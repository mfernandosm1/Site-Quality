# Arquivos operacionais que não fazem parte do frontend público.
<FilesMatch "(?i)^(?:analytics|publish|personalizacao-history|panel-theme)\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
