<script>
(() => {
  const esc=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const request=async(url,options={})=>{const response=await fetch(url,{headers:{'Content-Type':'application/json','Accept':'application/json'},...options});const data=await response.json().catch(()=>({}));if(!response.ok||data.success===false)throw new Error(data.message||'Falha na operação.');return data;};
  const configForm=document.getElementById('configForm'),configMessage=document.getElementById('configMessage'),simulate=document.getElementById('simulate'),reportBox=document.getElementById('report'),rowsBox=document.getElementById('rows'),executeButton=document.getElementById('executeSelected');
  let report=null; const selected=new Set(); const serviceCodes=new Set();
  const mode=()=>document.querySelector('input[name="operationMode"]:checked')?.value||'import';
  const fields=()=>Object.fromEntries([...document.querySelectorAll('.sync-field')].map(input=>[input.dataset.field,input.checked]));
  const setPreset=name=>{const values=name==='stock'?{salePrice:false,barcode:false,ncm:false,reference:false,brand:false,unit:false,active:false,cost:false,stock:true,collection:false}:{salePrice:true,barcode:true,ncm:true,reference:true,brand:true,unit:true,active:true,cost:false,stock:false,collection:false};document.querySelectorAll('.sync-field').forEach(input=>input.checked=Boolean(values[input.dataset.field]));};
  configForm.addEventListener('submit',async event=>{event.preventDefault();configMessage.hidden=false;configMessage.textContent='Salvando…';try{const result=await request('/produtos/importar-wm10/configuracao',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(configForm)))});configMessage.textContent=result.message;}catch(error){configMessage.textContent=error.message;}});
  document.getElementById('testConnection').addEventListener('click',async event=>{const button=event.currentTarget;button.disabled=true;button.textContent='Testando…';try{const result=await request('/produtos/importar-wm10/testar',{method:'POST',body:'{}'});configMessage.hidden=false;configMessage.textContent='✅ '+result.message;}catch(error){configMessage.hidden=false;configMessage.textContent='⚠️ '+error.message;}finally{button.disabled=false;button.textContent='Testar conexão';}});
  const groups=()=>report?[['new',report.new||[]],['legacy',report.legacy||[]],['review',report.review||[]],['existing',report.existing||[]],['imported',report.imported||[]],['ignored',report.ignored||[]],['invalid',report.invalid||[]]]:[];
  const allRows=()=>groups().flatMap(([status,items])=>items.map(item=>({...item,_status:status})));
  const selectable=item=>mode()==='import'?['new','legacy','review'].includes(item._status):item._status==='imported';
  function updateSelection(){const label=mode()==='sync'?'Sincronizar':'Importar';document.getElementById('selectionCount').textContent=`${selected.size} selecionado(s)`;executeButton.disabled=!selected.size;executeButton.textContent=selected.size?`${label} ${selected.size} selecionado(s)`:mode()==='sync'?'Sincronizar selecionados':'Importar selecionados';document.getElementById('selectionHint').textContent=mode()==='sync'?'Na sincronização, apenas produtos já importados/vinculados podem ser selecionados. Nenhum produto novo será criado.':'Na importação, “Novos”, “Inativos/sem estoque” e itens em “Revisar” podem ser selecionados manualmente. “Já existe” continua protegido contra duplicação.';}
  function statusLabel(status){return {new:'Novo',legacy:'Inativo / sem estoque',review:'Revisar',existing:'Já existe',imported:'Já tratado',ignored:'Ignorado',invalid:'Inválido'}[status]||status;}
  function renderRows(){if(!report)return;const term=document.getElementById('search').value,status=document.getElementById('statusFilter').value,activity=document.getElementById('activityFilter').value;const filteredItems=allRows().filter(item=>{if(status!=='all'&&item._status!==status)return false;if(activity==='active'&&!item.active)return false;if(activity==='inactive'&&item.active)return false;if(activity==='stock'&&Number(item.stock)<=0)return false;const hay=[item.code,item.name,item.barcode,item.reference,item.brand,item.match?.name,item.reason].join(' ');return QualitySearch.matches(hay,term);});const items=filteredItems.slice(0,200);rowsBox.innerHTML=`<div class="product-row header"><span></span><span>Código</span><span>Produto</span><span>Status</span><span>Estoque WM10</span><span>Preço</span><span>Comparação</span></div>`+items.map(item=>{const canSelect=selectable(item);const confidence=item.match?.confidence?Math.round(item.match.confidence*100):null;let match='—';if(item.match){match=`<div class="match"><strong>${esc(item.match.name)}</strong><small>${esc(item.match.reason)}${confidence!==null?` · ${confidence}%`:''}</small>${['existing','review'].includes(item._status)?`<button class="btn link-btn" data-link-code="${esc(item.code)}" data-product-id="${esc(item.match.productId)}" type="button">Vincular ao existente</button>`:''}</div>`;}else if(item.wmDuplicates?.length){match=`<div class="match"><strong>${item.wmDuplicates.length} possível(is) duplicado(s)</strong><small>${esc(item.wmDuplicates.slice(0,3).map(x=>`#${x.code} ${x.name}`).join(' · '))}</small></div>`;}else if(item.reason){match=`<small>${esc(item.reason)}</small>`;}const decision=item._status==='ignored'?`<button class="btn link-btn" data-reopen-code="${esc(item.code)}" type="button">Reabrir</button>`:(!['imported','invalid'].includes(item._status)?`<button class="btn link-btn" data-ignore-code="${esc(item.code)}" type="button">Não importar</button>`:'');return `<div class="product-row" data-code="${esc(item.code)}" data-status="${esc(item._status)}"><span>${canSelect?`<input type="checkbox" class="row-check" value="${esc(item.code)}" ${selected.has(Number(item.code))?'checked':''}>`:''}</span><strong>#${esc(item.code)}</strong><div><strong>${esc(item.name)}</strong><small>${[item.brand,item.reference?`Ref. ${item.reference}`:'',item.barcode?`EAN ${item.barcode}`:''].filter(Boolean).map(esc).join(' · ')}</small></div><span><span class="badge ${esc(item._status)}">${esc(statusLabel(item._status))}</span><small>${item.active?'Ativo':'Inativo'}</small></span><span>${Number(item.stock||0).toLocaleString('pt-BR')}</span><span>${Number(item.price||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}</span><span>${match}${canSelect&&mode()==='import'?`<label class="row-kind"><input type="checkbox" class="row-service" data-code="${esc(item.code)}" ${serviceCodes.has(Number(item.code))?'checked':''}> Importar como serviço</label>`:''}${decision}</span></div>`;}).join('')+(filteredItems.length>items.length?`<div class="row-limit-note">Mostrando 200 de ${filteredItems.length} registros. Use busca/filtros para localizar os demais sem pesar a tela.</div>`:'');rowsBox.querySelectorAll('.row-check').forEach(input=>input.addEventListener('change',()=>{const code=Number(input.value);input.checked?selected.add(code):selected.delete(code);updateSelection();}));rowsBox.querySelectorAll('.row-service').forEach(input=>input.addEventListener('change',()=>{const code=Number(input.dataset.code);input.checked?serviceCodes.add(code):serviceCodes.delete(code);}));rowsBox.querySelectorAll('[data-link-code]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm(`Vincular o código WM10 #${button.dataset.linkCode} ao produto sugerido do Quality?\n\nIsso não cria outro produto.`))return;button.disabled=true;try{await request('/produtos/importar-wm10/vincular',{method:'POST',body:JSON.stringify({wm10Code:Number(button.dataset.linkCode),productId:button.dataset.productId})});await runSimulation({scroll:false,useCache:true});}catch(error){alert(error.message);button.disabled=false;}}));rowsBox.querySelectorAll('[data-ignore-code]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm(`Marcar o produto WM10 #${button.dataset.ignoreCode} para não importar?`))return;await request('/produtos/importar-wm10/decisao',{method:'POST',body:JSON.stringify({wm10Code:Number(button.dataset.ignoreCode),decision:'ignored'})});await runSimulation({scroll:false,useCache:true});}));rowsBox.querySelectorAll('[data-reopen-code]').forEach(button=>button.addEventListener('click',async()=>{await request('/produtos/importar-wm10/decisao',{method:'POST',body:JSON.stringify({wm10Code:Number(button.dataset.reopenCode),decision:'pending'})});await runSimulation({scroll:false,useCache:true});}));}
  function roleLabel(role){return {parent:'Produto pai',variation:'Variação / filho',duplicate:'Duplicado',separate:'Manter separado',ignore:'Não importar'}[role]||role;}
  function familyRoleLabel(role){return {parent:'Produto pai',variation:'Variação / filho',duplicate:'Duplicado',separate:'Manter separado',ignore:'Não importar'}[role]||role;}
  function familyBodyHtml(family){
    const attrs=Object.entries(family.attributes||{}).filter(([,values])=>values?.length).map(([key,values])=>`<span><strong>${esc({color:'Cor',storage:'Armazenamento',size:'Tamanho',condition:'Condição',voltage:'Voltagem',type:'Tipo'}[key]||key)}:</strong> ${esc(values.slice(0,12).join(', '))}${values.length>12?'…':''}</span>`).join('');
    const members=family.members.map(member=>`<div class="family-member"><input class="family-member-check" data-code="${esc(member.code)}" type="checkbox"><strong>#${esc(member.code)}</strong><div><strong>${esc(member.name)}</strong><small>${[member.color?`Cor: ${member.color}`:'',member.size?`Tam: ${member.size}`:'',member.variantAttributes?.storage?`Armaz.: ${member.variantAttributes.storage}`:'',`Estoque WM10: ${Number(member.stock||0).toLocaleString('pt-BR')}`].filter(Boolean).map(esc).join(' · ')}</small></div><select class="family-role" data-code="${esc(member.code)}">${['parent','variation','duplicate','separate','ignore'].map(role=>`<option value="${role}" ${member.role===role?'selected':''}>${familyRoleLabel(role)}</option>`).join('')}</select></div>`).join('');
    return `<div class="family-name-row"><label>Nome do produto pai<input class="family-name" data-original-name="${esc(family.suggestedName)}" value="${esc(family.suggestedName)}"></label><small>Se você não editar o nome, a importação usa o nome do pai e remove somente o atributo que realmente varia entre os filhos.</small></div><div class="family-kind-row"><label>Tipo de cadastro</label><select class="family-kind"><option value="product" ${(family.kind||'product')==='product'?'selected':''}>📦 Produto</option><option value="service" ${family.kind==='service'?'selected':''}>🧰 Serviço</option></select><small>O padrão é Produto. Escolha Serviço somente quando esta família representar um serviço.</small></div><div class="family-attrs">${attrs}</div><div class="family-bulk"><button class="btn small family-select-all" type="button">Selecionar todos</button><button class="btn small family-select-none" type="button">Limpar</button><button class="btn small family-select-invert" type="button">Inverter</button><span class="bulk-count">0 selecionados</span><select class="family-bulk-role"><option value="variation">Variação / filho</option><option value="duplicate">Duplicado</option><option value="separate">Manter separado</option><option value="ignore">Não importar</option></select><button class="btn small primary family-apply-bulk" type="button">Aplicar aos selecionados</button><button class="btn small family-ignore-unselected" type="button">Não importar os não selecionados</button></div><div class="family-members">${members}</div><div class="family-actions">${family.status==='approved'?'<button class="btn family-reopen" type="button">Reabrir</button>':''}${family.status!=='imported'?`<button class="btn primary family-save" type="button">${family.status==='approved'?'Salvar alterações':'Aprovar família'}</button>`:`<strong>✅ Família já importada</strong><button class="btn primary family-repair" type="button">🔧 Corrigir nome e variações</button>`}</div>`;
  }
  function bindFamilyCard(card,family){
    const body=card.querySelector('.family-body'); if(body.dataset.bound==='1')return; body.dataset.bound='1'; body.innerHTML=familyBodyHtml(family);
    const keepOnlyOneParent=changed=>{if(changed.value!=='parent')return;card.querySelectorAll('.family-role').forEach(select=>{if(select!==changed&&select.value==='parent')select.value='variation';});};
    card.querySelectorAll('.family-role').forEach(select=>select.addEventListener('change',()=>keepOnlyOneParent(select)));
    const checks=[...card.querySelectorAll('.family-member-check')],bulkCount=card.querySelector('.bulk-count'); const update=()=>bulkCount.textContent=`${checks.filter(x=>x.checked).length} selecionado(s)`; checks.forEach(x=>x.onchange=update);
    card.querySelector('.family-select-all')?.addEventListener('click',()=>{checks.forEach(x=>x.checked=true);update();}); card.querySelector('.family-select-none')?.addEventListener('click',()=>{checks.forEach(x=>x.checked=false);update();}); card.querySelector('.family-select-invert')?.addEventListener('click',()=>{checks.forEach(x=>x.checked=!x.checked);update();});
    card.querySelector('.family-apply-bulk')?.addEventListener('click',()=>{const role=card.querySelector('.family-bulk-role').value,chosen=checks.filter(x=>x.checked);if(!chosen.length)return alert('Selecione pelo menos um produto.');chosen.forEach(x=>{const sel=card.querySelector(`.family-role[data-code="${x.dataset.code}"]`);if(sel&&sel.value!=='parent')sel.value=role;});});
    card.querySelector('.family-ignore-unselected')?.addEventListener('click',()=>{const chosen=new Set(checks.filter(x=>x.checked).map(x=>x.dataset.code));card.querySelectorAll('.family-role').forEach(sel=>{if(sel.value!=='parent'&&!chosen.has(sel.dataset.code))sel.value='ignore';});});
    card.querySelector('.family-save')?.addEventListener('click',async e=>{const button=e.currentTarget,roles=Object.fromEntries([...card.querySelectorAll('.family-role')].map(sel=>[sel.dataset.code,sel.value])),parent=Object.entries(roles).find(([,r])=>r==='parent');if(!parent)return alert('Escolha um produto pai.');const nameInput=card.querySelector('.family-name'),name=nameInput.value,nameEdited=name.trim()!==String(nameInput.dataset.originalName||'').trim()||family.nameEdited===true;button.disabled=true;try{const result=await request('/produtos/importar-wm10/familia',{method:'POST',body:JSON.stringify({familyId:family.id,name,parentCode:Number(parent[0]),roles,status:'approved',nameEdited,kind:card.querySelector('.family-kind')?.value||'product'})});family.status='approved';family.nameEdited=nameEdited;family.kind=card.querySelector('.family-kind')?.value||'product';family.suggestedName=result.result.name||family.suggestedName;family.parentCode=result.result.parentCode;family.members.forEach(m=>m.role=roles[String(m.code)]||m.role);renderSummary();renderFamilies();updateFamilyImportSummary();}catch(error){alert(error.message);button.disabled=false;}});
    card.querySelector('.family-reopen')?.addEventListener('click',async()=>{try{await request('/produtos/importar-wm10/familia/reabrir',{method:'POST',body:JSON.stringify({familyId:family.id})});family.status='suggested';renderSummary();renderFamilies();updateFamilyImportSummary();}catch(error){alert(error.message);}});
    card.querySelector('.family-repair')?.addEventListener('click',async e=>{if(!confirm('Corrigir este produto já importado usando o pai e os filhos salvos?\n\nO nome passará a manter armazenamento/condição quando eles forem fixos, e somente os atributos que variam formarão as variações. Um backup será criado antes.'))return;const button=e.currentTarget;button.disabled=true;button.textContent='Corrigindo…';try{const result=await request('/produtos/importar-wm10/familia/corrigir-importada',{method:'POST',body:JSON.stringify({familyId:family.id})});alert(`Família corrigida.\n\nAntes: ${result.result.previousName}\nAgora: ${result.result.name}\nVariações: ${result.result.variations}`);await runSimulation({scroll:false});}catch(error){alert(error.message);button.disabled=false;button.textContent='🔧 Corrigir nome e variações';}});
  }
  function renderFamilies(){if(!report)return;const section=document.getElementById('familiesSection'),box=document.getElementById('families'),term=document.getElementById('familySearch').value,status=document.getElementById('familyStatus').value;const families=report.families||[];section.hidden=!families.length;if(!families.length)return;const visible=families.filter(f=>(status==='all'||f.status===status)&&QualitySearch.matches([f.suggestedName,...f.members.slice(0,20).map(m=>m.name)].join(' '),term));const shown=visible.slice(0,40);document.getElementById('familySummary').innerHTML=`<span><strong>${families.length}</strong> famílias detectadas</span><span><strong>${families.filter(f=>f.status==='approved').length}</strong> aprovadas</span><span><strong>${families.filter(f=>f.status==='imported').length}</strong> importadas</span><span><strong>${families.reduce((sum,f)=>sum+f.members.length,0)}</strong> registros agrupados</span>`;box.innerHTML=shown.map(f=>`<details class="family-card ${f.status==='approved'?'approved':''}" data-family-id="${esc(f.id)}"><summary><div><strong>${f.kind==='service'?'🧰':'📦'} ${esc(f.suggestedName)}</strong><small>${esc(Object.entries(f.attributes||{}).filter(([,v])=>v?.length).map(([k,v])=>`${{color:'Cor',storage:'Armazenamento',size:'Tamanho',condition:'Condição',voltage:'Voltagem',type:'Tipo'}[k]||k}: ${v.length}`).join(' · ')||'Possíveis variações')}</small></div><span class="family-count">${f.members.length} registros</span><span class="family-status">${f.status==='imported'?'Importada':f.status==='approved'?'Aprovada':'Revisar'}</span></summary><div class="family-body"><div class="family-loading">Abra a família para carregar os ${f.members.length} itens.</div></div></details>`).join('')+(visible.length>shown.length?`<div class="family-empty">Mostrando 40 de ${visible.length} famílias. Pesquise para localizar as demais.</div>`:'');box.querySelectorAll('.family-card').forEach(card=>{card.addEventListener('toggle',()=>{if(card.open){const family=report.families.find(f=>f.id===card.dataset.familyId);if(family)bindFamilyCard(card,family);}});});updateFamilyImportSummary();}
  function updateFamilyImportSummary(){if(!report)return;const section=document.getElementById('familyImportSection'),approved=(report.families||[]).filter(f=>f.status==='approved');section.hidden=!approved.length;const counts={families:approved.length,parents:approved.length,variations:0,ignored:0};approved.forEach(f=>f.members.forEach(m=>{if(m.role==='variation')counts.variations++;if(m.role==='ignore')counts.ignored++;}));document.getElementById('familyImportSummary').innerHTML=`<div><small>Famílias aprovadas</small><strong>${counts.families}</strong></div><div><small>Produtos pai</small><strong>${counts.parents}</strong></div><div><small>Variações / filhos</small><strong>${counts.variations}</strong></div><div><small>Não importar</small><strong>${counts.ignored}</strong></div>`;document.getElementById('familyImportHint').textContent='Importe primeiro uma família pequena para validar o resultado. Limite: 200 famílias por lote.';}
  function renderSummary(){const stats=[['Encontrados',report.totalFound],['Famílias',report.familyCount||0],['Famílias aprovadas',report.approvedFamilyCount||0],['Novos',report.new?.length||0],['Revisar',report.review?.length||0],['Já existem',report.existing?.length||0],['Já tratados',report.imported?.length||0],['Ignorados',report.ignored?.length||0],['Legado',report.legacy?.length||0],['Ativos',report.active||0],['Inativos',report.inactive||0],['Com estoque',report.withStock||0],['Categorias lidas',report.categoriesFound??'—']];document.getElementById('summary').innerHTML=stats.map(([label,value])=>`<div class="stat"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`).join('');const warning=document.getElementById('categoryWarning');warning.hidden=!report.categoryWarning;warning.textContent=report.categoryWarning?`Categorias WM10: ${report.categoryWarning}`:'';}
  async function runSimulation({scroll=true,useCache=true,forceRefresh=false}={}){selected.clear();updateSelection();simulate.disabled=true;simulate.textContent=forceRefresh?'Atualizando WM10…':'Analisando dados salvos…';document.getElementById('progress').hidden=false;try{const result=await request('/produtos/importar-wm10/simular',{method:'POST',body:JSON.stringify({useCache,forceRefresh})});report=result.report;reportBox.hidden=false;document.getElementById('generatedAt').textContent=`Simulação de ${new Date(report.generatedAt).toLocaleString('pt-BR')} · nenhuma gravação realizada.`;renderSummary();renderFamilies();updateFamilyImportSummary();renderRows();if(scroll)reportBox.scrollIntoView({behavior:'smooth',block:'start'});}catch(error){alert(error.message);}finally{simulate.disabled=false;simulate.textContent='Analisar dados salvos · R$ 0';document.getElementById('progress').hidden=true;}}
  simulate.addEventListener('click',()=>runSimulation({useCache:true,forceRefresh:false}));
  document.getElementById('refreshWm10').addEventListener('click',async()=>{const estimated=<%= refreshEstimate?.productCalls || 'null' %>;const cost=<%= Number(refreshEstimate?.estimatedCost || 0).toFixed(2) %>;const detail=estimated?`\n\nEstimativa com a última contagem: ${estimated} consultas ≈ R$ ${cost.toFixed(2).replace('.', ',')}.`:'';if(!confirm(`Atualizar a cópia local consultando o WM10?${detail}\n\nDepois desta atualização, você pode analisar e importar quantas vezes quiser sem novas consultas.`))return;const button=document.getElementById('refreshWm10');button.disabled=true;button.textContent='Atualizando…';try{await runSimulation({useCache:false,forceRefresh:true});}finally{button.disabled=false;button.textContent='↻ Atualizar dados do WM10';}});
  document.getElementById('backfillNcm')?.addEventListener('click',async event=>{if(!confirm('Preencher NCM vazio usando a base local?\n\nO ERP prioriza regras seguras para mercadorias inequívocas (ex.: smartphone, bateria de celular, carregador, fone, mouse, console, cabo USB e pen drive), reaproveita vínculos WM10 quando cabível e NÃO altera NCM já preenchido. Serviços e casos duvidosos ficam para revisão.'))return;const button=event.currentTarget;button.disabled=true;button.textContent='Revisando NCM…';try{const result=await request('/produtos/importar-wm10/ncm-cache',{method:'POST',body:'{}'});const r=result.report;alert(`NCM concluído.\n\nPreenchidos: ${r.updated}\n• regra segura: ${r.fromTrustedRule||0}\n• vínculo WM10: ${r.fromWm10||0}\n• nome idêntico WM10: ${r.fromExactName||0}\nJá preenchidos: ${r.alreadyFilled}\nServiços ignorados: ${r.serviceSkipped||0}\nSem NCM seguro: ${r.withoutNcm}\nConflitos: ${r.conflicts}\nLegado suspeito não copiado: ${r.legacySuspectSkipped||0}\nNCM existente para revisar: ${r.reviewExisting||0}`);}catch(error){alert(error.message);}finally{button.disabled=false;button.textContent='🧾 Preencher / revisar NCM';}});
  ['search','statusFilter','activityFilter'].forEach(id=>document.getElementById(id).addEventListener(id==='search'?'input':'change',renderRows));
  ['familySearch','familyStatus'].forEach(id=>document.getElementById(id).addEventListener(id==='familySearch'?'input':'change',renderFamilies));
  document.querySelectorAll('input[name="operationMode"]').forEach(input=>input.addEventListener('change',()=>{selected.clear();if(mode()==='sync')setPreset('stock');else setPreset('catalog');updateSelection();renderRows();}));
  document.getElementById('presetCatalog').addEventListener('click',()=>setPreset('catalog'));
  document.getElementById('presetStock').addEventListener('click',()=>setPreset('stock'));
  document.getElementById('selectVisible').addEventListener('click',()=>{rowsBox.querySelectorAll('.row-check').forEach(input=>{input.checked=true;selected.add(Number(input.value));});updateSelection();});
  document.getElementById('clearSelection').addEventListener('click',()=>{selected.clear();updateSelection();renderRows();});
  function applyImportedCodesLocally(codes=[]){
    if(!report)return;
    const importedCodes=new Set((codes||[]).map(Number));
    if(!importedCodes.size)return;
    const moved=[];
    for(const key of ['new','legacy','review']){
      const keep=[];
      for(const item of report[key]||[]){if(importedCodes.has(Number(item.code)))moved.push(item);else keep.push(item);}
      report[key]=keep;
    }
    report.imported=[...(report.imported||[]),...moved];
    report.summary={...(report.summary||{}),new:(report.new||[]).length,legacy:(report.legacy||[]).length,review:(report.review||[]).length,imported:(report.imported||[]).length};
    importedCodes.forEach(code=>selected.delete(code));
    renderSummary();renderRows();updateSelection();
  }
  executeButton.addEventListener('click',async()=>{if(!selected.size)return;const currentMode=mode(),chosenFields=fields(),stockOnly=chosenFields.stock&&Object.entries(chosenFields).filter(([key,value])=>key!=='stock'&&value).length===0;const action=currentMode==='sync'?'sincronizar':'importar';const stockText=chosenFields.stock?'\n\nO estoque do WM10 SERÁ aplicado e será registrado como ajuste de inventário.':'\n\nO estoque do WM10 NÃO será importado.';const serviceCount=currentMode==='import'?[...selected].filter(code=>serviceCodes.has(Number(code))).length:0;if(!confirm(`${currentMode==='sync'?'Sincronizar':'Importar'} ${selected.size} produto(s)?${serviceCount?`\n\n${serviceCount} será(ão) importado(s) como serviço.`:''}${stockText}${stockOnly?'\nModo: somente estoque.':''}`))return;executeButton.disabled=true;executeButton.textContent=currentMode==='sync'?'Sincronizando…':'Importando…';try{const endpoint=currentMode==='sync'?'/produtos/importar-wm10/sincronizar':'/produtos/importar-wm10/executar';const result=await request(endpoint,{method:'POST',body:JSON.stringify({selectedCodes:[...selected],fields:chosenFields,itemKinds:Object.fromEntries([...selected].map(code=>[String(code),serviceCodes.has(Number(code))?'service':'product']))})});const r=result.report;alert(currentMode==='sync'?`Sincronização concluída.\n\nSincronizados: ${r.synced}\nEstoques ajustados: ${r.stockAdjusted||0}\nErros: ${r.errors.length}`:`Importação concluída.\n\nImportados: ${r.imported}\nEstoques aplicados: ${r.stockAdjusted||0}\nErros: ${r.errors.length}`);if(currentMode==='import')applyImportedCodesLocally(r.importedCodes||[]);else{selected.clear();updateSelection();renderRows();}}catch(error){alert(error.message);updateSelection();}finally{executeButton.disabled=!selected.size;updateSelection();}});
  document.getElementById('importApprovedFamilies').addEventListener('click',async event=>{const approved=(report?.families||[]).filter(f=>f.status==='approved');if(!approved.length)return alert('Aprove pelo menos uma família.');const chosenFields=fields();const variations=approved.reduce((sum,f)=>sum+f.members.filter(m=>['parent','variation'].includes(m.role)).length,0);const stockText=chosenFields.stock?'O estoque do WM10 também será aplicado.':'O estoque começará zerado; você poderá sincronizá-lo depois.';if(!confirm(`Importar ${approved.length} família(s) aprovada(s)?\n\nRegistros que formarão pai/variações: ${variations}\n${stockText}\n\nRecomendado: teste primeiro com uma família pequena.`))return;const button=event.currentTarget;button.disabled=true;button.textContent='Importando famílias…';try{const result=await request('/produtos/importar-wm10/familias/importar',{method:'POST',body:JSON.stringify({fields:chosenFields})});const r=result.report;alert(`Importação de famílias concluída.\n\nFamílias: ${r.importedFamilies}\nProdutos pai: ${r.parentProducts}\nVariações: ${r.variations}\nProdutos separados: ${r.separateProducts}\nIgnorados: ${r.ignored}\nErros: ${r.errors.length}`);if(r.importedProducts?.length===1&&confirm(`Abrir agora o cadastro de ${r.importedProducts[0].name}?`)){window.location.href=`/produtos?origem=erp&q=${encodeURIComponent(r.importedProducts[0].name)}`;return;}await runSimulation({scroll:false,useCache:true});}catch(error){alert(error.message);}finally{button.disabled=false;button.textContent='🚀 Importar famílias aprovadas';}});
  updateSelection();
})();
</script>
