op:1px solid #e2e8f0;padding:13px}.family-name-row{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:10px;align-items:end;margin-bottom:10px}.family-name-row label{font-size:10px;font-weight:900;text-transform:uppercase}.family-name{display:block;width:100%;margin-top:5px}.family-attrs{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 12px}.family-attrs span{font-size:10px;border-radius:999px;background:rgba(37,99,235,.08);padding:5px 7px}.family-bulk{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding:9px 0 10px}.family-bulk .bulk-count{font-size:10px;font-weight:900;color:#64748b;margin-right:auto}.family-bulk select{box-sizing:border-box;padding:7px 9px;border:1px solid #cbd5e1;border-radius:8px;background:transparent;color:inherit}.family-members{border-top:1px solid #e2e8f0}.family-member{display:grid;grid-template-columns:30px 80px minmax(260px,1fr) minmax(160px,.5fr);gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid #e2e8f0}.family-member small{display:block;color:#64748b}.family-member-check{width:16px;height:16px}.family-role{width:100%}.family-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}.family-empty{padding:18px;border:1px dashed #cbd5e1;border-radius:10px;color:#64748b;text-align:center}html[data-panel-theme="oled"] .wm10-hero,html[data-panel-theme="oled"] .wm10-card,html[data-panel-theme="black-oled"] .wm10-hero,html[data-panel-theme="black-oled"] .wm10-card{background:#080a0c!important;border-color:#30363d!important;color:#f8fafc!important}html[data-panel-theme="oled"] .config-grid input,html[data-panel-theme="oled"] .toolbar input,html[data-panel-theme="oled"] .toolbar select,html[data-panel-theme="oled"] .family-tools input,html[data-panel-theme="oled"] .family-tools select,html[data-panel-theme="oled"] .family-name,html[data-panel-theme="oled"] .family-role,html[data-panel-theme="oled"] .family-bulk select,html[data-panel-theme="black-oled"] .config-grid input,html[data-panel-theme="black-oled"] .toolbar input,html[data-panel-theme="black-oled"] .toolbar select,html[data-panel-theme="black-oled"] .family-tools input,html[data-panel-theme="black-oled"] .family-tools select,html[data-panel-theme="black-oled"] .family-name,html[data-panel-theme="black-oled"] .family-role,html[data-panel-theme="black-oled"] .family-bulk select{background:#0d0f12!important;border-color:#374151!important;color:#fff!important}html[data-panel-theme="oled"] .product-row.header,html[data-panel-theme="black-oled"] .product-row.header{background:#080a0c!important}html[data-panel-theme="oled"] .operation-mode,html[data-panel-theme="oled"] .field-box,html[data-panel-theme="oled"] .field-grid label,html[data-panel-theme="black-oled"] .operation-mode,html[data-panel-theme="black-oled"] .field-box,html[data-panel-theme="black-oled"] .field-grid label{border-color:#30363d!important}@media(max-width:950px){.wm10-grid,.operation-box{grid-template-columns:1fr}.summary{grid-template-columns:repeat(3,1fr)}.toolbar{grid-template-columns:1fr 1fr}.field-grid{grid-template-columns:repeat(2,1fr)}.product-row{min-width:980px}.rows{overflow:auto}.wm10-hero{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.config-grid{grid-template-columns:1fr}.config-grid .full{grid-column:auto}.summary,.field-grid{grid-template-columns:repeat(2,1fr)}.toolbar{grid-template-columns:1fr}.selection-bar{align-items:flex-start;flex-direction:column}}
