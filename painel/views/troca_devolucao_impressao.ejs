<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Imprimir troca / devolução</title>
  <style>
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#111827;font-family:Arial,sans-serif}.print-toolbar{height:54px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 14px;color:#fff}.print-toolbar span{font-size:12px;opacity:.78}.print-toolbar button{border:0;border-radius:9px;padding:9px 14px;font-weight:700;cursor:pointer;background:#2563eb;color:#fff}.print-frame{display:block;width:min(100%,1040px);height:calc(100vh - 54px);margin:0 auto;border:0;background:#fff;box-shadow:0 0 28px rgba(0,0,0,.25)}
  </style>
</head>
<body>
  <div class="print-toolbar"><span>Termo de troca / devolução</span><button type="button" id="printAgain">🖨️ Imprimir novamente</button></div>
  <iframe class="print-frame" id="printFrame" title="Termo de troca / devolução"></iframe>
  <script src="/public/js/erp-print-renderer.js"></script>
  <script>
    const model=<%- JSON.stringify(model).replace(/</g,'\\u003c') %>;
    const variables=<%- JSON.stringify(variables).replace(/</g,'\\u003c') %>;
    const frame=document.getElementById('printFrame');
    const printDocument=()=>{try{frame.contentWindow.focus();frame.contentWindow.print();}catch(error){console.error('Não foi possível abrir a impressão:',error);}};
    frame.addEventListener('load',()=>setTimeout(printDocument,180),{once:true});
    frame.srcdoc=window.QualityERPPrintRenderer.renderDocument(model,variables);
    document.getElementById('printAgain').addEventListener('click',printDocument);
  </script>
</body>
</html>
