<% layout('layout') -%>
<%
  const modulesByKey = new Map(modules.map((item) => [item.key, item]));
  const operationalKeys = [
    'clientes',
    'produtos',
    'categorias',
    'estoque',
    'fornecedores',
    'compras',
    'pdv',
    'orcamentos',
    'centro-operacoes',
    'financeiro',
    'ordens-servico'
  ];
  const managementKeys = ['fluxo-caixa', 'dre', 'dfc', 'relatorios', 'metas-comissoes'];
  const operationalModules = operationalKeys.map((key) => modulesByKey.get(key)).filter(Boolean);
  const managementModules = managementKeys.map((key) => modulesByKey.get(key)).filter(Boolean);
%>

<header class="erp-dashboard-header">
  <h1>Quality ERP</h1>
  <span>v0.27.1</span>
</header>

<section class="erp-module-group" aria-labelledby="erp-operacional-title">
  <div class="erp-group-heading">
    <h2 id="erp-operacional-title">Operacional</h2>
  </div>

  <div class="erp-grid erp-grid-organized">
    <% operationalModules.forEach((item) => { %>
      <a class="erp-module-card" href="/erp/modulo/<%= item.key %>" aria-label="<%= item.name %>. <%= item.description %>">
        <div class="erp-module-icon"><%= item.icon %></div>
        <div class="erp-module-content">
          <h3 class="erp-module-title"><%= item.name %></h3>
          <p class="erp-module-description"><%= item.description %></p>
          <span class="erp-module-status <%= item.status === 'ativo' ? 'is-active' : 'is-planned' %>"><%= item.status === 'ativo' ? 'Ativo' : 'Planejado' %></span>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<section class="erp-module-group" aria-labelledby="erp-gestao-title">
  <div class="erp-group-heading">
    <h2 id="erp-gestao-title">Gestão</h2>
  </div>

  <div class="erp-grid erp-grid-organized">
    <% managementModules.forEach((item) => { %>
      <a class="erp-module-card" href="/erp/modulo/<%= item.key %>" aria-label="<%= item.name %>. <%= item.description %>">
        <div class="erp-module-icon"><%= item.icon %></div>
        <div class="erp-module-content">
          <h3 class="erp-module-title"><%= item.name %></h3>
          <p class="erp-module-description"><%= item.description %></p>
          <span class="erp-module-status <%= item.status === 'ativo' ? 'is-active' : 'is-planned' %>"><%= item.status === 'ativo' ? 'Ativo' : 'Planejado' %></span>
        </div>
      </a>
    <% }) %>

    <a class="erp-module-card" href="/kernel" aria-label="Centro de Inteligência. Logs, eventos, auditoria, documentos e timelines de todos os módulos.">
      <div class="erp-module-icon">🧠</div>
      <div class="erp-module-content">
        <h3 class="erp-module-title">Centro de Inteligência</h3>
        <p class="erp-module-description">Logs, eventos, auditoria, documentos e timelines de todos os módulos.</p>
        <span class="erp-module-status is-active">Ativo</span>
      </div>
    </a>
  </div>
</section>


