<% layout('layout') -%>
<% const money = value => Number(value || 0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); %>
<% const dateTime = value => value ? new Date(value).toLocaleString('pt-BR') : '—'; %>
<% const statusLabel = { open:'Aberta', finalized:'Concluída', cancelled:'Cancelada', reversed:'Estornada' }; %>
<% const fiscalLabel = { none:'Sem documento', pending:'Pendente', transmitted:'Transmitido', rejected:'Rejeitado', cancelled:'Cancelado' }; %>
<% const filterParams = extra => new URLSearchParams({ q:filters.query || '', tipo:filters.type || 'all', situacao:filters.status || 'all', de:filters.dateFrom || '', ate:filters.dateTo || '', vendedor:filters.seller || '', caixa:filters.cashboxId || 'all', ordem:filters.sort || 'openedAt', direcao:filters.direction || 'desc', ...(extra || {}) }).toString(); %>
<% const sortLink = key => `/erp/centro-operacoes?${filterParams({ ordem:key, direcao:(filters.sort===key && filters.direction==='asc')?'desc':'asc' })}`; %>
<% const sortMark = key => filters.sort===key ? (filters.direction==='asc'?'↑':'↓') : '↕'; %>

<section class="operations-hero">
  <div><span class="erp-kicker">ERP v0.24.0</span><h1>Centro de Operações</h1><p>Vendas e ordens de serviço reunidas em uma consulta única.</p></div>
  <div class="operations-quick-actions"><a class="btn btn-primary" href="/erp/pdv">+ Nova operação</a><a class="btn" href="/erp/pdv/caixa">Caixa</a></div>
</section>

<section class="operations-summary">
  <a class="operations-summary-card erp-tone-info <%= filters.status==='all'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'all', ordem:'activityAt', direcao:'desc' }) %>"><span>Todas</span><b><%= summary.total %></b></a>
  <a class="operations-summary-card erp-tone-warning <%= filters.status==='open'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'open', ordem:'openedAt', direcao:'desc' }) %>"><span>Abertas</span><b><%= summary.open %></b></a>
  <a class="operations-summary-card erp-tone-success <%= filters.status==='finalized'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'finalized', ordem:'finalizedAt', direcao:'desc' }) %>"><span>Concluídas</span><b><%= summary.finalized %></b></a>
  <a class="operations-summary-card erp-tone-expense <%= filters.status==='reversed'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'reversed' }) %>"><span>Estornadas</span><b><%= summary.reversed %></b></a>
  <div class="operations-summary-card is-value erp-tone-warning"><span>Valor listado</span><b><%= money(summary.value) %></b></div>
</section>

<form class="operations-filters" method="get" action="/erp/centro-operacoes"><input type="hidden" name="ordem" value="<%= filters.sort || 'openedAt' %>"><input type="hidden" name="direcao" value="<%= filters.direction || 'desc' %>">
  <label class="operations-search"><span>Busca rápida</span><input name="q" value="<%= filters.query %>" placeholder="Número, cliente, CPF/CNPJ, telefone ou produto"></label>
  <label><span>Tipo</span><select name="tipo"><option value="all">Todos</option><option value="sale" <%= filters.type==='sale'?'selected':'' %>>Venda</option><option value="service_order" <%= filters.type==='service_order'?'selected':'' %>>O.S.</option></select></label>
  <label><span>Situação</span><select name="situacao"><option value="all">Todas</option><option value="open" <%= filters.status==='open'?'selected':'' %>>Em aberto</option><option value="finalized" <%= filters.status==='finalized'?'selected':'' %>>Concluída</option><option value="cancelled" <%= filters.status==='cancelled'?'selected':'' %>>Cancelada</option><option value="reversed" <%= filters.status==='reversed'?'selected':'' %>>Estornada</option></select></label>
  <label><span>Caixa</span><select name="caixa"><option value="all">Todos</option><% cashboxes.forEach(c => { %><option value="<%= c.id %>" <%= filters.cashboxId===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label>
  <div class="operations-period-filter">
    <span class="operations-period-title">Período de abertura</span>
    <div class="operations-period-inputs">
      <label><span>De</span><span class="operations-date-field"><input type="date" name="de" id="operationsDateFrom" value="<%= filters.dateFrom %>"><button class="operations-period-trigger" type="button" data-quick-date-trigger="from" aria-label="Abrir períodos rápidos da data inicial" title="Períodos rápidos">▾</button></span></label>
      <label><span>Até</span><span class="operations-date-field"><input type="date" name="ate" id="operationsDateTo" value="<%= filters.dateTo %>"><button class="operations-period-trigger" type="button" data-quick-date-trigger="to" aria-label="Abrir períodos rápidos da data final" title="Períodos rápidos">▾</button></span></label>
    </div>
  </div>
  <label><span>Vendedor</span><input name="vendedor" value="<%= filters.seller %>" placeholder="Nome do vendedor"></label>
  <div class="operations-filter-actions"><a class="btn" href="/erp/centro-operacoes">Limpar</a><button class="btn btn-primary" type="submit">Buscar</button></div>
</form>

<section class="operations-table-card">
  <div class="operations-table-head">
    <div class="operations-table-title-row">
      <h2>Operações</h2>
      <nav class="operations-status-tabs" aria-label="Filtros rápidos por situação">
        <a class="<%= filters.status==='all'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'all', ordem:'activityAt', direcao:'desc' }) %>"><span>Todas</span><b><%= summary.total %></b></a>
        <a class="<%= filters.status==='open'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'open', ordem:'openedAt', direcao:'desc' }) %>"><span>Abertas</span><b><%= summary.open %></b></a>
        <a class="<%= filters.status==='finalized'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'finalized', ordem:'finalizedAt', direcao:'desc' }) %>"><span>Concluídas</span><b><%= summary.finalized %></b></a>
        <a class="<%= filters.status==='cancelled'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'cancelled' }) %>"><span>Canceladas</span><b><%= summary.cancelled %></b></a>
        <a class="<%= filters.status==='reversed'?'is-active':'' %>" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ situacao:'reversed' }) %>"><span>Estornadas</span><b><%= summary.reversed %></b></a>
      </nav>
    </div>
    <span><%= operations.length %> registro(s)</span>
  </div>
  <div class="operations-bulk-bar" data-bulk-bar hidden>
    <div><strong><span data-selected-count>0</span> operação(ões) selecionada(s)</strong><small>Somente operações concluídas e aptas ao estorno podem ser selecionadas.</small></div>
    <div class="operations-bulk-actions"><button class="btn" type="button" data-clear-selection>Limpar seleção</button><button class="btn btn-danger" type="button" data-reverse-selected>↶ Estornar selecionadas</button></div>
  </div>
  <div class="operations-table-wrap"><table class="operations-table"><thead><tr><th><a class="operations-sort" data-save-scroll href="<%= sortLink('number') %>">Número <span><%= sortMark('number') %></span></a></th><th>Tipo</th><th><a class="operations-sort" data-save-scroll href="<%= sortLink('customer') %>">Cliente <span><%= sortMark('customer') %></span></a></th><th>Vendedor</th><th><a class="operations-sort" data-save-scroll href="<%= sortLink('openedAt') %>">Abertura <span><%= sortMark('openedAt') %></span></a></th><th><a class="operations-sort" data-save-scroll href="<%= sortLink('finalizedAt') %>">Conclusão <span><%= sortMark('finalizedAt') %></span></a></th><th><a class="operations-sort" data-save-scroll href="<%= sortLink('total') %>">Total <span><%= sortMark('total') %></span></a></th><th>Situação</th><th></th><th class="operations-select-head"><label title="Selecionar todas as operações concluídas visíveis"><input type="checkbox" data-select-all aria-label="Selecionar todas as operações concluídas visíveis"></label></th></tr></thead><tbody>
  <% if (!operations.length) { %><tr><td colspan="10" class="operations-empty">Nenhuma operação encontrada com os filtros informados.</td></tr><% } %>
  <% operations.forEach(op => { %><tr class="operation-main-row" data-operation-row="<%= op.id %>">
    <td><strong>#<%= op.number %></strong><small><%= op.id %></small></td><td><span class="operation-type"><%= op.displayType %></span></td><td><strong><%= op.displayCustomer %></strong><small><%= op.identifier || op.customer?.document || '' %></small></td><td><%= op.sellerNameSnapshot || '—' %></td><td><%= dateTime(op.dates?.openedAt) %></td><td><%= dateTime(op.dates?.finalizedAt || op.dates?.cancelledAt) %></td><td><strong><%= money(op.total) %></strong><small><%= op.itemCount %> item(ns)</small></td><td><span class="operation-status is-<%= op.status %>"><%= statusLabel[op.status] || op.status %></span></td>
    <td class="operations-actions"><details class="operation-manage-menu"><summary class="btn btn-small">Gerenciar <span aria-hidden="true">⌄</span></summary><div class="operation-manage-popover">
      <a class="operation-action" data-save-scroll href="/erp/centro-operacoes?<%= filterParams({ operacao:op.id }) %>">▤ <span>Ver ficha</span></a>
      <% if(op.status==='open') { %><a class="operation-action" href="<%= op.canOpenInPdv ? '/erp/pdv?caixa='+encodeURIComponent(op.cashboxId)+'&operacao='+encodeURIComponent(op.id) : '/erp/pdv/caixa?caixa='+encodeURIComponent(op.cashboxId) %>">▶ <span><%= op.canOpenInPdv?'Abrir no PDV':'Abrir caixa' %></span></a><a class="operation-action" href="/erp/pdv?caixa=<%= encodeURIComponent(op.cashboxId) %>&operacao=<%= encodeURIComponent(op.id) %>">✎ <span>Editar</span></a><% } %>
      <a class="operation-action" target="_blank" onclick="window.open(this.href, '_blank'); return false;" href="/erp/pdv?caixa=<%= encodeURIComponent(op.cashboxId) %>&operacao=<%= encodeURIComponent(op.id) %>&imprimir=1&somenteImpressao=1&voltar=<%= encodeURIComponent('/erp/centro-operacoes?'+filterParams({})) %>">🖨 <span>Imprimir</span></a>
      <button class="operation-action" type="button" data-duplicate-operation="<%= op.id %>">⧉ <span>Duplicar</span></button>
      <% if(op.status==='open') { %><button type="button" class="operation-action is-danger" data-cancel-operation="<%= op.id %>" data-version="<%= op.version %>">× <span>Cancelar</span></button><% } %>
      <% if(op.status==='finalized') { %><button type="button" class="operation-action is-danger" data-reverse-operation="<%= op.id %>">↶ <span>Estornar operação</span></button><button class="operation-action" type="button" disabled>🧾 <span>Documento Fiscal</span></button><% } %>
    </div></details></td>
    <td class="operations-select-cell"><label class="operation-select" title="<%= op.status==='finalized' ? 'Selecionar para estorno em lote' : 'Somente operações concluídas podem ser estornadas em lote' %>"><input type="checkbox" data-operation-select value="<%= op.id %>" data-operation-number="<%= op.number %>" <%= op.status==='finalized' ? '' : 'disabled' %> aria-label="Selecionar operação #<%= op.number %>"></label></td>
  </tr><% }) %></tbody></table></div>
</section>

<% if (selectedOperation) { const op = selectedOperation; %>
<div class="operation-detail-backdrop" data-operation-backdrop><section class="operation-detail-panel" id="operationPrintArea">
  <header><div><span><%= op.displayType %> #<%= op.number %></span><h2><%= op.displayCustomer %></h2><p><%= statusLabel[op.status] %> · <%= money(op.total) %></p></div><button class="operation-detail-close" type="button" data-operation-close aria-label="Fechar ficha">×</button></header>
  <div class="operation-detail-actions">
    <% if(op.status==='open') { %><a class="btn btn-primary" href="<%= op.canOpenInPdv ? '/erp/pdv?caixa='+encodeURIComponent(op.cashboxId)+'&operacao='+encodeURIComponent(op.id) : '/erp/pdv/caixa?caixa='+encodeURIComponent(op.cashboxId) %>"><%= op.canOpenInPdv ? 'Continuar no PDV' : 'Abrir caixa para continuar' %></a><% } %>
    <% if(op.customerId) { %><a class="btn" href="/erp/clientes?abrir=<%= encodeURIComponent(op.customerId) %>">Abrir cliente</a><% } %>
    <button class="btn" type="button" data-copy-operation="#<%= op.number %>">Copiar número</button>
    <a class="btn" target="_blank" onclick="window.open(this.href, '_blank'); return false;" href="/erp/pdv?caixa=<%= encodeURIComponent(op.cashboxId) %>&operacao=<%= encodeURIComponent(op.id) %>&imprimir=1&somenteImpressao=1&voltar=<%= encodeURIComponent('/erp/centro-operacoes?'+filterParams({})) %>">Imprimir comprovante</a>
  </div>

  <div class="operation-detail-grid">
    <article><h3>Identificação</h3><dl><dt>Número</dt><dd>#<%= op.number %></dd><dt>Tipo</dt><dd><%= op.displayType %></dd><dt>Situação</dt><dd><%= statusLabel[op.status] %></dd><dt>Caixa</dt><dd><%= op.cashbox?.name || op.cashboxId %></dd><dt>Abertura</dt><dd><%= dateTime(op.dates?.openedAt) %></dd><dt>Atualização</dt><dd><%= dateTime(op.dates?.updatedAt) %></dd><dt>Finalização</dt><dd><%= dateTime(op.dates?.finalizedAt) %></dd><dt>Cancelamento</dt><dd><%= dateTime(op.dates?.cancelledAt) %></dd><dt>Estorno</dt><dd><%= dateTime(op.dates?.reversedAt) %></dd><dt>Documento fiscal</dt><dd><span class="operation-fiscal-status is-<%= op.fiscal?.status || 'none' %>"><%= fiscalLabel[op.fiscal?.status || 'none'] %></span></dd></dl></article>
    <article><h3>Cliente e responsável</h3><dl><dt>Cliente</dt><dd><%= op.displayCustomer %></dd><dt>Documento</dt><dd><%= op.customer?.document || op.identifier || '—' %></dd><dt>Telefone</dt><dd><%= op.customer?.mobile || op.customer?.phone || '—' %></dd><dt>Vendedor</dt><dd><%= op.sellerNameSnapshot || '—' %></dd><dt>Criado por</dt><dd><%= op.createdBy || '—' %></dd><dt>Finalizado por</dt><dd><%= op.finalizedBy || '—' %></dd></dl></article>
  </div>

  <% if(op.notes || op.details) { %><article class="operation-detail-section"><h3>Observações</h3><div class="operation-detail-grid"><dl><dt>Observação original</dt><dd><%= op.notes || '—' %></dd></dl><% if(op.details){ %><dl><dt>Observação complementar anterior</dt><dd><%= op.details %></dd></dl><% } %></div></article><% } %><article class="operation-detail-section"><h3>Itens</h3><div class="detail-table-wrap"><table><thead><tr><th>Descrição</th><th>Qtd.</th><th>Unitário</th><th>Desconto</th><th>Total</th></tr></thead><tbody><% (op.items||[]).forEach(item => { %><tr><td><%= item.name %></td><td><%= item.quantity %></td><td><%= money(item.unitPrice) %></td><td><%= money(item.discount) %></td><td><%= money((Number(item.quantity)*Number(item.unitPrice))-Number(item.discount||0)) %></td></tr><% }) %></tbody></table></div><% if(op.coupon?.code){ %><div class="operation-coupon"><b>Cupom <%= op.coupon.code %></b><span><%= op.coupon.name || "" %></span><strong>- <%= money(op.couponDiscount || op.coupon.discount) %></strong></div><% } %><div class="operation-totals"><span>Subtotal <b><%= money(op.subtotal) %></b></span><span>Desconto nos itens <b><%= money(op.itemDiscountTotal ?? ((op.discountTotal||0)-(op.couponDiscount||0))) %></b></span><span>Cupom <b><%= money(op.couponDiscount||0) %></b></span><span>Total <b><%= money(op.total) %></b></span></div></article>

  <article class="operation-detail-section"><h3>Pagamentos</h3><div class="detail-table-wrap"><table><thead><tr><th>Forma</th><th>Valor</th><th>Parcelas</th><th>Vencimento</th><th>Situação</th></tr></thead><tbody><% (op.payments||[]).forEach(pay => { %><tr><td><%= pay.methodName || pay.methodId %></td><td><%= money(pay.amount) %></td><td><%= pay.installments || 1 %>x</td><td><%= pay.dueDate || '—' %></td><td><%= pay.status==='paid'?'Pago':pay.status %></td></tr><% }) %></tbody></table></div></article>

  <% if(op.type==='service_order') { %><article class="operation-detail-section"><h3>Ordem de Serviço</h3><div class="operation-detail-grid"><dl><dt>Equipamento</dt><dd><%= op.serviceOrder?.device || '—' %></dd><dt>Identificação/modelo</dt><dd><%= op.serviceOrder?.equipmentId || '—' %></dd><dt>Acessórios</dt><dd><%= op.serviceOrder?.accessories || '—' %></dd><dt>Técnico</dt><dd><%= op.serviceOrder?.technicianName || '—' %></dd></dl><dl><dt>Problema / diagnóstico</dt><dd><%= op.serviceOrder?.issue || '—' %></dd><dt>Serviço realizado</dt><dd><%= op.serviceOrder?.servicePerformed || '—' %></dd><dt>Fotos</dt><dd><%= (op.serviceOrder?.attachments||[]).length %></dd></dl></div></article><% } %>

  <div class="operation-detail-grid">
    <article><h3>Movimentação de caixa</h3><% if(!(op.cashMovements||[]).length){ %><p class="muted">Nenhuma movimentação vinculada.</p><% } %><% (op.cashMovements||[]).forEach(m => { %><div class="operation-movement"><span><%= m.description || m.type %><small><%= dateTime(m.createdAt) %> · <%= m.methodId %></small></span><b><%= money(m.signedAmount) %></b></div><% }) %></article>
    <article><h3>Movimentação de estoque</h3><% if(!(op.inventoryMovements||[]).length){ %><p class="muted">Nenhuma movimentação vinculada.</p><% } %><% (op.inventoryMovements||[]).forEach(m => { %><div class="operation-movement"><span><%= m.reason || m.type %><small><%= dateTime(m.createdAt) %> · <%= m.inventoryItemId %></small></span><b><%= m.signedQuantity > 0 ? '+' : '' %><%= m.signedQuantity %></b></div><% }) %></article>
  </div>

  <article class="operation-detail-section"><h3>Histórico da operação</h3><div class="operation-timeline"><% (op.timeline||[]).forEach(event => { %><div><i></i><span><b><%= event.label %></b><% if(event.type==='operation_note_added' && event.details?.note){ %><p><%= event.details.note %></p><% } %><small><%= dateTime(event.at) %> · <%= event.actor || 'painel' %></small></span></div><% }) %></div></article>
</section></div>
<% } %>

<script src="/public/js/quick-date-picker.js?v=1.0.2"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  window.QualityQuickDatePicker?.init({
    wrapper: '.operations-period-filter',
    from: '#operationsDateFrom',
    to: '#operationsDateTo',
    mode: 'operations'
  });

  const scrollKey = 'quality.operations.scrollY';
  const savedScroll = Number(sessionStorage.getItem(scrollKey) || 0);
  if (savedScroll > 0) requestAnimationFrame(() => window.scrollTo({ top:savedScroll, behavior:'auto' }));
  sessionStorage.removeItem(scrollKey);
  document.querySelectorAll('[data-save-scroll]').forEach(link => link.addEventListener('click', () => sessionStorage.setItem(scrollKey, String(window.scrollY))));

  const manageMenus = [...document.querySelectorAll('.operation-manage-menu')];
  const positionManageMenu = menu => {
    if (!menu?.open) return;
    const trigger = menu.querySelector(':scope > summary');
    const popover = menu.querySelector('.operation-manage-popover');
    if (!trigger || !popover) return;

    // O menu usa position:fixed para escapar do overflow da tabela/card.
    // Primeiro medimos com ele visível e depois escolhemos abrir acima/abaixo.
    popover.style.visibility = 'hidden';
    popover.style.left = '0px';
    popover.style.top = '0px';
    const triggerRect = trigger.getBoundingClientRect();
    const popoverRect = popover.getBoundingClientRect();
    const gap = 6;
    const viewportGap = 10;
    const availableBelow = window.innerHeight - triggerRect.bottom - viewportGap;
    const shouldOpenAbove = availableBelow < popoverRect.height && triggerRect.top > availableBelow;
    const top = shouldOpenAbove
      ? Math.max(viewportGap, triggerRect.top - popoverRect.height - gap)
      : Math.min(window.innerHeight - popoverRect.height - viewportGap, triggerRect.bottom + gap);
    const left = Math.min(
      Math.max(viewportGap, triggerRect.right - popoverRect.width),
      Math.max(viewportGap, window.innerWidth - popoverRect.width - viewportGap)
    );

    popover.style.left = `${Math.round(left)}px`;
    popover.style.top = `${Math.round(Math.max(viewportGap, top))}px`;
    popover.style.visibility = 'visible';
  };
  const closeManageMenus = except => manageMenus.forEach(menu => {
    if (menu !== except) menu.open = false;
  });
  const repositionOpenManageMenu = () => {
    const openMenu = manageMenus.find(menu => menu.open);
    if (openMenu) positionManageMenu(openMenu);
  };

  manageMenus.forEach(menu => menu.addEventListener('toggle', () => {
    if (!menu.open) return;
    closeManageMenus(menu);
    requestAnimationFrame(() => positionManageMenu(menu));
  }));
  window.addEventListener('resize', repositionOpenManageMenu, { passive:true });
  window.addEventListener('scroll', repositionOpenManageMenu, { passive:true, capture:true });
  document.addEventListener('click', event => {
    const currentMenu = event.target.closest('.operation-manage-menu');
    if (!currentMenu) closeManageMenus();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeManageMenus();
  });

  const filtersForm = document.querySelector('.operations-filters');
  filtersForm?.addEventListener('change', closeManageMenus);
  filtersForm?.addEventListener('submit', closeManageMenus);
  document.querySelectorAll('.operations-summary a, .operations-status-tabs a, .operation-manage-popover a, .operations-table a').forEach(link => {
    link.addEventListener('click', closeManageMenus);
  });

  const closeDetail = () => {
    document.querySelector('[data-operation-backdrop]')?.remove();
    const url = new URL(window.location.href);
    url.searchParams.delete('operacao');
    history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
  };
  document.querySelector('[data-operation-close]')?.addEventListener('click', closeDetail);
  document.querySelector('[data-operation-backdrop]')?.addEventListener('click', event => { if (event.target === event.currentTarget) closeDetail(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape') closeDetail(); });

  document.querySelector('[data-copy-operation]')?.addEventListener('click', async event => {
    const value = event.currentTarget.dataset.copyOperation || '';
    try { await navigator.clipboard.writeText(value); event.currentTarget.textContent = 'Número copiado'; }
    catch (_) { window.prompt('Copie o número da operação:', value); }
    setTimeout(() => { if (event.currentTarget) event.currentTarget.textContent = 'Copiar número'; }, 1600);
  });


  const api = async (url, body={}) => { const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); const data=await response.json().catch(()=>({})); if(!response.ok||data.success===false) throw new Error(data.message||'Não foi possível concluir a ação.'); return data; };

  const operationChecks=[...document.querySelectorAll('[data-operation-select]:not(:disabled)')];
  const selectAll=document.querySelector('[data-select-all]');
  const bulkBar=document.querySelector('[data-bulk-bar]');
  const selectedCount=document.querySelector('[data-selected-count]');
  const refreshBulkSelection=()=>{
    const selected=operationChecks.filter(input=>input.checked);
    selectedCount && (selectedCount.textContent=String(selected.length));
    if(bulkBar) bulkBar.hidden=selected.length===0;
    if(selectAll){
      selectAll.checked=operationChecks.length>0&&selected.length===operationChecks.length;
      selectAll.indeterminate=selected.length>0&&selected.length<operationChecks.length;
    }
    operationChecks.forEach(input=>input.closest('.operation-main-row')?.classList.toggle('is-selected',input.checked));
  };
  operationChecks.forEach(input=>input.addEventListener('change',refreshBulkSelection));
  selectAll?.addEventListener('change',()=>{operationChecks.forEach(input=>{input.checked=selectAll.checked});refreshBulkSelection();});
  document.querySelector('[data-clear-selection]')?.addEventListener('click',()=>{operationChecks.forEach(input=>{input.checked=false});refreshBulkSelection();});
  document.querySelector('[data-reverse-selected]')?.addEventListener('click',async event=>{
    const selected=operationChecks.filter(input=>input.checked);
    if(!selected.length)return;
    const numbers=selected.map(input=>`#${input.dataset.operationNumber}`).join(', ');
    if(!confirm(`Estornar ${selected.length} operação(ões) selecionada(s)?\n\n${numbers}\n\nEstoque, Caixa e financeiro serão revertidos individualmente.`))return;
    const reason=prompt('Motivo do estorno em lote (será aplicado a todas):','')||'';
    const button=event.currentTarget;
    const originalText=button.textContent;
    button.disabled=true;
    const failures=[];
    let completed=0;
    for(const input of selected){
      button.textContent=`Estornando ${completed+1} de ${selected.length}...`;
      try{await api(`/erp/pdv/operacoes/${input.value}/estornar`,{reason});completed+=1;}
      catch(error){failures.push(`#${input.dataset.operationNumber}: ${error.message}`);}
    }
    button.textContent=originalText;
    button.disabled=false;
    if(failures.length){
      alert(`${completed} operação(ões) estornada(s).\n\nFalhas:\n${failures.join('\n')}`);
    }else{
      alert(`${completed} operação(ões) estornada(s) com sucesso.`);
    }
    location.reload();
  });
  refreshBulkSelection();
  document.querySelectorAll('[data-duplicate-operation]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm('Duplicar esta operação em uma nova operação aberta?'))return;try{const data=await api(`/erp/pdv/operacoes/${button.dataset.duplicateOperation}/duplicar`);location.href=data.redirectUrl;}catch(error){alert(error.message)}}));
  document.querySelectorAll('[data-cancel-operation]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm('Cancelar esta operação em aberto?'))return;const reason=prompt('Motivo do cancelamento (opcional):','')||'';try{await api(`/erp/pdv/operacoes/${button.dataset.cancelOperation}/cancelar`,{reason,version:Number(button.dataset.version||0)});location.reload();}catch(error){alert(error.message)}}));
  document.querySelectorAll('[data-reverse-operation]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm('Estornar esta operação concluída? Estoque, Caixa e financeiro serão revertidos.'))return;const reason=prompt('Motivo do estorno (opcional):','')||'';try{const data=await api(`/erp/pdv/operacoes/${button.dataset.reverseOperation}/estornar`,{reason});alert(data.message);location.reload();}catch(error){alert(error.message)}}));
});
</script>
