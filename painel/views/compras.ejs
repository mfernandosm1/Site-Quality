d span{font-weight:800;opacity:1}.purchase-item .purchase-sale-field input{border-color:rgba(46,204,113,.75);background:rgba(46,204,113,.08);font-weight:800}.purchase-item .purchase-sale-field input:focus{box-shadow:0 0 0 2px rgba(46,204,113,.16)}.purchase-total{display:flex;justify-content:flex-end;gap:25px;align-items:center;padding:15px}.purchase-total strong{font-size:1.2rem}.purchase-plan{display:grid;gap:10px}.purchase-plan-group{border:1px solid var(--border,#333);border-radius:10px;padding:10px}.purchase-plan-row{display:grid;grid-template-columns:minmax(260px,420px) 120px 90px 150px 40px;gap:8px;align-items:end;justify-content:start}.purchase-plan-row label span{display:block;font-size:.78rem}.purchase-plan-row input,.purchase-plan-row select{width:100%}.purchase-installment-dates{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;margin-top:10px;padding-top:10px;border-top:1px dashed var(--border,#333)}.purchase-installment-date{display:grid;gap:4px}.purchase-installment-date span{font-size:.74rem;opacity:.72}.purchase-installment-date input{width:100%}.purchase-installment-date.is-manual input{border-color:rgba(46,204,113,.65)}.product-result-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:4px;opacity:.78}.purchase-item-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:5px;font-size:.78rem;opacity:.75}.purchase-pricing-hint{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:6px;font-size:.76rem}.purchase-pricing-hint .rule{padding:2px 6px;border-radius:999px;background:rgba(59,130,246,.12);color:#60a5fa}.purchase-pricing-hint .suggested{color:#22c55e;font-weight:800}.purchase-use-suggested{border:1px solid rgba(34,197,94,.45);background:rgba(34,197,94,.08);color:inherit;border-radius:7px;padding:3px 7px;cursor:pointer}.purchase-use-suggested:hover{background:rgba(34,197,94,.16)}.xml-import-body{padding:18px;overflow:auto}.xml-supplier-lock{margin-top:10px;border:1px solid rgba(46,204,113,.45);background:rgba(46,204,113,.08);border-radius:10px;padding:10px 12px}.xml-supplier-lock strong{display:block}.xml-supplier-lock small{opacity:.75}.xml-supplier-missing{margin-top:10px;border:1px solid rgba(255,193,7,.55);background:rgba(255,193,7,.08);border-radius:10px;padding:10px 12px}.xml-supplier-missing p{margin:0 0 8px}.xml-supplier-fixed-note{display:block;margin-top:4px;font-size:.74rem;opacity:.7}.xml-supplier-selected{border:1px solid rgba(46,204,113,.45);background:rgba(46,204,113,.08);border-radius:10px;padding:10px 12px;align-self:end}.xml-supplier-selected>span,.xml-supplier-selected>small{display:block}#supplierSelectField[hidden],#xmlSupplierSelected[hidden]{display:none!important}.xml-supplier-selected>span{font-size:.78rem;opacity:.72;margin-bottom:4px}.xml-supplier-selected>strong{display:block;font-size:.96rem}.xml-supplier-selected>small{margin-top:3px;opacity:.72}.xml-file-field{display:grid;gap:8px}.xml-status{margin-top:10px;opacity:.8}.xml-summary{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:8px;margin-bottom:12px}.xml-summary-search{grid-column:span 2;display:flex!important;align-items:center;gap:8px;padding:7px 10px!important}.xml-summary-search input{width:100%;min-width:180px;background:transparent;color:inherit;border:0;outline:0}.xml-summary-search .xml-search-icon{opacity:.65;flex:0 0 auto}.xml-summary-search .xml-search-clear{border:0;background:transparent;color:inherit;cursor:pointer;opacity:.7;font-size:1rem;padding:2px 5px}.xml-summary-search .xml-search-clear:hover{opacity:1}.xml-summary>div,.xml-item{border:1px solid var(--border,#333);border-radius:10px;padding:10px}.xml-items{display:grid;gap:8px;max-height:none;overflow:visible}.xml-item.pending{border-color:#d7a728}.xml-item.ok{border-color:#2ecc71}.xml-item select{width:100%;margin-top:8px}.xml-product-picker{position:relative}.xml-product-picker input{width:100%;min-height:38px}.xml-product-results{position:absolute;z-index:40;left:0;right:0;top:100%;max-height:220px;overflow:auto;background:var(--card,#111);border:1px solid var(--border,#333);border-radius:8px}.xml-product-results button{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--border,#333);background:transparent;color:inherit;padding:9px}.xml-product-results:empty{display:none}.xml-issuer{margin-bottom:12px}.xml-badge{display:inline-block;padding:3px 8px;border-radius:999px;background:rgba(255,255,255,.08);font-size:.75rem}@media(max-width:800px){.purchase-item,.purchase-plan-row{grid-template-columns:1fr 1fr}.purchase-item .item-name{grid-column:1/-1}}

.xml-product-create-modal{z-index:10040}.xml-product-create-card{width:min(620px,calc(100vw - 28px))}.xml-product-create-card form{padding:18px}.xml-item-actions{display:grid;grid-template-columns:1fr auto auto;gap:8px;margin-top:8px}.xml-item.defined{border-color:#2ecc71}.xml-item.suggested{border-color:#d6a500}.xml-quick-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.xml-defined{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;background:rgba(46,204,113,.14);color:#2ecc71;font-size:.76rem;font-weight:800}.xml-suggestion{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:7px;padding:7px 9px;border:1px solid rgba(214,165,0,.45);border-radius:9px;background:rgba(214,165,0,.08);font-size:.78rem}.xml-suggestion b{color:inherit}.xml-suggestion-reject{min-width:28px!important;padding:3px 7px!important;line-height:1.1}.xml-defined .btn{min-width:24px;padding:1px 5px;margin-left:2px}.purchase-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.purchase-detail-card{border:1px solid var(--border,#333);border-radius:12px;padding:12px;background:var(--card,#111)}@media(max-width:760px){.xml-item-actions,.purchase-detail-grid{grid-template-columns:1fr}}
