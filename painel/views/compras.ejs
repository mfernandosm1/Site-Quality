<% layout('layout') -%>
<%
const safe=v=>JSON.stringify(v||{}).replace(/</g,'\\u003c');
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const statusLabel={draft:'Rascunho',open:'Aberta',completed:'Concluída',reversed:'Estornada'};
const methods=(catalogs.paymentMethods||[]).filter(x=>x.active!==false);
const costCenters=(catalogs.costCenters||[]).filter(x=>x.active!==false);
const accounts=(catalogs.accounts||[]).filter(x=>x.active!==false);
%>
<section class="finance-hero compact purchase-hero"><div><span class="erp-kicker">COMPRAS · v<%= version %></span><h1>🚚 Compras</h1><p>Operações reais com fornecedor, itens, estoque e Contas a Pagar vinculados.</p></div><div class="finance-header-actions"><button class="btn btn-success" id="newPurchase">+ Nova compra</button><button class="btn" id="xmlSoon" title="Importar XML de NF-e para conferência">Importar XML</button></div></section>
<nav class="purchase-tabs" id="purchaseTabs"><button data-status="" class="active">Todas</button><button data-status="open">Abertas</button><button data-status="completed">Concluídas</button><button data-status="reversed">Estornadas</button></nav>
<section class="receivable-filter-panel"><div class="receivable-search-row"><label class="receivable-search"><span>Buscar nas compras e itens</span><input id="purchaseSearch" placeholder="Produto, fornecedor, compra, nota, chave ou usuário"></label><label><span>Fornecedor</span><select id="purchaseSupplier"><option value="">Todos</option><% suppliers.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></label><div class="purchase-period-filter" id="purchasePeriodFilter"><label><span>De</span><div class="quick-date-input"><input type="date" id="purchaseFrom"><button type="button" class="quick-date-trigger" data-quick-date-trigger="from" title="Filtro rápido por período">⌄</button></div></label><label><span>Até</span><div class="quick-date-input"><input type="date" id="purchaseTo"><button type="button" class="quick-date-trigger" data-quick-date-trigger="to" title="Filtro rápido por período">⌄</button></div></label></div><button class="btn btn-ghost" id="clearFilters">Limpar</button></div></section>
<section class="finance-panel"><div class="receivable-list-meta"><strong id="resultCount"><%= purchases.length %> compra(s)</strong><span>Clique em uma linha para abrir os detalhes.</span></div><div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>Nº</th><th>Fornecedor</th><th>Entrada</th><th>Nota</th><th>Itens</th><th>Total</th><th>Situação</th></tr></thead><tbody id="purchaseBody"></tbody></table></div></section>
<script type="application/json" id="purchaseBootstrap"><%- safe({purchases,suppliers,products,catalogs,cashboxes,defaultCashboxId}) %></script>
<div class="receivable-drawer-backdrop" id="purchaseBackdrop" hidden></div><aside class="receivable-drawer" id="purchaseDrawer" aria-hidden="true"><div id="purchaseDetail"></div></aside>
<div class="receivable-modal" id="purchaseModal" hidden><div class="receivable-modal-backdrop" data-close></div><section class="receivable-modal-card purchase-modal-card"><header class="receivable-modal-header"><div><span>COMPRAS</span><h2 id="purchaseTitle">Nova compra</h2><p>Salve para continuar depois ou finalize para integrar Estoque e Contas a Pagar.</p></div><button type="button" data-close>×</button></header><form id="purchaseForm">
<input type="hidden" id="purchaseId"><section class="payable-form-section"><header><h3>Fornecedor e entrada</h3></header><div class="payable-create-grid"><label class="span-2"><span>Fornecedor *</span><select id="supplierId" required><option value="">Selecione</option><% suppliers.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></label><label><span>Entrada *</span><input type="date" id="entryDate" required></label></div><details class="purchase-extra-fields"><summary>+ Dados fiscais adicionais</summary><div class="payable-create-grid"><label><span>Nº da nota</span><input id="invoiceNumber"></label><label><span>Série</span><input id="invoiceSeries"></label><label><span>Emissão</span><input type="date" id="issueDate"></label><label class="span-2"><span>Chave de acesso</span><input id="accessKey" maxlength="44"></label></div></details></section>
<section class="payable-form-section"><header><div><h3>Itens</h3><small>Busque no cadastro mestre; nenhum produto é duplicado.</small></div></header><div class="purchase-product-search"><input id="productSearch" placeholder="Nome, código, barras, referência, marca, modelo ou SKU"><div id="productResults"></div></div><div id="purchaseItems" class="purchase-items"></div></section>
<section class="payable-form-section"><header><div><h3>Valores e financeiro</h3><small>Informe acréscimos, desconto e destino financeiro da compra.</small></div></header><div class="payable-create-grid"><label><span>Frete</span><input id="freight" inputmode="decimal" value="0"></label><label><span>Outras despesas</span><input id="otherExpenses" inputmode="decimal" value="0"></label><label><span>Desconto geral</span><input id="discount" inputmode="decimal" value="0"></label><label><span>Centro de custo</span><select id="costCenterId"><option value="">Não definido</option><% costCenters.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></label><label><span>Plano de contas</span><select id="accountId"><option value="">Não definido</option><% accounts.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></label><label><span>Caixa previsto</span><select id="cashboxId"><% cashboxes.forEach(x=>{ %><option value="<%= x.id %>" <%= x.id===defaultCashboxId?'selected':'' %>><%= x.name %><%= x.isOpen?' · Aberto':' · Fechado' %></option><% }) %></select></label><label class="span-2"><span>Observações</span><textarea id="notes"></textarea></label></div><div class="purchase-total"><span>Total dos produtos <b id="productsTotal">R$ 0,00</b></span><strong>Total da compra <b id="grandTotal">R$ 0,00</b></strong></div></section>
<section class="payable-form-section"><header><div><h3>Plano de pagamento</h3><small>Reaproveita a arquitetura do Contas a Pagar.</small></div><button type="button" class="btn btn-small" id="addPlan">+ Forma</button></header><div id="paymentPlan" class="purchase-plan"></div><small>A soma deve fechar exatamente o total da compra. Dinheiro e PIX são registrados como pagamento imediato no Caixa aberto; boleto e outras formas previstas permanecem no Contas a Pagar.</small></section>
<footer class="receivable-modal-actions"><button type="button" class="btn" data-close>Cancelar</button><button type="submit" class="btn" data-submit-action="save">Salvar</button><button type="submit" class="btn btn-success" data-submit-action="complete">Finalizar compra</button></footer></form></section></div>
<div class="receivable-modal" id="xmlModal" hidden><div class="receivable-modal-backdrop" data-xml-close></div><section class="receivable-modal-card purchase-modal-card"><header class="receivable-modal-header"><div><span>COMPRAS · XML</span><h2>Conferência da NF-e</h2><p>O XML apenas prepara uma compra aberta. Nada será concluído automaticamente.</p></div><button type="button" data-xml-close>×</button></header><div class="xml-import-body"><section class="payable-form-section"><label class="xml-file-field"><span>Selecionar arquivo XML</span><input type="file" id="xmlFile" accept=".xml,text/xml,application/xml"></label><div id="xmlStatus" class="xml-status">Selecione uma NF-e modelo 55 para iniciar a conferência.</div></section><section id="xmlConference" hidden></section></div><footer class="receivable-modal-actions"><button type="button" class="btn" data-xml-close>Cancelar</button><button type="button" class="btn btn-success" id="useXml" disabled>Usar dados na nova compra</button></footer></section></div>
<style>
.purchase-period-filter{display:flex;gap:8px;position:relative}.quick-date-input{display:flex;align-items:stretch}.quick-date-input input{min-width:145px}.quick-date-trigger{width:34px;border:1px solid var(--border,#333);border-left:0;border-radius:0 8px 8px 0;background:var(--card,#111);color:inherit;cursor:pointer}.purchase-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.purchase-tabs button{border:1px solid var(--border,#333);background:var(--card,#111);color:inherit;padding:10px 14px;border-radius:10px}.purchase-tabs button.active{border-color:#2ecc71}.purchase-modal-card{max-width:1100px}.purchase-extra-fields{margin-top:12px;border-top:1px solid var(--border,#333);padding-top:10px}.purchase-extra-fields summary{cursor:pointer;font-weight:700;list-style:none}.purchase-extra-fields summary::-webkit-details-marker{display:none}.purchase-extra-fields[open] summary{margin-bottom:10px}.purchase-product-search{position:relative}.purchase-product-search>input{width:100%}.purchase-product-search #productResults{position:absolute;z-index:20;left:0;right:0;background:var(--card,#111);border:1px solid var(--border,#333);max-height:260px;overflow:auto}.purchase-product-search #productResults button{display:block;width:100%;text-align:left;padding:10px;border:0;border-bottom:1px solid var(--border,#333);background:transparent;color:inherit}.purchase-items{display:grid;gap:8px;margin-top:12px}.purchase-item{display:grid;grid-template-columns:minmax(260px,1fr) 90px 120px 110px 110px 40px;gap:8px;align-items:end;border:1px solid var(--border,#333);padding:10px;border-radius:10px}.purchase-item label span{display:block;font-size:.78rem;opacity:.72}.purchase-item input{width:100%}.purchase-total{display:flex;justify-content:flex-end;gap:25px;align-items:center;padding:15px}.purchase-total strong{font-size:1.2rem}.purchase-plan{display:grid;gap:8px}.purchase-plan-row{display:grid;grid-template-columns:1fr 130px 100px 150px 40px;gap:8px;align-items:end}.purchase-plan-row label span{display:block;font-size:.78rem}.purchase-plan-row input,.purchase-plan-row select{width:100%}.product-result-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:4px;opacity:.78}.purchase-item-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:5px;font-size:.78rem;opacity:.75}.xml-import-body{padding:18px;overflow:auto}.xml-file-field{display:grid;gap:8px}.xml-status{margin-top:10px;opacity:.8}.xml-summary{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:8px;margin-bottom:12px}.xml-summary>div,.xml-item{border:1px solid var(--border,#333);border-radius:10px;padding:10px}.xml-items{display:grid;gap:8px;max-height:380px;overflow:auto}.xml-item.pending{border-color:#d7a728}.xml-item.ok{border-color:#2ecc71}.xml-item select{width:100%;margin-top:8px}.xml-product-picker{position:relative}.xml-product-picker input{width:100%;min-height:38px}.xml-product-results{position:absolute;z-index:40;left:0;right:0;top:100%;max-height:220px;overflow:auto;background:var(--card,#111);border:1px solid var(--border,#333);border-radius:8px}.xml-product-results button{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--border,#333);background:transparent;color:inherit;padding:9px}.xml-product-results:empty{display:none}.xml-issuer{margin-bottom:12px}.xml-badge{display:inline-block;padding:3px 8px;border-radius:999px;background:rgba(255,255,255,.08);font-size:.75rem}@media(max-width:800px){.purchase-item,.purchase-plan-row{grid-template-columns:1fr 1fr}.purchase-item .item-name{grid-column:1/-1}}

.xml-item-actions{display:grid;grid-template-columns:1fr auto auto;gap:8px;margin-top:8px}.xml-item.defined{border-color:#2ecc71}.xml-item.suggested{border-color:#d6a500}.xml-quick-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.xml-defined{display:inline-flex;padding:4px 8px;border-radius:999px;background:rgba(46,204,113,.14);color:#2ecc71;font-size:.76rem;font-weight:800}.purchase-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.purchase-detail-card{border:1px solid var(--border,#333);border-radius:12px;padding:12px;background:var(--card,#111)}@media(max-width:760px){.xml-item-actions,.purchase-detail-grid{grid-template-columns:1fr}}
</style>
<script src="/public/js/quick-date-picker.js?v=1.0.3"></script>
<script>
(()=>{const data=JSON.parse(document.getElementById('purchaseBootstrap').textContent);let purchases=data.purchases||[],items=[],plan=[],statusFilter='',lastPurchaseTotal=0,submitAction='save',submitting=false;const $=s=>document.querySelector(s),methodName=id=>(data.catalogs.paymentMethods||[]).find(x=>x.id===id)?.name||id||'Não informada',eventLabel=type=>({created:'Compra criada',updated:'Compra atualizada',completed:'Compra finalizada',completion_failed:'Falha na finalização',reversed:'Compra estornada',inventory_reconciled:'Estoque da compra reconciliado'}[type]||type),money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}),num=v=>Number(String(v||0).replace(',','.'))||0,esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function filtered(){const q=$('#purchaseSearch').value.toLowerCase(),sup=$('#purchaseSupplier').value,from=$('#purchaseFrom').value,to=$('#purchaseTo').value;return purchases.filter(x=>(!statusFilter||x.status===statusFilter)&&(!sup||x.supplierId===sup)&&(!from||(x.entryDate||'')>=from)&&(!to||(x.entryDate||'')<=to)&&(!q||[x.number,x.supplierName,x.invoiceNumber,x.accessKey,x.createdBy,...(x.items||[]).map(i=>[i.productName,i.productCode,i.sku,i.barcode,i.reference].join(' '))].join(' ').toLowerCase().includes(q)));}
function render(){const rows=filtered();$('#resultCount').textContent=`${rows.length} compra(s)`;$('#purchaseBody').innerHTML=rows.length?rows.map(x=>`<tr data-id="${x.id}" tabindex="0"><td><b>${esc(x.number)}</b></td><td>${esc(x.supplierName)}</td><td>${esc(x.entryDate||'—')}</td><td>${esc(x.invoiceNumber||'—')}</td><td>${(x.items||[]).length}</td><td>${money(x.total)}</td><td><span class="finance-status ${x.status==='completed'?'':'off'}">${statusLabel(x.status)}</span></td></tr>`).join(''):'<tr><td colspan="7" class="empty-state">Nenhuma compra encontrada.</td></tr>';document.querySelectorAll('#purchaseBody tr[data-id]').forEach(r=>r.onclick=()=>detail(r.dataset.id));}
const statusLabel=s=>({draft:'Rascunho',open:'Aberta',completed:'Concluída',reversed:'Estornada'}[s]||s);
function totals(syncPlan=true){const pt=items.reduce((s,i)=>s+num(i.quantity)*num(i.unitCost)-num(i.discount),0),gt=Math.round((pt+num($('#freight').value)+num($('#otherExpenses').value)-num($('#discount').value))*100)/100;$('#productsTotal').textContent=money(pt);$('#grandTotal').textContent=money(gt);if(syncPlan&&plan.length){const sum=Math.round(plan.reduce((s,p)=>s+num(p.value),0)*100)/100;if(plan.length===1){plan[0].value=gt;}else if(Math.abs(sum-lastPurchaseTotal)<.01){plan[plan.length-1].value=Math.round((num(plan[plan.length-1].value)+(gt-lastPurchaseTotal))*100)/100;}document.querySelectorAll('.purchase-plan-row [data-k="value"]').forEach((input,index)=>{if(plan[index])input.value=plan[index].value;});}lastPurchaseTotal=gt;return gt;}
function renderItems(){ $('#purchaseItems').innerHTML=items.map((i,n)=>`<div class="purchase-item" data-n="${n}"><div class="item-name"><b>${esc(i.productName)}</b><small>${esc(i.sku||i.productCode||'Sem código')} · ${i.variationLabel?`Variação: ${esc(i.variationLabel)} · `:''}${i.stockControlled?'Controla estoque':'Sem controle de estoque'}</small></div><label><span>Quantidade</span><input data-k="quantity" value="${i.quantity}"></label><label><span>Custo unit.</span><input data-k="unitCost" value="${i.unitCost}"></label><label><span>Desconto</span><input data-k="discount" value="${i.discount||0}"></label><label><span>Total</span><input disabled value="${money(num(i.quantity)*num(i.unitCost)-num(i.discount))}"></label><button type="button" data-remove>×</button></div>`).join('');document.querySelectorAll('.purchase-item').forEach(row=>{const n=+row.dataset.n;row.querySelectorAll('input[data-k]').forEach(inp=>inp.oninput=()=>{items[n][inp.dataset.k]=num(inp.value);renderItems();});row.querySelector('[data-remove]').onclick=()=>{items.splice(n,1);renderItems();};});totals();}
function renderPlan(){if(!plan.length)plan=[{paymentMethodId:data.catalogs.paymentMethods?.find(x=>x.active!==false)?.id||'',value:totals(false),installmentCount:1,firstDueDate:$('#entryDate').value}];$('#paymentPlan').innerHTML=plan.map((p,n)=>`<div class="purchase-plan-row" data-n="${n}"><label><span>Forma</span><select data-k="paymentMethodId">${(data.catalogs.paymentMethods||[]).filter(x=>x.active!==false).map(x=>`<option value="${x.id}" ${x.id===p.paymentMethodId?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label><label><span>Valor</span><input data-k="value" value="${p.value}"></label><label><span>Parcelas</span><input data-k="installmentCount" type="number" min="1" value="${p.installmentCount||1}"></label><label><span>1º vencimento</span><input data-k="firstDueDate" type="date" value="${p.firstDueDate||''}"></label><button type="button" data-remove>×</button></div>`).join('');document.querySelectorAll('.purchase-plan-row').forEach(r=>{const n=+r.dataset.n;r.querySelectorAll('[data-k]').forEach(inp=>inp.oninput=()=>plan[n][inp.dataset.k]=inp.dataset.k==='value'||inp.dataset.k==='installmentCount'?num(inp.value):inp.value);r.querySelector('[data-remove]').onclick=()=>{plan.splice(n,1);renderPlan();totals();};});}
function openForm(x=null){$('#purchaseForm').reset();$('#productSearch').value='';$('#productResults').innerHTML='';submitAction='save';submitting=false;$('#purchaseId').value=x?.id||'';$('#supplierId').value=x?.supplierId||'';$('#invoiceNumber').value=x?.invoiceNumber||'';$('#invoiceSeries').value=x?.invoiceSeries||'';$('#accessKey').value=x?.accessKey||'';$('#issueDate').value=x?.issueDate||'';$('#entryDate').value=x?.entryDate||new Date().toISOString().slice(0,10);$('#freight').value=x?.freight||0;$('#otherExpenses').value=x?.otherExpenses||0;$('#discount').value=x?.discount||0;$('#costCenterId').value=x?.costCenterId||'';$('#accountId').value=x?.accountId||'';$('#cashboxId').value=x?.cashboxId||data.defaultCashboxId;$('#notes').value=x?.notes||'';items=(x?.items||[]).map(i=>({...i}));plan=(x?.paymentPlan||[]).map(i=>({...i}));lastPurchaseTotal=0;renderItems();renderPlan();totals();const extra=$('.purchase-extra-fields');if(extra)extra.open=Boolean(x?.invoiceNumber||x?.invoiceSeries||x?.accessKey||x?.issueDate);$('#purchaseModal').hidden=false;}
async function detail(id){
  const j=await fetch(`/erp/compras/api/${id}`).then(r=>r.json());
  if(!j.success)return alert(j.message);
  const x=j.item;
  const planRows=(x.paymentPlan||[]).map(p=>`<div class="purchase-detail-card"><div><b>${esc(methodName(p.paymentMethodId))}</b><small>${p.installmentCount||1} parcela(s) · 1º vencimento ${esc(p.firstDueDate||'—')}</small></div><strong>${money(p.value)}</strong></div>`).join('')||'<p class="purchase-detail-empty">Nenhuma composição informada.</p>';
  const paymentRows=(x.payments||[]).flatMap(payment=>(payment.payments||[]).map(row=>`<div class="purchase-detail-card"><div><b>${esc(row.paymentMethodName||methodName(row.paymentMethodId))}</b><small>Pago em ${esc(payment.paidAt||'—')}${payment.paymentNumber?` · ${esc(payment.paymentNumber)}`:''}</small></div><strong>${money(row.value)}</strong></div>`)).join('');
  const itemRows=(x.items||[]).map(i=>`<div class="purchase-detail-item"><div><b>${esc(i.productName)}</b>${i.variationLabel?`<small>${esc(i.variationLabel)}</small>`:''}</div><div class="purchase-detail-item-numbers"><span>${num(i.quantity)} × ${money(i.unitCost)}</span><strong>${money(i.total)}</strong></div></div>`).join('')||'<p class="purchase-detail-empty">Nenhum item informado.</p>';
  const eventRows=(x.events||[]).map(e=>`<div class="purchase-detail-event"><i></i><div><b>${esc(eventLabel(e.type))}</b><small>${new Date(e.createdAt).toLocaleString('pt-BR')} · ${esc(e.actor)}</small></div></div>`).join('')||'<p class="purchase-detail-empty">Nenhum evento registrado.</p>';
  $('#purchaseDetail').innerHTML=`<header class="receivable-drawer-header purchase-detail-header"><div><span>COMPRA</span><h2>${esc(x.number)}</h2><p>${esc(x.supplierName)}</p></div><button id="closeDetail" aria-label="Fechar resumo">×</button></header><div class="receivable-drawer-body purchase-detail-body"><section class="purchase-detail-summary"><div><span>Situação</span><b>${statusLabel(x.status)}</b></div><div><span>Nota</span><b>${esc(x.invoiceNumber||'—')}${x.invoiceSeries?` · Série ${esc(x.invoiceSeries)}`:''}</b></div><div><span>Entrada</span><b>${esc(x.entryDate||'—')}</b></div><div class="is-total"><span>Total</span><b>${money(x.total)}</b></div></section><section class="purchase-detail-section"><h3>Itens <small>${(x.items||[]).length}</small></h3><div class="purchase-detail-list">${itemRows}</div></section><section class="purchase-detail-section"><h3>Plano de pagamento</h3><div class="purchase-detail-list">${planRows}</div></section><section class="purchase-detail-section"><h3>Pagamentos realizados</h3><div class="purchase-detail-list">${paymentRows||'<p class="purchase-detail-empty">Ainda não há pagamento efetivado. Formas não imediatas permanecem no Contas a Pagar.</p>'}</div></section><section class="purchase-detail-section"><h3>Integrações</h3><div class="purchase-detail-integration"><div><span>Conta a pagar</span><b>${esc(x.payable?.number||'Ainda não gerada')}</b><small>${x.payable?esc(x.payable.status==='paid'?'Paga':x.payable.status==='partial'?'Parcial':'Em aberto'):'Aguardando finalização'}</small></div><div><span>Movimentos de estoque</span><b>${(x.inventoryMovements||[]).length}</b><small>movimento(s) vinculado(s)</small></div></div></section><section class="purchase-detail-section"><h3>Histórico</h3><div class="purchase-detail-timeline">${eventRows}</div></section></div><footer class="receivable-drawer-actions purchase-detail-actions">${['draft','open'].includes(x.status)?`<button class="btn" id="editPurchase">Editar</button><button class="btn btn-success" id="completePurchase">Finalizar compra</button>`:''}${x.status==='completed'?'<button class="btn btn-danger" id="reversePurchase">Estornar</button>':''}</footer>`;
  $('#purchaseDrawer').classList.add('open');
  document.body.classList.add('receivable-drawer-open');
  $('#purchaseBackdrop').hidden=false;
  $('#closeDetail').onclick=closeDetail;
  if($('#editPurchase'))$('#editPurchase').onclick=()=>{closeDetail();openForm(x)};
  if($('#completePurchase'))$('#completePurchase').onclick=async()=>{if(!confirm('Finalizar a compra e gerar estoque, Contas a Pagar e os pagamentos imediatos no Caixa?'))return;await action(`/erp/compras/api/${id}/concluir`,{});};
  if($('#reversePurchase'))$('#reversePurchase').onclick=async()=>{const reason=prompt('Informe o motivo do estorno:');if(!reason)return;await action(`/erp/compras/api/${id}/estornar`,{reason});};
}
function closeDetail(){$('#purchaseDrawer').classList.remove('open');document.body.classList.remove('receivable-drawer-open');$('#purchaseBackdrop').hidden=true}async function action(url,body){const j=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>r.json());alert(j.message);if(j.success)location.reload();}
$('#newPurchase').onclick=()=>openForm();document.querySelectorAll('[data-close]').forEach(x=>x.onclick=()=>{$('#purchaseModal').hidden=true;$('#productSearch').value='';$('#productResults').innerHTML='';});$('#purchaseBackdrop').onclick=closeDetail;let xmlConference=null;const closeXml=()=>{$('#xmlModal').hidden=true};document.querySelectorAll('[data-xml-close]').forEach(x=>x.onclick=closeXml);$('#xmlSoon').onclick=()=>{$('#xmlFile').value='';$('#xmlConference').hidden=true;$('#xmlStatus').textContent='Selecione uma NF-e modelo 55 para iniciar a conferência.';$('#useXml').disabled=true;xmlConference=null;$('#xmlModal').hidden=false;};$('#xmlFile').onchange=async()=>{const file=$('#xmlFile').files?.[0];if(!file)return;$('#xmlStatus').textContent='Lendo e conferindo o XML...';try{const xml=await file.text();const j=await fetch('/erp/compras/api/xml/conferir',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({xml})}).then(r=>r.json());if(!j.success)throw new Error(j.message);xmlConference=j.conference;renderXmlConference();$('#useXml').disabled=xmlConference.summary.pendingCount>0||!xmlConference.supplierId;}catch(error){xmlConference=null;$('#xmlConference').hidden=true;$('#useXml').disabled=true;$('#xmlStatus').textContent=error.message||'Não foi possível ler o XML.';}};function refreshXmlState(){xmlConference.summary.matchedCount=xmlConference.items.filter(i=>i.productId).length;xmlConference.summary.definedCount=xmlConference.items.filter(i=>i.defined).length;xmlConference.summary.pendingCount=xmlConference.items.length-xmlConference.summary.definedCount;$('#useXml').disabled=xmlConference.summary.pendingCount>0||!xmlConference.supplierId;}
async function createXmlSupplier(){const x=xmlConference;const name=prompt('Razão social do fornecedor:',x.issuer.name||'');if(!name)return;const j=await fetch('/erp/fornecedores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({personType:(x.issuer.document||'').replace(/\D/g,'').length===11?'pf':'pj',originType:'national',name,tradeName:x.issuer.tradeName||'',document:x.issuer.document||'',stateRegistration:x.issuer.stateRegistration||'',phone:x.issuer.phone||'',mobile:x.issuer.phone||'',zipCode:x.issuer.zipCode||'',street:x.issuer.street||'',number:x.issuer.number||'',complement:x.issuer.complement||'',district:x.issuer.district||'',city:x.issuer.city||'',state:x.issuer.state||'',notes:'Fornecedor cadastrado durante a conferência de XML.',active:true})}).then(r=>r.json());if(!j.success)return alert(j.message);data.suppliers.push(j.supplier);x.supplierId=j.supplier.id;x.supplierMatched=true;renderXmlConference();}
async function createXmlProduct(index){const row=xmlConference.items[index];const name=prompt('Nome do produto:',row.name||'');if(!name)return;const j=await fetch('/erp/compras/api/produtos/rapido',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,code:row.supplierCode,ean:row.ean,ncm:row.ncm,unitCost:row.unitCost})}).then(r=>r.json());if(!j.success)return alert(j.message);data.products.unshift(j.product);row.productId=j.product.id;row.suggestedProductId=j.product.id;row.matched=true;row.defined=true;row.matchReason='Produto cadastrado e vínculo definido';refreshXmlState();const linked=await fetch('/erp/compras/api/xml/vinculos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({issuerDocument:xmlConference.issuer.document,items:[row]})}).then(r=>r.json());if(!linked.success){row.defined=false;alert(linked.message);}renderXmlConference();}
function renderXmlConference(){const x=xmlConference;refreshXmlState();$('#xmlStatus').textContent=`${x.summary.itemCount} item(ns) · ${x.summary.definedCount} definido(s) · ${x.summary.pendingCount} pendente(s)`;$('#xmlConference').hidden=false;$('#xmlConference').innerHTML=`<div class="xml-issuer"><b>${esc(x.issuer.name||'Emitente não identificado')}</b><br><small>${esc(x.issuer.document||'Sem documento')} · NF ${esc(x.invoiceNumber||'—')} série ${esc(x.invoiceSeries||'—')}</small><label><span>Fornecedor vinculado *</span><select id="xmlSupplier"><option value="">Selecione o fornecedor</option>${(data.suppliers||[]).map(s=>`<option value="${s.id}" ${s.id===x.supplierId?'selected':''}>${esc(s.name)}</option>`).join('')}</select></label><div class="xml-quick-actions">${!x.supplierId?'<button type="button" class="btn btn-small" id="createXmlSupplier">+ Cadastrar fornecedor desta NF-e</button>':''}</div></div><div class="xml-summary"><div><small>Itens</small><br><b>${x.summary.itemCount}</b></div><div><small>Sugeridos</small><br><b>${x.summary.matchedCount}</b></div><div><small>Definidos</small><br><b>${x.summary.definedCount}</b></div><div><small>Pendentes</small><br><b>${x.summary.pendingCount}</b></div><div><small>Total do XML</small><br><b>${money(x.documentTotal)}</b></div></div><div class="xml-items">${x.items.map((i,n)=>`<div class="xml-item ${i.defined?'defined':i.productId?'suggested':'pending'}"><b>${esc(i.name)}</b><br><small>${esc(i.supplierCode||'Sem código')} · ${i.quantity} ${esc(i.unit)} × ${money(i.unitCost)} · NCM ${esc(i.ncm||'—')} · CFOP ${esc(i.cfop||'—')}</small><span class="xml-badge">${esc(i.matchReason)}</span>${i.defined?'<span class="xml-defined">✓ Vínculo definido</span>':''}<div class="xml-item-actions"><div class="xml-product-picker"><input type="search" data-xml-search="${n}" placeholder="Digite nome, código, referência, EAN ou variação..." value="${esc((data.products||[]).find(p=>p.id===i.productId)?.name||'')}" autocomplete="off"><div class="xml-product-results" data-xml-results="${n}"></div></div><button type="button" class="btn btn-small" data-xml-define="${n}" ${!i.productId?'disabled':''}>Definir</button><button type="button" class="btn btn-small" data-xml-create="${n}">+ Produto</button></div></div>`).join('')}</div>`;
$('#xmlSupplier').onchange=()=>{xmlConference.supplierId=$('#xmlSupplier').value;xmlConference.supplierMatched=!!xmlConference.supplierId;refreshXmlState();};if($('#createXmlSupplier'))$('#createXmlSupplier').onclick=createXmlSupplier;document.querySelectorAll('[data-xml-search]').forEach(input=>{const index=+input.dataset.xmlSearch;const results=document.querySelector(`[data-xml-results="${index}"]`);const show=()=>{const q=input.value.trim().toLowerCase();const found=(data.products||[]).filter(p=>!q||[p.name,p.code,p.sku,p.barcode,p.reference,p.brand,p.model,p.variationLabel].join(' ').toLowerCase().includes(q)).slice(0,30);results.innerHTML=found.map(p=>`<button type="button" data-xml-choice="${esc(p.id)}"><b>${esc(p.name)}</b><small>${esc(p.sku||p.code||'Sem código')} · estoque ${num(p.currentStock)}${p.variationConfigurationPending?' · grade de variações ainda não criada':''}</small></button>`).join('')||'<div class="empty-state">Nenhum produto encontrado.</div>';results.querySelectorAll('[data-xml-choice]').forEach(button=>button.onclick=()=>{const row=xmlConference.items[index];row.productId=button.dataset.xmlChoice;row.matched=true;row.defined=false;row.matchReason='Produto selecionado; clique em Definir';renderXmlConference();});};input.onfocus=show;input.oninput=()=>{const row=xmlConference.items[index];row.productId='';row.matched=false;row.defined=false;row.matchReason='Pesquisando produto';refreshXmlState();show();};});document.querySelectorAll('[data-xml-create]').forEach(button=>button.onclick=()=>createXmlProduct(+button.dataset.xmlCreate));document.querySelectorAll('[data-xml-define]').forEach(button=>button.onclick=async()=>{const row=xmlConference.items[+button.dataset.xmlDefine];if(!row.productId)return;row.defined=true;row.matchReason='Vínculo confirmado';refreshXmlState();const j=await fetch('/erp/compras/api/xml/vinculos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({issuerDocument:x.issuer.document,items:[row]})}).then(r=>r.json());if(!j.success){row.defined=false;alert(j.message);}renderXmlConference();});};$('#useXml').onclick=()=>{try{if(!xmlConference)return;const x=xmlConference;if(x.summary.pendingCount>0)throw new Error('Defina todos os itens antes de preencher a compra.');if(!x.supplierId)throw new Error('Selecione ou cadastre o fornecedor.');const mapped=x.items.map(row=>{const p=data.products.find(item=>item.id===row.productId);if(!p)throw new Error(`O produto vinculado ao item ${row.name} não está mais disponível. Refaça o vínculo.`);return {...p,selectionId:p.id,productId:p.parentProductId||p.productId||p.id,productName:p.name,productCode:p.code,inventoryItemId:p.inventoryItemId,variationLabel:p.variationLabel||'',quantity:row.quantity,unitCost:row.unitCost,discount:0,fiscal:{supplierCode:row.supplierCode,ean:row.ean,ncm:row.ncm,cest:row.cest,cfop:row.cfop,unit:row.unit,taxes:row.taxes}}});openForm({supplierId:x.supplierId,invoiceNumber:x.invoiceNumber,invoiceSeries:x.invoiceSeries,accessKey:x.accessKey,issueDate:x.issueDate,entryDate:x.entryDate||new Date().toISOString().slice(0,10),freight:x.freight,otherExpenses:x.otherExpenses,discount:x.discount,items:mapped,paymentPlan:[],notes:`Importada da NF-e ${x.invoiceNumber||''}${x.accessKey?` · Chave ${x.accessKey}`:''}`,fiscalDocument:{model:'55',xmlVersion:'4.00',protocol:x.protocol||'',issuer:x.issuer,taxes:x.taxes||{}}});closeXml();const extra=$('.purchase-extra-fields');if(extra)extra.open=true;$('#productSearch').focus();}catch(error){alert(error.message||'Não foi possível usar os dados do XML.');}};
$('#productSearch').oninput=()=>{const q=$('#productSearch').value.toLowerCase();const found=(data.products||[]).filter(p=>[p.name,p.code,p.sku,p.barcode,p.reference,p.brand,p.model].join(' ').toLowerCase().includes(q)).slice(0,20);$('#productResults').innerHTML=q?found.map(p=>`<button type="button" data-product="${p.id}"><b>${esc(p.name)}</b><div class="product-result-meta"><span>${esc(p.sku||p.code||'Sem código')}</span><span>Estoque ${num(p.currentStock)}</span><span>Último custo ${money(p.currentCost)}</span><span>Venda ${money(p.salePrice)}</span>${p.marginPercent!=null?`<span>Margem ${num(p.marginPercent).toFixed(2)}%</span>`:''}${p.variationConfigurationPending?'<span>Variações configuradas, mas a grade ainda não foi criada</span>':''}</div></button>`).join(''):'';document.querySelectorAll('[data-product]').forEach(b=>b.onclick=()=>{const p=data.products.find(x=>x.id===b.dataset.product);if(!items.some(i=>(i.selectionId||i.productId)===p.id))items.push({...p,selectionId:p.id,productId:p.parentProductId||p.productId||p.id,productName:p.name,productCode:p.code,inventoryItemId:p.inventoryItemId,variationLabel:p.variationLabel||'',quantity:1,unitCost:p.currentCost||0,discount:0});$('#productSearch').value='';$('#productResults').innerHTML='';renderItems();});};
document.addEventListener('click',event=>{if(!event.target.closest('.purchase-product-search'))$('#productResults').innerHTML='';if(!event.target.closest('.xml-product-picker'))document.querySelectorAll('.xml-product-results').forEach(box=>box.innerHTML='');});
['freight','otherExpenses','discount'].forEach(id=>$('#'+id).oninput=totals);$('#addPlan').onclick=()=>{plan.push({paymentMethodId:data.catalogs.paymentMethods?.find(x=>x.active!==false)?.id||'',value:0,installmentCount:1,firstDueDate:$('#entryDate').value});renderPlan();};
document.querySelectorAll('[data-submit-action]').forEach(button=>button.onclick=()=>submitAction=button.dataset.submitAction);$('#purchaseForm').onsubmit=async e=>{e.preventDefault();if(submitting)return;if(submitAction==='complete'&&!confirm('Finalizar esta compra agora? O estoque, o Contas a Pagar e os pagamentos imediatos serão integrados ao Caixa.'))return;submitting=true;const submitButtons=[...document.querySelectorAll('[data-submit-action]')];submitButtons.forEach(button=>button.disabled=true);const payload={id:$('#purchaseId').value,status:'open',supplierId:$('#supplierId').value,invoiceNumber:$('#invoiceNumber').value,invoiceSeries:$('#invoiceSeries').value,accessKey:$('#accessKey').value,issueDate:$('#issueDate').value,entryDate:$('#entryDate').value,items,freight:num($('#freight').value),otherExpenses:num($('#otherExpenses').value),discount:num($('#discount').value),costCenterId:$('#costCenterId').value,accountId:$('#accountId').value,cashboxId:$('#cashboxId').value,notes:$('#notes').value,paymentPlan:plan};try{const j=await fetch('/erp/compras/api',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(r=>r.json());if(!j.success){alert(j.message);return;}if(submitAction==='complete'){const completed=await fetch(`/erp/compras/api/${j.item.id}/concluir`,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).then(r=>r.json());alert(completed.message);if(completed.success)location.reload();return;}alert(j.message);location.reload();}catch(error){alert(error.message||'Não foi possível salvar a compra.');}finally{submitting=false;submitButtons.forEach(button=>button.disabled=false);}};
$('#purchaseTabs').onclick=e=>{if(!e.target.dataset.status&&e.target.dataset.status!=='')return;document.querySelectorAll('#purchaseTabs button').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');statusFilter=e.target.dataset.status;render();};['purchaseSearch','purchaseSupplier','purchaseFrom','purchaseTo'].forEach(id=>{$('#'+id).oninput=render;$('#'+id).onchange=render;});$('#clearFilters').onclick=()=>{['purchaseSearch','purchaseSupplier','purchaseFrom','purchaseTo'].forEach(id=>$('#'+id).value='');render();};if(window.QualityQuickDatePicker)window.QualityQuickDatePicker.init({from:'#purchaseFrom',to:'#purchaseTo',wrapper:'#purchasePeriodFilter',mode:'operations'});render();})();
</script>
