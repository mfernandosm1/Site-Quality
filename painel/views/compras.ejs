$('#xmlProductCreateForm').onsubmit=async event=>{event.preventDefault();const index=xmlQuickProductIndex,row=xmlConference?.items?.[index];if(!row)return closeXmlProductCreate();const name=$('#xmlQuickProductName').value.trim(),categoryId=$('#xmlQuickProductCategory').value;if(!name)return alert('Informe o nome do produto.');if(!categoryId)return alert('Selecione a categoria ERP do produto.');const submit=event.submitter;if(submit)submit.disabled=true;try{const j=await fetch('/erp/compras/api/produtos/rapido',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,categoryId,code:row.supplierCode,ean:row.ean,ncm:row.ncm,unitCost:row.unitCost})}).then(r=>r.json());if(!j.success)throw new Error(j.message||'Não foi possível cadastrar o produto.');data.products.unshift(j.product);row.productId=j.product.id;row.linkedProduct=j.product;row.suggestedProductId=j.product.id;row.matched=true;row.defined=true;row.matchReason='Produto cadastrado com categoria e vínculo definido';refreshXmlState();const linked=await fetch('/erp/compras/api/xml/vinculos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({issuerDocument:xmlConference.issuer.document,items:[row]})}).then(r=>r.json());if(!linked.success){row.defined=false;throw new Error(linked.message||'Produto criado, mas não foi possível salvar o vínculo do XML.');}closeXmlProductCreate();renderXmlConference();}catch(error){alert(error.message||'Não foi possível cadastrar o produto.');}finally{if(submit)submit.disabled=false;}};
function renderXmlConference(){const previousScroll=document.querySelector('.xml-items')?.scrollTop||0;const x=xmlConference;refreshXmlState();$('#xmlStatus').textContent=`${x.summary.itemCount} item(ns) · ${x.summary.definedCount} definido(s) · ${x.summary.pendingCount} pendente(s)`;$('#xmlConference').hidden=false;$('#xmlConference').innerHTML=`<div class="xml-issuer"><b>${esc(x.issuer.name||'Emitente não identificado')}</b><br><small>${esc(x.issuer.document||'Sem documento')} · NF ${esc(x.invoiceNumber||'—')} série ${esc(x.invoiceSeries||'—')}</small>${x.supplierId?`<div class="xml-supplier-lock"><small>Fornecedor identificado pelo CPF/CNPJ da NF-e</small><strong>${esc(x.supplier?.name||(data.suppliers||[]).find(s=>String(s.id)===String(x.supplierId))?.name||x.issuer.name||'Fornecedor')}</strong><small>${esc(x.issuer.document||'')}</small></div>`:`<div class="xml-supplier-missing"><p><b>Fornecedor ainda não cadastrado.</b><br><small>O ERP procurou pelo CPF/CNPJ ${esc(x.issuer.document||'do emitente')} e não encontrou cadastro correspondente.</small></p><button type="button" class="btn btn-small" id="createXmlSupplier">+ Cadastrar fornecedor com os dados da NF-e</button></div>`}</div><div class="xml-summary"><div><small>Itens</small><br><b>${x.summary.itemCount}</b></div><div><small>Sugeridos</small><br><b>${x.summary.matchedCount}</b></div><div><small>Definidos</small><br><b>${x.summary.definedCount}</b></div><div><small>Pendentes</small><br><b>${x.summary.pendingCount}</b></div><div><small>Total do XML</small><br><b>${money(x.documentTotal)}</b></div><div class="xml-summary-search"><span class="xml-search-icon">🔎</span><input type="search" id="xmlItemFilter" placeholder="Buscar no XML..." value="${esc(xmlItemFilter)}" autocomplete="off"><button type="button" class="xml-search-clear" id="xmlItemFilterClear" title="Limpar busca" aria-label="Limpar busca" ${xmlItemFilter?'':'hidden'}>×</button></div></div><div class="xml-items">${x.items.map((i,n)=>({i,n})).filter(({i})=>{const q=xmlItemFilter;if(!QualitySearch.normalize(q))return true;const linked=(data.products||[]).find(p=>p.id===i.productId||p.id===i.suggestedProductId);return QualitySearch.matches([i.name,i.supplierCode,i.ean,i.ncm,i.cfop,i.unit,linked?.name,linked?.code,linked?.sku,linked?.barcode,linked?.reference,linked?.brand,linked?.model].filter(Boolean).join(' '),q)}).map(({i,n})=>`<div class="xml-item ${i.defined?'defined':i.productId?'suggested':'pending'}"><b>${esc(i.name)}</b><br><small>${esc(i.supplierCode||'Sem código')} · ${i.quantity} ${esc(i.unit)} × ${money(i.unitCost)} · NCM ${esc(i.ncm||'—')} · CFOP ${esc(i.cfop||'—')}</small><span class="xml-badge">${esc(i.matchReason)}</span>${i.defined?`<span class="xml-defined">✓ Vínculo definido <button type="button" class="btn btn-small" data-xml-forget="${n}" title="Esquecer vínculo aprendido" aria-label="Esquecer vínculo aprendido">×</button></span>`:''}${!i.defined&&i.suggestedProductId?`<div class="xml-suggestion"><span>💡 ERP sugere: <b>${esc((data.products||[]).find(p=>p.id===i.suggestedProductId)?.name||'Produto sugerido')}</b> · ${esc(i.matchReason)}</span><button type="button" class="btn btn-small xml-suggestion-reject" data-xml-reject="${n}" title="Descartar esta sugestão" aria-label="Descartar esta sugestão">×</button></div>`:''}<div class="xml-item-actions"><div class="xml-product-picker"><input type="search" data-xml-search="${n}" placeholder="Digite nome, código, referência, EAN ou variação..." value="${esc((data.products||[]).find(p=>p.id===i.productId)?.name||'')}" autocomplete="off"><div class="xml-product-results" data-xml-results="${n}"></div></div><button type="button" class="btn btn-small" data-xml-define="${n}" ${!i.productId?'disabled':''}>Definir</button><button type="button" class="btn btn-small" data-xml-create="${n}">+ Produto</button></div></div>`).join('')}</div>`;
const xmlFilterInput=$('#xmlItemFilter');if(xmlFilterInput){xmlFilterInput.oninput=()=>{xmlItemFilter=xmlFilterInput.value;const q=xmlItemFilter;document.querySelectorAll('.xml-item').forEach(card=>{card.hidden=!QualitySearch.matches(card.textContent,q);});const clear=$('#xmlItemFilterClear');if(clear)clear.hidden=!xmlItemFilter;};}if($('#xmlItemFilterClear'))$('#xmlItemFilterClear').onclick=()=>{xmlItemFilter='';renderXmlConference();requestAnimationFrame(()=>$('#xmlItemFilter')?.focus());};if($('#createXmlSupplier'))$('#createXmlSupplier').onclick=createXmlSupplier;document.querySelectorAll('[data-xml-search]').forEach(input=>{const index=+input.dataset.xmlSearch;const results=document.querySelector(`[data-xml-results="${index}"]`);let timer=null,seq=0;const renderResults=found=>{results.innerHTML=found.map(p=>`<button type="button" data-xml-choice="${esc(p.id)}"><b>${esc(p.name)}</b><small>${esc(p.sku||p.code||'Sem código')} · estoque ${num(p.currentStock)}${p.variationConfigurationPending?' · grade de variações ainda não criada':''}</small></button>`).join('')||'<div class="empty-state">Nenhum produto encontrado.</div>';results.querySelectorAll('[data-xml-choice]').forEach(button=>button.onclick=()=>{const row=xmlConference.items[index];row.productId=button.dataset.xmlChoice;row.linkedProduct=(data.products||[]).find(p=>String(p.id)===String(row.productId))||null;row.suggestedProductId='';row.matched=true;row.defined=false;row.matchReason='Produto selecionado; clique em Definir';renderXmlConference();});};const show=async()=>{const q=String(input.value||'').trim(),currentSeq=++seq;results.innerHTML='<div class="empty-state">Atualizando produtos...</div>';try{const found=await fetchFreshPurchaseProducts(q,30);if(currentSeq!==seq||!input.isConnected||String(input.value||'').trim()!==q)return;renderResults(found);}catch(error){if(currentSeq!==seq||!input.isConnected||String(input.value||'').trim()!==q)return;console.warn('Compras XML: catálogo de produtos não pôde ser atualizado automaticamente.',error);const fallback=(data.products||[]).filter(p=>QualitySearch.matches([p.name,p.searchAlias,p.code,p.sku,p.barcode,p.reference,p.brand,p.model,p.variationLabel].join(' '),q)).slice(0,30);renderResults(fallback);}};const schedule=()=>{seq++;if(timer)clearTimeout(timer);timer=setTimeout(()=>{timer=null;show();},120);};input.onfocus=()=>{if(timer){clearTimeout(timer);timer=null;}show();};input.oninput=()=>{const row=xmlConference.items[index];row.productId='';row.linkedProduct=null;row.suggestedProductId='';row.matched=false;row.defined=false;row.matchReason='Pesquisando produto';refreshXmlState();schedule();};});document.querySelectorAll('[data-xml-create]').forEach(button=>button.onclick=()=>createXmlProduct(+button.dataset.xmlCreate));document.querySelectorAll('[data-xml-reject]').forEach(button=>button.onclick=async()=>{const row=xmlConference.items[+button.dataset.xmlReject];if(!row||row.defined||!row.suggestedProductId)return;const rejectedProductId=row.suggestedProductId;button.disabled=true;try{const j=await fetch('/erp/compras/api/xml/sugestoes/rejeitar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({issuerDocument:x.issuer.document,supplierCode:row.supplierCode,ean:row.ean,name:row.name,productId:rejectedProductId})}).then(r=>r.json());if(!j.success)throw new Error(j.message||'Não foi possível descartar a sugestão.');row.productId='';row.suggestedProductId='';row.matched=false;row.defined=false;row.matchReason='Sugestão descartada · pesquise ou cadastre o produto';refreshXmlState();renderXmlConference();}catch(error){button.disabled=false;alert(error.message||'Não foi possível descartar a sugestão.');}});document.querySelectorAll('[data-xml-forget]').forEach(button=>button.onclick=async()=>{const row=xmlConference.items[+button.dataset.xmlForget];if(!row||!row.defined)return;if(!confirm('Esquecer este vínculo aprendido? O produto não será excluído e compras anteriores não serão alteradas.'))return;button.disabled=true;try{const j=await fetch('/erp/compras/api/xml/vinculos/esquecer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({issuerDocument:x.issuer.document,supplierCode:row.supplierCode,ean:row.ean,name:row.name})}).then(r=>r.json());if(!j.success)throw new Error(j.message||'Não foi possível remover o vínculo.');row.productId='';row.linkedProduct=null;row.suggestedProductId='';row.matched=false;row.defined=false;row.matchReason='Não vinculado';refreshXmlState();renderXmlConference();}catch(error){button.disabled=false;alert(error.message||'Não foi possível remover o vínculo aprendido.');}});document.querySelectorAll('[data-xml-define]').forEach(button=>button.onclick=async()=>{const row=xmlConference.items[+button.dataset.xmlDefine];if(!row.productId)return;row.defined=true;row.matchReason='Vínculo confirmado';refreshXmlState();const j=await fetch('/erp/compras/api/xml/vinculos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({issuerDocument:x.issuer.document,items:[row]})}).then(r=>r.json());if(!j.success){row.defined=false;alert(j.message);}renderXmlConference();});requestAnimationFrame(()=>{const list=document.querySelector('.xml-items');if(list)list.scrollTop=previousScroll;});};$('#useXml').onclick=()=>{try{if(!xmlConference)return;const x=xmlConference;if(x.summary.pendingCount>0)throw new Error('Defina todos os itens antes de preencher a compra.');if(!x.supplierId)throw new Error('Selecione ou cadastre o fornecedor.');const mapped=x.items.map(row=>{const p=(row.linkedProduct&&String(row.linkedProduct.id)===String(row.productId)?row.linkedProduct:null)||data.products.find(item=>String(item.id)===String(row.productId));if(!p)throw new Error(`O produto vinculado ao item ${row.name} não está mais disponível. Refaça o vínculo.`);return {...p,selectionId:p.id,productId:p.parentProductId||p.productId||p.id,productName:p.name,productCode:p.code,inventoryItemId:p.inventoryItemId,variationLabel:p.variationLabel||'',quantity:row.quantity,unitCost:row.unitCost,salePrice:p.salePrice||0,discount:0,fiscal:{supplierCode:row.supplierCode,ean:row.ean,ncm:row.ncm,cest:row.cest,cfop:row.cfop,unit:row.unit,taxes:row.taxes}}});openForm({supplierId:x.supplierId,supplier:x.supplier||null,supplierName:x.supplier?.name||x.issuer?.name||'',supplierDocument:x.supplier?.document||x.issuer?.document||'',lockSupplier:true,invoiceNumber:x.invoiceNumber,invoiceSeries:x.invoiceSeries,accessKey:x.accessKey,issueDate:x.issueDate,entryDate:x.entryDate||(window.QualityDate?.today?.()||new Date().toLocaleDateString('en-CA')),freight:x.freight,otherExpenses:x.otherExpenses,discount:x.discount,items:mapped,paymentPlan:[],notes:`Importada da NF-e ${x.invoiceNumber||''}${x.accessKey?` · Chave ${x.accessKey}`:''}`,fiscalDocument:{model:'55',xmlVersion:'4.00',protocol:x.protocol||'',issuer:x.issuer,taxes:x.taxes||{}}});closeXml();const extra=$('.purchase-extra-fields');if(extra)extra.open=true;$('#productSearch').focus();}catch(error){alert(error.message||'Não foi possível usar os dados do XML.');}};
function localPurchaseProductSearch(q=''){return (data.products||[]).filter(p=>QualitySearch.matches([p.name,p.searchAlias,p.code,p.sku,p.barcode,p.reference,p.brand,p.model,p.variationLabel].join(' '),q)).slice(0,20);}
function mergeFreshPurchaseProducts(found=[]){for(const product of found){if(!product?.id)continue;const index=(data.products||[]).findIndex(item=>String(item.id)===String(product.id));if(index>=0)data.products[index]={...data.products[index],...product};else data.products.unshift(product);}}
async function fetchFreshPurchaseProducts(q='',limit=30){const normalizedQuery=String(q||'').trim();const response=await fetch(`/erp/compras/api/produtos?q=${encodeURIComponent(normalizedQuery)}&_=${Date.now()}`,{headers:{Accept:'application/json','Cache-Control':'no-cache'},cache:'no-store'});const result=await response.json().catch(()=>({}));if(!response.ok||result.success===false)throw new Error(result.message||'Não foi possível atualizar os produtos.');const found=Array.isArray(result.items)?result.items.slice(0,limit):[];mergeFreshPurchaseProducts(found);return found;}
function renderPurchaseProductResults(found=[],q=''){const results=$('#productResults');purchaseProductSearchResults=new Map((found||[]).map(product=>[String(product.id),product]));results.innerHTML=q?(found||[]).map(p=>`<button type="button" data-product="${esc(p.id)}"><b>${esc(p.name)}</b><div class="product-result-meta"><span>${esc(p.sku||p.code||'Sem código')}</span><span>Estoque ${num(p.currentStock)}</span><span>Último custo ${money(p.currentCost)}</span><span>Venda ${money(p.salePrice)}</span>${p.marginPercent!=null?`<span>Margem atual ${num(p.marginPercent).toFixed(2)}%</span>`:''}${p.targetMarginPercent!=null?`<span>Alvo ${num(p.targetMarginPercent).toFixed(2)}% · ${esc(p.pricingRuleSource||'')}</span>`:''}${p.suggestedSalePrice!=null?`<span>Sugerido ${money(p.suggestedSalePrice)}</span>`:''}${p.variationConfigurationPending?'<span>Variações configuradas, mas a grade ainda não foi criada</span>':''}</div></button>`).join(''):'';results.querySelectorAll('[data-product]').forEach(button=>button.onclick=()=>{const p=purchaseProductSearchResults.get(String(button.dataset.product))||(data.products||[]).find(x=>String(x.id)===String(button.dataset.product));if(!p)return;if(!items.some(i=>String(i.selectionId||i.productId)===String(p.id)))items.push({...p,selectionId:p.id,productId:p.parentProductId||p.productId||p.id,productName:p.name,productCode:p.code,inventoryItemId:p.inventoryItemId,variationLabel:p.variationLabel||'',quantity:1,unitCost:p.currentCost||0,salePrice:p.salePrice||0,discount:0});$('#productSearch').value='';results.innerHTML='';purchaseProductSearchResults.clear();renderItems();});}
async function refreshPurchaseProductSearch(){const input=$('#productSearch'),q=String(input?.value||'').trim();if(!q){purchaseProductSearchSeq++;renderPurchaseProductResults([],q);return [];}const seq=++purchaseProductSearchSeq;renderPurchaseProductResults([],q);try{const found=await fetchFreshPurchaseProducts(q,20);if(seq!==purchaseProductSearchSeq||String(input.value||'').trim()!==q)return [];renderPurchaseProductResults(found,q);return found;}catch(error){if(seq!==purchaseProductSearchSeq||String(input?.value||'').trim()!==q)return [];console.warn('Compras: catálogo de produtos não pôde ser atualizado automaticamente.',error);const fallback=localPurchaseProductSearch(q);renderPurchaseProductResults(fallback,q);return fallback;}}
function schedulePurchaseProductSearch(){const q=String($('#productSearch')?.value||'').trim();purchaseProductSearchSeq++;if(purchaseProductSearchTimer)clearTimeout(purchaseProductSearchTimer);renderPurchaseProductResults([],q);if(!q)return;purchaseProductSearchTimer=setTimeout(()=>{purchaseProductSearchTimer=null;refreshPurchaseProductSearch();},120);}
$('#productSearch').oninput=schedulePurchaseProductSearch;
$('#productSearch').onfocus=()=>{if(String($('#productSearch').value||'').trim())refreshPurchaseProductSearch();};
window.addEventListener('focus',()=>{if(document.activeElement===$('#productSearch')&&String($('#productSearch').value||'').trim())refreshPurchaseProductSearch();const xmlInput=document.activeElement;if(xmlInput?.matches?.('[data-xml-search]'))xmlInput.onfocus?.();});
document.addEventListener('visibilitychange',()=>{if(document.visibilityState!=='visible')return;if(String($('#productSearch')?.value||'').trim())refreshPurchaseProductSearch();const xmlInput=document.activeElement;if(xmlInput?.matches?.('[data-xml-search]'))xmlInput.onfocus?.();});
window.addEventListener('pageshow',()=>{if(String($('#productSearch')?.value||'').trim())refreshPurchaseProductSearch();const xmlInput=document.activeElement;if(xmlInput?.matches?.('[data-xml-search]'))xmlInput.onfocus?.();});
document.addEventListener('click',event=>{if(!event.target.closest('.purchase-product-search'))$('#productResults').innerHTML='';if(!event.target.closest('.xml-product-picker'))document.querySelectorAll('.xml-product-results').forEach(box=>box.innerHTML='');});
['freight','otherExpenses','discount'].forEach(id=>$('#'+id).oninput=totals);$('#addPlan').onclick=()=>{const total=totals(false);const informed=Math.round(plan.reduce((sum,row)=>sum+num(row.value),0)*100)/100;const remaining=Math.max(0,Math.round((total-informed)*100)/100);plan.push({paymentMethodId:data.catalogs.paymentMethods?.find(x=>x.active!==false&&x.modules?.purchases!==false)?.id||'',value:remaining,installmentCount:1,firstDueDate:$('#entryDate').value,installmentDueDates:[]});renderPlan();};
document.querySelectorAll('[data-submit-action]').forEach(button=>button.onclick=()=>submitAction=button.dataset.submitAction);$('#purchaseForm').onsubmit=async e=>{e.preventDefault();if(submitting)return;if(submitAction==='complete'&&!confirm('Finalizar esta compra agora? O estoque, o Contas a Pagar e os pagamentos imediatos serão integrados ao Caixa.'))return;submitting=true;const submitButtons=[...document.querySelectorAll('[data-submit-action]')];submitButtons.forEach(button=>button.disabled=true);const normalizedItems=items.map(item=>({...item,quantity:num(item.quantity),unitCost:num(item.unitCost),discount:num(item.discount),salePrice:num(item.salePrice)}));const payload={id:$('#purchaseId').value,status:'open',supplierId:currentXmlImport?.supplierId||$('#supplierId').value,xmlSupplierDocument:currentXmlImport?.supplierDocument||'',fiscalDocument:currentXmlImport?.fiscalDocument||undefined,invoiceNumber:$('#invoiceNumber').value,invoiceSeries:$('#invoiceSeries').value,accessKey:$('#accessKey').value,issueDate:$('#issueDate').value,entryDate:$('#entryDate').value,items:normalizedItems,freight:num($('#freight').value),otherExpenses:num($('#otherExpenses').value),discount:num($('#discount').value),accountId:$('#accountId').value,cashboxId:$('#cashboxId').value,notes:$('#notes').value,paymentPlan:plan};try{const j=await fetch('/erp/compras/api',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(r=>r.json());if(!j.success){alert(j.message);return;}if(submitAction==='complete'){const completed=await fetch(`/erp/compras/api/${j.item.id}/concluir`,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).then(r=>r.json());alert(completed.message);if(completed.success)location.reload();return;}alert(j.message);location.reload();}catch(error){alert(error.message||'Não foi possível salvar a compra.');}finally{submitting=false;submitButtons.forEach(button=>button.disabled=false);}};
$('#purchaseTabs').onclick=e=>{if(!e.target.dataset.status&&e.target.dataset.status!=='')return;document.querySelectorAll('#purchaseTabs button').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');statusFilter=e.target.dataset.status;render();};['purchaseSearch','purchaseSupplier','purchaseFrom','purchaseTo'].forEach(id=>{$('#'+id).oninput=render;$('#'+id).onchange=render;});$('#clearFilters').onclick=()=>{['purchaseSearch','purchaseSupplier','purchaseFrom','purchaseTo'].forEach(id=>$('#'+id).value='');render();};if(window.QualityQuickDatePicker)window.QualityQuickDatePicker.init({from:'#purchaseFrom',to:'#purchaseTo',wrapper:'#purchasePeriodFilter',mode:'operations'});render();})();
</script>
