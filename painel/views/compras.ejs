<script src="/public/js/quick-date-picker.js?v=1.0.3"></script>
<script>
(()=>{const data=JSON.parse(document.getElementById('purchaseBootstrap').textContent);function upsertSupplier(supplier){if(!supplier?.id)return null;const index=(data.suppliers||[]).findIndex(x=>String(x.id)===String(supplier.id));if(index>=0)data.suppliers[index]={...data.suppliers[index],...supplier};else data.suppliers.push(supplier);return supplier;}window.addEventListener('quality:supplier-created',e=>{const supplier=upsertSupplier(e.detail?.supplier);if(supplier)ensureSupplierOption(supplier.id);});let purchases=data.purchases||[],items=[],plan=[],statusFilter='',lastPurchaseTotal=0,submitAction='save',submitting=false,currentXmlImport=null,xmlQuickProductIndex=null,purchaseProductSearchTimer=null,purchaseProductSearchSeq=0,purchaseProductSearchResults=new Map();const $=s=>document.querySelector(s),ref=value=>String(value??'').replace(/\b([A-Z]{1,5})-0+(\d+)\b/g,'$1-$2'),methodName=id=>(data.catalogs.paymentMethods||[]).find(x=>x.id===id)?.name||id||'Não informada',eventLabel=type=>({created:'Compra criada',updated:'Compra atualizada',completed:'Compra finalizada',completion_failed:'Falha na finalização',reversed:'Compra estornada',inventory_reconciled:'Estoque da compra reconciliado'}[type]||type),money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}),num=v=>{if(typeof v==='number')return Number.isFinite(v)?v:0;let s=String(v??'').trim().replace(/\s+/g,'').replace(/R\$/gi,'').replace(/[^0-9,.-]/g,'');if(!s)return 0;const lastComma=s.lastIndexOf(','),lastDot=s.lastIndexOf('.');if(lastComma>-1&&lastDot>-1){if(lastComma>lastDot){s=s.replace(/\./g,'').replace(/,/g,'.');}else{s=s.replace(/,/g,'');}}else if(lastComma>-1){s=s.replace(/\./g,'').replace(/,/g,'.');}else if(lastDot>-1){const dotCount=(s.match(/\./g)||[]).length;if(dotCount>1){const parts=s.split('.'),decimal=parts.pop();s=decimal.length===2?parts.join('')+'.'+decimal:parts.join('')+decimal;}else if(/^[-]?\d{1,3}\.\d{3}$/.test(s)){s=s.replace('.','');}}const n=Number(s);return Number.isFinite(n)?n:0;},esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function filtered(){const q=$('#purchaseSearch').value,sup=$('#purchaseSupplier').value,from=$('#purchaseFrom').value,to=$('#purchaseTo').value;return purchases.filter(x=>(!statusFilter||x.status===statusFilter)&&(!sup||x.supplierId===sup)&&(!from||(x.entryDate||'')>=from)&&(!to||(x.entryDate||'')<=to)&&QualitySearch.matches([x.number,x.supplierName,x.invoiceNumber,x.accessKey,x.createdBy,...(x.items||[]).map(i=>[i.productName,i.productCode,i.sku,i.barcode,i.reference].join(' '))].join(' '),q));}
function render(){const rows=filtered();$('#resultCount').textContent=`${rows.length} compra(s)`;$('#purchaseBody').innerHTML=rows.length?rows.map(x=>`<tr data-id="${x.id}" tabindex="0"><td><b>${esc(ref(x.number))}</b></td><td>${esc(x.supplierName)}</td><td>${esc(x.entryDate||'—')}</td><td>${esc(x.invoiceNumber||'—')}</td><td>${(x.items||[]).length}</td><td>${money(x.total)}</td><td><span class="finance-status ${x.status==='completed'?'':'off'}">${statusLabel(x.status)}</span></td></tr>`).join(''):'<tr><td colspan="7" class="empty-state">Nenhuma compra encontrada.</td></tr>';document.querySelectorAll('#purchaseBody tr[data-id]').forEach(r=>r.onclick=()=>detail(r.dataset.id));}
const statusLabel=s=>({draft:'Rascunho',open:'Aberta',completed:'Concluída',reversed:'Estornada'}[s]||s);
function totals(syncPlan=true){const pt=items.reduce((s,i)=>s+num(i.quantity)*num(i.unitCost)-num(i.discount),0),gt=Math.round((pt+num($('#freight').value)+num($('#otherExpenses').value)-num($('#discount').value))*100)/100;$('#productsTotal').textContent=money(pt);$('#grandTotal').textContent=money(gt);if(syncPlan&&plan.length){const sum=Math.round(plan.reduce((s,p)=>s+num(p.value),0)*100)/100;if(plan.length===1){plan[0].value=gt;}else if(Math.abs(sum-lastPurchaseTotal)<.01){plan[plan.length-1].value=Math.round((num(plan[plan.length-1].value)+(gt-lastPurchaseTotal))*100)/100;}document.querySelectorAll('.purchase-plan-row [data-k="value"]').forEach((input,index)=>{if(plan[index])input.value=plan[index].value;});}lastPurchaseTotal=gt;return gt;}
function pricingRound(value){const raw=Math.max(0,num(value)),mode=String(data.pricingRules?.global?.rounding||'exact');if(mode==='up_integer')return Math.ceil(raw);if(mode==='ending_90'){const b=Math.floor(raw);return raw<=b+.90?b+.90:b+1.90;}if(mode==='ending_99'){const b=Math.floor(raw);return raw<=b+.99?b+.99:b+1.99;}return Math.round(raw*100)/100;}
function suggestedFor(item){const margin=Number(item?.targetMarginPercent);const cost=num(item?.unitCost);if(!Number.isFinite(margin)||margin<0||cost<=0)return null;return pricingRound(cost*(1+margin/100));}
function renderItems(){ $('#purchaseItems').innerHTML=items.map((i,n)=>{const sug=suggestedFor(i),hasRule=Number.isFinite(Number(i.targetMarginPercent));return `<div class="purchase-item" data-n="${n}"><div class="item-name"><b>${esc(i.productName)}</b><small>${esc(i.sku||i.productCode||'Sem código')} · ${i.variationLabel?`Variação: ${esc(i.variationLabel)} · `:''}${i.stockControlled?'Controla estoque':'Sem controle de estoque'}</small>${hasRule?`<div class="purchase-pricing-hint"><span class="rule">Margem alvo ${num(i.targetMarginPercent).toFixed(2)}% · ${esc(i.pricingRuleSource||'Regra')}</span>${sug!=null?`<span class="suggested">Sugerido ${money(sug)}</span><button type="button" class="purchase-use-suggested" data-use-suggested>Usar sugestão</button>`:''}</div>`:''}</div><label><span>Quantidade</span><input data-k="quantity" inputmode="decimal" value="${i.quantity}"></label><label class="purchase-cost-field"><span>Preço compra</span><input data-k="unitCost" inputmode="decimal" value="${i.unitCost}" title="Preço de compra / custo unitário desta ${i.variationLabel?'variação':'mercadoria'}"></label><label><span>Desconto</span><input data-k="discount" inputmode="decimal" value="${i.discount||0}"></label><label><span>Total compra</span><input data-line-total disabled value="${money(num(i.quantity)*num(i.unitCost)-num(i.discount))}"></label><label class="purchase-sale-field"><span>Preço de venda</span><input data-k="salePrice" inputmode="decimal" value="${i.salePrice??0}" title="Preço de venda ERP após concluir a compra"></label><button type="button" data-remove>×</button></div>`;}).join('');document.querySelectorAll('.purchase-item').forEach(row=>{const n=+row.dataset.n;row.querySelectorAll('input[data-k]').forEach(inp=>inp.onchange=()=>{const key=inp.dataset.k;items[n][key]=key==='quantity'?num(inp.value):inp.value;if(key==='unitCost'){renderItems();return;}const total=row.querySelector('[data-line-total]');if(total)total.value=money(num(items[n].quantity)*num(items