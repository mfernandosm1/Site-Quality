<% layout('layout') -%>
<section class="returns-page">
  <header class="returns-hero">
    <div><span class="returns-kicker">PDV · PÓS-VENDA</span><h1>↩ Trocas e Devoluções</h1><p>Vincule sempre à venda original. O ERP controla quantidade devolvida, estoque, crediário e crédito do cliente.</p></div>
    <div class="returns-actions"><a class="btn" href="/erp/pdv">← Voltar ao PDV</a><a class="btn" href="/erp/relatorios#returns">📊 Ver relatório</a></div>
  </header>
  <% if (flash) { %><div class="returns-alert"><%= flash %></div><% } %>

  <section class="returns-search-card">
    <form method="get" action="/erp/pdv/trocas-devolucoes" class="returns-search">
      <label><span>Localizar venda concluída</span><input name="q" value="<%= q %>" placeholder="Número da venda, cliente, produto, código ou identificador"></label>
      <button class="btn primary" type="submit">Buscar</button>
    </form>
    <div class="returns-sale-list">
      <% if (!sales.length) { %><div class="returns-empty">Nenhuma venda finalizada encontrada.</div><% } %>
      <% sales.forEach(sale=>{ const when=sale.finalizedAt||sale.dates?.finalizedAt||sale.createdAt; %>
        <a class="returns-sale <%= selected?.operation?.id===sale.id?'active':'' %>" href="/erp/pdv/trocas-devolucoes?venda=<%= encodeURIComponent(sale.id) %>&q=<%= encodeURIComponent(q||'') %>">
          <b>Venda #<%= sale.number %></b><span><%= sale.customerNameSnapshot || 'Consumidor final' %></span><small><%= new Date(when).toLocaleDateString('pt-BR') %> · <%= Number(sale.total||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></small>
        </a>
      <% }) %>
    </div>
  </section>

  <% if (selected) { const op=selected.operation; %>
  <section class="returns-form-card" id="returnFormCard">
    <div class="returns-section-title"><div><span>Venda original</span><h2>#<%= op.number %> · <%= op.customerNameSnapshot || 'Consumidor final' %></h2><small><%= new Date(op.finalizedAt||op.dates?.finalizedAt||op.createdAt).toLocaleString('pt-BR') %> · Total da venda <b><%= Number(op.total||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></b></small></div><a class="btn returns-original-sale-btn" href="/erp/pdv?operacao=<%= encodeURIComponent(op.id) %>" title="Abre a venda finalizada somente para conferência">Ver venda original</a></div>
    <% if (!selected.returnable.length) { %><div class="returns-alert warning">Todos os itens desta venda já foram devolvidos ou não possuem quantidade disponível.</div><% } else { %>
    <form id="returnForm">
      <input type="hidden" name="originalOperationId" value="<%= op.id %>">
      <div class="returns-grid">
        <label><span>Tipo</span><select name="type"><option value="exchange">Troca</option><option value="return">Devolução</option></select></label>
        <% if (selected.customer) { %><label><span>Cliente do crédito</span><input value="<%= selected.customer.name %>" readonly><input type="hidden" name="customerId" value="<%= selected.customer.id %>"></label><% } else { %>
          <label><span>Cliente do crédito *</span><select name="customerId" required><option value="">Selecione um cliente cadastrado</option><% customers.forEach(customer=>{ %><option value="<%= customer.id %>"><%= customer.name %><%= customer.documentFormatted?` · ${customer.documentFormatted}`:'' %></option><% }) %></select></label>
        <% } %>
        <label><span>Motivo *</span><select name="reasonCode" id="returnReasonCode" required><option value="">Selecione</option><% reasons.forEach(reason=>{ %><option value="<%= reason.id %>" data-problem="<%= reason.problem?'1':'0' %>"><%= reason.name %></option><% }) %></select></label>
      </div>
      <label class="returns-wide"><span>Descreva o motivo *</span><textarea name="reason" rows="2" required minlength="3" placeholder="Ex.: cliente relatou falha intermitente no carregamento; produto conferido no balcão."></textarea></label>

      <div class="returns-items-title"><div><h3>Itens que estão retornando</h3><p>O crédito usa o valor líquido efetivamente pago no item, incluindo rateio de cupom/desconto da venda.</p></div><strong id="returnCreditPreview">R$ 0,00</strong></div>
      <div class="returns-table-wrap"><table class="returns-table"><thead><tr><th></th><th>Produto</th><th>Vendido</th><th>Já devolvido</th><th>Disponível</th><th>Qtd. retorno</th><th>Crédito/un.</th><th>Destino físico</th></tr></thead><tbody>
      <% selected.returnable.forEach(item=>{ %>
        <tr data-return-row data-unit-credit="<%= item.unitCredit %>" data-stock="<%= item.stockControlled?'1':'0' %>">
          <td><input type="checkbox" data-select-return></td>
          <td><b><%= item.name %></b><small><%= [item.code,item.inventoryItemId].filter(Boolean).join(' · ') %></small></td>
          <td><%= item.quantitySold %></td><td><%= item.quantityReturned %></td><td><b><%= item.quantityAvailable %></b></td>
          <td><input type="number" data-return-qty min="0.001" max="<%= item.quantityAvailable %>" step="0.001" value="<%= Math.min(1,item.quantityAvailable) %>" disabled></td>
          <td><%= Number(item.unitCredit||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></td>
          <td>
            <% if (item.stockControlled) { %><select data-return-disposition disabled><option value="sellable">Volta ao estoque vendável</option><option value="quarantine">Problema / garantia — não vender</option><option value="discarded">Baixa / descarte</option></select><% } else { %><span class="returns-chip">Sem estoque</span><input type="hidden" data-return-disposition value="none"><% } %>
            <input type="hidden" data-return-item-id value="<%= item.operationItemId %>">
          </td>
        </tr>
      <% }) %>
      </tbody></table></div>

      <div class="returns-finance-note"><b>Como o financeiro será tratado</b><span>O crédito da devolução primeiro abate títulos do crediário desta venda que ainda estejam em aberto. O saldo restante entra na <strong>carteira do cliente</strong>. Em uma troca, abra a nova venda e use “Crédito do cliente / troca” como forma de pagamento; se o novo item for mais caro, cobre somente a diferença. Se for mais barato, o saldo continua disponível na carteira.</span></div>
      <div class="returns-submit"><button class="btn primary" type="submit">Confirmar troca / devolução</button><span id="returnStatus"></span></div>
      <div class="returns-success" id="returnSuccess" hidden aria-live="polite"></div>
    </form>
    <% } %>
  </section>
  <% } %>

  <details class="returns-history">
    <summary><span><b>Histórico recente</b><small>Últimas trocas e devoluções registradas</small></span><strong><%= recentReturns.length %></strong></summary>
    <div class="returns-history-list"><% if(!recentReturns.length){ %><div class="returns-empty">Nenhum registro ainda.</div><% } %><% recentReturns.forEach(row=>{ %><article><div><b><%= row.number %> · <%= row.type==='exchange'?'Troca':'Devolução' %></b><span>Venda #<%= row.originalOperationNumber %> · <%= row.customerName %></span><small><%= row.reasonLabel %> · <%= new Date(row.createdAt).toLocaleString('pt-BR') %> · <%= row.createdBy %></small></div><strong><%= Number(row.totalCredit||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></strong></article><% }) %></div>
  </details>
</section>

<style>
.returns-page{display:grid;gap:14px}.returns-hero,.returns-search-card,.returns-form-card,.returns-history{border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:0 8px 28px rgba(15,23,42,.05)}.returns-hero{padding:18px 20px;display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.returns-kicker{font-size:10px;letter-spacing:.12em;font-weight:900;color:var(--muted)}.returns-hero h1{margin:4px 0;font-size:25px}.returns-hero p{margin:0;color:var(--muted);max-width:850px}.returns-actions{display:flex;gap:7px;flex-wrap:wrap}.returns-alert{padding:11px 13px;border:1px solid color-mix(in srgb,#dc2626 35%,var(--line));background:color-mix(in srgb,#dc2626 8%,var(--card));border-radius:11px;color:var(--text)}.returns-alert.warning{border-color:color-mix(in srgb,#d97706 40%,var(--line));background:color-mix(in srgb,#d97706 8%,var(--card))}.returns-search-card{padding:14px}.returns-search{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:end}.returns-search label,.returns-grid label,.returns-wide{display:grid;gap:5px;font-size:10px;font-weight:800}.returns-search input,.returns-grid input,.returns-grid select,.returns-wide textarea,.returns-table input,.returns-table select{width:100%;box-sizing:border-box}.returns-sale-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:7px;margin-top:11px;max-height:255px;overflow:auto}.returns-sale{display:grid;gap:2px;border:1px solid var(--line);border-radius:10px;padding:9px 10px;text-decoration:none;color:var(--text);background:var(--card)}.returns-sale:hover,.returns-sale.active{border-color:var(--brand);background:color-mix(in srgb,var(--brand) 7%,var(--card))}.returns-sale span,.returns-sale small{color:var(--muted);font-size:10px}.returns-form-card{padding:16px}.returns-section-title,.returns-items-title{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.returns-section-title h2,.returns-items-title h3{margin:2px 0}.returns-section-title span{font-size:10px;color:var(--muted);font-weight:900;text-transform:uppercase}.returns-section-title small,.returns-items-title p{color:var(--muted);font-size:10px;margin:0}.returns-original-sale-btn{padding:7px 9px;font-size:10px;white-space:nowrap}.returns-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:15px 0 9px}.returns-wide{margin:9px 0}.returns-items-title{margin:17px 0 8px}.returns-items-title strong{font-size:21px;color:#15803d}.returns-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:11px}.returns-table{width:100%;border-collapse:collapse;min-width:900px}.returns-table th,.returns-table td{padding:8px;border-bottom:1px solid var(--line);font-size:10px;vertical-align:middle}.returns-table th{text-align:left;color:var(--muted);font-size:9px;text-transform:uppercase}.returns-table tbody tr:nth-child(even){background:color-mix(in srgb,var(--text) 2.5%,transparent)}.returns-table td:nth-child(1){width:30px}.returns-table td small{display:block;color:var(--muted);font-size:8px;margin-top:2px}.returns-table input[type=number]{min-width:75px}.returns-chip{display:inline-block;padding:4px 7px;border-radius:99px;background:color-mix(in srgb,var(--muted) 12%,transparent);color:var(--muted);font-size:9px}.returns-finance-note{display:grid;gap:4px;margin-top:12px;padding:11px 12px;border:1px solid color-mix(in srgb,#2563eb 25%,var(--line));border-radius:10px;background:color-mix(in srgb,#2563eb 6%,var(--card));font-size:10px}.returns-finance-note span{color:var(--muted);line-height:1.45}.returns-submit{display:flex;align-items:center;gap:12px;margin-top:12px}.returns-submit span{font-size:10px;color:var(--muted)}.returns-success{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:12px;padding:14px 15px;border:1px solid color-mix(in srgb,#16a34a 45%,var(--line));border-radius:12px;background:color-mix(in srgb,#16a34a 10%,var(--card));box-shadow:0 8px 24px color-mix(in srgb,#16a34a 10%,transparent)}.returns-success[hidden]{display:none!important}.returns-success>div{display:grid;gap:3px}.returns-success strong{font-size:14px;color:#16a34a}.returns-success span{font-size:10px;color:var(--muted);line-height:1.4}.returns-success a{white-space:nowrap}.returns-history{overflow:hidden}.returns-history>summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:13px 15px}.returns-history>summary::-webkit-details-marker{display:none}.returns-history>summary:after{content:'＋';font-size:18px;color:var(--muted);margin-left:9px}.returns-history[open]>summary:after{content:'−'}.returns-history>summary span{display:grid;gap:2px}.returns-history>summary small{color:var(--muted);font-size:9px}.returns-history>summary strong{margin-left:auto;color:var(--muted)}.returns-history-list{border-top:1px solid var(--line);padding:8px 14px}.returns-history-list article{display:flex;justify-content:space-between;gap:15px;padding:9px 2px;border-bottom:1px solid var(--line)}.returns-history-list article div{display:grid;gap:2px}.returns-history-list span,.returns-history-list small{font-size:9px;color:var(--muted)}.returns-empty{color:var(--muted);padding:12px;text-align:center}@media(max-width:850px){.returns-hero{display:grid}.returns-grid{grid-template-columns:1fr}.returns-search{grid-template-columns:1fr}.returns-sale-list{grid-template-columns:1fr}.returns-section-title{display:grid}}
</style>
<script>
(()=>{
  const form=document.getElementById('returnForm');if(!form)return;
  const rows=[...document.querySelectorAll('[data-return-row]')],status=document.getElementById('returnStatus'),preview=document.getElementById('returnCreditPreview'),reason=document.getElementById('returnReasonCode'),success=document.getElementById('returnSuccess');
  const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  function recalc(){let total=0;rows.forEach(row=>{const check=row.querySelector('[data-select-return]'),qty=row.querySelector('[data-return-qty]'),disp=row.querySelector('[data-return-disposition]');const on=check.checked;qty.disabled=!on;if(disp&&disp.tagName==='SELECT')disp.disabled=!on;if(on)total+=Number(qty.value||0)*Number(row.dataset.unitCredit||0);});preview.textContent=money(total)}
  function protectProblem(){const option=reason.selectedOptions[0],problem=option?.dataset.problem==='1';if(!problem)return;rows.forEach(row=>{const select=row.querySelector('select[data-return-disposition]');if(select&&select.value==='sellable')select.value='quarantine';});}
  rows.forEach(row=>{row.querySelector('[data-select-return]')?.addEventListener('change',recalc);row.querySelector('[data-return-qty]')?.addEventListener('input',recalc)});reason?.addEventListener('change',()=>{protectProblem();recalc()});
  form.addEventListener('submit',async event=>{
    event.preventDefault();
    const body={originalOperationId:form.elements.originalOperationId.value,type:form.elements.type.value,customerId:form.elements.customerId.value,reasonCode:form.elements.reasonCode.value,reason:form.elements.reason.value,items:rows.filter(row=>row.querySelector('[data-select-return]').checked).map(row=>({operationItemId:row.querySelector('[data-return-item-id]').value,quantity:Number(row.querySelector('[data-return-qty]').value||0),disposition:row.querySelector('[data-return-disposition]').value}))};
    if(!body.items.length){status.textContent='Selecione pelo menos um item.';return}
    status.textContent='Registrando...';success.hidden=true;
    try{
      const response=await fetch('/erp/pdv/trocas-devolucoes',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)});
      const data=await response.json();if(!response.ok||!data.success)throw new Error(data.message||'Falha ao registrar.');
      const wallet=Number(data.wallet?.balance||0);form.querySelectorAll('input,select,textarea,button[type=submit]').forEach(el=>el.disabled=true);
      const isExchange=body.type==='exchange';
      const nextUrl=`/erp/pdv?nova=1&cliente=${encodeURIComponent(data.record.customerId)}${isExchange?`&troca=${encodeURIComponent(data.record.id)}`:''}`;
      status.textContent='';
      success.innerHTML=`<div><strong>✅ ${isExchange?'Troca':'Devolução'} concluída com sucesso</strong><span>${isExchange?'Crédito disponível para a nova venda':'Crédito disponível do cliente'}: <b>${money(wallet)}</b>. ${isExchange?'Abrindo o PDV para escolher o novo produto...':'Voltando ao PDV com uma venda pronta para o próximo atendimento...'}</span></div><a class="btn primary" href="${nextUrl}">Ir ao PDV agora →</a>`;
      success.hidden=false;success.scrollIntoView({behavior:'smooth',block:'nearest'});
      setTimeout(()=>{location.href=nextUrl},1400);
    }catch(error){status.textContent=error.message||'Falha ao registrar.';}
  });
  recalc();
})();
</script>
