    </div></details>
    <details id="sale"><summary>Venda</summary><div class="config-fields"><label><input type="checkbox" name="showCustomerDocument" <%= printSettings.showCustomerDocument !== false ? 'checked' : '' %>> Exibir CPF/CNPJ</label><label><input type="checkbox" name="showCustomerPhone" <%= printSettings.showCustomerPhone !== false ? 'checked' : '' %>> Exibir telefone</label><label><input type="checkbox" name="showCustomerAddress" <%= printSettings.showCustomerAddress !== false ? 'checked' : '' %>> Exibir endereço</label><label class="wide">Mensagem principal<input name="saleFooterTitle" value="<%= printSettings.saleFooterTitle || 'Foi um prazer lhe atender. Volte sempre!' %>"></label><label class="wide">Aviso de garantia<input name="saleFooterWarranty" value="<%= printSettings.saleFooterWarranty || 'Se remover os lacres do produto, perde a garantia.' %>"></label><div class="wide"><button class="btn primary" type="submit">Salvar venda</button></div></div></details>
    <details id="os-entry"><summary>O.S. — Entrada</summary><div class="config-fields"><label class="wide">Título<input name="osEntryTitle" value="<%= printSettings.osEntryTitle || 'COMPROVANTE DE ENTRADA - O.S.' %>"></label><label class="wide">Condições de serviço<textarea name="osEntryTerms" rows="9"><%= printSettings.osEntryTerms || '' %></textarea></label><label><input type="checkbox" name="osShowPasswordGrid" <%= printSettings.osShowPasswordGrid ? 'checked' : '' %>> Duas senhas de desenho</label><div class="wide"><button class="btn primary" type="submit">Salvar O.S. de entrada</button></div></div></details>
    <details id="os-exit"><summary>O.S. — Saída</summary><div class="config-fields"><label class="wide">Título<input name="osExitTitle" value="<%= printSettings.osExitTitle || 'COMPROVANTE DE SAÍDA - O.S.' %>"></label><label class="wide">Garantia e retirada<textarea name="osExitTerms" rows="8"><%= printSettings.osExitTerms || '' %></textarea></label><label><input type="checkbox" name="osSignature" <%= printSettings.osSignature !== false ? 'checked' : '' %>> Assinatura do cliente</label><div class="wide"><button class="btn primary" type="submit">Salvar O.S. de saída</button></div></div></details>
  </form>
</section>

<script src="/public/js/erp-print-renderer.js"></script>
<script>
(()=>{
 const models=<%- JSON.stringify(printModels || []).replace(/</g,'\\u003c') %>;
 const printSettings=<%- JSON.stringify(printSettings || {}).replace(/</g,'\\u003c') %>;
 const $=s=>document.querySelector(s), content=$('#modelContent'), saveState=$('#saveState'), visualInput=$('#visualConfigInput');
 let initialSnapshot='', paymentPreviewMode='simple', currentModel=null, visualConfig=null, editorMode='visual';
 const htmlEscape=(value='')=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
 const checked=(key,label,value=true)=>`<label class="visual-check"><input type="checkbox" data-vkey="${key}" ${value?'checked':''}> <span>${label}</span></label>`;
 const textField=(key,label,value='',wide=false)=>`<label class="${wide?'wide':''}">${label}<input data-vkey="${key}" value="${htmlEscape(value)}"></label>`;
 const textareaField=(key,label,value='',wide=true)=>`<label class="${wide?'wide':''}">${label}<textarea data-vkey="${key}">${htmlEscape(value)}</textarea></label>`;
 const selectField=(key,label,value,options,wide=false)=>`<label class="${wide?'wide':''}">${label}<select data-vkey="${key}">${options.map(([v,t])=>`<option value="${v}" ${String(value)===String(v)?'selected':''}>${t}</option>`).join('')}</select></label>`;
 const numberField=(key,label,value,min,max,step=1)=>`<label>${label}<input type="number" data-vkey="${key}" min="${min}" max="${max}" step="${step}" value="${Number(value)}"></label>`;
 function inferKind(model){
  if(model?.visualConfig?.kind)return model.visualConfig.kind;
  if(model?.nativeKind)return model.nativeKind;
  const id=String(model?.id||'').toLowerCase(), body=String(model?.content||'');
  if(id.includes('credit-book')||model?.type==='credit_book'||body.includes('{{crediario_canhoes}}'))return 'credit_book';
  if(id.includes('os-exit')||body.includes('{{os_servico_bloco}}'))return 'os_exit';
  if(id.includes('os-entry')||body.includes('{{os_problema_bloco}}')||model?.type==='service_order')return 'os_entry';
  if(model?.type==='sale'||body.includes('{{pagamentos}}'))return 'sale';
  return '';
 }
 function blockIdsFor(kind){
  if(kind==='sale')return ['header','details','products','payments','footer'];
  if(kind==='credit_book')return ['header','company','details','products','declaration','observations','store','thanks','signature','slips'];
  if(kind==='os_entry')return ['header','details','problem','accessories','products','terms','passwords','signature'];
  if(kind==='os_exit')return ['header','details','problem','service','products','payments','terms','signature'];
  return [];
 }
 function blockLabels(kind){return {header:'Cabeçalho',details:kind==='sale'?'Dados da venda / cliente':kind==='credit_book'?'Dados do crediário':'Dados da O.S.',products:'Produtos / serviços',payments:'Pagamentos',footer:'Rodapé',problem:'Problema informado',accessories:'Acessórios recebidos',service:'Serviço executado',terms:kind==='os_exit'?'Garantia e retirada':'Condições de serviço',passwords:'Senhas',signature:'Assinatura',declaration:'Compromisso de pagamento',observations:'Observações importantes',store:'Loja virtual',thanks:'Agradecimento',slips:'Canhotos das parcelas',company:'Dados da empresa'};}
 function defaultBlockStyle(){return {fontSize:12,titleSize:12,titleBold:true,titleAlign:'left',spaceBefore:0,spaceAfter:0,separator:true};}
 function defaultLayout(kind){const ids=blockIdsFor(kind),blocks={};ids.forEach(id=>blocks[id]=defaultBlockStyle());return {preset:'standard',order:ids,blocks};}
 function normalizeLayout(cfg){cfg.layout=mergeDeep(defaultLayout(cfg.kind),cfg.layout||{});const valid=blockIdsFor(cfg.kind),seen=new Set(),order=[];(cfg.layout.order||[]).forEach(id=>{if(valid.includes(id)&&!seen.has(id)){seen.add(id);order.push(id);}});valid.forEach(id=>{if(!seen.has(id))order.push(id);});cfg.layout.order=order;valid.forEach(id=>{cfg.layout.blocks[id]=mergeDeep(defaultBlockStyle(),cfg.layout.blocks[id]||{});});return cfg.layout;}
 function blockWrap(cfg,id,inner,index){const layout=normalizeLayout(cfg),st=layout.blocks[id]||defaultBlockStyle();const align=['left','center','right'].includes(st.titleAlign)?st.titleAlign:'left';const before=Math.max(0,Math.min(40,Number(st.spaceBefore)||0)),after=Math.max(0,Math.min(40,Number(st.spaceAfter)||0));const font=Math.max(8,Math.min(20,Number(st.fontSize)||12)),title=Math.max(8,Math.min(22,Number(st.titleSize)||12));const decorated=String(inner).replace(/<h3([^>]*)>/i,`<h3$1 style="font-size:${title}px;font-weight:${st.titleBold===false?'400':'700'};text-align:${align}">`);const rule=index>0&&st.separator!==false?'<hr>':'';return `${rule}<div class="receipt-block receipt-block-${id}" style="font-size:${font}px;margin-top:${before}px;margin-bottom:${after}px">${decorated}</div>`;}
 function orderBlocks(cfg,items){const layout=normalizeLayout(cfg),byId=new Map(items.filter(x=>x&&x.html).map(x=>[x.id,x]));const out=[];layout.order.forEach(id=>{if(byId.has(id)){out.push(byId.get(id));byId.delete(id);}});byId.forEach(v=>out.push(v));return out.map((item,index)=>blockWrap(cfg,item.id,item.html,index)).join('');}
 function defaultsFor(kind){
  const common={kind,header:{logo:true,company:true,title:true,status:true,companyText:printSettings.companyName||'QUALITY CELULARES'}};
  if(kind==='sale')return {...common,layout:defaultLayout(kind),header:{...common.header,titleText:printSettings.saleTitle||'COMPROVANTE NÃO FISCAL'},sale:{number:true,date:true,identifier:true,seller:true},customer:{name:true,document:printSettings.showCustomerDocument!==false,phone:printSettings.showCustomerPhone!==false,address:printSettings.showCustomerAddress!==false},products:{show:true,title:'DESCRIÇÃO DO PRODUTO',code:true,qty:true,unit:true,discount:true,total:true},payments:{show:true,title:'PAGAMENTOS',showInstallments:true,showInstallmentValue:true,showDueDates:true,showMethodTotal:true},footer:{show:true,title:printSettings.saleFooterTitle||'Foi um prazer lhe atender. Volte sempre!',warranty:printSettings.saleFooterWarranty||'Se remover os lacres do produto, perde a garantia.'}};
  if(kind==='credit_book')return {...common,layout:defaultLayout(kind),header:{...common.header,status:false,titleText:'CARNÊ / COMPROVANTE DE CREDIÁRIO'},creditBook:{companyBlock:true,companyLegalName:true,companyDocument:true,companyAddress:true,companyCity:true,companyPhone:true,companyEmail:true,number:true,date:true,customer:true,document:true,phone:true,address:true,total:true,installmentCount:true,items:true,itemsTitle:'ITENS DA VENDA',declaration:true,declarationText:'Declaro estar ciente dos valores e vencimentos informados e comprometo-me com o pagamento das parcelas nas respectivas datas.',observations:true,observationsTitle:'OBSERVAÇÕES IMPORTANTES',observationsText:'Confira seu carnê, nele consta todas as parcelas de sua compra.\nContas em dia não impedem novas compras e evita negativações e protestos.',store:true,storeTitle:'Visite nossa loja virtual:',storeUrl:'{{empresa_site}}',thanks:true,thanksText:'É um privilégio ter você como nosso cliente =)\nQuality Celulares agradece a preferência!',signature:true,signatureLabel:'Assinatura do cliente',slips:true}};
  if(kind==='os_exit')return {...common,layout:defaultLayout(kind),header:{...common.header,titleText:printSettings.osExitTitle||'COMPROVANTE DE SAÍDA - O.S.'},os:{customer:true,reference:true,equipment:true,technician:true,openedAt:true,deliveredAt:true,problem:true,problemTitle:'PROBLEMA INFORMADO',service:true,serviceTitle:'SERVIÇO EXECUTADO',products:true,productsTitle:'PRODUTOS / SERVIÇOS',payments:true,paymentsTitle:'PAGAMENTOS',terms:true,termsTitle:'CONDIÇÕES DE GARANTIA E RETIRADA',signature:printSettings.osSignature!==false,signatureLabel:'Assinatura:',termsText:printSettings.osExitTerms||''}};
  if(kind==='os_entry')return {...common,layout:defaultLayout(kind),header:{...common.header,titleText:printSettings.osEntryTitle||'COMPROVANTE DE ENTRADA - O.S.'},os:{customer:true,reference:true,equipment:true,technician:true,openedAt:true,problem:true,problemTitle:'PROBLEMA INFORMADO',accessories:true,accessoriesTitle:'ACESSÓRIOS RECEBIDOS',products:true,productsTitle:'PRODUTOS / SERVIÇOS',terms:true,termsTitle:'CONDIÇÕES DE SERVIÇO',passwords:Boolean(printSettings.osShowPasswordGrid),passwordsTitle:'Senhas de desenho',signature:printSettings.osSignature!==false,signatureLabel:'Assinatura:',termsText:printSettings.osEntryTerms||''}};
  return {kind:''};
 }
 function mergeDeep(base,extra){const out={...base};Object.entries(extra||{}).forEach(([k,v])=>{out[k]=v&&typeof v==='object'&&!Array.isArray(v)?mergeDeep(base?.[k]||{},v):v;});return out;}
 function getPath(obj,path){return path.split('.').reduce((acc,key)=>acc?.[key],obj);}
 function setPath(obj,path,value){const keys=path.split('.');let ref=obj;keys.slice(0,-1).forEach(key=>{if(!ref[key]||typeof ref[key]!=='object')ref[key]={};ref=ref[key];});ref[keys.at(-1)]=value;}
 function buildHeader(cfg,kind){
  const h=cfg.header||{}, parts=[];
  if(h.logo)parts.push('{{empresa_logo}}');
  if(h.company)parts.push(`<strong class="doc-company">${htmlEscape(h.companyText||printSettings.companyName||'QUALITY CELULARES')}</strong>`);
  if(h.title){const suffix=(kind==='sale'||kind==='credit_book')?'': ' Nº {{numero}}';parts.push(`<span>${htmlEscape(h.titleText||'COMPROVANTE')}${suffix}</span>`);}
  if(h.status)parts.push('<b class="doc-status">{{status}}</b>');
  return parts.length?`<div class="doc-header">${parts.join('')}</div>`:'';
 }
 function buildSaleContent(cfg){
  const items=[]; const header=buildHeader(cfg,'sale'); if(header)items.push({id:'header',html:header});
  const sale=cfg.sale||{}, customer=cfg.customer||{}; const meta=[];
  if(sale.number)meta.push('<b>Operação:</b> {{numero}}'); if(sale.date)meta.push('<b>Data:</b> {{data}}'); if(customer.name)meta.push('<b>Cliente:</b> {{cliente}}'); if(customer.document)meta.push('<b>CPF/CNPJ:</b> {{cpf}}'); if(customer.phone)meta.push('<b>Telefone:</b> {{telefone}}'); if(customer.address)meta.push('<b>Endereço:</b> {{endereco}}'); if(sale.identifier)meta.push('<b>Identificador:</b> {{identificador}}'); if(sale.seller)meta.push('<b>Vendedor:</b> {{vendedor}}');
  if(meta.length)items.push({id:'details',html:`<div>${meta.join('<br>')}</div>`});
  const products=cfg.products||{}; if(products.show!==false){const classes=['receipt-items'];if(products.code===false)classes.push('hide-code');if(products.qty===false)classes.push('hide-qty');if(products.unit===false)classes.push('hide-unit');if(products.discount===false)classes.push('hide-discount');if(products.total===false)classes.push('hide-total');items.push({id:'products',html:`<section><h3>${htmlEscape(products.title||'DESCRIÇÃO DO PRODUTO')}</h3><div class="${classes.join(' ')}">{{itens_tabela}}</div><div class="doc-total"><b>TOTAL</b><strong>{{total}}</strong></div></section>`});}
  const payments=cfg.payments||{}; if(payments.show!==false)items.push({id:'payments',html:`<section><h3>${htmlEscape(payments.title||'PAGAMENTOS')}</h3>{{pagamentos}}</section>`});
  const footer=cfg.footer||{}; if(footer.show!==false&&(footer.title||footer.warranty))items.push({id:'footer',html:`<div class="sale-footer">${footer.title?`<strong>${htmlEscape(footer.title)}</strong>`:''}${footer.warranty?`<span>${htmlEscape(footer.warranty)}</span>`:''}</div>`});
  return orderBlocks(cfg,items);
 }
 function buildCreditBookContent(cfg){
  const items=[]; const header=buildHeader(cfg,'credit_book'); if(header)items.push({id:'header',html:header});
  const c=cfg.creditBook||{}, meta=[];
  if(c.companyBlock!==false){const company=[];if(c.companyLegalName!==false)company.push('<b>{{empresa_razao}}</b>');if(c.companyDocument!==false)company.push('CNPJ: {{empresa_cnpj}}');if(c.companyAddress!==false)company.push('{{empresa_endereco}}');if(c.companyCity!==false)company.push('{{empresa_cidade}}');if(c.companyPhone!==false)company.push('Celular: {{empresa_telefone}}');if(c.companyEmail!==false)company.push('{{empresa_email}}');if(company.length)items.push({id:'company',html:`<div style="text-align:center;line-height:1.35">${company.join('<br>')}</div>`});}
  if(c.number!==false)meta.push('<b>Venda:</b> #{{numero}}'); if(c.date!==false)meta.push('<b>Data:</b> {{data}}'); if(c.customer!==false)meta.push('<b>Cliente:</b> {{cliente}}'); if(c.document!==false)meta.push('<b>CPF/CNPJ:</b> {{cpf}}'); if(c.phone!==false)meta.push('<b>Telefone:</b> {{telefone}}'); if(c.address!==false)meta.push('<b>Endereço:</b> {{endereco}}'); if(c.total!==false)meta.push('<b>Total no crediário:</b> {{crediario_total}}'); if(c.installmentCount!==false)meta.push('<b>Parcelas:</b> {{crediario_quantidade}}');
  if(meta.length)items.push({id:'details',html:`<div>${meta.join('<br>')}</div>`});
  if(c.items!==false)items.push({id:'products',html:`<section><h3>${htmlEscape(c.itemsTitle||'ITENS DA VENDA')}</h3>{{crediario_itens}}</section>`});
  if(c.declaration!==false&&c.declarationText)items.push({id:'declaration',html:`<div style="text-align:center">${htmlEscape(c.declarationText).replace(/\r?\n/g,'<br>')}</div>`});
  if(c.observations!==false&&(c.observationsTitle||c.observationsText))items.push({id:'observations',html:`<section>${c.observationsTitle?`<h3>${htmlEscape(c.observationsTitle)}</h3>`:''}<div>${htmlEscape(c.observationsText||'').replace(/\r?\n/g,'<br>')}</div></section>`});
  if(c.store!==false&&(c.storeTitle||c.storeUrl))items.push({id:'store',html:`<div style="text-align:center">${c.storeTitle?`<b>${htmlEscape(c.storeTitle)}</b><br>`:''}${htmlEscape(c.storeUrl||'')}</div>`});
  if(c.thanks!==false&&c.thanksText)items.push({id:'thanks',html:`<div style="text-align:center">${htmlEscape(c.thanksText).replace(/\r?\n/g,'<br>')}</div>`});
  if(c.signature!==false)items.push({id:'signature',html:`<div class="signature" style="text-align:center">${htmlEscape(c.signatureLabel||'Assinatura do cliente')}<br><br>__________________________________<br>{{cliente}}</div>`});
  if(c.slips!==false)items.push({id:'slips',html:'{{crediario_canhoes}}'});
  return orderBlocks(cfg,items);
 }
 function buildOsContent(cfg,kind){
  const items=[];const header=buildHeader(cfg,kind);if(header)items.push({id:'header',html:header});const os=cfg.os||{};const meta=[];
  if(os.customer)meta.push('<span><b>Cliente:</b> {{cliente}}</span>'); if(os.equipment)meta.push('<span><b>Equipamento:</b> {{os_aparelho}}</span>'); if(os.reference)meta.push('<span><b>Celular:</b> {{telefone}}</span>'); if(os.openedAt)meta.push('<span><b>Abertura:</b> {{os_abertura}}</span>'); if(os.technician)meta.push('<span><b>Técnico:</b> {{os_tecnico}}</span>'); if(kind==='os_exit'&&os.deliveredAt)meta.push('<span><b>Saída:</b> {{os_saida}}</span>'); if(meta.length)items.push({id:'details',html:`<div class="doc-grid">${meta.join('')}</div>`});
  if(kind==='os_entry'){if(os.problem)items.push({id:'problem',html:`<section><h3>${htmlEscape(os.problemTitle||'PROBLEMA INFORMADO')}</h3>{{os_problema_conteudo}}</section>`});if(os.accessories)items.push({id:'accessories',html:`<section><h3>${htmlEscape(os.accessoriesTitle||'ACESSÓRIOS RECEBIDOS')}</h3>{{os_acessorios_conteudo}}</section>`});} else {if(os.problem)items.push({id:'problem',html:`<section><h3>${htmlEscape(os.problemTitle||'PROBLEMA INFORMADO')}</h3>{{os_problema_conteudo}}</section>`});if(os.service)items.push({id:'service',html:`<section><h3>${htmlEscape(os.serviceTitle||'SERVIÇO EXECUTADO')}</h3>{{os_servico_conteudo}}</section>`});}
  if(os.products)items.push({id:'products',html:`<section><h3>${htmlEscape(os.productsTitle||'PRODUTOS / SERVIÇOS')}</h3><div class="receipt-items os-receipt-items">{{itens_tabela}}</div><div class="doc-total"><b>TOTAL</b><strong>{{total}}</strong></div></section>`});
