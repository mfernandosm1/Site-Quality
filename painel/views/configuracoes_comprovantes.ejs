        <button type="button" class="variable-btn" data-variable="{{empresa_telefone}}"><span>Telefone da empresa</span><code>{{empresa_telefone}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{empresa_email}}"><span>E-mail da empresa</span><code>{{empresa_email}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{empresa_site}}"><span>Site da empresa</span><code>{{empresa_site}}</code></button>
