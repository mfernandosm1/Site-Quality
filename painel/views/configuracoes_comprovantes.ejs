<% layout('layout') -%>
<style>
:root{--pc-bg:#f3f5f8;--pc-card:#fff;--pc-text:#18202a;--pc-muted:#667085;--pc-border:#d8dee8;--pc-soft:#eef2f7;--pc-input:#fff;--pc-primary:#1769d2;--pc-danger:#c62828}
html[data-panel-theme="black-oled"],html[data-panel-theme="oled"],body.theme-black-oled{--pc-bg:#050505;--pc-card:#101010;--pc-text:#f5f7fa;--pc-muted:#9ca3af;--pc-border:#2b2b2b;--pc-soft:#171717;--pc-input:#0a0a0a;--pc-primary:#287be0;--pc-danger:#ff5252}
body{background:var(--pc-bg);color:var(--pc-text)}
.print-page{font-size:14px;line-height:1.4;color:var(--pc-text)}
.print-page *{box-sizing:border-box}
.print-page input,.print-page select,.print-page textarea,.print-page button{font:inherit}
.print-page input,.print-page select,.print-page textarea{width:100%;min-height:38px;padding:8px 10px;border:1px solid var(--pc-border);border-radius:8px;background:var(--pc-input);color:var(--pc-text)}
.print-page textarea{min-height:440px;resize:vertical;line-height:1.5}
.print-center{display:grid;grid-template-columns:minmax(250px,300px) minmax(560px,1fr) minmax(300px,350px);gap:14px;align-items:start}
.print-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.print-tabs button{padding:10px 15px;border:1px solid var(--pc-border);border-radius:9px;color:var(--pc-text);background:var(--pc-card);font-weight:800;cursor:pointer}.print-tabs button.active{background:var(--pc-primary);color:#fff;border-color:var(--pc-primary)}.print-pane[hidden]{display:none!important}.editor-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.save-state{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:999px;background:var(--pc-soft);color:var(--pc-muted);font-size:12px;font-weight:800}.save-state.dirty{background:#fff3cd;color:#8a5a00}.save-state.saved{background:#e7f6ed;color:#14733c}
.print-panel{background:var(--pc-card);border:1px solid var(--pc-border);border-radius:12px;padding:14px;min-width:0;box-shadow:0 4px 18px rgba(15,23,42,.06)}
html[data-panel-theme="black-oled"] .print-panel,html[data-panel-theme="oled"] .print-panel,body.theme-black-oled .print-panel{box-shadow:none}
.print-panel h2,.print-panel h3{margin-top:0}.print-panel h2{font-size:18px;margin-bottom:5px}.settings-note{color:var(--pc-muted)}
.model-search{margin:10px 0}.model-list{display:grid;gap:8px;max-height:650px;overflow:auto;padding-right:2px}.model-item{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;text-align:left;padding:12px;border:1px solid var(--pc-border);border-radius:9px;background:var(--pc-card);color:var(--pc-text);cursor:pointer}.model-item:hover{background:var(--pc-soft)}.model-item.active{border-color:var(--pc-primary);background:color-mix(in srgb,var(--pc-primary) 13%,var(--pc-card))}.model-item b,.model-item small{display:block}.model-item small{color:var(--pc-muted);margin-top:4px}.status-pill{display:inline-flex;padding:4px 7px;border-radius:999px;background:#e7f6ed;color:#14733c;font-size:11px;font-weight:800}.model-actions{display:flex;gap:6px}.model-actions button{padding:6px 8px}
.editor-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr .75fr;gap:10px;margin-bottom:10px}.editor-grid label,.config-fields label{display:grid;gap:5px;font-size:12px;font-weight:800;color:var(--pc-muted)}
.editor-toolbar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;border:1px solid var(--pc-border);border-bottom:0;border-radius:8px 8px 0 0;padding:8px;background:var(--pc-soft)}.editor-toolbar button,.editor-toolbar select{width:auto;min-height:34px;padding:6px 9px;border:1px solid var(--pc-border);border-radius:6px;background:var(--pc-card);color:var(--pc-text)}
.model-content{border-radius:0 0 8px 8px!important;font-family:Consolas,"Courier New",monospace!important;font-size:14px!important;background:var(--pc-input)!important;color:var(--pc-text)!important}
.variable-groups details{border:1px solid var(--pc-border);border-radius:8px;margin-bottom:8px;background:var(--pc-card)}.variable-groups summary{padding:10px 12px;cursor:pointer;font-weight:800}.variable-list{display:grid;gap:3px;padding:0 9px 10px}.variable-btn{display:flex;justify-content:space-between;gap:8px;width:100%;border:0;background:transparent;color:var(--pc-text);padding:7px;border-radius:6px;cursor:pointer;text-align:left}.variable-btn:hover{background:var(--pc-soft)}.variable-btn code{font-size:11px;color:var(--pc-primary)}
.preview-column{position:sticky;top:12px}.real-preview-box{display:grid;grid-template-columns:1fr auto;gap:7px;margin:10px 0;padding:9px;border:1px solid var(--pc-border);border-radius:9px;background:var(--pc-soft)}.real-preview-box label{grid-column:1/-1;font-size:11px;font-weight:800;color:var(--pc-muted)}.real-preview-box input{min-height:34px}.real-preview-box button{width:auto;min-height:34px;padding:6px 10px}.real-preview-status{grid-column:1/-1;font-size:11px;color:var(--pc-muted)}.real-preview-status.active{color:#14733c;font-weight:800}.real-preview-status.error{color:var(--pc-danger);font-weight:800}.real-preview-clear{grid-column:1/-1;width:max-content!important;padding:0!important;min-height:auto!important;border:0!important;background:transparent!important;color:var(--pc-primary)!important;text-decoration:underline;cursor:pointer}.preview-paper{background:#fff;color:#111;border:1px solid #d0d0d0;border-radius:8px;padding:14px;min-height:620px;font:12px Arial,sans-serif;box-shadow:0 1px 8px rgba(0,0,0,.25)}.preview-scenarios{display:flex;gap:6px;flex-wrap:wrap;margin:9px 0}.preview-scenarios button{width:auto;min-height:30px;padding:5px 8px;border:1px solid var(--pc-border);border-radius:999px;background:var(--pc-card);color:var(--pc-text);font-size:11px;font-weight:800;cursor:pointer}.preview-scenarios button.active{background:var(--pc-primary);border-color:var(--pc-primary);color:#fff}.logo-live-preview{grid-column:1/-1;background:#fff;border:1px solid #d0d0d0;border-radius:8px;min-height:125px;padding:12px;display:grid;align-items:start;overflow:hidden}.logo-live-preview img{display:block;max-width:64mm;max-height:72px;object-fit:contain}.range-line{display:grid!important;grid-template-columns:1fr auto;align-items:center;gap:8px}.range-line output{min-width:42px;text-align:right;color:var(--pc-text);font-weight:800}.range-line input[type=range]{grid-column:1/-1;padding:0;min-height:26px}.preview-paper .logo-preview{display:block;max-width:88%;max-height:86px;object-fit:contain;margin:0 auto 10px}.preview-paper h3{text-align:center;margin:4px 0;font-size:14px}.preview-status{display:table;margin:6px auto;border:1px solid #111;padding:3px 8px;font-weight:700}.preview-rule{border-top:1px dashed #555;margin:10px 0}.preview-row{display:flex;justify-content:space-between;gap:10px;margin:5px 0}.preview-terms{font-size:11.5px;line-height:1.38}
.config-sections{display:grid;gap:12px;margin-top:14px}.config-sections details{background:var(--pc-card);border:1px solid var(--pc-border);border-radius:10px;padding:12px}.config-sections summary{font-weight:800;cursor:pointer;font-size:16px}.config-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.config-fields .wide{grid-column:1/-1}.config-fields textarea{min-height:130px;font-size:14px}
.footer-actions{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:14px}.tip-box{border:1px solid #2f6fae;background:color-mix(in srgb,#2f6fae 12%,var(--pc-card));padding:10px;border-radius:8px;margin-top:12px}.print-lower-grid{margin-top:14px;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important}
.editor-mode-tabs{display:flex;gap:7px;margin:4px 0 12px;border-bottom:1px solid var(--pc-border);padding-bottom:10px}.editor-mode-tabs button{width:auto;padding:8px 12px;border:1px solid var(--pc-border);border-radius:8px;background:var(--pc-card);color:var(--pc-text);font-weight:800;cursor:pointer}.editor-mode-tabs button.active{background:var(--pc-primary);border-color:var(--pc-primary);color:#fff}.visual-editor-note{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 12px;border:1px solid #2f6fae;border-radius:9px;background:color-mix(in srgb,#2f6fae 10%,var(--pc-card));margin-bottom:10px}.visual-editor-note span{color:var(--pc-muted);font-size:12px}.visual-editor-sections{display:grid;gap:9px}.visual-block{border:1px solid var(--pc-border);border-radius:10px;background:var(--pc-card);overflow:hidden}.visual-block summary{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 12px;cursor:pointer;font-weight:800;background:var(--pc-soft)}.visual-block-body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;padding:12px}.visual-block-body .wide{grid-column:1/-1}.visual-check{display:flex!important;grid-template-columns:auto 1fr!important;align-items:center;gap:8px!important;padding:8px 9px;border:1px solid var(--pc-border);border-radius:8px;color:var(--pc-text)!important;background:var(--pc-input)}.visual-check input{width:auto!important;min-height:0!important}.visual-block textarea{min-height:90px!important}.advanced-warning{padding:9px 11px;border-radius:8px;background:#fff3cd;color:#725000;margin-bottom:8px;font-size:12px;font-weight:700}html[data-panel-theme="black-oled"] .advanced-warning,html[data-panel-theme="oled"] .advanced-warning{background:#2b2200;color:#ffd978}.visual-unavailable{padding:18px;border:1px dashed var(--pc-border);border-radius:9px;color:var(--pc-muted);text-align:center}.advanced-customizer{border:1px solid var(--pc-border);border-radius:10px;background:var(--pc-card);overflow:hidden}.advanced-customizer summary{padding:11px 12px;cursor:pointer;font-weight:800;background:var(--pc-soft)}.advanced-customizer-body{padding:12px;display:grid;gap:12px}.preset-row{display:flex;gap:7px;flex-wrap:wrap}.preset-row button,.order-row button{width:auto;min-height:30px;padding:5px 9px}.order-list{display:grid;gap:6px}.order-row{display:grid;grid-template-columns:1fr auto auto;gap:6px;align-items:center;padding:7px 8px;border:1px solid var(--pc-border);border-radius:8px;background:var(--pc-input)}.style-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.style-grid .wide{grid-column:1/-1}.style-grid label{display:grid;gap:5px}.style-grid select,.style-grid input{width:100%}.advanced-help{font-size:11px;color:var(--pc-muted)}
.info-dot{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border:1px solid var(--pc-border);border-radius:50%;font-size:11px;font-weight:900;color:var(--pc-muted);background:var(--pc-card);cursor:help;vertical-align:middle;margin-left:5px}.info-dot:hover{color:var(--pc-text);border-color:var(--pc-primary)}.models-info{margin-top:10px;display:flex;align-items:center;min-height:22px}.models-info .info-dot{margin-left:0}.print-save-toast{position:fixed!important;top:86px;right:22px;z-index:10000;width:auto!important;max-width:min(420px,calc(100vw - 44px));margin:0!important;padding:9px 12px!important;border-radius:9px!important;box-shadow:0 10px 30px rgba(0,0,0,.2);transition:opacity .22s ease,transform .22s ease}.print-save-toast.is-hiding{opacity:0;transform:translateY(-6px)}
@media(max-width:1250px){.print-center{grid-template-columns:260px minmax(0,1fr)}.preview-column{grid-column:1/-1;position:static}.preview-paper{max-width:360px;margin:auto}}
@media(max-width:820px){.print-center,.print-lower-grid{grid-template-columns:1fr!important}.editor-grid,.config-fields{grid-template-columns:1fr}.config-fields .wide{grid-column:auto}.print-page{font-size:13px}}
</style>
<div class="print-page">
<section class="ops-hero compact"><div><span class="ops-kicker">CONFIGURAÇÕES DO ERP</span><h1>🖨️ Comprovantes e Impressões <span class="info-dot" title="Central de impressão do Quality ERP. Crie, edite e reutilize modelos em todo o sistema." aria-label="Informações sobre a Central de Impressões">i</span></h1></div><a class="btn" href="/configuracoes">← Configurações</a></section>
<nav class="print-tabs" aria-label="Áreas da Central de Impressões"><button type="button" class="active" data-print-pane="modelsPane">Modelos personalizados</button><button type="button" data-print-pane="generalPane">Configurações gerais</button></nav>
<div id="modelsPane" class="print-pane">

<section id="models" class="print-center">
  <aside class="print-panel">
    <h2>Modelos cadastrados</h2><p class="settings-note">Selecione um modelo para carregar seus dados no editor.</p>
    <button class="btn primary" type="button" id="newModel">＋ Novo modelo</button>
    <input class="model-search" id="modelSearch" placeholder="Buscar modelo...">
    <div class="model-list" id="modelList">
      <% printModels.forEach((model,index)=>{ %>
      <button type="button" class="model-item <%= index===0?'active':'' %>" data-model-id="<%= model.id %>">
        <span><b><%= model.icon || '📄' %> <%= model.name %></b><small><%= model.system ? 'Modelo do sistema' : 'Modelo personalizado' %> · <%= model.type==='sale'?'Somente venda':model.type==='service_order'?'Somente O.S.':model.type==='credit_book'?'Carnê de crediário':'Venda e O.S.' %> · <%= model.paper==='thermal'?'Cupom térmico':'A4' %></small></span>
        <span class="status-pill"><%= model.active===false?'Inativo':'Ativo' %></span>
      </button>
      <% }) %>
      <% if(!printModels.length){ %><p class="settings-note">Nenhum modelo personalizado criado.</p><% } %>
    </div>
    <div class="models-info"><span class="info-dot" title="Modelos ativos aparecem nas opções de impressão do PDV." aria-label="Informação sobre modelos ativos">i</span></div>
  </aside>

  <main class="print-panel">
    <div class="editor-heading"><h2>Editar modelo</h2><span class="save-state saved" id="saveState">✓ Alterações salvas</span></div>
    <form method="post" action="/erp/configuracoes/comprovantes/modelos" id="modelForm">
      <input type="hidden" name="id" id="modelId">
      <div class="editor-grid">
        <label>Nome do modelo<input name="name" id="modelName" required></label>
        <label>Aplicação<select name="type" id="modelType"><option value="all">Venda e O.S.</option><option value="sale">Somente venda</option><option value="service_order">Somente O.S.</option><option value="credit_book">Carnê de crediário</option></select></label>
        <label>Formato do papel<select name="paper" id="modelPaper"><option value="thermal">Cupom térmico</option><option value="a4">Folha A4</option></select></label>
        <label>Situação<select id="modelActiveSelect"><option value="1">Ativo</option><option value="0">Inativo</option></select><input type="checkbox" hidden name="active" id="modelActive" checked></label>
      </div>
      <input type="hidden" name="visualConfig" id="visualConfigInput">
      <div class="editor-mode-tabs" role="tablist" aria-label="Modo de edição">
        <button type="button" class="active" data-editor-mode="visual">✨ Editor visual</button>
        <button type="button" data-editor-mode="advanced">&lt;/&gt; Código avançado</button>
      </div>
      <div id="visualEditorPane" class="visual-editor-pane">
        <div class="visual-editor-note"><b>Personalização simples</b><span>Ative, oculte e edite os blocos abaixo. A prévia é atualizada automaticamente.</span></div>
        <div id="visualEditorSections" class="visual-editor-sections"></div>
      </div>
      <div id="advancedEditorPane" hidden>
        <div class="advanced-warning">Modo avançado. Alterações feitas aqui são preservadas, mas uma edição visual posterior pode reorganizar o HTML deste modelo.</div>
        <div class="editor-toolbar">
          <button type="button" data-wrap="<strong>|</strong>"><b>B</b></button><button type="button" data-wrap="<em>|</em>"><i>I</i></button><button type="button" data-wrap="<u>|</u>"><u>U</u></button>
          <select id="fontSize"><option value="12">12px</option><option value="13" selected>13px</option><option value="14">14px</option><option value="16">16px</option></select>
          <button type="button" id="insertBreak">Quebra de linha</button><button type="button" id="insertRule">Linha</button>
        </div>
        <textarea class="model-content" name="content" id="modelContent" required placeholder="Digite o conteúdo e insira variáveis do ERP..."></textarea>
      </div>
      <div class="footer-actions"><div><button class="btn primary" type="submit">Salvar alterações</button> <button class="btn" type="button" id="previewButton">Visualizar impressão</button></div><div><button class="btn" type="submit" name="action" value="restore" id="restoreButton" hidden onclick="return confirm('Restaurar o conteúdo original deste modelo?')">Restaurar padrão</button> <button class="btn" type="submit" name="action" value="duplicate" id="duplicateButton">Duplicar</button> <button class="btn danger" type="submit" name="action" value="delete" id="deleteButton" onclick="return confirm('Excluir este modelo?')">Excluir</button></div></div>
    </form>
  </main>

  <aside class="print-panel preview-column">
    <h2>Pré-visualização</h2><p class="settings-note">Use dados de exemplo ou carregue uma venda/O.S. real pelo número.</p>
    <div class="real-preview-box">
      <label id="realPreviewLabel" for="realPreviewNumber">Visualizar dados reais</label>
      <input id="realPreviewNumber" inputmode="numeric" autocomplete="off" placeholder="Número da venda">
      <button class="btn primary" type="button" id="realPreviewLoad">Carregar</button>
      <div class="real-preview-status" id="realPreviewStatus">O tipo é definido automaticamente pelo modelo selecionado.</div>
      <button type="button" class="real-preview-clear" id="realPreviewClear" hidden>Voltar para dados de exemplo</button>
    </div>
    <div class="preview-scenarios" id="previewScenarios"><button type="button" class="active" data-payment-preview="simple">Venda simples</button><button type="button" data-payment-preview="installments">Parcelada</button><button type="button" data-payment-preview="mixed">Pagamento misto</button></div>
    <div class="preview-paper" id="previewPaper"><iframe id="previewFrame" title="Pré-visualização da impressão" style="width:100%;height:590px;border:0;background:#fff"></iframe></div>
  </aside>
</section>

<section class="print-center print-lower-grid" id="modelTools">
  <div class="print-panel variable-groups">
    <details><summary>Variáveis disponíveis</summary>
      <p class="settings-note">Clique em uma variável para inserir no cursor do editor.</p>
      <details><summary>Cliente</summary><div class="variable-list">
        <button type="button" class="variable-btn" data-variable="{{cliente}}"><span>Nome do cliente</span><code>{{cliente}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{cpf}}"><span>CPF/CNPJ</span><code>{{cpf}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{telefone}}"><span>Telefone</span><code>{{telefone}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{endereco}}"><span>Endereço</span><code>{{endereco}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{cliente_email}}"><span>E-mail</span><code>{{cliente_email}}</code></button>
      </div></details>
      <details><summary>Venda</summary><div class="variable-list">
        <button type="button" class="variable-btn" data-variable="{{numero}}"><span>Número</span><code>{{numero}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{status}}"><span>Status</span><code>{{status}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{vendedor}}"><span>Vendedor</span><code>{{vendedor}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{itens_tabela}}"><span>Tabela completa de itens</span><code>{{itens_tabela}}</code></button><button type="button" class="variable-btn" data-variable="{{itens_resumo}}"><span>Resumo dos itens</span><code>{{itens_resumo}}</code></button><button type="button" class="variable-btn" data-variable="{{pagamentos}}"><span>Pagamentos</span><code>{{pagamentos}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{total}}"><span>Total</span><code>{{total}}</code></button>
      </div></details>
      <details><summary>Crediário / Carnê</summary><div class="variable-list">
        <button type="button" class="variable-btn" data-variable="{{crediario_total}}"><span>Total no crediário</span><code>{{crediario_total}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{crediario_quantidade}}"><span>Quantidade de parcelas</span><code>{{crediario_quantidade}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{crediario_itens}}"><span>Itens da venda no carnê</span><code>{{crediario_itens}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{crediario_parcelas}}"><span>Resumo das parcelas</span><code>{{crediario_parcelas}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{crediario_canhoes}}"><span>Canhotos para assinatura/recebimento</span><code>{{crediario_canhoes}}</code></button>
      </div></details>
      <details><summary>O.S.</summary><div class="variable-list">
        <button type="button" class="variable-btn" data-variable="{{os_aparelho}}"><span>Aparelho</span><code>{{os_aparelho}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{os_defeito}}"><span>Defeito informado</span><code>{{os_defeito}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{os_tecnico}}"><span>Técnico</span><code>{{os_tecnico}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{os_abertura}}"><span>Data de abertura</span><code>{{os_abertura}}</code></button><button type="button" class="variable-btn" data-variable="{{os_problema_bloco}}"><span>Bloco do problema</span><code>{{os_problema_bloco}}</code></button><button type="button" class="variable-btn" data-variable="{{os_problema_conteudo}}"><span>Conteúdo do problema</span><code>{{os_problema_conteudo}}</code></button><button type="button" class="variable-btn" data-variable="{{os_acessorios_bloco}}"><span>Bloco de acessórios</span><code>{{os_acessorios_bloco}}</code></button><button type="button" class="variable-btn" data-variable="{{os_acessorios_conteudo}}"><span>Conteúdo dos acessórios</span><code>{{os_acessorios_conteudo}}</code></button><button type="button" class="variable-btn" data-variable="{{os_servico_bloco}}"><span>Bloco do serviço executado</span><code>{{os_servico_bloco}}</code></button><button type="button" class="variable-btn" data-variable="{{senhas_desenho}}"><span>Senhas de desenho</span><code>{{senhas_desenho}}</code></button>
      </div></details>
      <details><summary>Empresa / Loja</summary><div class="variable-list">
        <button type="button" class="variable-btn" data-variable="{{empresa}}"><span>Nome fantasia</span><code>{{empresa}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{empresa_razao}}"><span>Razão social</span><code>{{empresa_razao}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{empresa_cnpj}}"><span>CNPJ / documento</span><code>{{empresa_cnpj}}</code></button>
        <button type="button" class="variable-btn" data-variable="{{empresa_endereco}}"><span>Endereço da empresa</span><code>{{empresa_endereco}}</code></button>
