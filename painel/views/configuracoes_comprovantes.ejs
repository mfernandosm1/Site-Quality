      <label class="range-line">Espaço abaixo <output id="logoBottomOutput"><%= Number(printSettings.logoMarginBottom ?? 7) %>px</output><input id="logoMarginBottom" type="range" name="logoMarginBottom" min="0" max="30" step="1" value="<%= Number(printSettings.logoMarginBottom ?? 7) %>"></label>
      <% if (printSettings.logoUrl) { %><div class="logo-live-preview" id="logoLivePreview"><img src="<%= printSettings.logoUrl %>?v=<%= printSettings.logoVersion || 1 %>" alt="Logo atual"></div><label><input type="checkbox" name="removeLogo" value="1"> Remover logo atual</label><% } else { %><div class="logo-live-preview settings-note" id="logoLivePreview">Envie uma logo para visualizar aqui.</div><% } %>
