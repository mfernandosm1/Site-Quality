</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
const flashMessage = document.querySelector('.notice');
if (flashMessage) {
  setTimeout(() => {
    flashMessage.style.display = 'none';
  }, 3500);
}
  const tabButtons = document.querySelectorAll('.marketing-tab-btn');
  const tabPanels = document.querySelectorAll('.marketing-tab-panel');
  const promptInput = document.getElementById('marketing-prompt');
  const generateBtn = document.getElementById('marketing-generate-btn');
  const regenerateBtn = document.getElementById('marketing-regenerate-btn');
  const regenerateTopBtn = document.getElementById('marketing-regenerate-top-btn');
  const clearBtn = document.getElementById('marketing-clear-btn');
  const statusEl = document.getElementById('marketing-status');
  const resultsBox = document.getElementById('marketing-results');
  const historyList = document.getElementById('marketing-history-list');
  const historyEmpty = document.getElementById('marketing-history-empty');
  const showFavoritesBtn = document.getElementById('marketing-show-favorites-btn');
  const currentFavoriteBtn = document.getElementById('marketing-current-favorite-btn');
  const productSelect = document.getElementById('marketing-product-select');
  const useProductBtn = document.getElementById('marketing-use-product-btn');
  const clearProductBtn = document.getElementById('marketing-clear-product-btn');
  const productPreview = document.getElementById('marketing-product-preview');
  const copyAllBtn = document.getElementById('marketing-copy-all-btn');
  const clearTemplateBtn = document.getElementById('marketing-clear-template-btn');
  const marketingProducts = <%- JSON.stringify(marketingProducts || []).replace(/</g, '\\u003c') %>;
  const productsById = new Map((marketingProducts || []).map(product => [String(product.id), product]));
  let currentHistoryId = null;

  const chatMessage = document.getElementById('marketing-chat-message');
  const chatSendBtn = document.getElementById('marketing-chat-send-btn');
  const chatCopyBtn = document.getElementById('marketing-chat-copy-btn');
  const chatStatus = document.getElementById('marketing-chat-status');
  const chatOutput = document.getElementById('marketing-chat-output');
  const chatWindow = document.getElementById('marketing-chat-window');
  const chatTyping = document.getElementById('marketing-chat-typing');
  const chatClearBtn = document.getElementById('marketing-chat-clear-btn');
  let chatItems = [];
  let lastChatReply = '';
  const campaignFocus = document.getElementById('marketing-campaign-focus');
  const campaignBtn = document.getElementById('marketing-campaign-btn');
  const campaignCopyBtn = document.getElementById('marketing-campaign-copy-btn');
  const campaignStatus = document.getElementById('marketing-campaign-status');
  const campaignOutput = document.getElementById('marketing-campaign-output');
  const calendarDays = document.getElementById('marketing-calendar-days');
  const calendarFocus = document.getElementById('marketing-calendar-focus');
  const calendarBtn = document.getElementById('marketing-calendar-btn');
  const calendarCopyBtn = document.getElementById('marketing-calendar-copy-btn');
  const calendarStatus = document.getElementById('marketing-calendar-status');
  const calendarOutput = document.getElementById('marketing-calendar-output');


  const fields = {
    story: document.getElementById('result-story'),
    enquete: document.getElementById('result-enquete'),
    grupo: document.getElementById('result-grupo'),
    instagram: document.getElementById('result-instagram'),
    reels: document.getElementById('result-reels')
  };


  function setMiniStatus(el, text, type = 'normal') {
    if (!el) return;
    el.textContent = text || '';
    el.style.color = type === 'error' ? '#a40000' : '#374151';
  }

  function textFromHtml(el) {
    return (el?.innerText || el?.textContent || '').trim();
  }

  function renderIdeas(ideas = []) {
    return ideas.map(idea => `
      <div class="idea-card">
        <strong>💡 ${escapeHtml(idea.title || '')}</strong>
        <div><b>Canal:</b> ${escapeHtml(idea.channel || '')}</div>
        <div>${escapeHtml(idea.description || '')}</div>
        <div><b>CTA:</b> ${escapeHtml(idea.cta || '')}</div>
      </div>
    `).join('');
  }

  function renderCalendar(days = []) {
    return days.map(day => `
      <div class="calendar-card">
        <strong>🗓️ ${escapeHtml(day.day || '')} — ${escapeHtml(day.title || '')}</strong>
        <div><b>Canal:</b> ${escapeHtml(day.channel || '')}</div>
        <div><b>Objetivo:</b> ${escapeHtml(day.objective || '')}</div>
        <div>${escapeHtml(day.content || '')}</div>
      </div>
    `).join('');
  }

  function renderChatMessages(items = []) {
    if (!chatWindow) return;
    chatWindow.innerHTML = '';

    if (!items.length) {
      chatWindow.innerHTML = '<div class="marketing-chat-empty">Faça uma pergunta para começar. Ex.: “O que posso postar hoje no domingo?”</div>';
      return;
    }

    items.forEach(item => {
      const row = document.createElement('div');
      row.className = 'marketing-chat-message-row ' + (item.role === 'model' ? 'model' : 'user');

      const bubble = document.createElement('div');
      bubble.className = 'marketing-chat-bubble';
      const text = typeof item.text === 'object' && item.text !== null
        ? (item.text.reply || item.text.resposta || item.text.message || item.text.text || JSON.stringify(item.text))
        : (item.text || '');
      bubble.textContent = text;

      row.appendChild(bubble);
      chatWindow.appendChild(row);
    });

    chatWindow.scrollTop = chatWindow.scrollHeight;
  }

  async function loadChatHistory() {
    try {
      const res = await fetch('/marketing/chat/history', { headers: { 'Accept': 'application/json' } });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) return;
      chatItems = Array.isArray(json.items) ? json.items : [];
      lastChatReply = [...chatItems].reverse().find(item => item.role === 'model')?.text || '';
      renderChatMessages(chatItems);
      if (chatCopyBtn) chatCopyBtn.style.display = lastChatReply ? 'inline-flex' : 'none';
    } catch (_) {}
  }

  function setStatus(text, type = 'normal') {
    if (!statusEl) return;
    statusEl.textContent = text || '';
    statusEl.style.color = type === 'error' ? '#a40000' : '#374151';
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function getOutputFromFields() {
    return {
      story: fields.story?.value || '',
      enquete: fields.enquete?.value || '',
      grupo: fields.grupo?.value || '',
      instagram: fields.instagram?.value || '',
      reels: fields.reels?.value || ''
    };
  }

  function selectedProduct() {
    if (!productSelect || !productSelect.value) return null;
    return productsById.get(String(productSelect.value)) || null;
  }

  function updateProductPreview() {
    const product = selectedProduct();
    if (!productPreview) return;

    if (!product) {
      productPreview.style.display = 'none';
      productPreview.innerHTML = '';
      return;
    }

    const desc = product.descriptionShort || product.descriptionLong || 'Sem descrição cadastrada.';
    productPreview.style.display = '';
    productPreview.innerHTML = `
      <strong>📦 ${escapeHtml(product.name || '')}</strong><br>
      Categoria: ${escapeHtml(product.category || 'Não informada')}<br>
      ${product.priceFormatted && product.showPrice ? 'Preço: ' + escapeHtml(product.priceFormatted) + '<br>' : ''}
      <span>${escapeHtml(desc).slice(0, 260)}${desc.length > 260 ? '...' : ''}</span>
    `;
  }

  function fillPromptWithProduct() {
    const product = selectedProduct();
    if (!product) {
      alert('Selecione um produto cadastrado primeiro.');
      return;
    }

    const base = `Criar divulgação para o produto cadastrado: ${product.name}.`;
    const current = promptInput.value.trim();

    if (!current) {
      promptInput.value = base + '\nQuero textos vendedores, curtos, com emojis e CTA para chamar no WhatsApp.';
    } else if (!current.includes(product.name)) {
      promptInput.value = `${base}\n${current}`;
    }

    promptInput.focus();
    updateProductPreview();
    setStatus('📦 Produto carregado. Agora é só clicar em Gerar Conteúdo.');
  }

  function applyOutputToFields(output = {}, prompt = '') {
    fields.story.value = output.story || '';
    fields.enquete.value = output.enquete || '';
    fields.grupo.value = output.grupo || '';
    fields.instagram.value = output.instagram || '';
    fields.reels.value = output.reels || output.videoIdea || '';
    if (prompt) promptInput.value = prompt;
    resultsBox.style.display = 'grid';
    if (regenerateTopBtn) regenerateTopBtn.style.display = 'inline-flex';
    document.querySelector('[data-tab="gerador"]')?.click();
    setStatus('♻️ Geração antiga carregada. Você pode editar, copiar ou gerar nova versão.');
  }

  function safeJsonForScript(obj) {
    return JSON.stringify(obj || {}).replace(/</g, '\\u003c');
  }

  function addHistoryItem(item) {
    if (!item || !historyList) return;

    currentHistoryId = item.id || null;
    if (historyEmpty) historyEmpty.style.display = 'none';
    historyList.style.display = '';

    const output = item.output || {};
    const search = `${item.prompt || ''} ${output.story || ''} ${output.enquete || ''} ${output.grupo || ''} ${output.instagram || ''} ${output.reels || ''}`.toLowerCase();
    const div = document.createElement('div');
    div.className = 'marketing-list-item marketing-history-item';
    div.dataset.id = item.id || '';
    div.dataset.favorite = item.favorite ? '1' : '0';
    div.dataset.feedback = item.feedback || '';
    div.dataset.search = search;

    const createdAt = item.createdAt ? new Date(item.createdAt).toLocaleString('pt-BR') : new Date().toLocaleString('pt-BR');

    div.innerHTML = `
      <script type="application/json" id="history-output-${escapeHtml(item.id || '')}">${safeJsonForScript(output)}<\/script>
      <div class="marketing-list-meta">
        <strong><span class="marketing-fav-star">📝</span> ${escapeHtml(item.prompt || '')}</strong>
        <div class="marketing-history-top-actions">
          <span>${escapeHtml(createdAt)}</span>
          <button class="btn" type="button" data-history-reuse="${escapeHtml(item.id || '')}" data-prompt="${escapeHtml(item.prompt || '')}">♻️ Reutilizar</button>
          <button class="btn" type="button" data-copy-history-all="${escapeHtml(item.id || '')}">📋 Copiar tudo</button>
          <button class="btn" type="button" data-history-favorite="${escapeHtml(item.id || '')}">☆ Favoritar</button>
          <form method="post" action="/marketing/history/delete" onsubmit="return confirm('Excluir este item do histórico?')">
            <input type="hidden" name="id" value="${escapeHtml(item.id || '')}">
            <button class="btn" type="submit">Excluir</button>
          </form>
        </div>
      </div>
      <div class="marketing-history-copy-grid">
        <div class="marketing-list-text" data-history-text="story"><strong>Story:</strong><br>${escapeHtml(output.story || '')}</div>
        <button class="btn" type="button" data-copy-history="story">📋 Copiar Story</button>
        <div class="marketing-list-text" data-history-text="grupo"><strong>Grupo:</strong><br>${escapeHtml(output.grupo || '')}</div>
        <button class="btn" type="button" data-copy-history="grupo">📋 Copiar Grupo</button>
        <div class="marketing-list-text" data-history-text="instagram"><strong>Instagram/Facebook:</strong><br>${escapeHtml(output.instagram || '')}</div>
        <button class="btn" type="button" data-copy-history="instagram">📋 Copiar Instagram</button>
        <div class="marketing-list-text" data-history-text="enquete"><strong>Enquete:</strong><br>${escapeHtml(output.enquete || '')}</div>
        <button class="btn" type="button" data-copy-history="enquete">📋 Copiar Enquete</button>
        <div class="marketing-list-text" data-history-text="reels"><strong>Reels:</strong><br>${escapeHtml(output.reels || '')}</div>
        <button class="btn" type="button" data-copy-history="reels">📋 Copiar Reels</button>
      </div>
    `;

    historyList.prepend(div);
  }

  async function postHistoryAction(url, payload = {}) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.success) throw new Error(json.message || 'Erro ao atualizar histórico.');
    return json;
  }

  async function copyPlainText(text, btn) {
    try {
      await navigator.clipboard.writeText(text || '');
      if (btn) {
        const oldText = btn.textContent;
        btn.textContent = '✅ Copiado';
        setTimeout(() => { btn.textContent = oldText; }, 1300);
      }
    } catch (_) {
      const temp = document.createElement('textarea');
      temp.value = text || '';
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      temp.remove();
    }
  }


  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      tabButtons.forEach(b => b.classList.remove('active'));
      tabPanels.forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + tab)?.classList.add('active');
    });
  });

  document.querySelectorAll('.marketing-quick-buttons button').forEach(btn => {
    btn.addEventListener('click', () => {
      const add = btn.dataset.add || '';
      const current = promptInput.value.trim();
      promptInput.value = current ? current + '\n' + add : add;
      promptInput.focus();
      setStatus('⚡ Template rápido adicionado. Você pode editar antes de gerar.');
    });
  });

  clearTemplateBtn?.addEventListener('click', () => {
    promptInput.value = '';
    promptInput.focus();
    setStatus('');
  });

  async function generateMarketing() {
    const prompt = promptInput.value.trim();
    const productId = productSelect?.value || '';
    if (!prompt && !productId) {
      alert('Digite o que deseja criar ou selecione um produto cadastrado.');
      return;
    }

    const oldText = generateBtn.textContent;
    generateBtn.disabled = true;
    if (regenerateBtn) regenerateBtn.disabled = true;
    if (regenerateTopBtn) regenerateTopBtn.disabled = true;
    generateBtn.textContent = 'Gerando...';
    setStatus('⏳ Gerando conteúdo com IA...');

    try {
      const res = await fetch('/marketing/generate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ prompt, productId })
      });

      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || 'Erro ao gerar conteúdo.');

      const output = json.output || {};
      fields.story.value = output.story || '';
      fields.enquete.value = output.enquete || '';
      fields.grupo.value = output.grupo || '';
      fields.instagram.value = output.instagram || '';
      fields.reels.value = output.reels || output.videoIdea || '';
      resultsBox.style.display = 'grid';
      if (regenerateTopBtn) regenerateTopBtn.style.display = 'inline-flex';
      currentHistoryId = json.historyItem?.id || null;
      currentFavoriteBtn?.classList.remove('is-favorite-current');
      if (currentFavoriteBtn) currentFavoriteBtn.textContent = '⭐ Favoritar';
      addHistoryItem(json.historyItem);
      setStatus('✅ Conteúdo gerado. Você pode editar antes de copiar.');
    } catch (err) {
      console.error(err);
      setStatus('⚠️ ' + err.message, 'error');
    } finally {
      generateBtn.disabled = false;
      if (regenerateBtn) regenerateBtn.disabled = false;
      if (regenerateTopBtn) regenerateTopBtn.disabled = false;
      generateBtn.textContent = oldText;
    }
  }

  async function rewriteField(fieldId, channel, action, btn) {
    const field = document.getElementById(fieldId);
    if (!field || !field.value.trim()) {
      alert('Não há texto para reformular.');
      return;
    }

    const instruction = action || 'Melhorar mantendo a mesma ideia.';

    const oldText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Reformulando...';
    setStatus('⏳ Reformulando texto com IA...');

    try {
      const res = await fetch('/marketing/rewrite', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          originalPrompt: promptInput.value.trim(),
          channel,
          text: field.value,
          instruction
        })
      });

      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || 'Erro ao reformular texto.');

      field.value = json.text || field.value;
      setStatus('✅ Texto reformulado. Você pode editar antes de copiar.');
    } catch (err) {
      console.error(err);
      setStatus('⚠️ ' + err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = oldText;
    }
  }

  function buildAllText(sourceOutput = null) {
    const output = sourceOutput || getOutputFromFields();
    return [
      '===== STORY =====',
      output.story,
      '',
      '===== ENQUETE / INTERAÇÃO STORY =====',
      output.enquete,
      '',
      '===== GRUPOS WHATSAPP =====',
      output.grupo,
      '',
      '===== INSTAGRAM / FACEBOOK =====',
      output.instagram,
      '',
      '===== ROTEIRO REELS =====',
      output.reels
    ].join('\n').trim();
  }

  productSelect?.addEventListener('change', updateProductPreview);
  useProductBtn?.addEventListener('click', fillPromptWithProduct);
  clearProductBtn?.addEventListener('click', () => {
    if (productSelect) productSelect.value = '';
    updateProductPreview();
    setStatus('');
  });

  copyAllBtn?.addEventListener('click', async () => {
    const text = buildAllText();
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      const oldText = copyAllBtn.textContent;
      copyAllBtn.textContent = '✅ Tudo copiado';
      setTimeout(() => { copyAllBtn.textContent = oldText; }, 1300);
    } catch (_) {
      const temp = document.createElement('textarea');
      temp.value = text;
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      temp.remove();
    }
  });

  generateBtn?.addEventListener('click', generateMarketing);
  regenerateBtn?.addEventListener('click', generateMarketing);
  regenerateTopBtn?.addEventListener('click', generateMarketing);

  clearBtn?.addEventListener('click', () => {
    promptInput.value = '';
    if (productSelect) productSelect.value = '';
    updateProductPreview();
    Object.values(fields).forEach(field => field.value = '');
    resultsBox.style.display = 'none';
    if (regenerateTopBtn) regenerateTopBtn.style.display = 'none';
    currentHistoryId = null;
    currentFavoriteBtn?.classList.remove('is-favorite-current');
    if (currentFavoriteBtn) currentFavoriteBtn.textContent = '⭐ Favoritar';
    setStatus('');
  });

  document.querySelectorAll('[data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.copy;
      const field = document.getElementById(id);
      if (!field) return;
      await copyPlainText(field.value || '', btn);
    });
  });

  document.querySelectorAll('[data-rewrite]').forEach(btn => {
    btn.addEventListener('click', () => {
      rewriteField(btn.dataset.rewrite, btn.dataset.channel || 'geral', btn.dataset.action || 'Melhorar mantendo a mesma ideia.', btn);
    });
  });


  historyList?.addEventListener('click', async (event) => {
    const btn = event.target.closest('button');
    if (!btn) return;
    const itemEl = btn.closest('.marketing-history-item');
    if (!itemEl) return;

    try {
      if (btn.dataset.historyReuse) {
        const script = document.getElementById('history-output-' + btn.dataset.historyReuse);
        const output = script ? JSON.parse(script.textContent || '{}') : {};
        currentHistoryId = btn.dataset.historyReuse;
        applyOutputToFields(output, btn.dataset.prompt || itemEl.querySelector('.marketing-list-meta strong')?.textContent?.replace(/^⭐|^📝/, '').trim() || '');
      }

      if (btn.dataset.copyHistory) {
        const channel = btn.dataset.copyHistory;
        const script = document.getElementById('history-output-' + itemEl.dataset.id);
        const output = script ? JSON.parse(script.textContent || '{}') : {};
        await copyPlainText(output[channel] || '', btn);
      }

      if (btn.dataset.copyHistoryAll) {
        const script = document.getElementById('history-output-' + itemEl.dataset.id);
        const output = script ? JSON.parse(script.textContent || '{}') : {};
        await copyPlainText(buildAllText(output), btn);
      }

      if (btn.dataset.historyFavorite) {
        const json = await postHistoryAction('/marketing/history/favorite', { id: btn.dataset.historyFavorite });
        itemEl.dataset.favorite = json.favorite ? '1' : '0';
        itemEl.classList.toggle('is-favorite', Boolean(json.favorite));
        itemEl.querySelector('.marketing-fav-star').textContent = json.favorite ? '⭐' : '📝';
        btn.textContent = json.favorite ? '⭐ Favorito' : '☆ Favoritar';
        if (currentHistoryId && String(currentHistoryId) === String(btn.dataset.historyFavorite)) {
          currentFavoriteBtn?.classList.toggle('is-favorite-current', Boolean(json.favorite));
          if (currentFavoriteBtn) currentFavoriteBtn.textContent = json.favorite ? '⭐ Favorito' : '⭐ Favoritar';
        }
        setStatus(json.favorite ? '⭐ Geração favoritada e destacada em amarelo.' : '☆ Geração removida dos favoritos.');
      }
    } catch (err) {
      console.error(err);
      setStatus('⚠️ ' + err.message, 'error');
    }
  });

  showFavoritesBtn?.addEventListener('click', () => {
    const only = showFavoritesBtn.dataset.onlyFavorites !== '1';
    showFavoritesBtn.dataset.onlyFavorites = only ? '1' : '0';
    showFavoritesBtn.textContent = only ? '📜 Ver todo histórico' : '⭐ Ver favoritos';
    document.querySelectorAll('.marketing-history-item').forEach(item => {
      item.style.display = only && item.dataset.favorite !== '1' ? 'none' : '';
    });
  });

  currentFavoriteBtn?.addEventListener('click', async () => {
    if (!currentHistoryId) return alert('Gere um conteúdo primeiro.');
    const json = await postHistoryAction('/marketing/history/favorite', { id: currentHistoryId });
    const itemEl = document.querySelector(`.marketing-history-item[data-id="${currentHistoryId}"]`);
    if (itemEl) {
      itemEl.dataset.favorite = json.favorite ? '1' : '0';
      itemEl.classList.toggle('is-favorite', Boolean(json.favorite));
      itemEl.querySelector('.marketing-fav-star').textContent = json.favorite ? '⭐' : '📝';
      const favBtn = itemEl.querySelector('[data-history-favorite]');
      if (favBtn) favBtn.textContent = json.favorite ? '⭐ Favorito' : '☆ Favoritar';
    }
    currentFavoriteBtn?.classList.toggle('is-favorite-current', Boolean(json.favorite));
    if (currentFavoriteBtn) currentFavoriteBtn.textContent = json.favorite ? '⭐ Favorito' : '⭐ Favoritar';
    setStatus(json.favorite ? '⭐ Geração atual favoritada e destacada em amarelo.' : '☆ Geração atual removida dos favoritos.');
  });

  const historySearch = document.getElementById('marketing-history-search');

  chatSendBtn?.addEventListener('click', async () => {
    const message = chatMessage?.value.trim() || '';
    if (!message) return alert('Digite uma pergunta para o Chat IA.');

    const oldText = chatSendBtn.textContent;
    chatSendBtn.disabled = true;
    chatSendBtn.textContent = 'Pensando...';
    if (chatTyping) chatTyping.style.display = '';
    setMiniStatus(chatStatus, '⏳ IA digitando...');

    const tempUserMessage = { role: 'user', text: message, createdAt: new Date().toISOString() };
    renderChatMessages([...chatItems, tempUserMessage]);

    try {
      const res = await fetch('/marketing/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ message })
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || 'Erro no Chat IA.');

      chatItems = Array.isArray(json.items) ? json.items : [...chatItems, tempUserMessage, { role: 'model', text: json.reply || '', createdAt: new Date().toISOString() }];
      lastChatReply = json.reply || '';
      renderChatMessages(chatItems);

      if (chatOutput) chatOutput.textContent = lastChatReply;
      if (chatCopyBtn) chatCopyBtn.style.display = lastChatReply ? 'inline-flex' : 'none';
      if (chatMessage) chatMessage.value = '';
      setMiniStatus(chatStatus, '✅ Resposta gerada com memória da conversa.');
    } catch (err) {
      console.error(err);
      renderChatMessages(chatItems);
      setMiniStatus(chatStatus, '⚠️ ' + err.message, 'error');
    } finally {
      if (chatTyping) chatTyping.style.display = 'none';
      chatSendBtn.disabled = false;
      chatSendBtn.textContent = oldText;
    }
  });

  chatMessage?.addEventListener('keydown', event => {
    if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
      event.preventDefault();
      chatSendBtn?.click();
    }
  });

  chatClearBtn?.addEventListener('click', async () => {
    if (!confirm('Limpar a conversa do Chat IA?')) return;
    try {
      const res = await fetch('/marketing/chat/clear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({})
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.message || 'Erro ao limpar chat.');
      chatItems = [];
      lastChatReply = '';
      renderChatMessages(chatItems);
      if (chatCopyBtn) chatCopyBtn.style.display = 'none';
      setMiniStatus(chatStatus, '🧹 Chat limpo.');
    } catch (err) {
      setMiniStatus(chatStatus, '⚠️ ' + err.message, 'error');
    }
  });

  chatCopyBtn?.addEventListener('click', async () => {
    await copyPlainText(lastChatReply || textFromHtml(chatOutput), chatCopyBtn);
  });

  campaignBtn?.addEventListener('click', async () => {
    const focus = campaignFocus?.value.trim() || '';
    const oldText = campaignBtn.textContent;
    campaignBtn.disabled = true;
    campaignBtn.textContent = 'Gerando...';
    setMiniStatus(campaignStatus, '⏳ Gerando sugestões...');

    try {
      const res = await fetch('/marketing/campaign-suggestions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ focus })
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || 'Erro ao gerar sugestões.');
      campaignOutput.innerHTML = renderIdeas(json.ideas || []);
      campaignOutput.style.display = '';
      campaignCopyBtn.style.display = 'inline-flex';
      setMiniStatus(campaignStatus, '✅ Sugestões geradas.');
    } catch (err) {
      console.error(err);
      setMiniStatus(campaignStatus, '⚠️ ' + err.message, 'error');
    } finally {
      campaignBtn.disabled = false;
      campaignBtn.textContent = oldText;
    }
  });

  campaignCopyBtn?.addEventListener('click', async () => {
    await copyPlainText(textFromHtml(campaignOutput), campaignCopyBtn);
  });

  calendarBtn?.addEventListener('click', async () => {
    const focus = calendarFocus?.value.trim() || '';
    const days = calendarDays?.value || '7';
    const oldText = calendarBtn.textContent;
    calendarBtn.disabled = true;
    calendarBtn.textContent = 'Gerando...';
    setMiniStatus(calendarStatus, '⏳ Gerando calendário...');

    try {
      const res = await fetch('/marketing/content-calendar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ focus, days })
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || 'Erro ao gerar calendário.');
      calendarOutput.innerHTML = renderCalendar(json.days || []);
      calendarOutput.style.display = '';
      calendarCopyBtn.style.display = 'inline-flex';
      setMiniStatus(calendarStatus, '✅ Calendário gerado.');
    } catch (err) {
      console.error(err);
      setMiniStatus(calendarStatus, '⚠️ ' + err.message, 'error');
    } finally {
      calendarBtn.disabled = false;
      calendarBtn.textContent = oldText;
    }
  });

  calendarCopyBtn?.addEventListener('click', async () => {
    await copyPlainText(textFromHtml(calendarOutput), calendarCopyBtn);
  });

  historySearch?.addEventListener('input', () => {
    const term = historySearch.value.toLowerCase().trim();
    document.querySelectorAll('.marketing-history-item').forEach(item => {
      item.style.display = item.dataset.search.includes(term) ? '' : 'none';
    });
  });
  loadChatHistory();

});
</script>
