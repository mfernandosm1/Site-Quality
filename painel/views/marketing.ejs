<% layout('layout') -%>
<div class="card">
  <div class="marketing-ia-header">
    <div>
      <h3>✨ Marketing IA</h3>
      <div class="marketing-ia-subtitle">Crie Story, enquete, grupos, Instagram/Facebook e roteiro de Reels em poucos segundos.</div>
    </div>
	
    <% if (!hasGeminiKey) { %>
      <span class="badge">⚠️ Gemini não configurado</span>
    <% } else { %>
      <span class="badge">✅ Gemini configurado</span>
    <% } %>
  </div>

  <% if (!hasGeminiKey) { %>
    <div class="notice">
      Para gerar com IA, crie um arquivo <strong>.env</strong> na pasta <strong>painel</strong> com:<br>
      <code>GEMINI_API_KEY=sua_chave_aqui</code><br>
      Opcional: <code>GEMINI_MODEL=gemini-2.5-flash-lite</code>
    </div>
  <% } %>

  <div class="marketing-tabs">
    <button class="marketing-tab-btn active" type="button" data-tab="gerador">🚀 Gerador</button>
    <button class="marketing-tab-btn" type="button" data-tab="referencias">🧠 Referências</button>
    <button class="marketing-tab-btn" type="button" data-tab="historico">📜 Histórico</button>
    <button class="marketing-tab-btn" type="button" data-tab="chat">💬 Chat IA</button>
    <button class="marketing-tab-btn" type="button" data-tab="campanhas">💡 Campanhas</button>
    <button class="marketing-tab-btn" type="button" data-tab="calendario">🗓️ Calendário</button>
    <button class="marketing-tab-btn" type="button" data-tab="configuracoes">⚙️ Configurações</button>
  </div>

  <section class="marketing-tab-panel active" id="tab-gerador">
    <div class="marketing-prompt-box">
      <div class="marketing-product-box">
        <label>Produto cadastrado</label>
        <div class="marketing-product-row">
          <select id="marketing-product-select">
            <option value="">Selecionar produto do painel...</option>
            <% (marketingProducts || []).forEach(product => { %>
              <option value="<%= product.id %>"><%= product.name %><%= product.category ? ' — ' + product.category : '' %></option>
            <% }) %>
          </select>
          <button class="btn" type="button" id="marketing-use-product-btn">📦 Usar produto</button>
          <button class="btn" type="button" id="marketing-clear-product-btn">Limpar produto</button>
        </div>
        <div class="marketing-product-preview" id="marketing-product-preview" style="display:none;"></div>
      </div>

      <label>O que deseja criar?</label>
      <textarea id="marketing-prompt" placeholder="Ex.: Samsung A16 128GB preto. Quero divulgar nos stories e grupos, destacar garantia, parcelamento e envio rápido."></textarea>

      <div class="marketing-template-header">
        <div>
          <strong>⚡ Templates rápidos avançados</strong>
          <span>Escolha um modelo e ele preenche o pedido automaticamente.</span>
        </div>
        <button class="btn" type="button" id="marketing-clear-template-btn">Limpar texto</button>
      </div>

      <div class="marketing-quick-buttons advanced" id="marketing-quick-buttons">
        <% (quickButtons || []).forEach(btn => { %>
          <button type="button" data-add="<%= btn.text %>" title="<%= btn.text %>"><%= btn.label %></button>
        <% }) %>
      </div>

      <details class="marketing-quick-editor">
        <summary>⚙️ Adicionar ou editar templates rápidos avançados</summary>
        <form method="post" action="/marketing/quick-buttons/save">
          <div class="marketing-quick-editor-list">
            <% (quickButtons || []).forEach(btn => { %>
              <div class="marketing-quick-editor-item">
                <input type="hidden" name="id" value="<%= btn.id %>">
                <div>
                  <label>Botão</label>
                  <input type="text" name="label" value="<%= btn.label %>" placeholder="Ex.: 📱 Produto">
                </div>
                <div>
                  <label>Frase rápida</label>
                  <input type="text" name="text" value="<%= btn.text %>" placeholder="Texto que será adicionado ao campo principal">
                </div>
                <label class="marketing-remove-check">
                  <input type="checkbox" name="removeId" value="<%= btn.id %>"> Excluir
                </label>
              </div>
            <% }) %>
          </div>

          <div class="marketing-quick-editor-item new">
            <div>
              <label>Novo botão</label>
              <input type="text" name="newLabel" placeholder="Ex.: 🧨 Queima de estoque">
            </div>
            <div>
              <label>Nova frase rápida</label>
              <input type="text" name="newText" placeholder="Ex.: Criar campanha de queima de estoque com urgência, sem inventar quantidade.">
            </div>
          </div>

          <button class="btn primary" type="submit">💾 Salvar botões rápidos</button>
        </form>
      </details>

      <div class="marketing-actions-row">
        <button class="btn primary" type="button" id="marketing-generate-btn">🚀 Gerar Conteúdo</button>
        <button class="btn primary" type="button" id="marketing-regenerate-top-btn" style="display:none;">🔄 Gerar novamente tudo</button>
        <button class="btn" type="button" id="marketing-clear-btn">Limpar</button>
        <span class="marketing-status" id="marketing-status"></span>
      </div>
    </div>

    <div class="marketing-results-grid" id="marketing-results" style="display:none;">
      <div class="marketing-result-card full marketing-copy-all-card">
        <div>
          <div class="marketing-result-title">📋 Copiar tudo</div>
          <p style="margin:0;color:#6b7280;font-size:13px;">Copia Story, Enquete, Grupos, Instagram/Facebook e Reels em um clique.</p>
        </div>
        <button class="btn primary" type="button" id="marketing-copy-all-btn">📋 Copiar tudo</button>
      </div>

      <div class="marketing-result-card">
        <div class="marketing-result-title">📱 Story</div>
        <textarea id="result-story"></textarea>
        <div class="marketing-card-actions">
          <button class="btn" type="button" data-copy="result-story">📋 Copiar</button>
          <% (actionButtons || []).forEach(action => { %>
            <button class="btn" type="button" data-rewrite="result-story" data-channel="Story" data-action="<%= action.instruction %>"><%= action.label %></button>
          <% }) %>
        </div>
      </div>

      <div class="marketing-result-card">
        <div class="marketing-result-title">📊 Enquete / Interação Story</div>
        <textarea id="result-enquete"></textarea>
        <div class="marketing-card-actions">
          <button class="btn" type="button" data-copy="result-enquete">📋 Copiar</button>
          <% (actionButtons || []).forEach(action => { %>
            <button class="btn" type="button" data-rewrite="result-enquete" data-channel="Enquete Story" data-action="<%= action.instruction %>"><%= action.label %></button>
          <% }) %>
        </div>
      </div>

      <div class="marketing-result-card">
        <div class="marketing-result-title">👥 Grupos WhatsApp</div>
        <textarea id="result-grupo"></textarea>
        <div class="marketing-card-actions">
          <button class="btn" type="button" data-copy="result-grupo">📋 Copiar</button>
          <% (actionButtons || []).forEach(action => { %>
            <button class="btn" type="button" data-rewrite="result-grupo" data-channel="Grupos WhatsApp" data-action="<%= action.instruction %>"><%= action.label %></button>
          <% }) %>
        </div>
      </div>

      <div class="marketing-result-card">
        <div class="marketing-result-title">📸 Instagram/Facebook</div>
        <textarea id="result-instagram"></textarea>
        <div class="marketing-card-actions">
          <button class="btn" type="button" data-copy="result-instagram">📋 Copiar</button>
          <% (actionButtons || []).forEach(action => { %>
            <button class="btn" type="button" data-rewrite="result-instagram" data-channel="Instagram/Facebook" data-action="<%= action.instruction %>"><%= action.label %></button>
          <% }) %>
        </div>
      </div>

      <div class="marketing-result-card full">
        <div class="marketing-result-title">🎥 Roteiro Reels</div>
        <textarea id="result-reels"></textarea>
        <div class="marketing-card-actions">
          <button class="btn" type="button" data-copy="result-reels">📋 Copiar</button>
          <% (actionButtons || []).forEach(action => { %>
            <button class="btn" type="button" data-rewrite="result-reels" data-channel="Roteiro Reels" data-action="<%= action.instruction %>"><%= action.label %></button>
          <% }) %>
        </div>
      </div>

      <div class="marketing-result-card full">
        <div class="marketing-result-title">🔄 Gerar outra versão</div>
        <p style="margin:0 0 10px 0;color:#6b7280;font-size:13px;">Use estes botões para reaproveitar, favoritar ou refazer a geração atual.</p>
        <div class="marketing-card-actions">
          <button class="btn primary" type="button" id="marketing-regenerate-btn">🔄 Gerar novamente tudo</button>
          <button class="btn" type="button" id="marketing-current-favorite-btn">⭐ Favoritar</button>
        </div>
      </div>
    </div>
  </section>

  <section class="marketing-tab-panel" id="tab-referencias">
    <form method="post" action="/marketing/references/add" class="marketing-reference-form">
      <textarea name="text" placeholder="Cole aqui um texto que você gostou. Pode ser do ChatGPT, Gemini, campanha antiga, concorrente ou texto que vendeu bem. A IA usará apenas como inspiração, sem copiar."></textarea>
      <div>
        <label>Categoria</label>
        <input type="text" name="category" placeholder="Ex.: iPhone, Samsung, Promoção" value="Geral">
      </div>
      <button class="btn primary" type="submit">⭐ Salvar referência</button>
    </form>

    <% if (!references.length) { %>
      <div class="marketing-empty">Nenhuma referência salva ainda.</div>
    <% } else { %>
      <div class="marketing-list">
        <% references.forEach(ref => { %>
          <div class="marketing-list-item">
            <div class="marketing-list-meta">
              <strong>🏷️ <%= ref.category || 'Geral' %></strong>
              <form method="post" action="/marketing/references/delete" onsubmit="return confirm('Excluir esta referência?')">
                <input type="hidden" name="id" value="<%= ref.id %>">
                <button class="btn" type="submit">Excluir</button>
              </form>
            </div>
            <div class="marketing-list-text"><%= ref.text %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="marketing-tab-panel" id="tab-historico">
    <div class="marketing-actions-row" style="margin-bottom:12px;">
      <input type="text" id="marketing-history-search" placeholder="Buscar no histórico..." style="max-width:360px;">
      <button class="btn" type="button" id="marketing-show-favorites-btn" data-only-favorites="0">⭐ Ver favoritos</button>
      <form method="post" action="/marketing/history/clear" onsubmit="return confirm('Limpar todo o histórico?')">
        <button class="btn" type="submit">🗑️ Limpar todo histórico</button>
      </form>
    </div>

    <div class="marketing-empty" id="marketing-history-empty" style="<%= history.length ? 'display:none;' : '' %>">Nenhum conteúdo gerado ainda.</div>

    <div class="marketing-list" id="marketing-history-list" style="<%= history.length ? '' : 'display:none;' %>">
      <% (history || []).forEach(item => { %>
        <div class="marketing-list-item marketing-history-item <%= item.favorite ? 'is-favorite' : '' %>" data-id="<%= item.id %>" data-favorite="<%= item.favorite ? '1' : '0' %>" data-feedback="<%= item.feedback || '' %>" data-search="<%= ((item.prompt || '') + ' ' + (item.output?.story || '') + ' ' + (item.output?.enquete || '') + ' ' + (item.output?.grupo || '') + ' ' + (item.output?.instagram || '') + ' ' + (item.output?.reels || '')).toLowerCase() %>">
          <script type="application/json" id="history-output-<%= item.id %>"><%- JSON.stringify(item.output || {}).replace(/</g, '\\u003c') %></script>
          <div class="marketing-list-meta">
            <strong><span class="marketing-fav-star"><%= item.favorite ? '⭐' : '📝' %></span> <%= item.prompt %></strong>
            <div class="marketing-history-top-actions">
              <span><%= new Date(item.createdAt).toLocaleString('pt-BR') %></span>
              <button class="btn" type="button" data-history-reuse="<%= item.id %>" data-prompt="<%= item.prompt %>">♻️ Reutilizar</button>
              <button class="btn" type="button" data-copy-history-all="<%= item.id %>">📋 Copiar tudo</button>
              <button class="btn" type="button" data-history-favorite="<%= item.id %>"><%= item.favorite ? '⭐ Favorito' : '☆ Favoritar' %></button>
              <form method="post" action="/marketing/history/delete" onsubmit="return confirm('Excluir este item do histórico?')">
                <input type="hidden" name="id" value="<%= item.id %>">
                <button class="btn" type="submit">Excluir</button>
              </form>
            </div>
          </div>

          <div class="marketing-history-copy-grid">
            <div class="marketing-list-text" data-history-text="story"><strong>Story:</strong><br><%= item.output?.story || '' %></div>
            <button class="btn" type="button" data-copy-history="story">📋 Copiar Story</button>

            <div class="marketing-list-text" data-history-text="grupo"><strong>Grupo:</strong><br><%= item.output?.grupo || '' %></div>
            <button class="btn" type="button" data-copy-history="grupo">📋 Copiar Grupo</button>

            <div class="marketing-list-text" data-history-text="instagram"><strong>Instagram/Facebook:</strong><br><%= item.output?.instagram || '' %></div>
            <button class="btn" type="button" data-copy-history="instagram">📋 Copiar Instagram</button>

            <div class="marketing-list-text" data-history-text="enquete"><strong>Enquete:</strong><br><%= item.output?.enquete || '' %></div>
            <button class="btn" type="button" data-copy-history="enquete">📋 Copiar Enquete</button>

            <div class="marketing-list-text" data-history-text="reels"><strong>Reels:</strong><br><%= item.output?.reels || item.output?.videoIdea || '' %></div>
            <button class="btn" type="button" data-copy-history="reels">📋 Copiar Reels</button>
          </div>
        </div>
      <% }) %>
    </div>
  </section>


  <section class="marketing-tab-panel" id="tab-chat">
    <div class="marketing-ai-tool-card marketing-chat-card">
      <div class="marketing-chat-head">
        <div>
          <h3>💬 Chat IA interno</h3>
          <p>Agora o chat mantém o contexto da conversa e usa as configurações da empresa como base.</p>
        </div>
        <button class="btn" type="button" id="marketing-chat-clear-btn">🧹 Limpar Chat</button>
      </div>

      <div class="marketing-chat-window" id="marketing-chat-window">
        <div class="marketing-chat-empty">Faça uma pergunta para começar. Ex.: “O que posso postar hoje no domingo?”</div>
      </div>

      <div class="marketing-chat-typing" id="marketing-chat-typing" style="display:none;">✨ IA digitando...</div>

      <textarea id="marketing-chat-message" placeholder="Ex.: Me dê uma ideia simples para vender mais iPhones essa semana nos stories e grupos."></textarea>
      <div class="marketing-actions-row">
        <button class="btn primary" type="button" id="marketing-chat-send-btn">💬 Enviar pergunta</button>
        <button class="btn" type="button" id="marketing-chat-copy-btn" style="display:none;">📋 Copiar última resposta</button>
        <span class="marketing-status" id="marketing-chat-status"></span>
      </div>
      <div class="marketing-ai-output" id="marketing-chat-output" style="display:none;"></div>
    </div>
  </section>

  <section class="marketing-tab-panel" id="tab-campanhas">
    <div class="marketing-ai-tool-card">
      <h3>💡 Sugestões automáticas de campanhas</h3>
      <p>A IA usa suas configurações, produtos cadastrados e histórico recente para sugerir campanhas fáceis de executar.</p>
      <textarea id="marketing-campaign-focus" placeholder="Ex.: Quero campanhas para vender smartphones, acessórios e divulgar 60x no boleto."></textarea>
      <div class="marketing-actions-row">
        <button class="btn primary" type="button" id="marketing-campaign-btn">💡 Gerar sugestões</button>
        <button class="btn" type="button" id="marketing-campaign-copy-btn" style="display:none;">📋 Copiar sugestões</button>
        <span class="marketing-status" id="marketing-campaign-status"></span>
      </div>
      <div class="marketing-ai-output" id="marketing-campaign-output" style="display:none;"></div>
    </div>
  </section>

  <section class="marketing-tab-panel" id="tab-calendario">
    <div class="marketing-ai-tool-card">
      <h3>🗓️ Calendário de conteúdo</h3>
      <p>Gere um plano simples para postar todos os dias com Story, Reels, Status, grupos e feed.</p>
      <div class="row">
        <div>
          <label>Quantidade de dias</label>
          <select id="marketing-calendar-days">
            <option value="7">7 dias</option>
            <option value="14">14 dias</option>
            <option value="30">30 dias</option>
          </select>
        </div>
      </div>
      <textarea id="marketing-calendar-focus" placeholder="Ex.: Calendário para uma semana focado em celulares, acessórios, assistência e frete grátis regional."></textarea>
      <div class="marketing-actions-row">
        <button class="btn primary" type="button" id="marketing-calendar-btn">🗓️ Gerar calendário</button>
        <button class="btn" type="button" id="marketing-calendar-copy-btn" style="display:none;">📋 Copiar calendário</button>
        <span class="marketing-status" id="marketing-calendar-status"></span>
      </div>
      <div class="marketing-ai-output" id="marketing-calendar-output" style="display:none;"></div>
    </div>
  </section>

  <section class="marketing-tab-panel" id="tab-configuracoes">
  <div class="marketing-config-grid">
    <div class="marketing-config-card">
      <h3>🏢 Dados da empresa</h3>

      <form method="post" action="/marketing/settings/save">
        <div class="row">
          <div>
            <label>Nome da empresa</label>
            <input type="text" name="companyName" value="<%= marketingSettings.companyName || '' %>" placeholder="Ex.: Quality Celulares">
          </div>

          <div>
            <label>Segmento</label>
            <input type="text" name="segment" value="<%= marketingSettings.segment || '' %>" placeholder="Ex.: Eletrônicos e assistência técnica">
          </div>
        </div>

        <div class="row" style="margin-top:10px;">
          <div>
            <label>Cidade / região</label>
            <input type="text" name="city" value="<%= marketingSettings.city || '' %>" placeholder="Ex.: Saldanha Marinho - RS">
          </div>

          <div>
            <label>Personalidade opcional</label>

            <select name="personality">
              <option value="automatico" <%= marketingSettings.personality === 'automatico' ? 'selected' : '' %>>Automático</option>
              <option value="autoridade" <%= marketingSettings.personality === 'autoridade' ? 'selected' : '' %>>Autoridade</option>
              <option value="urgencia" <%= marketingSettings.personality === 'urgencia' ? 'selected' : '' %>>Urgência/Oportunidade</option>
              <option value="consultivo" <%= marketingSettings.personality === 'consultivo' ? 'selected' : '' %>>Consultivo/Amigável</option>
              <option value="premium" <%= marketingSettings.personality === 'premium' ? 'selected' : '' %>>Premium</option>
            </select>
          </div>
        </div>

        <div class="row" style="margin-top:10px;">
          <div>
            <label>WhatsApp</label>
            <input type="text" name="whatsapp" value="<%= marketingSettings.whatsapp || '' %>" placeholder="Opcional">
          </div>

          <div>
            <label>Instagram</label>
            <input type="text" name="instagram" value="<%= marketingSettings.instagram || '' %>" placeholder="Opcional">
          </div>
        </div>

        <div style="margin-top:10px;">
          <label>Site</label>
          <input type="text" name="site" value="<%= marketingSettings.site || '' %>" placeholder="Opcional">
        </div>

        <div style="margin-top:10px;">
          <label>Produtos principais</label>

          <textarea name="mainProducts" placeholder="Ex.: iPhone, Samsung, Xiaomi, JBL, PlayStation, notebooks..."><%= marketingSettings.mainProducts || '' %></textarea>
        </div>

        <div style="margin-top:10px;">
          <label>Serviços principais</label>

          <textarea name="mainServices" placeholder="Ex.: troca de tela, bateria, formatação, assistência notebook..."><%= marketingSettings.mainServices || '' %></textarea>
        </div>

        <button class="btn primary" type="submit" style="margin-top:12px;">
          💾 Salvar configurações
        </button>
      </form>

    </div>

      <div class="marketing-config-card">
        <h3>⚡ Ações IA personalizadas</h3>
        <p style="color:#6b7280;font-size:13px;margin-top:0;">Esses botões aparecem em todos os cards gerados. Você pode criar ações como 😂 Mais divertido, 💰 Mais premium ou ⚡ Mais agressivo.</p>

        <form method="post" action="/marketing/action-buttons/save">
          <div class="marketing-quick-editor-list">
            <% (actionButtons || []).forEach(action => { %>
              <div class="marketing-action-editor-item">
                <input type="hidden" name="id" value="<%= action.id %>">
                <div>
                  <label>Nome do botão</label>
                  <input type="text" name="label" value="<%= action.label %>" placeholder="Ex.: 😂 Mais divertido">
                </div>
                <div>
                  <label>Instrução da IA</label>
                  <input type="text" name="instruction" value="<%= action.instruction %>" placeholder="Ex.: Deixe mais descontraído.">
                </div>
                <label class="marketing-remove-check">
                  <input type="checkbox" name="removeId" value="<%= action.id %>"> Excluir
                </label>
              </div>
            <% }) %>
          </div>

          <div class="marketing-action-editor-item new">
            <div>
              <label>Novo botão</label>
              <input type="text" name="newLabel" placeholder="Ex.: 😂 Mais divertido">
            </div>
            <div>
              <label>Nova instrução</label>
              <input type="text" name="newInstruction" placeholder="Ex.: Deixe o texto mais animado, leve e divertido.">
            </div>
          </div>

          <button class="btn primary" type="submit">💾 Salvar ações IA</button>
        </form>
      </div>
    </div>
  </section>
</div>

<style>
.marketing-template-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin:12px 0 8px;
}

.marketing-template-header strong{
  display:block;
  color:#111827;
  font-size:14px;
}

.marketing-template-header span{
  display:block;
  color:#6b7280;
  font-size:12px;
  margin-top:2px;
}

.marketing-quick-buttons.advanced{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  padding:10px;
  border:1px solid #e5e7eb;
  border-radius:14px;
  background:#f9fafb;
}

.marketing-quick-buttons.advanced button{
  border:1px solid #d1d5db;
  background:#fff;
  border-radius:999px;
  padding:8px 11px;
  font-weight:800;
  cursor:pointer;
  transition:.15s ease;
}

.marketing-quick-buttons.advanced button:hover{
  transform:translateY(-1px);
  border-color:#c90000;
  box-shadow:0 5px 14px rgba(17,24,39,.10);
}

.marketing-quick-editor{
  margin-top:12px;
  border:1px solid #e5e7eb;
  border-radius:12px;
  padding:10px 12px;
  background:#fafafa;
}

.marketing-quick-editor summary{
  cursor:pointer;
  font-weight:800;
  color:#374151;
}

.marketing-quick-editor-list{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-top:12px;
}

.marketing-quick-editor-item,
.marketing-action-editor-item{
  display:grid;
  grid-template-columns:220px 1fr 90px;
