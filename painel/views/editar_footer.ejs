<% layout('layout') -%>

<% if (typeof sucessoRodape !== 'undefined' && sucessoRodape) { %>
  <div class="notice" style="background-color: #d4edda; color: #155724; border-color: #c3e6cb; padding: 12px; margin-bottom: 20px; border-radius: 6px; border: 1px solid #c3e6cb; font-weight: 500;">
    ✅ <%= sucessoRodape %>
  </div>
<% } %>

<div class="card">
  <h3>🔻 Rodapé — Texto, CNPJ e Links</h3>
  <form method="post" action="/footer/save" class="row" style="grid-template-columns: 1fr 1fr; gap: 15px;">
    <div>
      <label>Texto do Rodapé</label>
      <input type="text" name="text" value="<%= (footer && footer.text) || '' %>" placeholder="Ex: © 2014 - 2026 Quality Celulares.">
    </div>
    <div>
      <label>CNPJ</label>
      <input type="text" name="cnpj" value="<%= (footer && footer.cnpj) || '' %>" placeholder="Ex: 20.375.910/0001-66">
    </div>
    <div>
      <label>Link: Sobre nós</label>
      <input type="text" name="urlSobre" value="<%= (footer && footer.urlSobre) || 'sobre.html' %>" placeholder="sobre.html">
    </div>
    <div>
      <label>Link: Formas de pagamento</label>
      <input type="text" name="urlPagamento" value="<%= (footer && footer.urlPagamento) || 'formas-de-pagamento.html' %>" placeholder="formas-de-pagamento.html">
    </div>
    <div style="grid-column: 1 / -1; align-self: end; text-align: right;">
      <button class="btn primary" type="submit">Salvar Alterações</button>
    </div>
  </form>
</div>

<div class="card">
  <h3>Ícones Sociais</h3>
  <form method="post" action="/footer/add-social" class="row">
    <div><label>Nome do Ícone</label><input type="text" name="label" placeholder="Ex: Instagram Oficial"></div>
    <div><label>Link/URL</label><input type="url" name="url" placeholder="https://instagram.com/..."></div>
    <div><label>Ordem</label><input type="number" name="order" placeholder="1"></div>
    <div style="align-self:end"><button class="btn" type="submit">Adicionar</button></div>
  </form>
  <table class="table">
    <thead><tr><th>#</th><th>Título</th><th>URL</th><th>Ordem</th><th>Ações</th></tr></thead>
    <tbody>
      <% (footer.social||[]).forEach((s,idx)=>{ %>
        <tr>
          <td><span class="badge"><%= idx+1 %></span></td>
          <td>
            <form method="post" action="/footer/update-social">
              <input type="hidden" name="index" value="<%= idx %>">
              <input type="text" name="label" value="<%= s.label || s.icon %>">
          </td>
          <td><input type="url" name="url" value="<%= s.url %>"></td>
          <td><input type="number" name="order" value="<%= s.order || (idx+1) %>"></td>
          <td>
              <button class="btn primary" type="submit">Salvar</button>
            </form>
            <form method="post" action="/footer/del-social" style="display:inline">
              <input type="hidden" name="index" value="<%= idx %>">
              <button class="btn" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>