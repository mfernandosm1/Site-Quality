    const categoryName = bulkCategorySelect?.selectedOptions?.[0]?.textContent || 'sem categoria';
    const subcategoryName = bulkSubcategorySelect?.selectedOptions?.[0]?.textContent || 'sem subcategoria';

    const stockControlledEnabled = enabled.some(input => input.value === 'stockControlled');
    const minimumQuantityEnabled = enabled.some(input => input.value === 'minimumQuantity');

    if (minimumQuantityEnabled) {
      const minimumValue = Number(bulkMinimumQuantity?.value);
      if (!Number.isFinite(minimumValue) || minimumValue < 0 || !Number.isInteger(minimumValue)) {
        event.preventDefault();
        alert('Informe um estoque mínimo válido, usando um número inteiro igual ou maior que zero.');
        bulkMinimumQuantity?.focus();
        return;
      }
    }

    let detail = labels.join(', ');
    if (categoryEnabled) detail += `\nCategoria: ${categoryName}`;
    if (subcategoryEnabled) detail += `\nSubcategoria: ${subcategoryName}`;
    if (stockControlledEnabled) detail += `\nControle de estoque: ${bulkStockControlled?.value === 'true' ? 'ATIVAR' : 'DESATIVAR'}`;
    if (minimumQuantityEnabled) detail += `\nEstoque mínimo: ${bulkMinimumQuantity?.value || 0}`;
    detail += '\n\nUm backup automático do products.json será criado antes da alteração.';

    if (!confirm(`Aplicar as alterações em ${checkedProducts.length} produto(s)?\n\n${detail}`)) {
      event.preventDefault();
    }
  });



