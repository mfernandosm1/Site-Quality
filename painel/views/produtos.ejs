  let activeEditRow = null;

  function qltCodeFromRow(row){
    const raw = String(row?.dataset?.id || "0").replace(/\D/g, "");
    const suffix = raw.slice(-6).padStart(6, "0");
    return "QLT-" + suffix;
  }

  function getRowField(row, selector){
    return row?.querySelector(selector)?.value || "";
  }

  function setRowField(row, selector, value){
    const el = row?.querySelector(selector);
    if (!el) return;
    el.value = value ?? "";
    el.dispatchEvent(new Event("change", { bubbles:true }));
  }

  function productImageUrl(path){
    if (!path) return "/images/sem-imagem.png";
    if (/^https?:\/\//i.test(path)) return path;
    return "/" + String(path).replace(/^\//, "");
  }

  function parseComboLines(text){
    return (text || "").split(/\r?\n/).map(line => line.trim()).filter(Boolean).map(line => {
      const parts = line.split("|").map(v => v.trim());
      return { color: parts[0] || "", storage: parts[1] || "", ram: parts[2] || "", condition: parts[3] || "", image: parts[4] || "", stock: parts[5] || "" };
    });
  }

  function comboToLine(c){
    return [c.color, c.storage, c.ram, c.condition, c.image, c.stock].filter((x, i) => i < 4 || (x !== undefined && x !== null && x !== "")).join("|");
  }

  function comboLabel(c){
    return [c.color, c.storage, c.ram, c.condition].filter(Boolean).join(" + ") || "Combinação";
  }

  function renderEditVariationStock(row){
    if (!editVariationStockList) return;
    const combosEl = row?.querySelector(".row-variation-combinations");
    const combos = parseComboLines(combosEl?.value || "");
    editVariationStockList.innerHTML = "";
    if (!combos.length) {
      editVariationStockList.innerHTML = '<div class="quality-empty-note">Este produto ainda não tem combinações de variação com estoque. Use o botão 🎛️ Variações para criar a grade.</div>';
      return;
    }
    combos.forEach((combo, index) => {
      const item = document.createElement("div");
      item.className = "quality-stock-variation-row";
      item.innerHTML = `<span>${comboLabel(combo)}</span><input type="number" min="0" step="1" value="${String(combo.stock || "").replace(/&/g,"&amp;").replace(/"/g,"&quot;")}" data-combo-stock-index="${index}" placeholder="Qtd.">`;
      editVariationStockList.appendChild(item);
    });
  }

  function openEditProductModal(row){
    activeEditRow = row;
    if (!row) return;
    const name = getRowField(row, ".prod-name-input");
    const image = getRowField(row, ".prod-image-select");
    if (editProductTitle) editProductTitle.textContent = name || "Editar produto";
    if (editProductCode) editProductCode.textContent = qltCodeFromRow(row);
    if (editProductThumb) editProductThumb.src = productImageUrl(image);

    document.getElementById("edit-name").value = name;
    document.getElementById("edit-slug").value = getRowField(row, ".prod-slug-input");
    document.getElementById("edit-category").value = getRowField(row, ".prod-category-select");
    document.getElementById("edit-image").value = image;
    document.getElementById("edit-price").value = getRowField(row, 'input[name="price"]');
    document.getElementById("edit-showPrice").value = getRowField(row, 'select[name="showPrice"]') || "false";
    document.getElementById("edit-active").value = getRowField(row, 'select[name="active"]') || "true";
    document.getElementById("edit-featured").value = getRowField(row, 'select[name="featured"]') || "false";
    document.getElementById("edit-detailsEnabled").value = getRowField(row, 'select[name="detailsEnabled"]') || "false";
    document.getElementById("edit-showVariationsOnCard").value = getRowField(row, '.row-show-variations-card') || "false";
    document.getElementById("edit-stock").value = getRowField(row, 'input[name="stock"]');
    document.getElementById("edit-stock-min").value = "";
    document.getElementById("edit-seo-title").value = name;
    document.getElementById("edit-seo-slug").value = getRowField(row, ".prod-slug-input");
    document.getElementById("edit-seo-description").value = getRowField(row, ".row-description-short");
    renderEditVariationStock(row);

    document.querySelectorAll(".quality-edit-tab").forEach((btn, idx) => btn.classList.toggle("active", idx === 0));
    document.querySelectorAll(".quality-edit-panel").forEach((panel, idx) => panel.classList.toggle("active", idx === 0));
    editProductModal?.classList.add("open");
    editProductModal?.setAttribute("aria-hidden", "false");
  }

  function closeEditProductModal(){
    editProductModal?.classList.remove("open");
    editProductModal?.setAttribute("aria-hidden", "true");
    activeEditRow = null;
  }

  function updateStockBadge(row){
    const stockValue = getRowField(row, 'input[name="stock"]');
    const stockNum = Number(stockValue || 0);
    const badge = row?.querySelector(".quality-stock-badge");
    if (!badge) return;
    badge.classList.remove("zero", "empty");
    if (stockValue === "") {
      badge.classList.add("empty");
      badge.textContent = "📦 Não informado";
    } else if (stockNum > 0) {
      badge.textContent = "📦 Em estoque";
    } else {
      badge.classList.add("zero");
      badge.textContent = "📦 Sem estoque";
    }
  }

  function applyEditModalToRow(row){
    if (!row) return;
    setRowField(row, ".prod-name-input", document.getElementById("edit-name").value.trim());
    setRowField(row, ".prod-slug-input", gerarSlugPainel(document.getElementById("edit-slug").value.trim()));
    setRowField(row, ".prod-category-select", document.getElementById("edit-category").value);
    setRowField(row, ".prod-image-select", document.getElementById("edit-image").value.trim());
    setRowField(row, 'input[name="price"]', document.getElementById("edit-price").value);
    setRowField(row, 'select[name="showPrice"]', document.getElementById("edit-showPrice").value);
    setRowField(row, 'select[name="active"]', document.getElementById("edit-active").value);
    setRowField(row, 'select[name="featured"]', document.getElementById("edit-featured").value);
    setRowField(row, 'select[name="detailsEnabled"]', document.getElementById("edit-detailsEnabled").value);
    setRowField(row, '.row-show-variations-card', document.getElementById("edit-showVariationsOnCard").value);
    setRowField(row, 'input[name="stock"]', document.getElementById("edit-stock").value);

    const seoSlug = document.getElementById("edit-seo-slug").value.trim();
    if (seoSlug) setRowField(row, ".prod-slug-input", gerarSlugPainel(seoSlug));

    const combosEl = row.querySelector(".row-variation-combinations");
    if (combosEl && editVariationStockList) {
      const combos = parseComboLines(combosEl.value);
      editVariationStockList.querySelectorAll("[data-combo-stock-index]").forEach(input => {
        const idx = Number(input.dataset.comboStockIndex);
        if (combos[idx]) combos[idx].stock = input.value;
      });
      const validStocks = combos.map(c => c.stock).filter(v => v !== "" && !Number.isNaN(Number(v)));
      if (validStocks.length) setRowField(row, 'input[name="stock"]', validStocks.reduce((sum, v) => sum + Math.max(0, Number(v)), 0));
      combosEl.value = combos.map(comboToLine).join("\n");
      combosEl.dispatchEvent(new Event("change", { bubbles:true }));
    }

    const img = row.querySelector(".quality-product-thumb img");
    const newImage = getRowField(row, ".prod-image-select");
    if (img) img.src = productImageUrl(newImage);
    if (editProductThumb) editProductThumb.src = productImageUrl(newImage);
    if (editProductTitle) editProductTitle.textContent = getRowField(row, ".prod-name-input") || "Editar produto";
    updateStockBadge(row);
    updateVariationSummary(row);
    markRowDirty(row);
  }

  document.querySelectorAll(".quality-edit-tab").forEach(btn => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.editTab;
      document.querySelectorAll(".quality-edit-tab").forEach(b => b.classList.toggle("active", b === btn));
      document.querySelectorAll(".quality-edit-panel").forEach(panel => panel.classList.toggle("active", panel.dataset.editPanel === key));
    });
  });

  document.querySelectorAll(".quality-edit-btn").forEach(btn => {
    btn.addEventListener("click", () => openEditProductModal(btn.closest("tr")));
  });

  editProductClose?.addEventListener("click", closeEditProductModal);
  editProductCancel?.addEventListener("click", closeEditProductModal);
  editProductModal?.addEventListener("click", e => { if (e.target === editProductModal) closeEditProductModal(); });
  editProductSave?.addEventListener("click", async () => {
    if (!activeEditRow) return;
    applyEditModalToRow(activeEditRow);
    await saveProductRow(activeEditRow);
    closeEditProductModal();
  });

  updateAddGallerySummary();
  updateSelectionCount();

  if (flashMessage && flashMessage.textContent.trim()) {
    setTimeout(() => {
      flashMessage.style.display = "none";
    }, 3500);
  }
});

function sincronizarImagensAuto() {
  fetch(window.location.href)
    .then(res => res.text())
    .then(htmlStr => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlStr, 'text/html');

      const tabelaSelects = doc.querySelector(".prod-image-select");
      if (!tabelaSelects) return;

      const opcoesImagem = Array.from(tabelaSelects.options)
        .map(opt => opt.value.replace("images/", "").trim())
        .filter(val => val !== "");

      const dataList = document.getElementById("imagens-list");
      if (dataList) {
        dataList.innerHTML = "";
        opcoesImagem.forEach(img => {
          const opt = document.createElement("option");
          opt.value = "images/" + img;
          opt.textContent = img;
          dataList.appendChild(opt);
        });
      }

      const linhaSelects = document.querySelectorAll(".prod-image-select");
      linhaSelects.forEach(select => {
        const valorAtual = select.value || select.getAttribute("data-current-val") || "";
        select.innerHTML = '<option value="">Selecione...</option>';

        opcoesImagem.forEach(img => {
          const opt = document.createElement("option");
          opt.value = "images/" + img;
          opt.textContent = img;
          if ("images/" + img === valorAtual) opt.selected = true;
          select.appendChild(opt);
        });

        select.setAttribute("data-current-val", valorAtual);
      });
    })
    .catch(err => console.error("Erro na sincronização automática de fotos:", err));
}
</script>
