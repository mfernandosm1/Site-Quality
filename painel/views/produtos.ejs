      showMessage(activeGalleryContext.mode === "row" ? "✅ Vídeo adicionado e produto salvo." : "✅ Vídeo adicionado na galeria.");
    }
  });

  addManageGalleryBtn?.addEventListener("click", () => {
    openGalleryModal(makeGalleryContextFromAddForm());
  });
  addGalleryTextarea?.addEventListener("input", updateAddGallerySummary);

  searchInput?.addEventListener("input", filterTable);
  categoryFilter?.addEventListener("change", filterTable);

  document.querySelectorAll(".product-check").forEach(chk => {
    chk.addEventListener("change", updateSelectionCount);
  });

  rows.forEach(row => {
    ligarSlugAutomatico(
      row.querySelector(".prod-name-input"),
      row.querySelector(".prod-slug-input")
    );

    row.querySelectorAll("input[name], select[name], textarea[name]").forEach(el => {
      if (el.name === "id") return;
      el.addEventListener("change", () => markRowDirty(row));
      el.addEventListener("input", () => markRowDirty(row));
    });

    row.querySelector(".save-product-btn")?.addEventListener("click", () => saveProductRow(row));
    row.querySelector(".manage-gallery-btn")?.addEventListener("click", () => openGalleryModal(makeGalleryContextFromRow(row)));
    row.querySelector(".manage-variations-btn")?.addEventListener("click", () => openVariationModal(row));

    const galleryTextarea = row.querySelector(".gallery-textarea");
    galleryTextarea?.addEventListener("input", () => updateGallerySummary(row));
    updateGallerySummary(row);
    updateVariationSummary(row);
  });

  selectAllCheckbox?.addEventListener("change", () => {
    visibleRows().forEach(row => {
      const chk = row.querySelector(".product-check");
      if (chk) chk.checked = selectAllCheckbox.checked;
    });
    updateSelectionCount();
  });

  selectAllBtn?.addEventListener("click", () => {
    visibleRows().forEach(row => {
      const chk = row.querySelector(".product-check");
      if (chk) chk.checked = true;
    });
    updateSelectionCount();
  });

  clearBtn?.addEventListener("click", () => {
    document.querySelectorAll(".product-check").forEach(chk => chk.checked = false);
    updateSelectionCount();
  });

  const enableDetailsBtn = document.getElementById("enable-details-selected");
  const disableDetailsBtn = document.getElementById("disable-details-selected");
  const detailsActionInput = document.getElementById("details-action-input");
  const bulkDetailsForm = document.getElementById("bulk-details-form");

  function submitDetailsAction(action) {
    const checked = document.querySelectorAll(".product-check:checked");
    if (!checked.length) {
      alert("Selecione pelo menos um produto.");
      return;
    }
    detailsActionInput.value = action;
    bulkDetailsForm.submit();
  }

  enableDetailsBtn?.addEventListener("click", () => submitDetailsAction("enable"));
  disableDetailsBtn?.addEventListener("click", () => submitDetailsAction("disable"));



  // ----------------------------
  // Variações V3 - cadastro visual
  // ----------------------------
  const variationModal = document.getElementById("variation-modal-backdrop");
  const variationModalClose = document.getElementById("variation-modal-close");
  const variationModalSave = document.getElementById("variation-modal-save");
  const variationModalProduct = document.getElementById("variation-modal-product");
  const modalVariationsBox = document.getElementById("modal-variations-box");
  let activeVariationRow = null;

  function parseLines(value) {
    return (value || "").split(/\r?\n/).map(v => v.trim()).filter(Boolean);
  }

  function uniquePush(list, value) {
    if (value && !list.includes(value)) list.push(value);
    return list;
  }

  function getVarTextarea(box, type) {
    return box?.querySelector(`[data-var-type="${type}"]`);
  }

  function parseVariationLabels(value) {
    try {
      const obj = JSON.parse(value || '{}');
      return obj && typeof obj === 'object' ? obj : {};
    } catch (e) {
      return {};
    }
  }

  function labelsFromInputs(box) {
    const labels = {};
    box?.querySelectorAll('.variation-label-input').forEach(input => {
      const type = input.dataset.labelType;
      const value = (input.value || '').trim();
      if (type && value) labels[type] = value;
    });
    return labels;
  }

  function syncLabelInputs(box) {
    if (!box) return;
    const labels = parseVariationLabels(getVarTextarea(box, 'labels')?.value || '{}');
    box.querySelectorAll('.variation-label-input').forEach(input => {
      input.value = labels[input.dataset.labelType] || '';
    });
  }

  function syncLabelsTextarea(box) {
    const textarea = getVarTextarea(box, 'labels');
    if (!textarea) return;
    textarea.value = JSON.stringify(labelsFromInputs(box));
  }

  function updateVariationVisibility(box) {
    if (!box) return;
    const enabled = box.querySelector(".variation-enabled-select")?.value === "true";
    box.classList.toggle("variations-disabled", !enabled);
  }

  function renderVariationBox(box) {
    if (!box) return;
    updateVariationVisibility(box);
    syncLabelsTextarea(box);
    ["colors", "storage", "ram", "condition"].forEach(type => {
      const textarea = getVarTextarea(box, type);
      const listBox = box.querySelector(`[data-var-list="${type}"]`);
      if (!textarea || !listBox) return;
      const lines = parseLines(textarea.value);
      listBox.innerHTML = "";
      lines.forEach((line, index) => {
        const parts = line.split("|").map(v => v.trim());
        const pill = document.createElement("span");
        pill.className = "quality-var-pill";
        if (type === "colors") {
          const dot = document.createElement("span");
          dot.className = "quality-var-dot";
          dot.style.background = parts[1] || "#e5e7eb";
          pill.appendChild(dot);
          pill.appendChild(document.createTextNode(parts[0] || line));
        } else {
          pill.textContent = line;
        }
        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          const updated = parseLines(textarea.value).filter((_, i) => i !== index);
          textarea.value = updated.join("\n");
          textarea.dispatchEvent(new Event("input", { bubbles:true }));
          renderVariationBox(box);
        });
        pill.appendChild(remove);
        listBox.appendChild(pill);
      });
    });

    renderComboTools(box);
  }


  function comboLineLabel(line) {
    const p = (line || '').split('|').map(v => v.trim());
    return [p[0], p[1], p[2], p[3]].filter(Boolean).join(' + ') + (p[4] ? ' 🖼️' : '');
  }

  function colorNameFromLine(line) { return (line || '').split('|')[0].trim(); }

  function setSelectOptions(select, values, placeholder) {
    if (!select) return;
    const old = select.value;
    select.innerHTML = '';
    const opt0 = document.createElement('option');
    opt0.value = '';
    opt0.textContent = placeholder;
    select.appendChild(opt0);
    values.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      select.appendChild(opt);
    });
    if (values.includes(old)) select.value = old;
  }

  function renderComboTools(box) {
    if (!box) return;
    const colors = parseLines(getVarTextarea(box, 'colors')?.value).map(colorNameFromLine).filter(Boolean);
    const storage = parseLines(getVarTextarea(box, 'storage')?.value);
    const ram = parseLines(getVarTextarea(box, 'ram')?.value);
    const condition = parseLines(getVarTextarea(box, 'condition')?.value);
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="color"]'), colors, 'Cor');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="storage"]'), storage, 'GB');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="ram"]'), ram, 'RAM');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="condition"]'), condition, 'Estado');

    const comboTextarea = getVarTextarea(box, 'combinations');
    const comboList = box.querySelector('[data-var-list="combinations"]');
    if (!comboTextarea || !comboList) return;
    comboList.innerHTML = '';
    parseLines(comboTextarea.value).forEach((line, index) => {
      const pill = document.createElement('span');
      pill.className = 'quality-combo-pill';
      pill.appendChild(document.createTextNode(comboLineLabel(line)));
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        const updated = parseLines(comboTextarea.value).filter((_, i) => i !== index);
        comboTextarea.value = updated.join('\n');
        comboTextarea.dispatchEvent(new Event('input', { bubbles:true }));
        renderVariationBox(box);
      });
      pill.appendChild(remove);
      comboList.appendChild(pill);
    });
  }

  function initVariationBox(box) {
    if (!box || box.dataset.variationReady === "1") return;
    box.dataset.variationReady = "1";

    box.querySelectorAll(".add-var-color").forEach(btn => {
      btn.addEventListener("click", () => {
        const nameInput = box.querySelector(".var-color-name");
        const hexInput = box.querySelector(".var-color-hex");
        const imageInput = box.querySelector(".var-color-image");
        const name = (nameInput?.value || "").trim();
        if (!name) return alert("Digite o nome da cor.");
        const line = [name, (hexInput?.value || "").trim(), (imageInput?.value || "").trim()].filter(Boolean).join("|");
        const textarea = getVarTextarea(box, "colors");
        const list = parseLines(textarea.value);
        uniquePush(list, line);
        textarea.value = list.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        if (nameInput) nameInput.value = "";
        if (imageInput) imageInput.value = "";
        renderVariationBox(box);
      });
    });

    box.querySelectorAll(".add-var-simple").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.type;
        const select = box.querySelector(`.var-simple-select[data-type="${type}"]`);
        const custom = box.querySelector(`.var-simple-custom[data-type="${type}"]`);
        const customValue = (custom?.value || "").trim();
        const value = customValue || (select?.value || "").trim();
        if (!value) return alert("Informe a variação que deseja adicionar.");
        const textarea = getVarTextarea(box, type);
        const list = parseLines(textarea.value);
        uniquePush(list, value);
        textarea.value = list.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        if (custom) custom.value = "";
        renderVariationBox(box);
      });
    });

    box.querySelectorAll(".add-var-combo").forEach(btn => {
      btn.addEventListener("click", () => {
        const color = box.querySelector('.var-combo-select[data-combo="color"]')?.value || '';
        const storage = box.querySelector('.var-combo-select[data-combo="storage"]')?.value || '';
        const ram = box.querySelector('.var-combo-select[data-combo="ram"]')?.value || '';
        const condition = box.querySelector('.var-combo-select[data-combo="condition"]')?.value || '';
        const image = (box.querySelector('.var-combo-image')?.value || '').trim();
        if (!color && !storage && !ram && !condition) return alert('Escolha pelo menos uma opção para a combinação.');
        const line = [color, storage, ram, condition, image].join('|').replace(/\|+$/,'');
        const textarea = getVarTextarea(box, 'combinations');
        const list = parseLines(textarea.value);
        uniquePush(list, line);
        textarea.value = list.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        const imageInput = box.querySelector('.var-combo-image');
        if (imageInput) imageInput.value = '';
        renderVariationBox(box);
      });
    });

    box.querySelectorAll(".var-preset").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.type;
        const textarea = getVarTextarea(box, type);
        const current = parseLines(textarea.value);
        parseLines((btn.dataset.values || "").replace(/\\n/g, "\n")).forEach(v => uniquePush(current, v));
        textarea.value = current.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        renderVariationBox(box);
      });
    });

    box.querySelectorAll("textarea, select, input").forEach(el => {
      el.addEventListener("input", () => renderVariationBox(box));
      el.addEventListener("change", () => renderVariationBox(box));
    });

    syncLabelInputs(box);
    renderVariationBox(box);
  }

  function copyRowVariationsToModal(row) {
    if (!row || !modalVariationsBox) return;
    modalVariationsBox.querySelector(".variation-enabled-select").value = row.querySelector(".row-variations-enabled")?.value || "false";
    getVarTextarea(modalVariationsBox, "colors").value = row.querySelector(".row-variation-colors")?.value || "";
    getVarTextarea(modalVariationsBox, "storage").value = row.querySelector(".row-variation-storage")?.value || "";
    getVarTextarea(modalVariationsBox, "ram").value = row.querySelector(".row-variation-ram")?.value || "";
    getVarTextarea(modalVariationsBox, "condition").value = row.querySelector(".row-variation-condition")?.value || "";
    getVarTextarea(modalVariationsBox, "labels").value = row.querySelector(".row-variation-labels")?.value || "";
    getVarTextarea(modalVariationsBox, "combinations").value = row.querySelector(".row-variation-combinations")?.value || "";
    syncLabelInputs(modalVariationsBox);
    renderVariationBox(modalVariationsBox);
  }

  function copyModalVariationsToRow(row) {
    if (!row || !modalVariationsBox) return;
    row.querySelector(".row-variations-enabled").value = modalVariationsBox.querySelector(".variation-enabled-select")?.value || "false";
    row.querySelector(".row-variation-colors").value = getVarTextarea(modalVariationsBox, "colors")?.value || "";
    row.querySelector(".row-variation-storage").value = getVarTextarea(modalVariationsBox, "storage")?.value || "";
    row.querySelector(".row-variation-ram").value = getVarTextarea(modalVariationsBox, "ram")?.value || "";
    row.querySelector(".row-variation-condition").value = getVarTextarea(modalVariationsBox, "condition")?.value || "";
    row.querySelector(".row-variation-labels").value = getVarTextarea(modalVariationsBox, "labels")?.value || "";
    row.querySelector(".row-variation-combinations").value = getVarTextarea(modalVariationsBox, "combinations")?.value || "";
    markRowDirty(row);
    updateVariationSummary(row);
  }

  function updateVariationSummary(row) {
    const summary = row.querySelector(".variation-summary");
    if (!summary) return;
    const enabled = row.querySelector(".row-variations-enabled")?.value === "true";
    if (!enabled) { summary.textContent = "Sem variações"; return; }
    const c = parseLines(row.querySelector(".row-variation-colors")?.value).length;
    const s = parseLines(row.querySelector(".row-variation-storage")?.value).length;
    const r = parseLines(row.querySelector(".row-variation-ram")?.value).length;
    const e = parseLines(row.querySelector(".row-variation-condition")?.value).length;
    const g = parseLines(row.querySelector(".row-variation-combinations")?.value).length;
    const labels = parseVariationLabels(row.querySelector(".row-variation-labels")?.value || "{}");
    const storageName = labels.storage || "GB";
    const ramName = labels.ram || "RAM";
    const conditionName = labels.condition || "estado(s)";
    summary.textContent = `Variações: ${c} cor(es), ${s} ${storageName}, ${r} ${ramName}, ${e} ${conditionName}, ${g} combinação(ões)`;
  }

  function openVariationModal(row) {
    activeVariationRow = row;
    if (variationModalProduct) variationModalProduct.textContent = row.querySelector(".prod-name-input")?.value || "Produto";
    initVariationBox(modalVariationsBox);
    copyRowVariationsToModal(row);
    variationModal?.classList.add("open");
    variationModal?.setAttribute("aria-hidden", "false");
  }

  function closeVariationModal() {
    variationModal?.classList.remove("open");
    variationModal?.setAttribute("aria-hidden", "true");
    activeVariationRow = null;
  }

  initVariationBox(document.getElementById("add-variations-box"));
  variationModalClose?.addEventListener("click", closeVariationModal);
  variationModal?.addEventListener("click", e => { if (e.target === variationModal) closeVariationModal(); });
  variationModalSave?.addEventListener("click", async () => {
    if (!activeVariationRow) return;
    copyModalVariationsToRow(activeVariationRow);
    await saveProductRow(activeVariationRow);
    closeVariationModal();
  });
  updateAddGallerySummary();
  updateSelectionCount();

  if (flashMessage && flashMessage.textContent.trim()) {
    setTimeout(() => {
      flashMessage.style.display = "none";
    }, 3500);
  }
});

function sincronizarImagensAuto() {
  fetch(window.location.href)
    .then(res => res.text())
    .then(htmlStr => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlStr, 'text/html');

      const tabelaSelects = doc.querySelector(".prod-image-select");
      if (!tabelaSelects) return;

      const opcoesImagem = Array.from(tabelaSelects.options)
        .map(opt => opt.value.replace("images/", "").trim())
        .filter(val => val !== "");

      const dataList = document.getElementById("imagens-list");
      if (dataList) {
        dataList.innerHTML = "";
        opcoesImagem.forEach(img => {
          const opt = document.createElement("option");
          opt.value = "images/" + img;
          opt.textContent = img;
          dataList.appendChild(opt);
        });
      }

      const linhaSelects = document.querySelectorAll(".prod-image-select");
      linhaSelects.forEach(select => {
        const valorAtual = select.value || select.getAttribute("data-current-val") || "";
        select.innerHTML = '<option value="">Selecione...</option>';

        opcoesImagem.forEach(img => {
          const opt = document.createElement("option");
          opt.value = "images/" + img;
          opt.textContent = img;
          if ("images/" + img === valorAtual) opt.selected = true;
          select.appendChild(opt);
        });

        select.setAttribute("data-current-val", valorAtual);
      });
    })
    .catch(err => console.error("Erro na sincronização automática de fotos:", err));
}
</script>
