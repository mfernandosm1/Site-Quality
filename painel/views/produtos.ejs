  const imageSuggest = document.getElementById("quality-image-suggest");
  function renderImageSuggestions(input){
    if (!imageSuggest || !input) return;
    const term = (input.value || "").toLowerCase().replace(/^images\//, "");
    const options = getImageOptions();
    const matches = options.filter(v => v.toLowerCase().includes(term)).slice(0, 30);
    if (!matches.length) { imageSuggest.style.display = "none"; return; }
    const rect = input.getBoundingClientRect();
    imageSuggest.style.left = rect.left + "px";
    imageSuggest.style.top = (rect.bottom + 4) + "px";
    imageSuggest.style.width = Math.max(rect.width, 260) + "px";
    imageSuggest.innerHTML = matches.map(v => `<button type="button" data-img-value="${v.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;')}">${v.replace(/^images\//,'')}</button>`).join("");
    imageSuggest.style.display = "block";
    imageSuggest.querySelectorAll("button").forEach(btn => {
      btn.addEventListener("mousedown", e => {
