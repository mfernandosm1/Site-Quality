<% layout('layout') -%>
<div class="card">
  <h3>📦 Produtos</h3>


  <style>
  /* Layout moderno e compacto da página Produtos */
  .quality-panel-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:14px;
  }

  .quality-compact-gallery textarea{
    min-height:52px !important;
    max-height:70px !important;
  }

  .quality-controls-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:12px;
    margin:22px 0 14px 0;
  }

  .quality-control-box{
    background:#fafafa;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:12px;
  }

  .quality-control-title{
    display:flex;
    align-items:center;
    gap:6px;
    font-weight:800;
    margin-bottom:10px;
  }

  .quality-search-row,
  .quality-bulk-row{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
  }

  .quality-search-row input{ flex:1 1 320px; }
  .quality-search-row select{ flex:0 0 220px; }

  .quality-bulk-box{
    display:flex !important;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    background:transparent !important;
    border:none !important;
    padding:0 !important;
    margin:0 !important;
  }

  .quality-bulk-box form{
    display:flex !important;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    margin:0 !important;
  }

  .quality-bulk-box select{
    width:auto !important;
    min-width:220px !important;
    max-width:100% !important;
  }

  .quality-bulk-box .btn,
  .quality-control-box .btn{
    padding:8px 10px !important;
    font-size:12px !important;
    border-radius:9px !important;
  }

  .quality-table-toolbar{
    display:flex;
    justify-content:flex-end;
    margin:12px 0;
  }

  .quality-table-wrap{
    width:100%;
    overflow-x:auto;
    padding-bottom:10px;
  }

  .quality-table-wrap .table{
    width:100% !important;
    min-width:0 !important;
    table-layout:fixed !important;
    border-collapse:collapse;
  }

  .quality-table-wrap .table th,
  .quality-table-wrap .table td{
    min-width:0 !important;
    max-width:none !important;
    padding:7px !important;
    font-size:11px !important;
    vertical-align:top;
  }

  .quality-table-wrap .table th:nth-child(1),
  .quality-table-wrap .table td:nth-child(1){ width:2.2%; }
  .quality-table-wrap .table th:nth-child(2),
  .quality-table-wrap .table td:nth-child(2){ width:2.8%; }
  .quality-table-wrap .table th:nth-child(3),
  .quality-table-wrap .table td:nth-child(3){ width:15%; }
  .quality-table-wrap .table th:nth-child(4),
  .quality-table-wrap .table td:nth-child(4){ width:12%; }
  .quality-table-wrap .table th:nth-child(5),
  .quality-table-wrap .table td:nth-child(5){ width:5%; }
  .quality-table-wrap .table th:nth-child(6),
  .quality-table-wrap .table td:nth-child(6){ width:6%; }
  .quality-table-wrap .table th:nth-child(7),
  .quality-table-wrap .table td:nth-child(7){ width:5%; }
  .quality-table-wrap .table th:nth-child(8),
  .quality-table-wrap .table td:nth-child(8){ width:5%; }
  .quality-table-wrap .table th:nth-child(9),
  .quality-table-wrap .table td:nth-child(9){ width:5%; }
  .quality-table-wrap .table th:nth-child(10),
  .quality-table-wrap .table td:nth-child(10){ width:6%; }
  .quality-table-wrap .table th:nth-child(11),
  .quality-table-wrap .table td:nth-child(11){ width:15%; }
  .quality-table-wrap .table th:nth-child(12),
  .quality-table-wrap .table td:nth-child(12){ width:7%; }
  .quality-table-wrap .table th:nth-child(13),
  .quality-table-wrap .table td:nth-child(13){ width:8%; }
  .quality-table-wrap .table th:nth-child(14),
  .quality-table-wrap .table td:nth-child(14){ width:8%; }

  .quality-table-wrap input,
  .quality-table-wrap select,
  .quality-table-wrap textarea{
    width:100% !important;
    min-width:0 !important;
    max-width:100% !important;
    font-size:11px !important;
    padding:7px 8px !important;
  }

  .quality-table-wrap textarea{
    min-height:44px !important;
    max-height:62px !important;
  }

  .quality-table-wrap th:last-child,
  .quality-table-wrap td:last-child{
    position:static !important;
    right:auto !important;
    box-shadow:none !important;
    z-index:auto !important;
  }

  .quality-gallery-cell,
  .quality-actions{
    min-width:0 !important;
    max-width:none !important;
  }

  .gallery-hidden-textarea{
    display:none !important;
  }

  .gallery-summary{
    display:flex;
    flex-direction:column;
    gap:5px;
  }

  .gallery-count-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:100%;
    border:1px solid #e5e7eb;
    background:#f9fafb;
    color:#374151;
    border-radius:999px;
    padding:5px 7px;
    font-weight:800;
    font-size:11px;
  }

  .manage-gallery-btn,
  .quality-actions .btn{
    display:block;
    width:100% !important;
    padding:7px 8px !important;
    font-size:10.5px !important;
    border-radius:8px !important;
    margin-bottom:5px;
  }

  .row-save-status{
    display:block !important;
    margin:2px 0 5px 0 !important;
    font-size:11px !important;
  }

  .quality-modal-backdrop{
    position:fixed;
    inset:0;
    background:rgba(17,24,39,.55);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:999;
    padding:18px;
  }

  .quality-modal-backdrop.open{
    display:flex;
  }

  .quality-gallery-modal{
    width:min(680px, 96vw);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    border:1px solid #e5e7eb;
    box-shadow:0 22px 80px rgba(0,0,0,.25);
  }

  .quality-gallery-modal-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:14px 16px;
    border-bottom:1px solid #e5e7eb;
  }

  .quality-gallery-modal-header strong{
    font-size:15px;
  }

  .quality-gallery-modal-body{
    padding:16px;
  }

  .modal-gallery-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-bottom:14px;
  }

  .modal-gallery-item{
    display:grid;
    grid-template-columns:58px 1fr auto;
    align-items:center;
    gap:10px;
    background:#f9fafb;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:8px;
  }

  .modal-gallery-thumb{
    width:54px;
    height:54px;
    border-radius:10px;
    border:1px solid #e5e7eb;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    font-size:22px;
  }

  .modal-gallery-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
  }

  .modal-gallery-name{
    font-size:12px;
    color:#374151;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .modal-gallery-empty{
    color:#6b7280;
    font-size:13px;
    background:#f9fafb;
    border:1px dashed #d1d5db;
    border-radius:12px;
    padding:14px;
    margin-bottom:14px;
  }

  .modal-gallery-actions{
    display:grid;
    grid-template-columns:1fr auto;
    gap:8px;
    align-items:center;
    margin-top:8px;
  }

  .modal-gallery-actions input[type="url"]{
    width:100%;
  }

  .quality-close-btn{
    border:none;
    background:#f3f4f6;
    border-radius:999px;
    width:34px;
    height:34px;
    cursor:pointer;
    font-weight:900;
  }

  @media (max-width:1200px){
    .quality-table-wrap .table{ min-width:1180px !important; }
    .quality-controls-grid{ grid-template-columns:1fr; }
  }


  .add-gallery-manager{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }

  .add-gallery-manager .gallery-count-badge{
    width:auto;
    min-width:130px;
  }

  .add-gallery-hidden-textarea{
    display:none !important;
  }

  .product-add-form{
    grid-template-columns:2fr 1fr 1fr 1fr !important;
    gap:10px !important;
  }

  .product-add-form .field-name{ grid-column:span 2; }
  .product-add-form .field-slug{ grid-column:span 2; }
  .product-add-form .field-image{ grid-column:span 2; }
  .product-add-form .field-category{ grid-column:span 2; }
  .product-add-form .field-small select,
  .product-add-form .field-small input{
    max-width:100%;
  }

  .slug-help{
    display:block;
    margin-top:4px;
    color:#6b7280;
    font-size:11px;
  }

  .prod-slug-input{
    font-family:monospace;
    color:#374151;
  }

  @media (max-width:900px){
    .product-add-form{ grid-template-columns:1fr !important; }
    .product-add-form .field-name,
    .product-add-form .field-slug,
    .product-add-form .field-image,
    .product-add-form .field-category{ grid-column:1 / -1; }
  }



  /* Variações V3 - visual, sem quebrar slug/galeria */
  .quality-variations-box{
    grid-column:1 / -1;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:14px;
    background:#fbfdff;
    margin-top:8px;
  }
  .quality-variations-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:12px;font-weight:900;}
  .quality-variations-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
  .quality-variations-box.variations-disabled .quality-variations-grid{display:none !important;}
  .variation-disabled-note{display:none;margin-top:10px;padding:10px 12px;border:1px dashed #cbd5e1;border-radius:10px;background:#f8fafc;color:#64748b;font-size:12px;}
  .quality-variations-box.variations-disabled .variation-disabled-note{display:block;}
  .quality-var-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:10px;min-height:120px;}
  .quality-var-card strong{display:block;margin-bottom:8px;}
  .quality-var-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
  .quality-var-actions .btn{padding:6px 8px !important;font-size:11px !important;}
  .quality-var-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;min-height:28px;}
  .quality-var-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #d1d5db;background:#f9fafb;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:700;}
  .quality-var-pill button{border:none;background:transparent;color:#991b1b;font-weight:900;cursor:pointer;padding:0;}
  .quality-var-dot{width:14px;height:14px;border-radius:50%;border:1px solid #cbd5e1;display:inline-block;background:#e5e7eb;}
  .variation-hidden-data{display:none !important;}
  .variation-summary{font-size:11px;color:#374151;line-height:1.4;margin-top:4px;}
  .manage-variations-btn{margin-top:6px;width:100% !important;font-size:10.5px !important;padding:7px 8px !important;}
  .quality-variation-modal{width:min(920px,96vw);max-height:88vh;overflow:auto;background:#fff;border-radius:16px;border:1px solid #e5e7eb;box-shadow:0 22px 80px rgba(0,0,0,.25);}
  .quality-variation-modal-body{padding:16px;}
  .variation-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .variation-form-row{display:grid;grid-template-columns:1fr 80px 1.3fr auto;gap:8px;align-items:end;}
  .variation-form-row input,.variation-form-row select{width:100% !important;min-height:38px !important;}
  .variation-simple-row{display:grid;grid-template-columns:1fr 1.2fr auto;gap:8px;align-items:end;}
  .variation-simple-row input,.variation-simple-row select{min-height:38px !important;}
  .variation-labels-box{grid-column:1 / -1;background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:10px;margin-bottom:10px;}
  .variation-labels-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
  .variation-labels-grid label{font-size:11px;font-weight:800;color:#374151;}
  .variation-labels-grid input{width:100% !important;min-height:36px !important;}
  .variation-help{display:block;margin-top:5px;color:#6b7280;font-size:11px;}
  .quality-combo-card{grid-column:1 / -1;background:#fff;border:1px solid #dbeafe !important;}
  .variation-combo-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr auto;gap:6px;align-items:end;}
  .quality-combo-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
  .quality-combo-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #bfdbfe;background:#eff6ff;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:800;}
  .quality-combo-pill button{border:none;background:transparent;color:#991b1b;cursor:pointer;font-weight:900;}

  @media (max-width:1000px){.quality-variations-grid,.variation-modal-grid{grid-template-columns:1fr;}.variation-form-row,.variation-simple-row,.variation-combo-row{grid-template-columns:1fr;}}

</style>


  <% if (flash) { %>
    <div id="flash-message" style="margin: 10px 0 18px 0; padding: 12px 14px; border-radius: 6px; background: #e8f7ee; border: 1px solid #b8e6c8; color: #087a31; font-weight: 600;">
      <%= flash %>
    </div>
  <% } else { %>
    <div id="flash-message" style="display:none; margin: 10px 0 18px 0; padding: 12px 14px; border-radius: 6px; background: #e8f7ee; border: 1px solid #b8e6c8; color: #087a31; font-weight: 600;"></div>
  <% } %>

  <form method="post" action="/produtos/add" class="row product-add-form" id="add-product-form">
    <div class="field-name">
      <label>Nome</label>
      <input type="text" name="name" id="add-product-name" placeholder="Ex.: iPhone 15 128GB">
    </div>

    <div class="field-slug">
      <label>Slug / URL amigável</label>
      <input type="text" name="slug" id="add-product-slug" placeholder="iphone-15-128gb">
      <small class="slug-help">Preenche automático ao digitar o nome, mas você pode editar para SEO.</small>
    </div>

    <div class="field-small">
      <label>Preço</label>
      <input type="number" name="price" step="0.01" min="0" placeholder="opcional">
    </div>

    <div class="field-image">
      <label>Imagem</label>
      <input type="text" name="image" id="add-product-image" list="imagens-list" placeholder="Selecione ou digite o nome..." onfocus="sincronizarImagensAuto()" autocomplete="off">
      <datalist id="imagens-list">
        <% (imagens || []).forEach(img => { %>
          <option value="images/<%= img %>"><%= img %></option>
        <% }) %>
      </datalist>
    </div>

    <div class="field-category">
      <label>Categoria</label>
      <select name="category">
        <option value="">Início (vitrine)</option>
        <% (categorias || []).forEach(c => { %>
          <option value="<%= c.slug %>"><%= c.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field-small">
      <label>Mostrar preço</label>
      <select name="showPrice">
        <option value="true" selected>Sim</option>
        <option value="false">Não</option>
      </select>
    </div>

    <div class="field-small">
      <label>Mostrar na vitrine</label>
      <select name="featured">
        <option value="true">Sim</option>
        <option value="false" selected>Não</option>
      </select>
    </div>

    <div class="field-small">
      <label>Ativo</label>
      <select name="active">
        <option value="true" selected>Sim</option>
        <option value="false">Não</option>
      </select>
    </div>

    <div class="field-small">
      <label>Ver detalhes</label>
      <select name="detailsEnabled">
        <option value="false" selected>Não</option>
        <option value="true">Sim</option>
      </select>
    </div>

    <div class="quality-compact-gallery" style="grid-column: 1 / -1; border:1px solid #e5e7eb; border-radius:8px; padding:10px; background:#fafafa;">
      <label>Galeria do produto <small style="font-weight:400;color:#6b7280;">(máx. 4 itens: fotos ou vídeo do YouTube)</small></label>
      <textarea name="gallery" id="add-product-gallery" class="add-gallery-hidden-textarea"></textarea>
      <div class="add-gallery-manager">
        <span class="gallery-count-badge" id="add-gallery-count">📷 0 item(ns)</span>
        <button class="btn" type="button" id="add-manage-gallery-btn">Gerenciar galeria</button>
      </div>
      <small style="display:block; margin-top:6px; color:#6b7280;">Use o gerenciador para adicionar fotos ou vídeo. Depois clique em <strong>Adicionar</strong> para salvar o produto.</small>
    </div>

    <div class="quality-variations-box" id="add-variations-box">
      <div class="quality-variations-title">
        <span>🎛️ Variações do produto <small style="font-weight:400;color:#6b7280;">(opcional)</small></span>
        <small style="font-weight:400;color:#6b7280;">Use só quando o produto tiver cor, GB, RAM ou estado.</small>
      </div>
      <label>Ativar variações</label>
      <select name="variationsEnabled" class="variation-enabled-select" style="max-width:220px;margin-bottom:10px;">
        <option value="false" selected>Sem variações</option>
        <option value="true">Com variações</option>
      </select>
      <div class="variation-disabled-note">As opções de cor, armazenamento, RAM, estado e grade ficam escondidas enquanto o produto estiver marcado como <strong>Sem variações</strong>.</div>
      <textarea name="variationColors" class="variation-hidden-data" data-var-type="colors"></textarea>
      <textarea name="variationStorage" class="variation-hidden-data" data-var-type="storage"></textarea>
      <textarea name="variationRam" class="variation-hidden-data" data-var-type="ram"></textarea>
      <textarea name="variationCondition" class="variation-hidden-data" data-var-type="condition"></textarea>
      <textarea name="variationLabels" class="variation-hidden-data" data-var-type="labels"></textarea>
      <textarea name="variationCombinations" class="variation-hidden-data" data-var-type="combinations"></textarea>
      <div class="quality-variations-grid">
        <div class="variation-labels-box">
          <strong>🏷️ Nome dos grupos</strong>
          <small class="variation-help">Opcional. Use quando quiser trocar "Armazenamento" por "Tipo de serviço", por exemplo.</small>
          <div class="variation-labels-grid">
            <label>Cor<input type="text" class="variation-label-input" data-label-type="colors" placeholder="Cor"></label>
            <label>Armazenamento<input type="text" class="variation-label-input" data-label-type="storage" placeholder="Armazenamento"></label>
            <label>RAM<input type="text" class="variation-label-input" data-label-type="ram" placeholder="Memória RAM"></label>
            <label>Estado<input type="text" class="variation-label-input" data-label-type="condition" placeholder="Estado"></label>
          </div>
        </div>
        <div class="quality-var-card" data-var-card="colors">
          <strong>🎨 Cores</strong>
          <div class="variation-form-row">
            <input type="text" class="var-color-name" placeholder="Nome: Preto">
            <input type="color" class="var-color-hex" value="#111111">
            <input type="text" class="var-color-image" list="imagens-list" placeholder="Imagem opcional">
            <button class="btn add-var-color" type="button">Adicionar</button>
          </div>
          <div class="quality-var-actions">
            <button class="btn var-preset" type="button" data-type="colors" data-values="Preto|#111111\nBranco|#f8fafc\nAzul|#2563eb">Preto / Branco / Azul</button>
            <button class="btn var-preset" type="button" data-type="colors" data-values="Preto|#111111\nVerde|#22c55e\nAzul|#2563eb">Preto / Verde / Azul</button>
          </div>
          <div class="quality-var-list" data-var-list="colors"></div>
        </div>
        <div class="quality-var-card" data-var-card="storage">
          <strong>💾 Armazenamento</strong>
          <div class="variation-simple-row"><select class="var-simple-select" data-type="storage"><option>64GB</option><option>128GB</option><option>256GB</option><option>512GB</option><option>1TB</option></select><input type="text" class="var-simple-custom" data-type="storage" placeholder="Outro: 2TB"><button class="btn add-var-simple" type="button" data-type="storage">Adicionar</button></div><small class="variation-help">Escolha da lista ou digite uma opção nova.</small>
          <div class="quality-var-actions"><button class="btn var-preset" type="button" data-type="storage" data-values="128GB\n256GB\n512GB">128 / 256 / 512GB</button><button class="btn var-preset" type="button" data-type="storage" data-values="64GB\n128GB\n256GB">64 / 128 / 256GB</button></div>
          <div class="quality-var-list" data-var-list="storage"></div>
        </div>
        <div class="quality-var-card" data-var-card="ram">
          <strong>⚡ Memória RAM</strong>
          <div class="variation-simple-row"><select class="var-simple-select" data-type="ram"><option>4GB</option><option>6GB</option><option>8GB</option><option>12GB</option><option>16GB</option><option>24GB</option></select><input type="text" class="var-simple-custom" data-type="ram" placeholder="Outro: 32GB"><button class="btn add-var-simple" type="button" data-type="ram">Adicionar</button></div><small class="variation-help">Ex.: 16GB, 24GB, 32GB ou RAM Boost.</small>
          <div class="quality-var-actions"><button class="btn var-preset" type="button" data-type="ram" data-values="4GB\n8GB\n12GB">4 / 8 / 12GB</button><button class="btn var-preset" type="button" data-type="ram" data-values="6GB\n8GB">6 / 8GB</button></div>
          <div class="quality-var-list" data-var-list="ram"></div>
        </div>
        <div class="quality-var-card" data-var-card="condition">
          <strong>⭐ Estado</strong>
          <div class="variation-simple-row"><select class="var-simple-select" data-type="condition"><option>Novo</option><option>Excelente</option><option>Muito Bom</option><option>Com marcas de uso</option></select><input type="text" class="var-simple-custom" data-type="condition" placeholder="Outro estado"><button class="btn add-var-simple" type="button" data-type="condition">Adicionar</button></div><small class="variation-help">Ex.: Seminovo, Vitrine, Caixa aberta.</small>
          <div class="quality-var-actions"><button class="btn var-preset" type="button" data-type="condition" data-values="Novo">Novo</button><button class="btn var-preset" type="button" data-type="condition" data-values="Excelente\nMuito Bom\nCom marcas de uso">Usados padrão</button></div>
          <div class="quality-var-list" data-var-list="condition"></div>
        </div>
        <div class="quality-var-card quality-combo-card" data-var-card="combinations">
          <strong>🧩 Grade de combinações</strong>
          <small class="variation-help">Opcional. Ex.: Preto + 128GB + 4GB. Ao clicar numa cor no site, ele puxa automaticamente a combinação cadastrada.</small>
          <div class="variation-combo-row">
            <select class="var-combo-select" data-combo="color"><option value="">Cor</option></select>
            <select class="var-combo-select" data-combo="storage"><option value="">GB</option></select>
            <select class="var-combo-select" data-combo="ram"><option value="">RAM</option></select>
            <select class="var-combo-select" data-combo="condition"><option value="">Estado</option></select>
            <input type="text" class="var-combo-image" list="imagens-list" placeholder="Imagem opcional">
            <button class="btn add-var-combo" type="button">Adicionar</button>
          </div>
          <div class="quality-combo-list" data-var-list="combinations"></div>
        </div>
      </div>
    </div>

    <div style="grid-column: 1 / -1;">
      <label>Descrição curta</label>
      <input type="text" name="descriptionShort" placeholder="Ex.: Novo, lacrado, 128GB, garantia...">
    </div>

    <div style="grid-column: 1 / -1;">
      <label>Descrição completa</label>
      <textarea name="descriptionLong" rows="3" placeholder="Detalhes do produto, características, garantia, conteúdo da caixa..." style="width:100%; padding:8px 12px; border:1px solid #ccc; border-radius:4px;"></textarea>
    </div>

    <div style="align-self:end">
      <button class="btn primary" type="submit">Adicionar</button>
    </div>
  </form>

  <div class="quality-controls-grid">
