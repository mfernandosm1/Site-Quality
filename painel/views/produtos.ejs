              <div class="quality-erp-stock-card">
                <div class="quality-list-erp-category"><small>Categoria ERP</small><strong><%= listErpCategory?.name || 'Não definida' %></strong><span class="quality-erp-type"><%= listErpCategoryType === 'service' ? 'Serviço' : (listErpCategoryType === 'controlled_product' ? 'Produto controlado' : 'Produto') %></span></div>
                <input type="hidden" name="category" class="prod-category-select" value="<%= p.category || '' %>">
                <input type="hidden" name="subcategory" class="prod-subcategory-select" value="<%= p.subcategory || p.subcategoria || '' %>">
                <% if (listErpCategoryType === 'service') { %>
                  <span class="quality-service-badge">🧰 Serviço</span>
