  function parseComboLines(text){
    return (text || "").split(/\r?\n/).map(line => line.trim()).filter(Boolean).map(line => {
      const parts = line.split("|").map(v => v.trim());
      return { color: parts[0] || "", storage: parts[1] || "", ram: parts[2] || "", condition: parts[3] || "", image: parts[4] || "", stock: parts[5] || "", erpPrice: parts[6] || "" };
    });
  }

  function comboToLine(c){
    return [c.color, c.storage, c.ram, c.condition, c.image, c.stock, c.erpPrice].map(function(x){return x===undefined||x===null?'':x;}).join("|").replace(/\|+$/,'');
  }

  function comboLabel(c){
    return [c.color, c.storage, c.ram, c.condition].filter(Boolean).join(" + ") || "Combinação";
  }

  function renderEditVariationStock(row){
    if (!editVariationStockList) return;
    const combosEl = row?.querySelector(".row-variation-combinations");
    const combos = parseComboLines(combosEl?.value || "");
    editVariationStockList.innerHTML = "";
    if (!combos.length) {
      editVariationStockList.innerHTML = '<div class="quality-empty-note">Este produto ainda não tem combinações de variação com estoque. Use o botão 🎛️ Variações para criar a grade.</div>';
      return;
    }
    combos.forEach((combo, index) => {
      const item = document.createElement("div");
      item.className = "quality-stock-variation-row";
      item.innerHTML = `<span>${comboLabel(combo)}</span><input type="number" min="0" step="1" value="${String(combo.stock || "").replace(/&/g,"&amp;").replace(/"/g,"&quot;")}" data-combo-stock-index="${index}" placeholder="Qtd.">`;
      editVariationStockList.appendChild(item);
    });
  }

  function syncEditStockArchitecture(row){
    const combosEl = row?.querySelector('.row-variation-combinations');
    const combos = parseComboLines(combosEl?.value || '');
    const hasVariations = combos.length > 0;
    const stockInput = document.getElementById('edit-stock');
    const stockLabel = document.getElementById('edit-stock-label');
    const derivedHelp = document.getElementById('edit-stock-derived-help');
    if (!stockInput) return hasVariations;

    if (hasVariations) {
      const total = combos.reduce((sum, combo) => sum + Math.max(0, Number(combo.stock) || 0), 0);
      stockInput.value = String(total);
      // Produto com variações não possui estoque próprio. O total é apenas uma
      // leitura derivada da soma das combinações e não pode receber foco/edição.
      stockInput.readOnly = true;
      stockInput.disabled = true;
      stockInput.tabIndex = -1;
      stockInput.setAttribute('aria-readonly', 'true');
      stockInput.title = 'Calculado automaticamente pela soma das variações';
      if (stockLabel?.childNodes?.[0]) stockLabel.childNodes[0].textContent = 'Estoque total (variações)';
      if (derivedHelp) derivedHelp.style.display = 'block';
    } else {
      stockInput.readOnly = false;
      stockInput.disabled = false;
      stockInput.tabIndex = 0;
      stockInput.removeAttribute('aria-readonly');
      stockInput.removeAttribute('title');
      if (stockLabel?.childNodes?.[0]) stockLabel.childNodes[0].textContent = 'Estoque';
      if (derivedHelp) derivedHelp.style.display = 'none';
    }
    return hasVariations;
  }

