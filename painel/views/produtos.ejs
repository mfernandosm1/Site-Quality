                    <% if (hasStockVariations) { %>
                      <input type="hidden" name="stock" value="<%= stockValue %>">
                      <strong class="quality-derived-stock"><%= stockNum %></strong>
                      <span class="quality-stock-badge <%= stockClass %>">📦 <%= stockText %> · <%= p.variations.combinations.length %> variação(ões)</span>
                    <% } else { %>
                      <input type="number" step="1" min="0" name="stock" value="<%= stockValue %>" placeholder="Qtd.">
                      <span class="quality-stock-badge <%= stockClass %>">📦 <%= stockText %></span>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </td>

            <td>
              <% const rawErpActive = erpData.active !== undefined ? erpData.active : p.active; const erpActiveValue = !['false', '0', 'off', 'inativo'].includes(String(rawErpActive).toLowerCase()) && rawErpActive !== false; %>
