<div id="quality-image-suggest" class="quality-image-suggest"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("panel-search-input");
  const QUALITY_LIST_STATE = <%- JSON.stringify(listState || {}).replace(/</g, '\u003c') %>;

  const QUALITY_SUBCATEGORIES = <%- JSON.stringify(subcategorias || []).replace(/</g, '\u003c') %>;
  const QUALITY_CATEGORIES = <%- JSON.stringify(categorias || []).replace(/</g, '\u003c') %>;
  function refreshSubcategorySelect(categorySelect, preferredValue = '') {
    if (!categorySelect) return;
    const targetId = categorySelect.dataset.subcategoryTarget;
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;
    const category = QUALITY_CATEGORIES.find(c => String(c.slug || '') === String(categorySelect.value || ''));
    const current = preferredValue || target.dataset.current || target.value || '';
    target.innerHTML = categorySelect.value ? '<option value="">Selecione uma subcategoria...</option>' : '<option value="">Selecione primeiro uma categoria...</option>';
    if (category) {
      QUALITY_SUBCATEGORIES.filter(s => Number(s.categoryId) === Number(category.id) && s.active !== false)
        .sort((a,b) => Number(a.order||0)-Number(b.order||0))
        .forEach(s => { const o=document.createElement('option'); o.value=s.slug; o.textContent=s.name; if(String(s.slug)===String(current)) o.selected=true; target.appendChild(o); });
    }
    target.dataset.current = '';
  }
  const addProductForm = document.getElementById('add-product-form');
  addProductForm?.addEventListener('submit', (event) => {
    const erpCategory = addProductForm.querySelector('select[name="erpCategory"]');
    if (erpCategory && !erpCategory.value) {
      event.preventDefault();
      alert('Selecione uma categoria do ERP antes de cadastrar o produto.');
      erpCategory.focus();
    }
  });

  document.querySelectorAll('.js-category-select').forEach(select => {
    refreshSubcategorySelect(select);
    select.addEventListener('change', () => refreshSubcategorySelect(select, ''));
  });


  const bulkCategorySelect = document.getElementById('bulk-category-select');
  const bulkSubcategorySelect = document.getElementById('bulk-subcategory-select');

  function selectedProductsCommonCategory() {
    const selectedRows = Array.from(document.querySelectorAll('.product-check:checked'))
      .map(check => check.closest('.product-row'))
      .filter(Boolean);
    const values = [...new Set(selectedRows.map(row => row.querySelector('.prod-category-select')?.value || ''))];
    return values.length === 1 ? values[0] : null;
  }

  function refreshBulkSubcategories() {
    if (!bulkCategorySelect || !bulkSubcategorySelect) return;
    const categoryActionEnabled = Boolean(document.querySelector('.quality-bulk-action input[value="category"]:checked'));
    const categoryValue = categoryActionEnabled ? bulkCategorySelect.value : selectedProductsCommonCategory();
    const category = QUALITY_CATEGORIES.find(c => String(c.slug || '') === String(categoryValue || ''));
    const current = bulkSubcategorySelect.value || '';
    bulkSubcategorySelect.innerHTML = '<option value="">Sem subcategoria</option>';
    if (category) {
      QUALITY_SUBCATEGORIES
        .filter(s => Number(s.categoryId) === Number(category.id) && s.active !== false)
        .sort((a,b) => Number(a.order || 0) - Number(b.order || 0))
        .forEach(s => {
          const option = document.createElement('option');
          option.value = s.slug;
          option.textContent = s.name;
          if (String(s.slug) === String(current)) option.selected = true;
          bulkSubcategorySelect.appendChild(option);
        });
    }
  }

  bulkCategorySelect?.addEventListener('change', refreshBulkSubcategories);
  refreshBulkSubcategories();

  document.querySelectorAll('.quality-bulk-action input[name="enabledActions"]').forEach(check => {
    const card = check.closest('.quality-bulk-action');
    const sync = () => card?.classList.toggle('enabled', check.checked);
    check.addEventListener('change', () => {
      sync();
      if (check.value === 'category' || check.value === 'subcategory') refreshBulkSubcategories();
    });
    sync();
  });

  const categoryFilter = document.getElementById("panel-category-filter");
  const erpFilter = document.getElementById("panel-erp-filter");
  const lvFilter = document.getElementById("panel-lv-filter");
  const stockFilter = document.getElementById("panel-stock-filter");
  const filteredProductsCount = document.getElementById("filtered-products-count");
  const rows = document.querySelectorAll("#products-table-body .product-row");

  async function hydrateCompactImageSelect(select) {
    if (!select || select.dataset.imagesLoaded === 'true') return;
    await sincronizarImagensAuto();
    const current = select.value || select.dataset.currentVal || '';
    const options = [...document.querySelectorAll('#imagens-list option')];
    const fragment = document.createDocumentFragment();
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Imagem...';
    fragment.appendChild(placeholder);
    options.forEach(source => {
      const option = document.createElement('option');
      option.value = source.value;
      option.textContent = source.textContent || source.value.replace(/^images\//, '');
      if (option.value === current) option.selected = true;
      fragment.appendChild(option);
    });
    select.innerHTML = '';
    select.appendChild(fragment);
    select.value = current;
    select.dataset.imagesLoaded = 'true';
  }

  document.querySelectorAll('.quality-image-compact-select[data-lazy-images="true"]').forEach(select => {
    select.addEventListener('focus', () => hydrateCompactImageSelect(select), { once: true });
    select.addEventListener('pointerdown', () => hydrateCompactImageSelect(select), { once: true });
  });
  const selectedCount = document.getElementById("selected-count");
  const bulkContainer = document.getElementById("bulk-selected-container");
  const selectAllCheckbox = document.getElementById("select-all-checkbox");
  const selectAllBtn = document.getElementById("select-all-products");
  const clearBtn = document.getElementById("clear-selection");
  const invertSelectionBtn = document.getElementById("invert-selection");
  const bulkActionsForm = document.getElementById("bulk-actions-form");
  const bulkActionsSummary = document.getElementById("bulk-actions-summary");
  const bulkStockControlled = document.getElementById("bulk-stock-controlled");
  const bulkMinimumQuantity = document.getElementById("bulk-minimum-quantity");
  const flashMessage = document.getElementById("flash-message");

  const bulkCenterToggle = document.getElementById("bulk-center-toggle");
  const bulkCenter = bulkCenterToggle?.closest(".quality-bulk-center");
  const syncBulkCenter = () => {
    const expanded = bulkCenter?.classList.contains("is-expanded") === true;
    bulkCenterToggle?.setAttribute("aria-expanded", expanded ? "true" : "false");
    const icon = bulkCenterToggle?.querySelector(".quality-bulk-toggle-icon");
    if (icon) icon.textContent = expanded ? "▼" : "▶";
  };
  bulkCenterToggle?.addEventListener("click", () => {
    bulkCenter?.classList.toggle("is-expanded");
    syncBulkCenter();
  });
  syncBulkCenter();

  const galleryModal = document.getElementById("gallery-modal-backdrop");
  const galleryModalClose = document.getElementById("gallery-modal-close");
  const modalGalleryProduct = document.getElementById("modal-gallery-product");
  const modalGalleryList = document.getElementById("modal-gallery-list");
  const modalGalleryFileInput = document.getElementById("modal-gallery-file-input");
  const modalGalleryUploadBtn = document.getElementById("modal-gallery-upload-btn");
  const modalYoutubeUrl = document.getElementById("modal-youtube-url");
  const modalYoutubeBtn = document.getElementById("modal-youtube-btn");

  const addGalleryTextarea = document.getElementById("add-product-gallery");
  const addGalleryCount = document.getElementById("add-gallery-count");
  const addManageGalleryBtn = document.getElementById("add-manage-gallery-btn");

  let activeGalleryContext = null;

  function gerarSlugPainel(texto) {
    return String(texto || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function ligarSlugAutomatico(nomeInput, slugInput) {
    if (!nomeInput || !slugInput) return;

    slugInput.dataset.manual = slugInput.value.trim() ? "1" : "0";

    slugInput.addEventListener("input", () => {
      slugInput.value = gerarSlugPainel(slugInput.value);
      slugInput.dataset.manual = slugInput.value.trim() ? "1" : "0";
    });

    nomeInput.addEventListener("input", () => {
      if (slugInput.dataset.manual === "1") return;
      slugInput.value = gerarSlugPainel(nomeInput.value);
    });
  }

  ligarSlugAutomatico(
    document.getElementById("add-product-name"),
    document.getElementById("add-product-slug")
  );


  function setAddField(name, value) {
    const form = document.getElementById("add-product-form");
    const field = form?.querySelector(`[name="${name}"]`);
    if (!field || value === undefined || value === null) return;
    field.value = String(value);
    field.dispatchEvent(new Event("input", { bubbles: true }));
    field.dispatchEvent(new Event("change", { bubbles: true }));
  }

  function setAiFillStatus(text, type = "loading") {
    const status = document.getElementById("ai-fill-product-status");
    if (!status) return;
    status.textContent = text || "";
    status.className = `quality-ai-fill-status ${type}`;
  }

  function applyAiProductDraft(draft = {}) {
    const nameInput = document.getElementById("add-product-name");
    const slugInput = document.getElementById("add-product-slug");
    const editor = document.getElementById("add-description-long-editor");
    const hidden = document.getElementById("add-description-long-hidden");

    if (draft.name && nameInput) {
      nameInput.value = draft.name;
      nameInput.dispatchEvent(new Event("input", { bubbles: true }));
    }

    if (draft.slug && slugInput) {
      slugInput.value = gerarSlugPainel(draft.slug);
      slugInput.dataset.manual = "1";
      slugInput.dispatchEvent(new Event("input", { bubbles: true }));
    }

    if (draft.category) setAddField("category", draft.category);
    if (draft.descriptionShort) setAddField("descriptionShort", draft.descriptionShort);

    if (draft.descriptionLong) {
      const html = String(draft.descriptionLong);
      if (editor) editor.innerHTML = html;
      if (hidden) hidden.value = html;
    }
  }

  async function fillProductWithAi() {
    const input = document.getElementById("ai-product-query");
    const btn = document.getElementById("ai-fill-product-btn");
    const query = (input?.value || "").trim();

    if (!query) {
      setAiFillStatus("Digite o nome/modelo do produto primeiro.", "error");
      input?.focus();
      return;
    }

    const oldText = btn?.textContent || "✨ Preencher cadastro";
    if (btn) {
      btn.disabled = true;
      btn.textContent = "⏳ Consultando IA...";
    }
    setAiFillStatus("Gerando nome, slug, categoria e descrição técnica...", "loading");

    try {
      const response = await fetch("/produtos/ai-fill", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({ query })
      });

      const json = await response.json().catch(() => ({}));
      if (!response.ok || !json.success) throw new Error(json.message || "Erro ao gerar cadastro com IA.");

      applyAiProductDraft(json.draft || {});
      if (json.warning) {
        setAiFillStatus("⚠️ Gemini sem resposta/cota no momento. Preenchi um rascunho local com o que foi possível. Revise antes de salvar. Detalhe: " + json.warning, "error");
      } else {
        setAiFillStatus("✅ Cadastro preenchido. Revise os dados, escolha a imagem e clique em Adicionar.", "ok");
      }
    } catch (error) {
      console.error(error);
      setAiFillStatus(error.message || "Erro ao gerar cadastro com IA.", "error");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }

  document.getElementById("ai-fill-product-btn")?.addEventListener("click", fillProductWithAi);
  document.getElementById("ai-product-query")?.addEventListener("keydown", event => {
    if (event.key === "Enter") {
      event.preventDefault();
      fillProductWithAi();
    }
  });

  function showMessage(text, type = "success") {
    if (!flashMessage) return;
    flashMessage.textContent = text;
    flashMessage.style.display = "block";
    flashMessage.style.background = type === "error" ? "#fde8e8" : "#e8f7ee";
    flashMessage.style.borderColor = type === "error" ? "#f5b5b5" : "#b8e6c8";
    flashMessage.style.color = type === "error" ? "#a40000" : "#087a31";

    clearTimeout(window.__flashTimer);
    window.__flashTimer = setTimeout(() => {
      flashMessage.style.display = "none";
    }, 3500);
  }

  function getGalleryItems(textarea) {
    return (textarea?.value || "").split(/\r?\n/).map(v => v.trim()).filter(Boolean);
  }

  function setGalleryItems(textarea, items) {
    if (!textarea) return;
    textarea.value = items.slice(0, 4).join("\n");
    textarea.dispatchEvent(new Event("input", { bubbles: true }));
  }

  function isYoutubeUrl(url) {
    return /^(https?:\/\/)?(www\.)?(youtube\.com|youtu\.be)\//i.test(url || "");
  }

  function mediaLabel(value) {
    if (!value) return "";
    if (isYoutubeUrl(value)) return "YouTube: " + value;
    return value.split("/").pop() || value;
  }

  function gallerySummaryText(items) {
    const photos = items.filter(item => !isYoutubeUrl(item)).length;
    const videos = items.filter(item => isYoutubeUrl(item)).length;
    if (!items.length) return "📷 0 item(ns)";
    return `📷 ${photos} foto(s)${videos ? ` + ${videos} vídeo(s)` : ""}`;
  }

  function updateAddGallerySummary() {
    if (!addGalleryCount || !addGalleryTextarea) return;
    addGalleryCount.textContent = gallerySummaryText(getGalleryItems(addGalleryTextarea));
  }

  function updateGallerySummary(row) {
    if (!row) return;
    const textarea = row.querySelector(".gallery-textarea");
    const badge = row.querySelector(".gallery-count-badge");
    if (badge) badge.textContent = gallerySummaryText(getGalleryItems(textarea));
  }

  function addGalleryItem(textarea, item) {
    const items = getGalleryItems(textarea);
    if (items.length >= 4) {
      alert("A galeria permite no máximo 4 itens.");
      return false;
    }
    if (item && !items.includes(item)) items.push(item);
    setGalleryItems(textarea, items);
    return true;
  }

  function makeGalleryContextFromRow(row) {
    return {
      mode: "row",
      row,
      textarea: row.querySelector(".gallery-textarea"),
      title: row.querySelector(".prod-name-input")?.value || "Produto"
    };
  }

  function makeGalleryContextFromAddForm() {
    return {
      mode: "add",
      row: null,
      textarea: addGalleryTextarea,
      title: "Novo produto"
    };
  }

  async function saveActiveGalleryContext() {
    if (!activeGalleryContext) return;

    if (activeGalleryContext.mode === "row" && activeGalleryContext.row) {
      markRowDirty(activeGalleryContext.row);
      await saveProductRow(activeGalleryContext.row);
      updateGallerySummary(activeGalleryContext.row);
    } else {
      updateAddGallerySummary();
    }
  }

  function renderGalleryModal(context = activeGalleryContext) {
    if (!context || !modalGalleryList) return;

    const items = getGalleryItems(context.textarea);
    if (modalGalleryProduct) modalGalleryProduct.textContent = context.title || "Produto";
    modalGalleryList.innerHTML = "";

    if (!items.length) {
      const empty = document.createElement("div");
      empty.className = "modal-gallery-empty";
      empty.textContent = "Nenhuma foto ou vídeo adicionado ainda.";
      modalGalleryList.appendChild(empty);
      return;
    }

    items.forEach((item, index) => {
      const line = document.createElement("div");
      line.className = "modal-gallery-item";

      const thumb = document.createElement("div");
      thumb.className = "modal-gallery-thumb";
      if (isYoutubeUrl(item)) {
        thumb.textContent = "▶️";
      } else {
        const img = document.createElement("img");
        img.src = item;
        img.alt = mediaLabel(item);
        thumb.appendChild(img);
      }

      const text = document.createElement("div");
