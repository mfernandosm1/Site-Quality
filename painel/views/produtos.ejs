<% layout('layout') -%>
<% const isNewWorkspace = workspaceNew === true; const requestedWorkspaceType = typeof workspaceType === 'string' ? workspaceType : 'product'; const defaultServiceCategory = (erpCategorias || []).find(c => c.active !== false && c.type === 'service'); %>
<% const erpCategoryById = new Map((erpCategorias || []).map(c => [String(c.id), c])); const lvCategoryBySlug = new Map((categorias || []).map(c => [String(c.slug || c.id || ''), c])); const lvSubcategoryByKey = new Map(); (subcategorias || []).forEach(sc => { [sc.id, sc.slug, sc.name].filter(Boolean).forEach(key => lvSubcategoryByKey.set(String(key), sc)); }); %>
<div class="card">
  <% if (!isNewWorkspace) { %>
  <div id="product-master-intro">
    <h3>📦 Cadastro Mestre de Produtos</h3>
  </div>
  <% } %>


  <style>
