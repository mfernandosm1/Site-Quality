  function reconcileVariationCombinationLines(box, dimensions, comboTextarea) {
    const fields = ['color','storage','ram','condition'];
    const fieldIndex = {color:0,storage:1,ram:2,condition:3};
    const allowed = {};
    (dimensions || []).forEach(function(entry){ allowed[entry[0]] = new Set((entry[1] || []).map(String)); });

    const existing = parseLines(comboTextarea?.value || '');
    const clean = [];
    const seen = new Set();

    function lineParts(line){
      const parts=String(line||'').split('|').map(function(v){return v.trim();});
      while(parts.length<7)parts.push('');
      return parts;
    }
    function key(parts){ return parts.slice(0,4).join('|'); }
    function valid(parts){
      return fields.every(function(field){
        const value=parts[fieldIndex[field]]||'';
        if(!value)return true;
        return !!(allowed[field] && allowed[field].has(value));
      });
    }
    function push(parts){
      const k=key(parts);
      if(!k.replace(/\|/g,'') || seen.has(k))return;
      seen.add(k);clean.push(parts);
    }

    existing.map(lineParts).filter(valid).forEach(push);

    function generateForOrphan(field,value){
      const others=(dimensions||[]).filter(function(entry){return entry[0]!==field;});
      let rows=[['','','','','','','']];
      others.forEach(function(entry){
        const otherField=entry[0], values=entry[1]||[], idx=fieldIndex[otherField];
        rows=rows.flatMap(function(base){
          return values.map(function(option){const copy=base.slice();copy[idx]=option;return copy;});
        });
      });
      if(!others.length)rows=[['','','','','','','']];
      rows.forEach(function(parts){parts[fieldIndex[field]]=value;push(parts);});
    }

    (dimensions||[]).forEach(function(entry){
      const field=entry[0], values=entry[1]||[], idx=fieldIndex[field];
      values.forEach(function(value){
        if(!clean.some(function(parts){return (parts[idx]||'')===value;})) generateForOrphan(field,value);
      });
    });

    const lines=clean.map(function(parts){return parts.join('|').replace(/\|+$/,'');});
    if(comboTextarea)comboTextarea.value=lines.join('\n');
    return lines;
  }

  function renderComboTools(box) {
    if (!box) return;
    const colors = parseLines(getVarTextarea(box, 'colors')?.value).map(colorNameFromLine).filter(Boolean);
    const storage = parseLines(getVarTextarea(box, 'storage')?.value);
    const ram = parseLines(getVarTextarea(box, 'ram')?.value);
    const condition = parseLines(getVarTextarea(box, 'condition')?.value);
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="color"]'), colors, 'Cor');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="storage"]'), storage, 'GB');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="ram"]'), ram, 'RAM');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="condition"]'), condition, 'Estado');

    const comboTextarea = getVarTextarea(box, 'combinations');
    const comboList = box.querySelector('[data-var-list="combinations"]');
    if (!comboTextarea || !comboList) return;

    // Reconciliamos as opções com a grade de estoque. Isso evita o caso em que
    // uma nova variação aparece visualmente, mas fica fora de "Estoque por variação".
    // Combinações já existentes mantêm estoque/preço; opções removidas deixam de
    // gerar combinações e novas opções recebem as combinações que faltam.
    const dimensions = [
      ['color', colors], ['storage', storage], ['ram', ram], ['condition', condition]
    ].filter(([, values]) => values.length);
    let comboLines = reconcileVariationCombinationLines(box, dimensions, comboTextarea);

    // Quando há somente um grupo, a opção já é a própria variação vendável.
    // Nesse caso o preço pertence visualmente à opção (Cor/Tipo de serviço/etc.),
    // e não à Grade de combinações. A grade continua sendo usada internamente
    // para manter identidade, preço e compatibilidade com PDV/estoque.
    const comboCard = box.querySelector('[data-var-card="combinations"]');
    if (dimensions.length === 1) {
      if (comboCard) comboCard.style.display = 'none';
      const [field, values] = dimensions[0];
      const typeByField = { color:'colors', storage:'storage', ram:'ram', condition:'condition' };
      const fieldIndex = { color:0, storage:1, ram:2, condition:3 }[field];
      const listBox = box.querySelector(`[data-var-list="${typeByField[field]}"]`);
      const pills = listBox ? Array.from(listBox.querySelectorAll('.quality-var-pill')) : [];
      values.forEach((value, optionIndex) => {
        const pill = pills[optionIndex];
        if (!pill) return;
        const comboIndex = comboLines.findIndex(line => {
          const parts = line.split('|').map(v => v.trim());
          return (parts[fieldIndex] || '') === value;
        });
        if (comboIndex < 0) return;
        const parts = comboLines[comboIndex].split('|').map(v => v.trim());
        while (parts.length < 7) parts.push('');
        const wrap = document.createElement('span');
        wrap.className = 'quality-variation-inline-price';
        const label = document.createElement('small');
        label.textContent = 'Preço ERP';
        const input = document.createElement('input');
        input.type = 'number'; input.min = '0'; input.step = '0.01';
        input.placeholder = 'Herdar pai'; input.value = parts[6] || '';
        input.title = 'Vazio = usa o Preço de venda ERP do cadastro pai';
        input.addEventListener('click', e => e.stopPropagation());
        input.addEventListener('change', () => {
          const current = parseLines(comboTextarea.value);
          const currentIndex = current.findIndex(line => {
            const p = line.split('|').map(v => v.trim());
            return (p[fieldIndex] || '') === value;
          });
          if (currentIndex < 0) return;
          const cp = current[currentIndex].split('|').map(v => v.trim());
          while (cp.length < 7) cp.push('');
          cp[6] = input.value.trim();
          current[currentIndex] = cp.join('|').replace(/\|+$/,'');
          comboTextarea.value = current.join('\n');
          comboTextarea.dispatchEvent(new Event('input', { bubbles:true }));
        });
        wrap.appendChild(label); wrap.appendChild(input);
        const removeBtn = pill.querySelector('button');
        pill.insertBefore(wrap, removeBtn || null);
      });
    } else if (comboCard) {
      comboCard.style.display = '';
    }

    comboList.innerHTML = '';
    comboLines.forEach((line, index) => {
      const parts = line.split('|').map(v => v.trim());
      while (parts.length < 7) parts.push('');
      const pill = document.createElement('span');
      pill.className = 'quality-combo-pill';
      const text = document.createElement('span');
      text.textContent = [parts[0], parts[1], parts[2], parts[3]].filter(Boolean).join(' + ') || `Variação ${index + 1}`;
      pill.appendChild(text);
      const priceLabel = document.createElement('span');
      priceLabel.className = 'quality-combo-price-label';
      priceLabel.textContent = 'Preço ERP';
      pill.appendChild(priceLabel);
      const priceInput = document.createElement('input');
      priceInput.type = 'number';
      priceInput.min = '0';
      priceInput.step = '0.01';
      priceInput.placeholder = 'Herdar pai';
      priceInput.className = 'quality-combo-price-inline';
      priceInput.value = parts[6] || '';
      priceInput.title = 'Vazio = usa o Preço de venda ERP do cadastro pai';
      priceInput.addEventListener('change', () => {
        const current = parseLines(comboTextarea.value);
        const currentParts = (current[index] || line).split('|').map(v => v.trim());
        while (currentParts.length < 7) currentParts.push('');
        currentParts[6] = priceInput.value.trim();
        current[index] = currentParts.join('|').replace(/\|+$/,'');
        comboTextarea.value = current.join('\n');
        comboTextarea.dispatchEvent(new Event('input', { bubbles:true }));
      });
      pill.appendChild(priceInput);
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        const updated = parseLines(comboTextarea.value).filter((_, i) => i !== index);
        comboTextarea.value = updated.join('\n');
        comboTextarea.dispatchEvent(new Event('input', { bubbles:true }));
        renderVariationBox(box);
      });
      pill.appendChild(remove);
      comboList.appendChild(pill);
    });
  }

