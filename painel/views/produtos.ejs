<div class="quality-modal-backdrop" id="description-modal" aria-hidden="true">
  <div class="quality-description-modal">
    <div class="quality-gallery-modal-header">
      <strong>📝 Editar descrição do produto</strong>
      <button class="quality-close-btn" type="button" id="description-modal-close">×</button>
    </div>
    <div class="quality-description-modal-body">
      <div class="description-editor-field">
        <label>Descrição curta</label>
        <textarea id="description-modal-short" rows="3" placeholder="Resumo curto para cards e buscas..." style="width:100%;padding:10px 12px;border:1px solid #cbd5e1;border-radius:10px;"></textarea>
      </div>
      <div class="description-editor-field">
        <label>Descrição completa</label>
        <div class="description-toolbar">
          <button type="button" data-desc-cmd="bold"><b>B</b></button>
          <button type="button" data-desc-cmd="italic"><i>I</i></button>
          <button type="button" data-desc-cmd="insertUnorderedList">Lista</button>
          <button type="button" data-desc-cmd="formatBlock" data-desc-value="h3">Título</button>
          <button type="button" data-desc-cmd="formatBlock" data-desc-value="p">Texto</button>
          <button type="button" id="description-clear-format">Limpar formatação</button>
        </div>
        <div id="description-modal-long" class="description-rich-editor" contenteditable="true"></div>
        <small class="variation-help">Dica: você pode colar texto pronto aqui e usar negrito, títulos e listas.</small>
      </div>
      <div class="modal-gallery-actions" style="grid-template-columns:auto auto;justify-content:end;">
        <button class="btn" type="button" id="description-modal-cancel">Cancelar</button>
        <button class="btn" type="button" id="description-modal-save">Salvar descrição</button>
      </div>
    </div>
  </div>
</div>


