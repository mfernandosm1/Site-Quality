<% layout('layout') -%>
<div class="card">
  <h3>📦 Produtos</h3>


  <style>
  /* Layout moderno e compacto da página Produtos */
  .quality-panel-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:14px;
  }

  .quality-compact-gallery textarea{
    min-height:52px !important;
    max-height:70px !important;
  }

  .quality-controls-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:12px;
    margin:22px 0 14px 0;
  }

  .quality-control-box{
    background:#fafafa;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:12px;
  }

  .quality-control-title{
    display:flex;
    align-items:center;
    gap:6px;
    font-weight:800;
    margin-bottom:10px;
  }

  .quality-search-row,
  .quality-bulk-row{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
  }

  .quality-search-row input{ flex:1 1 320px; }
  .quality-search-row select{ flex:0 0 220px; }

  .quality-bulk-box{
    display:flex !important;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    background:transparent !important;
    border:none !important;
    padding:0 !important;
    margin:0 !important;
  }

  .quality-bulk-box form{
    display:flex !important;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    margin:0 !important;
  }

  .quality-bulk-box select{
    width:auto !important;
    min-width:220px !important;
    max-width:100% !important;
  }

  .quality-bulk-box .btn,
  .quality-control-box .btn{
    padding:8px 10px !important;
    font-size:12px !important;
    border-radius:9px !important;
  }

  .quality-table-toolbar{
    display:flex;
    justify-content:flex-end;
    margin:12px 0;
  }

  .quality-table-wrap{
    width:100%;
    overflow-x:auto;
    padding-bottom:10px;
  }

  .quality-table-wrap .table{
    width:100% !important;
    min-width:0 !important;
    table-layout:fixed !important;
    border-collapse:collapse;
  }

  .quality-table-wrap .table th,
  .quality-table-wrap .table td{
    min-width:0 !important;
    max-width:none !important;
    padding:7px !important;
    font-size:11px !important;
    vertical-align:top;
  }

  .quality-table-wrap .table th:nth-child(1),
  .quality-table-wrap .table td:nth-child(1){ width:2.2%; }
  .quality-table-wrap .table th:nth-child(2),
  .quality-table-wrap .table td:nth-child(2){ width:2.8%; }
  .quality-table-wrap .table th:nth-child(3),
  .quality-table-wrap .table td:nth-child(3){ width:15%; }
  .quality-table-wrap .table th:nth-child(4),
  .quality-table-wrap .table td:nth-child(4){ width:12%; }
  .quality-table-wrap .table th:nth-child(5),
  .quality-table-wrap .table td:nth-child(5){ width:5%; }
  .quality-table-wrap .table th:nth-child(6),
  .quality-table-wrap .table td:nth-child(6){ width:6%; }
  .quality-table-wrap .table th:nth-child(7),
  .quality-table-wrap .table td:nth-child(7){ width:5%; }
  .quality-table-wrap .table th:nth-child(8),
  .quality-table-wrap .table td:nth-child(8){ width:5%; }
  .quality-table-wrap .table th:nth-child(9),
  .quality-table-wrap .table td:nth-child(9){ width:5%; }
  .quality-table-wrap .table th:nth-child(10),
  .quality-table-wrap .table td:nth-child(10){ width:6%; }
  .quality-table-wrap .table th:nth-child(11),
  .quality-table-wrap .table td:nth-child(11){ width:15%; }
  .quality-table-wrap .table th:nth-child(12),
  .quality-table-wrap .table td:nth-child(12){ width:7%; }
  .quality-table-wrap .table th:nth-child(13),
  .quality-table-wrap .table td:nth-child(13){ width:8%; }
  .quality-table-wrap .table th:nth-child(14),
  .quality-table-wrap .table td:nth-child(14){ width:8%; }

  .quality-table-wrap input,
  .quality-table-wrap select,
  .quality-table-wrap textarea{
    width:100% !important;
    min-width:0 !important;
    max-width:100% !important;
    font-size:11px !important;
    padding:7px 8px !important;
  }

  .quality-table-wrap textarea{
    min-height:44px !important;
    max-height:62px !important;
  }

  .quality-table-wrap th:last-child,
  .quality-table-wrap td:last-child{
    position:static !important;
    right:auto !important;
    box-shadow:none !important;
    z-index:auto !important;
  }

  .quality-gallery-cell,
  .quality-actions{
    min-width:0 !important;
    max-width:none !important;
  }

  .gallery-hidden-textarea{
    display:none !important;
  }

  .gallery-summary{
    display:flex;
    flex-direction:column;
    gap:5px;
  }

  .gallery-count-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:100%;
    border:1px solid #e5e7eb;
    background:#f9fafb;
    color:#374151;
    border-radius:999px;
    padding:5px 7px;
    font-weight:800;
    font-size:11px;
  }

  .manage-gallery-btn,
  .quality-actions .btn{
    display:block;
    width:100% !important;
    padding:7px 8px !important;
    font-size:10.5px !important;
    border-radius:8px !important;
    margin-bottom:5px;
  }

  .row-save-status{
    display:block !important;
    margin:2px 0 5px 0 !important;
    font-size:11px !important;
  }

  .quality-modal-backdrop{
    position:fixed;
    inset:0;
    background:rgba(17,24,39,.55);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:999;
    padding:18px;
  }

  .quality-modal-backdrop.open{
    display:flex;
  }

  .quality-gallery-modal{
    width:min(680px, 96vw);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    border:1px solid #e5e7eb;
    box-shadow:0 22px 80px rgba(0,0,0,.25);
  }

  .quality-gallery-modal-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:14px 16px;
    border-bottom:1px solid #e5e7eb;
  }

  .quality-gallery-modal-header strong{
    font-size:15px;
  }

  .quality-gallery-modal-body{
    padding:16px;
  }

  .modal-gallery-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-bottom:14px;
  }

  .modal-gallery-item{
    display:grid;
    grid-template-columns:58px 1fr auto;
    align-items:center;
    gap:10px;
    background:#f9fafb;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:8px;
  }

  .modal-gallery-thumb{
    width:54px;
    height:54px;
    border-radius:10px;
    border:1px solid #e5e7eb;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    font-size:22px;
  }

  .modal-gallery-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
  }

  .modal-gallery-name{
    font-size:12px;
    color:#374151;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .modal-gallery-empty{
    color:#6b7280;
    font-size:13px;
    background:#f9fafb;
    border:1px dashed #d1d5db;
    border-radius:12px;
    padding:14px;
    margin-bottom:14px;
  }

  .modal-gallery-actions{
    display:grid;
    grid-template-columns:1fr auto;
    gap:8px;
    align-items:center;
    margin-top:8px;
  }

  .modal-gallery-actions input[type="url"]{
    width:100%;
  }

  .quality-close-btn{
    border:none;
    background:#f3f4f6;
    border-radius:999px;
    width:34px;
    height:34px;
    cursor:pointer;
    font-weight:900;
  }


  .description-editor-summary{
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .description-preview{
    min-height:32px;
    max-height:48px;
    overflow:hidden;
    border:1px solid #e5e7eb;
    background:#f9fafb;
    border-radius:9px;
    padding:7px 8px;
    font-size:11px;
    color:#374151;
    line-height:1.35;
  }
  .manage-description-btn{
    width:100% !important;
    padding:7px 8px !important;
    font-size:10.5px !important;
    border-radius:8px !important;
  }
  .quality-description-modal{
    width:min(860px,96vw);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    border:1px solid #e5e7eb;
    box-shadow:0 22px 80px rgba(0,0,0,.25);
  }
  .quality-description-modal-body{padding:16px;}
  .description-editor-field{margin-bottom:12px;}
  .description-editor-field label{font-weight:800;font-size:12px;display:block;margin-bottom:6px;}
  .description-toolbar{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
  .description-toolbar button{border:1px solid #d1d5db;background:#f9fafb;border-radius:8px;padding:7px 10px;font-weight:800;cursor:pointer;}
  .description-rich-editor{
    min-height:260px;
    border:1px solid #cbd5e1;
    border-radius:12px;
    padding:12px;
    background:#fff;
    line-height:1.6;
    outline:none;
    overflow:auto;
  }
  .description-rich-editor:focus{border-color:#2563eb;box-shadow:0 0 0 1px #2563eb;}
  .quality-image-suggest{
    position:fixed;
    z-index:2000;
    max-height:230px;
    overflow:auto;
    background:#fff;
    border:1px solid #cbd5e1;
    border-radius:10px;
    box-shadow:0 12px 30px rgba(0,0,0,.18);
    display:none;
  }
  .quality-image-suggest button{
    display:flex;
    width:100%;
    border:0;
    background:#fff;
    text-align:left;
    padding:8px 10px;
    font-size:12px;
    cursor:pointer;
    border-bottom:1px solid #f1f5f9;
  }
  .quality-image-suggest button:hover{background:#eff6ff;}

  @media (max-width:1200px){
    .quality-table-wrap .table{ min-width:1180px !important; }
    .quality-controls-grid{ grid-template-columns:1fr; }
  }


  .add-gallery-manager{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }

  .add-gallery-manager .gallery-count-badge{
    width:auto;
    min-width:130px;
  }

  .add-gallery-hidden-textarea{
    display:none !important;
  }

  .product-add-form{
    grid-template-columns:2fr 1fr 1fr 1fr !important;
    gap:10px !important;
  }

  .product-add-form .field-name{ grid-column:span 2; }
  .product-add-form .field-slug{ grid-column:span 2; }
  .product-add-form .field-image{ grid-column:span 2; }
  .product-add-form .field-category{ grid-column:span 2; }
  .product-add-form .field-small select,
  .product-add-form .field-small input{
    max-width:100%;
  }

  .slug-help{
    display:block;
    margin-top:4px;
    color:#6b7280;
    font-size:11px;
  }

  .prod-slug-input{
    font-family:monospace;
    color:#374151;
  }

  @media (max-width:900px){
    .product-add-form{ grid-template-columns:1fr !important; }
    .product-add-form .field-name,
    .product-add-form .field-slug,
    .product-add-form .field-image,
    .product-add-form .field-category{ grid-column:1 / -1; }
  }



  /* Variações V3 - visual, sem quebrar slug/galeria */
  .quality-variations-box{
    grid-column:1 / -1;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:14px;
    background:#fbfdff;
    margin-top:8px;
  }
  .quality-variations-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:12px;font-weight:900;}
  .quality-variations-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
  .quality-variations-box.variations-disabled .quality-variations-grid{display:none !important;}
  .variation-disabled-note{display:none;margin-top:10px;padding:10px 12px;border:1px dashed #cbd5e1;border-radius:10px;background:#f8fafc;color:#64748b;font-size:12px;}
  .quality-variations-box.variations-disabled .variation-disabled-note{display:block;}
  .quality-var-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:10px;min-height:120px;}
  .quality-var-card strong{display:block;margin-bottom:8px;}
  .quality-var-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
  .quality-var-actions .btn{padding:6px 8px !important;font-size:11px !important;}
  .quality-var-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;min-height:28px;}
  .quality-var-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #d1d5db;background:#f9fafb;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:700;}
  .quality-var-pill button{border:none;background:transparent;color:#991b1b;font-weight:900;cursor:pointer;padding:0;}
  .quality-var-dot{width:14px;height:14px;border-radius:50%;border:1px solid #cbd5e1;display:inline-block;background:#e5e7eb;}
  .variation-hidden-data{display:none !important;}
  .variation-summary{font-size:11px;color:#374151;line-height:1.4;margin-top:4px;}
  .manage-variations-btn{margin-top:6px;width:100% !important;font-size:10.5px !important;padding:7px 8px !important;}
  .quality-variation-modal{width:min(920px,96vw);max-height:88vh;overflow:auto;background:#fff;border-radius:16px;border:1px solid #e5e7eb;box-shadow:0 22px 80px rgba(0,0,0,.25);}
  .quality-variation-modal-body{padding:16px;}
  .variation-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .variation-form-row{display:grid;grid-template-columns:1fr 80px 1.3fr auto;gap:8px;align-items:end;}
  .variation-form-row input,.variation-form-row select{width:100% !important;min-height:38px !important;}
  .stock-input-small{max-width:120px !important;}
  .variation-simple-row{display:grid;grid-template-columns:1fr 1.2fr auto;gap:8px;align-items:end;}
  .variation-simple-row input,.variation-simple-row select{min-height:38px !important;}
  .variation-labels-box{grid-column:1 / -1;background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:10px;margin-bottom:10px;}
  .variation-labels-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
  .variation-labels-grid label{font-size:11px;font-weight:800;color:#374151;}
  .variation-labels-grid input{width:100% !important;min-height:36px !important;}
  .variation-help{display:block;margin-top:5px;color:#6b7280;font-size:11px;}
  .quality-combo-card{grid-column:1 / -1;background:#fff;border:1px solid #dbeafe !important;}
  .variation-combo-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1.2fr .7fr auto;gap:6px;align-items:end;}
  .quality-combo-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
  .quality-combo-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #bfdbfe;background:#eff6ff;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:800;}
  .quality-combo-pill button{border:none;background:transparent;color:#991b1b;cursor:pointer;font-weight:900;}

  @media (max-width:1000px){.quality-variations-grid,.variation-modal-grid{grid-template-columns:1fr;}.variation-form-row,.variation-simple-row,.variation-combo-row{grid-template-columns:1fr;}}


  /* V3.1 - tabela mais limpa: corrige largura após adicionar estoque e deixa tudo visível sem rolar para a direita */
  .quality-table-wrap{overflow-x:visible !important;}
  .quality-table-wrap .table{min-width:0 !important;width:100% !important;table-layout:fixed !important;}
  .quality-table-wrap .table th,
  .quality-table-wrap .table td{padding:6px !important;font-size:10.5px !important;}
  .quality-table-wrap .table th:nth-child(1), .quality-table-wrap .table td:nth-child(1){width:2.4% !important;}
  .quality-table-wrap .table th:nth-child(2), .quality-table-wrap .table td:nth-child(2){width:2.8% !important;}
  .quality-table-wrap .table th:nth-child(3), .quality-table-wrap .table td:nth-child(3){width:15.5% !important;}
  .quality-table-wrap .table th:nth-child(4), .quality-table-wrap .table td:nth-child(4){width:12.5% !important;}
  .quality-table-wrap .table th:nth-child(5), .quality-table-wrap .table td:nth-child(5){width:5% !important;}
  .quality-table-wrap .table th:nth-child(6), .quality-table-wrap .table td:nth-child(6){width:5% !important;}
  .quality-table-wrap .table th:nth-child(7), .quality-table-wrap .table td:nth-child(7){width:5.5% !important;}
  .quality-table-wrap .table th:nth-child(8), .quality-table-wrap .table td:nth-child(8){width:4.8% !important;}
  .quality-table-wrap .table th:nth-child(9), .quality-table-wrap .table td:nth-child(9){width:4.8% !important;}
  .quality-table-wrap .table th:nth-child(10), .quality-table-wrap .table td:nth-child(10){width:4.8% !important;}
  .quality-table-wrap .table th:nth-child(11), .quality-table-wrap .table td:nth-child(11){width:7% !important;}
  .quality-table-wrap .table th:nth-child(12), .quality-table-wrap .table td:nth-child(12){width:8.5% !important;}
  .quality-table-wrap .table th:nth-child(13), .quality-table-wrap .table td:nth-child(13){width:6.5% !important;}
  .quality-table-wrap .table th:nth-child(14), .quality-table-wrap .table td:nth-child(14){width:7% !important;}
  .quality-table-wrap .table th:nth-child(15), .quality-table-wrap .table td:nth-child(15){width:8.4% !important;}
  .quality-table-wrap select,
  .quality-table-wrap input,
  .quality-table-wrap textarea{font-size:10.5px !important;padding:6px 7px !important;}
  .quality-table-wrap select[name="detailsEnabled"]{max-width:100% !important;}
  .description-preview{max-height:34px !important;min-height:30px !important;overflow:hidden !important;}
  .manage-description-btn,.manage-gallery-btn,.manage-variations-btn,.quality-actions .btn{padding:6px 7px !important;font-size:10px !important;}
  .variation-summary{max-height:34px;overflow:hidden;font-size:10.5px !important;}
  .row-save-status{font-size:10px !important;white-space:normal !important;}
  @media (max-width:1200px){.quality-table-wrap{overflow-x:auto !important;}.quality-table-wrap .table{min-width:1120px !important;}}

  .add-description-editor-wrap{grid-column:1 / -1;border:1px solid #e5e7eb;border-radius:12px;background:#fafafa;padding:12px;}
  .add-description-editor-wrap .description-rich-editor{background:#fff;min-height:150px;}
  .add-description-editor-wrap .description-toolbar button{font-size:12px;}



  /* V7.4.2 - Refinamento visual da tabela de produtos */
  .quality-table-wrap{overflow-x:visible !important;background:#fff;border:1px solid #eef2f7;border-radius:16px;}
  .quality-products-summary-table{width:100% !important;min-width:0 !important;table-layout:fixed !important;border-collapse:separate !important;border-spacing:0;}
  .quality-products-summary-table th{padding:14px 10px !important;font-size:11px !important;color:#0f172a;font-weight:900;border-bottom:1px solid #e5e7eb;background:#fff;}
  .quality-products-summary-table td{padding:16px 10px !important;font-size:12px !important;vertical-align:middle !important;border-bottom:1px solid #e5e7eb;background:#fff;}
  .quality-products-summary-table tr:hover td{background:#fcfdff;}
  .quality-products-summary-table th:nth-child(1),.quality-products-summary-table td:nth-child(1){width:3.2% !important;text-align:center;}
  .quality-products-summary-table th:nth-child(2),.quality-products-summary-table td:nth-child(2){width:4% !important;text-align:center;}
  .quality-products-summary-table th:nth-child(3),.quality-products-summary-table td:nth-child(3){width:34% !important;}
  .quality-products-summary-table th:nth-child(4),.quality-products-summary-table td:nth-child(4){width:17% !important;}
  .quality-products-summary-table th:nth-child(5),.quality-products-summary-table td:nth-child(5){width:13% !important;}
  .quality-products-summary-table th:nth-child(6),.quality-products-summary-table td:nth-child(6){width:18% !important;}
  .quality-products-summary-table th:nth-child(7),.quality-products-summary-table td:nth-child(7){width:10.8% !important;}

  .quality-product-cell{display:grid;grid-template-columns:68px 1fr;gap:14px;align-items:center;min-width:0;}
  .quality-product-thumb{width:62px;height:62px;border:1px solid #e5e7eb;border-radius:14px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,.04);}
  .quality-product-thumb img{width:100%;height:100%;object-fit:contain;}
  .quality-product-main{display:flex;flex-direction:column;gap:7px;min-width:0;}
  .quality-product-main .prod-name-input{font-weight:900;font-size:14px !important;color:#0f172a;}
  .quality-product-meta{display:grid;grid-template-columns:1fr .68fr;gap:7px;}
  .quality-product-meta input{font-size:11px !important;color:#475569;}

  .quality-products-summary-table input,
  .quality-products-summary-table select{font-size:12px !important;padding:9px 10px !important;border-radius:11px !important;border:1px solid #dbe3ef !important;background:#fff !important;min-height:39px;}
  .quality-category-stock{display:flex;flex-direction:column;gap:9px;max-width:230px;}
  .quality-category-stock select{width:100% !important;}
  .quality-stock-box{display:grid;grid-template-columns:1fr;gap:5px;}
  .quality-stock-label{font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:#64748b;font-weight:900;}
