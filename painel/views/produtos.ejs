  let activeDescriptionRow = null;

  function stripTagsForPreview(html){
    const div = document.createElement("div");
    div.innerHTML = html || "";
    return (div.textContent || div.innerText || "").trim();
  }

  function sanitizeDescriptionHtml(html){
    const allowed = ["B","STRONG","I","EM","BR","P","DIV","UL","OL","LI","H3","H4"];
    const tpl = document.createElement("template");
    tpl.innerHTML = html || "";
    tpl.content.querySelectorAll("*").forEach(el => {
      if (!allowed.includes(el.tagName)) {
        el.replaceWith(document.createTextNode(el.textContent || ""));
        return;
      }
      Array.from(el.attributes).forEach(attr => el.removeAttribute(attr.name));
    });
    return tpl.innerHTML.trim();
  }



  const addProductFormEl = document.getElementById("add-product-form");
  const addDescHidden = document.getElementById("add-description-long-hidden");
  const addDescEditor = document.getElementById("add-description-long-editor");

