  .quality-inventory-config{grid-column:1/-1;border:1px solid #dbeafe;background:#f8fbff;border-radius:12px;padding:13px;margin-top:4px}
  .quality-inventory-config-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px}
  .quality-inventory-config label{font-size:11px;font-weight:800;color:#374151;display:flex;flex-direction:column;gap:5px}
  .quality-inventory-config .inventory-check{flex-direction:row;align-items:center;border:1px solid #e5e7eb;background:#fff;border-radius:10px;padding:10px}
  .quality-inventory-config .inventory-check input{width:auto!important;min-height:auto!important}
  .quality-inventory-help{display:block;margin-top:8px;color:#64748b;font-size:11px}
  html[data-panel-theme="oled"] .quality-inventory-config{background:#090909;border-color:#2b2b2b;color:#f5f5f5}
  html[data-panel-theme="oled"] .quality-inventory-config>strong{color:#f5f5f5}
  html[data-panel-theme="oled"] .quality-inventory-config label{color:#d4d4d4}
  html[data-panel-theme="oled"] .quality-inventory-config .inventory-check{background:#101010;border-color:#303030;color:#e5e5e5}
  html[data-panel-theme="oled"] .quality-inventory-config input,html[data-panel-theme="oled"] .quality-inventory-config select{background:#101010!important;color:#f5f5f5!important;border-color:#343434!important}
  html[data-panel-theme="oled"] .quality-inventory-config input::placeholder{color:#737373}
  html[data-panel-theme="oled"] .quality-inventory-help{color:#8f8f8f}
  @media(max-width:800px){.quality-inventory-config-grid{grid-template-columns:1fr}}


  .quality-list-erp-category{display:flex;flex-direction:column;gap:2px;padding:7px 9px;border:1px solid #dbeafe;background:#f8fbff;border-radius:9px}.quality-list-erp-category small{font-size:9px;text-transform:uppercase;color:#64748b;font-weight:800}.quality-list-erp-category strong{font-size:11px;color:#0f172a}html[data-panel-theme="oled"] .quality-list-erp-category{background:#090909;border-color:#2c2c2c}html[data-panel-theme="oled"] .quality-list-erp-category strong{color:#f5f5f5}
  .quality-erp-stock-card{display:flex;flex-direction:column;gap:8px;padding:9px;border:1px solid #dbeafe;background:#f8fbff;border-radius:11px}.quality-erp-stock-card .quality-list-erp-category{padding:0;border:0;background:transparent}.quality-erp-type{font-size:10px;color:#64748b;font-weight:700}.quality-stock-compact{display:flex;align-items:center;justify-content:space-between;gap:7px;padding-top:7px;border-top:1px solid #dbeafe}.quality-stock-compact input{width:72px!important;min-height:32px!important;padding:6px 8px!important}.quality-lv-category-card{display:flex;flex-direction:column;gap:3px;padding:8px 9px;border:1px solid #d1fae5;background:#f0fdf4;border-radius:10px;text-align:left;margin-bottom:7px}.quality-lv-category-card small{font-size:9px;text-transform:uppercase;letter-spacing:.03em;color:#047857;font-weight:900}.quality-lv-category-card strong{font-size:11px;color:#064e3b}.quality-lv-category-card span{font-size:10px;color:#4b5563}.quality-lv-inactive-badge{display:inline-flex;align-items:center;justify-content:center;gap:5px;padding:7px 9px;border:1px dashed #cbd5e1;background:#f8fafc;color:#64748b;border-radius:9px;font-size:10px;font-weight:800;margin-bottom:7px}.quality-lv-controls-disabled{opacity:.58}.quality-lv-category-card{display:flex}.quality-lv-inactive-badge{display:none}.quality-lv-controls-disabled .quality-lv-category-card{display:none}.quality-lv-controls-disabled .quality-lv-inactive-badge{display:inline-flex}.quality-lv-controls-disabled .quality-compact-field:not(.quality-lv-status-field){display:none}.quality-lv-controls-disabled .quality-channel-help{display:none}html[data-panel-theme="oled"] .quality-erp-stock-card{background:#090909;border-color:#292929}html[data-panel-theme="oled"] .quality-stock-compact{border-color:#292929}html[data-panel-theme="oled"] .quality-lv-category-card{background:#07140d;border-color:#14532d}html[data-panel-theme="oled"] .quality-lv-category-card small{color:#6ee7b7}html[data-panel-theme="oled"] .quality-lv-category-card strong{color:#d1fae5}html[data-panel-theme="oled"] .quality-lv-category-card span{color:#9ca3af}html[data-panel-theme="oled"] .quality-lv-inactive-badge{background:#090909;border-color:#343434;color:#a3a3a3}
  /* Layout moderno e compacto da página Produtos */
  .quality-panel-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:14px;
  }

  .quality-compact-gallery textarea{
    min-height:52px !important;
    max-height:70px !important;
  }

  .quality-controls-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:12px;
    margin:22px 0 14px 0;
  }

  .quality-control-box{
    background:#fafafa;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:12px;
  }

  .quality-control-title{
    display:flex;
    align-items:center;
    gap:6px;
    font-weight:800;
    margin-bottom:10px;
  }

  .quality-search-row,
  .quality-bulk-row{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
  }

  .quality-search-row input{ flex:1 1 320px; }
  .quality-search-row select{ flex:0 0 220px; }

  .quality-bulk-box{
    display:flex !important;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    background:transparent !important;
    border:none !important;
    padding:0 !important;
    margin:0 !important;
  }

  .quality-bulk-box form{
    display:flex !important;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    margin:0 !important;
  }

  .quality-bulk-box select{
    width:auto !important;
    min-width:220px !important;
    max-width:100% !important;
  }

  .quality-bulk-box .btn,
  .quality-control-box .btn{
    padding:8px 10px !important;
    font-size:12px !important;
    border-radius:9px !important;
  }


  .quality-bulk-center{display:flex;flex-direction:column;gap:12px;}
  .quality-bulk-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
  .quality-bulk-selection-actions{display:flex;gap:7px;flex-wrap:wrap;}
  .quality-bulk-actions-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;}
  .quality-bulk-action{border:1px solid #e5e7eb;background:#fff;border-radius:11px;padding:9px;display:flex;flex-direction:column;gap:7px;}
  .quality-bulk-action-head{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:900;color:#0f172a;cursor:pointer;}
  .quality-bulk-action-head input{width:auto !important;margin:0;}
  .quality-bulk-action-field{display:none;}
  .quality-bulk-action.enabled .quality-bulk-action-field{display:block;}
  .quality-bulk-action-field select,.quality-bulk-action-field input{width:100% !important;min-width:0 !important;}
  .quality-bulk-field-help{display:block;margin-top:5px;color:#64748b;font-size:10.5px;line-height:1.35;font-weight:700;}
  .quality-bulk-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding-top:2px;}
  .quality-bulk-summary{font-size:11px;color:#64748b;font-weight:700;}
  .quality-bulk-apply{min-width:190px;}
  @media(max-width:800px){.quality-bulk-actions-grid{grid-template-columns:1fr}.quality-bulk-apply{width:100%}}

  .quality-table-toolbar{
    display:flex;
    justify-content:flex-end;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    margin:12px 0;
  }
  .quality-table-toolbar .quality-channel-help{max-width:270px;text-align:left}

  .quality-table-wrap{
    width:100%;
    overflow-x:auto;
    padding-bottom:10px;
  }

  .quality-table-wrap .table{
    width:100% !important;
    min-width:0 !important;
    table-layout:fixed !important;
    border-collapse:collapse;
  }
  .quality-products-summary-table th,.quality-products-summary-table td{vertical-align:middle;padding:9px 8px}
  .quality-products-summary-table th:nth-child(1),.quality-products-summary-table td:nth-child(1){width:38px;text-align:center}
  .quality-products-summary-table th:nth-child(2),.quality-products-summary-table td:nth-child(2){width:46px;text-align:center}
  .quality-products-summary-table th:nth-child(5),.quality-products-summary-table td:nth-child(5),
  .quality-products-summary-table th:nth-child(6),.quality-products-summary-table td:nth-child(6){width:118px;text-align:center}
  .quality-products-summary-table th:nth-child(7),.quality-products-summary-table td:nth-child(7){width:150px}
  .quality-products-summary-table th:nth-child(8),.quality-products-summary-table td:nth-child(8){width:132px;text-align:center}
  .quality-products-summary-table .btn{margin:2px 0}
  .quality-product-cell,.quality-row-actions{min-width:0}
  .quality-product-cell input,.quality-product-cell select{max-width:100%}
  html[data-panel-theme="light"] .quality-table-wrap{scrollbar-color:#b8c2d1 #eef2f7}
  html[data-panel-theme="oled"] .quality-table-wrap{scrollbar-color:#404040 #111}
  @media(max-width:1100px){
    .quality-products-summary-table{min-width:980px !important;table-layout:auto !important}
    .quality-table-wrap{border-radius:12px}
    .quality-products-summary-table th,.quality-products-summary-table td{padding:8px 7px}
    .quality-products-summary-table th:nth-child(3),.quality-products-summary-table td:nth-child(3){min-width:250px}
    .quality-products-summary-table th:nth-child(4),.quality-products-summary-table td:nth-child(4){min-width:190px}
  }
  @media(max-width:700px){
    .quality-bulk-head,.quality-bulk-footer{align-items:stretch}
    .quality-bulk-selection-actions{width:100%}
    .quality-bulk-selection-actions .btn{flex:1 1 140px}
    .quality-filter-counter{min-height:38px}
    .quality-table-wrap{margin-left:-4px;margin-right:-4px;width:calc(100% + 8px)}
  }

  .quality-table-wrap .table th,
  .quality-table-wrap .table td{
    min-width:0 !important;
    max-width:none !important;
    padding:7px !important;
    font-size:11px !important;
    vertical-align:top;
  }

  .quality-table-wrap .table th:nth-child(1),
  .quality-table-wrap .table td:nth-child(1){ width:2.2%; }
  .quality-table-wrap .table th:nth-child(2),
  .quality-table-wrap .table td:nth-child(2){ width:2.8%; }
  .quality-table-wrap .table th:nth-child(3),
  .quality-table-wrap .table td:nth-child(3){ width:15%; }
  .quality-table-wrap .table th:nth-child(4),
  .quality-table-wrap .table td:nth-child(4){ width:12%; }
  .quality-table-wrap .table th:nth-child(5),
  .quality-table-wrap .table td:nth-child(5){ width:5%; }
  .quality-table-wrap .table th:nth-child(6),
  .quality-table-wrap .table td:nth-child(6){ width:6%; }
  .quality-table-wrap .table th:nth-child(7),
  .quality-table-wrap .table td:nth-child(7){ width:5%; }
  .quality-table-wrap .table th:nth-child(8),
  .quality-table-wrap .table td:nth-child(8){ width:5%; }
  .quality-table-wrap .table th:nth-child(9),
  .quality-table-wrap .table td:nth-child(9){ width:5%; }
  .quality-table-wrap .table th:nth-child(10),
  .quality-table-wrap .table td:nth-child(10){ width:6%; }
  .quality-table-wrap .table th:nth-child(11),
  .quality-table-wrap .table td:nth-child(11){ width:15%; }
  .quality-table-wrap .table th:nth-child(12),
  .quality-table-wrap .table td:nth-child(12){ width:7%; }
  .quality-table-wrap .table th:nth-child(13),
  .quality-table-wrap .table td:nth-child(13){ width:8%; }
  .quality-table-wrap .table th:nth-child(14),
  .quality-table-wrap .table td:nth-child(14){ width:8%; }

  .quality-table-wrap input,
  .quality-table-wrap select,
  .quality-table-wrap textarea{
    width:100% !important;
    min-width:0 !important;
    max-width:100% !important;
    font-size:11px !important;
    padding:7px 8px !important;
  }

  .quality-table-wrap textarea{
    min-height:44px !important;
    max-height:62px !important;
  }

  .quality-table-wrap th:last-child,
  .quality-table-wrap td:last-child{
    position:static !important;
    right:auto !important;
    box-shadow:none !important;
    z-index:auto !important;
  }

  .quality-gallery-cell,
  .quality-actions{
    min-width:0 !important;
    max-width:none !important;
  }

  .gallery-hidden-textarea{
    display:none !important;
  }

  .gallery-summary{
    display:flex;
    flex-direction:column;
    gap:5px;
  }

  .gallery-count-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:100%;
    border:1px solid #e5e7eb;
    background:#f9fafb;
    color:#374151;
    border-radius:999px;
    padding:5px 7px;
    font-weight:800;
    font-size:11px;
  }

  .manage-gallery-btn,
  .quality-actions .btn{
    display:block;
    width:100% !important;
    padding:7px 8px !important;
    font-size:10.5px !important;
    border-radius:8px !important;
    margin-bottom:5px;
  }

  .row-save-status{
    display:block !important;
    margin:2px 0 5px 0 !important;
    font-size:11px !important;
  }

  .quality-modal-backdrop{
    position:fixed;
    inset:0;
    background:rgba(17,24,39,.55);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:999;
    padding:18px;
  }

  .quality-modal-backdrop.open{
    display:flex;
  }

  .quality-gallery-modal{
    width:min(680px, 96vw);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    border:1px solid #e5e7eb;
    box-shadow:0 22px 80px rgba(0,0,0,.25);
  }

  .quality-gallery-modal-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:14px 16px;
    border-bottom:1px solid #e5e7eb;
  }

  .quality-gallery-modal-header strong{
    font-size:15px;
  }

  .quality-gallery-modal-body{
    padding:16px;
  }

  .modal-gallery-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-bottom:14px;
  }

  .modal-gallery-item{
    display:grid;
    grid-template-columns:58px 1fr auto;
    align-items:center;
    gap:10px;
    background:#f9fafb;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:8px;
  }

  .modal-gallery-thumb{
    width:54px;
    height:54px;
    border-radius:10px;
    border:1px solid #e5e7eb;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    font-size:22px;
  }

  .modal-gallery-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
  }

  .modal-gallery-name{
    font-size:12px;
    color:#374151;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .modal-gallery-empty{
    color:#6b7280;
    font-size:13px;
    background:#f9fafb;
    border:1px dashed #d1d5db;
    border-radius:12px;
    padding:14px;
    margin-bottom:14px;
  }

  .modal-gallery-actions{
    display:grid;
    grid-template-columns:1fr auto;
    gap:8px;
    align-items:center;
    margin-top:8px;
  }

  .modal-gallery-actions input[type="url"]{
    width:100%;
  }

  .quality-close-btn{
    border:none;
    background:#f3f4f6;
    border-radius:999px;
    width:34px;
    height:34px;
    cursor:pointer;
    font-weight:900;
  }


  .description-editor-summary{
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .description-preview{
    min-height:32px;
    max-height:48px;
    overflow:hidden;
    border:1px solid #e5e7eb;
    background:#f9fafb;
    border-radius:9px;
    padding:7px 8px;
    font-size:11px;
    color:#374151;
    line-height:1.35;
  }
  .manage-description-btn{
    width:100% !important;
    padding:7px 8px !important;
    font-size:10.5px !important;
    border-radius:8px !important;
  }
  .quality-description-modal{
    width:min(860px,96vw);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    border:1px solid #e5e7eb;
    box-shadow:0 22px 80px rgba(0,0,0,.25);
  }
  .quality-description-modal-body{padding:16px;}
  .description-editor-field{margin-bottom:12px;}
  .description-editor-field label{font-weight:800;font-size:12px;display:block;margin-bottom:6px;}
  .description-toolbar{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
  .description-toolbar button{border:1px solid #d1d5db;background:#f9fafb;border-radius:8px;padding:7px 10px;font-weight:800;cursor:pointer;}
  .description-rich-editor{
    min-height:260px;
    border:1px solid #cbd5e1;
    border-radius:12px;
    padding:12px;
    background:#fff;
    line-height:1.6;
    outline:none;
    overflow:auto;
  }
  .description-rich-editor:focus{border-color:#2563eb;box-shadow:0 0 0 1px #2563eb;}
  .quality-image-suggest{
    position:fixed;
    z-index:2000;
    max-height:230px;
    overflow:auto;
    background:#fff;
    border:1px solid #cbd5e1;
    border-radius:10px;
    box-shadow:0 12px 30px rgba(0,0,0,.18);
    display:none;
  }
  .quality-image-suggest button{
    display:flex;
    width:100%;
    border:0;
    background:#fff;
    text-align:left;
    padding:8px 10px;
    font-size:12px;
    cursor:pointer;
    border-bottom:1px solid #f1f5f9;
  }
  .quality-image-suggest button:hover{background:#eff6ff;}

  @media (max-width:1200px){
    .quality-table-wrap .table{ min-width:1180px !important; }
    .quality-controls-grid{ grid-template-columns:1fr; }
  }


  .add-gallery-manager{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }

  .add-gallery-manager .gallery-count-badge{
    width:auto;
    min-width:130px;
  }

  .add-gallery-hidden-textarea{
    display:none !important;
  }

  .product-add-form{
    grid-template-columns:2fr 1fr 1fr 1fr !important;
    gap:10px !important;
  }

  .product-add-form .field-name{ grid-column:span 2; }
  .product-add-form .field-slug{ grid-column:span 2; }
  .product-add-form .field-image{ grid-column:span 2; }
  .product-add-form .field-category{ grid-column:span 2; }
  .product-add-form .field-small select,
  .product-add-form .field-small input{
    max-width:100%;
  }

  .slug-help{
    display:block;
    margin-top:4px;
    color:#6b7280;
    font-size:11px;
  }


  .quality-ai-fill-box{
    margin:18px 0 16px;
    border:1px solid #bfdbfe;
    background:linear-gradient(135deg,#eff6ff,#ffffff);
    border-radius:16px;
    padding:14px;
    box-shadow:0 8px 24px rgba(37,99,235,.06);
  }
  .quality-ai-fill-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:10px;
  }
  .quality-ai-fill-title strong{font-size:15px;color:#0f172a;}
  .quality-ai-fill-title small{color:#64748b;font-weight:700;}
  .quality-ai-fill-row{display:grid;grid-template-columns:1fr;gap:8px;align-items:start;}
