  .quality-bulk-toggle-icon{display:inline-flex;min-width:24px;justify-content:center}
  .quality-bulk-center:not(.is-expanded) .quality-bulk-collapsible{display:none!important}
  .quality-bulk-center:not(.is-expanded){gap:0}
  [data-create-lv-dependent][hidden]{display:none!important}

</style>


  <!-- Mensagens AJAX da própria tela. O flash do redirect é exibido uma única
       vez pelo layout global, evitando os dois avisos simultâneos. -->
  <div id="flash-message" style="display:none; margin: 10px 0 18px 0; padding: 12px 14px; border-radius: 6px; background: #e8f7ee; border: 1px solid #b8e6c8; color: #087a31; font-weight: 600;"></div>

  <%
    const totalProdutos = (items || []).length;
    const ativosProdutos = (items || []).filter(p => p.active !== false).length;
    const inativosProdutos = totalProdutos - ativosProdutos;
    const vitrineProdutos = (items || []).filter(p => p.featured === true).length;
    const variacaoProdutos = (items || []).filter(p => p.variations && p.variations.enabled).length;
    const estoqueTotalProdutos = (items || []).reduce((sum, p) => sum + (Number(p.stock) || 0), 0);
  %>
  <% if (!isNewWorkspace) { %>
  <div class="quality-indicators-grid" id="product-summary-indicators">
    <div class="quality-indicator-card"><span>📦 Produtos</span><strong><%= totalProdutos %></strong></div>
    <div class="quality-indicator-card"><span>🟢 Ativos</span><strong><%= ativosProdutos %></strong></div>
    <div class="quality-indicator-card"><span>🔴 Inativos</span><strong><%= inativosProdutos %></strong></div>
    <div class="quality-indicator-card"><span>⭐ Vitrine</span><strong><%= vitrineProdutos %></strong></div>
    <div class="quality-indicator-card"><span>🎨 Variações</span><strong><%= variacaoProdutos %></strong></div>
    <div class="quality-indicator-card"><span>📦 Estoque total</span><strong id="quality-stock-total-indicator"><%= estoqueTotalProdutos %></strong></div>
  </div>
  <% } %>

  <div class="product-workspace-toolbar">
    <div class="product-workspace-toolbar-left">
      <a class="btn <%= isNewWorkspace ? '' : 'active' %>" href="/produtos">📋 Produtos cadastrados</a>
      <a class="btn primary <%= isNewWorkspace ? 'active' : '' %> js-new-product-choice" href="/produtos?workspace=new">＋ Novo produto</a>
    </div>
    <div class="product-workspace-toolbar-right">
      <a class="btn" href="/produtos/importar-wm10">⇩ Migração WM10</a>
      <a class="btn" href="/erp">← Voltar ao ERP</a>
    </div>
  </div>

  <div class="product-kind-dialog" id="product-kind-dialog" aria-hidden="true">
    <div class="product-kind-card" role="dialog" aria-modal="true" aria-labelledby="product-kind-title">
      <h3 id="product-kind-title">O que você vai cadastrar?</h3>
      <p>Escolha o tipo para o Quality preparar o cadastro correto.</p>
      <div class="product-kind-options">
        <button type="button" class="product-kind-option" data-product-kind="product">📦 Produto<small>Mercadoria, peça, acessório ou item com estoque.</small></button>
        <button type="button" class="product-kind-option" data-product-kind="service">🧰 Serviço<small>Abre o cadastro já direcionado para uma categoria de Serviço.</small></button>
      </div>
      <button type="button" class="btn product-kind-cancel" id="product-kind-cancel">Cancelar</button>
    </div>
  </div>
  <input type="file" id="quick-main-image-file" accept="image/*" hidden>

  <section class="product-workspace-section new-product-workspace <%= isNewWorkspace ? 'active' : '' %>" id="product-workspace-new">
    <div class="new-product-heading">
      <div><h2><%= requestedWorkspaceType === 'service' ? '＋ Novo serviço' : '＋ Novo produto' %></h2><p>Preencha por etapas. Os campos continuam salvando no cadastro atual com segurança.</p></div>
      <a class="btn" href="/produtos">← Voltar à lista</a>
    </div>
    <div class="product-create-tabs" id="product-create-tabs">
      <button type="button" class="product-create-tab active" data-create-tab="general">🏢 ERP</button>
      <button type="button" class="product-create-tab" data-create-tab="commercial">💰 Comercial</button>
      <button type="button" class="product-create-tab" data-create-tab="stock">📚 Estoque</button>
      <button type="button" class="product-create-tab" data-create-tab="site">🌐 Loja Virtual</button>
      <button type="button" class="product-create-tab" data-create-tab="variations" id="create-variations-tab" <%= requestedWorkspaceType === 'service' ? 'hidden' : '' %>>🎛️ Variações</button>
    </div>
  <div class="quality-ai-fill-box" id="quality-ai-fill-box">
    <div class="quality-ai-fill-title">
      <strong>✨ Cadastro inteligente com IA</strong>
      <small>Digite o modelo, revise os campos e salve normalmente.</small>
    </div>
    <div class="quality-ai-fill-row">
      <input type="text" id="ai-product-query" placeholder="Ex.: Samsung Galaxy A36 5G 256GB">
      <div class="quality-ai-fill-action">
        <button class="btn" type="button" id="ai-fill-product-btn">✨ Preencher cadastro</button>
        <span class="quality-ai-fill-help">Digite o modelo, revise os campos e salve normalmente.</span>
      </div>
    </div>
    <div class="quality-ai-fill-status" id="ai-fill-product-status"></div>
  </div>

  <form method="post" action="/produtos/add" class="row product-add-form" id="add-product-form">
    <div class="field-name">
      <label>Nome interno ERP</label>
      <input type="text" name="erpName" id="add-product-name" placeholder="Ex.: IPHONE 15 128GB PRETO">
    </div>

    <div class="field-slug" data-create-section="site" data-create-lv-dependent>
      <label>Nome da Loja Virtual (Nome LV)</label>
      <input type="text" name="lvName" id="add-product-lv-name" placeholder="Ex.: Apple iPhone 15 128GB">
      <small class="slug-help">Pode ser mais comercial que o nome interno usado no ERP.</small>
    </div>

    <div class="field-slug" data-create-section="site" data-create-lv-dependent>
      <label>Slug / URL amigável</label>
      <input type="text" name="slug" id="add-product-slug" placeholder="iphone-15-128gb">
      <small class="slug-help">Preenche automático pelo nome e pode ser ajustado para SEO.</small>
    </div>

    <div class="field-small" data-create-section="site" data-create-lv-dependent>
      <label>Preço Loja Virtual</label>
      <input type="number" name="lvPrice" step="0.01" min="0" placeholder="opcional">
    </div>

    <div class="field-small" data-create-section="stock">
      <label>Estoque</label>
      <input type="number" name="stock" step="1" min="0" placeholder="opcional">
    </div>

    <div class="quality-master-area" data-create-section="general">
      <div class="quality-master-area-title"><strong>🏢 Dados ERP</strong><small>Base simples para compras, estoque, PDV e relatórios.</small></div>
      <% if (requestedWorkspaceType === 'service' && !defaultServiceCategory) { %><div class="quality-service-note" style="display:block">⚠️ Nenhuma Categoria ERP ativa do tipo Serviço foi encontrada. Cadastre/ative uma categoria de Serviço antes de salvar.</div><% } %>
      <div class="quality-master-grid">
        <label>Apelido de busca<input type="text" name="searchAlias" placeholder="Ex.: Película Note 13 Pro"></label>
        <label>SKU<input type="text" name="sku" placeholder="SKU interno"></label>
        <label>Código de barras<input type="text" name="barcode" inputmode="numeric"></label>
        <label>Marca<input type="text" name="brand"></label>
        <label>Categoria ERP
          <select name="erpCategory" required>
            <option value="">Selecione uma categoria...</option>
            <% (erpCategorias || []).filter(c => c.active !== false).forEach(c => { %><option value="<%= c.id %>" data-category-type="<%= c.type || 'product' %>" <%= requestedWorkspaceType === 'service' && defaultServiceCategory && String(defaultServiceCategory.id) === String(c.id) ? 'selected' : '' %>><%= '— '.repeat(c.depth || 0) %><%= c.name %></option><% }) %>
          </select>
        </label>
<div class="quality-category-separation-note"><strong>Categoria interna</strong><small>Não altera SEO, URL ou navegação da Loja Virtual.</small></div>
        <label class="inventory-check"><input type="checkbox" name="erpActive" value="true" checked> <%= requestedWorkspaceType === 'service' ? 'Serviço ativo no ERP' : 'Produto ativo no ERP' %></label>
      </div>
      <details class="quality-master-extra">
        <summary>＋ Dados internos adicionais</summary>
        <div class="quality-master-grid">
          <label>Código interno<input type="text" name="internalCode" value="Gerado automaticamente ao salvar" readonly></label>
          <label>Código do fornecedor<input type="text" name="supplierCode"></label>
          <label>Unidade<select name="unit"><option value="UN" <%= requestedWorkspaceType !== 'service' ? 'selected' : '' %>>UN - Unidade</option><option value="CX">CX - Caixa</option><option value="PC">PC - Peça</option><option value="KIT">KIT</option><option value="SER" <%= requestedWorkspaceType === 'service' ? 'selected' : '' %>>SER - Serviço</option></select></label>
          <label>Fornecedor principal<input type="text" name="mainSupplierId" placeholder="Preparado para vínculo futuro"></label>
          <label>Fornecedor preferencial<input type="text" name="preferredSupplierId" placeholder="Preparado para vínculo futuro"></label>
        </div>
      </details>
    </div>

    <div class="quality-inventory-config" data-create-section="stock" id="add-inventory-config">
      <strong>📦 Controle de estoque ERP</strong>
      <div class="quality-service-note">🧰 Esta categoria é do tipo Serviço. O controle de estoque não se aplica.</div>
      <div class="quality-inventory-config-grid">
        <label class="inventory-check"><input type="checkbox" name="stockControlled" value="true" <%= requestedWorkspaceType === 'service' ? '' : 'checked' %>> Controlar estoque deste <%= requestedWorkspaceType === 'service' ? 'serviço' : 'produto' %></label>
        <label class="inventory-check"><input type="checkbox" name="allowNegative" value="true"> Permitir vender com estoque zerado/negativo</label>
        <label>Estoque mínimo<input type="number" name="minimumQuantity" min="0" step="1" value="0"></label>
        <label>Disponibilidade no site<select name="inventorySiteMode"><option value="shared" <%= requestedWorkspaceType !== 'service' ? 'selected' : '' %>>Compartilhar saldo</option><option value="limited">Limitar quantidade</option><option value="disabled" <%= requestedWorkspaceType === 'service' ? 'selected' : '' %>>Não disponibilizar</option></select></label>
        <label>Limite do site<input type="number" name="siteLimit" min="0" step="1" placeholder="Opcional"></label>
        <label>Reserva física da loja<input type="number" name="physicalSafety" min="0" step="1" value="0"></label>
      </div>
      <small class="quality-inventory-help">Nesta entrega, quantidade, controle, estoque mínimo e histórico já são gravados. As regras automáticas de venda pelo site serão conectadas em uma etapa futura.</small>
    </div>

    <div class="field-image" data-create-lv-dependent>
      <label>Imagem</label>
      <input type="text" name="image" id="add-product-image" list="imagens-list" placeholder="Selecione ou digite o nome..." onfocus="sincronizarImagensAuto()" autocomplete="off">
      <datalist id="imagens-list">
        <% (imagens || []).forEach(img => { %>
          <option value="images/<%= img %>"><%= img %></option>
        <% }) %>
      </datalist>
    </div>

    <div class="field-category" data-site-category-field data-create-section="site" data-create-lv-dependent>
      <label>Categoria Loja Virtual</label>
      <select name="siteCategory" class="js-category-select" data-subcategory-target="add-product-subcategory">
        <option value="">Sem categoria</option>
        <% (categorias || []).forEach(c => { %>
          <option value="<%= c.slug %>" <%= listState?.category === c.slug ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field-category" data-site-category-field data-create-section="site" data-create-lv-dependent>
      <label>Subcategoria Loja Virtual</label>
      <select name="siteSubcategory" id="add-product-subcategory" class="js-subcategory-select">
        <option value="">Selecione primeiro uma categoria...</option>
      </select>
    </div>

    <div class="field-small" data-create-section="site" data-create-lv-dependent>
      <label>Mostrar preço</label>
      <select name="showPrice">
        <option value="true" selected>Sim</option>
        <option value="false">Não</option>
      </select>
    </div>

    <div class="field-small" data-create-section="site" data-create-lv-dependent>
      <label>Mostrar na vitrine</label>
      <select name="featured">
        <option value="true">Sim</option>
        <option value="false" selected>Não</option>
      </select>
    </div>

    <div class="field-small" data-create-section="site">
      <label>Produto publicado na Loja Virtual</label>
      <select name="lvActive" id="add-lv-active">
        <option value="true">Ativo</option>
        <option value="false" selected>Inativo</option>
      </select>
      <small class="slug-help">A alteração entra no site somente ao usar o botão Publicar.</small>
    </div>

    <div class="field-small" data-create-section="site" data-create-lv-dependent>
      <label>Ver detalhes</label>
      <select name="detailsEnabled">
        <option value="false" selected>Não</option>
        <option value="true">Sim</option>
      </select>
    </div>

    <div class="quality-compact-gallery" data-create-lv-dependent style="grid-column: 1 / -1; border:1px solid #e5e7eb; border-radius:8px; padding:10px; background:#fafafa;">
      <label>Galeria do produto <small style="font-weight:400;color:#6b7280;">(máx. 4 itens: fotos ou vídeo do YouTube)</small></label>
      <textarea name="gallery" id="add-product-gallery" class="add-gallery-hidden-textarea"></textarea>
      <div class="add-gallery-manager">
        <span class="gallery-count-badge" id="add-gallery-count">📷 0 item(ns)</span>
        <button class="btn" type="button" id="add-manage-gallery-btn">Gerenciar galeria</button>
      </div>
      <small style="display:block; margin-top:6px; color:#6b7280;">Use o gerenciador para adicionar fotos ou vídeo. Depois clique em <strong>Adicionar</strong> para salvar o produto.</small>
    </div>

    <div class="quality-variations-box" id="add-variations-box" <%= requestedWorkspaceType === 'service' ? 'hidden' : '' %>>
      <div class="quality-variations-title">
        <span>🎛️ Variações do produto <small style="font-weight:400;color:#6b7280;">(opcional)</small></span>
        <small style="font-weight:400;color:#6b7280;">Use só quando o produto tiver cor, GB, RAM ou estado.</small>
      </div>
      <label>Ativar variações</label>
      <select name="variationsEnabled" class="variation-enabled-select" style="max-width:220px;margin-bottom:10px;">
        <option value="false" selected>Sem variações</option>
        <option value="true">Com variações</option>
      </select>
      <div class="variation-disabled-note">As opções de cor, armazenamento, RAM, estado e grade ficam escondidas enquanto o produto estiver marcado como <strong>Sem variações</strong>.</div>
      <textarea name="variationColors" class="variation-hidden-data" data-var-type="colors"></textarea>
      <textarea name="variationStorage" class="variation-hidden-data" data-var-type="storage"></textarea>
      <textarea name="variationRam" class="variation-hidden-data" data-var-type="ram"></textarea>
      <textarea name="variationCondition" class="variation-hidden-data" data-var-type="condition"></textarea>
      <textarea name="variationLabels" class="variation-hidden-data" data-var-type="labels"></textarea>
      <textarea name="variationCombinations" class="variation-hidden-data" data-var-type="combinations"></textarea>
      <div class="quality-variations-grid">
        <div class="variation-labels-box">
          <strong>🏷️ Nome dos grupos</strong>
          <small class="variation-help">Opcional. Use quando quiser personalizar os nomes dos grupos de variação do produto.</small>
          <div class="variation-labels-grid">
            <label>Cor<input type="text" class="variation-label-input" data-label-type="colors" placeholder="Cor"></label>
            <label>Armazenamento<input type="text" class="variation-label-input" data-label-type="storage" placeholder="Armazenamento"></label>
            <label>RAM<input type="text" class="variation-label-input" data-label-type="ram" placeholder="Memória RAM"></label>
            <label>Estado<input type="text" class="variation-label-input" data-label-type="condition" placeholder="Estado"></label>
          </div>
        </div>
        <div class="quality-var-card" data-var-card="colors">
          <strong>🎨 Cores</strong>
          <div class="variation-form-row">
            <input type="text" class="var-color-name" placeholder="Nome: Preto">
            <input type="color" class="var-color-hex" value="#111111">
            <input type="text" class="var-color-image quality-image-picker" list="imagens-list" placeholder="Imagem opcional" onfocus="sincronizarImagensAuto()" autocomplete="off">
            <button class="btn add-var-color" type="button">Adicionar</button>
          </div>
          <div class="quality-var-actions">
            <button class="btn var-preset" type="button" data-type="colors" data-values="Preto|#111111\nBranco|#f8fafc\nAzul|#2563eb">Preto / Branco / Azul</button>
            <button class="btn var-preset" type="button" data-type="colors" data-values="Preto|#111111\nVerde|#22c55e\nAzul|#2563eb">Preto / Verde / Azul</button>
          </div>
          <div class="quality-var-list" data-var-list="colors"></div>
        </div>
        <div class="quality-var-card" data-var-card="storage">
          <strong>💾 Armazenamento</strong>
          <div class="variation-simple-row"><select class="var-simple-select" data-type="storage"><option>64GB</option><option>128GB</option><option>256GB</option><option>512GB</option><option>1TB</option></select><input type="text" class="var-simple-custom" data-type="storage" placeholder="Outro: 2TB"><button class="btn add-var-simple" type="button" data-type="storage">Adicionar</button></div><small class="variation-help">Escolha da lista ou digite uma opção nova.</small>
          <div class="quality-var-actions"><button class="btn var-preset" type="button" data-type="storage" data-values="128GB\n256GB\n512GB">128 / 256 / 512GB</button><button class="btn var-preset" type="button" data-type="storage" data-values="64GB\n128GB\n256GB">64 / 128 / 256GB</button></div>
          <div class="quality-var-list" data-var-list="storage"></div>
        </div>
        <div class="quality-var-card" data-var-card="ram">
          <strong>⚡ Memória RAM</strong>
          <div class="variation-simple-row"><select class="var-simple-select" data-type="ram"><option>4GB</option><option>6GB</option><option>8GB</option><option>12GB</option><option>16GB</option><option>24GB</option></select><input type="text" class="var-simple-custom" data-type="ram" placeholder="Outro: 32GB"><button class="btn add-var-simple" type="button" data-type="ram">Adicionar</button></div><small class="variation-help">Ex.: 16GB, 24GB, 32GB ou RAM Boost.</small>
          <div class="quality-var-actions"><button class="btn var-preset" type="button" data-type="ram" data-values="4GB\n8GB\n12GB">4 / 8 / 12GB</button><button class="btn var-preset" type="button" data-type="ram" data-values="6GB\n8GB">6 / 8GB</button></div>
          <div class="quality-var-list" data-var-list="ram"></div>
        </div>
        <div class="quality-var-card" data-var-card="condition">
          <strong>⭐ Estado</strong>
          <div class="variation-simple-row"><select class="var-simple-select" data-type="condition"><option>Novo</option><option>Excelente</option><option>Muito Bom</option><option>Com marcas de uso</option></select><input type="text" class="var-simple-custom" data-type="condition" placeholder="Outro estado"><button class="btn add-var-simple" type="button" data-type="condition">Adicionar</button></div><small class="variation-help">Ex.: Seminovo, Vitrine, Caixa aberta.</small>
          <div class="quality-var-actions"><button class="btn var-preset" type="button" data-type="condition" data-values="Novo">Novo</button><button class="btn var-preset" type="button" data-type="condition" data-values="Excelente\nMuito Bom\nCom marcas de uso">Usados padrão</button></div>
          <div class="quality-var-list" data-var-list="condition"></div>
        </div>
        <div class="quality-var-card quality-combo-card" data-var-card="combinations">
          <strong>🧩 Grade de combinações</strong>
          <small class="variation-help">Cada combinação é um item vendável. O preço ERP é opcional: vazio herda o preço do cadastro pai; preenchido usa o preço próprio da variação.</small>
          <div class="variation-combo-row">
            <select class="var-combo-select" data-combo="color"><option value="">Cor</option></select>
            <select class="var-combo-select" data-combo="storage"><option value="">GB</option></select>
            <select class="var-combo-select" data-combo="ram"><option value="">RAM</option></select>
            <select class="var-combo-select" data-combo="condition"><option value="">Estado</option></select>
            <input type="text" class="var-combo-image quality-image-picker" list="imagens-list" placeholder="Imagem opcional" onfocus="sincronizarImagensAuto()" autocomplete="off">
            <input type="number" class="var-combo-stock stock-input-small" min="0" step="1" placeholder="Estoque">
            <input type="number" class="var-combo-price" min="0" step="0.01" placeholder="Preço ERP" title="Opcional: vazio herda o preço ERP do cadastro pai">
            <button class="btn add-var-combo" type="button">Adicionar</button>
          </div>
          <div class="quality-combo-list" data-var-list="combinations"></div>
        </div>
      </div>
    </div>



    <div class="commercial-policy-box workspace-commercial" data-create-section="commercial">
      <strong>💰 Comercial e política de desconto</strong>
      <div class="commercial-policy-grid" style="margin-top:10px">
        <label>Preço de custo<input type="number" name="costPrice" step="0.01" min="0" placeholder="0,00"></label>
        <label>Preço de venda ERP<input type="number" name="erpPrice" step="0.01" min="0" placeholder="0,00"></label>
        <label>Preço mínimo<input type="number" name="minimumPrice" step="0.01" min="0" placeholder="0,00"></label>
        <label>Margem mínima (%)<input type="number" name="minimumMarginPercent" step="0.01" min="0" placeholder="0"></label>
        <label>Política de desconto<select name="discountPolicy"><option value="inherit">Herdar regra superior</option><option value="custom">Regra própria</option><option value="blocked">Sem desconto</option></select></label>
        <label>Desconto máximo (%)<input type="number" name="maximumDiscountPercent" step="0.01" min="0" max="100" placeholder="0"></label>
        <label>Desconto máximo (R$)<input type="number" name="maximumDiscountAmount" step="0.01" min="0" placeholder="0,00"></label>
        <label>Exige autorização?<select name="requiresAuthorization"><option value="false">Não</option><option value="true">Sim</option></select></label>
      </div>
      <small class="commercial-note">O limite mais restritivo entre desconto, preço mínimo e margem mínima sempre prevalecerá.</small>
    </div>

    <div class="quality-tags-field" data-create-lv-dependent>
      <label>Etiquetas do produto</label>
      <div class="quality-tags-options">
        <% ['Lançamento','Oferta','Mais vendido','Últimas unidades','Preço Baixou','Frete grátis','Novo','Novidade','Seminovo','5G'].forEach(tag => { %>
          <label class="quality-tag-option"><input type="checkbox" name="tags" value="<%= tag %>"> <%= tag %></label>
        <% }) %>
      </div>
      <div class="quality-tags-custom">
        <input type="text" name="tags" placeholder="Etiquetas extras separadas por vírgula. Ex.: Pronta entrega, Premium">
      </div>
      <small class="variation-help">As etiquetas aparecem no card e na página do produto. Use poucas para não poluir.</small>
    </div>

    <div style="grid-column: 1 / -1;" data-create-lv-dependent>
      <label>Descrição curta</label>
      <input type="text" name="descriptionShort" placeholder="Ex.: Novo, lacrado, 128GB, garantia...">
    </div>

    <div class="add-description-editor-wrap" data-create-lv-dependent>
      <label>Descrição completa</label>
      <textarea name="descriptionLong" id="add-description-long-hidden" style="display:none;"></textarea>
      <div class="description-toolbar" style="margin-top:8px;">
        <button type="button" data-add-desc-cmd="bold"><b>B</b></button>
        <button type="button" data-add-desc-cmd="italic"><i>I</i></button>
        <button type="button" data-add-desc-cmd="insertUnorderedList">Lista</button>
        <button type="button" data-add-desc-cmd="formatBlock" data-add-desc-value="h3">Título</button>
        <button type="button" data-add-desc-cmd="formatBlock" data-add-desc-value="p">Texto</button>
        <button type="button" id="add-description-clear-format">Limpar formatação</button>
      </div>
      <div id="add-description-long-editor" class="description-rich-editor" contenteditable="true" data-placeholder="Detalhes do produto, características, garantia, conteúdo da caixa..."></div>
      <small class="variation-help">Agora o cadastro novo também aceita negrito, títulos e listas. Ao clicar em Adicionar, o texto é salvo automaticamente.</small>
    </div>

    <div style="align-self:end">
      <button class="btn primary" type="submit">Adicionar</button>
    </div>
  </form>
  <script>
  // v0.12.3.16 - bootstrap imediato e isolado do cadastro.
  // Executa assim que o formulário termina de ser interpretado, antes do restante da página.
  (() => {
    const addForm=document.getElementById('add-product-form');
    if(!addForm||addForm.classList.contains('create-tabs-ready'))return;
    const nodes=Array.from(addForm.children);
    const submitWrap=nodes.find(el=>el.querySelector?.('button[type="submit"]'));
    const panels={};
    ['general','commercial','stock','site','variations'].forEach(key=>{
      const panel=document.createElement('div');
      panel.className='product-create-panel'+(key==='general'?' active':'');
      panel.dataset.createPanel=key; panels[key]=panel; addForm.appendChild(panel);
    });
    const footer=document.createElement('div'); footer.className='product-create-footer';
    const destination=el=>{
      if(el===submitWrap)return 'footer';
      if(el.matches?.('[data-create-section="commercial"]'))return 'commercial';
      if(el.matches?.('[data-create-section="stock"]'))return 'stock';
      if(el.matches?.('[data-create-section="site"]'))return 'site';
      if(el.classList?.contains('quality-variations-box'))return 'variations';
      if(el.classList?.contains('quality-tags-field')||el.classList?.contains('add-description-editor-wrap')||el.querySelector?.('[name="descriptionShort"]'))return 'general';
      const name=el.querySelector?.('input,select,textarea')?.name||'';
      if(name==='stock')return 'stock';
      if(['showPrice','featured','active','lvActive','detailsEnabled','showVariationsOnCard','siteCategory','siteSubcategory','slug','lvName','lvPrice'].includes(name))return 'site';
      return 'general';
    };
    nodes.forEach(el=>{const dest=destination(el);dest==='footer'?footer.appendChild(el):panels[dest].appendChild(el);});
    addForm.appendChild(footer);
    addForm.classList.add('create-tabs-ready');
    window.__qualityProductCreatePanels=panels;
  })();
  </script>
  </section>

