    if (editProductThumb) editProductThumb.src = productImageUrl(newImage);
    if (editProductTitle) editProductTitle.textContent = getRowField(row, ".prod-name-input") || "Editar produto";
    updateStockBadge(row);
    updateStockTotalIndicator();
    updateVariationSummary(row);
    markRowDirty(row);
  }

  document.querySelectorAll(".quality-edit-tab").forEach(btn => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.editTab;
      document.querySelectorAll(".quality-edit-tab").forEach(b => b.classList.toggle("active", b === btn));
      document.querySelectorAll(".quality-edit-panel").forEach(panel => panel.classList.toggle("active", panel.dataset.editPanel === key));
    });
  });

  document.querySelectorAll(".quality-edit-btn").forEach(btn => {
    btn.addEventListener("click", () => openEditProductModal(btn.closest("tr")));
  });

  editProductClose?.addEventListener("click", closeEditProductModal);
  editProductCancel?.addEventListener("click", closeEditProductModal);
  editProductModal?.addEventListener("click", e => { if (e.target === editProductModal) closeEditProductModal(); });
  editProductSave?.addEventListener("click", async () => {
    if (!activeEditRow) return;
    const touchedFields = Array.from(activeEditTouchedFields);
    applyEditModalToRow(activeEditRow);
    const saved = await saveProductRow(activeEditRow, { touchedFields });
    if (saved) closeEditProductModal();
  });

  updateAddGallerySummary();
  updateSelectionCount();

  // O redirect de salvar usa ?saved=... apenas para a primeira renderização.
  // Retira o parâmetro imediatamente para F5 não repetir o salvamento/mensagem.
  const currentUrl = new URL(window.location.href);
  if (currentUrl.searchParams.has('saved')) {
    currentUrl.searchParams.delete('saved');
    history.replaceState(history.state, '', currentUrl.pathname + (currentUrl.search ? currentUrl.search : '') + currentUrl.hash);
  }

  // O layout global já exibiu o único aviso de redirect. Em Produtos ele é
  // transitório para não permanecer preso no topo da tela.
  const layoutNotice = document.querySelector('.notice');
  if (layoutNotice) setTimeout(() => { layoutNotice.style.display = 'none'; }, 3500);

  if (flashMessage && flashMessage.textContent.trim()) {
    clearTimeout(window.__flashTimer);
    window.__flashTimer = setTimeout(() => {
      flashMessage.style.display = "none";
    }, 3500);
  }
});

let __qualityImagesPromise = null;
async function sincronizarImagensAuto() {
  const dataList = document.getElementById("imagens-list");
  if (dataList?.dataset.loaded === 'true') return [];
  if (__qualityImagesPromise) return __qualityImagesPromise;

  __qualityImagesPromise = fetch('/produtos/api/images', { headers:{ 'Accept':'application/json' } })
    .then(res => res.json())
    .then(json => {
      if (!json?.success) throw new Error(json?.message || 'Erro ao listar imagens.');
      const imagens = Array.isArray(json.items) ? json.items : [];
      if (dataList) {
        dataList.innerHTML = '';
        imagens.forEach(img => {
          const opt = document.createElement('option');
          opt.value = img.startsWith('images/') ? img : `images/${img}`;
          opt.textContent = img.replace(/^images\//, '');
          dataList.appendChild(opt);
        });
        dataList.dataset.loaded = 'true';
      }
      return imagens;
    })
    .catch(err => {
      console.error('Erro ao sincronizar imagens:', err);
      __qualityImagesPromise = null;
      return [];
    });
  return __qualityImagesPromise;
}
</script>

<script>
(() => {
  // v0.12.3.16: estrutura das abas já montada imediatamente após o formulário.
  const addForm = document.getElementById('add-product-form');
  if (!addForm) return;
  const panels = window.__qualityProductCreatePanels || Object.fromEntries(
    [...addForm.querySelectorAll('[data-create-panel]')].map(panel => [panel.dataset.createPanel, panel])
  );

  document.querySelectorAll('.product-create-tab').forEach(btn => btn.addEventListener('click', () => {
    const key = btn.dataset.createTab;
    document.querySelectorAll('.product-create-tab').forEach(b => b.classList.toggle('active', b === btn));
    Object.entries(panels).forEach(([panelKey,panel]) => panel.classList.toggle('active', panelKey === key));
  }));

  const params = new URLSearchParams(window.location.search);
  const productKindDialog=document.getElementById('product-kind-dialog');
  const openProductKindDialog=()=>{if(!productKindDialog)return;productKindDialog.classList.add('open');productKindDialog.setAttribute('aria-hidden','false');};
  const closeProductKindDialog=()=>{if(!productKindDialog)return;productKindDialog.classList.remove('open');productKindDialog.setAttribute('aria-hidden','true');};
  // Sempre abre o seletor, inclusive quando o usuário já está em Novo Produto/Serviço.
  document.querySelectorAll('.js-new-product-choice').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();openProductKindDialog();}));
  document.getElementById('product-kind-cancel')?.addEventListener('click',closeProductKindDialog);
  productKindDialog?.addEventListener('click',event=>{if(event.target===productKindDialog)closeProductKindDialog();});
  productKindDialog?.querySelectorAll('[data-product-kind]').forEach(button=>button.addEventListener('click',()=>{window.location.href=`/produtos?workspace=new&type=${encodeURIComponent(button.dataset.productKind||'product')}`;}));
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&productKindDialog?.classList.contains('open'))closeProductKindDialog();});

  const requestedProductKind=String(params.get('type')||'').toLowerCase();
  if(params.get('workspace')==='new'&&requestedProductKind==='service'){
    const serviceCategory=[...document.querySelectorAll('select[name="erpCategory"] option[data-category-type="service"]')][0];
    const categorySelect=document.querySelector('select[name="erpCategory"]');
    if(serviceCategory&&categorySelect){categorySelect.value=serviceCategory.value;categorySelect.dispatchEvent(new Event('change',{bubbles:true}));}
    const heading=document.querySelector('.new-product-heading h2');if(heading)heading.textContent='＋ Novo serviço';
  }
})();
</script>

<script>
(()=>{
  const createStatus=document.getElementById('add-lv-active');
  const createFields=[...document.querySelectorAll('[data-create-lv-dependent]')];
  const syncCreateLv=()=>{
    const inactive=createStatus?.value!=='true';
    createFields.forEach(el=>el.hidden=inactive);
  };
  createStatus?.addEventListener('change',syncCreateLv); syncCreateLv();

  const createCategory=document.querySelector('select[name="erpCategory"]');
  const createInventory=document.getElementById('add-inventory-config');
  const createVariationsTab=document.getElementById('create-variations-tab');
  const createVariationsBox=document.getElementById('add-variations-box');
  const syncCreateCategory=()=>{
    const isService=createCategory?.selectedOptions?.[0]?.dataset?.categoryType==='service';
    createInventory?.classList.toggle('is-service',isService);
    if(createVariationsTab) createVariationsTab.hidden=isService;
    if(createVariationsBox) createVariationsBox.hidden=isService;
    if(isService){
      // Serviço = cadastro único. Variações pertencem somente a produtos.
      createVariationsBox?.querySelectorAll('textarea[data-var-type]').forEach(el=>{el.value='';});
      const enabled=createVariationsBox?.querySelector('select[name="variationsEnabled"]');
      if(enabled){ enabled.value='false'; enabled.dispatchEvent(new Event('change',{bubbles:true})); }
      const activeTab=document.querySelector('.product-create-tab.active');
      if(activeTab?.dataset?.createTab==='variations') document.querySelector('.product-create-tab[data-create-tab="commercial"]')?.click();
      const controlled=document.querySelector('input[name="stockControlled"]');
      const negative=document.querySelector('input[name="allowNegative"]');
      const mode=document.querySelector('select[name="inventorySiteMode"]');
      if(controlled) controlled.checked=false;
      if(negative) negative.checked=false;
      if(mode) mode.value='disabled';
    }
  };
  createCategory?.addEventListener('change',syncCreateCategory); syncCreateCategory();

  const editStatus=document.getElementById('edit-lvActive');
  const editCategoryFields=[...document.querySelectorAll('[data-edit-site-category]')];
  const editLvFields=[...document.querySelectorAll('[data-edit-lv-dependent]')];
  const editDisabledNote=document.getElementById('edit-lv-disabled-note');
  const syncEditLv=()=>{
    const inactive=editStatus?.value!=='true';
    [...editCategoryFields,...editLvFields].forEach(el=>el.hidden=inactive);
    if(editDisabledNote) editDisabledNote.style.display=inactive?'block':'none';
  };
  editStatus?.addEventListener('change',syncEditLv);
  document.getElementById('edit-erpCategory')?.addEventListener('change',syncEditCategoryBehavior);
  document.querySelectorAll('[data-edit-product],.quality-edit-open').forEach(btn=>btn.addEventListener('click',()=>setTimeout(()=>{syncEditLv();syncEditCategoryBehavior();},0)));
})();
</script>

<script>
(()=>{
  const modal=document.getElementById('productHistoryModal'), body=document.getElementById('productHistoryBody'), title=document.getElementById('productHistoryTitle');
  if(!modal)return;
  const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const fmt=v=>{try{return new Date(v).toLocaleString('pt-BR')}catch{return v||'—'}};
  const close=()=>{modal.hidden=true;}; document.querySelectorAll('[data-history-close]').forEach(b=>b.addEventListener('click',close));
  document.querySelectorAll('.quality-history-btn').forEach(btn=>btn.addEventListener('click',async()=>{
    const row=btn.closest('.product-row'); if(!row)return; const id=row.dataset.id; const name=row.querySelector('.prod-name-input')?.value||'Produto';
    title.textContent=`Histórico · ${name}`; body.innerHTML='<p>Carregando histórico...</p>'; modal.hidden=false;
    try{const j=await fetch(`/produtos/api/${encodeURIComponent(id)}/historico`).then(r=>r.json()); if(!j.success)throw new Error(j.message);
      body.innerHTML=(j.events||[]).length?(j.events||[]).map(e=>`<div style="border-bottom:1px solid var(--border,#333);padding:10px 2px"><div style="display:flex;justify-content:space-between;gap:12px"><strong>${esc(e.label)}</strong><small>${esc(fmt(e.at))}</small></div><small>${esc(e.source||'')} · ${esc(e.actor||'sistema')}</small></div>`).join(''):'<p>Nenhum evento registrado para este produto.</p>';
    }catch(error){body.innerHTML=`<p>⚠️ ${esc(error.message||'Não foi possível carregar o histórico.')}</p>`;}
  }));
})();
</script>

<script>
// V1.7.4 - atalhos resilientes: Produto/Serviço e foto principal na listagem.
(()=>{
  const dialog=()=>document.getElementById('product-kind-dialog');
  const fileInput=()=>document.getElementById('quick-main-image-file');
  let quickTarget=null;
  const openDialog=()=>{const el=dialog();if(!el)return;el.classList.add('open');el.setAttribute('aria-hidden','false');};
  const closeDialog=()=>{const el=dialog();if(!el)return;el.classList.remove('open');el.setAttribute('aria-hidden','true');};
  document.addEventListener('click',event=>{
    const newButton=event.target.closest?.('.js-new-product-choice');
    if(newButton){
      event.preventDefault(); event.stopImmediatePropagation(); openDialog(); return;
    }
    const kindButton=event.target.closest?.('[data-product-kind]');
    if(kindButton && dialog()?.contains(kindButton)){
      event.preventDefault(); event.stopImmediatePropagation();
      location.href=`/produtos?workspace=new&type=${encodeURIComponent(kindButton.dataset.productKind||'product')}`; return;
    }
    if(event.target.closest?.('#product-kind-cancel')){event.preventDefault();closeDialog();return;}
    if(event.target===dialog()){closeDialog();return;}
    const thumb=event.target.closest?.('.quick-main-image');
    if(thumb){event.preventDefault();event.stopImmediatePropagation();quickTarget=thumb;const input=fileInput();if(input){input.value='';input.click();}return;}
  },true);
  fileInput()?.addEventListener('change',async event=>{
    const input=event.currentTarget,file=input.files?.[0],target=quickTarget; if(!file||!target)return;
    if(!file.type.startsWith('image/')){alert('Selecione uma imagem.');input.value='';quickTarget=null;return;}
    const form=new FormData();form.append('imageFile',file);form.append('productId',target.dataset.productId||'');target.classList.add('is-uploading');
    try{const response=await fetch('/produtos/quick-main-image',{method:'POST',body:form,headers:{Accept:'application/json'}});const payload=await response.json().catch(()=>({}));if(!response.ok||payload.success===false)throw new Error(payload.message||'Falha ao trocar a imagem.');const img=target.querySelector('img');if(img)img.src=`/${payload.image}?v=${Date.now()}`;}
    catch(error){alert(error.message||'Falha ao trocar a foto principal.');}
    finally{target.classList.remove('is-uploading');input.value='';quickTarget=null;}
  },true);
})();
</script>
