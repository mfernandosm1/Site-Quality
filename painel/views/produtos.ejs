  bulkActionsForm?.addEventListener("submit", event => {
    const checkedProducts = document.querySelectorAll(".product-check:checked");
    const enabled = Array.from(bulkActionsForm.querySelectorAll('input[name="enabledActions"]:checked'));

    if (!checkedProducts.length) {
      event.preventDefault();
      alert("Selecione pelo menos um produto.");
      return;
    }

    if (!enabled.length) {
      event.preventDefault();
      alert("Marque pelo menos uma operação em lote.");
      return;
    }

    const labels = enabled.map(input => input.closest('.quality-bulk-action')?.querySelector('.quality-bulk-action-head')?.textContent.trim()).filter(Boolean);
    const confirmed = window.confirm(`Aplicar ${labels.join(', ')} em ${checkedProducts.length} produto(s) selecionado(s)?`);
    if (!confirmed) { event.preventDefault(); return; }
    if (bulkActionsSummary) bulkActionsSummary.textContent = `${checkedProducts.length} produto(s) · ${labels.join(' · ')}`;

    const categoryEnabled = enabled.some(input => input.value === 'category');
    const subcategoryEnabled = enabled.some(input => input.value === 'subcategory');
    if (subcategoryEnabled && !categoryEnabled && bulkSubcategorySelect?.value && selectedProductsCommonCategory() === null) {
