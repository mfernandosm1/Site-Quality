  function parseTagsValue(value){
    const seen = new Set();
    return String(value || "")
      .split(/\r?\n|,/)
      .map(v => v.trim())
      .filter(Boolean)
      .filter(v => {
        const key = v.toLowerCase();
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      })
      .slice(0, 8);
  }

  function setTagsValue(row, tags){
    const el = row?.querySelector(".row-product-tags");
    if (!el) return;
    el.value = (tags || []).filter(Boolean).join("\n");
    el.dispatchEvent(new Event("change", { bubbles:true }));
    updateTagsSummary(row);
  }

  function getTagsValue(row){
    return parseTagsValue(row?.querySelector(".row-product-tags")?.value || "");
  }

  function parseIdListValue(value){
    return String(value || "")
      .split(/\r?\n|,|;/)
      .map(v => String(v || "").trim().replace(/^QLT[-\s]*/i, ""))
      .filter(Boolean)
      .filter((v, i, arr) => arr.findIndex(x => x.toLowerCase() === v.toLowerCase()) === i)
      .slice(0, 12);
  }

  function getListValue(row, selector){
    return parseIdListValue(row?.querySelector(selector)?.value || "");
  }

  function setListValue(row, selector, values){
    const el = row?.querySelector(selector);
    if (!el) return;
    el.value = parseIdListValue(Array.isArray(values) ? values.join("\n") : values).join("\n");
    el.dispatchEvent(new Event("change", { bubbles:true }));
  }

  function addPickerValueToTextarea(inputId, textareaId){
    const input = document.getElementById(inputId);
    const textarea = document.getElementById(textareaId);
    if (!input || !textarea) return;
    const value = String(input.value || "").trim();
    if (!value) return;
    const values = parseIdListValue(textarea.value + "\n" + value);
    textarea.value = values.join("\n");
    input.value = "";
  }

