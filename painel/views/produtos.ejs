  <form id="update-all-form" method="post" action="/produtos/update-all">
    <div class="quality-table-wrap">
    <table class="table quality-products-summary-table">
      <thead>
        <tr>
          <th><input type="checkbox" id="select-all-checkbox" title="Selecionar ou desmarcar todos os produtos visíveis"></th>
          <th>#</th>
          <th>Produto</th>
          <th>ERP / Estoque</th>
          <th>ERP</th>
          <th>LV</th>
          <th>Recursos</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody id="products-table-body">
        <% (items || []).forEach((p, idx) => { %>
          <% const hasStockVariations = Array.isArray(p?.variations?.combinations) && p.variations.combinations.length > 0; const stockValue = (p.stock ?? ''); const stockNum = Number(stockValue || 0); const stockClass = stockValue === '' ? 'empty' : (stockNum > 0 ? '' : 'zero'); const stockText = stockValue === '' ? 'Não informado' : (stockNum > 0 ? 'Em estoque' : 'Sem estoque'); %>
          <% const listErpRaw = p?.erp?.active !== undefined ? p.erp.active : p.active; const listErpActive = !['false','0','off','inativo'].includes(String(listErpRaw).toLowerCase()) && listErpRaw !== false; const listLvRaw = p?.virtualStore?.active !== undefined ? p.virtualStore.active : p.active; const listLvActive = !['false','0','off','inativo'].includes(String(listLvRaw).toLowerCase()) && listLvRaw !== false; %>
          <tr class="product-row <%= !listErpActive ? 'erp-inactive' : '' %> <%= !listLvActive ? 'lv-inactive' : '' %>" data-id="<%= p.id %>" data-erp-active="<%= listErpActive ? 'true' : 'false' %>" data-lv-active="<%= listLvActive ? 'true' : 'false' %>" data-erp-category-type="<%= erpCategoryById.get(String(p?.erp?.categoryId || p?.erp?.category || ''))?.type || 'product' %>" data-stock="<%= Number(stockValue || 0) %>" data-stock-controlled="<%= p?.inventory?.stockControlled === true ? 'true' : 'false' %>">
            <td><input type="checkbox" class="product-check" value="<%= p.id %>"></td>
            <td><span class="badge"><%= idx + 1 %></span></td>

            <td>
              <input type="hidden" name="id" value="<%= p.id %>">
              <% const erpData = p.erp || {}; const lvData = p.virtualStore || {}; %>
              <input type="hidden" name="sku" value="<%= erpData.sku || '' %>">
              <input type="hidden" name="internalCode" value="<%= erpData.internalCode || '' %>">
              <input type="hidden" name="supplierCode" value="<%= erpData.supplierCode || '' %>">
              <input type="hidden" name="searchAlias" value="<%= erpData.searchAlias || '' %>">
              <input type="hidden" name="barcode" value="<%= erpData.barcode || '' %>">
              <input type="hidden" name="brand" value="<%= erpData.brand || '' %>">
              <input type="hidden" name="unit" value="<%= erpData.unit || 'UN' %>">
              <input type="hidden" name="erpCategory" value="<%= erpData.categoryId || erpData.category || '' %>">
              <input type="hidden" name="erpSubcategory" value="<%= erpData.subcategory || '' %>">
              <input type="hidden" name="lvName" value="<%= lvData.name || p.name || '' %>">
              <input type="hidden" name="lvPrice" value="<%= lvData.price ?? p.price ?? '' %>">
              <input type="hidden" name="seoTitle" value="<%= lvData.seoTitle || '' %>">
              <input type="hidden" name="seoDescription" value="<%= lvData.seoDescription || '' %>">
              <% const commercial = p.commercial || {}; %>
              <input type="hidden" name="costPrice" value="<%= commercial.costPrice ?? '' %>"><input type="hidden" name="erpPrice" value="<%= commercial.erpPrice ?? '' %>"><input type="hidden" name="marketplacePrice" value="<%= commercial.marketplacePrice ?? '' %>"><input type="hidden" name="promotionalPrice" value="<%= commercial.promotionalPrice ?? '' %>"><input type="hidden" name="desiredMarginPercent" value="<%= commercial.desiredMarginPercent ?? '' %>"><input type="hidden" name="expectedProfit" value="<%= commercial.expectedProfit ?? '' %>"><input type="hidden" name="defaultCommissionPercent" value="<%= commercial.defaultCommissionPercent ?? '' %>">
              <input type="hidden" name="cashPrice" value="<%= commercial.cashPrice ?? '' %>">
              <input type="hidden" name="installmentPrice" value="<%= commercial.installmentPrice ?? '' %>">
              <input type="hidden" name="minimumPrice" value="<%= commercial.minimumPrice ?? '' %>">
              <input type="hidden" name="minimumMarginPercent" value="<%= commercial.minimumMarginPercent ?? '' %>">
              <input type="hidden" name="discountPolicy" value="<%= commercial.discountPolicy || 'inherit' %>">
              <input type="hidden" name="maximumDiscountPercent" value="<%= commercial.maximumDiscountPercent ?? '' %>">
              <input type="hidden" name="maximumDiscountAmount" value="<%= commercial.maximumDiscountAmount ?? '' %>">
              <input type="hidden" name="requiresAuthorization" value="<%= commercial.requiresAuthorization ? 'true' : 'false' %>">

              <% const inventoryPolicy = p.inventory || {}; const siteInventory = inventoryPolicy.channelAvailability?.site || {}; %>
              <input type="hidden" name="stockControlled" class="row-stock-controlled" value="<%= inventoryPolicy.stockControlled === true ? 'true' : 'false' %>">
              <input type="hidden" name="allowNegative" class="row-allow-negative" value="<%= inventoryPolicy.allowNegative === true ? 'true' : 'false' %>">
              <input type="hidden" name="minimumQuantity" class="row-minimum-quantity" value="<%= inventoryPolicy.minimumQuantity ?? 0 %>">
              <input type="hidden" name="inventorySiteMode" class="row-inventory-site-mode" value="<%= siteInventory.mode || 'shared' %>">
              <input type="hidden" name="siteLimit" class="row-site-limit" value="<%= siteInventory.limit ?? '' %>">
              <input type="hidden" name="physicalSafety" class="row-physical-safety" value="<%= siteInventory.physicalSafety ?? 0 %>">

              <div class="quality-product-cell">
                <div class="quality-product-thumb quick-main-image" data-product-id="<%= p.id %>" title="Clique para trocar a foto principal">
