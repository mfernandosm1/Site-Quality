  function comboLineLabel(line) {
    const p = (line || '').split('|').map(v => v.trim());
    return [p[0], p[1], p[2], p[3]].filter(Boolean).join(' + ') + (p[4] ? ' 🖼️' : '') + (p[5] ? ' • Est: ' + p[5] : '') + (p[6] ? ' • R$ ' + Number(p[6]).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}) : ' • preço do pai');
  }

  function colorNameFromLine(line) { return (line || '').split('|')[0].trim(); }

  function setSelectOptions(select, values, placeholder) {
    if (!select) return;
    const old = select.value;
    select.innerHTML = '';
    const opt0 = document.createElement('option');
    opt0.value = '';
    opt0.textContent = placeholder;
    select.appendChild(opt0);
    values.forEach(v => {
