  async function saveProductRow(row, options = {}) {
    const data = new URLSearchParams();
    data.append("id", row.dataset.id);
    if (Array.isArray(options.touchedFields)) {
      data.append('__touchedFields', JSON.stringify(options.touchedFields));
    }

    row.querySelectorAll("input[name], select[name], textarea[name]").forEach(el => {
      if (el.name === "id") return;
      data.append(el.name, el.value);
    });

    // Captura os estados antes de qualquer resposta do backend. Eles são
    // persistidos novamente por uma rota dedicada após o salvamento completo.
    const submittedErpActive = row.querySelector('select[name="erpActive"]')?.value === 'false' ? 'false' : 'true';
    const submittedLvActive = row.querySelector('select[name="lvActive"]')?.value === 'false' ? 'false' : 'true';

    const btn = row.querySelector(".save-product-btn");
    const oldText = btn ? btn.textContent : "";
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Salvando...";
    }

    try {
      const res = await fetch("/produtos/update", {
        method: "POST",
        body: data.toString(),
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
        }
      });

      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || "Erro ao salvar produto.");

      // O /produtos/update já persiste o produto completo, inclusive os estados
      // ERP/LV. Não fazemos uma segunda gravação de status aqui: duas requisições
      // concorrentes sobre products.json podiam fazer uma resposta antiga sobrescrever
      // Categoria LV, Subcategoria e SEO recém-salvos.

      if (json.item && json.item.slug) {
        const slugInput = row.querySelector(".prod-slug-input");
        if (slugInput) {
          slugInput.value = json.item.slug;
          slugInput.dataset.manual = "1";
        }
      }
      if (json.item && json.item.stock !== undefined && json.item.stock !== null) {
        setRowField(row, 'input[name="stock"]', json.item.stock);
        updateStockBadge(row);
        updateStockTotalIndicator();
      }

      // Usa os valores canônicos devolvidos pelo backend. Assim o painel confirma
      // visualmente o que realmente foi persistido, inclusive quando o valor é false.
      if (json.item) {
        const savedErpActive = json.item.erp && json.item.erp.active !== undefined
          ? json.item.erp.active
          : json.item.active !== false;
        const savedLvActive = json.item.virtualStore && json.item.virtualStore.active !== undefined
          ? json.item.virtualStore.active
          : json.item.active !== false;
        setRowField(row, 'select[name="erpActive"]', savedErpActive === false ? 'false' : 'true');
        setRowField(row, 'select[name="lvActive"]', savedLvActive === false ? 'false' : 'true');
      }

      if (json.item) {
        setRowField(row, '.prod-category-select', json.item.category || '');
        setRowField(row, '.prod-subcategory-select', json.item.subcategory || json.item.subcategoria || '');
        setRowField(row, 'input[name="seoTitle"]', json.item.virtualStore?.seoTitle || '');
        setRowField(row, 'input[name="seoDescription"]', json.item.virtualStore?.seoDescription || '');
        refreshLvCategoryCard(row);
      }

      markRowClean(row);
      updateGallerySummary(row);

      const status = row.querySelector(".row-save-status");
      if (status) {
        status.textContent = "✅ Produto salvo";
        status.style.color = "#087a31";
        status.style.display = "inline-block";
        clearTimeout(status.__hideTimer);
        status.__hideTimer = setTimeout(() => { status.style.display = "none"; }, 3500);
      } else {
        showMessage("✅ Produto salvo com sucesso.");
      }
      return true;
    } catch (err) {
      console.error(err);
      const message = err?.message || "Erro ao salvar produto.";
      const status = row.querySelector(".row-save-status");
      if (status) {
        status.textContent = `⚠️ ${message}`;
        status.style.color = "#a40000";
        status.style.display = "inline-block";
      }
      showMessage(`⚠️ ${message}`, "error");
      return false;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = oldText;
      }
    }
  }


  async function saveChannelStatus(row) {
    const erpSelect = row.querySelector('select[name="erpActive"]');
    const lvSelect = row.querySelector('select[name="lvActive"]');
    const status = row.querySelector(".row-save-status");
    const erpValue = erpSelect?.value === 'false' ? 'false' : 'true';
    const lvValue = lvSelect?.value === 'false' ? 'false' : 'true';

    if (erpSelect) erpSelect.disabled = true;
    if (lvSelect) lvSelect.disabled = true;
    if (status) {
      status.textContent = "Salvando status...";
      status.style.color = "#2563eb";
      status.style.display = "inline-block";
    }

    try {
      const payload = new URLSearchParams({
        id: String(row.dataset.id || ''),
        erpActive: erpValue,
        lvActive: lvValue
      });
      const response = await fetch('/produtos/update-channel-status', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
        },
        body: payload.toString()
      });

      const raw = await response.text();
      let json = {};
      try { json = raw ? JSON.parse(raw) : {}; } catch (_) {}
      if (!response.ok || !json.success) {
        throw new Error(json.message || raw || `Falha HTTP ${response.status}`);
      }

      const savedErp = json.item?.erp?.active === false ? 'false' : 'true';
      const savedLv = json.item?.virtualStore?.active === false ? 'false' : 'true';
      if (erpSelect) erpSelect.value = savedErp;
      if (lvSelect) lvSelect.value = savedLv;
      syncRowOperationalState(row);
      filterTable();

      markRowClean(row);
      if (status) {
        status.textContent = "✅ Status salvo";
        status.style.color = "#087a31";
        clearTimeout(status.__hideTimer);
        status.__hideTimer = setTimeout(() => { status.style.display = "none"; }, 3000);
      }
      return true;
    } catch (error) {
      console.error('Erro ao salvar ERP/LV:', error);
      if (erpSelect) erpSelect.value = erpSelect.dataset.savedValue || erpValue;
      if (lvSelect) lvSelect.value = lvSelect.dataset.savedValue || lvValue;
      if (status) {
        status.textContent = `⚠️ ${error.message || 'Erro ao salvar status'}`;
        status.style.color = "#a40000";
        status.style.display = "inline-block";
      }
      return false;
    } finally {
      if (erpSelect) { erpSelect.disabled = false; erpSelect.dataset.savedValue = erpSelect.value; }
      if (lvSelect) { lvSelect.disabled = false; lvSelect.dataset.savedValue = lvSelect.value; }
    }
  }


