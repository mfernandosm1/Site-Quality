  const variationModal = document.getElementById("variation-modal-backdrop");
  const variationModalClose = document.getElementById("variation-modal-close");
  const variationModalSave = document.getElementById("variation-modal-save");
  const variationModalProduct = document.getElementById("variation-modal-product");
  const modalVariationsBox = document.getElementById("modal-variations-box");
  let activeVariationRow = null;

  function parseLines(value) {
    return (value || "").split(/\r?\n/).map(v => v.trim()).filter(Boolean);
  }

  function uniquePush(list, value) {
    if (value && !list.includes(value)) list.push(value);
    return list;
  }

  function getVarTextarea(box, type) {
    return box?.querySelector(`[data-var-type="${type}"]`);
  }

  function parseVariationLabels(value) {
    try {
      const obj = JSON.parse(value || '{}');
      return obj && typeof obj === 'object' ? obj : {};
    } catch (e) {
      return {};
    }
  }

  function labelsFromInputs(box) {
    const labels = {};
    box?.querySelectorAll('.variation-label-input').forEach(input => {
      const type = input.dataset.labelType;
      const value = (input.value || '').trim();
      if (type && value) labels[type] = value;
    });
    return labels;
  }

  function syncLabelInputs(box) {
    if (!box) return;
    const labels = parseVariationLabels(getVarTextarea(box, 'labels')?.value || '{}');
    box.querySelectorAll('.variation-label-input').forEach(input => {
      input.value = labels[input.dataset.labelType] || '';
    });
  }

  function syncLabelsTextarea(box) {
    const textarea = getVarTextarea(box, 'labels');
    if (!textarea) return;
    textarea.value = JSON.stringify(labelsFromInputs(box));
  }

  function updateVariationVisibility(box) {
    if (!box) return;
    const enabled = box.querySelector(".variation-enabled-select")?.value === "true";
    box.classList.toggle("variations-disabled", !enabled);
  }

  function renderVariationBox(box) {
    if (!box) return;
    updateVariationVisibility(box);
    syncLabelsTextarea(box);
    ["colors", "storage", "ram", "condition"].forEach(type => {
      const textarea = getVarTextarea(box, type);
      const listBox = box.querySelector(`[data-var-list="${type}"]`);
      if (!textarea || !listBox) return;
      const lines = parseLines(textarea.value);
      listBox.innerHTML = "";
      lines.forEach((line, index) => {
        const parts = line.split("|").map(v => v.trim());
        const pill = document.createElement("span");
        pill.className = "quality-var-pill";
        if (type === "colors") {
          const dot = document.createElement("span");
          dot.className = "quality-var-dot";
          dot.style.background = parts[1] || "#e5e7eb";
          pill.appendChild(dot);
          pill.appendChild(document.createTextNode(parts[0] || line));
        } else {
          pill.textContent = line;
        }
        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          const updated = parseLines(textarea.value).filter((_, i) => i !== index);
          textarea.value = updated.join("\n");
          textarea.dispatchEvent(new Event("input", { bubbles:true }));
          renderVariationBox(box);
        });
        pill.appendChild(remove);
        listBox.appendChild(pill);
      });
    });

    renderComboTools(box);
  }


  function comboLineLabel(line) {
    const p = (line || '').split('|').map(v => v.trim());
    return [p[0], p[1], p[2], p[3]].filter(Boolean).join(' + ') + (p[4] ? ' 🖼️' : '') + (p[5] ? ' • Est: ' + p[5] : '');
  }

  function colorNameFromLine(line) { return (line || '').split('|')[0].trim(); }

  function setSelectOptions(select, values, placeholder) {
    if (!select) return;
    const old = select.value;
    select.innerHTML = '';
    const opt0 = document.createElement('option');
    opt0.value = '';
    opt0.textContent = placeholder;
    select.appendChild(opt0);
    values.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      select.appendChild(opt);
    });
    if (values.includes(old)) select.value = old;
  }

  function renderComboTools(box) {
    if (!box) return;
    const colors = parseLines(getVarTextarea(box, 'colors')?.value).map(colorNameFromLine).filter(Boolean);
    const storage = parseLines(getVarTextarea(box, 'storage')?.value);
    const ram = parseLines(getVarTextarea(box, 'ram')?.value);
    const condition = parseLines(getVarTextarea(box, 'condition')?.value);
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="color"]'), colors, 'Cor');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="storage"]'), storage, 'GB');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="ram"]'), ram, 'RAM');
    setSelectOptions(box.querySelector('.var-combo-select[data-combo="condition"]'), condition, 'Estado');

    const comboTextarea = getVarTextarea(box, 'combinations');
    const comboList = box.querySelector('[data-var-list="combinations"]');
    if (!comboTextarea || !comboList) return;
    comboList.innerHTML = '';
    parseLines(comboTextarea.value).forEach((line, index) => {
      const pill = document.createElement('span');
      pill.className = 'quality-combo-pill';
      pill.appendChild(document.createTextNode(comboLineLabel(line)));
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        const updated = parseLines(comboTextarea.value).filter((_, i) => i !== index);
        comboTextarea.value = updated.join('\n');
        comboTextarea.dispatchEvent(new Event('input', { bubbles:true }));
        renderVariationBox(box);
      });
      pill.appendChild(remove);
      comboList.appendChild(pill);
    });
  }

  function initVariationBox(box) {
    if (!box || box.dataset.variationReady === "1") return;
    box.dataset.variationReady = "1";

    box.querySelectorAll(".add-var-color").forEach(btn => {
      btn.addEventListener("click", () => {
        const nameInput = box.querySelector(".var-color-name");
        const hexInput = box.querySelector(".var-color-hex");
        const imageInput = box.querySelector(".var-color-image");
        const name = (nameInput?.value || "").trim();
        if (!name) return alert("Digite o nome da cor.");
        const line = [name, (hexInput?.value || "").trim(), (imageInput?.value || "").trim()].filter(Boolean).join("|");
        const textarea = getVarTextarea(box, "colors");
        const list = parseLines(textarea.value);
        uniquePush(list, line);
        textarea.value = list.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        if (nameInput) nameInput.value = "";
        if (imageInput) imageInput.value = "";
        renderVariationBox(box);
      });
    });

    box.querySelectorAll(".add-var-simple").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.type;
        const select = box.querySelector(`.var-simple-select[data-type="${type}"]`);
        const custom = box.querySelector(`.var-simple-custom[data-type="${type}"]`);
        const customValue = (custom?.value || "").trim();
        const value = customValue || (select?.value || "").trim();
        if (!value) return alert("Informe a variação que deseja adicionar.");
        const textarea = getVarTextarea(box, type);
        const list = parseLines(textarea.value);
        uniquePush(list, value);
        textarea.value = list.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        if (custom) custom.value = "";
        renderVariationBox(box);
      });
    });

    box.querySelectorAll(".add-var-combo").forEach(btn => {
      btn.addEventListener("click", () => {
        const color = box.querySelector('.var-combo-select[data-combo="color"]')?.value || '';
        const storage = box.querySelector('.var-combo-select[data-combo="storage"]')?.value || '';
        const ram = box.querySelector('.var-combo-select[data-combo="ram"]')?.value || '';
        const condition = box.querySelector('.var-combo-select[data-combo="condition"]')?.value || '';
        const image = (box.querySelector('.var-combo-image')?.value || '').trim();
        const stock = (box.querySelector('.var-combo-stock')?.value || '').trim();
        if (!color && !storage && !ram && !condition) return alert('Escolha pelo menos uma opção para a combinação.');
        const line = [color, storage, ram, condition, image, stock].join('|').replace(/\|+$/,'');
        const textarea = getVarTextarea(box, 'combinations');
        const list = parseLines(textarea.value);
        uniquePush(list, line);
        textarea.value = list.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        const imageInput = box.querySelector('.var-combo-image');
        const stockInput = box.querySelector('.var-combo-stock');
        if (imageInput) imageInput.value = '';
        if (stockInput) stockInput.value = '';
        renderVariationBox(box);
      });
    });

    box.querySelectorAll(".var-preset").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.type;
        const textarea = getVarTextarea(box, type);
        const current = parseLines(textarea.value);
        parseLines((btn.dataset.values || "").replace(/\\n/g, "\n")).forEach(v => uniquePush(current, v));
        textarea.value = current.join("\n");
        textarea.dispatchEvent(new Event("input", { bubbles:true }));
        renderVariationBox(box);
      });
    });

    box.querySelectorAll("textarea, select, input").forEach(el => {
      el.addEventListener("input", () => renderVariationBox(box));
      el.addEventListener("change", () => renderVariationBox(box));
    });

    box.querySelectorAll(".quality-image-picker").forEach(el => {
      el.addEventListener("focus", () => sincronizarImagensAuto());
    });

    syncLabelInputs(box);
    renderVariationBox(box);
  }

  function copyRowVariationsToModal(row) {
