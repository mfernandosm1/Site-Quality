  function normalizeProductSearch(value) {
    return String(value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function productSearchMatches(haystack, query) {
    const normalizedHaystack = normalizeProductSearch(haystack);
    const normalizedQuery = normalizeProductSearch(query);
    if (!normalizedQuery) return true;
    const hayTokens = normalizedHaystack.split(/\s+/).filter(Boolean);
    const queryTokens = normalizedQuery.split(/\s+/).filter(Boolean);
    return queryTokens.every(token => hayTokens.some(hayToken => token.length >= 3 ? hayToken.includes(token) : hayToken.startsWith(token)));
  }

  function filterTable() {
    const searchText = searchInput?.value || "";
    const selectedCategory = categoryFilter?.value || "";
    const selectedErp = erpFilter?.value || "";
    const selectedLv = lvFilter?.value || "";
    const selectedStock = stockFilter?.value || "";
    let visibleCount = 0;

    rows.forEach(row => {
      syncRowOperationalState(row);
      const searchableSelectors = [
        ".prod-name-input", ".prod-slug-input",
        'input[name="internalCode"]', 'input[name="sku"]',
        'input[name="barcode"]', 'input[name="supplierCode"]',
        'input[name="searchAlias"]'
      ];
      const searchHaystack = searchableSelectors
        .map(selector => row.querySelector(selector)?.value || "")
        .join(" ");
      const productCategory = row.querySelector(".prod-category-select")?.value || "";
      const matchesSearch = productSearchMatches(searchHaystack, searchText);
      const matchesErp = !selectedErp || row.dataset.erpActive === selectedErp;
      const matchesLv = !selectedLv || row.dataset.lvActive === selectedLv;
      const isService = row.dataset.erpCategoryType === "service";
      const stockValue = Number(row.querySelector('input[name="stock"]')?.value ?? row.dataset.stock ?? 0);
      const stockControlled = (row.querySelector('input[name="stockControlled"]')?.value || row.dataset.stockControlled) === "true";
      let matchesStock = true;
      if (selectedStock === "service") matchesStock = isService;
      else if (selectedStock === "positive") matchesStock = !isService && stockControlled && stockValue > 0;
      else if (selectedStock === "zero") matchesStock = !isService && stockControlled && stockValue <= 0;

      let matchesCategory = false;
      if (selectedCategory === "") matchesCategory = true;
      else if (selectedCategory === "[vitrine]") matchesCategory = productCategory === "";
      else matchesCategory = productCategory === selectedCategory;

      const visible = matchesSearch && matchesCategory && matchesErp && matchesLv && matchesStock;
      row.style.display = visible ? "" : "none";
      if (visible) visibleCount += 1;
    });

    if (filteredProductsCount) {
      const serverStateMatches = String(searchText).trim() === String(QUALITY_LIST_STATE.query || '').trim()
        && selectedCategory === String(QUALITY_LIST_STATE.category || '')
        && selectedErp === String(QUALITY_LIST_STATE.erpStatus || '')
        && selectedLv === String(QUALITY_LIST_STATE.lvStatus || '')
        && !selectedStock;
      filteredProductsCount.textContent = String(serverStateMatches ? (QUALITY_LIST_STATE.totalFiltered ?? visibleCount) : visibleCount);
    }
    updateSelectionCount();
  }

