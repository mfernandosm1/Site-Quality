          <textarea class="variation-hidden-data" data-var-type="condition"></textarea>
          <textarea class="variation-hidden-data" data-var-type="labels"></textarea>
          <textarea class="variation-hidden-data" data-var-type="combinations"></textarea>
          <div class="quality-variations-grid">
