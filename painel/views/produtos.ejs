                <div class="quality-compact-field">
                  <label>ERP</label>
                  <select name="erpActive" aria-label="Status ERP de <%= p.name %>">
                    <option value="true" <%= erpActiveValue ? 'selected' : '' %>>Ativo</option>
                    <option value="false" <%= !erpActiveValue ? 'selected' : '' %>>Inativo</option>
                  </select>
                </div>
                <small class="quality-channel-help">PDV, estoque, compras e financeiro.</small>
              </div>
            </td>

            <td>
              <% const rawLvActive = lvData.active !== undefined ? lvData.active : p.active; const lvActiveValue = !['false', '0', 'off', 'inativo'].includes(String(rawLvActive).toLowerCase()) && rawLvActive !== false; const listLvCategory = lvCategoryBySlug.get(String(p.category || '')); const listLvSubcategory = lvSubcategoryByKey.get(String(p.subcategory || p.subcategoria || '')); %>
              <div class="quality-status-stack quality-channel-status <%= !lvActiveValue ? 'quality-lv-controls-disabled' : '' %>">
                <div class="quality-lv-category-card"><small>Categoria LV</small><strong><%= listLvCategory?.name || (p.category ? p.category : 'Sem categoria') %></strong><% if (listLvSubcategory) { %><span>Subcategoria LV: <%= listLvSubcategory.name || listLvSubcategory.slug %></span><% } %></div>
                <div class="quality-lv-inactive-badge">○ LV Inativa</div>
                <div class="quality-compact-field quality-lv-status-field">
                  <label>Loja Virtual</label>
                  <select name="lvActive" aria-label="Status LV de <%= p.name %>">
                    <option value="true" <%= lvActiveValue ? 'selected' : '' %>>Ativo</option>
                    <option value="false" <%= !lvActiveValue ? 'selected' : '' %>>Inativo</option>
                  </select>
                </div>
                <div class="quality-compact-field">
                  <label>Vitrine</label>
                  <select name="featured">
                    <option value="true" <%= p.featured ? 'selected' : '' %>>Sim</option>
                    <option value="false" <%= !p.featured ? 'selected' : '' %>>Não</option>
                  </select>
                </div>
                <div class="quality-compact-field">
                  <label>Preço</label>
                  <select name="showPrice">
                    <option value="true" <%= p.showPrice !== false ? 'selected' : '' %>>Mostrar</option>
                    <option value="false" <%= p.showPrice === false ? 'selected' : '' %>>Ocultar</option>
                  </select>
                </div>
                <div class="quality-compact-field">
                  <label>Detalhes</label>
                  <select name="detailsEnabled">
                    <option value="true" <%= p.detailsEnabled ? 'selected' : '' %>>Sim</option>
                    <option value="false" <%= !p.detailsEnabled ? 'selected' : '' %>>Não</option>
                  </select>
                </div>
                <small class="quality-channel-help">Sincroniza somente ao clicar em Publicar.</small>
              </div>
            </td>

            <td>
              <div class="quality-resource-stack">
                <textarea name="descriptionShort" class="row-description-short" placeholder="Descrição curta..." style="display:none;"><%= p.descriptionShort || '' %></textarea>
                <textarea name="descriptionLong" class="row-description-long" placeholder="Descrição completa..." style="display:none;"><%= p.descriptionLong || '' %></textarea>
                <textarea name="tags" class="row-product-tags" style="display:none;"><%= Array.isArray(p.tags) ? p.tags.join('\n') : (p.tags || '') %></textarea>
                <textarea name="relatedManualIds" class="row-related-manual-ids" style="display:none;"><%= Array.isArray(p.relatedManualIds) ? p.relatedManualIds.join('\n') : (p.relatedManualIds || '') %></textarea>
                <textarea name="crossSellIds" class="row-cross-sell-ids" style="display:none;"><%= Array.isArray(p.crossSellIds) ? p.crossSellIds.join('\n') : (p.crossSellIds || '') %></textarea>

                <select name="image" class="prod-image-select quality-image-compact-select" data-current-val="<%= p.image || '' %>" data-lazy-images="true">
                  <option value="">Imagem...</option>
                  <% if (p.image) { %><option value="<%= p.image %>" selected><%= String(p.image).replace(/^images\//, '') %></option><% } %>
                </select>

