  function refreshLvCategoryCard(row) {
    if (!row) return;
    const card = row.querySelector('.quality-lv-category-card');
    if (!card) return;
    const categorySlug = getRowField(row, '.prod-category-select');
    const subcategorySlug = getRowField(row, '.prod-subcategory-select');
    const category = QUALITY_CATEGORIES.find(c => String(c.slug || '') === String(categorySlug || ''));
    const subcategory = QUALITY_SUBCATEGORIES.find(s => String(s.slug || '') === String(subcategorySlug || '') && (!category || Number(s.categoryId) === Number(category.id)));
    card.innerHTML = '';
    const small = document.createElement('small');
    small.textContent = 'Categoria LV';
    const strong = document.createElement('strong');
    strong.textContent = category?.name || categorySlug || 'Sem categoria';
    card.appendChild(small);
    card.appendChild(strong);
    if (subcategory) {
