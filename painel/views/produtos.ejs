  <% if ((listState?.totalPages || 1) > 1) { const qsBase = new URLSearchParams(); if(listState?.query) qsBase.set('q',listState.query); if(listState?.category) qsBase.set('categoria',listState.category); if(listState?.erpStatus) qsBase.set('erpStatus',listState.erpStatus); if(listState?.lvStatus) qsBase.set('lvStatus',listState.lvStatus); qsBase.set('pageSize',String(listState.pageSize || 250)); %>
