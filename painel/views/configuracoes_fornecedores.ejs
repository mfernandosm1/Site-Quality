<% layout('layout') -%>
<section class="supplier-settings-page">
<header class="supplier-settings-hero"><div><span>ERP · CONFIGURAÇÕES</span><h1>Cadastro de Fornecedores</h1><p>Defina campos visíveis e obrigatórios sem alterar dados já cadastrados.</p></div><div><a class="btn" href="/configuracoes">← Voltar</a> <button class="btn" id="restoreSupplierFields">Restaurar padrão</button> <button class="btn primary" id="saveSupplierFields">Salvar configurações</button></div></header>
<div id="supplierSettingsMessage" hidden></div>
<section class="supplier-settings-card supplier-settings-options">
<label class="lookup-option"><input type="checkbox" id="cnpjLookupEnabled" <%= fieldSettings.cnpjLookupEnabled !== false ? 'checked' : '' %>> <span><strong>Habilitar consulta automática de CNPJ</strong><small>Permite preencher dados cadastrais pela consulta externa.</small></span></label>
<label class="lookup-option"><input type="checkbox" id="allowDocumentEdit" <%= fieldSettings.allowDocumentEdit === true ? 'checked' : '' %>> <span><strong>Permitir alteração de CPF/CNPJ após o cadastro</strong><small>Quando desativado, o documento e o tipo de pessoa ficam protegidos nos fornecedores já cadastrados.</small></span></label>
</section>
<section class="supplier-settings-card"><div class="table-wrap"><table><thead><tr><th>Campo</th><th>Nome exibido</th><th>Aplicação</th><th>Ativo</th><th>Obrigatório</th></tr></thead><tbody>
<% (fieldSettings.fields || []).forEach(field => { %><tr data-key="<%= field.key %>"><td><strong><%= field.key %></strong></td><td>
<% if (['document','name','stateRegistration'].includes(field.key)) { %><div class="supplier-person-labels"><label><small>PF</small><input class="field-label-pf" value="<%= field.labelPf || (field.key==='document'?'CPF':field.key==='name'?'Nome':'RG') %>"></label><label><small>PJ</small><input class="field-label-pj" value="<%= field.labelPj || (field.key==='document'?'CNPJ':field.key==='name'?'Razão social':'Inscrição estadual') %>"></label></div><input class="field-label" type="hidden" value="<%= field.label %>"><% } else { %><input class="field-label" value="<%= field.label %>"><% } %>
</td><td><%= field.personType==='pj'?'Somente PJ':field.personType==='pf'?'Somente PF':(['document','name','stateRegistration'].includes(field.key)?'PF e PJ · nome dinâmico':'PF e PJ') %></td><td><input class="field-visible" type="checkbox" <%= field.visible !== false ? 'checked' : '' %> <%= ['personType','originType','name'].includes(field.key)?'disabled':'' %>></td><td><input class="field-required" type="checkbox" <%= field.required ? 'checked' : '' %> <%= field.key==='name'?'disabled':'' %>></td></tr><% }) %>
</tbody></table></div></section>
</section>
<style>.supplier-settings-page{padding:18px 22px 40px}.supplier-settings-hero,.supplier-settings-card{border:1px solid var(--line,#d6dbe3);background:var(--card,#fff);border-radius:13px;padding:18px;margin-bottom:12px}.supplier-settings-hero{display:flex;justify-content:space-between;gap:18px}.supplier-settings-hero span{font-size:10px;font-weight:900;color:#2563eb}.supplier-settings-hero h1{margin:4px 0}.supplier-settings-hero p{margin:0;color:var(--muted,#64748b)}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:650px}th,td{padding:10px;border-bottom:1px solid var(--line,#e2e8f0);text-align:left;font-size:12px}th{font-size:10px;text-transform:uppercase;color:var(--muted,#64748b)}.field-label,.field-label-pf,.field-label-pj{width:100%;padding:7px;border:1px solid var(--line,#cbd5e1);border-radius:7px;background:var(--surface-soft,var(--card,#fff));color:var(--text,#111)}.supplier-person-labels{display:grid;grid-template-columns:1fr 1fr;gap:7px}.supplier-person-labels label{display:grid;gap:3px}.supplier-person-labels small{font-size:9px;font-weight:900;text-transform:uppercase;color:var(--muted,#64748b)}.supplier-settings-options{display:grid;gap:13px}.lookup-option{display:flex;gap:9px;align-items:flex-start;font-weight:800}.lookup-option input{margin-top:3px}.lookup-option span{display:grid;gap:3px}.lookup-option small{font-weight:500;color:var(--muted,#64748b);line-height:1.35}#supplierSettingsMessage{padding:10px 12px;border-radius:9px;margin-bottom:12px}#supplierSettingsMessage.success{background:#dcfce7;color:#166534}#supplierSettingsMessage.error{background:#fee2e2;color:#991b1b}@media(max-width:760px){.supplier-settings-page{padding:14px}.supplier-settings-hero{flex-direction:column}}</style>
<script>
(()=>{const msg=document.getElementById('supplierSettingsMessage');const show=(t,c='success')=>{msg.textContent=t;msg.className=c;msg.hidden=false};const payload=()=>({cnpjLookupEnabled:document.getElementById('cnpjLookupEnabled').checked,allowDocumentEdit:document.getElementById('allowDocumentEdit').checked,fields:[...document.querySelectorAll('tbody tr')].map(row=>({key:row.dataset.key,label:row.querySelector('.field-label')?.value.trim()||'',labelPf:row.querySelector('.field-label-pf')?.value.trim()||'',labelPj:row.querySelector('.field-label-pj')?.value.trim()||'',visible:row.querySelector('.field-visible').disabled?true:row.querySelector('.field-visible').checked,required:row.querySelector('.field-required').disabled?true:row.querySelector('.field-required').checked}))});document.querySelectorAll('.field-visible').forEach(input=>input.addEventListener('change',()=>{const required=input.closest('tr').querySelector('.field-required');if(!input.checked){required.checked=false;required.disabled=true}else if(required.closest('tr').dataset.key!=='name') required.disabled=false;}));document.getElementById('saveSupplierFields').onclick=async()=>{try{const r=await fetch('/configuracoes/fornecedores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload())});const j=await r.json();if(!r.ok)throw new Error(j.message);show(j.message)}catch(e){show(e.message,'error')}};document.getElementById('restoreSupplierFields').onclick=async()=>{if(!confirm('Restaurar o padrão do cadastro de fornecedores?'))return;try{const r=await fetch('/configuracoes/fornecedores/restaurar',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const j=await r.json();if(!r.ok)throw new Error(j.message);location.reload()}catch(e){show(e.message,'error')}}})();
</script>
