ed{background:color-mix(in srgb,#f59e0b 14%,var(--card));color:#b45309}.mc-status.posted{background:color-mix(in srgb,#16a34a 14%,var(--card));color:#15803d}.mc-status.off{background:color-mix(in srgb,#64748b 13%,var(--card));color:var(--muted)}.mc-actions{display:flex;gap:4px}.mc-actions button,.mc-link-btn{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:7px;padding:5px 7px;font:inherit;font-size:9px;cursor:pointer;text-decoration:none}.mc-actions .primary{border-color:var(--brand);color:var(--brand);font-weight:900}.mc-loading,.mc-error,.mc-empty{padding:28px;text-align:center;color:var(--muted)}.mc-error{color:#dc2626}.mc-empty{display:grid;gap:5px}.mc-grid-two{display:grid;grid-template-columns:minmax(300px,.7fr) minmax(420px,1.3fr);gap:12px}.mc-goal-form{padding:15px;display:grid;gap:12px}.mc-goal-form label{display:grid;gap:5px}.mc-money-input,.mc-percent-input{display:flex;align-items:center;border:1px solid var(--line);border-radius:9px;background:var(--card);overflow:hidden}.mc-money-input>b,.mc-percent-input>b{padding:0 9px;color:var(--muted);font-size:11px}.mc-money-input input,.mc-percent-input input{border:0!important;border-radius:0!important;min-width:0;width:100%}.mc-goal-actions{display:flex;justify-content:flex-end}.mc-user-goals{display:grid}.mc-user-goal{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 14px;border-bottom:1px solid var(--line)}.mc-user-goal>span{display:grid}.mc-user-goal small{color:var(--muted);font-size:9px}.mc-user-goal .mc-money-input{width:180px}.mc-rule-list{display:grid}.mc-rule-item{display:grid;grid-template-columns:minmax(150px,.7fr) minmax(230px,1.2fr) 1fr auto;gap:12px;align-items:center;padding:11px 14px;border-bottom:1px solid var(--line)}.mc-rule-tags{display:flex;gap:4px;flex-wrap:wrap}.mc-rule-tags span,.mc-rule-tags em{padding:4px 6px;border-radius:999px;background:color-mix(in srgb,var(--card) 88%,var(--text));font-size:9px;color:var(--text);font-style:normal}.mc-modal{position:fixed;inset:0;z-index:1400;background:rgba(15,23,42,.58);display:grid;place-items:center;padding:18px}.mc-modal[hidden]{display:none}.mc-modal-card{position:relative;width:min(720px,96vw);max-height:92vh;overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 28px 80px rgba(0,0,0,.3)}.mc-modal-wide{width:min(1120px,97vw)}.mc-rule-modal{width:min(940px,97vw)}.mc-finance-card{width:min(480px,96vw);display:grid;gap:10px}.mc-close{position:absolute;right:11px;top:9px;border:0;background:transparent;color:var(--muted);font-size:26px;cursor:pointer}.mc-modal-head>span{font-size:9px;letter-spacing:.13em;font-weight:900;color:var(--muted)}.mc-modal-head h2{margin:3px 0;color:var(--text)}.mc-modal-head p{margin:0 0 13px;color:var(--muted);font-size:11px}.mc-rule-main{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.mc-rule-main label,.mc-finance-card label,.mc-tier-row label,.mc-category-row label{display:grid;gap:4px}.mc-switch-line{grid-column:1/-1;display:flex!important;align-items:flex-start;gap:8px;padding:9px;border:1px solid var(--line);border-radius:10px}.mc-switch-line span{display:grid;gap:2px}.mc-switch-line small{font-size:9px;color:var(--muted)}.mc-operation-types{border:1px solid var(--line);border-radius:10px;margin:12px 0;padding:10px;display:flex;gap:18px}.mc-operation-types legend{font-size:10px;font-weight:900;color:var(--muted);padding:0 5px}.mc-rule-section{border-top:1px solid var(--line);padding-top:13px;margin-top:13px}.mc-rule-section-head{display:flex;justify-content:space-between;gap:12px;align-items:start;margin-bottom:8px}.mc-rule-section-head h3{margin:0 0 2px;font-size:14px;color:var(--text)}.mc-rule-section-head p{margin:0;color:var(--muted);font-size:10px}.mc-tier-list,.mc-category-list{display:grid;gap:6px}.mc-tier-row{display:grid;grid-template-columns:1.1fr .8fr .7fr 34px;gap:6px;align-items:end;padding:8px;border:1px solid var(--line);border-radius:10px}.mc-category-row{display:grid;grid-template-columns:1fr 180px 34px;gap:6px;align-items:end;padding:8px;border:1px solid var(--line);border-radius:10px}.mc-tier-row>button,.mc-category-row>button{height:38px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:#dc2626;font-size:19px;cursor:pointer}.mc-note{padding:9px 10px;margin-top:8px;border-radius:9px;background:color-mix(in srgb,var(--brand) 7%,var(--card));color:var(--muted);font-size:10px;line-height:1.45}.mc-modal-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:14px}.mc-detail-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0 13px}.mc-detail-summary div{border:1px solid var(--line);border-radius:10px;padding:9px}.mc-detail-summary span{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;font-weight:900}.mc-detail-summary b{display:block;color:var(--text);font-size:15px;margin-top:3px}.mc-warning{padding:9px;border-radius:9px;background:color-mix(in srgb,#f59e0b 13%,var(--card));color:var(--text);margin-bottom:10px}.mc-finance-amount{font-size:27px;font-weight:900;color:#16a34a;padding:9px 0}.mc-toast{position:fixed;right:18px;bottom:18px;z-index:1700;background:#166534;color:#fff;padding:10px 14px;border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.25);font-size:12px;font-weight:800}.mc-toast.error{background:#b91c1c}.mc-empty-cell{text-align:center!important;padding:28px!important;color:var(--muted)!important}
@media(max-width:1250px){.mc-summary{grid-template-columns:repeat(3,1fr)}}@media(max-width:1050px){.mc-summary{grid-template-columns:repeat(2,1fr)}.mc-grid-two{grid-template-columns:1fr}.mc-rule-item{grid-template-columns:1fr 1fr}.mc-rule-item>.btn{justify-self:start}.mc-rule-main{grid-template-columns:1fr 1fr}}@media(max-width:700px){.mc-hero{display:grid}.mc-period-card{display:grid;grid-template-columns:1fr 1fr}.mc-period-card label{min-width:0}.mc-summary{grid-template-columns:1fr 1fr}.mc-rule-item{grid-template-columns:1fr}.mc-rule-main,.mc-tier-row,.mc-category-row,.mc-detail-summary{grid-template-columns:1fr}.mc-tier-row>button,.mc-category-row>button{width:44px}.mc-user-goal{align-items:stretch;display:grid}.mc-user-goal .mc-money-input{width:100%}}
