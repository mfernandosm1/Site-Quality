  function blockTargetSelect(stepIndex, optionIndex, selected) {
    var currentId = String((document.querySelector('#blockEditorForm input[name="id"]') || {}).value || '');
    var value = String(selected || '');
    var html = '<option value="">Encerrar fluxo após esta escolha</option>';
    blocosSalvos.forEach(function (block) {
      if (!block || !block.id || String(block.id) === currentId) return;
      var isSelected = value === String(block.id) || value.toLowerCase() === String(block.nome || '').toLowerCase();
      html += '<option value="' + esc(block.id) + '"' + (isSelected ? ' selected' : '') + '>' + esc(block.nome || 'Bloco') + '</option>';
    });
    return '<select class="qw-select" title="Bloco que será executado quando o cliente escolher esta opção" onchange="updateOption(' + stepIndex + ',' + optionIndex + ',\'proximoBloco\',this.value)">' + html + '</select>';
  }

  function optionActionSelect(stepIndex, optionIndex, selected) {
