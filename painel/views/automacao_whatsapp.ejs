  .qw-operational .qw-tabs{gap:5px;margin-bottom:8px;flex-wrap:nowrap;overflow-x:auto}
  .qw-operational .qw-tab{padding:6px 10px;border-radius:9px;font-size:11px;white-space:nowrap}
  .qw-inbox-summary{display:flex;align-items:center;gap:8px;margin-bottom:8px;padding:5px 8px;background:#fff;border:1px solid var(--qw-line);border-radius:11px;box-shadow:0 4px 16px rgba(15,23,42,.04)}
  .qw-summary-item{display:flex;align-items:center;gap:5px;padding:4px 9px;border-right:1px solid #eef2f7;font-size:11px;color:#64748b}
  .qw-summary-item:last-child{border-right:0}.qw-summary-item strong{font-size:14px;color:#111827}.qw-summary-icon{font-size:12px}
  .qw-summary-item.urgent .qw-summary-icon{color:#ef4444}.qw-summary-item.success .qw-summary-icon{color:#22c55e}
  .qw-operational .qw-inbox-shell{grid-template-columns:285px minmax(0,1fr);gap:7px;min-height:0;height:calc(100vh - 205px)}
  .qw-operational .qw-inbox-list,.qw-operational .qw-inbox-chat{border-radius:12px;box-shadow:0 5px 18px rgba(15,23,42,.05)}
  .qw-operational .qw-inbox-list-head{padding:7px}.qw-operational .qw-inbox-list-head .qw-input{padding:7px 9px;border-radius:9px;font-size:12px}
  .qw-operational .qw-conversation-list{max-height:none;height:calc(100% - 47px)}
  .qw-operational .qw-conversation-item{padding:8px 8px 8px 12px;min-height:44px}
  .qw-operational .qw-conversation-title{font-size:12px}.qw-operational .qw-conversation-time{font-size:10px}
  .qw-operational .qw-conversation-preview{font-size:10.5px}.qw-operational .qw-unread-count{min-width:18px;height:18px;font-size:10px}
  .qw-operational .qw-inbox-chat{display:flex;flex-direction:column;min-height:0}
  .qw-operational .qw-inbox-chat-head{padding:7px 10px;min-height:42px}
  .qw-operational .qw-contact-heading h2{font-size:14px}.qw-operational .qw-contact-sub{font-size:10px}
  .qw-operational .qw-icon-btn{width:32px;height:32px;font-size:16px}
  .qw-operational .qw-inbox-chat-body{flex:1;min-height:0;max-height:none;padding:12px;gap:6px}
  .qw-operational .qw-inbox-msg{font-size:12px;padding:7px 9px;max-width:min(72%,620px)}
  .qw-operational .qw-inbox-msg small{font-size:9px;margin-top:3px}
  .qw-operational .qw-inbox-composer{padding:6px 8px}.qw-operational .qw-composer-bar{gap:3px}
  .qw-operational .qw-inbox-compose-text{min-height:36px;max-height:90px;padding:8px 12px;font-size:12px}
  .qw-operational .qw-popover{bottom:52px}.qw-operational .qw-inbox-send-result{margin-top:4px;padding:6px 8px}
  @media(max-width:1200px){.qw-operational .qw-title p{display:none}.qw-operational .qw-inbox-shell{grid-template-columns:255px minmax(0,1fr)}}
  @media(max-width:950px){.qw-operational{padding:9px}.qw-operational .qw-inbox-shell{height:auto;grid-template-columns:1fr}.qw-operational .qw-conversation-list{height:auto;max-height:220px}.qw-operational .qw-inbox-chat-body{min-height:430px}.qw-inbox-summary{overflow-x:auto}.qw-summary-item{white-space:nowrap}}


  /* v0.5.9 — Painel Comercial com dados existentes do Inbox */
  .qw-commercial-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:10px}
  .qw-commercial-kpi{background:#fff;border:1px solid var(--qw-line);border-radius:14px;padding:13px;box-shadow:0 5px 18px rgba(15,23,42,.05)}
  .qw-commercial-kpi .value{font-size:25px;font-weight:900;line-height:1}.qw-commercial-kpi .label{font-size:11px;color:#64748b;margin-top:6px}.qw-commercial-kpi .hint{font-size:10px;color:#94a3b8;margin-top:4px}
  .qw-commercial-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:10px}
  .qw-commercial-stack{display:grid;gap:10px}.qw-commercial-card{padding:14px}.qw-commercial-card h2{margin-bottom:4px}
  .qw-pipeline{display:grid;grid-template-columns:repeat(6,minmax(110px,1fr));gap:7px;overflow-x:auto;padding-bottom:3px}
  .qw-pipeline-stage{border:1px solid var(--qw-line);border-top:4px solid #94a3b8;border-radius:12px;padding:11px;background:#fff;min-width:110px}.qw-pipeline-stage strong{display:block;font-size:23px}.qw-pipeline-stage span{font-size:11px;color:#64748b}.qw-pipeline-stage.new{border-top-color:#3b82f6}.qw-pipeline-stage.in_progress{border-top-color:#eab308}.qw-pipeline-stage.pending{border-top-color:#f97316}.qw-pipeline-stage.completed_sale{border-top-color:#22c55e}.qw-pipeline-stage.lost{border-top-color:#ef4444}.qw-pipeline-stage.no_potential{border-top-color:#64748b}
  .qw-commercial-tools{display:grid;grid-template-columns:1.4fr .8fr .8fr;gap:8px;margin:10px 0}.qw-commercial-list{display:grid;gap:7px;max-height:510px;overflow:auto}
  .qw-opportunity{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid #eef2f7;border-radius:12px;padding:10px;text-decoration:none;color:var(--qw-text);background:#fff}.qw-opportunity:hover{background:#f8fafc}.qw-opportunity[hidden]{display:none}.qw-opportunity-name{font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.qw-opportunity-meta{font-size:11px;color:#64748b;margin-top:3px}.qw-opportunity-side{text-align:right;white-space:nowrap}.qw-opportunity-wait{font-size:10px;font-weight:900;color:#b91c1c;background:#fee2e2;border-radius:999px;padding:4px 7px}.qw-opportunity-ok{font-size:10px;font-weight:900;color:#166534;background:#dcfce7;border-radius:999px;padding:4px 7px}
  .qw-origin-row,.qw-interest-row{display:grid;grid-template-columns:minmax(100px,1fr) 2fr auto;gap:8px;align-items:center;margin:9px 0;font-size:12px}.qw-bar{height:8px;border-radius:999px;background:#e2e8f0;overflow:hidden}.qw-bar span{display:block;height:100%;background:#2563eb;border-radius:inherit}.qw-interest-row{grid-template-columns:minmax(0,1fr) auto}.qw-interest-row strong{font-size:13px}.qw-commercial-empty{padding:16px;border:1px dashed #cbd5e1;border-radius:12px;text-align:center;color:#64748b}
  @media(max-width:1100px){.qw-commercial-kpis{grid-template-columns:repeat(3,1fr)}.qw-commercial-layout{grid-template-columns:1fr}}
  @media(max-width:700px){.qw-commercial-kpis{grid-template-columns:repeat(2,1fr)}.qw-commercial-tools{grid-template-columns:1fr}.qw-commercial-kpi:last-child{grid-column:span 2}}


  /* v0.6.0 — grupos no Inbox */
  .qw-inbox-type-filters{display:flex;gap:5px;margin-top:6px}.qw-type-filter{border:1px solid var(--qw-line);background:#fff;border-radius:8px;padding:5px 8px;font-size:10px;font-weight:900;cursor:pointer}.qw-type-filter.active{background:#111827;color:#fff;border-color:#111827}
  .qw-group-badge{font-size:10px;background:#ede9fe;color:#6d28d9;border-radius:999px;padding:3px 7px;margin-left:5px}.qw-message-author{font-size:11px;font-weight:900;color:#2563eb;margin-bottom:3px}.qw-group-header-icon{font-size:18px;margin-right:5px}
  /* v0.6.1 — mídia temporária, sem cópia automática no painel */
  .qw-remote-media{display:grid;gap:7px}.qw-remote-media-note{font-size:10px;color:#64748b;background:rgba(255,255,255,.58);border-radius:8px;padding:6px 8px}.qw-remote-media .qw-inbox-document{border:1px solid rgba(148,163,184,.35)}


  /* v0.6.2 — Central de Armazenamento */
  .qw-storage-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}
  .qw-storage-kpi{background:#fff;border:1px solid var(--qw-line);border-radius:16px;padding:15px;box-shadow:var(--qw-shadow)}
  .qw-storage-kpi .value{font-size:27px;font-weight:900;line-height:1}.qw-storage-kpi .label{font-size:12px;color:var(--qw-muted);margin-top:7px}.qw-storage-kpi .hint{font-size:10px;color:#94a3b8;margin-top:4px}
  .qw-storage-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);gap:14px}.qw-storage-stack{display:grid;gap:14px}
  .qw-health-list{display:grid;gap:9px}.qw-health-row{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:11px 12px;border:1px solid #eef2f7;border-radius:12px;background:#fff}.qw-health-row strong{white-space:nowrap}.qw-health-ok{color:#166534}.qw-health-warn{color:#b45309}.qw-health-bad{color:#b91c1c}
  .qw-clean-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.qw-clean-action{border:1px solid var(--qw-line);border-radius:14px;padding:13px;background:#fff}.qw-clean-action h3{font-size:14px;margin:0 0 5px}.qw-clean-action p{font-size:11px;color:var(--qw-muted);min-height:31px;margin:0 0 10px}.qw-clean-action form{margin:0}.qw-clean-action .qw-btn{width:100%;font-size:12px;padding:9px}
  .qw-storage-note{font-size:11px;color:var(--qw-muted);line-height:1.5}.qw-storage-path{font-family:Consolas,monospace;font-size:11px;background:#f8fafc;border:1px solid var(--qw-line);border-radius:10px;padding:9px;word-break:break-all}
  @media(max-width:1000px){.qw-storage-kpis{grid-template-columns:repeat(2,1fr)}.qw-storage-layout{grid-template-columns:1fr}}@media(max-width:620px){.qw-storage-kpis,.qw-clean-grid{grid-template-columns:1fr}}

</style>

<div class="qw-wrap <%= (tab === 'inbox' || tab === 'comercial') ? 'qw-operational' : '' %>">
  <div class="qw-header">
    <div class="qw-title">
      <h1>💬 Automação WhatsApp</h1>
      <p>Central de atendimento, blocos, mídias e ferramentas do WhatsApp. Versão <strong><%= version %></strong> — modo operacional compacto para atendimento diário.</p>
    </div>
    <div class="qw-actions">
      <a class="qw-btn dark qw-header-action" href="/" title="Voltar ao Dashboard"><span class="qw-action-icon">←</span><span class="qw-action-label">Voltar ao Dashboard</span></a>
      <a class="qw-btn primary qw-header-action" href="/automacao-whatsapp?tab=blocos" title="Novo bloco"><span class="qw-action-icon">＋</span><span class="qw-action-label">Novo bloco</span></a>
    </div>
  </div>

  <% if (flash) { %><div class="qw-flash"><%= flash %></div><% } %>

  <div class="qw-tabs">
    <a class="qw-tab <%= tab === 'dashboard' ? 'active' : '' %>" href="/automacao-whatsapp">Dashboard</a>
    <a class="qw-tab <%= tab === 'inbox' ? 'active' : '' %>" href="/automacao-whatsapp?tab=inbox">Inbox</a>
    <a class="qw-tab <%= tab === 'comercial' ? 'active' : '' %>" href="/automacao-whatsapp?tab=comercial">Painel Comercial</a>
    <a class="qw-tab <%= tab === 'blocos' ? 'active' : '' %>" href="/automacao-whatsapp?tab=blocos">Blocos</a>
    <a class="qw-tab <%= tab === 'midias' ? 'active' : '' %>" href="/automacao-whatsapp?tab=midias">Mídias</a>
    <a class="qw-tab <%= tab === 'simulador' ? 'active' : '' %>" href="/automacao-whatsapp?tab=simulador">Simulador</a>
    <a class="qw-tab <%= tab === 'aniversariantes' ? 'active' : '' %>" href="/automacao-whatsapp?tab=aniversariantes">Aniversariantes</a>
    <a class="qw-tab <%= tab === 'configuracoes' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes">Configurações</a>
  </div>

  <% if (tab === 'configuracoes') { %>
    <div class="qw-settings-nav">
      <a class="qw-settings-link <%= settingsSection === 'geral' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=geral">⚙️ Geral</a>
      <a class="qw-settings-link <%= settingsSection === 'conexao' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=conexao">🔗 Conexão</a>
      <a class="qw-settings-link <%= settingsSection === 'logs' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=logs">📜 Logs</a>
      <a class="qw-settings-link <%= settingsSection === 'armazenamento' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=armazenamento">💾 Armazenamento</a>
    </div>
  <% } %>

  <% if (tab === 'dashboard') { %>
    <div class="qw-grid">
      <div class="qw-card qw-kpi qw-span-3"><div class="icon">📦</div><div class="value"><%= blocos.length %></div><div class="label">Blocos cadastrados</div></div>
      <div class="qw-card qw-kpi qw-span-3"><div class="icon">🎂</div><div class="value"><%= fila.length %></div><div class="label">Fila atual</div></div>
      <div class="qw-card qw-kpi qw-span-3"><div class="icon">📜</div><div class="value"><%= logs.length %></div><div class="label">Logs salvos</div></div>
      <div class="qw-card qw-kpi qw-span-3"><div class="icon">📱</div><div class="value" style="font-size:20px"><%= whatsapp.status === 'conectado' ? 'CONECTADO' : 'OFFLINE' %></div><div class="label">Sessão WhatsApp</div></div>

      <div class="qw-card qw-span-8">
        <h2>🧭 Status do módulo</h2>
        <div class="qw-status">
          <span class="qw-pill green">v0.4.0: blocos avançados</span>
          <span class="qw-pill <%= whatsapp.status === 'conectado' ? 'green' : (whatsapp.status === 'erro' ? 'red' : 'orange') %>"><%= whatsapp.message %></span>
          <span class="qw-pill green">Simulador disponível</span>
        </div>
        <p class="qw-muted" style="margin-top:12px">A conexão usa LocalAuth e mantém a sessão no computador. Os envios desta versão são exclusivamente manuais para um número de teste.</p>
      </div>
      <div class="qw-card qw-span-4">
        <h2>🛡️ Segurança operacional</h2>
        <p class="sub">Base inicial para evitar erro e reduzir risco de bloqueio.</p>
        <div class="qw-warning">Nenhuma mensagem é disparada automaticamente. Cada texto, mídia ou bloco exige uma ação manual na aba “Conexão e teste”.</div>
      </div>
      <div class="qw-card qw-span-12">
        <h2>📦 Últimos blocos</h2>
        <% if (!blocos.length) { %><div class="qw-empty">Nenhum bloco ainda.</div><% } else { %>
          <table class="qw-table"><thead><tr><th>Nome</th><th>Gatilho</th><th>Etapas</th><th>Status</th><th>Ações</th></tr></thead><tbody>
          <% blocos.slice(0,8).forEach(function(b){ %>
            <tr><td><strong><%= b.nome %></strong><br><span class="qw-muted"><%= b.descricao || 'Sem descrição' %></span></td><td><%= b.gatilho || '—' %></td><td><%= (b.etapas || []).length %></td><td><%= b.ativo ? 'Ativo' : 'Inativo' %></td><td><a class="qw-link" href="/automacao-whatsapp?tab=blocos&edit=<%= b.id %>">Editar</a></td></tr>
          <% }) %>
          </tbody></table>
        <% } %>
      </div>
    </div>
  <% } %>



  <% if (tab === 'comercial') {
    const statusLabelsCommercial = {new:'Novos',in_progress:'Em andamento',pending:'Pendentes',completed_sale:'Vendas concluídas',lost:'Perdidos',no_potential:'Sem potencial'};
    const originLabelsCommercial = {site_quality:'Site Quality',instagram:'Instagram',whatsapp_direct:'WhatsApp direto',campaign:'Campanha',referral:'Indicação',unknown:'Desconhecida'};
    const formatResponseTime = function(seconds){ if(seconds===null || seconds===undefined) return '—'; if(seconds<60) return seconds+'s'; const min=Math.round(seconds/60); if(min<60) return min+' min'; return (seconds/3600).toFixed(1).replace('.',',')+' h'; };
    const maxOrigin = Math.max(1,...Object.values(commercialDashboard.byOrigin||{}));
  %>
    <div class="qw-commercial-kpis">
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.total %></div><div class="label">Conversas comerciais</div><div class="hint">Base total já registrada</div></div>
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.activePipeline %></div><div class="label">Oportunidades abertas</div><div class="hint">Novos + andamento + pendentes</div></div>
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.awaitingResponse %></div><div class="label">Aguardando atendimento</div><div class="hint">Cliente enviou a última mensagem</div></div>
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.completedSales %></div><div class="label">Vendas concluídas</div><div class="hint">Status marcado no Inbox</div></div>
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.conversionRate %>%</div><div class="label">Conversão registrada</div><div class="hint">Vendas ÷ vendas + perdidos</div></div>
    </div>

    <div class="qw-commercial-layout">
      <div class="qw-commercial-stack">
        <div class="qw-card qw-commercial-card">
          <h2>📊 Funil comercial</h2><p class="sub">Distribuição atual das conversas pelos status já usados no Inbox.</p>
          <div class="qw-pipeline">
            <% Object.keys(statusLabelsCommercial).forEach(function(key){ %><div class="qw-pipeline-stage <%= key %>"><strong><%= commercialDashboard.byStatus[key] || 0 %></strong><span><%= statusLabelsCommercial[key] %></span></div><% }) %>
          </div>
        </div>
        <div class="qw-card qw-commercial-card">
          <h2>🎯 Oportunidades abertas</h2><p class="sub">Lista operacional para localizar rapidamente quem precisa de atenção.</p>
          <div class="qw-commercial-tools">
            <input class="qw-input" id="commercialSearch" placeholder="🔎 Buscar nome, número ou produto" oninput="filterCommercialOpportunities()">
            <select class="qw-select" id="commercialStatusFilter" onchange="filterCommercialOpportunities()"><option value="">Todos os status</option><% Object.entries(statusLabelsCommercial).slice(0,3).forEach(function(entry){ %><option value="<%= entry[0] %>"><%= entry[1] %></option><% }) %></select>
            <select class="qw-select" id="commercialAttentionFilter" onchange="filterCommercialOpportunities()"><option value="">Todos</option><option value="waiting">Aguardando resposta</option><option value="answered">Respondidos</option></select>
          </div>
          <div class="qw-commercial-list" id="commercialOpportunityList">
            <% if(!commercialDashboard.opportunities.length){ %><div class="qw-commercial-empty">Nenhuma oportunidade aberta.</div><% } %>
            <% commercialDashboard.opportunities.forEach(function(c){ const search=String((c.name||'')+' '+(c.phone||'')+' '+(c.interestProduct||'')).toLowerCase(); %>
              <a class="qw-opportunity" href="/automacao-whatsapp?tab=inbox&conversation=<%= c.id %>" data-search="<%= search %>" data-status="<%= c.commercialStatus || 'new' %>" data-attention="<%= c.awaitingResponse ? 'waiting':'answered' %>">
                <div><div class="qw-opportunity-name"><%= c.name || c.phone %></div><div class="qw-opportunity-meta"><%= statusLabelsCommercial[c.commercialStatus] || 'Novo' %> · <%= originLabelsCommercial[c.origin] || 'Origem desconhecida' %><% if(c.interestProduct){ %> · Interesse: <%= c.interestProduct %><% } %></div></div>
                <div class="qw-opportunity-side"><span class="<%= c.awaitingResponse?'qw-opportunity-wait':'qw-opportunity-ok' %>"><%= c.awaitingResponse?'Aguardando':'Respondido' %></span></div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="qw-commercial-stack">
        <div class="qw-card qw-commercial-card"><h2>⏱️ Atendimento</h2><p class="sub">Média calculada somente nas conversas que já possuem primeira resposta registrada.</p><div style="font-size:34px;font-weight:900;margin:14px 0 4px"><%= formatResponseTime(commercialDashboard.averageFirstResponseSeconds) %></div><div class="qw-muted" style="font-size:12px">Tempo médio até a primeira resposta</div></div>
        <div class="qw-card qw-commercial-card"><h2>🌎 Origem das conversas</h2><p class="sub">Origem automática ou corrigida manualmente no contato.</p><% Object.entries(originLabelsCommercial).forEach(function(entry){ const count=commercialDashboard.byOrigin[entry[0]]||0; %><div class="qw-origin-row"><span><%= entry[1] %></span><div class="qw-bar"><span style="width:<%= Math.round((count/maxOrigin)*100) %>%"></span></div><strong><%= count %></strong></div><% }) %></div>
        <div class="qw-card qw-commercial-card"><h2>📱 Produtos de interesse</h2><p class="sub">Interesses identificados ou preenchidos manualmente no Inbox.</p><% if(!commercialDashboard.topInterests.length){ %><div class="qw-commercial-empty">Nenhum produto de interesse registrado.</div><% } %><% commercialDashboard.topInterests.forEach(function(item){ %><div class="qw-interest-row"><span><%= item.name %></span><strong><%= item.total %></strong></div><% }) %></div>
      </div>
    </div>
  <% } %>

  <% if (tab === 'inbox') {
    const statusLabels = {new:'Novo contato',in_progress:'Em andamento',pending:'Pendente',completed_sale:'Venda concluída',lost:'Perdido',no_potential:'Sem potencial'};
    const originLabels = {site_quality:'Site Quality',instagram:'Instagram',whatsapp_direct:'WhatsApp direto',campaign:'Campanha',referral:'Indicação',unknown:'Desconhecida'};
    const relativeTime = function(value){
      try {
        const date = new Date(value), diff = Date.now() - date.getTime(), min = Math.floor(diff/60000), hours = Math.floor(diff/3600000), days = Math.floor(diff/86400000);
        if(min < 1) return 'Agora'; if(min < 60) return min+' min'; if(hours < 24) return date.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
        if(days === 1) return 'Ontem'; if(days < 7) return date.toLocaleDateString('pt-BR',{weekday:'short'}).replace('.','');
        return date.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'});
      } catch { return '—'; }
    };
    const formatDateTime = function(value){ try{return new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(value));}catch{return '—';} };
  %>
    <div class="qw-inbox-summary" aria-label="Resumo do Inbox">
      <div class="qw-summary-item"><span class="qw-summary-icon">💬</span><strong><%= inboxSummary.total %></strong><span>Conversas</span></div>
      <div class="qw-summary-item urgent"><span class="qw-summary-icon">●</span><strong><%= inboxSummary.awaitingResponse %></strong><span>Aguardando</span></div>
      <div class="qw-summary-item"><span class="qw-summary-icon">🆕</span><strong><%= inboxSummary.newContacts %></strong><span>Novos</span></div>
      <div class="qw-summary-item success"><span class="qw-summary-icon">✓</span><strong><%= inboxSummary.completedSales %></strong><span>Vendas</span></div>
      <div class="qw-summary-item"><span class="qw-summary-icon">👥</span><strong><%= inboxSummary.groups || 0 %></strong><span>Grupos</span></div>
    </div>

    <% if (!inboxConversations.length) { %>
      <div class="qw-card qw-inbox-empty"><div><div class="qw-inbox-empty-icon">💬</div><h2>Nenhuma conversa registrada</h2><p class="qw-muted">As novas mensagens aparecerão aqui automaticamente.</p></div></div>
    <% } else { %>
      <div class="qw-inbox-shell">
        <div class="qw-card qw-inbox-list">
          <div class="qw-inbox-list-head"><input class="qw-input" id="inboxSearch" placeholder="🔎 Buscar conversa" oninput="filterInboxConversations()"><div class="qw-inbox-type-filters"><button type="button" class="qw-type-filter active" data-inbox-type="all" onclick="setInboxTypeFilter('all',this)">Todos</button><button type="button" class="qw-type-filter" data-inbox-type="contact" onclick="setInboxTypeFilter('contact',this)">Contatos</button><button type="button" class="qw-type-filter" data-inbox-type="group" onclick="setInboxTypeFilter('group',this)">Grupos</button></div></div>
          <div class="qw-conversation-list" id="inboxConversationList">
            <% inboxConversations.forEach(function(c){ const selected = selectedConversation && selectedConversation.id === c.id; const unread=Number(c.unreadCount||0); %>
              <a class="qw-conversation-item status-<%= c.commercialStatus || 'new' %> <%= unread ? 'has-unread':'' %> <%= selected ? 'active':'' %>" data-type="<%= c.conversationType || 'contact' %>" data-search="<%= String((c.name||'')+' '+(c.phone||'')+' '+(c.lastMessageAuthor||'')).toLowerCase() %>" href="/automacao-whatsapp?tab=inbox&conversation=<%= encodeURIComponent(c.id) %>">
                <div class="qw-conversation-top"><span class="qw-conversation-title"><%= c.conversationType==='group' ? '👥 ' : '' %><%= c.name || c.phone %><% if(c.conversationType==='group'){ %><span class="qw-group-badge">Grupo</span><% } %></span><span class="qw-conversation-time"><%= relativeTime(c.lastMessageAt) %></span></div>
                <div class="qw-conversation-bottom"><span class="qw-conversation-preview"><%= c.lastMessageDirection==='outgoing' ? '✓ ' : '' %><%= c.conversationType==='group' && c.lastMessageAuthor ? c.lastMessageAuthor+': ' : '' %><%= c.lastMessageText || 'Mídia' %></span><% if(unread){ %><span class="qw-unread-count"><%= unread > 99 ? '99+' : unread %></span><% } %></div>
              </a>
            <% }) %>
          </div>
        </div>

        <% if (selectedConversation) { %>
          <div class="qw-card qw-inbox-chat">
            <div class="qw-inbox-chat-head">
              <div class="qw-contact-heading"><h2 style="margin:0"><%= selectedConversation.conversationType==='group' ? '👥 ' : '' %><%= selectedConversation.name || selectedConversation.phone %></h2><div class="qw-contact-sub"><% if(selectedConversation.conversationType==='group'){ %><%= selectedConversation.groupParticipantCount ? selectedConversation.groupParticipantCount+' participantes · ' : '' %>Grupo do WhatsApp<% } else { %><span class="qw-chat-status-dot <%= selectedConversation.awaitingResponse?'wait':'' %>"></span><%= selectedConversation.awaitingResponse?'Aguardando resposta':'Respondido' %> · <%= selectedConversation.phoneResolved ? ('+'+selectedConversation.phone) : 'número pendente' %><% } %></div></div>
              <div class="qw-chat-toolbar">
                <% if(selectedConversation.conversationType!=='group'){ %><button class="qw-icon-btn" type="button" title="Dados do contato" onclick="openContactDrawer()">👤</button><% } %>
                <button class="qw-icon-btn" type="button" title="Mais ações" onclick="openConversationMenu(event)">⋮</button>
              </div>
            </div>
            <div class="qw-inbox-chat-body" id="inboxChatBody">
              <% if (!selectedMessages.length) { %><div class="qw-wait">Nenhuma mensagem salva.</div><% } %>
              <% selectedMessages.forEach(function(m){ var media=m.media||null; var mediaUrl='/automacao-whatsapp/inbox/media/'+encodeURIComponent(selectedConversation.id)+'/'+encodeURIComponent(m.id); %><div class="qw-inbox-msg <%= m.direction %>"><% if(selectedConversation.conversationType==='group' && m.authorName){ %><div class="qw-message-author"><%= m.authorName %></div><% } %>
                <% if(m.hasMedia && media && media.stored){ %><div class="qw-inbox-media">
                  <% if(media.kind==='image'){ %><a href="<%= mediaUrl %>" target="_blank" rel="noopener"><img src="<%= mediaUrl %>" alt="<%= media.originalName || 'Imagem' %>" loading="lazy"></a><% } %>
                  <% if(media.kind==='audio'){ %><audio controls preload="metadata" src="<%= mediaUrl %>"></audio><% } %>
                  <% if(media.kind==='video'){ %><video controls preload="metadata" src="<%= mediaUrl %>"></video><% } %>
                  <% if(media.kind==='document'){ %><a class="qw-inbox-document" href="<%= mediaUrl %>" target="_blank" rel="noopener"><span class="qw-inbox-document-icon">📄</span><span class="qw-inbox-document-info"><span class="qw-inbox-document-name"><%= media.originalName || media.filename || 'Documento' %></span><span class="qw-inbox-document-meta"><%= media.mime || 'Arquivo' %><%= media.size ? ' · '+Math.max(1,Math.round(media.size/1024))+' KB' : '' %></span></span></a><% } %>
                  <div class="qw-media-actions"><a class="qw-media-action" href="<%= mediaUrl %>" target="_blank" rel="noopener">Abrir</a><a class="qw-media-action" href="<%= mediaUrl %>?download=1">Baixar</a></div>
                </div><% } else if(m.hasMedia){ %><div class="qw-inbox-media qw-remote-media">
                  <% if(media && media.kind==='image'){ %><a href="<%= mediaUrl %>" target="_blank" rel="noopener"><img src="<%= mediaUrl %>" alt="<%= media.originalName || 'Imagem recebida' %>" loading="lazy"></a><% } %>
                  <% if(media && media.kind==='audio'){ %><audio controls preload="none" src="<%= mediaUrl %>"></audio><% } %>
                  <% if(media && media.kind==='video'){ %><video controls preload="metadata" src="<%= mediaUrl %>"></video><% } %>
                  <% if(!media || media.kind==='document'){ %><a class="qw-inbox-document" href="<%= mediaUrl %>" target="_blank" rel="noopener"><span class="qw-inbox-document-icon">📄</span><span class="qw-inbox-document-info"><span class="qw-inbox-document-name"><%= media && media.originalName ? media.originalName : 'Arquivo recebido' %></span><span class="qw-inbox-document-meta"><%= media && media.mime ? media.mime : 'Disponível pelo WhatsApp' %><%= media && media.size ? ' · '+Math.max(1,Math.round(media.size/1024))+' KB' : '' %></span></span></a><% } %>
                  <div class="qw-remote-media-note">Visualização temporária pelo WhatsApp · nenhuma cópia automática no painel</div>
                  <div class="qw-media-actions"><a class="qw-media-action" href="<%= mediaUrl %>" target="_blank" rel="noopener">Visualizar</a><a class="qw-media-action" href="<%= mediaUrl %>?download=1">Baixar no computador</a></div>
                </div><% } %>
                <% if(m.text){ %><div><%= m.text %></div><% } else if(!m.hasMedia){ %><div>[<%= m.type || 'mensagem' %>]</div><% } %><small><%= formatDateTime(m.timestamp) %></small></div><% }) %>
            </div>
            <div class="qw-inbox-composer">
              <div id="inboxAttachPopover" class="qw-popover"><div class="qw-popover-title">➕ Anexar</div>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('image/*')"><span>🖼️</span><span>Imagem <small>JPG, PNG, WebP ou GIF</small></span></button>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('audio/*')"><span>🎙️</span><span>Áudio <small>MP3, OGG, M4A ou WebM</small></span></button>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip')"><span>📄</span><span>Documento <small>PDF, Office, TXT ou ZIP</small></span></button>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('video/mp4,video/webm')"><span>🎬</span><span>Vídeo <small>MP4 ou WebM · até 40 MB</small></span></button>
              </div>
              <div id="inboxBlockPopover" class="qw-popover"><div class="qw-popover-title">🧩 Executar bloco</div><div class="qw-popover-list"><% blocos.filter(function(b){return b.ativo;}).forEach(function(b){ %><button class="qw-popover-item" type="button" onclick="executeInboxBlockQuick('<%= b.id %>')"><%= b.nome %><small><%= (b.etapas||[]).length %> etapa(s) · <%= b.categoria || 'Geral' %></small></button><% }) %></div></div>
              <form id="inboxTextForm" onsubmit="return sendInboxText(event)"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><div class="qw-composer-bar">
                <button class="qw-icon-btn" type="button" title="Anexar" onclick="toggleInboxPopover('inboxAttachPopover')">＋</button>
                <button class="qw-icon-btn" type="button" title="Executar bloco" onclick="toggleInboxPopover('inboxBlockPopover')">🧩</button>
                <textarea id="inboxMessageText" class="qw-textarea qw-inbox-compose-text" name="texto" maxlength="4000" placeholder="Digite uma mensagem" <%= (selectedConversation.conversationType==='group' || selectedConversation.phoneResolved) && whatsapp.status === 'conectado' ? '' : 'disabled' %>></textarea>
                <button id="inboxSendTextBtn" class="qw-icon-btn qw-send-icon" title="Enviar" type="submit" <%= (selectedConversation.conversationType==='group' || selectedConversation.phoneResolved) && whatsapp.status === 'conectado' ? '' : 'disabled' %>>➤</button>
              </div></form>
              <input id="inboxAttachmentInput" type="file" hidden onchange="prepareInboxAttachment(event)">
              <div id="inboxAttachmentPreview" class="qw-attach-preview"><span id="inboxAttachmentName" class="qw-attach-preview-name"></span><button class="qw-attach-cancel" type="button" title="Cancelar anexo" onclick="cancelInboxAttachment()">✕</button></div>
              <div id="inboxSendResult" class="qw-inbox-send-result"></div>
            </div>
          </div>

          <% if(selectedConversation.conversationType!=='group'){ %>
          <div id="contactDrawerBackdrop" class="qw-contact-drawer-backdrop" onclick="closeContactDrawer()"></div>
          <aside id="contactDrawer" class="qw-contact-drawer">
            <div class="qw-drawer-head"><h2>👤 Dados do contato</h2><button class="qw-drawer-close" type="button" onclick="closeContactDrawer()">✕</button></div>
            <form class="qw-contact-form" method="post" action="/automacao-whatsapp/inbox/contato/atualizar"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><div class="qw-contact-form-grid">
              <div class="qw-field"><label>👤 Nome</label><input class="qw-input" name="name" value="<%= selectedConversation.name || '' %>" required></div>
              <div class="qw-field"><label>📌 Status comercial</label><select class="qw-select" name="commercialStatus"><% Object.entries(statusLabels).forEach(function(entry){ %><option value="<%= entry[0] %>" <%= selectedConversation.commercialStatus===entry[0]?'selected':'' %>><%= entry[1] %></option><% }) %></select></div>
              <div class="qw-field"><label>🌐 Origem</label><select class="qw-select" name="origin"><% Object.entries(originLabels).forEach(function(entry){ %><option value="<%= entry[0] %>" <%= selectedConversation.origin===entry[0]?'selected':'' %>><%= entry[1] %></option><% }) %></select></div>
              <div class="qw-field"><label>📱 Produto de interesse</label><input class="qw-input" name="interestProduct" value="<%= selectedConversation.interestProduct || '' %>" placeholder="Ex: Samsung Galaxy S25"></div>
              <div class="qw-field"><label class="qw-check"><input type="checkbox" name="saveContact" value="1" <%= selectedConversation.contactSaved ? 'checked' : '' %> <%= selectedConversation.phoneResolved ? '' : 'disabled' %>> 📇 Salvar na agenda do Painel</label></div>
              <button class="qw-btn primary" type="submit">💾 Salvar alterações</button>
            </div></form>
          </aside>
          <% } %>
          <div id="conversationMenu" class="qw-conversation-menu"><button type="button" onclick="markInboxUnread('<%= selectedConversation.id %>')">● Marcar como não lida</button><% if(selectedConversation.conversationType!=='group'){ %><button type="button" onclick="openContactDrawer();closeConversationMenu()">👤 Dados do contato</button><% } %></div>
        <% } else { %>
          <div class="qw-card qw-inbox-placeholder"><div><div style="font-size:58px">💬</div><h2>Selecione uma conversa</h2><p class="qw-muted">Abra um contato para visualizar e responder.</p></div></div>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'conexao') { %>
    <div class="qw-connection-grid">
      <div class="qw-card">
        <h2>📱 Sessão WhatsApp</h2>
        <div class="qw-live-status"><span id="waDot" class="qw-status-dot"></span><span id="waStatusText"><%= whatsapp.message %></span></div>
        <p id="waIdentity" class="qw-muted"><% if (whatsapp.connectedNumber) { %>Número conectado: +<%= whatsapp.connectedNumber %><% } else { %>Nenhum número conectado no momento.<% } %></p>
        <div id="waQrBox" class="qw-qr-box">
          <% if (whatsapp.qrDataUrl) { %><div><img src="<%= whatsapp.qrDataUrl %>" alt="QR Code WhatsApp"><p>WhatsApp → Aparelhos conectados → Conectar aparelho</p></div><% } else { %><div><div style="font-size:54px">📲</div><strong>Use “Conectar” para iniciar.</strong><p class="qw-muted">Quando já existir uma sessão salva, ela será restaurada sem novo QR Code.</p></div><% } %>
        </div>
        <div class="qw-actions" style="justify-content:flex-start;margin-top:12px">
          <button class="qw-btn success" type="button" id="waConnectBtn" onclick="connectWhatsApp()">Conectar</button>
          <button class="qw-btn danger" type="button" onclick="disconnectWhatsApp()">Desconectar</button>
        </div>
        <div class="qw-info" style="margin-top:12px">A sessão é salva localmente em <code>content/automacao_whatsapp/session</code>. Desconectar preserva essa sessão.</div>
      </div>

      <div class="qw-card">
        <h2>🧪 Envio manual seguro</h2>
        <p class="sub">Somente para o número de teste informado abaixo. Não há gatilhos ou disparos automáticos nesta versão.</p>
        <form id="manualSendForm" class="qw-form" onsubmit="return sendManual(event)">
          <div class="qw-field"><label>Número de teste com DDD</label><input id="testNumber" class="qw-input" name="numero" inputmode="numeric" value="<%= config.numeroTeste || '' %>" placeholder="Ex: 5599999999999" required></div>
          <div class="qw-field"><label>Texto ou legenda</label><textarea class="qw-textarea" name="texto" placeholder="Mensagem de teste"></textarea></div>
          <div class="qw-field"><label>Imagem, áudio, vídeo ou arquivo (opcional)</label><input class="qw-input" type="file" name="arquivo" accept="image/*,audio/*,video/mp4,video/webm,video/quicktime,.pdf,.txt,.docx"></div>
          <button class="qw-btn primary" type="submit">Enviar manualmente</button>
        </form>
        <hr style="border:0;border-top:1px solid var(--qw-line);margin:18px 0">
        <h2>▶ Executar bloco completo</h2>
        <form id="blockSendForm" class="qw-form" onsubmit="return sendBlock(event)">
          <div class="qw-field"><label>Bloco salvo</label><select class="qw-select" name="blocoId" required><option value="">Selecione...</option><% blocos.filter(function(b){return b.ativo;}).forEach(function(b){ %><option value="<%= b.id %>"><%= b.nome %> · <%= (b.etapas || []).length %> etapa(s)</option><% }) %></select></div>
          <button class="qw-btn success" type="submit">Executar bloco no número de teste</button>
        </form>
        <div id="waResult" class="qw-result" style="margin-top:12px"></div>
        <div class="qw-warning" style="margin-top:12px">Durante a execução de um bloco, não feche o painel. Pausas, “digitando” e “gravando áudio” são respeitados.</div>
      </div>
    </div>
  <% } %>

  <% if (tab === 'blocos') { const edit = blocoEdit || {}; const categorias = Array.from(new Set(blocos.map(b => b.categoria || 'Geral'))).sort(); %>
    <div class="qw-grid">
      <div class="qw-card qw-span-5 qw-editor-card">
        <h2><%= blocoEdit ? '✏️ Editar bloco' : '➕ Novo bloco' %></h2>
        <p class="sub">Monte a sequência visual do bloco e teste cada etapa antes de salvar.</p>
        <div id="unsavedAlert" class="qw-unsaved">⚠️ Existem alterações ainda não salvas.</div>
        <form id="blockEditorForm" class="qw-form" method="post" action="/automacao-whatsapp/blocos/salvar" onsubmit="return prepareSteps()">
          <input type="hidden" name="id" value="<%= edit.id || '' %>">
          <input type="hidden" name="etapasJson" id="etapasJson">
          <div class="qw-field"><label>Nome do bloco</label><input class="qw-input" name="nome" value="<%= edit.nome || '' %>" placeholder="Ex: Formas de pagamento" required></div>
          <div class="qw-field"><label>Descrição</label><textarea class="qw-textarea" name="descricao" placeholder="Uso interno"><%= edit.descricao || '' %></textarea></div>
          <div class="qw-row">
            <div class="qw-field"><label>Categoria/pasta</label><input class="qw-input" name="categoria" list="qwCategorias" value="<%= edit.categoria || 'Geral' %>" placeholder="Ex: Vendas"><datalist id="qwCategorias"><% categorias.forEach(function(c){ %><option value="<%= c %>"><% }) %></datalist></div>
            <div class="qw-field"><label>Gatilho/atalho</label><input class="qw-input" name="gatilho" value="<%= edit.gatilho || '' %>" placeholder="Ex: pagamento"></div>
          </div>
          <div class="qw-row">
            <label class="qw-check"><input type="checkbox" name="ativo" <%= edit.ativo !== false ? 'checked' : '' %>> Bloco ativo</label>
            <label class="qw-check"><input type="checkbox" name="favorito" <%= edit.favorito ? 'checked' : '' %>> ⭐ Favorito</label>
          </div>
          <h2 style="margin-top:8px">🧩 Fluxo do bloco</h2>
          <div class="qw-flow-start">🚀 Início do bloco</div>
          <div class="qw-toolbar"><button class="qw-mini-btn" type="button" onclick="expandAllSteps()">Expandir todas</button><button class="qw-mini-btn" type="button" onclick="collapseAllSteps()">Recolher todas</button></div>
          <div class="qw-addbar"><button class="qw-mini-btn" type="button" onclick="addStep('texto')">+ Texto</button><button class="qw-mini-btn" type="button" onclick="addStep('pausa')">+ Pausa</button><button class="qw-mini-btn" type="button" onclick="addStep('audio')">+ Áudio</button><button class="qw-mini-btn" type="button" onclick="addStep('imagem')">+ Imagem</button><button class="qw-mini-btn" type="button" onclick="addStep('video')">+ Vídeo</button><button class="qw-mini-btn" type="button" onclick="addStep('arquivo')">+ Arquivo</button><button class="qw-mini-btn" type="button" onclick="addStep('opcoes')">+ Opções</button></div>
          <div id="builder" class="qw-builder"></div>
          <div class="qw-actions" style="justify-content:flex-start"><button class="qw-btn primary" type="submit">Salvar bloco</button><button class="qw-btn success" type="button" onclick="simulateCurrent()">▶ Simular fluxo</button></div>
        </form>
      </div>
      <div class="qw-card qw-span-7 qw-simulator-card"><h2>🧪 Prévia do bloco</h2><p class="sub">Simule o bloco inteiro ou use “Testar etapa” dentro de cada card.</p><div class="qw-phone"><div class="qw-phone-head"><div class="qw-phone-avatar">Q</div><div><div class="qw-phone-title">Quality Celulares</div><div class="qw-phone-status" id="quickStatus">simulador pronto</div></div></div><div id="preview" class="qw-chat"><div class="qw-wait">Clique em “Simular fluxo”</div></div></div><div class="qw-sim-controls"><button class="qw-btn success" type="button" onclick="simulateCurrent()">▶ Simular tudo</button><button class="qw-btn danger" type="button" onclick="stopSimulation()">Parar</button><button class="qw-btn" type="button" onclick="clearSimulation('preview','quickStatus')">Limpar</button></div></div>
      <div class="qw-card qw-span-12">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap">
          <div><h2>📚 Biblioteca de blocos</h2><p class="sub">Pesquise, filtre, favorite, duplique e abra rapidamente um bloco.</p></div>
          <a class="qw-btn primary" href="/automacao-whatsapp?tab=blocos">➕ Criar novo bloco</a>
        </div>
        <div class="qw-library-tools"><input id="blockSearch" class="qw-input" placeholder="🔎 Buscar por nome, descrição ou gatilho" oninput="filterBlockCards()"><select id="blockCategory" class="qw-select" onchange="filterBlockCards()"><option value="">Todas as categorias</option><% categorias.forEach(function(c){ %><option value="<%= c.toLowerCase() %>"><%= c %></option><% }) %></select><label class="qw-check"><input id="onlyFavorites" type="checkbox" onchange="filterBlockCards()"> Só favoritos</label></div>
        <% if (!blocos.length) { %><div class="qw-empty">Nenhum bloco cadastrado.</div><% } else { %><div class="qw-block-grid" id="blockGrid"><% blocos.slice().sort((a,b)=>(Number(b.favorito)-Number(a.favorito)) || String(a.nome).localeCompare(String(b.nome))).forEach(function(b){ const searchText = [b.nome,b.descricao,b.gatilho,b.categoria].join(' ').toLowerCase(); %><div class="qw-block-card" data-search="<%= searchText %>" data-category="<%= String(b.categoria || 'Geral').toLowerCase() %>" data-favorite="<%= b.favorito ? '1':'0' %>"><div class="qw-block-top"><div><div class="qw-block-name"><%= b.nome %></div><div class="qw-muted" style="font-size:12px;margin-top:3px"><%= b.gatilho ? '/'+b.gatilho : 'Sem atalho' %></div></div><form method="post" action="/automacao-whatsapp/blocos/favorito/<%= b.id %>"><button class="qw-star" title="Favoritar" type="submit"><%= b.favorito ? '⭐':'☆' %></button></form></div><div class="qw-block-meta"><span class="qw-tag"><%= b.categoria || 'Geral' %></span><span class="qw-tag"><%= (b.etapas || []).length %> etapas</span><span class="qw-tag <%= b.ativo ? 'active':'inactive' %>"><%= b.ativo ? 'Ativo':'Inativo' %></span></div><div class="qw-block-desc"><%= b.descricao || 'Sem descrição interna.' %></div><div class="qw-block-actions"><a class="qw-mini-btn blue" style="text-decoration:none" href="/automacao-whatsapp?tab=blocos&edit=<%= b.id %>">✏️ Editar</a><form method="post" action="/automacao-whatsapp/blocos/duplicar/<%= b.id %>"><button class="qw-mini-btn" type="submit">📄 Duplicar</button></form><button class="qw-mini-btn gold" type="button" onclick="simulateLibraryBlock('<%= b.id %>')">▶ Prévia</button><form method="post" action="/automacao-whatsapp/blocos/excluir/<%= b.id %>" onsubmit="return confirm('Excluir este bloco?')"><button class="qw-mini-btn danger" type="submit">Excluir</button></form></div></div><% }) %></div><% } %>
      </div>
    </div>
  <% } %>

  <% if (tab === 'midias') {
    const midiasOrfas = midias.filter(function(m){ return !(m.usos || []).length; });
    const gruposMidia = blocos
      .map(function(b){
        return {
          id: b.id,
          nome: b.nome,
          midias: midias.filter(function(m){ return (m.usos || []).some(function(u){ return u.id === b.id; }); })
        };
      })
      .filter(function(g){ return g.midias.length; });
  %>
    <div class="qw-grid">
      <div class="qw-card qw-span-12">
        <h2>🗂️ Biblioteca oficial de mídias</h2>
        <p class="sub">Organizada por bloco. Uma mesma mídia pode aparecer em mais de um grupo, mas o arquivo físico continua sendo único.</p>
        <div class="qw-info" style="margin-bottom:14px">Esta biblioteca contém somente materiais oficiais dos blocos. As futuras mídias do Inbox e das conversas permanecerão em outra estrutura.</div>

        <div class="qw-media-tools">
          <input id="mediaSearch" class="qw-input" placeholder="🔎 Buscar mídia ou bloco" oninput="filterMediaCards()">
          <select id="mediaType" class="qw-select" onchange="filterMediaCards()">
            <option value="">Todos os tipos</option>
            <option value="imagem">Imagens</option>
            <option value="audio">Áudios</option>
            <option value="video">Vídeos</option>
            <option value="arquivo">Arquivos</option>
          </select>
        </div>

        <% if (!midias.length) { %>
          <div class="qw-empty">Nenhuma mídia catalogada ainda.</div>
        <% } else { %>
          <div id="mediaFilterEmpty" class="qw-media-empty-filter">Nenhuma mídia corresponde à pesquisa ou ao filtro selecionado.</div>

          <div class="qw-media-groups" id="mediaGroups">
            <% gruposMidia.forEach(function(grupo, groupIndex){ %>
              <section class="qw-media-group <%= groupIndex === 0 ? 'open' : '' %>" data-group-name="<%= String(grupo.nome || '').toLowerCase() %>">
                <button class="qw-media-group-head" type="button" onclick="toggleMediaGroup(this)">
                  <span class="qw-media-group-title"><span class="qw-media-group-arrow">›</span> 📦 <%= grupo.nome %></span>
                  <span class="qw-media-group-meta">
                    <span class="qw-tag"><%= grupo.midias.length %> mídia(s)</span>
                    <span class="qw-tag"><%= grupo.midias.filter(m=>m.tipo==='imagem').length %> imagem(ns)</span>
                    <span class="qw-tag"><%= grupo.midias.filter(m=>m.tipo==='audio').length %> áudio(s)</span>
                    <span class="qw-tag"><%= grupo.midias.filter(m=>m.tipo==='video').length %> vídeo(s)</span>
                  </span>
                </button>
                <div class="qw-media-group-body">
                  <div class="qw-media-grid">
                    <% grupo.midias.forEach(function(m){ const usos = m.usos || []; %>
                      <div class="qw-media-card"
                           data-media-id="<%= m.id %>"
                           data-media-search="<%= [m.nome,m.tipo,m.mime,grupo.nome].join(' ').toLowerCase() %>"
                           data-media-type="<%= m.tipo %>">
                        <div class="qw-media-thumb">
                          <% if (m.tipo === 'imagem') { %><img src="<%= m.caminho %>" alt="<%= m.nome %>">
                          <% } else if (m.tipo === 'video') { %><video controls preload="metadata" src="<%= m.caminho %>"></video>
                          <% } else if (m.tipo === 'audio') { %><audio controls preload="metadata" src="<%= m.caminho %>"></audio>
                          <% } else { %><div style="font-size:44px">📄</div><% } %>
                        </div>
                        <div class="qw-media-name"><%= m.nome %></div>
                        <div class="qw-block-meta">
                          <span class="qw-tag"><%= m.tipo %></span>
                          <span class="qw-tag"><%= Math.max(1, Math.round((m.tamanho || 0)/1024)) %> KB</span>
                          <span class="qw-tag active">Em uso por <%= usos.length %> bloco(s)</span>
                        </div>
                        <div class="qw-media-usage">Vinculada a: <%= usos.map(u=>u.nome).join(', ') %></div>
                        <div class="qw-block-actions">
                          <a class="qw-mini-btn blue qw-media-link-btn" href="<%= m.caminho %>" target="_blank" rel="noopener">👁 Abrir</a>
                          <a class="qw-mini-btn qw-media-link-btn" href="/automacao-whatsapp/midias/download/<%= m.id %>">⬇ Baixar</a>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </section>
            <% }) %>

            <% if (midiasOrfas.length) { %>
              <section class="qw-media-group" data-group-name="sem bloco vinculado mídias órfãs">
                <button class="qw-media-group-head" type="button" onclick="toggleMediaGroup(this)">
                  <span class="qw-media-group-title"><span class="qw-media-group-arrow">›</span> 🧹 Sem bloco vinculado</span>
                  <span class="qw-media-group-meta"><span class="qw-tag inactive"><%= midiasOrfas.length %> mídia(s) órfã(s)</span></span>
                </button>
                <div class="qw-media-group-body">
                  <div class="qw-media-grid">
                    <% midiasOrfas.forEach(function(m){ %>
                      <div class="qw-media-card"
                           data-media-id="<%= m.id %>"
                           data-media-search="<%= [m.nome,m.tipo,m.mime,'sem bloco vinculado'].join(' ').toLowerCase() %>"
                           data-media-type="<%= m.tipo %>">
                        <div class="qw-media-thumb">
                          <% if (m.tipo === 'imagem') { %><img src="<%= m.caminho %>" alt="<%= m.nome %>">
                          <% } else if (m.tipo === 'video') { %><video controls preload="metadata" src="<%= m.caminho %>"></video>
                          <% } else if (m.tipo === 'audio') { %><audio controls preload="metadata" src="<%= m.caminho %>"></audio>
                          <% } else { %><div style="font-size:44px">📄</div><% } %>
                        </div>
                        <div class="qw-media-name"><%= m.nome %></div>
                        <div class="qw-block-meta">
                          <span class="qw-tag"><%= m.tipo %></span>
                          <span class="qw-tag"><%= Math.max(1, Math.round((m.tamanho || 0)/1024)) %> KB</span>
                          <span class="qw-tag inactive">Sem uso</span>
                        </div>
                        <div class="qw-media-usage">Esta mídia não está vinculada a nenhum bloco.</div>
                        <div class="qw-block-actions">
                          <a class="qw-mini-btn blue qw-media-link-btn" href="<%= m.caminho %>" target="_blank" rel="noopener">👁 Abrir</a>
                          <a class="qw-mini-btn qw-media-link-btn" href="/automacao-whatsapp/midias/download/<%= m.id %>">⬇ Baixar</a>
                          <form method="post" action="/automacao-whatsapp/midias/excluir/<%= m.id %>" onsubmit="return confirm('Excluir esta mídia sem uso?')">
                            <button class="qw-mini-btn danger" type="submit">Excluir</button>
                          </form>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </section>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (tab === 'simulador') { %>
    <div class="qw-grid"><div class="qw-card qw-span-12"><h2>▶ Simulador de fluxo</h2><p class="sub">Escolha um bloco salvo para conferir a ordem, pausas, digitando, áudio, imagem e opções.</p><div class="qw-row"><select class="qw-select" id="simulateSelect"><% blocos.forEach(function(b){ %><option value="<%= b.id %>"><%= b.nome %></option><% }) %></select><button class="qw-btn success" type="button" onclick="simulateSaved()">Simular bloco</button></div><div class="qw-phone" style="margin-top:14px">
      <div class="qw-phone-head">
        <div class="qw-phone-avatar">Q</div>
        <div><div class="qw-phone-title">Quality Celulares</div><div class="qw-phone-status" id="savedStatus">simulador pronto</div></div>
      </div>
      <div id="savedPreview" class="qw-chat"><div class="qw-wait">Escolha um bloco e clique em simular</div></div>
    </div>
    <div class="qw-sim-controls">
      <button class="qw-btn danger" type="button" onclick="stopSimulation()">Parar</button>
      <button class="qw-btn" type="button" onclick="clearSimulation('savedPreview','savedStatus')">Limpar</button>
    </div>
    <div class="qw-sim-note">Imagem, áudio e vídeo são exibidos usando a biblioteca oficial de mídias dos blocos.</div></div></div>
  <% } %>

  <% if (tab === 'aniversariantes') { %>
    <div class="qw-grid"><div class="qw-card qw-span-8"><h2>🎂 Aniversariantes</h2><p class="sub">Fase 1 preparada para receber dados do script WM10. Na próxima fase, criaremos o webhook interno e a fila de envio.</p><div class="qw-info">Fluxo previsto: WM10 → Painel Quality → fila Automação WhatsApp → envio controlado.</div></div><div class="qw-card qw-span-4"><h2>⏰ Horário atual</h2><div class="qw-pill green"><%= config.horarioAniversario || '08:00' %></div><p class="qw-muted">Configurável em Configurações → Geral.</p></div></div>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'logs') { %>
    <div class="qw-grid"><div class="qw-card qw-span-12"><h2>📜 Logs</h2><p class="sub">Conexão, QR Code, envios manuais, etapas de blocos, falhas e simulações.</p><% if (!logs.length) { %><div class="qw-empty">Sem logs ainda.</div><% } else { %><div class="qw-log-list"><% logs.slice(0,200).forEach(function(log){ %><div class="qw-log-row"><strong><%= log.message %></strong><br><small><%= new Date(log.at).toLocaleString('pt-BR') %> · <%= log.type %></small><% if (log.details && Object.keys(log.details).length) { %><details><summary>Detalhes</summary><pre><%= JSON.stringify(log.details, null, 2) %></pre></details><% } %></div><% }) %></div><% } %></div></div>
  <% } %>


  <% if (tab === 'configuracoes' && settingsSection === 'armazenamento') { %>
    <div class="qw-storage-kpis">
      <div class="qw-storage-kpi"><div class="value"><%= storageReport.labels.total %></div><div class="label">Inbox completo</div><div class="hint">Mensagens, mídia local e backups</div></div>
      <div class="qw-storage-kpi"><div class="value"><%= storageReport.labels.media %></div><div class="label">Mídias locais</div><div class="hint"><%= storageReport.mediaFiles %> arquivo(s)</div></div>
      <div class="qw-storage-kpi"><div class="value"><%= storageReport.messageCount %></div><div class="label">Mensagens registradas</div><div class="hint"><%= storageReport.contacts %> contatos · <%= storageReport.groups %> grupos</div></div>
      <div class="qw-storage-kpi"><div class="value"><%= storageReport.backups %></div><div class="label">Backups do Inbox</div><div class="hint"><%= storageReport.labels.backups %> ocupados</div></div>
    </div>

    <div class="qw-storage-layout">
      <div class="qw-storage-stack">
        <div class="qw-card">
          <h2>🔍 Varredura do armazenamento</h2>
          <p class="sub">Relatório somente leitura. Nenhum arquivo é alterado durante a análise.</p>
          <div class="qw-health-list">
            <div class="qw-health-row"><span>Arquivos órfãos</span><strong class="<%= storageReport.orphanFiles.count ? 'qw-health-warn':'qw-health-ok' %>"><%= storageReport.orphanFiles.count %> · <%= storageReport.labels.orphan %></strong></div>
            <div class="qw-health-row"><span>Mídias antigas de grupos</span><strong class="<%= storageReport.groupFiles.count ? 'qw-health-warn':'qw-health-ok' %>"><%= storageReport.groupFiles.count %> · <%= storageReport.labels.groups %></strong></div>
            <div class="qw-health-row"><span>Mídias com mais de 30 dias</span><strong class="<%= storageReport.old30Files.count ? 'qw-health-warn':'qw-health-ok' %>"><%= storageReport.old30Files.count %> · <%= storageReport.labels.old30 %></strong></div>
            <div class="qw-health-row"><span>Mídias com mais de 90 dias</span><strong class="<%= storageReport.old90Files.count ? 'qw-health-warn':'qw-health-ok' %>"><%= storageReport.old90Files.count %> · <%= storageReport.labels.old90 %></strong></div>
            <div class="qw-health-row"><span>Pastas vazias</span><strong class="<%= storageReport.emptyDirs ? 'qw-health-warn':'qw-health-ok' %>"><%= storageReport.emptyDirs %></strong></div>
            <div class="qw-health-row"><span>Arquivos JSON inválidos</span><strong class="<%= storageReport.invalidJson.length ? 'qw-health-bad':'qw-health-ok' %>"><%= storageReport.invalidJson.length %></strong></div>
          </div>
          <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><a class="qw-btn primary" href="/automacao-whatsapp?tab=configuracoes&section=armazenamento">🔄 Executar nova varredura</a></div>
        </div>

        <div class="qw-card">
          <h2>🧹 Limpeza manual</h2>
          <p class="sub">As ações abaixo removem somente cópias locais em <code>inbox/media</code>. Mensagens e CRM permanecem intactos.</p>
          <div class="qw-clean-grid">
            <div class="qw-clean-action"><h3>Arquivos órfãos</h3><p>Arquivos locais sem referência em nenhuma mensagem.</p><form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirmStorageCleanup(this,'Remover <%= storageReport.orphanFiles.count %> arquivo(s) órfão(s) e liberar aproximadamente <%= storageReport.labels.orphan %>?')"><input type="hidden" name="action" value="orphans"><button class="qw-btn" type="submit" <%= storageReport.orphanFiles.count ? '' : 'disabled' %>>Limpar órfãos</button></form></div>
            <div class="qw-clean-action"><h3>Mídias de grupos</h3><p>Remove somente mídias antigas que já foram gravadas localmente.</p><form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirmStorageCleanup(this,'Remover <%= storageReport.groupFiles.count %> mídia(s) local(is) de grupos e liberar aproximadamente <%= storageReport.labels.groups %>?')"><input type="hidden" name="action" value="groups"><button class="qw-btn" type="submit" <%= storageReport.groupFiles.count ? '' : 'disabled' %>>Limpar grupos</button></form></div>
            <div class="qw-clean-action"><h3>Mais de 30 dias</h3><p>Apaga cópias locais antigas, mantendo o registro textual.</p><form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirmStorageCleanup(this,'Remover <%= storageReport.old30Files.count %> mídia(s) com mais de 30 dias e liberar aproximadamente <%= storageReport.labels.old30 %>?')"><input type="hidden" name="action" value="older30"><button class="qw-btn" type="submit" <%= storageReport.old30Files.count ? '' : 'disabled' %>>Limpar +30 dias</button></form></div>
            <div class="qw-clean-action"><h3>Mais de 90 dias</h3><p>Opção mais conservadora para preservar arquivos recentes.</p><form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirmStorageCleanup(this,'Remover <%= storageReport.old90Files.count %> mídia(s) com mais de 90 dias e liberar aproximadamente <%= storageReport.labels.old90 %>?')"><input type="hidden" name="action" value="older90"><button class="qw-btn" type="submit" <%= storageReport.old90Files.count ? '' : 'disabled' %>>Limpar +90 dias</button></form></div>
            <div class="qw-clean-action"><h3>Pastas vazias</h3><p>Remove apenas diretórios vazios deixados por limpezas anteriores.</p><form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirmStorageCleanup(this,'Remover as pastas vazias encontradas?')"><input type="hidden" name="action" value="empty_dirs"><button class="qw-btn" type="submit" <%= storageReport.emptyDirs ? '' : 'disabled' %>>Limpar pastas</button></form></div>
            <div class="qw-clean-action" style="border-color:#fecaca;background:#fffafa"><h3>Limpeza completa da mídia</h3><p>Apaga todas as cópias locais do Inbox. Não apaga mensagens ou contatos.</p><form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirmStorageCleanup(this,'ATENÇÃO: remover todas as <%= storageReport.mediaFiles %> mídias locais e liberar aproximadamente <%= storageReport.labels.media %>?')"><input type="hidden" name="action" value="all_media"><button class="qw-btn danger" type="submit" <%= storageReport.mediaFiles ? '' : 'disabled' %>>Limpar toda a mídia</button></form></div>
          </div>
        </div>
      </div>

      <div class="qw-storage-stack">
        <div class="qw-card"><h2>📊 Detalhes</h2><div class="qw-health-list">
          <div class="qw-health-row"><span>Arquivos de mensagens</span><strong><%= storageReport.labels.messages %></strong></div>
          <div class="qw-health-row"><span>Contatos salvos</span><strong><%= storageReport.savedContacts %></strong></div>
          <div class="qw-health-row"><span>Total de pastas</span><strong><%= storageReport.folders %></strong></div>
          <div class="qw-health-row"><span>Maior mídia local</span><strong><%= storageReport.largestMedia ? storageReport.labels.largest : '—' %></strong></div>
        </div><% if(storageReport.largestMedia){ %><p class="qw-storage-note" style="margin-top:10px">Maior arquivo: <strong><%= storageReport.largestMedia.name %></strong></p><% } %></div>
        <div class="qw-card"><h2>🛡️ Regra de segurança</h2><div class="qw-info">Desde a v0.6.1, mídias novas são visualizadas temporariamente pelo WhatsApp e não são salvas automaticamente. Esta central serve principalmente para limpar arquivos antigos.</div><p class="qw-storage-note" style="margin-top:12px">A limpeza atualiza os metadados das mensagens para impedir links quebrados. Quando o WhatsApp ainda disponibilizar a mídia, ela poderá ser visualizada novamente de forma temporária.</p></div>
        <div class="qw-card"><h2>📁 Área analisada</h2><div class="qw-storage-path">content/automacao_whatsapp/inbox</div><p class="qw-storage-note">A sessão do WhatsApp, a biblioteca oficial de blocos e as mídias cadastradas nos blocos ficam fora desta limpeza.</p></div>
        <% if(storageReport.invalidJson.length){ %><div class="qw-card"><h2>⚠️ JSON inválidos</h2><div class="qw-warning"><%= storageReport.invalidJson.join(', ') %></div><p class="qw-storage-note">A central apenas informa estes arquivos. Não tenta corrigi-los ou excluí-los automaticamente.</p></div><% } %>
      </div>
    </div>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'geral') { %>
    <div class="qw-grid"><div class="qw-card qw-span-8"><h2>⚙️ Configurações gerais</h2><p class="sub">Controle de horário, limites e comportamento humano. Envio real permanece desligado nesta fase.</p><form class="qw-form" method="post" action="/automacao-whatsapp/configuracoes/salvar"><div class="qw-field"><label>Número de teste padrão</label><input class="qw-input" name="numeroTeste" inputmode="numeric" value="<%= config.numeroTeste || '' %>" placeholder="Ex: 5599999999999"></div><div class="qw-row"><div class="qw-field"><label>Horário dos aniversariantes</label><input class="qw-input" type="time" name="horarioAniversario" value="<%= config.horarioAniversario || '08:00' %>"></div><div class="qw-field"><label>Limite diário de mensagens</label><input class="qw-input" type="number" min="1" max="1000" name="limiteDiario" value="<%= config.limiteDiario || 40 %>"></div></div><div class="qw-row"><div class="qw-field"><label>Delay humano mínimo entre mensagens (segundos)</label><input class="qw-input" type="number" min="0" name="delayHumanoMin" value="<%= config.delayHumanoMin || 4 %>"></div><div class="qw-field"><label>Delay humano máximo entre mensagens (segundos)</label><input class="qw-input" type="number" min="0" name="delayHumanoMax" value="<%= config.delayHumanoMax || 12 %>"></div></div><div class="qw-row"><div class="qw-field"><label>Digitando padrão (segundos)</label><input class="qw-input" type="number" min="0" name="digitandoPadrao" value="<%= config.digitandoPadrao || 2 %>"></div><div class="qw-field"><label>Gravando áudio padrão (segundos)</label><input class="qw-input" type="number" min="0" name="gravandoAudioPadrao" value="<%= config.gravandoAudioPadrao || 2 %>"></div></div><label class="qw-check"><input type="checkbox" name="envioRealAtivo" <%= config.envioRealAtivo ? 'checked' : '' %>> Permitir envio real quando a conexão WhatsApp existir</label><button class="qw-btn primary" type="submit">Salvar configurações</button></form></div><div class="qw-card qw-span-4"><h2>🛡️ Nota</h2><div class="qw-warning">Na v0.5.0, o envio real existe apenas em Configurações → Conexão e sempre exige ação manual. Esta chave continua reservada para fases futuras.</div></div></div>
  <% } %>
</div>

<script>
(function () {
  'use strict';

  function waResult(message, ok) {
    var box = document.getElementById('waResult');
    if (!box) return;
    box.textContent = message;
    box.className = 'qw-result show ' + (ok ? 'ok' : 'bad');
  }

  function renderWaStatus(state) {
    if (!state) return;
    var text = document.getElementById('waStatusText');
    var dot = document.getElementById('waDot');
    var qrBox = document.getElementById('waQrBox');
    var identity = document.getElementById('waIdentity');
    if (text) text.textContent = state.message || state.status;
    if (dot) dot.className = 'qw-status-dot ' + (state.status === 'conectado' ? 'connected' : (state.status === 'erro' ? 'error' : 'waiting'));
    if (identity) identity.textContent = state.connectedNumber ? 'Número conectado: +' + state.connectedNumber + (state.connectedName ? ' · ' + state.connectedName : '') : 'Nenhum número conectado no momento.';
    if (qrBox && state.qrDataUrl) qrBox.innerHTML = '<div><img src="' + state.qrDataUrl + '" alt="QR Code WhatsApp"><p>WhatsApp → Aparelhos conectados → Conectar aparelho</p></div>';
    if (qrBox && state.status === 'conectado') qrBox.innerHTML = '<div><div style="font-size:58px">✅</div><strong>Sessão pronta</strong><p class="qw-muted">Você já pode realizar os testes manuais.</p></div>';
  }

  async function waRequest(url, options) {
    var response = await fetch(url, options || {});
    var payload = await response.json();
    if (!response.ok || !payload.success) throw new Error(payload.message || 'Falha na operação.');
    return payload;
  }

  async function connectWhatsApp() {
    waResult('Abrindo o WhatsApp Web...', true);
    try {
      var payload = await waRequest('/automacao-whatsapp/whatsapp/conectar', { method: 'POST' });
      renderWaStatus(payload.whatsapp);
    } catch (error) { waResult(error.message, false); }
  }

  async function disconnectWhatsApp() {
    try {
      var payload = await waRequest('/automacao-whatsapp/whatsapp/desconectar', { method: 'POST' });
      renderWaStatus(payload.whatsapp);
      waResult('Desconectado. A sessão local foi preservada.', true);
    } catch (error) { waResult(error.message, false); }
  }

  async function refreshWaStatus() {
    try {
      var payload = await waRequest('/automacao-whatsapp/whatsapp/status');
      renderWaStatus(payload.whatsapp);
    } catch (_) {}
  }

  async function sendManual(event) {
    event.preventDefault();
    var form = event.currentTarget;
    var button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    waResult('Enviando...', true);
    try {
      var payload = await waRequest('/automacao-whatsapp/whatsapp/enviar', { method: 'POST', body: new FormData(form) });
      waResult(payload.message, true);
    } catch (error) { waResult(error.message, false); }
    finally { button.disabled = false; }
    return false;
  }

  async function sendBlock(event) {
    event.preventDefault();
    var form = event.currentTarget;
    var number = document.getElementById('testNumber');
    var button = form.querySelector('button[type="submit"]');
    var data = Object.fromEntries(new FormData(form).entries());
    data.numero = number ? number.value : '';
    button.disabled = true;
    waResult('Executando bloco. Aguarde a conclusão...', true);
    try {
      var payload = await waRequest('/automacao-whatsapp/whatsapp/executar-bloco', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
      waResult(payload.message, true);
    } catch (error) { waResult(error.message, false); }
    finally { button.disabled = false; }
    return false;
  }

  window.connectWhatsApp = connectWhatsApp;
  window.disconnectWhatsApp = disconnectWhatsApp;
  window.sendManual = sendManual;
  window.sendBlock = sendBlock;
  if (document.getElementById('waStatusText')) { refreshWaStatus(); setInterval(refreshWaStatus, 2500); }


  var blocosSalvos = <%- JSON.stringify(blocos || []).replace(/</g, '\u003c') %>;
  var midiasSalvas = <%- JSON.stringify(midias || []).replace(/</g, '\u003c') %>;
  var editSteps = <%- JSON.stringify((blocoEdit && blocoEdit.etapas) || []).replace(/</g, '\u003c') %>;
  var steps = Array.isArray(editSteps) ? editSteps : [];
  var openSteps = {};
  steps.forEach(function(_, index){ openSteps[index] = index === 0; });

  function uid() {
    return 'etapa_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 7);
  }

  function esc(value) {
    return String(value == null ? '' : value).replace(/[&<>"]/g, function (char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char];
    });
  }

  function defaultStep(tipo) {
    if (tipo === 'texto') return { id: uid(), tipo: 'texto', texto: '', digitandoSegundos: 2 };
    if (tipo === 'pausa') return { id: uid(), tipo: 'pausa', segundos: 3 };
    if (tipo === 'audio') return { id: uid(), tipo: 'audio', caminho: '', mediaId: '', gravandoSegundos: 2, legenda: '' };
    if (tipo === 'imagem') return { id: uid(), tipo: 'imagem', caminho: '', mediaId: '', legenda: '' };
    if (tipo === 'video') return { id: uid(), tipo: 'video', caminho: '', mediaId: '', legenda: '' };
    if (tipo === 'arquivo') return { id: uid(), tipo: 'arquivo', caminho: '', mediaId: '', legenda: '' };
    if (tipo === 'opcoes') {
      return {
        id: uid(),
        tipo: 'opcoes',
        texto: 'Escolha uma opção:',
        opcoes: [
          { label: '1️⃣ Smartphones', resposta: '1', proximoBloco: 'Smartphones' },
          { label: '2️⃣ Assistência', resposta: '2', proximoBloco: 'Assistência' }
        ]
      };
    }
    return { id: uid(), tipo: 'texto', texto: '', digitandoSegundos: 0 };
  }

  function addStep(tipo) {
    steps.push(defaultStep(tipo));
    markUnsaved();
    openSteps[steps.length - 1] = true;
    renderBuilder();
  }

  function removeStep(index) {
    steps.splice(index, 1);
    markUnsaved();
    openSteps = {};
    steps.forEach(function(_, i){ openSteps[i] = false; });
    renderBuilder();
  }

  function moveStep(index, direction) {
    var target = index + direction;
    if (target < 0 || target >= steps.length) return;
    var current = steps[index];
    steps[index] = steps[target];
    steps[target] = current;
    markUnsaved();
    renderBuilder();
  }

  function updateStep(index, key, value) {
    if (!steps[index]) return;
    steps[index][key] = value;
    markUnsaved();
  }

  function updateOption(stepIndex, optionIndex, key, value) {
    if (!steps[stepIndex]) return;
    steps[stepIndex].opcoes = steps[stepIndex].opcoes || [];
    if (!steps[stepIndex].opcoes[optionIndex]) return;
    steps[stepIndex].opcoes[optionIndex][key] = value;
    markUnsaved();
  }

  function addOption(index) {
    steps[index].opcoes = steps[index].opcoes || [];
    steps[index].opcoes.push({ label: '', resposta: '', proximoBloco: '' });
    renderBuilder();
  }

  function removeOption(stepIndex, optionIndex) {
    steps[stepIndex].opcoes.splice(optionIndex, 1);
    renderBuilder();
  }

  async function uploadMedia(index, input) {
    var file = input.files && input.files[0];
    if (!file) return;

    var formData = new FormData();
    formData.append('arquivo', file);

    try {
      var response = await fetch('/automacao-whatsapp/midias/upload', {
        method: 'POST',
        body: formData
      });
      var payload = await response.json();

      if (!response.ok || !payload.success) {
        throw new Error(payload.message || 'Falha no upload.');
      }

      steps[index].caminho = payload.caminho;
      steps[index].mediaId = payload.mediaId || '';
      steps[index].tipo = payload.tipo;
      renderBuilder();
    } catch (error) {
      alert(error.message || 'Falha no upload.');
    }
  }

  function mediaPreview(step) {
    if (!step.caminho) return '';
    if (step.tipo === 'imagem') {
      return '<div class="qw-media-preview"><img src="' + esc(step.caminho) + '" alt="Prévia"><div class="qw-compact-path">' + esc(step.caminho) + '</div></div>';
    }
    if (step.tipo === 'audio') {
      return '<div class="qw-media-preview"><audio controls src="' + esc(step.caminho) + '"></audio><div class="qw-compact-path">' + esc(step.caminho) + '</div></div>';
    }
    if (step.tipo === 'video') {
      return '<div class="qw-media-preview"><video controls preload="metadata" src="' + esc(step.caminho) + '"></video><div class="qw-compact-path">' + esc(step.caminho) + '</div></div>';
    }
    return '<div class="qw-media-preview"><a class="qw-link" href="' + esc(step.caminho) + '" target="_blank">Abrir arquivo</a></div>';
  }

  function typeSelect(index, selected) {
    var types = [
      ['texto', 'Texto'],
      ['pausa', 'Pausa'],
      ['audio', 'Áudio'],
      ['imagem', 'Imagem'],
      ['video', 'Vídeo'],
      ['arquivo', 'Arquivo'],
      ['opcoes', 'Opções']
    ];

    return '<select class="qw-select" onchange="changeStepType(' + index + ',this.value)">' +
      types.map(function (item) {
        return '<option value="' + item[0] + '"' + (item[0] === selected ? ' selected' : '') + '>' + item[1] + '</option>';
      }).join('') +
      '</select>';
  }

  function changeStepType(index, tipo) {
    steps[index] = defaultStep(tipo);
    renderBuilder();
  }

  function stepSummary(step) {
    if (!step) return '';
    if (step.tipo === 'texto') return 'digitando ' + Number(step.digitandoSegundos || 0) + 's · ' + String(step.texto || 'texto vazio').replace(/\s+/g, ' ').slice(0, 70);
    if (step.tipo === 'pausa') return Number(step.segundos || 0) + ' segundo(s)';
    if (step.tipo === 'audio') return 'gravando ' + Number(step.gravandoSegundos || 0) + 's · ' + (step.caminho ? step.caminho.split('/').pop() : 'sem áudio');
    if (step.tipo === 'imagem') return step.caminho ? step.caminho.split('/').pop() : 'sem imagem';
    if (step.tipo === 'video') return step.caminho ? step.caminho.split('/').pop() : 'sem vídeo';
    if (step.tipo === 'arquivo') return step.caminho ? step.caminho.split('/').pop() : 'sem arquivo';
    if (step.tipo === 'opcoes') return (step.opcoes || []).length + ' opção(ões)';
    return '';
  }

  function toggleStep(index) {
    openSteps[index] = !openSteps[index];
    renderBuilder();
  }

  function expandAllSteps() {
    steps.forEach(function(_, index){ openSteps[index] = true; });
    renderBuilder();
  }

  function collapseAllSteps() {
    steps.forEach(function(_, index){ openSteps[index] = false; });
    renderBuilder();
  }

  function mediaLibrarySelect(index, tipo, selectedId) {
    var options = midiasSalvas.filter(function(m){ return m.tipo === tipo; });
    if (!options.length) return '<span class="qw-muted" style="font-size:12px">Nenhuma mídia deste tipo na biblioteca.</span>';
    return '<select class="qw-select" style="max-width:320px" onchange="selectLibraryMedia(' + index + ',this.value)"><option value="">Selecionar da biblioteca...</option>' + options.map(function(m){ return '<option value="' + esc(m.id) + '"' + (m.id === selectedId ? ' selected' : '') + '>' + esc(m.nome) + '</option>'; }).join('') + '</select>';
  }

  function selectLibraryMedia(index, mediaId) {
    var media = midiasSalvas.find(function(m){ return m.id === mediaId; });
    if (!media || !steps[index]) return;
    steps[index].mediaId = media.id;
    steps[index].caminho = media.caminho;
    steps[index].tipo = media.tipo;
    renderBuilder();
    markUnsaved();
  }

  function renderBuilder() {
    var builder = document.getElementById('builder');
    if (!builder) return;

    if (!steps.length) {
      builder.innerHTML = '<div class="qw-empty">Nenhuma etapa ainda. Clique em Texto, Pausa, Áudio, Imagem, Arquivo ou Opções.</div>';
      return;
    }

    builder.innerHTML = steps.map(function (step, index) {
      var body = '';

      if (step.tipo === 'texto') {
        body =
          '<div class="qw-step-grid">' +
            '<div><label>Tipo</label>' + typeSelect(index, step.tipo) + '</div>' +
            '<div><label>Mensagem</label><textarea class="qw-textarea" oninput="updateStep(' + index + ',\'texto\',this.value)">' + esc(step.texto || '') + '</textarea></div>' +
            '<div><label>Digitando (s)</label><input class="qw-input" type="number" min="0" value="' + esc(step.digitandoSegundos || 0) + '" oninput="updateStep(' + index + ',\'digitandoSegundos\',this.value)"></div>' +
          '</div>';
      } else if (step.tipo === 'pausa') {
        body =
          '<div class="qw-step-grid">' +
            '<div><label>Tipo</label>' + typeSelect(index, step.tipo) + '</div>' +
            '<div><label>Descrição</label><input class="qw-input" value="Aguardar antes da próxima etapa" readonly></div>' +
            '<div><label>Segundos</label><input class="qw-input" type="number" min="0" value="' + esc(step.segundos || 0) + '" oninput="updateStep(' + index + ',\'segundos\',this.value)"></div>' +
          '</div>';
      } else if (step.tipo === 'audio') {
        body =
          '<div class="qw-step-grid">' +
            '<div><label>Tipo</label>' + typeSelect(index, step.tipo) + '</div>' +
            '<div><label>Caminho do áudio</label><input class="qw-input" value="' + esc(step.caminho || '') + '" oninput="updateStep(' + index + ',\'caminho\',this.value)"></div>' +
            '<div><label>Gravando (s)</label><input class="qw-input" type="number" min="0" value="' + esc(step.gravandoSegundos || 0) + '" oninput="updateStep(' + index + ',\'gravandoSegundos\',this.value)"></div>' +
          '</div>' +
          '<div class="qw-upload" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center"><label class="qw-mini-btn">Fazer novo upload<input type="file" accept="audio/*" hidden onchange="uploadMedia(' + index + ',this)"></label>' + mediaLibrarySelect(index, step.tipo, step.mediaId) + '</div>' +
          mediaPreview(step) +
          '<div class="qw-field" style="margin-top:8px"><label>Legenda/observação</label><input class="qw-input" value="' + esc(step.legenda || '') + '" oninput="updateStep(' + index + ',\'legenda\',this.value)"></div>';
      } else if (step.tipo === 'imagem' || step.tipo === 'video' || step.tipo === 'arquivo') {
        body =
          '<div class="qw-step-grid">' +
            '<div><label>Tipo</label>' + typeSelect(index, step.tipo) + '</div>' +
            '<div><label>Caminho</label><input class="qw-input" value="' + esc(step.caminho || '') + '" oninput="updateStep(' + index + ',\'caminho\',this.value)"></div>' +
            '<div><label>Formato</label><input class="qw-input" value="' + esc(step.tipo) + '" readonly></div>' +
          '</div>' +
          '<div class="qw-upload" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center"><label class="qw-mini-btn">Fazer novo upload<input type="file" accept="image/*,audio/*,video/mp4,video/webm,video/quicktime,.pdf,.txt,.docx" hidden onchange="uploadMedia(' + index + ',this)"></label>' + mediaLibrarySelect(index, step.tipo, step.mediaId) + '</div>' +
          mediaPreview(step) +
          '<div class="qw-field" style="margin-top:8px"><label>Legenda</label><textarea class="qw-textarea" oninput="updateStep(' + index + ',\'legenda\',this.value)">' + esc(step.legenda || '') + '</textarea></div>';
      } else if (step.tipo === 'opcoes') {
        var options = (step.opcoes || []).map(function (option, optionIndex) {
          return '<div class="qw-option-row">' +
            '<input class="qw-input" placeholder="Rótulo" value="' + esc(option.label || '') + '" oninput="updateOption(' + index + ',' + optionIndex + ',\'label\',this.value)">' +
            '<input class="qw-input" placeholder="Resposta" value="' + esc(option.resposta || '') + '" oninput="updateOption(' + index + ',' + optionIndex + ',\'resposta\',this.value)">' +
            '<input class="qw-input" placeholder="Próximo bloco" value="' + esc(option.proximoBloco || '') + '" oninput="updateOption(' + index + ',' + optionIndex + ',\'proximoBloco\',this.value)">' +
            '<button class="qw-mini-btn danger" type="button" onclick="removeOption(' + index + ',' + optionIndex + ')">X</button>' +
          '</div>';
        }).join('');

        body =
          '<div class="qw-step-grid">' +
            '<div><label>Tipo</label>' + typeSelect(index, step.tipo) + '</div>' +
            '<div><label>Texto acima das opções</label><input class="qw-input" value="' + esc(step.texto || '') + '" oninput="updateStep(' + index + ',\'texto\',this.value)"></div>' +
            '<div><label>Ações</label><button class="qw-mini-btn" type="button" onclick="addOption(' + index + ')">+ Opção</button></div>' +
          '</div>' +
          '<div class="qw-options-box">' + options + '</div>';
      }

      var isOpen = !!openSteps[index];
      return '<div class="qw-step ' + (isOpen ? 'open' : '') + '">' +
        '<div class="qw-step-head">' +
          '<div class="qw-step-summary" onclick="toggleStep(' + index + ')">' +
            '<button class="qw-toggle" type="button">' + (isOpen ? '▾' : '▸') + '</button>' +
            '<div><div class="qw-step-title"><span class="qw-step-number">' + (index + 1) + '</span>' + esc(step.tipo) + '</div>' +
            '<div class="qw-step-summary-text">' + esc(stepSummary(step)) + '</div></div>' +
          '</div>' +
          '<div class="qw-step-actions">' +
            '<button class="qw-mini-btn gold" type="button" onclick="event.stopPropagation();simulateStep(' + index + ')">▶</button>' + '<button class="qw-mini-btn blue" type="button" onclick="event.stopPropagation();duplicateStep(' + index + ')">⧉</button>' + '<button class="qw-mini-btn" type="button" onclick="event.stopPropagation();moveStep(' + index + ',-1)">↑</button>' +
            '<button class="qw-mini-btn" type="button" onclick="event.stopPropagation();moveStep(' + index + ',1)">↓</button>' +
            '<button class="qw-mini-btn danger" type="button" onclick="event.stopPropagation();removeStep(' + index + ')">Remover</button>' +
          '</div>' +
        '</div>' +
        '<div class="qw-step-body">' + body + '</div>' +
      '</div>';
    }).join('');
  }

  function duplicateStep(index) {
    if (!steps[index]) return;
    var copy = JSON.parse(JSON.stringify(steps[index]));
    copy.id = uid();
    steps.splice(index + 1, 0, copy);
    openSteps[index + 1] = true;
    markUnsaved();
    renderBuilder();
  }

  function simulateStep(index) {
    if (!steps[index]) return;
    runVisualSimulation([steps[index]], 'preview', 'quickStatus');
  }

  function filterBlockCards() {
    var query = String((document.getElementById('blockSearch') || {}).value || '').toLowerCase().trim();
    var category = String((document.getElementById('blockCategory') || {}).value || '').toLowerCase();
    var favorites = !!((document.getElementById('onlyFavorites') || {}).checked);
    document.querySelectorAll('.qw-block-card').forEach(function(card){
      var ok = (!query || card.dataset.search.indexOf(query) >= 0) && (!category || card.dataset.category === category) && (!favorites || card.dataset.favorite === '1');
      card.style.display = ok ? '' : 'none';
    });
  }


  function toggleMediaGroup(button) {
    var group = button && button.closest ? button.closest('.qw-media-group') : null;
    if (group) group.classList.toggle('open');
  }

  function filterMediaCards() {
    var query = String((document.getElementById('mediaSearch') || {}).value || '').toLowerCase().trim();
    var type = String((document.getElementById('mediaType') || {}).value || '').toLowerCase();
    var anyVisible = false;

    document.querySelectorAll('.qw-media-group').forEach(function(group) {
      var groupName = String(group.dataset.groupName || '');
      var visibleInside = 0;

      group.querySelectorAll('.qw-media-card').forEach(function(card) {
        var searchText = String(card.dataset.mediaSearch || '');
        var cardType = String(card.dataset.mediaType || '');
        var matchesQuery = !query || searchText.indexOf(query) >= 0 || groupName.indexOf(query) >= 0;
        var matchesType = !type || cardType === type;
        var visible = matchesQuery && matchesType;
        card.style.display = visible ? '' : 'none';
        if (visible) visibleInside += 1;
      });

      group.hidden = visibleInside === 0;
      if (visibleInside > 0) {
        anyVisible = true;
        if (query || type) group.classList.add('open');
      }
    });

    var empty = document.getElementById('mediaFilterEmpty');
    if (empty) empty.classList.toggle('show', !anyVisible);
  }

  function simulateLibraryBlock(id) {
    var block = blocosSalvos.find(function(item){ return item.id === id; });
    if (!block) return;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    runVisualSimulation(block.etapas || [], 'preview', 'quickStatus');
  }

  function markUnsaved() {
    var alertBox = document.getElementById('unsavedAlert');
    if (alertBox) alertBox.classList.add('show');
  }

  function prepareSteps() {
    var hidden = document.getElementById('etapasJson');
    if (!hidden) return false;

    if (!steps.length) {
      alert('Adicione pelo menos uma etapa antes de salvar o bloco.');
      return false;
    }

    hidden.value = JSON.stringify(steps);
    return true;
  }

  var simulationRun = 0;

  function sleep(ms, runId) {
    return new Promise(function (resolve) {
      var started = Date.now();
      function tick() {
        if (runId !== simulationRun) return resolve(false);
        if (Date.now() - started >= ms) return resolve(true);
        setTimeout(tick, 100);
      }
      tick();
    });
  }

  function nowTime() {
    return new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }

  function addChatNode(container, className, html) {
    var node = document.createElement('div');
    node.className = className;
    node.innerHTML = html;
    container.appendChild(node);
    container.scrollTop = container.scrollHeight;
    return node;
  }

  function clearSimulation(previewId, statusId) {
    simulationRun += 1;
    var preview = document.getElementById(previewId);
    var status = document.getElementById(statusId);
    if (preview) preview.innerHTML = '<div class="qw-wait">Simulador limpo</div>';
    if (status) status.textContent = 'simulador pronto';
  }

  function stopSimulation() {
    simulationRun += 1;
    var statusQuick = document.getElementById('quickStatus');
    var statusSaved = document.getElementById('savedStatus');
    if (statusQuick) statusQuick.textContent = 'simulação interrompida';
    if (statusSaved) statusSaved.textContent = 'simulação interrompida';
  }

  function typingHtml(label) {
    return esc(label) + '<span class="qw-dots"><span></span><span></span><span></span></span>';
  }

  async function runVisualSimulation(items, previewId, statusId) {
    simulationRun += 1;
    var runId = simulationRun;
    var preview = document.getElementById(previewId);
    var status = document.getElementById(statusId);

    if (!preview) return;

    preview.innerHTML = '';
    if (status) status.textContent = 'executando fluxo...';

    if (!items || !items.length) {
      addChatNode(preview, 'qw-wait', 'Este bloco não possui etapas.');
      if (status) status.textContent = 'sem etapas';
      return;
    }

    for (var index = 0; index < items.length; index += 1) {
      if (runId !== simulationRun) return;
      var step = items[index] || {};

      if (step.tipo === 'texto') {
        var typingSeconds = Math.max(0, Number(step.digitandoSegundos || 0));
        var typing = addChatNode(preview, 'qw-typing', typingHtml('digitando'));
        if (status) status.textContent = 'digitando...';
        var continued = await sleep(typingSeconds * 1000, runId);
        if (!continued) return;
        typing.remove();
        addChatNode(
          preview,
          'qw-msg',
          esc(step.texto || '(texto vazio)') + '<small>' + nowTime() + ' ✓✓</small>'
        );
      }

      if (step.tipo === 'pausa') {
        var pauseSeconds = Math.max(0, Number(step.segundos || 0));
        var waitNode = addChatNode(preview, 'qw-wait', 'Aguardando ' + pauseSeconds + ' segundo(s)...');
        if (status) status.textContent = 'aguardando...';
        var pauseContinued = await sleep(pauseSeconds * 1000, runId);
        if (!pauseContinued) return;
        waitNode.remove();
      }

      if (step.tipo === 'imagem') {
        if (status) status.textContent = 'enviando imagem...';
        var imagePath = esc(step.caminho || '');
        var imageHtml = imagePath
          ? '<img src="' + imagePath + '" alt="Imagem do bloco" onerror="this.outerHTML=\'<div>Imagem não encontrada</div>\'">'
          : '<div>Imagem não selecionada</div>';
        if (step.legenda) imageHtml += '<div>' + esc(step.legenda) + '</div>';
        imageHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', imageHtml);
      }

      if (step.tipo === 'video') {
        if (status) status.textContent = 'enviando vídeo...';
        var videoPath = esc(step.caminho || '');
        var videoHtml = videoPath
          ? '<video controls preload="metadata" style="display:block;max-width:100%;max-height:340px;border-radius:9px;margin-bottom:6px" src="' + videoPath + '"></video>'
          : '<div>Vídeo não selecionado</div>';
        if (step.legenda) videoHtml += '<div>' + esc(step.legenda) + '</div>';
        videoHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', videoHtml);
      }

      if (step.tipo === 'audio') {
        var recordingSeconds = Math.max(0, Number(step.gravandoSegundos || 0));
        var recording = addChatNode(preview, 'qw-typing', typingHtml('gravando áudio'));
        if (status) status.textContent = 'gravando áudio...';
        var audioContinued = await sleep(recordingSeconds * 1000, runId);
        if (!audioContinued) return;
        recording.remove();

        var audioPath = esc(step.caminho || '');
        var audioHtml = audioPath
          ? '<audio controls preload="metadata" src="' + audioPath + '"></audio>'
          : '<div>Áudio não selecionado</div>';
        if (step.legenda) audioHtml += '<div>' + esc(step.legenda) + '</div>';
        audioHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', audioHtml);
      }

      if (step.tipo === 'arquivo') {
        if (status) status.textContent = 'enviando arquivo...';
        var filePath = esc(step.caminho || '');
        var fileHtml = filePath
          ? '<a class="qw-file" href="' + filePath + '" target="_blank">📎 Abrir arquivo</a>'
          : '<div>Arquivo não selecionado</div>';
        if (step.legenda) fileHtml += '<div>' + esc(step.legenda) + '</div>';
        fileHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', fileHtml);
      }

      if (step.tipo === 'opcoes') {
        if (status) status.textContent = 'mostrando opções...';
        var optionsHtml = '<div>' + esc(step.texto || 'Escolha uma opção:') + '</div><div class="qw-options-preview">';
        (step.opcoes || []).forEach(function (option) {
          optionsHtml += '<div class="qw-option-preview">' + esc(option.label || option.resposta || 'Opção') + '</div>';
        });
        optionsHtml += '</div><small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', optionsHtml);
      }

      await sleep(250, runId);
    }

    if (runId !== simulationRun) return;
    if (status) status.textContent = 'fluxo concluído';
    addChatNode(preview, 'qw-wait', 'Simulação concluída');
  }

  function simulateCurrent() {
    runVisualSimulation(steps, 'preview', 'quickStatus');
  }

  function simulateSaved() {
    var select = document.getElementById('simulateSelect');
    if (!select) return;

    var selected = null;
    for (var index = 0; index < blocosSalvos.length; index += 1) {
      if (blocosSalvos[index].id === select.value) {
        selected = blocosSalvos[index];
        break;
      }
    }

    runVisualSimulation(
      selected ? (selected.etapas || []) : [],
      'savedPreview',
      'savedStatus'
    );
  }

  function showInboxSendResult(message, ok){
    var box = document.getElementById('inboxSendResult');
    if(!box) return;
    box.textContent = message || '';
    box.className = 'qw-inbox-send-result show ' + (ok ? 'ok' : 'bad');
  }

  async function sendInboxText(event){
    event.preventDefault();
    var form = event.currentTarget;
    var button = document.getElementById('inboxSendTextBtn');
    var textarea = document.getElementById('inboxMessageText');
    var text = String(textarea ? textarea.value : '').trim();
    if(!text){ showInboxSendResult('Digite uma mensagem antes de enviar.', false); return false; }
    if(button) button.disabled = true;
    if(textarea) textarea.disabled = true;
    try {
      var response = await fetch('/automacao-whatsapp/inbox/enviar-texto', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ conversationId:form.elements.conversationId.value, texto:text })
      });
      var payload = await response.json();
      if(!response.ok || !payload.success) throw new Error(payload.message || 'Falha no envio.');
      if(textarea) textarea.value = '';
      inboxComposerDirty = false;
      showInboxSendResult(payload.message || 'Mensagem enviada.', true);
      window.setTimeout(function(){ window.location.reload(); }, 700);
    } catch(error){
      showInboxSendResult(error.message || 'Falha ao enviar a mensagem.', false);
    } finally {
      if(button) button.disabled = false;
      if(textarea){ textarea.disabled = false; textarea.focus(); }
    }
    return false;
  }

  async function sendInboxBlock(event){
    event.preventDefault();
    var form = event.currentTarget;
    var button = document.getElementById('inboxSendBlockBtn');
    var select = document.getElementById('inboxBlockSelect');
    var blocoId = select ? select.value : '';
    if(!blocoId){ showInboxSendResult('Selecione um bloco.', false); return false; }
    if(button) button.disabled = true;
    if(select) select.disabled = true;
    showInboxSendResult('Executando bloco. Aguarde a conclusão...', true);
    try {
      var response = await fetch('/automacao-whatsapp/inbox/executar-bloco', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ conversationId:form.elements.conversationId.value, blocoId:blocoId })
      });
      var payload = await response.json();
      if(!response.ok || !payload.success) throw new Error(payload.message || 'Falha ao executar o bloco.');
      if(select) select.value = '';
      inboxComposerDirty = false;
      showInboxSendResult(payload.message || 'Bloco executado.', true);
      window.setTimeout(function(){ window.location.reload(); }, 700);
    } catch(error){
      showInboxSendResult(error.message || 'Falha ao executar o bloco.', false);
    } finally {
      if(button) button.disabled = false;
      if(select) select.disabled = false;
    }
    return false;
  }

  var inboxPendingAttachment = null;
  function chooseInboxAttachment(accept){
    var input=document.getElementById('inboxAttachmentInput');
    if(!input)return;
    input.accept=accept||''; input.value=''; closeInboxPopovers(); input.click();
  }
  function prepareInboxAttachment(event){
    var file=event.target.files && event.target.files[0];
    if(!file)return;
    if(file.size>40*1024*1024){ showInboxSendResult('O arquivo ultrapassa o limite de 40 MB.',false); event.target.value=''; return; }
    inboxPendingAttachment=file; inboxComposerDirty=true;
    var preview=document.getElementById('inboxAttachmentPreview');
    var name=document.getElementById('inboxAttachmentName');
    if(name) name.textContent='📎 '+file.name+' · '+Math.max(1,Math.round(file.size/1024))+' KB';
    if(preview) preview.classList.add('show');
    sendInboxAttachment();
  }
  function cancelInboxAttachment(){
    inboxPendingAttachment=null;
    var input=document.getElementById('inboxAttachmentInput'); if(input) input.value='';
    document.getElementById('inboxAttachmentPreview')?.classList.remove('show');
    inboxComposerDirty=Boolean(document.getElementById('inboxMessageText')?.value);
  }
  async function sendInboxAttachment(){
    if(!inboxPendingAttachment)return;
    var conversationId=<%- JSON.stringify(selectedConversation ? selectedConversation.id : '') %>;
    var text=document.getElementById('inboxMessageText');
    var sendButton=document.getElementById('inboxSendTextBtn');
    var file=inboxPendingAttachment;
    var body=new FormData(); body.append('conversationId',conversationId); body.append('legenda',text?text.value:''); body.append('arquivo',file,file.name);
    if(sendButton)sendButton.disabled=true;
    showInboxSendResult('Enviando anexo...',true);
    try{
      var response=await fetch('/automacao-whatsapp/inbox/enviar-anexo',{method:'POST',body:body});
      var payload=await response.json();
      if(!response.ok||!payload.success)throw new Error(payload.message||'Falha ao enviar o anexo.');
      if(text)text.value=''; cancelInboxAttachment(); inboxComposerDirty=false;
      showInboxSendResult(payload.message||'Anexo enviado.',true);
      window.setTimeout(function(){window.location.reload();},850);
    }catch(error){ showInboxSendResult(error.message||'Falha ao enviar o anexo.',false); }
    finally{ if(sendButton)sendButton.disabled=false; }
  }

  function closeInboxPopovers(){ document.querySelectorAll('.qw-popover.open').forEach(function(el){el.classList.remove('open');}); }
  function toggleInboxPopover(id){ var target=document.getElementById(id); var opening=target && !target.classList.contains('open'); closeInboxPopovers(); if(opening) target.classList.add('open'); }
  async function executeInboxBlockQuick(blocoId){
    var conversationId=<%- JSON.stringify(selectedConversation ? selectedConversation.id : '') %>;
    closeInboxPopovers(); showInboxSendResult('Executando bloco...',true);
    try{ var response=await fetch('/automacao-whatsapp/inbox/executar-bloco',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({conversationId:conversationId,blocoId:blocoId})}); var payload=await response.json(); if(!response.ok||!payload.success) throw new Error(payload.message||'Falha ao executar o bloco.'); showInboxSendResult(payload.message||'Bloco executado.',true); window.setTimeout(function(){window.location.reload();},700); }catch(error){showInboxSendResult(error.message||'Falha ao executar o bloco.',false);}
  }
  function openContactDrawer(){ document.getElementById('contactDrawer')?.classList.add('open'); document.getElementById('contactDrawerBackdrop')?.classList.add('open'); closeConversationMenu(); }
  function closeContactDrawer(){ document.getElementById('contactDrawer')?.classList.remove('open'); document.getElementById('contactDrawerBackdrop')?.classList.remove('open'); }
  function openConversationMenu(event){ var menu=document.getElementById('conversationMenu'); if(!menu)return; event.stopPropagation(); menu.style.top=(event.clientY+8)+'px'; menu.style.left=Math.max(8,event.clientX-190)+'px'; menu.classList.add('open'); }
  function closeConversationMenu(){ document.getElementById('conversationMenu')?.classList.remove('open'); }
  async function markInboxUnread(conversationId){ try{ var response=await fetch('/automacao-whatsapp/inbox/marcar-nao-lida',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({conversationId:conversationId})}); var payload=await response.json(); if(!response.ok||!payload.success) throw new Error(payload.message); window.location.href='/automacao-whatsapp?tab=inbox'; }catch(error){showInboxSendResult(error.message||'Falha ao marcar como não lida.',false);} }
  document.addEventListener('click',function(event){ if(!event.target.closest('.qw-popover')&&!event.target.closest('.qw-icon-btn')) closeInboxPopovers(); if(!event.target.closest('.qw-conversation-menu')&&!event.target.closest('[title="Mais ações"]')) closeConversationMenu(); });
  document.addEventListener('keydown',function(event){ if(event.key==='Escape'){closeInboxPopovers();closeContactDrawer();closeConversationMenu();} });
  var chatBody=document.getElementById('inboxChatBody'); if(chatBody) chatBody.scrollTop=chatBody.scrollHeight;

  var inboxComposerDirty = false;
  var inboxMessageText = document.getElementById('inboxMessageText');
  if(inboxMessageText){
    inboxMessageText.addEventListener('input', function(){ inboxComposerDirty = Boolean(inboxMessageText.value); });
    inboxMessageText.addEventListener('keydown', function(event){
      if(event.key === 'Enter' && !event.shiftKey){
        event.preventDefault();
        var form = document.getElementById('inboxTextForm');
        if(form && typeof form.requestSubmit === 'function') form.requestSubmit();
      }
    });
  }

  function filterCommercialOpportunities(){
    var search=String(document.getElementById('commercialSearch')?.value||'').toLowerCase().trim();
    var status=document.getElementById('commercialStatusFilter')?.value||'';
    var attention=document.getElementById('commercialAttentionFilter')?.value||'';
    document.querySelectorAll('#commercialOpportunityList .qw-opportunity').forEach(function(item){
      var visible=(!search || String(item.dataset.search||'').includes(search)) && (!status || item.dataset.status===status) && (!attention || item.dataset.attention===attention);
      item.hidden=!visible;
    });
  }

  var inboxTypeFilter = 'all';
  function setInboxTypeFilter(type,button){ inboxTypeFilter=type||'all'; document.querySelectorAll('.qw-type-filter').forEach(function(item){item.classList.toggle('active',item===button);}); filterInboxConversations(); }
  function filterInboxConversations(){
    var input = document.getElementById('inboxSearch');
    var query = String(input ? input.value : '').toLowerCase().trim();
    document.querySelectorAll('#inboxConversationList .qw-conversation-item').forEach(function(item){
      var matchesText=!query || String(item.dataset.search || '').includes(query);
      var matchesType=inboxTypeFilter==='all' || item.dataset.type===inboxTypeFilter;
      item.style.display = matchesText && matchesType ? '' : 'none';
    });
  }

  var inboxInitialRevision = <%- JSON.stringify(typeof inboxRevision !== 'undefined' ? inboxRevision : '') %>;
  var inboxFormDirty = false;
  document.querySelectorAll('.qw-contact-form input, .qw-contact-form select').forEach(function(field){
    field.addEventListener('input', function(){ inboxFormDirty = true; });
    field.addEventListener('change', function(){ inboxFormDirty = true; });
  });
  if (<%- JSON.stringify(tab === 'inbox') %>) {
    window.setInterval(async function(){
      try {
        var selected = new URLSearchParams(window.location.search).get('conversation') || '';
        var response = await fetch('/automacao-whatsapp/inbox/state?conversation=' + encodeURIComponent(selected), { cache:'no-store' });
        var payload = await response.json();
        if (payload.success && payload.revision && payload.revision !== inboxInitialRevision) {
          if (!inboxFormDirty && !inboxComposerDirty && !document.querySelector('.qw-contact-form :focus') && !document.querySelector('.qw-inbox-composer :focus')) window.location.reload();
        }
      } catch (_) {}
    }, 2500);
  }

  function confirmStorageCleanup(form,message){
    if(!window.confirm(message+'\n\nAs mensagens, contatos e dados do CRM serão preservados.')) return false;
    var button=form && form.querySelector('button[type="submit"]'); if(button){button.disabled=true;button.textContent='Limpando...';}
    return true;
  }

  window.sendInboxText = sendInboxText;
  window.sendInboxBlock = sendInboxBlock;
  window.toggleInboxPopover = toggleInboxPopover;
  window.chooseInboxAttachment = chooseInboxAttachment;
  window.prepareInboxAttachment = prepareInboxAttachment;
  window.cancelInboxAttachment = cancelInboxAttachment;
  window.executeInboxBlockQuick = executeInboxBlockQuick;
  window.openContactDrawer = openContactDrawer;
  window.closeContactDrawer = closeContactDrawer;
  window.openConversationMenu = openConversationMenu;
  window.closeConversationMenu = closeConversationMenu;
  window.markInboxUnread = markInboxUnread;
  window.setInboxTypeFilter = setInboxTypeFilter;
  window.filterInboxConversations = filterInboxConversations;
  window.filterCommercialOpportunities = filterCommercialOpportunities;
  window.confirmStorageCleanup = confirmStorageCleanup;
  window.addStep = addStep;
  window.removeStep = removeStep;
  window.moveStep = moveStep;
  window.updateStep = updateStep;
  window.updateOption = updateOption;
  window.addOption = addOption;
  window.removeOption = removeOption;
  window.changeStepType = changeStepType;
  window.uploadMedia = uploadMedia;
  window.prepareSteps = prepareSteps;
  window.simulateCurrent = simulateCurrent;
  window.simulateSaved = simulateSaved;
  window.toggleStep = toggleStep;
  window.expandAllSteps = expandAllSteps;
  window.collapseAllSteps = collapseAllSteps;
  window.stopSimulation = stopSimulation;
  window.clearSimulation = clearSimulation;
  window.duplicateStep = duplicateStep;
  window.simulateStep = simulateStep;
  window.filterBlockCards = filterBlockCards;
  window.filterMediaCards = filterMediaCards;
  window.toggleMediaGroup = toggleMediaGroup;
  window.simulateLibraryBlock = simulateLibraryBlock;

  renderBuilder();
  var editorForm = document.getElementById('blockEditorForm');
  if (editorForm) editorForm.addEventListener('input', markUnsaved);
})();
</script>