  function appendInboxOutgoingMessages(messages){
    var body=document.getElementById('inboxChatBody');
    if(!body || !Array.isArray(messages) || !messages.length) return;
    var empty=body.querySelector('.qw-wait'); if(empty) empty.remove();
    messages.forEach(function(message){
      var item=document.createElement('div'); item.className='qw-inbox-msg outgoing';
      var kind=String(message && message.type || 'text');
      var text=String(message && message.text || '');
      var label=String(message && message.label || '');
      if(kind!=='text' && label){
        var media=document.createElement('div');
        media.style.fontWeight='700'; media.style.marginBottom=text?'5px':'0';
        media.textContent=(kind==='audio'?'🎙️ ':kind==='imagem'?'🖼️ ':kind==='video'?'🎬 ':'📄 ')+label;
        item.appendChild(media);
      }
      if(text){ var content=document.createElement('div'); content.textContent=text; item.appendChild(content); }
      var time=document.createElement('small');
      time.textContent=new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date());
      item.appendChild(time); body.appendChild(item);
    });
    body.scrollTop=body.scrollHeight;
  }

