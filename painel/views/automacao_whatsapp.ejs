  .qw-inbox-page .qw-popover{max-height:min(460px,calc(100vh - 190px));z-index:180}
  .qw-inbox-page .qw-popover-list,.qw-inbox-page .qw-emoji-grid{max-height:min(340px,46vh)}
  .qw-schedule-modal{z-index:99999!important}
  .qw-storage-report{margin-top:12px}.qw-storage-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.qw-storage-metric{border:1px solid var(--qw-line);border-radius:11px;padding:10px;background:var(--qw-card,#fff)}.qw-storage-metric strong{display:block;font-size:18px}.qw-storage-metric span{display:block;margin-top:3px;font-size:9px;color:var(--qw-muted)}.qw-storage-detail{margin-top:10px;padding:10px;border:1px solid var(--qw-line);border-radius:11px;font-size:10px;color:var(--qw-muted)}.qw-storage-actions{display:flex;gap:8px;flex-wrap:wrap}.qw-storage-actions form{margin:0}
  @media(max-width:900px){.qw-inbox-page{height:auto;min-height:calc(100vh - 108px);overflow:visible}.qw-inbox-page .qw-inbox-shell{height:auto!important}.qw-storage-metrics{grid-template-columns:repeat(2,1fr)}}

  /* 2026-08-25 — Temas escuros consistentes no CRM/WhatsApp, inclusive Blocos */
