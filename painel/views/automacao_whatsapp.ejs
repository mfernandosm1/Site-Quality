      var nextChat=doc.querySelector('.qw-inbox-chat');
      var nextPlaceholder=doc.querySelector('.qw-inbox-placeholder');
      var nextPane=nextChat||nextPlaceholder;
      var currentList=document.getElementById('inboxConversationList');
      var nextList=doc.getElementById('inboxConversationList');
      var listScroll=currentList?currentList.scrollTop:0;
      var oldChatBody=document.getElementById('inboxChatBody');
      var oldChatScroll=oldChatBody?oldChatBody.scrollTop:0;
      var oldChatNearBottom=oldChatBody ? (oldChatBody.scrollHeight-oldChatBody.scrollTop-oldChatBody.clientHeight<100) : true;
      if(!nextPane) throw new Error('Conversa não encontrada.');
      var currentPane=document.querySelector('.qw-inbox-chat')||document.querySelector('.qw-inbox-placeholder');
      if(currentList&&nextList){currentList.innerHTML=nextList.innerHTML;currentList.scrollTop=listScroll;}
      if(currentPane) currentPane.replaceWith(nextPane);
      else document.querySelector('.qw-inbox-shell')?.appendChild(nextPane);
      ['contactDrawerBackdrop','contactDrawer','conversationMenu'].forEach(function(id){
        var current=document.getElementById(id), next=doc.getElementById(id);
        if(current&&next) current.replaceWith(next); else if(!current&&next) document.querySelector('.qw-inbox-shell')?.appendChild(next);
      });
      document.querySelectorAll('.qw-conversation-item').forEach(function(item){
        var same=(new URL(item.href,window.location.origin).searchParams.get('conversation')||'')===conversationId;
        item.classList.toggle('active',same); item.classList.remove('qw-loading');
        if(same){ item.classList.remove('has-unread'); item.querySelector('.qw-unread-count')?.remove(); }
      });
      if(!options.popstate) history.pushState({inboxConversation:conversationId},'',targetUrl.pathname+targetUrl.search);
      inboxComposerDirty=false;
      bindInboxComposer();
      filterInboxConversations();
      var body=document.getElementById('inboxChatBody');
      if(body){ if(oldChatNearBottom) body.scrollTop=body.scrollHeight; else body.scrollTop=Math.min(oldChatScroll,body.scrollHeight-body.clientHeight); }
      await syncInboxRevisionMarker();
      window.setTimeout(recoverVisibleInboxMedia,250);
      return true;
    }catch(error){
      if(error && error.name==='AbortError') return false;
      window.location.href=targetUrl.pathname+targetUrl.search;
      return false;
    }finally{
      document.querySelector('.qw-inbox-chat')?.classList.remove('qw-switching');
