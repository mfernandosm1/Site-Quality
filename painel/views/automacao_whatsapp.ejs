    inboxScheduleRecorder=null;inboxScheduleRecordedChunks=[];inboxScheduleRecordedBlob=null;inboxScheduleRecordedFileName='';inboxScheduleRecordingProcessing=false;inboxScheduleRecordingStartedAt=0;inboxScheduleRecordedDurationSeconds=0;
