  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-option-card,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-flow-map,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-flow-node,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-log-row,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-media-card,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-media-group,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-settings-nav{
    background:var(--qw-card)!important;color:var(--qw-text)!important;border-color:var(--qw-line)!important;
  }
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-step-head,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-media-group-head{
    background:var(--qw-soft)!important;color:var(--qw-text)!important;border-color:var(--qw-line)!important;
  }
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-input,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-textarea,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-select{
    background:var(--qw-soft)!important;color:var(--qw-text)!important;border-color:var(--qw-line)!important;
  }
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-field label,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-check,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-step-title,
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-block-name{
    color:var(--qw-text)!important;
  }
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-btn:not(.primary):not(.success):not(.danger):not(.dark),
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-tab:not(.active),
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-mini-btn:not(.danger):not(.blue):not(.gold),
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-pill:not(.green):not(.orange):not(.red){
    background:var(--qw-soft)!important;color:var(--qw-text)!important;border-color:var(--qw-line)!important;
  }
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-mini-btn.blue{background:color-mix(in srgb,#2563eb 18%,var(--qw-card))!important;color:#bfdbfe!important;border-color:color-mix(in srgb,#60a5fa 45%,var(--qw-line))!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-mini-btn.gold{background:color-mix(in srgb,#f59e0b 14%,var(--qw-card))!important;color:#fde68a!important;border-color:color-mix(in srgb,#f59e0b 45%,var(--qw-line))!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-empty{background:var(--qw-soft)!important;color:var(--qw-muted)!important;border-color:var(--qw-line)!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-flow-start{background:color-mix(in srgb,#16a34a 14%,var(--qw-card))!important;color:#bbf7d0!important;border-color:color-mix(in srgb,#22c55e 45%,var(--qw-line))!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-flow-node.start{background:color-mix(in srgb,#16a34a 10%,var(--qw-card))!important;color:var(--qw-text)!important;border-color:color-mix(in srgb,#22c55e 35%,var(--qw-line))!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-flow-node.choice{background:color-mix(in srgb,#2563eb 12%,var(--qw-card))!important;color:var(--qw-text)!important;border-color:color-mix(in srgb,#60a5fa 35%,var(--qw-line))!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-info-tip{background:var(--qw-soft)!important;color:var(--qw-muted)!important;border-color:var(--qw-line)!important}
  html[data-panel-theme]:not([data-panel-theme="light"]) .qw-unsaved{background:color-mix(in srgb,#f59e0b 12%,var(--qw-card))!important;color:#fde68a!important;border-color:color-mix(in srgb,#f59e0b 40%,var(--qw-line))!important}

</style>

<div class="qw-wrap <%= (tab === 'inbox' || tab === 'dashboard') ? 'qw-operational' : '' %> <%= tab === 'inbox' ? 'qw-inbox-page' : '' %>">
  <% if (tab !== 'inbox') { %>
  <div class="qw-header">
    <div class="qw-title">
      <div class="qw-title-line">
        <h1>💬 Automação WhatsApp</h1>
        <span class="qw-info-tip" tabindex="0" aria-label="Informações do módulo">i<span class="qw-info-tip-text">Central de atendimento, blocos, mídias e ferramentas do WhatsApp. Versão <strong><%= version %></strong> — modo operacional compacto para atendimento diário.</span></span>
      </div>
    </div>
    <div class="qw-actions">
      <a class="qw-btn dark qw-header-action" href="/" title="Voltar ao Dashboard"><span class="qw-action-icon">←</span><span class="qw-action-label">Voltar ao Dashboard</span></a>
      <a class="qw-btn primary qw-header-action" href="/automacao-whatsapp?tab=blocos" title="Novo bloco"><span class="qw-action-icon">＋</span><span class="qw-action-label">Novo bloco</span></a>
    </div>
  </div>
  <% } %>

  <% if (flash) { %><div class="qw-flash"><%= flash %></div><% } %>

  <div class="qw-tabs">
    <a class="qw-tab <%= tab === 'dashboard' ? 'active' : '' %>" href="/automacao-whatsapp">Painel Comercial</a>
    <a class="qw-tab <%= tab === 'inbox' ? 'active' : '' %>" href="/automacao-whatsapp?tab=inbox">Inbox</a>
    <a class="qw-tab <%= tab === 'blocos' ? 'active' : '' %>" href="/automacao-whatsapp?tab=blocos">Blocos</a>
    <a class="qw-tab <%= tab === 'palavras-chave' ? 'active' : '' %>" href="/automacao-whatsapp?tab=palavras-chave">Automação</a>
    <a class="qw-tab <%= tab === 'midias' ? 'active' : '' %>" href="/automacao-whatsapp?tab=midias">Mídias</a>
    <a class="qw-tab <%= tab === 'aniversariantes' ? 'active' : '' %>" href="/automacao-whatsapp?tab=aniversariantes">Aniversariantes</a>
    <a class="qw-tab <%= tab === 'configuracoes' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes">Configurações</a>
  </div>


    <div id="newInboxConversationModal" class="qw-new-chat-modal" aria-hidden="true">
      <div class="qw-new-chat-backdrop" onclick="closeNewInboxConversation()"></div>
      <div class="qw-new-chat-panel" role="dialog" aria-modal="true" aria-label="Iniciar nova conversa">
        <div class="qw-new-chat-head"><div><strong>Iniciar conversa</strong><small>Contatos do WhatsApp e clientes cadastrados no ERP</small></div><button type="button" onclick="closeNewInboxConversation()">×</button></div>
        <div class="qw-new-chat-direct"><input id="newInboxDirectPhone" class="qw-input" inputmode="tel" placeholder="Digite um novo número, ex.: 54999999999" autocomplete="off" onkeydown="if(event.key==='Enter'){event.preventDefault();startInboxConversationByNumber();}"><button id="newInboxDirectPhoneBtn" type="button" class="qw-btn primary" onclick="startInboxConversationByNumber()">Iniciar</button></div>
        <div class="qw-new-chat-separator">ou procure um contato</div>
        <div class="qw-new-chat-search"><input id="newInboxConversationSearch" class="qw-input" placeholder="Pesquise por nome ou número" autocomplete="off" oninput="searchNewInboxConversationDebounced()"></div>
        <div id="newInboxConversationMeta" class="qw-new-chat-meta">Digite um nome ou número para pesquisar.</div>
        <div id="newInboxConversationResults" class="qw-new-chat-results"></div>
      </div>
    </div>

  <% if (tab === 'configuracoes') { %>
    <div class="qw-settings-nav">
      <a class="qw-settings-link <%= settingsSection === 'geral' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=geral">⚙️ Geral</a>
      <a class="qw-settings-link <%= settingsSection === 'conexao' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=conexao">🔗 Conexão</a>
      <a class="qw-settings-link <%= settingsSection === 'armazenamento' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=armazenamento">🧹 Armazenamento</a>
      <a class="qw-settings-link <%= settingsSection === 'logs' ? 'active' : '' %>" href="/automacao-whatsapp?tab=configuracoes&section=logs">📜 Logs</a>
    </div>
  <% } %>

  <% if (tab === 'dashboard') {
    const statusLabelsDashboard = {new:'Novo',in_progress:'Em andamento',pending:'Pendente',completed_sale:'Venda concluída',lost:'Perdido',no_potential:'Sem potencial'};
    const formatResponseTimeDashboard = function(seconds){ if(seconds===null || seconds===undefined) return '—'; if(seconds<60) return seconds+'s'; const min=Math.round(seconds/60); if(min<60) return min+' min'; return (seconds/3600).toFixed(1).replace('.',',')+' h'; };
    const inboundDaily = inboundMetrics?.daily || [];
    const inboundCompareDaily = inboundMetrics?.compareDaily || [];
    const inboundDailyMax = Math.max(1,...inboundDaily.map(function(item){return Number(item.total||0);}),...inboundCompareDaily.map(function(item){return Number(item.total||0);}));
  %>
    <div class="qw-library-heading" style="margin:2px 0 10px"><h2 style="margin:0">📊 Painel comercial</h2><span class="qw-info-tip" tabindex="0" aria-label="Como são contados os contatos">i<span class="qw-info-tip-text">Os indicadores de contatos contam cada número uma única vez no período e somente quando a primeira mensagem do período veio do cliente. Conversas iniciadas pela loja não entram nessa contagem.</span></span></div>
    <div class="qw-commercial-kpis qw-contact-kpis">
      <div class="qw-commercial-kpi inbound"><div class="value"><%= inboundMetrics?.today || 0 %></div><div class="label">Contatos hoje</div><div class="hint">Vieram até a loja</div></div>
      <div class="qw-commercial-kpi inbound"><div class="value"><%= inboundMetrics?.week || 0 %></div><div class="label">Esta semana</div><div class="hint">Contatos únicos</div></div>
      <div class="qw-commercial-kpi inbound"><div class="value"><%= inboundMetrics?.month || 0 %></div><div class="label">Este mês</div><div class="hint">Contatos únicos</div></div>
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.awaitingResponse %></div><div class="label">Aguardando resposta</div><div class="hint">Cliente falou por último</div></div>
      <div class="qw-commercial-kpi warning"><div class="value"><%= commercialDashboard.waitingOver30m %></div><div class="label">+30 min</div><div class="hint">Precisam de atenção</div></div>
      <div class="qw-commercial-kpi"><div class="value"><%= commercialDashboard.activePipeline || 0 %></div><div class="label">Pedem ação</div><div class="hint">Oportunidades priorizadas</div></div>
    </div>

    <div class="qw-commercial-main-grid">
      <div class="qw-card qw-commercial-card">
        <div class="qw-library-heading"><div><h2 style="margin:0">🎯 Oportunidades que pedem ação</h2><p class="sub" style="margin-top:4px">Fila prática para responder e acompanhar. A inteligência desta priorização ainda pode evoluir sem mudar seu fluxo.</p></div><span class="qw-pill"><%= commercialDashboard.opportunities.length %> na lista</span></div>
        <div class="qw-commercial-tools">
          <input class="qw-input" id="commercialSearch" placeholder="🔎 Buscar nome, número ou produto" oninput="filterCommercialOpportunities()">
          <select class="qw-select" id="commercialAttentionFilter" onchange="filterCommercialOpportunities()"><option value="">Todos</option><option value="waiting">Aguardando resposta</option><option value="answered">Já respondidos</option></select>
        </div>
        <div class="qw-commercial-list" id="commercialOpportunityList">
          <% if(!commercialDashboard.opportunities.length){ %><div class="qw-commercial-empty">Nenhuma conversa exige ação agora.</div><% } %>
          <% commercialDashboard.opportunities.forEach(function(c){ const search=String((c.name||'')+' '+(c.phone||'')+' '+(c.interestProduct||'')+' '+(c.opportunityReason||'')).toLowerCase(); %>
            <div class="qw-opportunity-row smart" data-commercial-row>
              <a class="qw-opportunity <%= c.attentionLevel %>" href="/automacao-whatsapp?tab=inbox&conversation=<%= c.id %>" title="Abrir conversa" data-search="<%= search %>" data-status="<%= c.commercialStatus || 'new' %>" data-attention="<%= c.awaitingResponse ? 'waiting':'answered' %>">
                <div>
                  <div class="qw-opportunity-name"><%= c.name || c.phone %></div>
                  <div class="qw-opportunity-meta"><%= statusLabelsDashboard[c.commercialStatus] || 'Novo' %><% if(c.interestProduct){ %> · Interesse: <%= c.interestProduct %><% } %></div>
                  <div class="qw-opportunity-reason"><strong><%= c.opportunityReason || 'Atendimento em andamento' %></strong><% if(c.suggestedAction){ %><span> → <%= c.suggestedAction %></span><% } %></div>
                </div>
                <div class="qw-opportunity-side"><span class="<%= c.awaitingResponse?'qw-opportunity-wait':'qw-opportunity-ok' %>"><%= c.awaitingResponse?'Responder':'Acompanhar' %></span></div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="qw-card qw-commercial-card">
        <div class="qw-library-heading"><div><h2 style="margin:0">📈 Contatos por dia</h2><p class="sub" style="margin-top:4px">Todos os dias do mês em uma única leitura, no mesmo padrão visual do Analytics.</p></div><span class="qw-info-tip" tabindex="0">i<span class="qw-info-tip-text">Conta contatos únicos em cada dia quando a primeira mensagem daquele dia veio do cliente. Selecione outro mês para comparação.</span></span></div>
        <form class="qw-inbound-controls" method="get" action="/automacao-whatsapp">
          <input type="hidden" name="tab" value="dashboard">
          <label>Mês<select class="qw-select" name="contactMonth" onchange="this.form.submit()"><% (inboundMetrics?.availableMonths||[]).forEach(function(month){ %><option value="<%= month.key %>" <%= inboundMetrics?.selectedMonth===month.key?'selected':'' %>><%= month.label %></option><% }) %></select></label>
          <label>Comparar com<select class="qw-select" name="compareMonth" onchange="this.form.submit()"><option value="none" <%= !inboundMetrics?.compareMonth?'selected':'' %>>Sem comparação</option><% (inboundMetrics?.availableMonths||[]).forEach(function(month){ %><option value="<%= month.key %>" <%= inboundMetrics?.compareMonth===month.key?'selected':'' %>><%= month.label %></option><% }) %></select></label>
        </form>
        <div class="qw-inbound-summary"><span class="current"><b><%= inboundMetrics?.selectedTotal||0 %></b> <%= inboundMetrics?.selectedMonthLabel||'' %></span><% if(inboundMetrics?.compareMonth){ %><span class="compare"><b><%= inboundMetrics?.compareTotal||0 %></b> <%= inboundMetrics?.compareMonthLabel||'' %></span><span class="delta <%= Number(inboundMetrics?.deltaPercent||0)>=0?'up':'down' %>"><%= inboundMetrics?.deltaPercent===null?'—':((Number(inboundMetrics.deltaPercent)>=0?'+':'')+String(inboundMetrics.deltaPercent).replace('.',',')+'%') %></span><% } %></div>
        <div class="qw-inbound-daily"><% inboundDaily.forEach(function(item,index){ const day=String(item.date||'').slice(8,10); const compare=inboundCompareDaily[index]||{}; const total=Number(item.total||0); const compareTotal=Number(compare.total||0); const height=total>0?Math.max(5,Math.round((total/inboundDailyMax)*100)):0; const compareHeight=compareTotal>0?Math.max(5,Math.round((compareTotal/inboundDailyMax)*100)):0; %><div class="qw-inbound-day" title="<%= inboundMetrics?.selectedMonthLabel %> dia <%= day %>: <%= total %><% if(inboundMetrics?.compareMonth){ %> · <%= inboundMetrics?.compareMonthLabel %>: <%= compareTotal %><% } %>"><span><%= total || '' %></span><div class="qw-inbound-bars"><i class="current" style="height:<%= height %>%"></i><% if(inboundMetrics?.compareMonth){ %><i class="compare" style="height:<%= compareHeight %>%"></i><% } %></div><small><%= day %></small></div><% }) %></div>
        <div class="qw-inbound-chart-note">Passe o mouse sobre uma barra para conferir o dia.</div>
      </div>
    </div>

    <div class="qw-dashboard-fold-grid">
      <details class="qw-dashboard-fold">
        <summary><span>📅 Agenda / Lembretes</span><span class="qw-pill"><%= taskOverview.overdue.length + taskOverview.today.length + taskOverview.upcoming.length %></span></summary>
        <div class="qw-dashboard-fold-body">
          <div class="qw-task-kpis"><div class="qw-task-kpi"><strong><%= taskOverview.overdue.length %></strong><span>Atrasados</span></div><div class="qw-task-kpi"><strong><%= taskOverview.today.length %></strong><span>Hoje</span></div><div class="qw-task-kpi"><strong><%= taskOverview.upcoming.length %></strong><span>Próximos</span></div></div>
          <div class="qw-dashboard-task-grid"><% [['overdue','🔴 Atrasados'],['today','🟠 Hoje'],['upcoming','🟢 Próximos']].forEach(function(group){ var list=taskOverview[group[0]]||[]; %><div class="qw-dashboard-task-col"><h3><%= group[1] %></h3><% if(!list.length){ %><div class="qw-task-empty">Nenhum lembrete.</div><% } %><% list.slice(0,5).forEach(function(task){ %><div class="qw-dashboard-task-row"><a class="qw-dashboard-task-link" href="/automacao-whatsapp?tab=inbox&conversation=<%= encodeURIComponent(task.conversationId||'') %>"><strong><%= task.title %></strong><small><%= formatDateTime(task.dueAt) %></small></a></div><% }) %></div><% }) %></div>
        </div>
      </details>

      <details class="qw-dashboard-fold">
        <summary><span>🕘 Mensagens agendadas</span><span class="qw-pill"><%= (scheduledOverview||[]).length %></span></summary>
        <div class="qw-dashboard-fold-body">
          <div class="qw-schedule-list-actions" style="justify-content:flex-end;margin-bottom:8px"><button type="button" onclick="clearScheduledHistoryFromDashboard()">Limpar histórico</button></div>
          <div class="qw-scheduled-dashboard-list"><% if(!(scheduledOverview||[]).length){ %><div class="qw-commercial-empty">Nenhuma mensagem agendada pendente.</div><% } %><% (scheduledOverview||[]).forEach(function(item){ var scheduleIcon=item.type==='video'?'🎬':item.type==='image'?'🖼️':item.type==='audio'?'🎙️':'💬'; %><div class="qw-scheduled-dashboard-row <%= item.status==='erro'?'error':'' %>" data-dashboard-schedule-id="<%= item.id %>"><div class="qw-scheduled-dashboard-main"><strong><%= scheduleIcon %> <%= item.conversationName || 'Contato' %></strong><small><%= formatDateTime(item.scheduledAt) %> · <%= item.status==='erro'?'Erro — revisar':'Agendado' %><% if(item.text){ %> · <%= String(item.text).slice(0,80) %><% } %></small></div><div class="qw-scheduled-dashboard-actions"><a href="/automacao-whatsapp?tab=inbox&conversation=<%= encodeURIComponent(item.conversationId||'') %>">Abrir</a><button type="button" onclick="deleteInboxScheduledMessage('<%= item.id %>',true)">Excluir</button></div></div><% }) %></div>
        </div>
      </details>

      <details class="qw-dashboard-fold">
        <summary><span>⏱️ Atendimento</span><span class="qw-pill"><%= commercialDashboard.awaitingResponse %> aguardando</span></summary>
        <div class="qw-dashboard-fold-body"><div class="qw-smart-panel"><div class="qw-smart-metric"><strong><%= formatResponseTimeDashboard(commercialDashboard.averageFirstResponseSeconds) %></strong><span>1ª resposta média · 30d</span></div><div class="qw-smart-metric"><strong><%= commercialDashboard.awaitingResponse %></strong><span>Aguardando agora</span></div><div class="qw-smart-metric"><strong><%= commercialDashboard.waitingOver2h %></strong><span>Críticos +2h</span></div></div></div>
      </details>

      <details class="qw-dashboard-fold">
        <summary><span>🔎 Interesses detectados</span><span class="qw-pill"><%= (commercialDashboard.topProductInterests||[]).length + (commercialDashboard.topServiceInterests||[]).length %> itens</span></summary>
        <div class="qw-dashboard-fold-body"><div class="qw-interest-groups"><section><h3>📱 Produtos</h3><% if(!(commercialDashboard.topProductInterests||[]).length){ %><div class="qw-commercial-empty">Nenhum produto cadastrado foi identificado com segurança.</div><% } %><% (commercialDashboard.topProductInterests||[]).forEach(function(item){ %><div class="qw-interest-row"><span><%= item.name %></span><strong><%= item.total %></strong></div><% }) %></section><section><h3>🛠️ Serviços</h3><% if(!(commercialDashboard.topServiceInterests||[]).length){ %><div class="qw-commercial-empty">Nenhum serviço cadastrado foi identificado com segurança.</div><% } %><% (commercialDashboard.topServiceInterests||[]).forEach(function(item){ %><div class="qw-interest-row"><span><%= item.name %></span><strong><%= item.total %></strong></div><% }) %></section></div></div>
      </details>
    </div>
  <% } %>



  <% if (tab === 'palavras-chave') {
    const regrasAtivas=(palavrasChave||[]).filter(function(item){return item.ativo;});
    const totalExecucoes=(palavrasChave||[]).reduce(function(total,item){return total+Number(item.execucoes||0);},0);
    const regraAtual=keywordEdit||null;
  %>
    <div class="qw-grid">
      <div class="qw-card qw-span-12">
        <div class="qw-library-heading"><h2 style="margin:0">⚡ Automação</h2><span class="qw-info-tip" tabindex="0" aria-label="Como funciona a automação">i<span class="qw-info-tip-text">Quando uma mensagem recebida corresponde a uma regra ativa, o Quality executa o bloco vinculado. Se o cliente estiver no meio de um menu/opção, a resposta do fluxo tem prioridade.</span></span></div>
        <div class="qw-keyword-summary">
          <span class="qw-pill green"><%= regrasAtivas.length %> ativa(s)</span>
          <span class="qw-pill"><%= (palavrasChave||[]).length === 1 ? '1 automação' : (palavrasChave||[]).length+' automações' %></span>
          <span class="qw-pill"><%= totalExecucoes === 0 ? 'Nenhuma resposta automática' : (totalExecucoes === 1 ? '1 resposta automática' : totalExecucoes+' respostas automáticas') %></span>
          <span class="qw-pill <%= whatsapp.status === 'conectado' ? 'green':'orange' %>">WhatsApp <%= whatsapp.status === 'conectado' ? 'conectado':'offline' %></span>
        </div>
      </div>

      <div class="qw-card qw-span-12 qw-automation-metrics">
        <div class="qw-library-heading"><h2 style="margin:0">📈 Respostas automáticas</h2><span class="qw-info-tip" tabindex="0">i<span class="qw-info-tip-text">Hoje, semana e mês usam o histórico de acionamentos. O total preserva os acionamentos existentes.</span></span></div>
        <div class="qw-automation-kpis"><div><strong><%= keywordMetrics?.today || 0 %></strong><span>Hoje</span></div><div><strong><%= keywordMetrics?.week || 0 %></strong><span>Esta semana</span></div><div><strong><%= keywordMetrics?.month || 0 %></strong><span>Este mês</span></div><div><strong><%= keywordMetrics?.total || 0 %></strong><span>Total</span></div></div>
        <% if((keywordMetrics?.topTerms||[]).length){ %><div class="qw-automation-ranking"><strong>Perguntas/frases mais acionadas</strong><% (keywordMetrics.topTerms||[]).slice(0,5).forEach(function(item,index){ %><div class="qw-automation-rank"><span><b><%= index+1 %>.</b> <%= item.label %></span><strong><%= item.total %></strong></div><% }) %></div><% } else if((keywordMetrics?.top||[]).length){ %><div class="qw-automation-ranking"><strong>Automações mais usadas</strong><% (keywordMetrics.top||[]).slice(0,5).forEach(function(item,index){ %><div class="qw-automation-rank"><span><b><%= index+1 %>.</b> <%= item.nome %><small><%= item.ultimaMensagem ? 'Última: '+item.ultimaMensagem : '' %></small></span><strong><%= item.total %></strong></div><% }) %></div><% } %>
      </div>

      <details class="qw-card qw-span-12 qw-automation-create" <%= regraAtual ? 'open':'' %>>
        <summary><span><%= regraAtual ? '✏️ Editar automação' : '➕ Nova automação' %></span><% if (regraAtual) { %><small class="qw-muted">Edição em andamento</small><% } %></summary>
        <div class="qw-automation-create-body">
          <form method="post" action="/automacao-whatsapp/palavras-chave/salvar">
            <input type="hidden" name="id" value="<%= regraAtual?.id || '' %>">
            <div class="qw-field"><label>Nome interno</label><input class="qw-input" name="nome" value="<%= regraAtual?.nome || '' %>" placeholder="Ex.: Horário de atendimento"></div>
            <div class="qw-field"><label>Quando a mensagem...</label><select class="qw-select" name="modo"><option value="contem" <%= !regraAtual || regraAtual.modo==='contem'?'selected':'' %>>Contém uma das palavras/frases</option><option value="igual" <%= regraAtual?.modo==='igual'?'selected':'' %>>É exatamente igual</option><option value="comeca" <%= regraAtual?.modo==='comeca'?'selected':'' %>>Começa com</option></select></div>
            <div class="qw-field"><label>Frases que acionam esta automação</label><textarea class="qw-textarea" name="palavras" rows="6" placeholder="qual horário vocês atendem&#10;horário de atendimento&#10;que horas abre"><%= (regraAtual?.palavras||[]).join('\n') %></textarea><div class="qw-keyword-form-help">Uma por linha. Também aceita vírgula ou ponto e vírgula. A busca ignora maiúsculas e acentos.</div></div>
            <div class="qw-field"><label>Bloco que será executado <span class="qw-muted">(opcional)</span></label><select class="qw-select" id="keywordBlockSelect" name="blocoId" onchange="syncKeywordDraftState()"><option value="">Nenhum bloco por enquanto</option><% blocos.forEach(function(b){ %><option value="<%= b.id %>" <%= regraAtual?.blocoId===b.id?'selected':'' %>><%= b.nome %><%= b.ativo?'':' · inativo' %></option><% }) %></select><div class="qw-keyword-form-help">A lista se atualiza automaticamente quando você cria ou altera blocos em outra aba. Você pode salvar sem bloco e completar depois.</div><div id="keywordNoBlockWarning" class="qw-warning" style="display:none;margin-top:8px">⚠️ Nenhum bloco selecionado. Esta automação será salva como <strong>rascunho inativo</strong> e não responderá clientes até você vincular um bloco e ativá-la.</div></div>
            <label class="qw-check"><input id="keywordActiveCheckbox" type="checkbox" name="ativo" <%= regraAtual?.ativo ? 'checked':'' %>> Automação ativa</label>
            <div class="qw-actions" style="justify-content:flex-start;margin-top:12px"><button class="qw-btn primary" type="submit">Salvar automação</button><% if(regraAtual){ %><a class="qw-btn dark" href="/automacao-whatsapp?tab=palavras-chave">Cancelar edição</a><% } %></div>
          </form>
        </div>
      </details>

      <div class="qw-span-12 qw-automation-workbench">
        <div class="qw-card">
          <h2>🧪 Simulador de mensagem</h2>

          <input id="keywordSimulatorInput" class="qw-input" placeholder="Ex.: Qual horário vocês atendem hoje?" oninput="simulateKeywordTrigger()">
          <div id="keywordSimulatorResult" class="qw-keyword-sim-result">Digite uma mensagem para testar.</div>
        </div>

        <div class="qw-card">
          <div class="qw-library-heading"><div><h2 style="margin:0">📋 Automações cadastradas</h2><p class="sub" style="margin-top:4px">Lista compacta. A primeira regra compatível tem prioridade.</p></div><span class="qw-pill"><%= (palavrasChave||[]).length %></span></div>
          <div class="qw-keyword-list-tools">
            <input id="keywordAutomationSearch" class="qw-input" placeholder="🔎 Buscar automação, frase ou bloco" oninput="filterKeywordAutomationList()">
            <select id="keywordAutomationState" class="qw-select" onchange="filterKeywordAutomationList()"><option value="">Ativas e inativas</option><option value="active">Somente ativas</option><option value="inactive">Somente inativas</option></select>
          </div>
          <div class="qw-keyword-list" id="keywordAutomationList">
            <% if(!(palavrasChave||[]).length){ %><div class="qw-keyword-list-empty">Nenhuma automação cadastrada ainda.</div><% } %>
            <% (palavrasChave||[]).forEach(function(rule,index){ const target=blocos.find(function(b){return b.id===rule.blocoId;}); const triggerPreview=(rule.palavras||[]).join(' · '); const searchText=String((rule.nome||'')+' '+triggerPreview+' '+(target?.nome||'')).toLowerCase(); %>
              <div class="qw-keyword-list-row <%= rule.ativo?'':'is-off' %>" data-keyword-row data-state="<%= rule.ativo?'active':'inactive' %>" data-search="<%= searchText %>">
                <div class="qw-keyword-order">#<%= index+1 %></div>
                <div class="qw-keyword-main"><strong><%= rule.nome %></strong><small><%= rule.modo==='igual'?'Igual a':rule.modo==='comeca'?'Começa com':'Contém' %> · bloco: <%= target?.nome || (rule.blocoId ? 'Bloco não encontrado' : '⚠ sem bloco — rascunho') %></small></div>
                <div class="qw-keyword-trigger-preview" title="<%= triggerPreview %>"><%= triggerPreview || 'Sem frase configurada' %></div>
                <div><span class="qw-keyword-state"><%= rule.ativo?'Ativa':'Inativa' %></span><span class="qw-keyword-usage"><%= Number(rule.execucoes||0) %> execução(ões)<%= rule.ultimoAcionamentoEm ? ' · '+formatDateTime(rule.ultimoAcionamentoEm):'' %></span></div>
                <div class="qw-keyword-list-actions">
                  <form method="post" action="/automacao-whatsapp/palavras-chave/mover/<%= rule.id %>"><input type="hidden" name="direction" value="up"><button class="qw-mini-btn" type="submit" title="Subir prioridade" <%= index===0?'disabled':'' %>>↑</button></form>
                  <form method="post" action="/automacao-whatsapp/palavras-chave/mover/<%= rule.id %>"><input type="hidden" name="direction" value="down"><button class="qw-mini-btn" type="submit" title="Descer prioridade" <%= index===(palavrasChave.length-1)?'disabled':'' %>>↓</button></form>
                  <a class="qw-mini-btn blue" style="text-decoration:none" href="/automacao-whatsapp?tab=palavras-chave&kwedit=<%= rule.id %>">Editar</a>
                  <form method="post" action="/automacao-whatsapp/palavras-chave/toggle/<%= rule.id %>"><button class="qw-mini-btn <%= rule.ativo?'danger':'' %>" type="submit"><%= rule.ativo?'Desativar':'Ativar' %></button></form>
                  <form method="post" action="/automacao-whatsapp/palavras-chave/excluir/<%= rule.id %>" onsubmit="return confirm('Excluir esta automação?')"><button class="qw-mini-btn danger" type="submit">Excluir</button></form>
                </div>
              </div>
            <% }) %>
          </div>
          <div id="keywordAutomationEmptySearch" class="qw-keyword-list-empty" hidden>Nenhuma automação encontrada com estes filtros.</div>
        </div>
      </div>
    </div>
  <% } %>


  <% if (tab === 'inbox') {
    const statusLabels = {new:'Novo contato',in_progress:'Em andamento',pending:'Pendente',completed_sale:'Venda concluída',lost:'Perdido',no_potential:'Sem potencial'};
    const originLabels = {site_quality:'Site Quality',instagram:'Instagram',whatsapp_direct:'WhatsApp direto',campaign:'Campanha',referral:'Indicação',unknown:'Desconhecida'};
    const relativeTime = function(value){
      try {
        const date = new Date(value), diff = Date.now() - date.getTime(), min = Math.floor(diff/60000), hours = Math.floor(diff/3600000), days = Math.floor(diff/86400000);
        if(min < 1) return 'Agora'; if(min < 60) return min+' min'; if(hours < 24) return date.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
        if(days === 1) return 'Ontem'; if(days < 7) return date.toLocaleDateString('pt-BR',{weekday:'short'}).replace('.','');
        return date.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'});
      } catch { return '—'; }
    };
    const formatDateTime = function(value){ try{return new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(value));}catch{return '—';} };
  %>

    <% if (!inboxConversations.length) { %>
      <div class="qw-card qw-inbox-empty"><div><div class="qw-inbox-empty-icon">💬</div><h2>Nenhuma conversa registrada</h2><p class="qw-muted">As novas mensagens aparecerão aqui automaticamente.</p></div></div>
    <% } else { %>
      <div class="qw-inbox-shell">
        <div class="qw-card qw-inbox-list">
          <div class="qw-inbox-list-head"><div class="qw-sync-row"><input class="qw-input" id="inboxSearch" placeholder="🔎 Buscar conversa" oninput="filterInboxConversations()"><button class="qw-new-chat-btn" type="button" title="Iniciar nova conversa" onclick="openNewInboxConversation()">＋</button><button id="inboxSyncBtn" class="qw-sync-btn" type="button" title="Forçar sincronização do Inbox" onclick="syncInboxNow()">↻</button></div><div id="inboxSyncMeta" class="qw-sync-meta"><%= whatsapp.syncing ? 'Sincronizando agora...' : (whatsapp.lastSyncAt ? 'Última sincronização: '+formatDateTime(whatsapp.lastSyncAt) : 'Sincronização automática ao conectar') %></div><div class="qw-inbox-type-filters"><button type="button" class="qw-type-filter active" data-inbox-type="all" onclick="setInboxTypeFilter('all',this)">Todos</button><button type="button" class="qw-type-filter" data-inbox-type="contact" onclick="setInboxTypeFilter('contact',this)">Contatos</button><button type="button" class="qw-type-filter" data-inbox-type="group" onclick="setInboxTypeFilter('group',this)">Grupos</button></div></div>
          <div class="qw-conversation-list" id="inboxConversationList">
            <% inboxConversations.forEach(function(c){ const selected = selectedConversation && selectedConversation.id === c.id; const unread=Number(c.unreadCount||0); const cTasks=(taskOverview.byConversation&&taskOverview.byConversation[c.id])||[]; const cTask=cTasks[0]||null; %>
              <a class="qw-conversation-item status-<%= c.commercialStatus || 'new' %> <%= unread ? 'has-unread':'' %> <%= selected ? 'active':'' %>" data-type="<%= c.conversationType || 'contact' %>" data-search="<%= String((c.name||'')+' '+(c.phone||'')+' '+(c.lastMessageAuthor||'')).toLowerCase() %>" href="/automacao-whatsapp?tab=inbox&conversation=<%= encodeURIComponent(c.id) %>">
                <div class="qw-conversation-top"><span class="qw-conversation-title"><%= c.conversationType==='group' ? '👥 ' : '' %><%= c.name || c.phone %><% if(c.conversationType==='group'){ %><span class="qw-group-badge">Grupo</span><% } %></span><span class="qw-conversation-time"><%= relativeTime(c.lastMessageAt) %></span></div>
                <div class="qw-conversation-bottom"><span class="qw-conversation-preview"><%= c.lastMessageDirection==='outgoing' ? '✓ ' : '' %><%= c.conversationType==='group' && c.lastMessageAuthor ? c.lastMessageAuthor+': ' : '' %><%= c.lastMessageText || 'Mídia' %></span><% if(unread){ %><span class="qw-unread-count"><%= unread > 99 ? '99+' : unread %></span><% } %></div><% if(c.pendingType&&c.pendingType!=='none'){ %><span class="qw-pending-chip">⚠ <%= c.pendingNote||c.pendingType %></span><% } %><% if(c.nextAction){ %><div class="qw-next-action"><strong>Próxima:</strong> <%= c.nextAction %></div><% } %><% if(cTask){ %><div class="qw-conversation-task <%= cTask.bucket==='overdue'?'overdue':'' %>">📅 <%= cTask.bucket==='overdue'?'Atrasado':cTask.bucket==='today'?'Hoje':formatDateTime(cTask.dueAt) %> · <%= cTask.title %></div><% } %>
              </a>
            <% }) %>
          </div>
        </div>

        <% if (selectedConversation) { %>
          <div class="qw-card qw-inbox-chat" data-conversation-id="<%= selectedConversation.id %>" data-conversation-type="<%= selectedConversation.conversationType || 'contact' %>">
            <div id="inboxSendResult" class="qw-inbox-send-result" role="status" aria-live="polite"></div>
            <div class="qw-inbox-chat-head">
              <div class="qw-contact-heading"><h2 style="margin:0"><%= selectedConversation.conversationType==='group' ? '👥 ' : '' %><%= selectedConversation.name || selectedConversation.phone %></h2><div class="qw-contact-sub"><% if(selectedConversation.conversationType==='group'){ %><%= selectedConversation.groupParticipantCount ? selectedConversation.groupParticipantCount+' participantes · ' : '' %>Grupo do WhatsApp<% } else { %><span class="qw-chat-status-dot <%= selectedConversation.awaitingResponse?'wait':'' %>"></span><%= selectedConversation.awaitingResponse?'Aguardando resposta':'Respondido' %> · <%= selectedConversation.phoneResolved ? ('+'+selectedConversation.phone) : 'número pendente' %> · <span class="qw-attendance-badge <%= selectedConversation.attendanceState==='closed'?'closed':'' %>"><%= selectedConversation.attendanceState==='closed'?'Atendimento encerrado':'Atendimento aberto' %></span><% } %></div></div>
              <div class="qw-chat-toolbar">
                <% if(selectedConversation.conversationType!=='group'){ %><div class="qw-attendance-actions"><% if(selectedConversation.attendanceState==='closed'){ %><form method="post" action="/automacao-whatsapp/inbox/atendimento"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="action" value="reopen"><button class="qw-btn" type="submit">↻ Reabrir</button></form><% } else { %><form class="qw-close-form" method="post" action="/automacao-whatsapp/inbox/atendimento" onsubmit="return confirm('Encerrar este atendimento? Ele sairá do Painel Comercial, mas continuará no Inbox.')"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="action" value="close"><select class="qw-select qw-close-reason" name="reason"><option value="completed">Atendimento concluído</option><option value="customer_bought">Cliente comprou</option><option value="customer_gave_up">Cliente desistiu</option><option value="will_think">Vai pensar</option><option value="no_interest">Sem interesse</option><option value="other">Outro</option></select><button class="qw-btn" type="submit">✓ Encerrar</button></form><% } %></div><button class="qw-icon-btn" type="button" title="Dados do contato" onclick="openContactDrawer()">👤</button><% } %>
                <button class="qw-icon-btn" type="button" title="Mais ações" onclick="openConversationMenu(event)">⋮</button>
              </div>
            </div>
            <% var selectedOpenTasks=(taskOverview.byConversation&&taskOverview.byConversation[selectedConversation.id])||[]; var selectedTopTask=selectedOpenTasks[0]||null; if(selectedTopTask){ %><div class="qw-chat-reminder <%= selectedTopTask.bucket==='overdue'?'overdue':'' %>"><div class="qw-chat-reminder-text">📅 <%= selectedTopTask.title %> · <%= formatDateTime(selectedTopTask.dueAt) %><% if(selectedOpenTasks.length>1){ %> · +<%= selectedOpenTasks.length-1 %> outro(s)<% } %></div><form method="post" action="/automacao-whatsapp/inbox/cliente/lembrete/concluir"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="taskId" value="<%= selectedTopTask.id %>"><input type="hidden" name="returnTo" value="/automacao-whatsapp?tab=inbox&amp;conversation=<%= encodeURIComponent(selectedConversation.id) %>"><button class="qw-chat-reminder-complete" type="submit">✓ Concluir</button></form></div><% } %>
            <div class="qw-inbox-chat-body" id="inboxChatBody">
              <% if (!selectedMessages.length) { %><div class="qw-wait">Nenhuma mensagem salva.</div><% } %>
              <% selectedMessages.forEach(function(m){ var media=m.media||null; var mediaUrl='/automacao-whatsapp/inbox/media/'+encodeURIComponent(selectedConversation.id)+'/'+encodeURIComponent(m.id); var mediaName=(media&&(media.originalName||media.filename))||''; var isSticker=m.type==='sticker'||(media&&media.kind==='sticker'); var mime=String((media&&media.mime)||'').toLowerCase(); var lowerName=String(mediaName||'').toLowerCase(); var isPdf=mime==='application/pdf'||lowerName.endsWith('.pdf'); var docIcon=isPdf?'📕':(/\.docx?$/.test(lowerName)||mime.includes('word'))?'📘':(/\.xlsx?$/.test(lowerName)||mime.includes('excel')||mime.includes('spreadsheet'))?'📗':(/\.zip$/.test(lowerName)||mime.includes('zip'))?'🗜️':(/\.txt$/.test(lowerName)||mime==='text/plain')?'📝':'📄'; %><div class="qw-inbox-msg <%= m.direction %>"><% if(selectedConversation.conversationType==='group' && m.authorName){ %><div class="qw-message-author"><%= m.authorName %></div><% } %>
                <% if(m.hasMedia && media && media.stored){ %><div class="qw-inbox-media <%= isSticker?'qw-inbox-sticker':'' %>">
                  <% if(isSticker){ %><a href="<%= mediaUrl %>" target="_blank" rel="noopener"><img src="<%= mediaUrl %>" alt="Figurinha" loading="lazy"></a><span class="qw-inbox-sticker-label">Figurinha</span><% } else if(media.kind==='image'){ %><a href="<%= mediaUrl %>" target="_blank" rel="noopener"><img src="<%= mediaUrl %>" alt="<%= mediaName || 'Imagem' %>" loading="lazy"></a><% } %>
                  <% if(media.kind==='audio'){ %><div class="qw-inbox-audio-card"><div class="qw-inbox-audio-head"><span class="qw-inbox-audio-icon">🎙️</span><span class="qw-inbox-audio-title"><%= mediaName || 'Áudio recebido' %></span></div><audio controls preload="metadata" src="<%= mediaUrl %>"></audio></div><% } %>
                  <% if(media.kind==='video'){ %><video controls preload="metadata" src="<%= mediaUrl %>"></video><% } %>
                  <% if(media.kind==='document'){ %><a class="qw-inbox-document" href="<%= mediaUrl %>" target="_blank" rel="noopener"><span class="qw-inbox-document-icon"><%= docIcon %></span><span class="qw-inbox-document-info"><span class="qw-inbox-document-name"><%= mediaName || 'Documento' %></span><span class="qw-inbox-document-meta"><%= isPdf?'PDF':(media.mime || 'Arquivo') %><%= media.size ? ' · '+(media.size>=1048576?(media.size/1048576).toFixed(1)+' MB':Math.max(1,Math.round(media.size/1024))+' KB') : '' %></span></span></a><% } %>
                  <span class="qw-media-status">✓ Salva localmente</span><div class="qw-media-actions"><a class="qw-media-action" href="<%= mediaUrl %>" target="_blank" rel="noopener">👁 <%= isPdf?'Abrir PDF':'Abrir' %></a><a class="qw-media-action" href="<%= mediaUrl %>?download=1">⬇ Baixar</a></div>
                </div><% } else if(m.hasMedia){ var remoteKind=isSticker?'sticker':((media&&media.kind)||'document'); %><div class="qw-inbox-media qw-remote-media <%= remoteKind==='sticker'?'qw-inbox-sticker':'' %>" data-remote-media>
                  <div class="qw-inbox-document" style="cursor:default"><span class="qw-inbox-document-icon"><%= remoteKind==='audio'?'🎙️':remoteKind==='sticker'?'🏷️':remoteKind==='image'?'🖼️':remoteKind==='video'?'🎬':docIcon %></span><span class="qw-inbox-document-info"><span class="qw-inbox-document-name"><%= mediaName || (remoteKind==='audio'?'Áudio':remoteKind==='sticker'?'Figurinha':remoteKind==='image'?'Imagem':remoteKind==='video'?'Vídeo':'Arquivo recebido') %></span><span class="qw-inbox-document-meta">☁ Disponível sob demanda</span></span></div>
                  <div class="qw-remote-media-note">Será recuperada e salva localmente quando você abrir.</div>
                  <div class="qw-media-actions"><button type="button" class="qw-media-action" data-url="<%= mediaUrl %>" data-kind="<%= remoteKind %>" data-name="<%= mediaName||'arquivo' %>" onclick="loadInboxRemoteMedia(this,this.dataset.url,this.dataset.kind,this.dataset.name)">👁 <%= remoteKind==='audio'?'Carregar áudio':remoteKind==='sticker'?'Abrir figurinha':remoteKind==='image'?'Abrir imagem':remoteKind==='video'?'Carregar vídeo':isPdf?'Abrir PDF':'Visualizar' %></button><a class="qw-media-action" href="<%= mediaUrl %>?download=1">⬇ Baixar</a></div>
                </div><% } %>
                <% if(m.text){ %><div><%= m.text %></div><% } else if(!m.hasMedia){ %><div>[<%= m.type || 'mensagem' %>]</div><% } %><small><%= formatDateTime(m.timestamp) %></small></div><% }) %>
            </div>
            <div class="qw-inbox-composer">
              <div id="inboxAttachPopover" class="qw-popover"><div class="qw-popover-title">➕ Anexar</div>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('image/*')"><span>🖼️</span><span>Imagem <small>JPG, PNG, WebP ou GIF</small></span></button>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('audio/*')"><span>🎙️</span><span>Áudio <small>MP3, OGG, M4A ou WebM</small></span></button>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip')"><span>📄</span><span>Documento <small>PDF, Office, TXT ou ZIP</small></span></button>
                <button class="qw-attach-item" type="button" onclick="chooseInboxAttachment('video/mp4,video/webm')"><span>🎬</span><span>Vídeo <small>MP4 ou WebM · até 40 MB</small></span></button>
              </div>
              <div id="inboxBlockPopover" class="qw-popover"><div class="qw-popover-title">🧩 Executar bloco</div><div class="qw-block-popover-search"><input id="inboxBlockSearch" class="qw-input" placeholder="🔎 Buscar bloco" autocomplete="off" oninput="filterInboxBlocks()"></div><div class="qw-popover-list" id="inboxBlockList"><% blocos.filter(function(b){return b.ativo;}).forEach(function(b){ const blockSearch=String((b.nome||'')+' '+(b.categoria||'')+' '+(b.gatilho||'')).toLowerCase(); %><button class="qw-popover-item" type="button" data-search="<%= blockSearch %>" onclick="executeInboxBlockQuick('<%= b.id %>')"><%= b.nome %><small><%= (b.etapas||[]).length %> etapa(s) · <%= b.categoria || 'Geral' %></small></button><% }) %><div id="inboxBlockSearchEmpty" class="qw-block-search-empty">Nenhum bloco encontrado.</div></div></div>
              <div id="inboxEmojiPopover" class="qw-popover qw-emoji-popover"><div class="qw-popover-title">😊 Emojis</div><div class="qw-emoji-grid"><% ['😀','😃','😄','😁','😊','😍','🥰','😉','🙂','😂','🤣','😅','🙏','👍','👏','🤝','💙','❤️','💚','💛','🔥','✨','🎉','🥳','🎂','🎁','📱','📲','🔧','🛠️','✅','❌','⚠️','📍','💰','💳','🚚','📦','🍎','⌚','🎮','☕','👋','🤗','😎','🤔','💬','📸'].forEach(function(emoji){ %><button class="qw-emoji-btn" type="button" onclick="insertInboxEmoji('<%= emoji %>')" title="<%= emoji %>"><%= emoji %></button><% }) %></div></div>
              <form id="inboxTextForm" onsubmit="return sendInboxText(event)"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><div class="qw-composer-bar">
                <button class="qw-icon-btn" type="button" title="Anexar" onclick="toggleInboxPopover('inboxAttachPopover')">＋</button>
                <button class="qw-icon-btn" type="button" title="Executar bloco" onclick="toggleInboxPopover('inboxBlockPopover')">🧩</button>
                <button class="qw-icon-btn" type="button" title="Emojis" onclick="toggleInboxPopover('inboxEmojiPopover')">😊</button>
                <button class="qw-icon-btn qw-schedule-trigger" type="button" title="Agendar mensagem" data-inbox-schedule-open>🕘</button>
                <textarea id="inboxMessageText" class="qw-textarea qw-inbox-compose-text" name="texto" maxlength="4000" placeholder="Digite uma mensagem" <%= (selectedConversation.conversationType==='group' || selectedConversation.phoneResolved) && whatsapp.status === 'conectado' ? '' : 'disabled' %>></textarea>
                <button id="inboxSendTextBtn" class="qw-icon-btn qw-send-icon" title="Enviar" type="submit" <%= (selectedConversation.conversationType==='group' || selectedConversation.phoneResolved) && whatsapp.status === 'conectado' ? '' : 'disabled' %>>➤</button>
              </div></form>
              <input id="inboxAttachmentInput" type="file" hidden onchange="prepareInboxAttachment(event)">
              <div id="inboxAttachmentPreview" class="qw-attach-preview"><span id="inboxAttachmentName" class="qw-attach-preview-name"></span><button class="qw-attach-cancel" type="button" title="Cancelar anexo" onclick="cancelInboxAttachment()">✕</button></div>

              <div id="inboxScheduleModal" class="qw-schedule-modal" aria-hidden="true">
                <div class="qw-schedule-backdrop" onclick="closeInboxScheduleModal()"></div>
                <section class="qw-schedule-card" role="dialog" aria-modal="true" aria-labelledby="inboxScheduleTitle">
                  <div class="qw-schedule-head"><div><strong id="inboxScheduleTitle">🕘 Agendar mensagem</strong><small><%= selectedConversation.name || selectedConversation.phone %></small></div><button type="button" onclick="closeInboxScheduleModal()" aria-label="Fechar">×</button></div>
                  <div class="qw-schedule-note">O envio acontece automaticamente no horário escolhido. Se o ERP ou o WhatsApp estiver offline naquele momento, a mensagem fica pendente e será tentada quando a conexão voltar.</div>
                  <div class="qw-schedule-grid">
                    <label><span>Dia e horário</span><input id="inboxScheduleAt" class="qw-input" type="datetime-local"></label>
                    <label class="qw-schedule-full"><span>Mensagem / legenda</span><textarea id="inboxScheduleText" class="qw-textarea" maxlength="4000" rows="5" placeholder="Digite a mensagem que será enviada"></textarea></label>
                    <label class="qw-schedule-full"><span>Arquivo opcional</span><input id="inboxScheduleMedia" class="qw-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif,audio/mpeg,audio/ogg,audio/mp4,audio/webm,audio/wav,video/mp4,video/webm,video/quicktime" onchange="updateInboxScheduleFileName()"><small id="inboxScheduleFileName">Imagem, áudio ou vídeo · até 40 MB</small></label>
                    <div class="qw-schedule-full qw-schedule-recorder"><div><span>🎙️ Gravar áudio agora</span><small>Grave agora e escolha o horário para o envio depois.</small></div><div class="qw-schedule-recorder-actions"><button id="inboxScheduleRecordBtn" type="button" class="qw-btn" onclick="startInboxScheduleRecording()">● Gravar</button><button id="inboxScheduleStopBtn" type="button" class="qw-btn" onclick="stopInboxScheduleRecording()" disabled>■ Parar</button><button id="inboxScheduleClearAudioBtn" type="button" class="qw-btn" onclick="clearInboxScheduleRecording()" hidden>✕ Remover áudio</button></div><div id="inboxScheduleRecordingStatus" class="qw-schedule-recording-status">Nenhum áudio gravado.</div><audio id="inboxScheduleAudioPreview" controls hidden></audio></div>
                  </div>
                  <div class="qw-schedule-actions"><button type="button" class="qw-btn" onclick="closeInboxScheduleModal()">Cancelar</button><button id="inboxScheduleSaveBtn" type="button" class="qw-btn primary" onclick="saveInboxScheduledMessage()">🕘 Agendar</button></div>
                  <div class="qw-schedule-list-head"><div><strong>Agendamentos desta conversa</strong><small>Exclua um item individualmente ou limpe todos os agendamentos desta conversa.</small></div><div class="qw-schedule-list-actions"><button class="danger" type="button" onclick="clearInboxScheduledMessages('all')">Limpar agendamentos</button></div></div>
                  <div id="inboxScheduleList" class="qw-schedule-list">
                    <% if(!(scheduledMessages||[]).length){ %><div class="qw-schedule-empty">Nenhum agendamento nesta conversa.</div><% } %>
                    <% (scheduledMessages||[]).forEach(function(item){ var statusLabel=item.status==='enviado'?'Enviado':item.status==='cancelado'?'Cancelado':item.status==='erro'?'Erro':'Pendente'; %>
                      <div class="qw-schedule-row status-<%= item.status %>" data-schedule-id="<%= item.id %>">
                        <div><strong><%= item.type==='video'?'🎬 ':item.type==='image'?'🖼️ ':item.type==='audio'?'🎙️ ':'💬 ' %><%= item.text ? String(item.text).slice(0,90) : (item.fileName||(item.type==='audio'?'Áudio agendado':item.type==='video'?'Vídeo agendado':'Imagem agendada')) %></strong><small><%= formatDateTime(item.scheduledAt) %> · <%= statusLabel %><%= item.fileName ? ' · '+item.fileName : '' %></small><% if(item.lastError){ %><em><%= item.lastError %></em><% } %></div>
                        <div class="qw-schedule-row-actions"><% if(item.status==='pendente'){ %><button type="button" onclick="cancelInboxScheduledMessage('<%= item.id %>')">Cancelar</button><% } else if(item.status==='erro'){ %><button type="button" onclick="retryInboxScheduledMessage('<%= item.id %>')">Tentar agora</button><% } %><button class="delete" type="button" onclick="deleteInboxScheduledMessage('<%= item.id %>')">Excluir</button></div>
                      </div>
                    <% }) %>
                  </div>
                </section>
              </div>
            </div>
          </div>

          <% if(selectedConversation.conversationType!=='group'){ var crm=customerContext||{}; var customer=crm.customer||null; var customerLabels=(customer&&customer.labels)||[]; %>
          <div id="contactDrawerBackdrop" class="qw-contact-drawer-backdrop" onclick="closeContactDrawer()"></div>
          <aside id="contactDrawer" class="qw-contact-drawer" aria-label="Ficha do cliente">
            <div class="qw-drawer-head"><div><h2>👤 Ficha do cliente</h2><div class="qw-muted" style="font-size:12px">Central do Cliente · CRM/ERP</div></div><button class="qw-drawer-close" type="button" title="Recolher ficha" onclick="closeContactDrawer()">✕</button></div>
            <% if(customer){ %>
              <div class="qw-crm-id">ID único: <%= customer.id %></div>
              <form method="post" action="/automacao-whatsapp/inbox/cliente/atualizar">
                <input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="customerId" value="<%= customer.id %>">
                <div class="qw-crm-section"><h3>Dados principais</h3><div class="qw-crm-grid">
                  <div class="qw-field wide"><label>Nome</label><input class="qw-input" name="name" value="<%= customer.name||selectedConversation.name||'' %>" required></div>
                  <div class="qw-field wide"><label>Telefone / WhatsApp</label><input class="qw-input" value="<%= selectedConversation.phoneResolved ? ('+'+selectedConversation.phone) : 'Número pendente' %>" disabled></div>
                  <div class="qw-field wide"><label>E-mail</label><input class="qw-input" type="email" name="email" value="<%= customer.email||'' %>" placeholder="cliente@email.com"></div>
                  <div class="qw-field"><label>CPF</label><input class="qw-input" name="cpf" value="<%= (customer.document&&customer.document.cpf)||'' %>"></div>
                  <div class="qw-field"><label>CNPJ</label><input class="qw-input" name="cnpj" value="<%= (customer.document&&customer.document.cnpj)||'' %>"></div>
                </div></div>
                <div class="qw-crm-section"><h3>Comercial</h3><div class="qw-crm-grid">
                  <div class="qw-field"><label>Etapa</label><select class="qw-select" name="commercialStage"><% Object.entries(statusLabels).forEach(function(entry){ %><option value="<%= entry[0] %>" <%= (customer.commercialStage||selectedConversation.commercialStatus)===entry[0]?'selected':'' %>><%= entry[1] %></option><% }) %></select></div>
                  <div class="qw-field"><label>Origem</label><select class="qw-select" name="origin"><% Object.entries(originLabels).forEach(function(entry){ %><option value="<%= entry[0] %>" <%= selectedConversation.origin===entry[0]?'selected':'' %>><%= entry[1] %></option><% }) %></select></div>
                  <div class="qw-field wide"><label>Produto de interesse</label><input class="qw-input" name="interestProduct" value="<%= customer.interestProduct||selectedConversation.interestProduct||'' %>" placeholder="Ex: Redmi Note 15"></div>
                  <div class="qw-field"><label>Tipo de pendência</label><select class="qw-select" name="pendingType"><% [['none','Nenhuma'],['send_quote','Enviar orçamento'],['send_photo','Enviar foto/vídeo'],['check_stock','Verificar estoque'],['customer_reply','Aguardar cliente'],['supplier_reply','Aguardar fornecedor'],['payment','Pagamento'],['technical','Questão técnica'],['other','Outra']].forEach(function(item){ %><option value="<%= item[0] %>" <%= (selectedConversation.pendingType||'none')===item[0]?'selected':'' %>><%= item[1] %></option><% }) %></select></div>
                  <div class="qw-field"><label>Prazo da próxima ação</label><input class="qw-input" type="datetime-local" name="nextActionDueAt" value="<%= formatDateTimeLocalInput(selectedConversation.nextActionDueAt) %>"></div>
                  <div class="qw-field wide"><label>Detalhe da pendência</label><input class="qw-input" name="pendingNote" value="<%= selectedConversation.pendingNote||'' %>" placeholder="Ex: cliente pediu foto da cor preta"></div>
                  <div class="qw-field wide"><label>Próxima ação do atendimento</label><input class="qw-input" name="nextAction" value="<%= selectedConversation.nextAction||'' %>" placeholder="Ex: enviar orçamento atualizado e confirmar troca"></div>
                  <div class="qw-field wide"><label>Responsável futuro</label><input class="qw-input" name="assignedTo" value="<%= customer.assignedTo||'' %>" placeholder="Opcional — preparado para multiusuário"></div>
                  <div class="qw-field wide"><label class="qw-check"><input type="checkbox" name="saveContact" value="1" <%= selectedConversation.contactSaved?'checked':'' %> <%= selectedConversation.phoneResolved?'':'disabled' %>> Salvar na agenda do Painel</label></div>
                </div></div>
                <div class="qw-crm-section"><h3>Etiquetas</h3><div class="qw-crm-labels"><% (crm.labels||[]).forEach(function(label){ %><label class="qw-crm-label"><input type="checkbox" name="labels" value="<%= label.id %>" <%= customerLabels.includes(label.id)?'checked':'' %>><span class="qw-label-dot" style="background:<%= label.color %>"></span><%= label.name %></label><% }) %></div></div>
                <div class="qw-crm-save"><button class="qw-btn primary" type="submit">💾 Salvar ficha do cliente</button></div>
              </form>
              <div class="qw-crm-section"><h3>Nova etiqueta</h3><form class="qw-crm-new-label" method="post" action="/automacao-whatsapp/inbox/cliente/etiqueta"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><div class="qw-field"><label>Nome</label><input class="qw-input" name="name" required placeholder="Ex: Retornar depois"></div><input class="qw-color-input" type="color" name="color" value="#64748b"><button class="qw-mini-btn" type="submit">Criar</button></form></div>
              <div class="qw-crm-section"><h3>Notas internas</h3><form method="post" action="/automacao-whatsapp/inbox/cliente/nota"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="customerId" value="<%= customer.id %>"><textarea class="qw-textarea" name="text" maxlength="2000" required placeholder="Esta nota não será enviada ao WhatsApp."></textarea><button class="qw-btn" type="submit" style="width:100%;margin-top:8px">＋ Adicionar nota</button></form><% if((crm.notes||[]).length){ crm.notes.forEach(function(note){ %><div class="qw-crm-note"><%= note.text %><small><%= formatDateTime(note.createdAt) %></small></div><% }) } else { %><div class="qw-crm-empty" style="margin-top:9px">Nenhuma nota interna registrada.</div><% } %></div>
              <div class="qw-crm-section"><h3>🔔 Lembretes</h3>
                <form class="qw-task-form" method="post" action="/automacao-whatsapp/inbox/cliente/lembrete"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="customerId" value="<%= customer.id %>"><input class="qw-input" name="title" maxlength="180" required placeholder="Ex: Retornar orçamento"><textarea class="qw-textarea" name="description" maxlength="1000" placeholder="Descrição opcional" style="min-height:62px"></textarea><div class="qw-task-form-row"><input class="qw-input" type="datetime-local" name="dueAt" required><select class="qw-select" name="priority"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option></select></div><button class="qw-btn" type="submit" style="width:100%">＋ Criar lembrete</button></form>
                <div class="qw-task-list" style="margin-top:10px"><% var customerTasks=crm.tasks||[]; var openTasks=customerTasks.filter(function(t){return t.status!=='completed'}); var doneTasks=customerTasks.filter(function(t){return t.status==='completed'}); if(!openTasks.length){ %><div class="qw-crm-empty">Nenhum lembrete em aberto.</div><% } %><% openTasks.forEach(function(task){ var bucket=(taskOverview.byConversation[selectedConversation.id]||[]).find(function(t){return t.id===task.id}); %><div class="qw-task-item <%= task.priority %>"><div class="qw-task-title"><%= task.title %></div><div class="qw-task-meta"><%= formatDateTime(task.dueAt) %><% if(task.description){ %> · <%= task.description %><% } %></div><span class="qw-task-badge <%= bucket&&bucket.bucket||'' %>"><%= bucket&&bucket.bucket==='overdue'?'Atrasado':bucket&&bucket.bucket==='today'?'Hoje':'Próximo' %></span><div class="qw-task-actions"><form method="post" action="/automacao-whatsapp/inbox/cliente/lembrete/concluir"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="taskId" value="<%= task.id %>"><button class="qw-mini-btn" type="submit">✓ Concluir</button></form><form method="post" action="/automacao-whatsapp/inbox/cliente/lembrete/excluir" onsubmit="return confirm('Excluir este lembrete?')"><input type="hidden" name="conversationId" value="<%= selectedConversation.id %>"><input type="hidden" name="taskId" value="<%= task.id %>"><button class="qw-mini-btn danger" type="submit">Excluir</button></form></div></div><% }) %><% if(doneTasks.length){ %><details style="margin-top:9px"><summary style="font-size:11px;font-weight:900;cursor:pointer">Concluídos (<%= doneTasks.length %>)</summary><% doneTasks.slice(0,10).forEach(function(task){ %><div class="qw-task-item completed"><div class="qw-task-title">✓ <%= task.title %></div><div class="qw-task-meta"><%= formatDateTime(task.completedAt||task.dueAt) %></div></div><% }) %></details><% } %></div>
              </div>
              <div class="qw-crm-section"><h3>Integrações futuras</h3><div class="qw-crm-empty">Compras, financeiro, garantias, assistência e histórico completo usarão este mesmo ID de cliente.</div></div>
            <% } else { %><div class="qw-empty">Não foi possível criar a ficha central deste contato.</div><% } %>
          </aside>
          <% } %>
          <div id="conversationMenu" class="qw-conversation-menu"><button type="button" onclick="markInboxUnread('<%= selectedConversation.id %>')">● Marcar como não lida</button><% if(selectedConversation.conversationType!=='group'){ %><button type="button" onclick="openContactDrawer();closeConversationMenu()">👤 Dados do contato</button><% } %></div>
        <% } else { %>
          <div class="qw-card qw-inbox-placeholder"><div><div style="font-size:58px">💬</div><h2>Selecione uma conversa</h2><p class="qw-muted">Abra um contato para visualizar e responder.</p></div></div>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'conexao') { %>
    <div class="qw-connection-grid">
      <div class="qw-card">
        <h2>📱 Sessão WhatsApp</h2>
        <div class="qw-live-status"><span id="waDot" class="qw-status-dot"></span><span id="waStatusText"><%= whatsapp.message %></span></div>
        <p id="waIdentity" class="qw-muted"><% if (whatsapp.connectedNumber) { %>Número conectado: +<%= whatsapp.connectedNumber %><% } else { %>Nenhum número conectado no momento.<% } %></p>
        <div id="waQrBox" class="qw-qr-box">
          <% if (whatsapp.qrDataUrl) { %><div><img src="<%= whatsapp.qrDataUrl %>" alt="QR Code WhatsApp"><p>WhatsApp → Aparelhos conectados → Conectar aparelho</p></div><% } else { %><div><div style="font-size:54px">📲</div><strong>Use “Conectar” para iniciar.</strong><p class="qw-muted">Quando já existir uma sessão salva, ela será restaurada sem novo QR Code.</p></div><% } %>
        </div>
        <div class="qw-actions" style="justify-content:flex-start;margin-top:12px">
          <button class="qw-btn success" type="button" id="waConnectBtn" onclick="connectWhatsApp()">Conectar</button>
          <button class="qw-btn" type="button" onclick="sessionAction('/automacao-whatsapp/whatsapp/reiniciar','Reiniciar a conexão agora?')">🔄 Reiniciar</button>
          <button class="qw-btn danger" type="button" onclick="disconnectWhatsApp()">🔓 Desconectar</button>
          <button class="qw-btn" type="button" onclick="sessionAction('/automacao-whatsapp/whatsapp/novo-qr','Isso removerá a sessão salva e exigirá novo QR Code. Continuar?')">📱 Novo QR</button>
          <button class="qw-btn dark" type="button" onclick="runSessionDiagnostic()">🩺 Diagnóstico</button>
        </div>
        <div id="waDiagnostic" class="qw-info" style="margin-top:12px;display:none"></div>
        <div class="qw-info" style="margin-top:12px">A sessão é salva localmente em <code>content/automacao_whatsapp/session</code>. “Desconectar” preserva a sessão; “Novo QR” remove a autenticação local.</div>
        <div class="qw-warning" style="margin-top:12px"><strong>⚠ Canal atual via WhatsApp Web</strong><br><span style="display:block;margin-top:5px">Esta conexão usa <code>whatsapp-web.js</code> e uma sessão local do WhatsApp Web. Ela não é a API Oficial da Meta. Os limites, intervalos e bloqueio automático de pedidos como “parar” reduzem disparos acidentais, mas não transformam esta conexão em um canal oficial. Para o menor risco operacional, migre o Inbox e as automações para a WhatsApp Business Platform/API Oficial.</span></div>
        <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--qw-line)">
          <div class="qw-library-heading"><h2 style="margin:0">🧹 Agendamentos</h2><span class="qw-info-tip" tabindex="0" aria-label="Limpeza global de agendamentos">i<span class="qw-info-tip-text">Remove os agendamentos de todas as conversas, inclusive pendentes. Use somente quando quiser zerar a fila e o histórico.</span></span></div>
          <p class="qw-muted" style="margin:6px 0 10px">Limpeza geral dos agendamentos do Inbox.</p>
          <div style="display:flex;gap:7px;flex-wrap:wrap">
            <button class="qw-btn danger" type="button" onclick="clearAllInboxScheduledMessages()">Excluir todos os agendamentos</button>
            <a class="qw-btn" href="/automacao-whatsapp?tab=configuracoes&section=armazenamento">🧹 Limpeza e espaço do Inbox</a>
          </div>
        </div>
      </div>

      <div class="qw-card">
        <h2>🧪 Envio manual seguro</h2>
        <p class="sub">Somente para o número de teste informado abaixo. Não há gatilhos ou disparos automáticos nesta versão.</p>
        <form id="manualSendForm" class="qw-form" onsubmit="return sendManual(event)">
          <div class="qw-field"><label>Número de teste com DDD</label><input id="testNumber" class="qw-input" name="numero" inputmode="numeric" value="<%= config.numeroTeste || '' %>" placeholder="Ex: 5599999999999" required></div>
          <div class="qw-field"><label>Texto ou legenda</label><textarea class="qw-textarea" name="texto" placeholder="Mensagem de teste"></textarea></div>
          <div class="qw-field"><label>Imagem, áudio, vídeo ou arquivo (opcional)</label><input class="qw-input" type="file" name="arquivo" accept="image/*,audio/*,video/mp4,video/webm,video/quicktime,.pdf,.txt,.docx"></div>
          <button class="qw-btn primary" type="submit">Enviar manualmente</button>
        </form>
        <hr style="border:0;border-top:1px solid var(--qw-line);margin:18px 0">
        <h2>▶ Executar bloco completo</h2>
        <form id="blockSendForm" class="qw-form" onsubmit="return sendBlock(event)">
          <div class="qw-field"><label>Bloco salvo</label><select class="qw-select" name="blocoId" required><option value="">Selecione...</option><% blocos.filter(function(b){return b.ativo;}).forEach(function(b){ %><option value="<%= b.id %>"><%= b.nome %> · <%= (b.etapas || []).length %> etapa(s)</option><% }) %></select></div>
          <button class="qw-btn success" type="submit">Executar bloco no número de teste</button>
        </form>
        <div id="waResult" class="qw-result" style="margin-top:12px"></div>
        <div class="qw-warning" style="margin-top:12px">Durante a execução de um bloco, não feche o painel. Pausas, “digitando” e “gravando áudio” são respeitados.</div>
      </div>
    </div>
  <% } %>

  <% if (tab === 'blocos') { const edit = blocoEdit || {}; const categorias = Array.from(new Set(blocos.map(b => b.categoria || 'Geral'))).sort(); %>
    <div class="qw-grid">
      <div class="qw-card qw-span-5 qw-editor-card">
        <div class="qw-library-heading"><h2 style="margin:0"><%= blocoEdit ? '✏️ Editar bloco' : '➕ Novo bloco' %></h2><span class="qw-info-tip" tabindex="0" aria-label="Informações sobre o editor do bloco">i<span class="qw-info-tip-text">Monte a sequência visual do bloco e teste cada etapa antes de salvar.</span></span></div>
        <div id="unsavedAlert" class="qw-unsaved">⚠️ Alterações não salvas</div>
        <form id="blockEditorForm" class="qw-form" method="post" action="/automacao-whatsapp/blocos/salvar" onsubmit="return prepareSteps()">
          <input type="hidden" name="id" value="<%= edit.id || '' %>">
          <input type="hidden" name="etapasJson" id="etapasJson">
          <div class="qw-field"><label>Nome do bloco</label><input class="qw-input" name="nome" value="<%= edit.nome || '' %>" placeholder="Ex: Formas de pagamento" required></div>
          <details class="qw-optional-details" <%= edit.descricao ? 'open' : '' %>>
            <summary>Descrição <span style="font-weight:500">— uso interno, opcional</span></summary>
            <div class="qw-optional-body"><textarea class="qw-textarea" name="descricao" placeholder="Adicione uma observação interna se precisar"><%= edit.descricao || '' %></textarea></div>
          </details>
          <div class="qw-block-meta-row">
            <div class="qw-field"><label>Categoria/pasta</label><input class="qw-input" name="categoria" list="qwCategorias" value="<%= edit.categoria || 'Geral' %>" placeholder="Ex: Vendas"><datalist id="qwCategorias"><% categorias.forEach(function(c){ %><option value="<%= c %>"><% }) %></datalist></div>
            <div class="qw-field"><label>Gatilho/atalho</label><input class="qw-input" name="gatilho" value="<%= edit.gatilho || '' %>" placeholder="Ex: pagamento"></div>
          </div>
          <div class="qw-row">
            <label class="qw-check"><input type="checkbox" name="ativo" <%= edit.ativo !== false ? 'checked' : '' %>> Bloco ativo</label>
            <label class="qw-check"><input type="checkbox" name="favorito" <%= edit.favorito ? 'checked' : '' %>> ⭐ Favorito</label>
          </div>
          <div class="qw-library-heading" style="margin-top:8px"><h2 style="margin:0">🧩 Fluxo do bloco</h2><span class="qw-info-tip" tabindex="0" aria-label="Informações sobre o mapa do fluxo">i<span class="qw-info-tip-text">Cada etapa segue em sequência. Em Opções, cada escolha cria uma ramificação própria e pode levar para texto, imagem, áudio, vídeo, arquivo, outro bloco ou encerramento. O mapa visual fica oculto para não ocupar espaço no editor.</span></span></div>
          <div class="qw-flow-start">🚀 Início do bloco</div>
          <div class="qw-addbar"><button class="qw-mini-btn" type="button" onclick="addStep('texto')">+ Texto</button><button class="qw-mini-btn" type="button" onclick="addStep('pausa')">+ Pausa</button><button class="qw-mini-btn" type="button" onclick="addStep('audio')">+ Áudio</button><button class="qw-mini-btn" type="button" onclick="addStep('imagem')">+ Imagem</button><button class="qw-mini-btn" type="button" onclick="addStep('video')">+ Vídeo</button><button class="qw-mini-btn" type="button" onclick="addStep('arquivo')">+ Arquivo</button><button class="qw-mini-btn" type="button" onclick="addStep('opcoes')">+ Opções</button><span class="qw-info-tip" tabindex="0" aria-label="Como adicionar etapas">i<span class="qw-info-tip-text">Use os botões Texto, Pausa, Áudio, Imagem, Vídeo, Arquivo ou Opções para montar o bloco.</span></span></div>
          <div id="builder" class="qw-builder"></div>
          <div class="qw-actions" style="justify-content:flex-start"><button class="qw-btn primary" type="submit">Salvar bloco</button><button class="qw-btn success" type="button" onclick="simulateCurrent()">▶ Simular fluxo</button></div>
        </form>
      </div>
      <div class="qw-card qw-span-7 qw-simulator-card"><div class="qw-library-heading"><h2 style="margin:0">🧪 Prévia do bloco</h2><span class="qw-info-tip" tabindex="0" aria-label="Informações sobre o simulador">i<span class="qw-info-tip-text">Simule o bloco inteiro ou use “Testar etapa” dentro de cada card.</span></span></div><div class="qw-row" style="margin:10px 0 12px"><select class="qw-select" id="embeddedSimulateSelect"><option value="">Bloco atual / em edição</option><% blocos.forEach(function(b){ %><option value="<%= b.id %>"><%= b.nome %></option><% }) %></select><button class="qw-btn success" type="button" onclick="simulateEmbeddedSelected()">Simular bloco</button></div><div class="qw-phone"><div class="qw-phone-head"><div class="qw-phone-avatar">Q</div><div><div class="qw-phone-title">Quality Celulares</div><div class="qw-phone-status" id="quickStatus">simulador pronto</div></div></div><div id="preview" class="qw-chat"><div class="qw-wait">Selecione um bloco salvo ou simule o bloco atual</div></div></div><div class="qw-sim-controls"><button class="qw-btn success" type="button" onclick="simulateCurrent()">▶ Simular atual</button><button class="qw-btn danger" type="button" onclick="stopSimulation()">Parar</button><button class="qw-btn" type="button" onclick="clearSimulation('preview','quickStatus')">Limpar</button></div></div>
      <div class="qw-card qw-span-12">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap">
          <div class="qw-library-heading"><h2>📚 Biblioteca de blocos</h2><span class="qw-info-tip" tabindex="0" aria-label="Informações da biblioteca de blocos">i<span class="qw-info-tip-text">Pesquise, filtre, favorite, duplique e abra rapidamente um bloco.</span></span></div>
          <a class="qw-btn primary" href="/automacao-whatsapp?tab=blocos">➕ Criar novo bloco</a>
        </div>
        <div class="qw-library-tools"><input id="blockSearch" class="qw-input" placeholder="🔎 Buscar por nome, descrição ou gatilho" oninput="filterBlockCards()"><select id="blockCategory" class="qw-select" onchange="filterBlockCards()"><option value="">Todas as categorias</option><% categorias.forEach(function(c){ %><option value="<%= c.toLowerCase() %>"><%= c %></option><% }) %></select><label class="qw-check"><input id="onlyFavorites" type="checkbox" onchange="filterBlockCards()"> Só favoritos</label></div>
        <% if (!blocos.length) { %><div class="qw-empty">Nenhum bloco cadastrado.</div><% } else { %><div class="qw-block-grid" id="blockGrid"><% blocos.slice().sort((a,b)=>(Number(b.favorito)-Number(a.favorito)) || String(a.nome).localeCompare(String(b.nome))).forEach(function(b){ const searchText = [b.nome,b.descricao,b.gatilho,b.categoria].join(' ').toLowerCase(); %><div class="qw-block-card" data-search="<%= searchText %>" data-category="<%= String(b.categoria || 'Geral').toLowerCase() %>" data-favorite="<%= b.favorito ? '1':'0' %>"><div class="qw-block-top"><div><div class="qw-block-name"><%= b.nome %></div><div class="qw-muted" style="font-size:12px;margin-top:3px"><%= b.gatilho ? '/'+b.gatilho : 'Sem atalho' %></div></div><form method="post" action="/automacao-whatsapp/blocos/favorito/<%= b.id %>"><button class="qw-star" title="Favoritar" type="submit"><%= b.favorito ? '⭐':'☆' %></button></form></div><div class="qw-block-meta"><span class="qw-tag"><%= b.categoria || 'Geral' %></span><span class="qw-tag"><%= (b.etapas || []).length %> etapas</span><span class="qw-tag <%= b.ativo ? 'active':'inactive' %>"><%= b.ativo ? 'Ativo':'Inativo' %></span></div><div class="qw-block-desc"><%= b.descricao || 'Sem descrição interna.' %></div><div class="qw-block-actions"><a class="qw-mini-btn blue" style="text-decoration:none" href="/automacao-whatsapp?tab=blocos&edit=<%= b.id %>">✏️ Editar</a><form method="post" action="/automacao-whatsapp/blocos/duplicar/<%= b.id %>"><button class="qw-mini-btn" type="submit">📄 Duplicar</button></form><button class="qw-mini-btn gold" type="button" onclick="simulateLibraryBlock('<%= b.id %>')">▶ Prévia</button><form method="post" action="/automacao-whatsapp/blocos/excluir/<%= b.id %>" onsubmit="return confirm('Excluir este bloco?')"><button class="qw-mini-btn danger" type="submit">Excluir</button></form></div></div><% }) %></div><% } %>
      </div>
    </div>
  <% } %>

  <% if (tab === 'midias') {
    const midiasOrfas = midias.filter(function(m){ return !(m.usos || []).length; });
    const gruposMidia = blocos
      .map(function(b){
        return {
          id: b.id,
          nome: b.nome,
          midias: midias.filter(function(m){ return (m.usos || []).some(function(u){ return u.id === b.id; }); })
        };
      })
      .filter(function(g){ return g.midias.length; });
  %>
    <div class="qw-grid">
      <div class="qw-card qw-span-12">
        <div class="qw-library-heading"><h2 style="margin:0">🗂️ Biblioteca oficial de mídias</h2><span class="qw-info-tip" tabindex="0" aria-label="Informações da biblioteca oficial de mídias">i<span class="qw-info-tip-text">Organizada por bloco. Uma mesma mídia pode aparecer em mais de um grupo, mas o arquivo físico continua sendo único. Esta biblioteca contém somente materiais oficiais dos blocos.</span></span></div>

        <div class="qw-media-tools">
          <input id="mediaSearch" class="qw-input" placeholder="🔎 Buscar mídia ou bloco" oninput="filterMediaCards()">
          <select id="mediaType" class="qw-select" onchange="filterMediaCards()">
            <option value="">Todos os tipos</option>
            <option value="imagem">Imagens</option>
            <option value="audio">Áudios</option>
            <option value="video">Vídeos</option>
            <option value="arquivo">Arquivos</option>
          </select>
        </div>

        <% if (!midias.length) { %>
          <div class="qw-empty">Nenhuma mídia catalogada ainda.</div>
        <% } else { %>
          <div id="mediaFilterEmpty" class="qw-media-empty-filter">Nenhuma mídia corresponde à pesquisa ou ao filtro selecionado.</div>

          <div class="qw-media-groups" id="mediaGroups">
            <% gruposMidia.forEach(function(grupo, groupIndex){ %>
              <section class="qw-media-group <%= groupIndex === 0 ? 'open' : '' %>" data-group-name="<%= String(grupo.nome || '').toLowerCase() %>">
                <button class="qw-media-group-head" type="button" onclick="toggleMediaGroup(this)">
                  <span class="qw-media-group-title"><span class="qw-media-group-arrow">›</span> 📦 <%= grupo.nome %></span>
                  <span class="qw-media-group-meta">
                    <span class="qw-tag"><%= grupo.midias.length %> mídia(s)</span>
                    <span class="qw-tag"><%= grupo.midias.filter(m=>m.tipo==='imagem').length %> imagem(ns)</span>
                    <span class="qw-tag"><%= grupo.midias.filter(m=>m.tipo==='audio').length %> áudio(s)</span>
                    <span class="qw-tag"><%= grupo.midias.filter(m=>m.tipo==='video').length %> vídeo(s)</span>
                  </span>
                </button>
                <div class="qw-media-group-body">
                  <div class="qw-media-grid">
                    <% grupo.midias.forEach(function(m){ const usos = m.usos || []; %>
                      <div class="qw-media-card"
                           data-media-id="<%= m.id %>"
                           data-media-search="<%= [m.nome,m.tipo,m.mime,grupo.nome].join(' ').toLowerCase() %>"
                           data-media-type="<%= m.tipo %>">
                        <div class="qw-media-thumb">
                          <% if (m.tipo === 'imagem') { %><img src="<%= m.caminho %>" alt="<%= m.nome %>">
                          <% } else if (m.tipo === 'video') { %><video controls preload="metadata" src="<%= m.caminho %>"></video>
                          <% } else if (m.tipo === 'audio') { %><audio controls preload="metadata" src="<%= m.caminho %>"></audio>
                          <% } else { %><div style="font-size:44px">📄</div><% } %>
                        </div>
                        <div class="qw-media-name"><%= m.nome %></div>
                        <div class="qw-block-meta">
                          <span class="qw-tag"><%= m.tipo %></span>
                          <span class="qw-tag"><%= Math.max(1, Math.round((m.tamanho || 0)/1024)) %> KB</span>
                          <span class="qw-tag active">Em uso por <%= usos.length %> bloco(s)</span>
                        </div>
                        <div class="qw-media-usage">Vinculada a: <%= usos.map(u=>u.nome).join(', ') %></div>
                        <div class="qw-block-actions">
                          <a class="qw-mini-btn blue qw-media-link-btn" href="<%= m.caminho %>" target="_blank" rel="noopener">👁 Abrir</a>
                          <a class="qw-mini-btn qw-media-link-btn" href="/automacao-whatsapp/midias/download/<%= m.id %>">⬇ Baixar</a>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </section>
            <% }) %>

            <% if (midiasOrfas.length) { %>
              <section class="qw-media-group" data-group-name="sem bloco vinculado mídias órfãs">
                <button class="qw-media-group-head" type="button" onclick="toggleMediaGroup(this)">
                  <span class="qw-media-group-title"><span class="qw-media-group-arrow">›</span> 🧹 Sem bloco vinculado</span>
                  <span class="qw-media-group-meta"><span class="qw-tag inactive"><%= midiasOrfas.length %> mídia(s) órfã(s)</span></span>
                </button>
                <div class="qw-media-group-body">
                  <div class="qw-media-grid">
                    <% midiasOrfas.forEach(function(m){ %>
                      <div class="qw-media-card"
                           data-media-id="<%= m.id %>"
                           data-media-search="<%= [m.nome,m.tipo,m.mime,'sem bloco vinculado'].join(' ').toLowerCase() %>"
                           data-media-type="<%= m.tipo %>">
                        <div class="qw-media-thumb">
                          <% if (m.tipo === 'imagem') { %><img src="<%= m.caminho %>" alt="<%= m.nome %>">
                          <% } else if (m.tipo === 'video') { %><video controls preload="metadata" src="<%= m.caminho %>"></video>
                          <% } else if (m.tipo === 'audio') { %><audio controls preload="metadata" src="<%= m.caminho %>"></audio>
                          <% } else { %><div style="font-size:44px">📄</div><% } %>
                        </div>
                        <div class="qw-media-name"><%= m.nome %></div>
                        <div class="qw-block-meta">
                          <span class="qw-tag"><%= m.tipo %></span>
                          <span class="qw-tag"><%= Math.max(1, Math.round((m.tamanho || 0)/1024)) %> KB</span>
                          <span class="qw-tag inactive">Sem uso</span>
                        </div>
                        <div class="qw-media-usage">Esta mídia não está vinculada a nenhum bloco.</div>
                        <div class="qw-block-actions">
                          <a class="qw-mini-btn blue qw-media-link-btn" href="<%= m.caminho %>" target="_blank" rel="noopener">👁 Abrir</a>
                          <a class="qw-mini-btn qw-media-link-btn" href="/automacao-whatsapp/midias/download/<%= m.id %>">⬇ Baixar</a>
                          <form method="post" action="/automacao-whatsapp/midias/excluir/<%= m.id %>" onsubmit="return confirm('Excluir esta mídia sem uso?')">
                            <button class="qw-mini-btn danger" type="submit">Excluir</button>
                          </form>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </section>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (tab === 'aniversariantes') { %>
    <% const missedYesterday = birthdayDashboard.missedPreviousDay || { rows:[], total:0, pending:0, noPhone:0, date:'', dateLabel:'', previewMessage:'' }; %>
    <div class="qw-grid">
      <div class="qw-card qw-span-12">
        <div style="display:flex;justify-content:space-between;gap:18px;align-items:center;flex-wrap:wrap">
          <div>
            <div class="qw-library-heading"><h2>🎂 Automação de aniversariantes</h2><span class="qw-info-tip" tabindex="0" aria-label="Informações da automação de aniversariantes">i<span class="qw-info-tip-text">Agora o fluxo usa diretamente os clientes do Quality ERP e envia pelo WhatsApp conectado ao Inbox.</span></span></div>
            <p class="qw-muted" style="margin:8px 0 0">Horário automático: <strong><%= config.horarioAniversario || '08:00' %></strong> · WhatsApp: <strong><%= whatsapp.status === 'conectado' ? 'conectado' : 'desconectado' %></strong></p>
          </div>
          <div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap">
            <span class="qw-pill"><%= birthdayDashboard.total %> hoje</span>
            <span class="qw-pill green"><%= birthdayDashboard.sent %> enviado(s)</span>
            <span class="qw-pill"><%= birthdayDashboard.pending %> pendente(s)</span><% if(Number(birthdayDashboard.optedOut||0)>0){ %><span class="qw-pill"><%= birthdayDashboard.optedOut %> opt-out</span><% } %>
            <span class="qw-pill <%= config.aniversariantesAtivo ? 'green' : '' %>"><%= config.aniversariantesAtivo ? 'Automação ativa' : 'Automação desativada' %></span>
          </div>
        </div>
      </div>


      <div class="qw-card qw-span-7">
        <div class="qw-library-heading"><h2>⚙️ Mensagem e horário</h2><span class="qw-info-tip" tabindex="0" aria-label="Informações sobre mensagem e horário">i<span class="qw-info-tip-text">Você pode alterar a mensagem e o horário quando quiser, sem mexer no código.</span></span></div>
        <form class="qw-form" method="post" action="/automacao-whatsapp/aniversariantes/configuracoes">
          <label class="qw-check" style="margin-bottom:12px"><input type="checkbox" name="aniversariantesAtivo" <%= config.aniversariantesAtivo ? 'checked' : '' %>> Ativar envio automático de aniversariantes</label>
          <div class="qw-row">
            <div class="qw-field">
              <label>Horário do envio</label>
              <input class="qw-input" type="time" name="horarioAniversario" value="<%= config.horarioAniversario || '08:00' %>">
            </div>
            <div class="qw-field">
              <label>Intervalo entre aniversariantes (segundos)</label>
              <input class="qw-input" type="number" min="45" max="600" name="intervaloAniversarioSegundos" value="<%= config.intervaloAniversarioSegundos == null ? 45 : Math.max(45, Number(config.intervaloAniversarioSegundos)||45) %>">
            </div>
          </div>
          <div class="qw-field">
            <label>Mensagem padrão</label>
            <textarea id="birthdayMessageInput" class="qw-textarea" name="mensagemAniversario" rows="9" oninput="updateBirthdayPreview()"><%= config.mensagemAniversario || '' %></textarea>
            <small class="qw-muted">Variáveis disponíveis: <code>{primeiro_nome}</code>, <code>{nome}</code> e <code>{data_aniversario}</code>.</small>
          </div>
          <div class="qw-field" style="margin-top:14px;padding-top:14px;border-top:1px solid var(--qw-border,#2a2a2a)">
            <label>Mensagem para aniversário perdido (envio manual)</label>
            <textarea id="birthdayLateMessageInput" class="qw-textarea" name="mensagemAniversarioAtrasado" rows="8" oninput="updateBirthdayLatePreview()"><%= config.mensagemAniversarioAtrasado || '' %></textarea>
            <small class="qw-muted">Usada somente quando você enviar manualmente um aniversário do dia anterior. Nunca é disparada automaticamente.</small>
            <div id="birthdayLatePreview" class="qw-info" data-date-label="<%= missedYesterday.dateLabel || '' %>" style="white-space:pre-wrap;line-height:1.55;margin-top:8px"><%= missedYesterday.previewMessage || '' %></div>
          </div>
          <button class="qw-btn primary" type="submit">Salvar configurações</button>
        </form>
      </div>

      <div class="qw-card qw-span-5">
        <h2>🧪 Simulador</h2>
        <p class="sub">Faça a prévia sem enviar nada. Se quiser, também pode mandar um teste real apenas para o seu número.</p>
        <div class="qw-field">
          <label>Nome para a prévia</label>
          <input id="birthdayPreviewName" class="qw-input" value="João da Silva" oninput="updateBirthdayPreview()">
        </div>
        <div id="birthdayPreview" class="qw-info" style="white-space:pre-wrap;line-height:1.55;margin-top:10px"><%= birthdayDashboard.previewMessage %></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
          <button class="qw-btn" type="button" onclick="simulateBirthdayRun()">Simular rotina de hoje</button>
        </div>
        <div id="birthdaySimulationResult" style="margin-top:12px"></div>
        <hr style="border:0;border-top:1px solid var(--qw-border,#2a2a2a);margin:18px 0">
        <div class="qw-field">
          <label>Número para teste real</label>
          <input id="birthdayTestNumber" class="qw-input" inputmode="numeric" value="<%= config.numeroTeste || '' %>" placeholder="Ex: 5599999999999">
        </div>
        <button class="qw-btn" type="button" onclick="sendBirthdayTest()">Enviar teste para este número</button>
        <p class="qw-muted" style="margin-top:8px">O teste real não marca nenhum cliente como já enviado.</p>
      </div>

      <div class="qw-card qw-span-12">
        <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap">
          <div class="qw-library-heading"><h2>👥 Aniversariantes de hoje</h2><span class="qw-info-tip" tabindex="0" aria-label="Origem da lista de aniversariantes">i<span class="qw-info-tip-text">Lista consultada diretamente do cadastro de clientes do Quality ERP.</span></span></div>
          <button class="qw-btn primary" type="button" onclick="runBirthdaysNow()" <%= !config.aniversariantesAtivo ? 'disabled title="Ative a automação antes de executar"' : '' %>>Executar agora</button>
        </div>
        <% if (!birthdayDashboard.rows.length) { %>
          <div class="qw-empty">Nenhum aniversariante encontrado para hoje.</div>
        <% } else { %>
          <div class="qw-table-wrap"><table class="qw-table"><thead><tr><th>Cliente</th><th>Nascimento</th><th>WhatsApp</th><th>Status</th><th>Ação</th></tr></thead><tbody>
          <% birthdayDashboard.rows.forEach(function(row){ %>
            <tr>
              <td><strong><%= row.name %></strong><% if(row.error){ %><br><small class="qw-muted"><%= row.error %></small><% } %></td>
              <td><%= row.birthDate || '—' %></td>
              <td><%= row.phone ? ('+' + row.phone) : 'Sem número válido' %></td>
              <td>
                <% if(row.status === 'enviado'){ %><span class="qw-pill green">Enviado</span>
                <% } else if(row.status === 'erro'){ %><span class="qw-pill">Erro · tentará novamente</span>
                <% } else if(row.status === 'sem_telefone'){ %><span class="qw-pill">Sem telefone</span>
                <% } else if(row.status === 'opt_out'){ %><span class="qw-pill">Não enviar · opt-out</span>
                <% } else { %><span class="qw-pill">Pendente</span><% } %>
              </td>
              <td>
                <% if(row.status === 'erro'){ %>
                  <button class="qw-btn" type="button" onclick="resendBirthdayCustomer('<%= row.id %>')">Reenviar agora</button>
                <% } else if(row.status === 'sem_telefone'){ %>
                  <span class="qw-muted">Corrija o cadastro</span>
                <% } else if(row.status === 'opt_out'){ %>
                  <span class="qw-muted">Bloqueado por solicitação do cliente</span>
                <% } else { %>
                  <span class="qw-muted">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody></table></div>
        <% } %>
      </div>

      <% if (missedYesterday.total > 0) { %>
      <details class="qw-card qw-span-12" style="border-color:rgba(255,193,7,.45);background:rgba(255,193,7,.025);padding:12px 14px">
        <summary style="cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;list-style:none">
          <span><strong>⚠️ <%= missedYesterday.total %> aniversário(s) do dia anterior não enviado(s)</strong> <span class="qw-muted">· <%= missedYesterday.dateLabel %> · envio somente manual</span></span>
          <span class="qw-pill"><%= missedYesterday.total %> pendente(s)</span>
        </summary>
        <div style="margin-top:12px">
          <div class="qw-warning" style="padding:9px 11px;margin-bottom:10px">
            Estes clientes não entram na rotina automática de hoje. Confira/corrija o número e envie manualmente usando a mensagem de aniversário perdido configurada acima.
          </div>
          <div style="display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-bottom:10px">
            <button class="qw-btn" type="button" onclick="sendAllMissedBirthdays()">Enviar todos manualmente</button>
          </div>
          <div id="missedBirthdayResult" style="margin:0 0 10px"></div>
          <div class="qw-table-wrap"><table class="qw-table"><thead><tr><th>Cliente</th><th>Aniversário</th><th>WhatsApp</th><th>Status</th><th>Ação</th></tr></thead><tbody>
          <% missedYesterday.rows.forEach(function(row){ %>
            <tr>
              <td><strong><%= row.name %></strong><% if(row.error){ %><br><small class="qw-muted"><%= row.error %></small><% } %></td>
              <td><strong><%= row.birthdayDateLabel %></strong><br><small class="qw-muted">Dia anterior</small></td>
              <td><%= row.phone ? ('+' + row.phone) : 'Sem número válido' %></td>
              <td>
                <% if(row.status === 'erro'){ %><span class="qw-pill">Erro anterior</span>
                <% } else if(row.status === 'sem_telefone'){ %><span class="qw-pill">Sem telefone</span>
                <% } else { %><span class="qw-pill">Aguardando envio manual</span><% } %>
              </td>
              <td>
                <% if(row.status === 'sem_telefone'){ %>
                  <span class="qw-muted">Corrija o cadastro</span>
                <% } else { %>
                  <button class="qw-btn" type="button" onclick="sendMissedBirthdayCustomer('<%= row.id %>', '<%= row.birthdayDateLabel %>')">Enviar manualmente</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody></table></div>
        </div>
      </details>
      <% } %>
    </div>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'armazenamento') { %>
    <div class="qw-grid">
      <div class="qw-card qw-span-12">
        <div class="qw-library-heading"><div><h2 style="margin:0">🧹 Limpeza e armazenamento do Inbox</h2><p class="sub" style="margin-top:4px">Libere espaço ocupado por mídias locais sem apagar o histórico textual das conversas.</p></div><button class="qw-btn" type="button" onclick="loadInboxStorageReport(true)">↻ Atualizar análise</button></div>
        <div id="inboxStorageReport" class="qw-storage-report"><div class="qw-empty">Analisando armazenamento...</div></div>
        <div class="qw-warning" style="margin:12px 0">As opções abaixo removem cópias locais de mídias do Inbox. As conversas, nomes e mensagens de texto permanecem. Mídias antigas podem deixar de abrir localmente depois da limpeza.</div>
        <div class="qw-storage-actions">
          <form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirm('Remover mídias órfãs que não pertencem mais a nenhuma mensagem?')"><input type="hidden" name="action" value="orphans"><button class="qw-btn" type="submit">Limpar mídias órfãs</button></form>
          <form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirm('Remover as mídias locais de grupos? As mensagens dos grupos continuam no histórico.')"><input type="hidden" name="action" value="groups"><button class="qw-btn" type="submit">Limpar mídias de grupos</button></form>
          <form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirm('Remover mídias locais com mais de 90 dias?')"><input type="hidden" name="action" value="older90"><button class="qw-btn" type="submit">Mídias com +90 dias</button></form>
          <form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirm('Remover mídias locais com mais de 30 dias?')"><input type="hidden" name="action" value="older30"><button class="qw-btn" type="submit">Mídias com +30 dias</button></form>
          <form method="post" action="/automacao-whatsapp/armazenamento/limpar"><input type="hidden" name="action" value="empty_dirs"><button class="qw-btn" type="submit">Remover pastas vazias</button></form>
          <form method="post" action="/automacao-whatsapp/armazenamento/limpar" onsubmit="return confirm('ATENÇÃO: remover TODAS as mídias armazenadas localmente no Inbox? O histórico textual será preservado, mas fotos, áudios e vídeos salvos localmente poderão deixar de abrir.')"><input type="hidden" name="action" value="all_media"><button class="qw-btn danger" type="submit">Limpar todas as mídias locais</button></form>
        </div>
      </div>
    </div>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'logs') { %>
    <div class="qw-grid"><div class="qw-card qw-span-12"><h2>📜 Logs</h2><p class="sub">Conexão, QR Code, envios manuais, etapas de blocos, falhas e simulações.</p><% if (!logs.length) { %><div class="qw-empty">Sem logs ainda.</div><% } else { %><div class="qw-log-list"><% logs.slice(0,200).forEach(function(log){ %><div class="qw-log-row"><strong><%= log.message %></strong><br><small><%= new Date(log.at).toLocaleString('pt-BR') %> · <%= log.type %></small><% if (log.details && Object.keys(log.details).length) { %><details><summary>Detalhes</summary><pre><%= JSON.stringify(log.details, null, 2) %></pre></details><% } %></div><% }) %></div><% } %></div></div>
  <% } %>

  <% if (tab === 'configuracoes' && settingsSection === 'geral') { %>
    <div class="qw-grid"><div class="qw-card qw-span-8"><h2>⚙️ Configurações gerais</h2><p class="sub">Limites operacionais de envio. Horário e mensagem de aniversário ficam na aba Aniversariantes.</p><form class="qw-form" method="post" action="/automacao-whatsapp/configuracoes/salvar"><div class="qw-field"><label>Número de teste padrão</label><input class="qw-input" name="numeroTeste" inputmode="numeric" value="<%= config.numeroTeste || '' %>" placeholder="Ex: 5599999999999"></div><div class="qw-row"><div class="qw-field"><label>Limite diário de mensagens</label><input class="qw-input" type="number" min="1" max="1000" name="limiteDiario" value="<%= config.limiteDiario || 40 %>"></div></div><div class="qw-row"><div class="qw-field"><label>Intervalo operacional mínimo (segundos)</label><input class="qw-input" type="number" min="0" name="delayHumanoMin" value="<%= config.delayHumanoMin || 4 %>"></div><div class="qw-field"><label>Intervalo operacional máximo (segundos)</label><input class="qw-input" type="number" min="0" name="delayHumanoMax" value="<%= config.delayHumanoMax || 12 %>"></div></div><div class="qw-row"><div class="qw-field"><label>Digitando padrão (segundos)</label><input class="qw-input" type="number" min="0" name="digitandoPadrao" value="<%= config.digitandoPadrao || 2 %>"></div><div class="qw-field"><label>Gravando áudio padrão (segundos)</label><input class="qw-input" type="number" min="0" name="gravandoAudioPadrao" value="<%= config.gravandoAudioPadrao || 2 %>"></div></div><label class="qw-check"><input type="checkbox" name="envioRealAtivo" <%= config.envioRealAtivo ? 'checked' : '' %>> Permitir envio real quando a conexão WhatsApp existir</label><button class="qw-btn primary" type="submit">Salvar configurações</button></form></div><div class="qw-card qw-span-4"><h2>🛡️ Nota</h2><div class="qw-warning">Na v0.5.0, o envio real existe apenas em Configurações → Conexão e sempre exige ação manual. Esta chave continua reservada para fases futuras.</div></div></div>
  <% } %>
</div>

<script>
(function () {
  'use strict';

  function waResult(message, ok) {
    var box = document.getElementById('waResult');
    if (!box) return;
    box.textContent = message;
    box.className = 'qw-result show ' + (ok ? 'ok' : 'bad');
  }

  function renderWaStatus(state) {
    if (!state) return;
    var text = document.getElementById('waStatusText');
    var dot = document.getElementById('waDot');
    var qrBox = document.getElementById('waQrBox');
    var identity = document.getElementById('waIdentity');
    if (text) text.textContent = state.message || state.status;
    if (dot) dot.className = 'qw-status-dot ' + (state.status === 'conectado' ? 'connected' : (state.status === 'erro' ? 'error' : 'waiting'));
    if (identity) identity.textContent = state.connectedNumber ? 'Número conectado: +' + state.connectedNumber + (state.connectedName ? ' · ' + state.connectedName : '') : 'Nenhum número conectado no momento.';
    if (qrBox && state.qrDataUrl) qrBox.innerHTML = '<div><img src="' + state.qrDataUrl + '" alt="QR Code WhatsApp"><p>WhatsApp → Aparelhos conectados → Conectar aparelho</p></div>';
    if (qrBox && state.status === 'conectado') qrBox.innerHTML = '<div><div style="font-size:58px">✅</div><strong>Sessão pronta</strong><p class="qw-muted">Você já pode realizar os testes manuais.</p></div>';
  }

  async function waRequest(url, options) {
    var response = await fetch(url, options || {});
    var payload = await response.json();
    if (!response.ok || !payload.success) throw new Error(payload.message || 'Falha na operação.');
    return payload;
  }

  function birthdayFirstName(name){
    var parts=String(name||'').trim().split(/\s+/).filter(Boolean);
    return parts[0]||'Cliente';
  }
  function birthdayRender(template,name,dateLabel){
    var full=String(name||'').trim()||'Cliente';
    var first=birthdayFirstName(full);
    return String(template||'')
      .replace(/\{\{\s*primeiro_nome\s*\}\}|\{primeiro_nome\}/gi,first)
      .replace(/\{\{\s*nome\s*\}\}|\{nome\}/gi,full)
      .replace(/\{\{\s*data_aniversario\s*\}\}|\{data_aniversario\}/gi,String(dateLabel||''));
  }
  function updateBirthdayPreview(){
    var message=document.getElementById('birthdayMessageInput');
    var name=document.getElementById('birthdayPreviewName');
    var preview=document.getElementById('birthdayPreview');
    if(!message||!preview)return;
    preview.textContent=birthdayRender(message.value,name?name.value:'João da Silva','');
  }
  function updateBirthdayLatePreview(){
    var message=document.getElementById('birthdayLateMessageInput');
    var preview=document.getElementById('birthdayLatePreview');
    var name=document.getElementById('birthdayPreviewName');
    if(!message||!preview)return;
    preview.textContent=birthdayRender(message.value,name?name.value:'João da Silva',preview.dataset.dateLabel||'');
  }
  function birthdayResult(message,ok){
    var box=document.getElementById('birthdaySimulationResult');
    if(!box)return;
    box.textContent=message;
    box.className='qw-result show '+(ok?'ok':'bad');
  }
  function missedBirthdayResult(message,ok){
    var box=document.getElementById('missedBirthdayResult');
    if(!box)return birthdayResult(message,ok);
    box.textContent=message;
    box.className='qw-result show '+(ok?'ok':'bad');
  }
  function birthdayEscapeHtml(value){
    return String(value == null ? '' : value).replace(/[&<>\"']/g,function(ch){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[ch] || ch;
    });
  }
  function birthdayStatusInfo(row){
    if(row.status==='enviado') return {label:'Já enviado hoje',icon:'✅',tone:'green'};
    if(row.status==='sem_telefone') return {label:'Não será enviado · sem telefone',icon:'⚠️',tone:'warn'};
    if(row.status==='opt_out') return {label:'Não será enviado · opt-out',icon:'⛔',tone:'warn'};
    if(row.status==='erro') return {label:'Será tentado novamente',icon:'🟠',tone:'warn'};
    return {label:'Será enviado',icon:'🟢',tone:'green'};
  }
  function birthdayFormatDuration(seconds){
    seconds=Math.max(0,Number(seconds)||0);
    if(seconds<60) return seconds+' segundo'+(seconds===1?'':'s');
    var min=Math.ceil(seconds/60);
    return 'aprox. '+min+' minuto'+(min===1?'':'s');
  }
  function toggleBirthdayPreview(id){
    var el=document.getElementById(id);
    if(el) el.hidden=!el.hidden;
  }
  async function simulateBirthdayRun(){
    var box=document.getElementById('birthdaySimulationResult');
    if(box) box.innerHTML='<div class="qw-result show">Consultando aniversariantes...</div>';
    try{
      var payload=await waRequest('/automacao-whatsapp/aniversariantes/simular',{cache:'no-store'});
      var rows=Array.isArray(payload.rows)?payload.rows:[];
      var eligible=Number(payload.eligible||0);
      var invalid=rows.filter(function(row){return row.status==='sem_telefone';}).length;
      var already=rows.filter(function(row){return row.status==='enviado';}).length;
      var html='';
      html+='<div class="qw-card" style="padding:14px;margin:0;background:rgba(255,255,255,.025)">';
      html+='<div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><div><strong style="font-size:15px">🧪 Resultado da simulação</strong><div class="qw-muted" style="margin-top:3px">Prévia completa da rotina de hoje</div></div><span class="qw-pill '+(payload.whatsappConnected?'green':'')+'">'+(payload.whatsappConnected?'🟢 WhatsApp conectado':'🔴 WhatsApp desconectado')+'</span></div>';
      html+='<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:8px;margin-top:12px">';
      var cards=[
        ['🕘 Horário',payload.scheduledTime||'—'],['👥 Encontrados',payload.total||0],['📤 Serão enviados',eligible],['✅ Já enviados hoje',already],['⚠️ Sem telefone válido',invalid],['⏱ Intervalo',(payload.intervalSeconds||0)+'s'],['⌛ Tempo estimado',birthdayFormatDuration(payload.estimatedSeconds)]
      ];
      cards.forEach(function(c){html+='<div style="border:1px solid var(--qw-border,#2a2a2a);border-radius:10px;padding:10px"><div class="qw-muted" style="font-size:11px">'+birthdayEscapeHtml(c[0])+'</div><strong style="display:block;margin-top:3px">'+birthdayEscapeHtml(c[1])+'</strong></div>';});
      html+='</div>';
      html+='<div class="qw-info" style="margin-top:12px"><strong>🛡️ Simulação apenas — nenhuma mensagem foi enviada.</strong><br><span class="qw-muted">A automação está '+(payload.automationEnabled?'ativada':'desativada')+'. Esta tela mostra exatamente o que aconteceria se a rotina executasse agora.</span></div>';
      if(rows.length){
        html+='<div style="margin-top:14px;overflow:auto"><table class="qw-table" style="width:100%"><thead><tr><th>Cliente</th><th>WhatsApp</th><th>Situação</th><th>Prévia</th></tr></thead><tbody>';
        rows.forEach(function(row,index){
          var info=birthdayStatusInfo(row), previewId='birthdaySimPreview_'+index;
          html+='<tr><td><strong>'+birthdayEscapeHtml(row.name||'Cliente')+'</strong></td><td>'+(row.phone?'+'+birthdayEscapeHtml(row.phone):'<span class="qw-muted">Sem número válido</span>')+'</td><td><span class="qw-pill '+(info.tone==='green'?'green':'')+'">'+info.icon+' '+birthdayEscapeHtml(info.label)+'</span>'+(row.error?'<br><small class="qw-muted">'+birthdayEscapeHtml(row.error)+'</small>':'')+'</td><td><button class="qw-mini-btn" type="button" onclick="toggleBirthdayPreview(\''+previewId+'\')">Ver mensagem</button></td></tr>';
          html+='<tr id="'+previewId+'" hidden><td colspan="4"><div class="qw-info" style="white-space:pre-wrap;line-height:1.55;margin:5px 0 8px">'+birthdayEscapeHtml(row.message||'')+'</div></td></tr>';
        });
        html+='</tbody></table></div>';
      }else{
        html+='<div class="qw-empty" style="margin-top:12px">Nenhum aniversariante encontrado para hoje.</div>';
      }
      html+='</div>';
      if(box) box.innerHTML=html;
    }catch(error){
      if(box) box.innerHTML='<div class="qw-result show bad">'+birthdayEscapeHtml(error.message||'Falha na simulação.')+'</div>';
    }
  }
  async function sendBirthdayTest(){
    var number=document.getElementById('birthdayTestNumber');
    var name=document.getElementById('birthdayPreviewName');
    var message=document.getElementById('birthdayMessageInput');
    if(!number||!number.value.trim()){birthdayResult('Informe o número que receberá o teste.',false);return;}
    if(!confirm('Enviar esta mensagem de teste pelo WhatsApp para o número informado?'))return;
    birthdayResult('Enviando teste...',true);
    try{
      var payload=await waRequest('/automacao-whatsapp/aniversariantes/testar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({numero:number.value,nome:name?name.value:'João da Silva',mensagem:message?message.value:''})});
      birthdayResult(payload.message,true);
    }catch(error){birthdayResult(error.message||'Falha no envio de teste.',false);}
  }
  async function sendMissedBirthdayCustomer(customerId,dateLabel){
    if(!customerId)return;
    var lateMessage=document.getElementById('birthdayLateMessageInput');
    if(!confirm('Enviar manualmente a mensagem atrasada para este cliente?\n\nO aniversário foi em '+(dateLabel||'ontem')+'.'))return;
    try{
      missedBirthdayResult('Enviando mensagem atrasada...',true);
      var payload=await waRequest('/automacao-whatsapp/aniversariantes/atrasados/reenviar/'+encodeURIComponent(customerId),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mensagem:lateMessage?lateMessage.value:''})});
      missedBirthdayResult(payload.message||'Mensagem atrasada enviada com sucesso.',true);
      setTimeout(function(){window.location.reload();},900);
    }catch(error){
      missedBirthdayResult(error.message||'Falha ao enviar a mensagem atrasada.',false);
    }
  }
  async function sendAllMissedBirthdays(){
    var lateMessage=document.getElementById('birthdayLateMessageInput');
    if(!confirm('Enviar MANUALMENTE a mensagem de atraso para todos os aniversariantes pendentes do dia anterior que possuem WhatsApp válido?'))return;
    try{
      missedBirthdayResult('Executando recuperação manual do dia anterior...',true);
      var payload=await waRequest('/automacao-whatsapp/aniversariantes/atrasados/enviar-todos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mensagem:lateMessage?lateMessage.value:''})});
      missedBirthdayResult(payload.message||'Recuperação manual concluída.',true);
      setTimeout(function(){window.location.reload();},1200);
    }catch(error){
      missedBirthdayResult(error.message||'Falha na recuperação manual.',false);
    }
  }

  async function resendBirthdayCustomer(customerId){
    if(!customerId)return;
    if(!confirm('Reenviar agora a mensagem de aniversário para este cliente?'))return;
    try{
      birthdayResult('Tentando reenviar a mensagem...',true);
      var payload=await waRequest('/automacao-whatsapp/aniversariantes/reenviar/'+encodeURIComponent(customerId),{method:'POST',headers:{'Content-Type':'application/json'}});
      birthdayResult(payload.message||'Mensagem reenviada com sucesso.',true);
      setTimeout(function(){window.location.reload();},900);
    }catch(error){
      birthdayResult(error.message||'Falha ao reenviar a mensagem.',false);
    }
  }

  async function runBirthdaysNow(){
    if(!confirm('Enviar agora a mensagem para todos os aniversariantes pendentes de hoje?'))return;
    birthdayResult('Executando os envios de hoje...',true);
    try{
      var payload=await waRequest('/automacao-whatsapp/aniversariantes/executar-agora',{method:'POST',headers:{'Content-Type':'application/json'}});
      birthdayResult(payload.message,true);
      setTimeout(function(){window.location.reload();},1200);
    }catch(error){birthdayResult(error.message||'Falha ao executar aniversariantes.',false);}
  }
  window.updateBirthdayPreview=updateBirthdayPreview;
  window.updateBirthdayLatePreview=updateBirthdayLatePreview;
  window.simulateBirthdayRun=simulateBirthdayRun;
  window.toggleBirthdayPreview=toggleBirthdayPreview;
  window.sendBirthdayTest=sendBirthdayTest;
  window.sendMissedBirthdayCustomer=sendMissedBirthdayCustomer;
  window.sendAllMissedBirthdays=sendAllMissedBirthdays;
  window.resendBirthdayCustomer=resendBirthdayCustomer;
  window.runBirthdaysNow=runBirthdaysNow;

  async function sessionAction(url,question){
    if(question && !confirm(question)) return;
    var box=document.getElementById('waDiagnostic');
    try{
      if(box){box.style.display='block';box.textContent='Executando...';}
      var response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'}});
      var payload=await response.json();
      if(!response.ok||!payload.success) throw new Error(payload.message||'Ação não concluída.');
      if(box) box.textContent=payload.whatsapp?.message||'Ação concluída.';
      setTimeout(function(){window.location.reload();},900);
    }catch(error){if(box){box.style.display='block';box.textContent=error.message||'Falha na ação.';}}
  }
  async function runSessionDiagnostic(){
    var box=document.getElementById('waDiagnostic');
    if(!box)return;
    box.style.display='block';box.textContent='Executando diagnóstico...';
    try{
      var response=await fetch('/automacao-whatsapp/whatsapp/diagnostico',{cache:'no-store'});
      var payload=await response.json();
      if(!response.ok||!payload.success)throw new Error(payload.message||'Diagnóstico indisponível.');
      var a=payload.adapter||{},s=payload.session||{},m=payload.media||{};
      box.innerHTML='<strong>Diagnóstico da sessão</strong><br>'+
        'Cliente: '+(a.clientAttached?'OK':'indisponível')+' · Página: '+(a.pageAvailable?'OK':'indisponível')+'<br>'+
        'WAWebCollections: '+(a.hasWAWebCollections?'OK':'não encontrado')+' · Msg Store: '+(a.hasMsgCollection?'OK':'não encontrada')+'<br>'+
        'Download Manager: '+(a.hasDownloadManager?'OK':'não encontrado')+' · Mensagens carregadas: '+(a.messageModels||0)+'<br>'+
        'Media Engine: '+(m.engineVersion||'—')+' · Cache: '+(s.messageCacheSize||0)+' mensagens'+
