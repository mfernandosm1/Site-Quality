      if(item.status==='erro') actions='<button type="button" onclick="retryInboxScheduledMessage(\''+esc(item.id)+'\')">Tentar agora</button>';
      actions+='<button class="delete" type="button" onclick="deleteInboxScheduledMessage(\''+esc(item.id)+'\')">Excluir</button>';
      return '<div class="qw-schedule-row status-'+esc(item.status)+'" data-schedule-id="'+esc(item.id)+'"><div><strong>'+icon+esc(main)+'</strong><small>'+esc(formatInboxScheduleDate(item.scheduledAt))+' · '+esc(status)+(item.fileName?' · '+esc(item.fileName):'')+'</small>'+(item.lastError?'<em>'+esc(item.lastError)+'</em>':'')+'</div><div class="qw-schedule-row-actions">'+actions+'</div></div>';
    }).join('');
