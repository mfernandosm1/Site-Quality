    if(!options.silent) document.querySelector('.qw-inbox-chat')?.classList.add('qw-switching');
    if(clicked && !options.silent) clicked.classList.add('qw-loading');
    if(inboxConversationNavigationController) inboxConversationNavigationController.abort();
    inboxConversationNavigationController=new AbortController();
    try{
      var response=await fetch(targetUrl.pathname+targetUrl.search,{headers:{'X-QW-Inbox-Navigation':'1'},cache:'no-store',signal:inboxConversationNavigationController.signal});
      if(!response.ok) throw new Error('Não foi possível abrir a conversa.');
      var html=await response.text();
