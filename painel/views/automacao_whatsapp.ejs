    if(inboxScheduleRecordingProcessing){showInboxSendResult('Aguarde um instante enquanto o áudio é preparado.',false);return;}
    var recordedMime=inboxScheduleRecordedBlob?String(inboxScheduleRecordedBlob.type||'audio/webm'):'', textValue=String(text&&text.value||'').trim(), file=(inboxScheduleRecordedBlob ? new File([inboxScheduleRecordedBlob],inboxScheduleRecordedFileName||'audio-agendado.webm',{type:recordedMime||'audio/webm'}) : (media&&media.files&&media.files[0]));
    if(!at||!at.value){showInboxSendResult('Escolha o dia e o horário do envio.',false);return;}
    if(!textValue&&!file){showInboxSendResult('Digite uma mensagem, selecione uma imagem, áudio ou vídeo, ou grave um áudio.',false);return;}
