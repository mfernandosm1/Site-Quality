<% layout('layout') -%>
<style>
  :root{--qw-bg:#f6f7fb;--qw-card:#fff;--qw-text:#111827;--qw-muted:#6b7280;--qw-line:#e5e7eb;--qw-red:#dc2626;--qw-green:#16a34a;--qw-blue:#2563eb;--qw-orange:#f97316;--qw-shadow:0 10px 30px rgba(15,23,42,.07)}
  .qw-wrap{background:var(--qw-bg);margin:-18px;padding:22px;min-height:calc(100vh - 70px);color:var(--qw-text)}
  .qw-header{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:18px}
  .qw-title h1{margin:0;font-size:28px;letter-spacing:-.03em}.qw-title p{margin:7px 0 0;color:var(--qw-muted)}
  .qw-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.qw-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--qw-line);border-radius:12px;background:#fff;color:#111827;text-decoration:none;padding:10px 14px;font-weight:800;cursor:pointer}.qw-btn.primary{background:#2563eb;color:#fff;border-color:#2563eb}.qw-btn.dark{background:#111827;color:#fff;border-color:#111827}.qw-btn.danger{background:#fee2e2;color:#991b1b;border-color:#fecaca}.qw-btn.success{background:#dcfce7;color:#166534;border-color:#bbf7d0}
  .qw-flash{background:#ecfdf5;border:1px solid #bbf7d0;color:#166534;border-radius:14px;padding:12px 14px;margin-bottom:16px}
  .qw-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px}.qw-tab{border:1px solid var(--qw-line);background:#fff;color:#374151;text-decoration:none;border-radius:12px;padding:10px 14px;font-weight:800;font-size:13px}.qw-tab.active{background:#111827;color:#fff;border-color:#111827}
  .qw-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.qw-card{background:var(--qw-card);border:1px solid var(--qw-line);border-radius:18px;padding:16px;box-shadow:var(--qw-shadow)}.qw-card h2{font-size:17px;margin:0 0 12px}.qw-card .sub{color:var(--qw-muted);font-size:13px;margin:-6px 0 14px}.qw-span-12{grid-column:span 12}.qw-span-8{grid-column:span 8}.qw-span-7{grid-column:span 7}.qw-span-6{grid-column:span 6}.qw-span-5{grid-column:span 5}.qw-span-4{grid-column:span 4}.qw-span-3{grid-column:span 3}
  .qw-kpi{min-height:112px;position:relative;overflow:hidden}.qw-kpi .icon{font-size:22px}.qw-kpi .value{font-size:30px;font-weight:900;line-height:1;margin-top:12px}.qw-kpi .label{color:var(--qw-muted);font-size:13px;margin-top:6px}.qw-kpi:after{content:"";position:absolute;right:-28px;top:-28px;width:92px;height:92px;border-radius:999px;background:rgba(37,99,235,.08)}
  .qw-status{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.qw-pill{border:1px solid var(--qw-line);background:#fff;border-radius:999px;padding:8px 12px;font-size:13px;color:#374151}.qw-pill.green{background:#ecfdf5;color:#166534;border-color:#bbf7d0}.qw-pill.orange{background:#fff7ed;color:#9a3412;border-color:#fed7aa}.qw-pill.red{background:#fef2f2;color:#991b1b;border-color:#fecaca}
  .qw-table{width:100%;border-collapse:collapse;font-size:13px}.qw-table th{text-align:left;color:#6b7280;font-size:12px;padding:9px 8px;border-bottom:1px solid var(--qw-line)}.qw-table td{padding:10px 8px;border-bottom:1px solid #f1f5f9;vertical-align:middle}.qw-table tr:last-child td{border-bottom:0}.qw-muted{color:var(--qw-muted)}
  .qw-form{display:grid;gap:12px}.qw-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.qw-field label{display:block;font-size:12px;font-weight:900;color:#374151;margin:0 0 6px}.qw-input,.qw-textarea,.qw-select{width:100%;box-sizing:border-box;border:1px solid var(--qw-line);border-radius:12px;background:#fff;padding:10px 12px;font:inherit}.qw-textarea{min-height:92px;resize:vertical}.qw-check{display:flex;gap:8px;align-items:center;font-weight:800;color:#374151}
  .qw-builder{display:grid;gap:10px}.qw-step{border:1px solid var(--qw-line);border-radius:16px;background:#fff;padding:12px}.qw-step-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.qw-step-title{font-weight:900}.qw-step-grid{display:grid;grid-template-columns:150px 1fr 130px;gap:10px}.qw-step-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.qw-mini-btn{border:1px solid var(--qw-line);background:#f9fafb;border-radius:10px;padding:8px 10px;font-weight:800;cursor:pointer}.qw-mini-btn.danger{background:#fee2e2;color:#991b1b;border-color:#fecaca}.qw-addbar{display:flex;gap:8px;flex-wrap:wrap}.qw-empty{color:var(--qw-muted);padding:14px;border:1px dashed #d1d5db;border-radius:14px;background:#fafafa}.qw-preview{background:#0b1220;color:#e5e7eb;border-radius:16px;padding:14px;min-height:220px;white-space:pre-wrap;font-family:Consolas,monospace;font-size:13px;line-height:1.45}.qw-warning{background:#fff7ed;border:1px solid #fed7aa;border-radius:14px;padding:12px;color:#9a3412}.qw-info{background:#eff6ff;border:1px solid #bfdbfe;border-radius:14px;padding:12px;color:#1e40af}.qw-link{color:#2563eb;font-weight:900}.qw-options-box{display:grid;gap:8px;margin-top:8px}.qw-option-row{display:grid;grid-template-columns:1fr 90px 1fr auto;gap:8px}
  @media(max-width:1100px){.qw-span-8,.qw-span-7,.qw-span-6,.qw-span-5,.qw-span-4,.qw-span-3{grid-column:span 12}.qw-header{flex-direction:column}.qw-actions{justify-content:flex-start}.qw-step-grid,.qw-row,.qw-option-row{grid-template-columns:1fr}.qw-kpi{grid-column:span 6}}

  .qw-phone{background:#efeae2;border:1px solid #d7d2ca;border-radius:20px;overflow:hidden;min-height:420px;display:flex;flex-direction:column}
  .qw-phone-head{background:#075e54;color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px}
  .qw-phone-avatar{width:38px;height:38px;border-radius:50%;background:#d9fdd3;display:grid;place-items:center;color:#075e54;font-size:20px;font-weight:900}
  .qw-phone-title{font-weight:900}.qw-phone-status{font-size:12px;opacity:.85}
  .qw-chat{flex:1;padding:16px;background:
    linear-gradient(rgba(239,234,226,.94),rgba(239,234,226,.94)),
    radial-gradient(circle at 15px 15px,rgba(0,0,0,.03) 2px,transparent 3px);
    background-size:auto,30px 30px;display:flex;flex-direction:column;gap:8px;overflow:auto;max-height:560px}
  .qw-msg{align-self:flex-end;max-width:min(78%,520px);background:#d9fdd3;border-radius:12px 4px 12px 12px;padding:9px 11px;box-shadow:0 1px 1px rgba(0,0,0,.08);white-space:pre-wrap;word-break:break-word;position:relative}
  .qw-msg small{display:block;text-align:right;color:#667781;font-size:10px;margin-top:4px}
  .qw-msg img{display:block;max-width:100%;max-height:320px;border-radius:9px;margin-bottom:6px}
  .qw-msg audio{width:280px;max-width:100%;display:block}
  .qw-file{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.55);border-radius:9px;padding:10px;text-decoration:none;color:#111827;font-weight:800}
  .qw-typing{align-self:flex-start;background:#fff;border-radius:4px 12px 12px 12px;padding:10px 14px;box-shadow:0 1px 1px rgba(0,0,0,.08);color:#667781;font-size:13px}
  .qw-dots{display:inline-flex;gap:3px;margin-left:6px}.qw-dots span{width:5px;height:5px;border-radius:50%;background:#667781;animation:qwDot 1.1s infinite}.qw-dots span:nth-child(2){animation-delay:.18s}.qw-dots span:nth-child(3){animation-delay:.36s}
  @keyframes qwDot{0%,70%,100%{transform:translateY(0);opacity:.45}35%{transform:translateY(-4px);opacity:1}}
  .qw-wait{align-self:center;background:rgba(255,255,255,.78);color:#667781;border-radius:999px;padding:6px 10px;font-size:12px}
  .qw-options-preview{display:grid;gap:6px;margin-top:8px}.qw-option-preview{background:#fff;border:1px solid #cbd5e1;border-radius:9px;padding:8px 10px;text-align:center;color:#075e54;font-weight:900}
  .qw-sim-controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  .qw-sim-note{font-size:12px;color:var(--qw-muted);margin-top:8px}


  .qw-editor-card{align-self:start}
  .qw-simulator-card{align-self:start;position:static}
  .qw-step{padding:0;overflow:hidden}
  .qw-step-head{margin:0;padding:11px 12px;cursor:pointer;background:#f8fafc;border-bottom:1px solid transparent}
  .qw-step.open .qw-step-head{border-bottom-color:var(--qw-line)}
  .qw-step-body{display:none;padding:12px}
  .qw-step.open .qw-step-body{display:block}
  .qw-step-summary{display:flex;gap:8px;align-items:center;min-width:0}
  .qw-step-summary-text{color:var(--qw-muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:420px}
  .qw-toggle{border:0;background:transparent;font-size:16px;cursor:pointer;padding:0 4px}
  .qw-toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:10px 0}
  .qw-media-preview img{max-width:120px;max-height:90px;object-fit:cover}
  .qw-media-preview audio{width:220px;max-width:100%}.qw-media-preview video{width:260px;max-width:100%;max-height:180px;border-radius:10px;background:#111827}
  .qw-compact-path{font-size:11px;color:var(--qw-muted);word-break:break-all;margin-top:5px}
  .qw-step-actions{flex-wrap:nowrap}
  @media(max-width:1100px){.qw-simulator-card{position:static}.qw-step-summary-text{max-width:220px}}


  .qw-library-tools{display:grid;grid-template-columns:1.5fr .8fr auto;gap:10px;margin-bottom:14px}.qw-block-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.qw-block-card{border:1px solid var(--qw-line);border-radius:16px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:10px;min-height:180px;transition:.18s}.qw-block-card:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(15,23,42,.09)}.qw-block-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.qw-block-name{font-weight:900;font-size:16px}.qw-star{border:0;background:transparent;font-size:22px;cursor:pointer;line-height:1}.qw-block-meta{display:flex;gap:6px;flex-wrap:wrap}.qw-tag{font-size:11px;border-radius:999px;padding:5px 8px;background:#f1f5f9;color:#475569;font-weight:800}.qw-tag.active{background:#dcfce7;color:#166534}.qw-tag.inactive{background:#fee2e2;color:#991b1b}.qw-block-desc{color:var(--qw-muted);font-size:13px;line-height:1.4;flex:1}.qw-block-actions{display:flex;gap:7px;flex-wrap:wrap}.qw-block-actions form{margin:0}.qw-unsaved{display:none;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:12px;padding:9px 11px;font-size:12px;font-weight:800}.qw-unsaved.show{display:block}.qw-flow-start{border:1px solid #86efac;background:#f0fdf4;border-radius:15px;padding:12px;margin-bottom:10px;font-weight:900;color:#166534;text-align:center}.qw-step-number{display:inline-grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#111827;color:#fff;font-size:12px;margin-right:6px}.qw-mini-btn.blue{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.qw-mini-btn.gold{background:#fffbeb;color:#92400e;border-color:#fde68a}@media(max-width:1100px){.qw-block-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.qw-library-tools{grid-template-columns:1fr 1fr}}@media(max-width:700px){.qw-block-grid{grid-template-columns:1fr}.qw-library-tools{grid-template-columns:1fr}}

  .qw-connection-grid{display:grid;grid-template-columns:minmax(280px,420px) 1fr;gap:14px}.qw-qr-box{min-height:350px;display:grid;place-items:center;border:1px dashed #cbd5e1;border-radius:16px;background:#fff;padding:14px;text-align:center}.qw-qr-box img{width:min(320px,100%);height:auto}.qw-live-status{display:flex;align-items:center;gap:10px;font-weight:900}.qw-status-dot{width:11px;height:11px;border-radius:50%;background:#9ca3af}.qw-status-dot.connected{background:#16a34a;box-shadow:0 0 0 5px rgba(22,163,74,.12)}.qw-status-dot.waiting{background:#f97316;box-shadow:0 0 0 5px rgba(249,115,22,.12)}.qw-status-dot.error{background:#dc2626;box-shadow:0 0 0 5px rgba(220,38,38,.12)}.qw-result{display:none;border-radius:12px;padding:11px 13px;font-weight:800}.qw-result.show{display:block}.qw-result.ok{background:#ecfdf5;border:1px solid #bbf7d0;color:#166534}.qw-result.bad{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.qw-send-lock{opacity:.6;pointer-events:none}.qw-log-list{display:grid;gap:8px}.qw-log-row{border:1px solid var(--qw-line);border-radius:12px;padding:10px 12px;background:#fff}.qw-log-row small{color:var(--qw-muted)}
  @media(max-width:900px){.qw-connection-grid{grid-template-columns:1fr}}
  .qw-media-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.qw-media-card{border:1px solid var(--qw-line);border-radius:16px;background:#fff;padding:12px;display:flex;flex-direction:column;gap:9px;min-height:210px}.qw-media-thumb{height:120px;border-radius:12px;background:#f8fafc;display:grid;place-items:center;overflow:hidden}.qw-media-thumb img,.qw-media-thumb video{width:100%;height:100%;object-fit:contain}.qw-media-thumb audio{width:92%}.qw-media-name{font-weight:900;word-break:break-word}.qw-media-usage{font-size:12px;color:var(--qw-muted);line-height:1.45}.qw-media-path{font-size:10px;color:var(--qw-muted);word-break:break-all}.qw-media-tools{display:grid;grid-template-columns:1fr 220px;gap:10px;margin-bottom:14px}@media(max-width:1100px){.qw-media-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.qw-media-grid{grid-template-columns:1fr}.qw-media-tools{grid-template-columns:1fr}}

  .qw-media-groups{display:grid;gap:12px}
  .qw-media-group{border:1px solid var(--qw-line);border-radius:16px;background:#fff;overflow:hidden}
  .qw-media-group[hidden]{display:none}
  .qw-media-group-head{width:100%;border:0;background:#f8fafc;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;text-align:left;color:var(--qw-text)}
  .qw-media-group-title{display:flex;align-items:center;gap:9px;font-weight:900;font-size:15px}
  .qw-media-group-meta{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
  .qw-media-group-arrow{font-size:18px;transition:transform .18s}
  .qw-media-group.open .qw-media-group-arrow{transform:rotate(90deg)}
  .qw-media-group-body{display:none;padding:12px;border-top:1px solid var(--qw-line)}
  .qw-media-group.open .qw-media-group-body{display:block}
  .qw-media-empty-filter{display:none;color:var(--qw-muted);padding:14px;border:1px dashed #d1d5db;border-radius:14px;background:#fafafa}
  .qw-media-empty-filter.show{display:block}
  .qw-media-link-btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}

  .qw-settings-nav{display:flex;gap:8px;flex-wrap:wrap;margin:-6px 0 18px;padding:10px;background:#fff;border:1px solid var(--qw-line);border-radius:14px}
  .qw-settings-link{padding:9px 13px;border-radius:10px;text-decoration:none;color:#475569;font-weight:900;font-size:13px}
  .qw-settings-link:hover{background:#f1f5f9}.qw-settings-link.active{background:#eff6ff;color:#1d4ed8}
  .qw-inbox-empty{min-height:360px;display:grid;place-items:center;text-align:center;padding:30px}
  .qw-inbox-empty-icon{font-size:64px;margin-bottom:10px}

  .qw-inbox-shell{display:grid;grid-template-columns:360px minmax(0,1fr);gap:14px;min-height:620px}
  .qw-inbox-list{padding:0;overflow:hidden}.qw-inbox-list-head{padding:14px;border-bottom:1px solid var(--qw-line)}
  .qw-conversation-list{max-height:650px;overflow:auto}.qw-conversation-item{display:block;padding:13px 14px;border-bottom:1px solid #eef2f7;text-decoration:none;color:var(--qw-text);background:#fff}.qw-conversation-item:hover,.qw-conversation-item.active{background:#eff6ff}.qw-conversation-name{display:flex;justify-content:space-between;gap:8px;font-weight:900}.qw-conversation-snippet{color:var(--qw-muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px}.qw-conversation-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.qw-badge{font-size:10px;font-weight:900;border-radius:999px;padding:4px 7px;background:#f1f5f9;color:#475569}.qw-badge.wait{background:#fef2f2;color:#991b1b}.qw-badge.new{background:#eff6ff;color:#1d4ed8}
  .qw-inbox-chat{padding:0;overflow:hidden}.qw-inbox-chat-head{padding:14px 16px;border-bottom:1px solid var(--qw-line);display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.qw-inbox-chat-body{background:#efeae2;padding:18px;min-height:390px;max-height:540px;overflow:auto;display:flex;flex-direction:column;gap:8px}.qw-inbox-msg{max-width:min(78%,650px);padding:9px 11px;border-radius:12px;background:#fff;box-shadow:0 1px 1px rgba(0,0,0,.08);white-space:pre-wrap;word-break:break-word}.qw-inbox-msg.outgoing{align-self:flex-end;background:#d9fdd3;border-radius:12px 4px 12px 12px}.qw-inbox-msg.incoming{align-self:flex-start;border-radius:4px 12px 12px 12px}.qw-inbox-msg small{display:block;text-align:right;color:#667781;font-size:10px;margin-top:5px}.qw-inbox-media{display:grid;gap:6px;margin-bottom:5px}.qw-inbox-media img{display:block;max-width:100%;max-height:340px;border-radius:9px;object-fit:contain;background:#f8fafc}.qw-inbox-media video{display:block;width:min(420px,100%);max-height:340px;border-radius:9px;background:#111}.qw-inbox-media audio{display:block;width:min(340px,100%)}.qw-inbox-document{display:flex;align-items:center;gap:10px;padding:10px;border-radius:9px;background:rgba(255,255,255,.58);color:#111827;text-decoration:none}.qw-inbox-document-icon{font-size:26px}.qw-inbox-document-info{min-width:0;flex:1}.qw-inbox-document-name{font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.qw-inbox-document-meta{font-size:10px;color:#64748b}.qw-media-actions{display:flex;gap:6px;flex-wrap:wrap}.qw-media-action{font-size:10px;font-weight:900;color:#2563eb;text-decoration:none}.qw-media-error{font-size:11px;color:#991b1b;background:#fee2e2;border-radius:8px;padding:7px}.qw-attach-item{border:0;width:100%;background:#fff;text-align:left;cursor:pointer}.qw-attach-item:hover{background:#eff6ff}.qw-attach-preview{display:none;margin-top:6px;padding:8px;background:#fff;border:1px solid var(--qw-line);border-radius:10px;font-size:11px}.qw-attach-preview.show{display:flex;align-items:center;justify-content:space-between;gap:8px}.qw-attach-preview-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.qw-attach-cancel{border:0;background:#fee2e2;color:#991b1b;border-radius:999px;width:24px;height:24px;cursor:pointer}.qw-contact-form{padding:14px 16px;border-top:1px solid var(--qw-line);background:#fff}.qw-contact-form-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:10px}.qw-contact-form-grid .wide{grid-column:span 2}.qw-inbox-placeholder{min-height:620px;display:grid;place-items:center;text-align:center;padding:30px}
  .qw-inbox-composer{padding:12px 14px;border-top:1px solid var(--qw-line);background:#f8fafc;display:grid;gap:10px}
  .qw-inbox-compose-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;align-items:end}
  .qw-inbox-compose-text{min-height:46px;max-height:140px;resize:vertical}
  .qw-inbox-block-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}
  .qw-inbox-send-result{display:none;border-radius:10px;padding:9px 11px;font-size:12px;font-weight:800}
  .qw-inbox-send-result.show{display:block}.qw-inbox-send-result.ok{background:#ecfdf5;color:#166534;border:1px solid #bbf7d0}.qw-inbox-send-result.bad{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
  .qw-inbox-composer button:disabled,.qw-inbox-composer select:disabled,.qw-inbox-composer textarea:disabled{opacity:.55;cursor:not-allowed}

  @media(max-width:950px){.qw-inbox-shell{grid-template-columns:1fr}.qw-conversation-list{max-height:340px}.qw-contact-form-grid{grid-template-columns:1fr}.qw-contact-form-grid .wide{grid-column:span 1}}
  @media(max-width:650px){.qw-inbox-compose-row,.qw-inbox-block-row{grid-template-columns:1fr}.qw-inbox-compose-row .qw-btn,.qw-inbox-block-row .qw-btn{width:100%}}

  /* Inbox UX v0.5.5 */
  .qw-inbox-shell{grid-template-columns:340px minmax(0,1fr);gap:10px;min-height:660px}
  .qw-inbox-list,.qw-inbox-chat{border-radius:16px}
  .qw-inbox-list-head{padding:12px;background:#f8fafc}
  .qw-conversation-list{max-height:690px}
  .qw-conversation-item{position:relative;padding:12px 12px 12px 16px;min-height:58px}
  .qw-conversation-item:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#cbd5e1}
  .qw-conversation-item.status-new:before{background:#3b82f6}.qw-conversation-item.status-in_progress:before{background:#eab308}.qw-conversation-item.status-pending:before{background:#f97316}.qw-conversation-item.status-completed_sale:before{background:#22c55e}.qw-conversation-item.status-lost:before{background:#ef4444}.qw-conversation-item.status-no_potential:before{background:#64748b}
  .qw-conversation-item.has-unread{background:#f0fdf4}.qw-conversation-item.active{background:#e0f2fe}
  .qw-conversation-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .qw-conversation-title{font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .qw-conversation-time{font-size:11px;color:#64748b;white-space:nowrap}.has-unread .qw-conversation-time{color:#16a34a;font-weight:900}
  .qw-conversation-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:4px}
  .qw-conversation-preview{font-size:12px;color:#64748b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
  .qw-unread-count{min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:#22c55e;color:#fff;font-size:11px;font-weight:900;display:grid;place-items:center}
  .qw-chat-toolbar{display:flex;align-items:center;gap:7px}.qw-icon-btn{width:38px;height:38px;border:0;border-radius:999px;background:transparent;display:grid;place-items:center;cursor:pointer;font-size:19px}.qw-icon-btn:hover{background:#e2e8f0}.qw-icon-btn:disabled{opacity:.45;cursor:not-allowed}
  .qw-inbox-chat-head{align-items:center;padding:10px 14px;background:#f8fafc}.qw-contact-heading{min-width:0}.qw-contact-heading h2{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.qw-contact-sub{font-size:11px;color:#64748b;margin-top:2px}
  .qw-inbox-chat-body{min-height:480px;max-height:620px;padding:18px}
  .qw-inbox-composer{position:relative;padding:9px 11px;background:#f1f5f9;display:block}
  .qw-composer-bar{display:grid;grid-template-columns:auto auto minmax(0,1fr) auto;gap:5px;align-items:end}
  .qw-inbox-compose-text{min-height:42px;max-height:110px;border-radius:20px;padding:10px 14px;resize:none;background:#fff}
  .qw-send-icon{background:#2563eb;color:#fff}.qw-send-icon:hover{background:#1d4ed8}
  .qw-popover{display:none;position:absolute;z-index:25;bottom:64px;left:10px;width:min(330px,calc(100% - 20px));background:#fff;border:1px solid var(--qw-line);border-radius:14px;box-shadow:0 16px 40px rgba(15,23,42,.18);padding:10px}.qw-popover.open{display:block}
  .qw-popover-title{font-weight:900;padding:5px 7px 10px}.qw-popover-list{max-height:300px;overflow:auto;display:grid;gap:4px}
  .qw-popover-item{width:100%;border:0;background:#fff;border-radius:10px;padding:10px;text-align:left;cursor:pointer;font-weight:800}.qw-popover-item:hover{background:#eff6ff}.qw-popover-item small{display:block;color:#64748b;font-weight:400;margin-top:2px}
  .qw-attach-item{display:flex;gap:10px;align-items:center;padding:10px;border-radius:10px;color:#475569}.qw-attach-item.disabled{opacity:.55}.qw-attach-item span:first-child{font-size:20px}
  .qw-contact-drawer-backdrop{display:none;position:fixed;inset:0;background:rgba(15,23,42,.25);z-index:80}.qw-contact-drawer-backdrop.open{display:block}
  .qw-contact-drawer{position:fixed;right:0;top:0;bottom:0;width:min(410px,100vw);background:#fff;box-shadow:-16px 0 40px rgba(15,23,42,.2);padding:18px;overflow:auto;transform:translateX(105%);transition:.2s;z-index:81}.qw-contact-drawer.open{transform:translateX(0)}
  .qw-drawer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.qw-drawer-head h2{margin:0}.qw-drawer-close{border:0;background:#f1f5f9;border-radius:999px;width:36px;height:36px;cursor:pointer}
  .qw-contact-form{padding:0;border:0}.qw-contact-form-grid{display:grid;grid-template-columns:1fr;gap:13px}.qw-contact-form-grid .wide{grid-column:span 1}
  .qw-conversation-menu{display:none;position:fixed;z-index:90;background:#fff;border:1px solid var(--qw-line);border-radius:12px;box-shadow:0 14px 36px rgba(15,23,42,.2);padding:6px;min-width:210px}.qw-conversation-menu.open{display:block}.qw-conversation-menu button{width:100%;border:0;background:#fff;text-align:left;padding:10px;border-radius:8px;cursor:pointer;font-weight:800}.qw-conversation-menu button:hover{background:#f1f5f9}
  .qw-chat-status-dot{width:9px;height:9px;border-radius:50%;display:inline-block;background:#22c55e;margin-right:5px}.qw-chat-status-dot.wait{background:#ef4444}
  .qw-inbox-send-result{margin-top:6px}
  @media(max-width:950px){.qw-inbox-shell{grid-template-columns:1fr}.qw-inbox-chat-body{min-height:430px}.qw-conversation-list{max-height:290px}}
  @media(max-width:600px){.qw-wrap{padding:10px}.qw-grid[style*="margin-bottom"]{display:none}.qw-inbox-shell{gap:7px}.qw-composer-bar{grid-template-columns:auto auto minmax(0,1fr) auto}.qw-icon-btn{width:34px;height:40px}.qw-inbox-compose-text{font-size:14px}}

  /* v0.5.6 — modo operacional compacto (Full HD / zoom 100%) */
  .qw-operational{padding:12px 16px;min-height:calc(100vh - 58px)}
  .qw-operational .qw-header{align-items:center;margin-bottom:8px;gap:10px}
  .qw-operational .qw-title{display:flex;align-items:center;gap:10px;min-width:0}
  .qw-operational .qw-title h1{font-size:20px;white-space:nowrap}
