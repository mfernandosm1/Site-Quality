  function flowActionName(option) {
    var kind = option && (option.acaoTipo || (option.proximoBloco ? 'bloco' : 'encerrar')) || 'encerrar';
    var names = { texto:'Texto', imagem:'Imagem', audio:'Áudio', video:'Vídeo', arquivo:'Arquivo', bloco:'Outro bloco', encerrar:'Encerrar' };
    return names[kind] || kind;
  }

  function flowActionDetail(option) {
    if (!option) return '';
    var kind = option.acaoTipo || (option.proximoBloco ? 'bloco' : 'encerrar');
    if (kind === 'texto') return String(option.texto || 'Texto ainda não definido').replace(/\s+/g, ' ').slice(0, 56);
    if (kind === 'bloco') {
      var found = blocosSalvos.find(function(b){ return b.id === option.proximoBloco; });
      return found ? found.nome : (option.proximoBloco ? 'Bloco selecionado' : 'Escolha um bloco');
    }
    if (['imagem','audio','video','arquivo'].indexOf(kind) >= 0) return option.caminho ? String(option.caminho).split('/').pop() : 'Mídia ainda não definida';
    return 'Fim deste caminho';
  }

  function renderFlowMap() {
    var map = document.getElementById('flowMap');
    if (!map) return;
    if (!steps.length) {
      map.innerHTML = '<div class="qw-flow-map-head"><div class="qw-flow-map-title">Mapa do fluxo</div></div><div class="qw-flow-map-note">Adicione etapas para visualizar o caminho e as ramificações.</div>';
      return;
    }
    var html = '<div class="qw-flow-map-head"><div class="qw-flow-map-title">🧭 Mapa do fluxo</div><div class="qw-flow-map-note">visualização das ramificações</div></div><div class="qw-flow-map-track">';
    html += '<div class="qw-flow-node start"><div class="qw-flow-node-title">Início</div><div class="qw-flow-node-main">Bloco atual</div></div>';
    steps.forEach(function(step, index){
      html += '<div class="qw-flow-arrow">→</div>';
      if (step.tipo !== 'opcoes') {
        html += '<div class="qw-flow-node"><div class="qw-flow-node-title">Etapa ' + (index + 1) + '</div><div class="qw-flow-node-main">' + esc(step.tipo) + '</div><div class="qw-flow-node-sub">' + esc(stepSummary(step)) + '</div></div>';
        return;
      }
      html += '<div class="qw-flow-node choice"><div class="qw-flow-node-title">Etapa ' + (index + 1) + '</div><div class="qw-flow-node-main">Decisão</div><div class="qw-flow-node-sub">' + esc(step.texto || 'Escolha uma opção') + '</div></div>';
      var options = step.opcoes || [];
      if (options.length) {
        html += '<div class="qw-flow-arrow">⇢</div><div class="qw-flow-branches">';
        options.forEach(function(option, optionIndex){
          html += '<div class="qw-flow-branch-wrap"><div class="qw-flow-node branch"><div class="qw-flow-node-title">Opção ' + (optionIndex + 1) + '</div><div class="qw-flow-node-main">' + esc(option.label || 'Sem nome') + '</div><div class="qw-flow-node-sub">→ ' + esc(flowActionName(option)) + '<br>' + esc(flowActionDetail(option)) + '</div></div></div>';
        });
        html += '</div>';
      }
    });
    html += '</div><div class="qw-flow-channel-note"><strong>Entrega no WhatsApp atual:</strong> as ramificações já funcionam no ERP, mas enquanto este canal não oferecer botões/listas interativas estáveis, o cliente recebe as opções numeradas e responde 1, 2, 3... Quando conectarmos um canal com menus nativos, a mesma estrutura de fluxo poderá ser usada sem refazer os blocos.</div>';
    map.innerHTML = html;
  }

  function renderBuilder() {
    var builder = document.getElementById('builder');
    if (!builder) return;

    if (!steps.length) {
      builder.innerHTML = '';
      renderFlowMap();
      return;
    }

    builder.innerHTML = steps.map(function (step, index) {
      var body = '';

      if (step.tipo === 'texto') {
