    box.innerHTML=items.map(function(item){
      var status=item.status==='enviado'?'Enviado':item.status==='cancelado'?'Cancelado':item.status==='erro'?'Erro':'Pendente';
      if(item.status==='pendente'&&Number(item.attempts||0)>0) status+=' · tentativa '+Number(item.attempts||0)+'/3';
      if(item.status==='pendente'&&item.nextAttemptAt) status+=' · nova tentativa '+formatInboxScheduleDate(item.nextAttemptAt);
      var main=item.text?String(item.text).slice(0,90):(item.fileName||(item.type==='audio'?'Áudio agendado':item.type==='video'?'Vídeo agendado':'Imagem agendada'));
      var icon=item.type==='video'?'🎬 ':item.type==='image'?'🖼️ ':item.type==='audio'?'🎙️ ':'💬 ';
