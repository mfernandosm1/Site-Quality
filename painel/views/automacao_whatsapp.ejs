  async function loadInboxRemoteMedia(button,url,kind,name,options){
    var box=button && button.closest('[data-remote-media]');
    if(!box || button.disabled) return false;
    options=options||{};
    button.disabled=true;
    var original=button.textContent;
    button.textContent=options.automatic?'Sincronizando...':'Recuperando...';
    try{
      var response=await fetch(url,{cache:'no-store'});
      if(!response.ok){
        var text=await response.text();
        throw new Error((text.match(/<p>(.*?)<\/p>/s)||[])[1]?.replace(/<[^>]+>/g,'') || 'Não foi possível recuperar esta mídia.');
      }
      var blob=await response.blob();
      if(!blob.size) throw new Error('O WhatsApp retornou um arquivo vazio.');
      var objectUrl=URL.createObjectURL(blob);
      var viewer=null;
      if(kind==='audio'){ viewer=document.createElement('audio'); viewer.controls=true; viewer.preload='metadata'; viewer.src=objectUrl; }
      else if(kind==='video'){ viewer=document.createElement('video'); viewer.controls=true; viewer.preload='metadata'; viewer.src=objectUrl; }
      else if(kind==='image'||kind==='sticker'){ viewer=document.createElement('img'); viewer.src=objectUrl; viewer.alt=kind==='sticker'?'Figurinha':(name||'Imagem'); viewer.loading='eager'; }
      if(viewer){
        var oldViewer=box.querySelector('audio,video,img,.qw-inbox-document');
        if(oldViewer) oldViewer.replaceWith(viewer); else box.prepend(viewer);
      }
      var note=box.querySelector('.qw-remote-media-note');
      if(note){ note.textContent='✓ Recuperada e salva localmente'; note.style.color=''; }
      button.textContent='Carregada';
      button.dataset.recovered='1';
      return true;
    }catch(error){
      button.disabled=false;
      button.textContent=original;
      var note=box.querySelector('.qw-remote-media-note');
      if(note){ note.textContent=error.message||'Falha ao recuperar a mídia.'; note.style.color='#b91c1c'; }
      return false;
    }
  }

