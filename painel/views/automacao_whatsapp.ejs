    return '<select class="qw-select" onchange="selectOptionLibraryMedia(' + stepIndex + ',' + optionIndex + ',this.value)"><option value="">Selecionar da biblioteca...</option>' + options.map(function(m){ return '<option value="' + esc(m.id) + '"' + (m.id === selectedId ? ' selected' : '') + '>' + esc(m.nome) + '</option>'; }).join('') + '</select>';
  }

  function selectOptionLibraryMedia(stepIndex, optionIndex, mediaId) {
    var media = midiasSalvas.find(function(m){ return m.id === mediaId; });
    var option = steps[stepIndex] && steps[stepIndex].opcoes && steps[stepIndex].opcoes[optionIndex];
    if (!media || !option) return;
    option.mediaId = media.id;
    option.caminho = media.caminho;
    option.acaoTipo = media.tipo;
