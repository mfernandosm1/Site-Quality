  .qw-operational .qw-actions{gap:6px;flex-wrap:nowrap}
  .qw-operational .qw-header-action{width:36px;height:34px;padding:0;border-radius:10px}
  .qw-operational .qw-action-icon{font-size:17px;line-height:1}
