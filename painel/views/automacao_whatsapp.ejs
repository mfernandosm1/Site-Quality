      return '<div class="qw-option-action"><div class="qw-muted" style="font-size:11px">Ao clicar, o fluxo termina sem enviar outra mensagem.</div></div>';
    }
    if (['imagem','audio','video','arquivo'].indexOf(kind) >= 0) {
      var accept = kind === 'imagem' ? 'image/*' : kind === 'audio' ? 'audio/*' : kind === 'video' ? 'video/mp4,video/webm,video/quicktime' : '.pdf,.txt,.doc,.docx,.xls,.xlsx,.zip';
      return '<div class="qw-option-action"><div class="qw-option-branch-label">Depois do clique</div><div class="qw-option-action-grid"><label class="qw-mini-btn" style="display:inline-flex;justify-content:center">Fazer upload<input type="file" accept="' + accept + '" hidden onchange="uploadOptionMedia(' + stepIndex + ',' + optionIndex + ',this)"></label>' + optionMediaLibrarySelect(stepIndex, optionIndex, kind, option.mediaId || '') + '</div>' + (option.caminho ? '<div class="qw-compact-path" style="margin-top:7px">' + esc(option.caminho) + '</div>' : '') + '<div style="margin-top:7px"><input class="qw-input" placeholder="Legenda/observação opcional" value="' + esc(option.legenda || '') + '" oninput="updateOption(' + stepIndex + ',' + optionIndex + ',\'legenda\',this.value)"></div></div>';
    }
    return '';
