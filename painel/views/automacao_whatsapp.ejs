  function normalizeKeywordAutomationText(value){
    return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^\p{L}\p{N}\s]/gu,' ').replace(/\s+/g,' ').trim();
  }
  function keywordRuleMatchedTerm(rule,text){
    var normalized=normalizeKeywordAutomationText(text);if(!normalized)return '';
    return (rule.palavras||[]).find(function(raw){
      var keyword=normalizeKeywordAutomationText(raw);if(!keyword)return false;
      if(rule.modo==='igual')return normalized===keyword;
      if(rule.modo==='comeca')return normalized===keyword||normalized.indexOf(keyword+' ')===0;
      return normalized.indexOf(keyword)>=0;
    })||'';
  }
  function keywordRuleMatchesClient(rule,text){ return !!keywordRuleMatchedTerm(rule,text); }
  function simulateKeywordTrigger(){
    var input=document.getElementById('keywordSimulatorInput'),result=document.getElementById('keywordSimulatorResult');if(!input||!result)return;
    var text=String(input.value||'').trim();
    if(!text){result.classList.remove('match');result.textContent='Digite uma mensagem para testar.';return;}
    var ruleIndex=(keywordRulesSalvas||[]).findIndex(function(item){return item.ativo&&item.blocoId&&keywordRuleMatchesClient(item,text);});
    if(ruleIndex<0){result.classList.remove('match');result.innerHTML='Nenhuma automação <strong>ativa</strong> corresponde a esta mensagem. Nada seria disparado.';return;}
    var rule=keywordRulesSalvas[ruleIndex],term=keywordRuleMatchedTerm(rule,text);
    var block=(blocosSalvos||[]).find(function(item){return item.id===rule.blocoId;});
    result.classList.add('match');
    result.innerHTML='⚡ Regra <strong>#'+(ruleIndex+1)+' · '+esc(rule.nome)+'</strong> ganharia a prioridade.<br><small>Correspondência: “'+esc(term)+'” → bloco: <strong>'+esc(block?block.nome:'não encontrado')+'</strong>. Nenhuma mensagem foi enviada.</small>';
  }
  function filterKeywordAutomationList(){
    var search=normalizeKeywordAutomationText(document.getElementById('keywordAutomationSearch')?.value||'');
    var state=document.getElementById('keywordAutomationState')?.value||'',visible=0;
    document.querySelectorAll('[data-keyword-row]').forEach(function(row){
      var hay=normalizeKeywordAutomationText(row.dataset.search||'');
      var show=(!search||hay.indexOf(search)>=0)&&(!state||row.dataset.state===state);
      row.hidden=!show;if(show)visible++;
    });
    var empty=document.getElementById('keywordAutomationEmptySearch');if(empty)empty.hidden=visible!==0||!(keywordRulesSalvas||[]).length;
  }

  function syncKeywordDraftState(){
    var select=document.getElementById('keywordBlockSelect');
    var active=document.getElementById('keywordActiveCheckbox');
    var warning=document.getElementById('keywordNoBlockWarning');
    if(!select||!active)return;
    var hasBlock=!!String(select.value||'').trim();
    if(warning)warning.style.display=hasBlock?'none':'block';
    active.disabled=!hasBlock;
    if(!hasBlock)active.checked=false;
    active.closest('.qw-check')?.classList.toggle('qw-muted',!hasBlock);
  }

  var keywordBlocksRevision='';
  async function refreshKeywordBlocks(force){
    var select=document.getElementById('keywordBlockSelect');
    if(!select)return;
    try{
      var response=await fetch('/automacao-whatsapp/blocos/listar?_='+Date.now(),{cache:'no-store'});
      var payload=await response.json();
      if(!response.ok||!payload.success||!Array.isArray(payload.items))return;
      var revision=payload.items.map(function(b){return [b.id,b.nome,b.ativo,b.atualizadoEm].join('|');}).join('§');
      if(!force&&revision===keywordBlocksRevision)return;
      keywordBlocksRevision=revision;
      var selected=String(select.value||'');
      var html='<option value="">Nenhum bloco por enquanto</option>';
      payload.items.forEach(function(b){
        html+='<option value="'+esc(b.id)+'">'+esc(b.nome)+(b.ativo?'':' · inativo')+'</option>';
      });
      select.innerHTML=html;
      if(payload.items.some(function(b){return String(b.id)===selected;}))select.value=selected;
      else select.value='';
      // Nesta aba o simulador só precisa da identificação atual dos blocos.
      blocosSalvos=payload.items.map(function(b){return Object.assign({},b);});
      syncKeywordDraftState();
    }catch(error){ /* Mantém a lista atual caso a atualização em segundo plano falhe. */ }
  }

  if(document.getElementById('keywordBlockSelect')){
    syncKeywordDraftState();
    refreshKeywordBlocks(true);
    setInterval(function(){ if(!document.hidden)refreshKeywordBlocks(false); },5000);
    window.addEventListener('focus',function(){refreshKeywordBlocks(false);});
    document.addEventListener('visibilitychange',function(){if(!document.hidden)refreshKeywordBlocks(false);});
