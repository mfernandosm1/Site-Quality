  function stabilizeInboxAudioPreview(preview,fallbackSeconds){
    if(!preview)return;
    var fallback=Math.max(0.1,Number(fallbackSeconds)||0);
    var repair=function(){
      var duration=Number(preview.duration);
      if(Number.isFinite(duration)&&duration>0.25)return;
      try{
        var restore=function(){
          preview.removeEventListener('timeupdate',restore);
          try{preview.currentTime=0;}catch(_){}
        };
        preview.addEventListener('timeupdate',restore);
        preview.currentTime=1e101;
      }catch(_){}
    };
    preview.addEventListener('loadedmetadata',repair,{once:true});
    preview.addEventListener('durationchange',function(){
      var duration=Number(preview.duration);
      if((!Number.isFinite(duration)||duration<=0.25)&&fallback>0){
        preview.dataset.recordedDuration=String(fallback);
      }
    },{once:true});
    window.setTimeout(repair,120);
  }
  async function startInboxScheduleRecording(){
    if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){showInboxSendResult('Este navegador não permite gravação de áudio.',false);return;}
    try{
      clearInboxScheduleRecording();
      var stream=await navigator.mediaDevices.getUserMedia({audio:true});
      var preferred=['audio/ogg;codecs=opus','audio/webm;codecs=opus','audio/webm'];
      var mime=preferred.find(function(type){return window.MediaRecorder&&MediaRecorder.isTypeSupported&&MediaRecorder.isTypeSupported(type);})||'';
      inboxScheduleRecordedChunks=[];
      inboxScheduleRecorder=new MediaRecorder(stream,mime?{mimeType:mime}:undefined);
      var recorder=inboxScheduleRecorder;
      recorder.ondataavailable=function(event){if(event.data&&event.data.size)inboxScheduleRecordedChunks.push(event.data);};
      recorder.onstop=async function(){
        inboxScheduleRecordingProcessing=true;
        if(!inboxScheduleRecordedDurationSeconds&&inboxScheduleRecordingStartedAt){
          var ended=(window.performance&&performance.now)?performance.now():Date.now();
          inboxScheduleRecordedDurationSeconds=Math.max(0.1,(ended-inboxScheduleRecordingStartedAt)/1000);
        }
        var type=String(recorder.mimeType||'audio/webm').toLowerCase();
        inboxScheduleRecordedBlob=new Blob(inboxScheduleRecordedChunks,{type:type});
        var baseType=type.split(';')[0], extension=baseType.indexOf('ogg')>=0?'.ogg':baseType.indexOf('mp4')>=0?'.m4a':'.webm';
        inboxScheduleRecordedFileName='audio-agendado-'+Date.now()+extension;
        var status=document.getElementById('inboxScheduleRecordingStatus');if(status)status.textContent='Preparando áudio...';
        if(inboxScheduleRecordedUrl)URL.revokeObjectURL(inboxScheduleRecordedUrl);
        inboxScheduleRecordedUrl=URL.createObjectURL(inboxScheduleRecordedBlob);
        var preview=document.getElementById('inboxScheduleAudioPreview');if(preview){preview.src=inboxScheduleRecordedUrl;preview.hidden=false;preview.load();stabilizeInboxAudioPreview(preview,inboxScheduleRecordedDurationSeconds);}
        status=document.getElementById('inboxScheduleRecordingStatus');if(status)status.textContent='✓ Áudio pronto para agendar · '+formatInboxRecordedDuration(inboxScheduleRecordedDurationSeconds)+' · '+Math.max(1,Math.round(inboxScheduleRecordedBlob.size/1024))+' KB';
        var clear=document.getElementById('inboxScheduleClearAudioBtn');if(clear)clear.hidden=false;
        stream.getTracks().forEach(function(track){track.stop();});
        inboxScheduleRecordingProcessing=false;
      };
      inboxScheduleRecordingStartedAt=(window.performance&&performance.now)?performance.now():Date.now();
      inboxScheduleRecordedDurationSeconds=0;
      inboxScheduleRecorder.start(250);
      var start=document.getElementById('inboxScheduleRecordBtn'),stop=document.getElementById('inboxScheduleStopBtn'),status=document.getElementById('inboxScheduleRecordingStatus');
      if(start)start.disabled=true;if(stop)stop.disabled=false;if(status)status.textContent='🔴 Gravando... clique em Parar quando terminar.';
    }catch(error){showInboxSendResult(error.message||'Não foi possível acessar o microfone.',false);}
  }
  function stopInboxScheduleRecording(){
    if(inboxScheduleRecorder&&inboxScheduleRecorder.state!=='inactive'){
      if(inboxScheduleRecordingStartedAt){var ended=(window.performance&&performance.now)?performance.now():Date.now();inboxScheduleRecordedDurationSeconds=Math.max(0.1,(ended-inboxScheduleRecordingStartedAt)/1000);}
      inboxScheduleRecorder.stop();
