  function renderOptionAction(stepIndex, optionIndex, option) {
    var kind = option.acaoTipo || (option.proximoBloco ? 'bloco' : 'encerrar');
    if (kind === 'texto') {
      return '<div class="qw-option-action"><div class="qw-option-branch-label">Depois do clique</div><textarea class="qw-textarea" style="min-height:72px" placeholder="Texto que será enviado" oninput="updateOption(' + stepIndex + ',' + optionIndex + ',\'texto\',this.value)">' + esc(option.texto || '') + '</textarea></div>';
    }
    if (kind === 'bloco') {
