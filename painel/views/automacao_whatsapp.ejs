  async function recoverVisibleInboxMedia(){
    var selectedConversationType=getCurrentInboxConversationType();
    // Em grupos, mídia é 100% sob demanda para não pesar abertura/sincronização.
    if(selectedConversationType==='group') return;
    var buttons=Array.from(document.querySelectorAll('[data-remote-media] .qw-media-action[data-url]')).slice(0,40);
    for(var i=0;i<buttons.length;i+=1){
      var button=buttons[i];
      if(button.dataset.recovered==='1') continue;
      await loadInboxRemoteMedia(button,button.dataset.url,button.dataset.kind,button.dataset.name,{automatic:true});
      await new Promise(function(resolve){setTimeout(resolve,250);});
    }
  }
