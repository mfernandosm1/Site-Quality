          '</div>';
        }).join('');

        body =
          '<div class="qw-step-grid">' +
            '<div><label>Tipo</label>' + typeSelect(index, step.tipo) + '</div>' +
            '<div><label>Pergunta/menu</label><input class="qw-input" value="' + esc(step.texto || '') + '" oninput="updateStep(' + index + ',\'texto\',this.value)"></div>' +
            '<div><label>Opções</label><button class="qw-mini-btn" type="button" onclick="addOption(' + index + ')">+ Adicionar</button></div>' +
          '</div>' +
          '<div class="qw-flow-choice-note"><span>↳</span><div>Cada opção cria uma ramificação real do fluxo. O destino pode ser texto, imagem, áudio, vídeo, arquivo, outro bloco ou encerramento.</div></div>' +
          '<div class="qw-options-box">' + options + '</div>' +
          '<div class="qw-field qw-invalid-response-field"><label>Resposta não reconhecida <span class="qw-info-tip" tabindex="0" aria-label="Mensagem para resposta inválida">i<span class="qw-info-tip-text">Mensagem automática enviada quando o cliente responde algo que não corresponde a nenhuma opção. O fluxo continua aguardando uma escolha válida. Deixe vazio se não quiser responder automaticamente.</span></span></label><textarea class="qw-textarea" rows="2" placeholder="Ex: Não entendi sua resposta. Escolha uma das opções acima." oninput="updateStep(' + index + ',\'mensagemInvalida\',this.value)">' + esc(step.mensagemInvalida == null ? 'Não entendi sua resposta. Por favor, escolha uma das opções informadas acima.' : step.mensagemInvalida) + '</textarea></div>' +
          '<div class="qw-step-grid" style="margin-top:8px">' +
            '<div><label>Tempo sem resposta (min) <span class="qw-info-tip" tabindex="0" aria-label="Tempo limite do fluxo">i<span class="qw-info-tip-text">Tempo máximo que o fluxo ficará aguardando uma opção. Ao atingir o limite, a espera é finalizada. Use 0 para não aplicar tempo limite.</span></span></label><input class="qw-input" type="number" min="0" max="10080" value="' + esc(step.tempoLimiteMinutos == null ? 30 : step.tempoLimiteMinutos) + '" oninput="updateStep(' + index + ',\'tempoLimiteMinutos\',this.value)"></div>' +
            '<div style="display:flex;align-items:end;padding-bottom:7px"><label style="display:flex;gap:7px;align-items:center;cursor:pointer"><input type="checkbox" ' + (step.encerrarAoExpirar === false ? '' : 'checked') + ' onchange="updateStep(' + index + ',\'encerrarAoExpirar\',this.checked)"> Encerrar atendimento ao expirar</label></div>' +
          '</div>' +
          '<div class="qw-field" style="margin-top:8px"><label>Mensagem ao expirar <span class="qw-info-tip" tabindex="0" aria-label="Mensagem ao atingir tempo limite">i<span class="qw-info-tip-text">Mensagem enviada uma única vez quando o cliente não responde dentro do tempo configurado. Depois disso o fluxo deixa de aguardar respostas.</span></span></label><textarea class="qw-textarea" rows="2" placeholder="Ex: Atendimento encerrado por falta de resposta. Quando precisar, pode chamar novamente." oninput="updateStep(' + index + ',\'mensagemExpirada\',this.value)">' + esc(step.mensagemExpirada == null ? 'Este atendimento foi encerrado automaticamente por falta de resposta. Quando precisar, é só chamar novamente.' : step.mensagemExpirada) + '</textarea></div>';
      }

      var isOpen = !!openSteps[index];
      return '<div class="qw-step ' + (isOpen ? 'open' : '') + '">' +
        '<div class="qw-step-head">' +
          '<div class="qw-step-summary" onclick="toggleStep(' + index + ')">' +
            '<button class="qw-toggle" type="button">' + (isOpen ? '▾' : '▸') + '</button>' +
            '<div><div class="qw-step-title"><span class="qw-step-number">' + (index + 1) + '</span>' + esc(step.tipo) + '</div>' +
            '<div class="qw-step-summary-text">' + esc(stepSummary(step)) + '</div></div>' +
          '</div>' +
          '<div class="qw-step-actions">' +
            '<button class="qw-mini-btn gold" type="button" onclick="event.stopPropagation();simulateStep(' + index + ')">▶</button>' + '<button class="qw-mini-btn blue" type="button" onclick="event.stopPropagation();duplicateStep(' + index + ')">⧉</button>' + '<button class="qw-mini-btn" type="button" onclick="event.stopPropagation();moveStep(' + index + ',-1)">↑</button>' +
            '<button class="qw-mini-btn" type="button" onclick="event.stopPropagation();moveStep(' + index + ',1)">↓</button>' +
            '<button class="qw-mini-btn danger" type="button" onclick="event.stopPropagation();removeStep(' + index + ')">Remover</button>' +
          '</div>' +
        '</div>' +
        '<div class="qw-step-body">' + body + '</div>' +
      '</div>';
    }).join('');
    renderFlowMap();
  }

  function duplicateStep(index) {
    if (!steps[index]) return;
    var copy = JSON.parse(JSON.stringify(steps[index]));
    copy.id = uid();
    steps.splice(index + 1, 0, copy);
    openSteps[index + 1] = true;
    markUnsaved();
    renderBuilder();
  }

  function simulateStep(index) {
    if (!steps[index]) return;
    runVisualSimulation([steps[index]], 'preview', 'quickStatus');
  }

  function filterBlockCards() {
    var query = String((document.getElementById('blockSearch') || {}).value || '').toLowerCase().trim();
    var category = String((document.getElementById('blockCategory') || {}).value || '').toLowerCase();
    var favorites = !!((document.getElementById('onlyFavorites') || {}).checked);
    document.querySelectorAll('.qw-block-card').forEach(function(card){
      var ok = (!query || card.dataset.search.indexOf(query) >= 0) && (!category || card.dataset.category === category) && (!favorites || card.dataset.favorite === '1');
      card.style.display = ok ? '' : 'none';
    });
  }


  function toggleMediaGroup(button) {
    var group = button && button.closest ? button.closest('.qw-media-group') : null;
    if (group) group.classList.toggle('open');
  }

  function filterMediaCards() {
    var query = String((document.getElementById('mediaSearch') || {}).value || '').toLowerCase().trim();
    var type = String((document.getElementById('mediaType') || {}).value || '').toLowerCase();
    var anyVisible = false;

    document.querySelectorAll('.qw-media-group').forEach(function(group) {
      var groupName = String(group.dataset.groupName || '');
      var visibleInside = 0;

      group.querySelectorAll('.qw-media-card').forEach(function(card) {
        var searchText = String(card.dataset.mediaSearch || '');
        var cardType = String(card.dataset.mediaType || '');
        var matchesQuery = !query || searchText.indexOf(query) >= 0 || groupName.indexOf(query) >= 0;
        var matchesType = !type || cardType === type;
        var visible = matchesQuery && matchesType;
        card.style.display = visible ? '' : 'none';
        if (visible) visibleInside += 1;
      });

      group.hidden = visibleInside === 0;
      if (visibleInside > 0) {
        anyVisible = true;
        if (query || type) group.classList.add('open');
      }
    });

    var empty = document.getElementById('mediaFilterEmpty');
    if (empty) empty.classList.toggle('show', !anyVisible);
  }

  function simulateLibraryBlock(id) {
    var block = blocosSalvos.find(function(item){ return item.id === id; });
    if (!block) return;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    runVisualSimulation(block.etapas || [], 'preview', 'quickStatus');
  }

  function markUnsaved() {
    var alertBox = document.getElementById('unsavedAlert');
    if (alertBox) alertBox.classList.add('show');
  }

  function prepareSteps() {
    var hidden = document.getElementById('etapasJson');
    if (!hidden) return false;

    if (!steps.length) {
      alert('Adicione pelo menos uma etapa antes de salvar o bloco.');
      return false;
    }

    hidden.value = JSON.stringify(steps);
    return true;
  }

  var simulationRun = 0;

  function sleep(ms, runId) {
    return new Promise(function (resolve) {
      var started = Date.now();
      function tick() {
        if (runId !== simulationRun) return resolve(false);
        if (Date.now() - started >= ms) return resolve(true);
        setTimeout(tick, 100);
      }
      tick();
    });
  }

  function nowTime() {
    return new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }

  function addChatNode(container, className, html) {
    var node = document.createElement('div');
    node.className = className;
    node.innerHTML = html;
    container.appendChild(node);
    container.scrollTop = container.scrollHeight;
    return node;
  }

  function clearSimulation(previewId, statusId) {
    simulationRun += 1;
    var preview = document.getElementById(previewId);
    var status = document.getElementById(statusId);
    if (preview) preview.innerHTML = '<div class="qw-wait">Simulador limpo</div>';
    if (status) status.textContent = 'simulador pronto';
  }

  function stopSimulation() {
    simulationRun += 1;
    var statusQuick = document.getElementById('quickStatus');
    var statusSaved = document.getElementById('savedStatus');
    if (statusQuick) statusQuick.textContent = 'simulação interrompida';
    if (statusSaved) statusSaved.textContent = 'simulação interrompida';
  }

  function typingHtml(label) {
    return esc(label) + '<span class="qw-dots"><span></span><span></span><span></span></span>';
  }

  async function runVisualSimulation(items, previewId, statusId) {
    simulationRun += 1;
    var runId = simulationRun;
    var preview = document.getElementById(previewId);
    var status = document.getElementById(statusId);

    if (!preview) return;

    preview.innerHTML = '';
    if (status) status.textContent = 'executando fluxo...';

    if (!items || !items.length) {
      addChatNode(preview, 'qw-wait', 'Este bloco não possui etapas.');
      if (status) status.textContent = 'sem etapas';
      return;
    }

    for (var index = 0; index < items.length; index += 1) {
      if (runId !== simulationRun) return;
      var step = items[index] || {};

      if (step.tipo === 'texto') {
        var typingSeconds = Math.max(0, Number(step.digitandoSegundos || 0));
        var typing = addChatNode(preview, 'qw-typing', typingHtml('digitando'));
        if (status) status.textContent = 'digitando...';
        var continued = await sleep(typingSeconds * 1000, runId);
        if (!continued) return;
        typing.remove();
        addChatNode(
          preview,
          'qw-msg',
          esc(step.texto || '(texto vazio)') + '<small>' + nowTime() + ' ✓✓</small>'
        );
      }

      if (step.tipo === 'pausa') {
        var pauseSeconds = Math.max(0, Number(step.segundos || 0));
        var waitNode = addChatNode(preview, 'qw-wait', 'Aguardando ' + pauseSeconds + ' segundo(s)...');
        if (status) status.textContent = 'aguardando...';
        var pauseContinued = await sleep(pauseSeconds * 1000, runId);
        if (!pauseContinued) return;
        waitNode.remove();
      }

      if (step.tipo === 'imagem') {
        if (status) status.textContent = 'enviando imagem...';
        var imagePath = esc(step.caminho || '');
        var imageHtml = imagePath
          ? '<img src="' + imagePath + '" alt="Imagem do bloco" onerror="this.outerHTML=\'<div>Imagem não encontrada</div>\'">'
          : '<div>Imagem não selecionada</div>';
        if (step.legenda) imageHtml += '<div>' + esc(step.legenda) + '</div>';
        imageHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', imageHtml);
      }

      if (step.tipo === 'video') {
        if (status) status.textContent = 'enviando vídeo...';
        var videoPath = esc(step.caminho || '');
        var videoHtml = videoPath
          ? '<video controls preload="metadata" style="display:block;max-width:100%;max-height:340px;border-radius:9px;margin-bottom:6px" src="' + videoPath + '"></video>'
          : '<div>Vídeo não selecionado</div>';
        if (step.legenda) videoHtml += '<div>' + esc(step.legenda) + '</div>';
        videoHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', videoHtml);
      }

      if (step.tipo === 'audio') {
        var recordingSeconds = Math.max(0, Number(step.gravandoSegundos || 0));
        var recording = addChatNode(preview, 'qw-typing', typingHtml('gravando áudio'));
        if (status) status.textContent = 'gravando áudio...';
        var audioContinued = await sleep(recordingSeconds * 1000, runId);
        if (!audioContinued) return;
        recording.remove();

        var audioPath = esc(step.caminho || '');
        var audioHtml = audioPath
          ? '<audio controls preload="metadata" src="' + audioPath + '"></audio>'
          : '<div>Áudio não selecionado</div>';
        if (step.legenda) audioHtml += '<div>' + esc(step.legenda) + '</div>';
        audioHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', audioHtml);
      }

      if (step.tipo === 'arquivo') {
        if (status) status.textContent = 'enviando arquivo...';
        var filePath = esc(step.caminho || '');
        var fileHtml = filePath
          ? '<a class="qw-file" href="' + filePath + '" target="_blank">📎 Abrir arquivo</a>'
          : '<div>Arquivo não selecionado</div>';
        if (step.legenda) fileHtml += '<div>' + esc(step.legenda) + '</div>';
        fileHtml += '<small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', fileHtml);
      }

      if (step.tipo === 'opcoes') {
        if (status) status.textContent = 'mostrando opções...';
        var optionsHtml = '<div>' + esc(step.texto || 'Escolha uma opção:') + '</div><div class="qw-options-preview">';
        (step.opcoes || []).forEach(function (option) {
          optionsHtml += '<div class="qw-option-preview">' + esc(option.label || option.resposta || 'Opção') + '</div>';
        });
        optionsHtml += '</div><small>' + nowTime() + ' ✓✓</small>';
        addChatNode(preview, 'qw-msg', optionsHtml);
      }

      await sleep(250, runId);
    }

    if (runId !== simulationRun) return;
    if (status) status.textContent = 'fluxo concluído';
    addChatNode(preview, 'qw-wait', 'Simulação concluída');
  }

  function simulateCurrent() {
    runVisualSimulation(steps, 'preview', 'quickStatus');
  }

  function simulateEmbeddedSelected() {
    var select = document.getElementById('embeddedSimulateSelect');
    if (!select || !select.value) return simulateCurrent();
    var selected = blocosSalvos.find(function(item){ return item.id === select.value; });
    runVisualSimulation(selected ? (selected.etapas || []) : [], 'preview', 'quickStatus');
  }

  var inboxToastTimer=null;
  function showInboxSendResult(message, ok){
    var box = document.getElementById('inboxSendResult');
    if(!box) return;
    if(inboxToastTimer) window.clearTimeout(inboxToastTimer);
    box.textContent = message || '';
    box.className = 'qw-inbox-send-result show ' + (ok ? 'ok' : 'bad');
    inboxToastTimer=window.setTimeout(function(){
      box.className='qw-inbox-send-result';
      box.textContent='';
    }, ok ? 1800 : 3800);
  }

  async function sendInboxText(event){
    event.preventDefault();
    var form = event.currentTarget;
    var textarea = document.getElementById('inboxMessageText');
    var text = String(textarea ? textarea.value : '').trim();
    if(!text){ showInboxSendResult('Digite uma mensagem antes de enviar.', false); return false; }

    // Experiência igual ao WhatsApp Web: libera o compositor imediatamente.
    // O envio continua em segundo plano e não bloqueia a próxima mensagem.
    var conversationId = form.elements.conversationId.value;
    if(textarea){ textarea.value = ''; textarea.focus(); }
    inboxComposerDirty = false;
    appendInboxOutgoingMessages([{type:'text',text:text}]);
    inboxPreventAutoReloadUntil = Date.now() + 6000;

    try {
      var response = await fetch('/automacao-whatsapp/inbox/enviar-texto', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ conversationId:conversationId, texto:text })
      });
      var payload = await response.json();
      if(!response.ok || !payload.success) throw new Error(payload.message || 'Falha no envio.');
      // Não aguarda sincronização para liberar/focar o campo. Apenas atualiza o marcador em background.
      syncInboxRevisionMarker().catch(function(){});
    } catch(error){
      showInboxSendResult(error.message || 'Falha ao enviar a mensagem.', false);
      // Se o usuário ainda não começou outra mensagem, devolve o texto para facilitar nova tentativa.
      if(textarea && !String(textarea.value||'').trim()){
        textarea.value = text;
        inboxComposerDirty = true;
        textarea.focus();
      }
    }
    return false;
  }

  async function sendInboxBlock(event){
    event.preventDefault();
    var form = event.currentTarget;
    var button = document.getElementById('inboxSendBlockBtn');
    var select = document.getElementById('inboxBlockSelect');
    var blocoId = select ? select.value : '';
    if(!blocoId){ showInboxSendResult('Selecione um bloco.', false); return false; }
    if(button) button.disabled = true;
    if(select) select.disabled = true;
    showInboxSendResult('Executando bloco. Aguarde a conclusão...', true);
    try {
      var response = await fetch('/automacao-whatsapp/inbox/executar-bloco', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ conversationId:form.elements.conversationId.value, blocoId:blocoId })
      });
      var payload = await response.json();
