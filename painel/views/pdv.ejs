 function finalizationData(){
  const items=state.items||[];
  if(!items.length)throw new Error('Adicione pelo menos um produto ou serviço antes de finalizar.');
  for(const item of items){
   const quantity=Number(item.quantity||0),unitPrice=Number(item.unitPrice||0),discount=Number(item.discount||0);
   if(quantity<=0)throw new Error(`Informe uma quantidade válida para ${item.name||'o item'}.`);
   if(unitPrice<=0)throw new Error(`O valor unitário de ${item.name||'um item'} deve ser maior que zero.`);
   if(discount<0)throw new Error(`O desconto de ${item.name||'um item'} não pode ser negativo.`);
   if((quantity*unitPrice)-discount<=0)throw new Error(`O subtotal de ${item.name||'um item'} deve ser de pelo menos R$ 0,01.`);
  }
  if(boot.cashboxSettings?.requireSeller===true&&!$('#sellerName').value.trim())throw new Error('Informe o vendedor antes de finalizar.');
  if(boot.cashboxSettings?.requireItemVerification===true&&items.some(item=>item.verified!==true))throw new Error('Confira e marque todos os produtos como verificados antes de finalizar.');
  const subtotal=items.reduce((sum,item)=>sum+Number(item.quantity||0)*Number(item.unitPrice||0),0);
  const itemDiscounts=items.reduce((sum,item)=>sum+Number(item.discount||0),0);
  const discounts=itemDiscounts+couponDiscount(Math.max(0,subtotal-itemDiscounts));
  const total=Math.round((Math.max(0,subtotal-discounts)+freightAdditionalTotal())*100)/100;
  if(total<0.01)throw new Error('O total da operação deve ser de pelo menos R$ 0,01.');
  const paymentRows=[...document.querySelectorAll('.pdv-payment-row')];
  const invalidPayment=paymentRows.find(r=>Number(r.querySelector('.pay-amount').value||0)>0&&!r.querySelector('.pay-method').value);
  if(invalidPayment){invalidPayment.querySelector('.pay-method').focus();throw new Error('Selecione a forma de pagamento antes de finalizar.');}
  const payments=collectPayments();
  const unconfiguredRows=paymentRows.filter(r=>{const method=paymentMethodById.get(r.querySelector('.pay-method').value)||{};return Number(r.querySelector('.pay-amount').value||0)>0&&method.generatesReceivable===true&&r.dataset.installmentsConfigured!=='true';});
  if(unconfiguredRows.length){const proceed=confirm('As datas e valores das parcelas ainda não foram configurados. Deseja finalizar usando divisão igual e vencimentos automáticos mensais?');if(!proceed){openInstallmentModal(unconfiguredRows[0]);throw new Error('Finalize a configuração das parcelas antes de continuar.');}unconfiguredRows.forEach(r=>{const count=Math.max(1,Number(r.querySelector('.pay-installments').value||1));r.dataset.dueDates=JSON.stringify(buildDueDates(r));r.dataset.installmentAmounts=JSON.stringify(equalInstallmentAmounts(Number(r.querySelector('.pay-amount').value||0),count));r.dataset.installmentsConfigured='true';});}
  const normalizedPayments=collectPayments();payments.splice(0,payments.length,...normalizedPayments);
  if(!payments.length)throw new Error('Informe o pagamento integral antes de finalizar.');
  const paid=Math.round(payments.reduce((sum,p)=>sum+Number(p.amount||0),0)*100)/100;
  const pending=Math.round((total-paid)*100)/100;
  if(pending>0)throw new Error(`Ainda faltam ${money(pending)} para concluir a operação.`);
  const change=Math.max(0,Math.round((paid-total)*100)/100);
  const cashPaid=Math.round(payments.filter(p=>isCashPayment(p.methodId)).reduce((sum,p)=>sum+Number(p.amount||0),0)*100)/100;
  if(change>cashPaid)throw new Error('Somente pagamentos em dinheiro podem ultrapassar o total e gerar troco.');
