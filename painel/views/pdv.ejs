   // o usuário retorna diretamente para a seleção de modelos.
   showOnly('#modalPrint');
   if($('#printPreview').checked){
    const closePreview=()=>{try{if(!w.closed)w.close();}catch(_){}};
    w.addEventListener?.('afterprint',closePreview,{once:true});
    setTimeout(()=>{try{w.focus();w.print();}catch(_){}},300);
   }else{w.focus();}
  }catch(e){
