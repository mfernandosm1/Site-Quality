<script>window.PDV_BOOT=<%- JSON.stringify({products,customers,customerFieldSettings,operations,emptyOpenSale,current,currentReceivables,openSession,cashState,paymentMethods,coupons,selectedCashboxId,selectedCustomerId,cashboxSettings,erpUsers,sellerUsers,technicianUsers,loggedUserName,automaticSeller,canDiscount,canApproveDiscount,discountLimitPercent,operationStatuses,printSettings,printModels,printOnly,printReturnUrl}) %>;</script>
<script src="/public/js/erp-print-renderer.js"></script>
<script>
(()=>{
 const boot=window.PDV_BOOT, money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}), $=s=>document.querySelector(s);
 const normalizeUserName=value=>String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
 const userIdForName=(name,kind='seller')=>{const wanted=normalizeUserName(name);if(!wanted)return '';const list=kind==='technician'?(boot.technicianUsers||[]):(boot.sellerUsers||[]);return String((list.find(user=>[user.displayName,user.name,user.username].some(value=>normalizeUserName(value)===wanted))||{}).id||'');};
 const sellerOptionsHtml=(selected='')=>{const chosen=String(selected||'').trim();const rows=['<option value="">—</option>'];const seen=new Set();for(const user of (boot.sellerUsers||[])){const value=String(user.displayName||user.name||'').trim();if(!value||seen.has(normalizeUserName(value)))continue;seen.add(normalizeUserName(value));const label=value!==String(user.name||'').trim()?`${value} · ${user.name}`:value;rows.push(`<option value="${esc(value)}" ${normalizeUserName(value)===normalizeUserName(chosen)?'selected':''}>${esc(label)}</option>`);}for(const valueRaw of [...(boot.cashboxSettings?.allowedSellers||[]),chosen]){const value=String(valueRaw||'').trim();if(!value||seen.has(normalizeUserName(value)))continue;seen.add(normalizeUserName(value));rows.push(`<option value="${esc(value)}" ${normalizeUserName(value)===normalizeUserName(chosen)?'selected':''}>${esc(value)} · histórico</option>`);}return rows.join('');};
 let state={id:boot.current?.id||'',number:boot.current?.number||null,version:Number(boot.current?.version||0),type:boot.current?.type||boot.cashboxSettings?.defaultOperationType||'sale',items:boot.current?.items||[],payments:boot.current?.payments||[],coupon:boot.current?.coupon||null,freight:{payer:boot.current?.freight?.payer||'none',carrierId:boot.current?.freight?.carrierId||'',carrierName:boot.current?.freight?.carrierName||'',freightAmount:Number(boot.current?.freight?.freightAmount||0),insuranceAmount:Number(boot.current?.freight?.insuranceAmount||0),otherExpensesAmount:Number(boot.current?.freight?.otherExpensesAmount||0),volumeQuantity:Number(boot.current?.freight?.volumeQuantity||0),species:boot.current?.freight?.species||'',brand:boot.current?.freight?.brand||'',netWeight:Number(boot.current?.freight?.netWeight||0),grossWeight:Number(boot.current?.freight?.grossWeight||0)},unlockPatterns:[...(boot.current?.serviceOrder?.unlockPatterns||[])].map(pattern=>[...(pattern||[])]).slice(0,2)}; if(!state.unlockPatterns.length&&boot.current?.serviceOrder?.unlockPattern?.length)state.unlockPatterns=[[...boot.current.serviceOrder.unlockPattern],[]]; while(state.unlockPatterns.length<2)state.unlockPatterns.push([]);
 const checkinItems=['Tela / display','Carcaça / estrutura','Botões','Conectores','Câmeras','Áudio','Sinais de oxidação','Liga / inicializa'];
 const checkoutItems=['Liga / desliga','Tela / display','Touch / teclado','Botões','Carregamento / fonte','Bateria','Câmeras / scanner','Áudio / microfone','Wi-Fi / rede','Bluetooth','USB / conectores','Impressão / alimentação de papel','HDMI / vídeo'];
 let productByName=new Map();
 let productByKey=new Map();
 let productCatalogRefreshedAt=Date.now();
 let productCatalogRefreshPromise=null;
 const productCatalogKey=p=>String(p?.id||p?.selectionId||`${p?.productId||''}:${p?.inventoryItemId||''}`);
 function rebuildProductIndex(){
   productByName=new Map((boot.products||[]).map(p=>[String(p.name||'').toLowerCase(),p]));
   productByKey=new Map((boot.products||[]).map(p=>[productCatalogKey(p),p]));
 }
 function selectedProductFromInput(input=$('#productSearch')){
   const selectedKey=String(input?.dataset?.selectedProductKey||'');
   if(selectedKey&&productByKey.has(selectedKey))return productByKey.get(selectedKey);
   return productByName.get(String(input?.value||'').trim().toLowerCase())||null;
 }
 function selectProductInInput(product,input=$('#productSearch')){
   if(!input||!product)return;
   input.value=product.name||'';
