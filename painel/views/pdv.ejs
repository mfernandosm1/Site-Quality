<% layout('layout') -%>
<div class="pdv-shell" data-current-id="<%= current?.id || '' %>">
  <header class="pdv-head pdv-head-compact">
    <div class="pdv-title-line"><h1>PDV</h1><span class="pdv-version">v0.14.7</span></div>
    <section class="pdv-cashbar pdv-cashbar-inline">
      <div><b>Caixa:</b><select id="cashbox"><% cashboxes.forEach(c=>{ %><option value="<%= c.id %>" <%= selectedCashboxId===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
      <div id="cashStatus" class="pdv-cash-status <%= openSession?'open':'closed' %>"><%= openSession?'● Aberto':'● Fechado' %></div>
      <div><b id="cashBalanceLabel"><%= openSession ? 'Saldo' : 'Saldo anterior' %></b><strong id="cashBalance">R$ <%= Number(cashBalance||0).toLocaleString('pt-BR',{minimumFractionDigits:2}) %></strong></div>
      <button class="btn" id="btnCash"><%= openSession?'Movimentações':'Abrir caixa' %></button>
    </section>
    <div class="pdv-head-actions">
      <button class="btn" id="btnOperations">🔎 Buscar operações <kbd>Ctrl+A</kbd></button>
      <button class="btn" id="btnShortcuts">⌨️ Atalhos <kbd>F1</kbd></button>
      <button class="btn primary" id="btnNew">＋ Nova operação</button>
    </div>
  </header>

  <section class="pdv-workspace">
    <div class="pdv-main">
      <div class="pdv-operation-top">
        <div class="pdv-type-switch"><button data-type="sale" class="active">🛒 Venda</button><button data-type="service_order">🛠️ O.S.</button></div>
        <span id="operationNumber" class="pdv-operation-number"><%= current ? '#'+current.number : 'Nova operação' %></span>
        <span class="pdv-status-pill" id="operationStatus"><%= current?.status === 'finalized' ? 'Finalizada' : current?.status === 'awaiting_payment' ? 'Aguardando pagamento' : current?.status === 'cancelled' ? 'Cancelada' : 'Em aberto' %></span><span class="pdv-version-pill" id="operationVersion">v<%= current?.version || 0 %></span><button class="btn pdv-history-btn" id="btnHistory" <%= current ? '' : 'disabled' %>>🕘 Histórico</button>
      </div>

      <div class="pdv-fields-grid pdv-fields-smart">
        <label class="pdv-customer-field">Cliente<div class="pdv-field-with-action"><select id="customerId"><option value="">Consumidor final</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" data-name="<%= c.name %>"><%= c.code %> · <%= c.name %></option><% }) %></select><button class="btn pdv-mini-action" id="btnCustomerSearch" title="Pesquisar cliente">🔎</button></div></label>
        <label class="pdv-identifier-field" title="Dê dois cliques para informar nome, telefone ou referência">Identificador <span class="pdv-muted-note">(duplo clique)</span><input id="identifier" class="pdv-identifier-collapsed" placeholder="✎" readonly></label>
        <label>Vendedor principal<input id="sellerName" placeholder="Selecione ou informe o vendedor"></label>
      </div>

      <div class="pdv-product-entry">
        <label>Produto / serviço<div class="pdv-field-with-action"><input id="productSearch" list="productOptions" placeholder="Pesquise por nome, código, SKU ou código de barras [F5]"><button class="btn pdv-mini-action" id="btnProductSearch" title="Abrir lista de produtos">🔎</button></div></label>
        <datalist id="productOptions"><% products.forEach(p=>{ %><option value="<%= p.name %>" data-id="<%= p.id %>"></option><% }) %></datalist>
        <label>Quantidade<input type="number" id="productQty" value="1" min="0.001" step="0.001"></label>
        <button class="btn primary" id="btnAddProduct">Adicionar</button>
      </div>

      <div class="pdv-table-wrap"><table class="pdv-table"><thead><tr><th>Produto / serviço</th><th>Qtd.</th><th>Valor unit.</th><th>Desconto</th><th>Vendedor do item</th><th>Subtotal</th><th></th></tr></thead><tbody id="itemsBody"></tbody></table></div>

      <div class="pdv-os-panel" id="osPanel" hidden>
        <div class="pdv-os-title"><div><h3>Ordem de Serviço</h3><p>Preencha somente o necessário. Check-in, check-out e fotos são opcionais.</p></div></div>
        <div class="pdv-fields-grid pdv-os-main-grid">
          <label>Equipamento<input id="osDevice" placeholder="Ex.: iPhone 13, Notebook Dell, Impressora Brother"></label>
          <label>Identificação do equipamento <span class="pdv-muted-note">(opcional)</span><input id="osEquipmentId" placeholder="Número de série, patrimônio ou referência"></label>
          <label>Técnico responsável<input id="osTechnician" placeholder="Nome do técnico"></label>
        </div>
        <label>Problema relatado / diagnóstico inicial<textarea id="osIssue" rows="3" placeholder="Relato do cliente e diagnóstico inicial no mesmo campo"></textarea></label>
        <label>Serviço realizado<textarea id="osServicePerformed" rows="4" placeholder="Descreva as etapas realizadas para solucionar o problema"></textarea></label>
        <label>Acessórios recebidos <span class="pdv-muted-note">(opcional)</span><input id="osAccessories" placeholder="Ex.: carregador, fonte, cabo USB, capa, mouse"></label>

        <details class="pdv-os-section" id="osCheckinSection">
          <summary><span>📥 Check-in do equipamento</span><small>Opcional · estado na entrada</small></summary>
          <div class="pdv-os-section-body">
            <label>Estado físico / observações de entrada<textarea id="osCheckinNotes" rows="3" placeholder="Riscos, trincas, amassados, peças faltando ou outras observações"></textarea></label>
            <div class="pdv-checklist" id="checkinChecklist"></div>
          </div>
        </details>

        <details class="pdv-os-section" id="osCheckoutSection">
          <summary><span>✅ Check-out e testes finais</span><small>Opcional · validação antes da entrega</small></summary>
          <div class="pdv-os-section-body">
            <div class="pdv-checklist" id="checkoutChecklist"></div>
            <label>Observações finais do check-out<textarea id="osCheckoutNotes" rows="3" placeholder="Resultados, limitações ou orientações ao cliente"></textarea></label>
            <div class="pdv-delivery-checks"><label><input type="checkbox" id="osCustomerChecked"> Cliente conferiu o equipamento</label><label><input type="checkbox" id="osAccessoriesChecked"> Cliente conferiu os acessórios</label><label><input type="checkbox" id="osGuidanceReceived"> Cliente recebeu orientações</label></div>
          </div>
        </details>

        <details class="pdv-os-section" id="osPhotosSection">
          <summary><span>🖼️ Fotos da O.S.</span><small>Até 3 fotos · compactação automática</small></summary>
          <div class="pdv-os-section-body">
            <div class="pdv-photo-toolbar"><select id="photoKind"><option value="checkin">Foto de entrada</option><option value="checkout">Foto de saída</option><option value="general">Foto geral</option></select><input type="file" id="osPhotoInput" accept="image/*" capture="environment"><button class="btn" id="btnAddPhoto" type="button">Adicionar foto</button></div>
            <p class="pdv-modal-help">A imagem é reduzida para no máximo 1600 px e salva em WebP. O limite total é de três fotos por O.S.</p>
            <div class="pdv-photo-grid" id="osPhotoGrid"></div>
          </div>
        </details>
      </div>

      <label class="pdv-notes">Observação geral<textarea id="notes" rows="2" placeholder="Informação interna da venda ou O.S."></textarea></label>
    </div>

    <aside class="pdv-side">
      <div class="pdv-summary"><div><span>Subtotal</span><b id="subtotal">R$ 0,00</b></div><div><span>Descontos</span><b id="discountTotal">R$ 0,00</b></div><div class="total"><span>Total da operação</span><strong id="total">R$ 0,00</strong></div></div>
      <div class="pdv-payments-head"><h3>Pagamentos</h3><button class="btn" id="btnAddPayment">＋ Adicionar</button></div>
      <div id="payments"></div>
      <div class="pdv-payment-summary"><div><span>Total pago</span><b id="amountPaid">R$ 0,00</b></div><div class="pending"><span>Pendente</span><strong id="amountPending">R$ 0,00</strong></div><div class="change"><span>Troco</span><strong id="change">R$ 0,00</strong></div></div>
    </aside>
  </section>

  <footer class="pdv-bottom-actions">
    <div class="pdv-bottom-left">
      <button class="btn" id="btnPrint">🖨️ Imprimir <kbd>F9</kbd></button>
      <button class="btn warn" id="btnCancelOperation" <%= current && !['finalized','cancelled'].includes(current.status) ? '' : 'disabled' %>>Cancelar</button><button class="btn" id="btnSave">💾 Salvar em aberto <kbd>F10</kbd></button>
    </div>
    <button class="btn primary pdv-finalize-wide" id="btnFinalize">✓ Finalizar operação <kbd>F12</kbd></button>
  </footer>
</div>


<div class="pdv-modal" id="modalCustomerSearch" hidden><div class="pdv-modal-card wide"><button class="pdv-close" data-close>×</button><h2>Buscar cliente</h2><p class="pdv-modal-help">Pesquise por nome, telefone, CPF/CNPJ, e-mail ou código.</p><input id="customerSearchInput" placeholder="Digite para pesquisar"><div class="pdv-search-list" id="customerSearchList"></div></div></div>
<div class="pdv-modal" id="modalProductSearch" hidden><div class="pdv-modal-card wide"><button class="pdv-close" data-close>×</button><h2>Buscar produto / serviço</h2><p class="pdv-modal-help">Pesquise por nome, código, SKU, categoria ou código de barras.</p><input id="productSearchInput" placeholder="Digite para pesquisar"><div class="pdv-search-list" id="productSearchList"></div></div></div>
<div class="pdv-modal" id="modalPrint" hidden><div class="pdv-modal-card pdv-print-modal"><button class="pdv-close" data-close>×</button><h2>Imprimir</h2><p class="pdv-modal-help">Selecione o modelo de impressão.</p><div class="pdv-print-models" id="printModels"></div><div class="pdv-print-options" id="osPrintOptions" hidden><b>Conteúdo da impressão da O.S.</b><label><input type="checkbox" id="printCheckin" checked> Incluir check-in preenchido</label><label><input type="checkbox" id="printCheckout" checked> Incluir check-out preenchido</label><label><input type="checkbox" id="printPhotos" checked> Incluir fotos</label><label><input type="checkbox" id="printTimeline"> Incluir histórico resumido</label></div><div class="pdv-print-actions"><label><input type="checkbox" id="printPreview" checked> Visualizar antes de imprimir</label><button class="btn" data-close>Cancelar</button><button class="btn primary" id="btnConfirmPrint">🖨️ Imprimir</button></div></div></div>
<div class="pdv-modal" id="modalNewPrintModel" hidden><div class="pdv-modal-card"><button class="pdv-close" data-close>×</button><h2>Novo modelo</h2><label>Nome<input id="newModelName" placeholder="Ex.: Termo de garantia"></label><label>Aplicação<select id="newModelType"><option value="all">Venda e O.S.</option><option value="sale">Somente venda</option><option value="service_order">Somente O.S.</option></select></label><label>Conteúdo<textarea id="newModelContent" rows="12" placeholder="Use: {{empresa}}, {{numero}}, {{cliente}}, {{identificador}}, {{itens}}, {{total}}, {{vendedor}}, {{observacao}}, {{os_aparelho}}, {{os_defeito}}"></textarea></label><button class="btn primary" id="btnSavePrintModel">Salvar modelo</button></div></div>
<div class="pdv-modal" id="modalHistory" hidden><div class="pdv-modal-card wide"><button class="pdv-close" data-close>×</button><h2>Histórico da operação</h2><div class="pdv-operation-dates" id="operationDates"></div><div class="pdv-timeline" id="operationTimeline"></div></div></div>
<div class="pdv-modal" id="modalOperations" hidden><div class="pdv-modal-card wide"><button class="pdv-close" data-close>×</button><h2>Buscar operações</h2><input id="operationSearch" placeholder="Cliente, identificador, número, aparelho ou vendedor"><div class="pdv-operation-list" id="operationList"></div></div></div>
<div class="pdv-modal pdv-cash-modal" id="modalCash" hidden><div class="pdv-modal-card"><button class="pdv-close" data-close>×</button><h2 id="cashModalTitle">Caixa simplificado</h2><div id="cashClosedBox"><p class="pdv-modal-help">Abra o caixa uma vez no início do dia. O saldo inicial é transportado automaticamente do último fechamento.</p><div class="pdv-cash-opening-summary"><span>Saldo para abertura</span><strong id="openingBalanceDisplay">R$ <%= Number(cashState?.suggestedOpeningBalance||0).toLocaleString('pt-BR',{minimumFractionDigits:2}) %></strong><small><%= cashState?.lastClosedSession ? 'Vindo do último fechamento' : 'Primeira abertura registrada' %></small></div><label class="pdv-additional-opening" <%= cashState?.openedTodayByUser ? '' : 'hidden' %>><input type="checkbox" id="allowAdditionalOpening"> Abrir um novo turno hoje</label><button class="btn primary pdv-cash-primary" id="btnOpenCash">Abrir caixa e liberar PDV</button></div><div id="cashOpenBox"><div class="pdv-cash-current"><span>Saldo calculado agora</span><strong><%= Number(cashBalance||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></strong><small>Será usado automaticamente no fechamento.</small></div><details class="pdv-cash-movements"><summary>Registrar suprimento, sangria ou despesa</summary><div><label>Tipo<select id="movementType"><option value="supply">Entrada (suprimento)</option><option value="withdrawal">Saída (sangria)</option><option value="expense">Despesa</option></select></label><label>Valor<input type="number" id="movementAmount" step="0.01"></label><label>Descrição<input id="movementDescription"></label><button class="btn" id="btnMovement">Registrar movimentação</button></div></details><button class="btn warn pdv-cash-primary" id="btnCloseCash">Abrir conferência no Caixa Operacional</button></div></div></div>
<div class="pdv-modal" id="modalInstallments" hidden><div class="pdv-modal-card wide pdv-installments-modal"><button class="pdv-close" data-close>×</button><h2>Configurar parcelas</h2><p class="pdv-modal-help">Defina valores e vencimentos das parcelas. Você também pode redistribuir os valores igualmente.</p><div class="pdv-installment-summary" id="installmentSummary"></div><div class="pdv-installment-tools"><button type="button" class="btn" id="btnRedistributeInstallments">Redistribuir igualmente</button></div><div class="pdv-installment-list" id="installmentList"></div><div class="pdv-finalize-actions"><button class="btn" data-close>Cancelar</button><button class="btn primary" id="btnSaveInstallments">Salvar configuração</button></div></div></div>
<div class="pdv-modal" id="modalFinalize" hidden><div class="pdv-modal-card pdv-finalize-modal"><button class="pdv-close" data-close>×</button><h2>Confirmar finalização</h2><p class="pdv-modal-help">Confira os dados antes de processar estoque e caixa. Depois de finalizada, a operação ficará somente para consulta.</p><div class="pdv-finalize-summary" id="finalizeSummary"></div><div class="pdv-finalize-actions"><button class="btn" data-close>Cancelar</button><button class="btn primary" id="btnConfirmFinalize">✓ Confirmar finalização</button></div></div></div>
<div class="pdv-modal pdv-success-backdrop" id="modalFinalizeSuccess" hidden><div class="pdv-modal-card pdv-success-modal"><div class="pdv-success-icon">✓</div><h2 id="finalizeSuccessTitle">Operação finalizada com sucesso</h2><p class="pdv-modal-help" id="finalizeSuccessText">A movimentação foi registrada no estoque e no caixa.</p><div class="pdv-success-number" id="finalizeSuccessNumber">#—</div><div class="pdv-success-actions"><button class="btn primary" id="btnSuccessNew">＋ Nova operação <kbd>F9</kbd></button><button class="btn" id="btnSuccessPrint">🖨️ Imprimir comprovante</button><button class="btn" id="btnSuccessView">👁️ Ver resumo da operação</button></div><p class="pdv-success-note">Imprimir, cancelar a impressão ou consultar o resumo não altera a venda finalizada.</p></div></div>
<div class="pdv-modal pdv-success-backdrop" id="modalOperationSummary" hidden><div class="pdv-modal-card pdv-operation-summary-modal"><button class="pdv-close" id="btnSummaryClose" type="button" aria-label="Fechar">×</button><div class="pdv-operation-summary-head"><div><span>Operação finalizada</span><h2 id="operationSummaryTitle">Resumo da operação</h2></div><span class="pdv-status-pill">Finalizada</span></div><div id="operationSummaryContent" class="pdv-operation-summary-content"></div><div class="pdv-success-actions"><button class="btn" id="btnSummaryBack">← Voltar ao sucesso</button><button class="btn" id="btnSummaryPrint">🖨️ Imprimir novamente</button><button class="btn primary" id="btnSummaryNew">＋ Nova operação</button></div></div></div>
<div class="pdv-modal" id="modalShortcuts" hidden><div class="pdv-modal-card"><button class="pdv-close" data-close>×</button><h2>Atalhos do PDV</h2><div class="pdv-shortcuts"><span><kbd>F1</kbd> Menu de atalhos</span><span><kbd>F5</kbd> Buscar produto</span><span><kbd>F7</kbd> Buscar cliente</span><span><kbd>F9</kbd> Imprimir</span><span><kbd>F10</kbd> Salvar em aberto</span><span><kbd>F12</kbd> Finalizar</span><span><kbd>Ctrl+A</kbd> Buscar operações</span><span><kbd>Ctrl+S</kbd> Salvar em aberto</span></div></div></div>
<script>window.PDV_BOOT=<%- JSON.stringify({products,customers,operations,current,openSession,cashState,paymentMethods,selectedCashboxId}) %>;</script>
<script>
(()=>{
 const boot=window.PDV_BOOT, money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}), $=s=>document.querySelector(s);
 let state={id:boot.current?.id||'',number:boot.current?.number||null,version:Number(boot.current?.version||0),type:boot.current?.type||'sale',items:boot.current?.items||[],payments:boot.current?.payments||[]};
 const checkinItems=['Tela / display','Carcaça / estrutura','Botões','Conectores','Câmeras','Áudio','Sinais de oxidação','Liga / inicializa'];
 const checkoutItems=['Liga / desliga','Tela / display','Touch / teclado','Botões','Carregamento / fonte','Bateria','Câmeras / scanner','Áudio / microfone','Wi-Fi / rede','Bluetooth','USB / conectores','Impressão / alimentação de papel','HDMI / vídeo'];
 const productByName=new Map(boot.products.map(p=>[String(p.name).toLowerCase(),p]));
 const paymentMethodById=new Map((boot.paymentMethods||[]).map(m=>[String(m.id),m]));
 const isoDateAfter=days=>{const d=new Date();d.setHours(12,0,0,0);d.setDate(d.getDate()+Number(days||0));return d.toISOString().slice(0,10);};
 const addDaysToIso=(iso,days)=>{const d=new Date(`${iso}T12:00:00`);if(Number.isNaN(d.getTime()))return '';d.setDate(d.getDate()+Number(days||0));return d.toISOString().slice(0,10);};
 let installmentRow=null;
 function paymentDueDates(el){try{const value=JSON.parse(el.dataset.dueDates||'[]');return Array.isArray(value)?value.filter(Boolean):[]}catch{return []}}
 function paymentInstallmentAmounts(el){try{const value=JSON.parse(el.dataset.installmentAmounts||'[]');return Array.isArray(value)?value.map(Number).filter(value=>Number.isFinite(value)&&value>=0):[]}catch{return []}}
 function buildDueDates(el){const method=paymentMethodById.get(el.querySelector('.pay-method').value)||{};const count=Math.max(1,Number(el.querySelector('.pay-installments').value||1));const first=isoDateAfter(method.firstDueDays||0);const current=paymentDueDates(el);return Array.from({length:count},(_,index)=>current[index]||addDaysToIso(first,index*Number(method.installmentIntervalDays||30)));}
 function equalInstallmentAmounts(amount,count){const cents=Math.round(Number(amount||0)*100),base=Math.floor(cents/count),remainder=cents-(base*count);return Array.from({length:count},(_,index)=>(base+(index<remainder?1:0))/100);}
 function syncInstallmentButton(el){const method=paymentMethodById.get(el.querySelector('.pay-method').value)||{};const count=Math.max(1,Number(el.querySelector('.pay-installments').value||1));const action=el.querySelector('.pdv-installment-action');const button=el.querySelector('.pdv-installment-config');const resume=el.querySelector('.pdv-installment-resume');const dueField=el.querySelector('.pdv-pay-due-field');const receivable=method.generatesReceivable===true;const multiple=receivable&&count>1;const single=receivable&&count===1;if(dueField){dueField.hidden=!single;const input=dueField.querySelector('.pay-due-date');if(single&&input&&!input.value){const current=paymentDueDates(el);input.value=current[0]||isoDateAfter(method.firstDueDays||0);el.dataset.dueDates=JSON.stringify([input.value]);}}action.hidden=!multiple;button.classList.toggle('configured',multiple&&el.dataset.installmentsConfigured==='true');button.innerHTML=multiple&&el.dataset.installmentsConfigured==='true'?'<span class="pdv-installment-icon">✓</span><span>Parcelas configuradas</span>':'<span class="pdv-installment-icon">⚙</span><span>Configurar parcelas</span>';if(resume)resume.textContent=multiple&&el.dataset.installmentsConfigured==='true'?`${count} parcelas • Configuração personalizada`:`${count} parcelas • Distribuição igual`;}
 function updateInstallmentSummary(){if(!installmentRow)return;const amount=Math.round(Number(installmentRow.querySelector('.pay-amount').value||0)*100)/100;const values=[...$('#installmentList').querySelectorAll('.pdv-installment-value')].map(input=>Number(input.value||0));const configured=Math.round(values.reduce((sum,value)=>sum+value,0)*100)/100;const difference=Math.round((amount-configured)*100)/100;$('#installmentSummary').innerHTML=`<div><span>Total da forma</span><strong>${money(amount)}</strong></div><div><span>Total configurado</span><strong>${money(configured)}</strong></div><div class="${Math.abs(difference)<.01?'ok':difference>0?'warning':'negative'}"><span>${Math.abs(difference)<.01?'Distribuição fechada':difference>0?'Falta distribuir':'Valor excedente'}</span><strong>${money(Math.abs(difference))}</strong></div>`;}
 function renderInstallmentModalValues(values,dates){const count=dates.length;$('#installmentList').innerHTML=dates.map((dueDate,index)=>`<div class="pdv-installment-line"><span><b>${index+1}/${count}</b><small>Parcela ${index+1}</small></span><label><small>Valor</small><input class="pdv-installment-value" type="number" min="0.01" step="0.01" value="${Number(values[index]||0).toFixed(2)}"></label><label><small>Vencimento</small><input class="pdv-installment-date" type="date" value="${dueDate}"></label></div>`).join('');$('#installmentList').querySelectorAll('input').forEach(input=>input.addEventListener('input',updateInstallmentSummary));updateInstallmentSummary();}
 function openInstallmentModal(el){const count=Math.max(1,Number(el.querySelector('.pay-installments').value||1));const amount=Number(el.querySelector('.pay-amount').value||0);const dates=buildDueDates(el);const currentValues=paymentInstallmentAmounts(el);const values=currentValues.length===count?currentValues:equalInstallmentAmounts(amount,count);installmentRow=el;renderInstallmentModalValues(values,dates);show('#modalInstallments');}
 function redistributeInstallments(){if(!installmentRow)return;const count=Math.max(1,Number(installmentRow.querySelector('.pay-installments').value||1));const values=equalInstallmentAmounts(Number(installmentRow.querySelector('.pay-amount').value||0),count);[...$('#installmentList').querySelectorAll('.pdv-installment-value')].forEach((input,index)=>input.value=Number(values[index]||0).toFixed(2));updateInstallmentSummary();}
 function saveInstallmentDates(){if(!installmentRow)return;const dates=[...$('#installmentList').querySelectorAll('.pdv-installment-date')].map(input=>input.value);const values=[...$('#installmentList').querySelectorAll('.pdv-installment-value')].map(input=>Math.round(Number(input.value||0)*100)/100);if(dates.some(value=>!value)){alert('Informe o vencimento de todas as parcelas.');return;}if(values.some(value=>value<=0)){alert('Todas as parcelas precisam ter valor maior que zero.');return;}const amount=Math.round(Number(installmentRow.querySelector('.pay-amount').value||0)*100)/100;const configured=Math.round(values.reduce((sum,value)=>sum+value,0)*100)/100;if(Math.abs(amount-configured)>=.01){alert(`A soma das parcelas precisa fechar em ${money(amount)}. Diferença atual: ${money(amount-configured)}.`);return;}installmentRow.dataset.dueDates=JSON.stringify(dates);installmentRow.dataset.installmentAmounts=JSON.stringify(values);installmentRow.dataset.installmentsConfigured='true';syncInstallmentButton(installmentRow);$('#modalInstallments').hidden=true;installmentRow=null;}
 function syncPaymentRow(el,{setDefaultDate=false}={}){
  const method=paymentMethodById.get(el.querySelector('.pay-method').value)||{};
  const receivable=method.generatesReceivable===true;
  const installments=el.querySelector('.pay-installments');
  installments.disabled=method.allowInstallments===false;
  installments.max=Math.max(1,Number(method.maxInstallments||1));
  if(method.allowInstallments===false)installments.value=1;
  if(!receivable)el.dataset.dueDates='[]';
