 function checklistHtml(title,data){const items=(data?.items||[]).filter(i=>i.status&&i.status!=='not_applicable');if(!items.length&&!data?.notes)return '';const labels={approved:'Aprovado',failed:'Com problema',not_tested:'Não testado',not_applicable:'N/A'};return `<section><h2>${esc(title)}</h2>${items.length?`<table><tbody>${items.map(i=>`<tr><td>${esc(i.label)}</td><td><b>${esc(labels[i.status]||i.status)}</b></td><td>${esc(i.notes||'')}</td></tr>`).join('')}</tbody></table>`:''}${data?.notes?`<p><b>Observações:</b> ${esc(data.notes)}</p>`:''}</section>`;}
 async function photosHtml(attachments){if(!attachments.length||!$('#printPhotos').checked)return '';const imgs=await Promise.all(attachments.map(async a=>{try{const r=await fetch(a.url);const b=await r.blob();return await new Promise(ok=>{const fr=new FileReader();fr.onload=()=>ok(`<figure><img src="${fr.result}"><figcaption>${esc(a.kind==='checkin'?'Entrada':a.kind==='checkout'?'Saída':'Foto da O.S.')}</figcaption></figure>`);fr.readAsDataURL(b)})}catch{return ''}}));return imgs.some(Boolean)?`<section><h2>Fotos</h2><div class="photos">${imgs.join('')}</div></section>`:'';}
 async function buildPrintHtml(model){const op=boot.current||payload();const so=payload().serviceOrder;const customer=$('#customerId').selectedOptions[0]?.dataset.name||'Consumidor final';const total=state.items.reduce((s,i)=>s+Number(i.quantity||0)*Number(i.unitPrice||0)-Number(i.discount||0),0);if(!model.smart){let text=model.content;const d={empresa:'Quality Celulares',numero:state.number||'NOVA',cliente:customer,identificador:$('#identifier').value||'—',vendedor:$('#sellerName').value||'—',observacao:$('#notes').value||'—',total:money(total),itens:state.items.length?state.items.map(i=>`${i.quantity}x ${i.name} — ${money(i.quantity*i.unitPrice-(i.discount||0))}`).join('\n'):'Nenhum item adicionado',os_aparelho:so.device||'—',os_defeito:so.issue||'—'};Object.entries(d).forEach(([k,v])=>text=text.replaceAll(`{{${k}}}`,String(v)));return `<!doctype html><html><head><meta charset="utf-8"><title>${esc(model.name)}</title><style>body{font:14px Arial,sans-serif;color:#111;margin:28px;white-space:pre-wrap;line-height:1.45}</style></head><body>${esc(text)}</body></html>`;}
 const complete=model.id==='os-complete',exit=model.id==='os-exit';let body=`<header><h1>QUALITY CELULARES</h1><h2>${exit?'COMPROVANTE DE RETIRADA':'ORDEM DE SERVIÇO'} #${esc(state.number||'NOVA')}</h2></header><section class="grid"><p><b>Cliente:</b> ${esc(customer)}</p><p><b>Contato/referência:</b> ${esc($('#identifier').value||'—')}</p><p><b>Equipamento:</b> ${esc(so.device||'—')}</p>${so.equipmentId?`<p><b>Identificação:</b> ${esc(so.equipmentId)}</p>`:''}<p><b>Técnico:</b> ${esc(so.technicianName||'—')}</p><p><b>Abertura:</b> ${fmtDate(op.dates?.openedAt||op.createdAt||new Date())}</p></section>${so.issue?`<section><h2>Problema relatado / diagnóstico inicial</h2><p>${esc(so.issue)}</p></section>`:''}${so.accessories?`<section><h2>Acessórios recebidos</h2><p>${esc(so.accessories)}</p></section>`:''}${so.servicePerformed?`<section><h2>Serviço realizado</h2><p>${esc(so.servicePerformed)}</p></section>`:''}`;
 if(complete&&$('#printCheckin').checked)body+=checklistHtml('Check-in',so.checkin);if((complete||exit)&&$('#printCheckout').checked)body+=checklistHtml('Check-out e testes finais',so.checkout);if(so.checkout?.customerChecked||so.checkout?.accessoriesChecked||so.checkout?.guidanceReceived)body+=`<section><h2>Conferência na entrega</h2><p>${so.checkout.customerChecked?'☑':'☐'} Cliente conferiu o equipamento &nbsp; ${so.checkout.accessoriesChecked?'☑':'☐'} Conferiu os acessórios &nbsp; ${so.checkout.guidanceReceived?'☑':'☐'} Recebeu orientações</p></section>`;if(complete)body+=await photosHtml(so.attachments||[]);if(state.items.length)body+=`<section><h2>Produtos / serviços</h2><table><tbody>${state.items.map(i=>`<tr><td>${esc(i.quantity)}x ${esc(i.name)}</td><td>${money(i.quantity*i.unitPrice-(i.discount||0))}</td></tr>`).join('')}</tbody></table><p class="total"><b>Total:</b> ${money(total)}</p></section>`;if(complete&&$('#printTimeline').checked&&(op.timeline||[]).length)body+=`<section><h2>Histórico resumido</h2>${op.timeline.map(e=>`<p>${fmtDate(e.at)} — ${esc(e.label||e.type)}</p>`).join('')}</section>`;body+=`<footer><div>Assinatura do cliente: __________________________________</div><div>Responsável: __________________________________</div></footer>`;return `<!doctype html><html><head><meta charset="utf-8"><title>${esc(model.name)}</title><style>body{font:13px Arial,sans-serif;color:#111;margin:24px;line-height:1.4}header{text-align:center;border-bottom:2px solid #111;margin-bottom:18px}h1{font-size:20px;margin:0}h2{font-size:15px;margin:12px 0 7px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px}section{border-bottom:1px solid #ccc;padding:7px 0}p{white-space:pre-wrap;margin:5px 0}table{width:100%;border-collapse:collapse}td{border-bottom:1px solid #ddd;padding:5px}.photos{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.photos img{width:100%;max-height:260px;object-fit:contain}.photos figure{margin:0;text-align:center}.total{text-align:right;font-size:16px}footer{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:45px}@media print{body{margin:10mm}}</style></head><body>${body}</body></html>`;}
 $('#btnPrint').onclick=()=>openPrintFrom(null);
 $('#btnConfirmPrint').onclick=async()=>{
  const model=currentPrintModel();let w=null;
  try{
   w=window.open('','_blank');
   if(!w)throw new Error('O navegador bloqueou a janela de impressão. Autorize pop-ups para o Painel Quality.');
   const html=await buildPrintHtml(model);
   w.document.open();w.document.write(html);w.document.close();
   restoreAfterPrint();
   if($('#printPreview').checked){
    const closePreview=()=>{try{if(!w.closed)w.close();}catch(_){}};
    w.addEventListener?.('afterprint',closePreview,{once:true});
    setTimeout(()=>{try{w.focus();w.print();}catch(_){}},300);
   }else{w.focus();}
  }catch(e){
   try{if(w&&!w.closed)w.close();}catch(_){}
   alert(e.message||'Não foi possível abrir a impressão.');
  }
 };
 $('#btnSavePrintModel').onclick=()=>{const name=$('#newModelName').value.trim(),content=$('#newModelContent').value.trim();if(!name||!content)return alert('Informe o nome e o conteúdo do modelo.');const models=getCustomModels();models.push({id:'custom-'+Date.now(),name,type:$('#newModelType').value,icon:'📄',content});localStorage.setItem('qualityPdvPrintModels',JSON.stringify(models));$('#newModelName').value='';$('#newModelContent').value='';hideAll();selectedPrintModel=models.at(-1).id;renderPrintModels();show('#modalPrint')};
 const fmtDate=v=>v?new Date(v).toLocaleString('pt-BR'):'—';
 function renderHistory(){const op=boot.current;if(!op)return;$('#operationDates').innerHTML=`<div><span>Abertura</span><b>${fmtDate(op.dates?.openedAt||op.createdAt)}</b></div><div><span>Última atualização</span><b>${fmtDate(op.dates?.updatedAt||op.updatedAt)}</b></div><div><span>Finalização</span><b>${fmtDate(op.dates?.finalizedAt||op.finalizedAt)}</b></div><div><span>Cancelamento</span><b>${fmtDate(op.dates?.cancelledAt||op.cancelledAt)}</b></div>`;const events=[...(op.timeline||[])].reverse();$('#operationTimeline').innerHTML=events.map(ev=>`<article><time>${fmtDate(ev.at)}</time><div><b>${esc(ev.label||ev.type)}</b><span>${esc(ev.actor||'sistema')}</span></div></article>`).join('')||'<p>Nenhum evento registrado.</p>';}
 $('#btnHistory').onclick=()=>{renderHistory();show('#modalHistory')};
 function renderOperations(filter=''){ const q=filter.toLowerCase(); $('#operationList').innerHTML=boot.operations.filter(o=>!q||`${o.number} ${o.identifier} ${o.customerNameSnapshot} ${o.sellerNameSnapshot} ${o.serviceOrder?.device||''}`.toLowerCase().includes(q)).map(o=>`<button data-id="${o.id}"><b>${o.type==='service_order'?'O.S.':'Venda'} #${o.number}</b><span>${o.customerNameSnapshot||o.identifier||'Consumidor final'}</span><em>${money(o.total)} · ${o.status}</em></button>`).join('')||'<p>Nenhuma operação encontrada.</p>'; document.querySelectorAll('#operationList button').forEach(b=>b.onclick=()=>location.href='/erp/pdv?operacao='+b.dataset.id); }
 $('#btnOperations').onclick=()=>{renderOperations();show('#modalOperations')}; $('#operationSearch').oninput=e=>renderOperations(e.target.value); $('#btnNew').onclick=()=>location.href=newOperationUrl();
 $('#btnOpenCash').onclick=async()=>{try{const body={cashboxId:$('#cashbox').value,allowAdditionalOpening:!!$('#allowAdditionalOpening')?.checked};await api('/erp/pdv/caixa/abrir','POST',body);location.reload()}catch(e){alert(e.message)}};
 $('#btnMovement').onclick=async()=>{try{await api('/erp/pdv/caixa/movimentar','POST',{cashboxId:$('#cashbox').value,type:$('#movementType').value,amount:Number($('#movementAmount').value||0),description:$('#movementDescription').value});location.reload()}catch(e){alert(e.message)}};
 $('#btnCloseCash').onclick=()=>{location.href='/erp/pdv/caixa?caixa='+encodeURIComponent($('#cashbox').value)};
 document.addEventListener('keydown',e=>{if(e.key==='F1'){e.preventDefault();show('#modalShortcuts')}if(e.key==='F5'){e.preventDefault();$('#productSearch').focus()}if(e.key==='F7'){e.preventDefault();$('#btnCustomerSearch').click()}if(e.key==='F9'){e.preventDefault();if(!$('#modalFinalizeSuccess').hidden||!$('#modalOperationSummary').hidden)location.href=newOperationUrl();else $('#btnPrint').click()}if(e.key==='F10'){e.preventDefault();save(false)}if(e.key==='F12'){e.preventDefault();save(true)}if(e.ctrlKey&&e.key.toLowerCase()==='a'){e.preventDefault();$('#btnOperations').click()}if(e.ctrlKey&&e.key.toLowerCase()==='s'){e.preventDefault();save(false)}});
 if(boot.current){const so=boot.current.serviceOrder||{};$('#customerId').value=boot.current.customerId||'';$('#identifier').value=boot.current.identifier||'';$('#sellerName').value=boot.current.sellerNameSnapshot||'';$('#notes').value=boot.current.notes||'';$('#osDevice').value=so.device||'';$('#osEquipmentId').value=so.equipmentId||'';$('#osIssue').value=so.issue||so.diagnosis||'';$('#osTechnician').value=so.technicianName||'';$('#osServicePerformed').value=so.servicePerformed||'';$('#osAccessories').value=so.accessories||'';$('#osCheckinNotes').value=so.checkin?.notes||'';$('#osCheckoutNotes').value=so.checkout?.notes||'';$('#osCustomerChecked').checked=!!so.checkout?.customerChecked;$('#osAccessoriesChecked').checked=!!so.checkout?.accessoriesChecked;$('#osGuidanceReceived').checked=!!so.checkout?.guidanceReceived;}
 function renderChecklist(containerId,labels,saved=[]){const map=new Map((saved||[]).map(i=>[i.label,i]));$(containerId).innerHTML=labels.map(label=>{const item=map.get(label)||{};return `<div class="pdv-check-row" data-label="${esc(label)}"><b>${esc(label)}</b><select><option value="not_applicable">Não se aplica</option><option value="approved">Aprovado</option><option value="failed">Com problema</option><option value="not_tested">Não testado</option></select><input placeholder="Observação opcional" value="${esc(item.notes||'')}"></div>`}).join('');[...document.querySelectorAll(`${containerId} .pdv-check-row`)].forEach(r=>r.querySelector('select').value=map.get(r.dataset.label)?.status||'not_applicable');}
 function renderPhotos(){const list=boot.current?.serviceOrder?.attachments||[];$('#osPhotoGrid').innerHTML=list.map(a=>`<article><img src="${esc(a.url)}" alt="Foto da O.S."><span>${a.kind==='checkin'?'Entrada':a.kind==='checkout'?'Saída':'Geral'}</span><button type="button" data-id="${esc(a.id)}">Remover</button></article>`).join('')||'<p class="pdv-empty-photos">Nenhuma foto adicionada.</p>';document.querySelectorAll('#osPhotoGrid button').forEach(b=>b.onclick=async()=>{if(!confirm('Remover esta foto?'))return;try{const j=await api(`/erp/pdv/operacoes/${state.id}/anexos/${b.dataset.id}`,'DELETE',{version:state.version});applyServerOperation(j.operation);renderPhotos()}catch(e){alert(e.message)}});}
 async function compressPhoto(file){const img=await new Promise((ok,fail)=>{const i=new Image();i.onload=()=>ok(i);i.onerror=fail;i.src=URL.createObjectURL(file)});const max=1600,scale=Math.min(1,max/Math.max(img.width,img.height)),canvas=document.createElement('canvas');canvas.width=Math.round(img.width*scale);canvas.height=Math.round(img.height*scale);canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);return canvas.toDataURL('image/webp',0.78);}
 $('#btnAddPhoto').onclick=async()=>{if(!boot.openSession)return alert('Abra o caixa antes de alterar a O.S.');if(!state.id){alert('Salve a O.S. em aberto antes de adicionar fotos.');return}const file=$('#osPhotoInput').files[0];if(!file)return alert('Selecione uma foto.');try{$('#btnAddPhoto').disabled=true;$('#btnAddPhoto').textContent='Compactando...';const dataUrl=await compressPhoto(file);const j=await api(`/erp/pdv/operacoes/${state.id}/anexos`,'POST',{version:state.version,dataUrl,name:file.name,kind:$('#photoKind').value});applyServerOperation(j.operation);$('#osPhotoInput').value='';renderPhotos();alert(j.message)}catch(e){alert(e.message)}finally{$('#btnAddPhoto').disabled=false;$('#btnAddPhoto').textContent='Adicionar foto'}};
 renderChecklist('#checkinChecklist',checkinItems,boot.current?.serviceOrder?.checkin?.items);renderChecklist('#checkoutChecklist',checkoutItems,boot.current?.serviceOrder?.checkout?.items);renderPhotos();
 setType(state.type); const initialPayments=Array.isArray(state.payments)?[...state.payments]:[]; (initialPayments.length?initialPayments:[{}]).forEach(rowPayment); renderItems(); $('#cashClosedBox').hidden=!!boot.openSession;$('#cashOpenBox').hidden=!boot.openSession; if(!boot.openSession){document.querySelectorAll('.pdv-main input,.pdv-main select,.pdv-main textarea,.pdv-main button:not(#btnHistory),.pdv-side input,.pdv-side select,.pdv-side button,.pdv-type-switch button,#btnSave,#btnFinalize,#btnCancelOperation').forEach(el=>el.disabled=true);$('#operationStatus').textContent='Abra o caixa para operar';show('#modalCash');document.querySelector('#modalCash [data-close]').hidden=true;} lockFinalized();
})();
</script>
