rder:1px solid #374151;background:#17191d;color:#fff;border-radius:9px;padding:9px;min-height:39px;text-transform:none;font-weight:400}.pdv-customer-grid [hidden],.pdv-customer-tabs [hidden],[data-pdv-customer-panel][hidden]{display:none!important}.pdv-customer-field-status{display:block;min-height:14px;font-size:10px;font-weight:600;text-transform:none;color:#94a3b8}.pdv-customer-field-status.success{color:#86efac}.pdv-customer-field-status.error{color:#fca5a5}.pdv-customer-document-valid{border-color:#166534!important}.pdv-customer-document-invalid{border-color:#b91c1c!important}.pdv-customer-full{grid-column:1/-1}.pdv-customer-cnpj-note{grid-column:1/-1;border:1px solid #1e3a5f;background:#0c1b2d;color:#bfdbfe;border-radius:10px;padding:10px;font-size:11px}.pdv-customer-message,.pdv-customer-duplicate{padding:10px;border-radius:9px;margin-top:12px}.pdv-customer-message.error{background:#3f1d0b;color:#fed7aa}.pdv-customer-message.success{background:#052e16;color:#bbf7d0}.pdv-customer-duplicate{border:1px solid #854d0e;background:#422006;color:#fde68a}.pdv-customer-duplicate p{margin:6px 0}.pdv-customer-duplicate-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.pdv-customer-savebar{display:flex;justify-content:flex-end;gap:8px;margin-top:15px;padding-top:13px;border-top:1px solid #30363d}@media(max-width:760px){.pdv-customer-grid{grid-template-columns:1fr}.pdv-customer-full{grid-column:auto}}
