 if(boot.current){const so=boot.current.serviceOrder||{};$('#customerId').value=boot.current.customerId||'';$('#identifier').value=boot.current.identifier||'';$('#sellerName').value=boot.current.sellerNameSnapshot||'';$('#customStatusId').value=boot.current.customStatusId||defaultStatusForType(boot.current.type);$('#notes').value=boot.current.notes||'';$('#osDevice').value=so.device||'';$('#osEquipmentId').value=so.equipmentId||'';$('#osIssue').value=so.issue||so.diagnosis||'';$('#osTechnician').value=so.technicianName||'';$('#osServicePerformed').value=so.servicePerformed||'';$('#osAccessories').value=so.accessories||'';state.unlockPatterns=[...(so.unlockPatterns||[])].map(pattern=>[...(pattern||[])]).slice(0,2);if(!state.unlockPatterns.length&&so.unlockPattern?.length)state.unlockPatterns=[[...so.unlockPattern],[]];while(state.unlockPatterns.length<2)state.unlockPatterns.push([]);renderPatternEditor(0);renderPatternEditor(1);$('#osCheckinNotes').value=so.checkin?.notes||'';$('#osCheckoutNotes').value=so.checkout?.notes||'';$('#osCustomerChecked').checked=!!so.checkout?.customerChecked;$('#osAccessoriesChecked').checked=!!so.checkout?.accessoriesChecked;$('#osGuidanceReceived').checked=!!so.checkout?.guidanceReceived;} syncPdvCustomerEditButton(); refreshPdvCustomerWallet();
 function renderPatternEditor(index){const grid=$(`#osPatternGrid${index+1}`);if(!grid)return;const pattern=state.unlockPatterns[index]||[];grid.innerHTML=Array.from({length:9},(_,pointIndex)=>{const point=pointIndex+1;const order=pattern.indexOf(point);return `<button type="button" data-pattern-point="${point}" class="${order>=0?'selected':''}" aria-label="Ponto ${point}">${order>=0?order+1:''}</button>`}).join('');grid.querySelectorAll('button').forEach(button=>button.onclick=()=>{const point=Number(button.dataset.patternPoint);const current=state.unlockPatterns[index]||[];state.unlockPatterns[index]=current.includes(point)?current.filter(item=>item!==point):[...current,point];renderPatternEditor(index);});const feedback=$(`#osPatternFeedback${index+1}`);if(feedback)feedback.textContent=pattern.length?`Registrada com ${pattern.length} ponto(s).`:'Nenhuma senha informada.';}
 function patternSvg(pattern=[]){const points=[[20,20],[60,20],[100,20],[20,60],[60,60],[100,60],[20,100],[60,100],[100,100]];const valid=(pattern||[]).map(Number).filter(point=>point>=1&&point<=9);const lines=valid.slice(1).map((point,index)=>{const [x1,y1]=points[valid[index]-1], [x2,y2]=points[point-1];return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`}).join('');const dots=points.map(([x,y],index)=>{const order=valid.indexOf(index+1);return `<circle cx="${x}" cy="${y}" r="${order>=0?8:7}" class="${order>=0?'active':''}"/>${order>=0?`<text x="${x}" y="${y+3}">${order+1}</text>`:''}`}).join('');return `<svg class="printed-pattern" viewBox="0 0 120 120" aria-label="Senha de desenho"><g class="pattern-lines">${lines}</g><g class="pattern-dots">${dots}</g></svg>`;}
 function renderChecklist(containerId,labels,saved=[]){const map=new Map((saved||[]).map(i=>[i.label,i]));$(containerId).innerHTML=labels.map(label=>{const item=map.get(label)||{};return `<div class="pdv-check-row" data-label="${esc(label)}"><b>${esc(label)}</b><select><option value="not_applicable">Não se aplica</option><option value="approved">Aprovado</option><option value="failed">Com problema</option><option value="not_tested">Não testado</option></select><input placeholder="Observação opcional" value="${esc(item.notes||'')}"></div>`}).join('');[...document.querySelectorAll(`${containerId} .pdv-check-row`)].forEach(r=>r.querySelector('select').value=map.get(r.dataset.label)?.status||'not_applicable');}
 function renderPhotos(){const list=boot.current?.serviceOrder?.attachments||[];$('#osPhotoGrid').innerHTML=list.map(a=>`<article><img src="${esc(a.url)}" alt="Foto da O.S."><span>${a.kind==='checkin'?'Entrada':a.kind==='checkout'?'Saída':'Geral'}</span><button type="button" data-id="${esc(a.id)}">Remover</button></article>`).join('')||'<p class="pdv-empty-photos">Nenhuma foto adicionada.</p>';document.querySelectorAll('#osPhotoGrid button').forEach(b=>b.onclick=async()=>{if(!confirm('Remover esta foto?'))return;try{const j=await api(`/erp/pdv/operacoes/${state.id}/anexos/${b.dataset.id}`,'DELETE',{version:state.version});applyServerOperation(j.operation);renderPhotos()}catch(e){alert(e.message)}});}
 async function compressPhoto(file){const img=await new Promise((ok,fail)=>{const i=new Image();i.onload=()=>ok(i);i.onerror=fail;i.src=URL.createObjectURL(file)});const max=1600,scale=Math.min(1,max/Math.max(img.width,img.height)),canvas=document.createElement('canvas');canvas.width=Math.round(img.width*scale);canvas.height=Math.round(img.height*scale);canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);return canvas.toDataURL('image/webp',0.78);}
 $('#btnAddPhoto').onclick=async()=>{if(!boot.openSession)return alert('Abra o caixa antes de alterar a O.S.');if(!state.id){alert('Salve a O.S. em aberto antes de adicionar fotos.');return}const file=$('#osPhotoInput').files[0];if(!file)return alert('Selecione uma foto.');try{$('#btnAddPhoto').disabled=true;$('#btnAddPhoto').textContent='Compactando...';const dataUrl=await compressPhoto(file);const j=await api(`/erp/pdv/operacoes/${state.id}/anexos`,'POST',{version:state.version,dataUrl,name:file.name,kind:$('#photoKind').value});applyServerOperation(j.operation);$('#osPhotoInput').value='';renderPhotos();alert(j.message)}catch(e){alert(e.message)}finally{$('#btnAddPhoto').disabled=false;$('#btnAddPhoto').textContent='Adicionar foto'}};
 if((boot.printOnly||new URLSearchParams(location.search).get('imprimir')==='1') && boot.current) setTimeout(()=>$('#btnPrint').click(),120);
 renderChecklist('#checkinChecklist',checkinItems,boot.current?.serviceOrder?.checkin?.items);renderChecklist('#checkoutChecklist',checkoutItems,boot.current?.serviceOrder?.checkout?.items);renderPhotos();
 setType(state.type); const initialPayments=Array.isArray(state.payments)?[...state.payments]:[]; (initialPayments.length?initialPayments:[{}]).forEach(rowPayment); renderItems(); $('#cashClosedBox').hidden=!!boot.openSession;$('#cashOpenBox').hidden=!boot.openSession; if(!boot.openSession){document.querySelectorAll('.pdv-main input,.pdv-main select,.pdv-main textarea,.pdv-main button,.pdv-side input,.pdv-side select,.pdv-side button,.pdv-type-switch button,#btnSave,#btnFinalize,#btnCancelOperation').forEach(el=>el.disabled=true);$('#operationStatus').textContent='Abra o caixa para operar';show('#modalCash');document.querySelector('#modalCash [data-close]').hidden=true;} lockFinalized();
})();
