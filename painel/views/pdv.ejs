<% layout('layout') -%>
<% if (printOnly) { %>
<style>
  body.pdv-print-only .topbar{display:none!important}
  body.pdv-print-only .container{max-width:none!important;margin:0!important;padding:0!important}
  body.pdv-print-only .pdv-shell{display:none!important}
  body.pdv-print-only{min-height:100vh;background:var(--panel-bg,#0b0b0b)}
  body.pdv-print-only .pdv-modal{background:rgba(0,0,0,.72)}
  body.pdv-print-only .pdv-print-modal{max-width:760px}
  .pdv-print-only-context{margin:0 0 12px;padding:9px 11px;border:1px solid var(--panel-border,#333);border-radius:8px;background:rgba(90,140,255,.08);font-size:12px}
  .pdv-print-only-context strong{display:block;margin-bottom:2px}
</style>
<% } %>

<style>
.pdv-shortcut-supervisor{margin-top:14px;padding-top:12px;border-top:1px solid var(--panel-border,#333);display:grid;gap:8px}.pdv-shortcut-supervisor>div{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.pdv-shortcut-supervisor strong{font-size:22px;letter-spacing:.18em;font-variant-numeric:tabular-nums}.pdv-shortcut-supervisor small{color:var(--muted);font-size:9px}.pdv-discount-code-label{display:grid;gap:6px;margin:14px 0 6px;font-weight:700}.pdv-discount-code-label input{font-size:26px;letter-spacing:.28em;text-align:center;font-weight:900;height:54px}.pdv-discount-code-help{display:block;color:var(--muted);font-size:10px;line-height:1.4}.pdv-supervisor-auth{margin-top:12px;border:1px solid var(--panel-border,#333);border-radius:10px;padding:9px}.pdv-supervisor-auth summary{cursor:pointer;font-size:11px;font-weight:800}.pdv-supervisor-auth>div{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;align-items:end;margin-top:9px}.pdv-supervisor-auth label{display:grid;gap:4px;font-size:10px}.pdv-supervisor-auth input{height:38px}.pdv-self-approval{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding:10px 11px;border:1px solid color-mix(in srgb,var(--brand,#3b82f6) 42%,var(--panel-border,#333));border-radius:10px;background:color-mix(in srgb,var(--brand,#3b82f6) 7%,transparent)}.pdv-self-approval span{display:grid;gap:2px;font-size:11px}.pdv-self-approval small{color:var(--muted);font-size:9px}
.pdv-discount-editor{display:grid;grid-template-columns:58px minmax(78px,1fr);gap:5px;align-items:center}.pdv-discount-editor select,.pdv-discount-editor input{min-width:0;width:100%;box-sizing:border-box}.pdv-freight-summary>div{display:flex;align-items:center;gap:7px}.pdv-freight-summary .btn{padding:5px 8px;font-size:10px}.pdv-freight-modal{max-width:720px}.pdv-freight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.pdv-freight-grid label{display:grid;gap:5px;font-size:10px;font-weight:800}.pdv-freight-grid input,.pdv-freight-grid select{width:100%;box-sizing:border-box}.pdv-freight-grid .wide{grid-column:span 2}.pdv-freight-totals{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:13px 0}.pdv-freight-totals>div{padding:9px;border:1px solid var(--panel-border,#333);border-radius:9px;display:grid;gap:3px}.pdv-freight-totals span{font-size:9px;color:var(--muted);text-transform:uppercase;font-weight:800}.pdv-freight-totals b{font-size:15px}@media(max-width:760px){.pdv-freight-grid{grid-template-columns:1fr}.pdv-freight-grid .wide{grid-column:auto}.pdv-freight-totals{grid-template-columns:1fr}}
.pdv-customer-wallet-banner{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 10px;padding:8px 12px;border:1px solid color-mix(in srgb,#16a34a 34%,var(--panel-border,#333));border-radius:10px;background:color-mix(in srgb,#16a34a 8%,var(--card,#111));color:var(--text,#fff)}.pdv-customer-wallet-banner[hidden]{display:none!important}.pdv-customer-wallet-banner>div{display:flex;align-items:center;gap:8px;min-width:0}.pdv-customer-wallet-banner span{font-size:10px;color:var(--muted,#9ca3af)}.pdv-customer-wallet-banner strong{font-size:15px;color:#22c55e;white-space:nowrap}.pdv-customer-wallet-banner small{font-size:9px;color:var(--muted,#9ca3af);white-space:nowrap}
</style>
<div class="pdv-shell" data-current-id="<%= current?.id || '' %>">
  <header class="pdv-head pdv-head-compact">
    <div class="pdv-title-stack"><h1>PDV</h1><span class="pdv-version">v0.15.0</span></div>
    <section class="pdv-cashbar pdv-cashbar-inline">
      <div><b>Caixa:</b><select id="cashbox"><% cashboxes.forEach(c=>{ %><option value="<%= c.id %>" <%= selectedCashboxId===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
      <div id="cashStatus" class="pdv-cash-status <%= openSession?'open':'closed' %>"><%= openSession?'● Aberto':'● Fechado' %></div>
      <div><b id="cashBalanceLabel"><%= openSession ? 'Saldo' : 'Saldo anterior' %></b><strong id="cashBalance">R$ <%= Number(cashBalance||0).toLocaleString('pt-BR',{minimumFractionDigits:2}) %></strong></div>
      <% if (openSession) { %><a class="btn" id="btnCashMovements" href="/erp/pdv/caixa?caixa=<%= encodeURIComponent(selectedCashboxId || '') %>">Movimentações</a><% } else { %><button class="btn" id="btnCash">Abrir caixa</button><% } %>
    </section>
    <div class="pdv-head-actions">
      <button class="btn" id="btnOperations">🔎 Buscar operações <kbd>Ctrl+A</kbd></button>
      <% if (typeof canReturns !== 'undefined' && canReturns) { %><a class="btn" href="/erp/pdv/trocas-devolucoes">↩ Troca / devolução</a><% } %>
      <button class="btn pdv-shortcuts-trigger" id="btnShortcuts" title="Atalhos do PDV (F1)" aria-label="Atalhos do PDV">⌨️ <kbd>F1</kbd></button>
      <button class="btn primary" id="btnNew">＋ Nova operação</button>
    </div>
  </header>

  <% if (typeof exchangeContext !== 'undefined' && exchangeContext) { %>
  <div class="pdv-exchange-context">
    <div>
      <strong>↩ Troca em andamento · <%= exchangeContext.record.number %></strong>
      <span>Cliente: <b><%= exchangeContext.record.customerName %></b> · Selecione abaixo o novo produto normalmente.</span>
    </div>
    <div class="pdv-exchange-credit">
      <small>Crédito disponível</small>
      <b><%= Number(exchangeContext.wallet?.balance||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></b>
      <span>Use “Crédito do cliente / troca” no pagamento.</span>
    </div>
  </div>
  <% } %>

  <div class="pdv-customer-wallet-banner" id="pdvCustomerWalletBanner" hidden>
    <div><span>💳 Crédito disponível do cliente</span><strong id="pdvCustomerWalletBalance">R$ 0,00</strong></div>
    <small>Use “Crédito do cliente / troca” como forma de pagamento.</small>
  </div>

  <section class="pdv-workspace">
    <div class="pdv-main">
      <div class="pdv-operation-top">
        <div class="pdv-type-switch"><button data-type="sale" class="active">🛒 Venda</button><button data-type="service_order">🛠️ O.S.</button></div>
        <span id="operationNumber" class="pdv-operation-number"><%= current ? '#'+current.number : 'Nova operação' %></span>
        <span class="pdv-status-pill" id="operationStatus"><%= current?.status === 'finalized' ? 'Finalizada' : current?.status === 'awaiting_payment' ? 'Aguardando pagamento' : current?.status === 'cancelled' ? 'Cancelada' : 'Em aberto' %></span>
      </div>

      <div class="pdv-fields-grid pdv-fields-smart">
        <label class="pdv-customer-field">Cliente<div class="pdv-field-with-action"><select id="customerId"><option value="">Consumidor final</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" data-name="<%= c.name %>"><%= c.name %><%= c.documentFormatted ? ` - ${c.documentFormatted}` : (c.document ? ` - ${c.document}` : '') %></option><% }) %></select><button class="btn pdv-mini-action" id="btnCustomerEdit" type="button" title="Editar cliente" aria-label="Editar cliente" hidden>✎</button><button class="btn pdv-mini-action" id="btnCustomerSearch" title="Pesquisar / adicionar cliente">🔎</button></div></label>
        <label class="pdv-identifier-field" title="Dê dois cliques para informar nome, telefone ou referência">Identificador <span class="pdv-muted-note">(duplo clique)</span><input id="identifier" class="pdv-identifier-collapsed" placeholder="✎" readonly></label>
        <% const initialSellerName=current?.sellerNameSnapshot || automaticSeller || ''; const legacySellerNames=[...(cashboxSettings.allowedSellers||[]),initialSellerName].filter(Boolean).filter((name,index,arr)=>arr.indexOf(name)===index && !(sellerUsers||[]).some(user=>String(user.displayName||user.name).trim().toLowerCase()===String(name).trim().toLowerCase())); %><label>Vendedor principal<select id="sellerName"><option value="">Selecione o usuário vendedor</option><% (sellerUsers||[]).forEach(user=>{ const operationalName=user.displayName||user.name; %><option value="<%= operationalName %>" <%= String(initialSellerName).trim().toLowerCase()===String(operationalName).trim().toLowerCase()?'selected':'' %>><%= operationalName %><%= operationalName!==user.name ? ` · ${user.name}` : `` %></option><% }) %><% legacySellerNames.forEach(name=>{ %><option value="<%= name %>" <%= String(initialSellerName)===String(name)?'selected':'' %>><%= name %> · histórico</option><% }) %></select></label><label>Status da operação<select id="customStatusId"><% operationStatuses.filter(s=>s.active!==false).forEach(s=>{ %><option value="<%= s.id %>" data-sale-default="<%= s.defaultSale?'1':'0' %>" data-os-default="<%= s.defaultOs?'1':'0' %>" <%= current?.customStatusId===s.id?'selected':'' %>><%= s.name %></option><% }) %></select></label>
      </div>

      <div class="pdv-product-entry">
        <label>Produto / serviço<div class="pdv-product-search-wrap"><div class="pdv-field-with-action"><input id="productSearch" autocomplete="off" placeholder="Pesquise por nome, código, SKU ou código de barras [F5]"><button class="btn pdv-mini-action" id="btnProductSearch" title="Abrir lista de produtos">🔎</button></div><div class="pdv-product-quick-list" id="productQuickList" hidden></div></div></label>
        <label>Quantidade<input type="number" id="productQty" value="1" min="0.001" step="0.001"></label>
        <button class="btn primary" id="btnAddProduct">Adicionar</button>
      </div>

      <div class="pdv-table-wrap"><table class="pdv-table"><thead><tr><th>Produto / serviço</th><th>Qtd.</th><th>Valor unit.</th><th>Desconto</th><th>Vendedor do item</th><th>Subtotal</th><th></th></tr></thead><tbody id="itemsBody"></tbody></table></div>

      <div class="pdv-os-panel" id="osPanel" hidden>
        <div class="pdv-os-title"><div><h3>Ordem de Serviço</h3><p>Preencha somente o necessário. Check-in, check-out e fotos são opcionais.</p></div></div>
        <div class="pdv-fields-grid pdv-os-main-grid">
          <label>Equipamento<input id="osDevice" placeholder="Ex.: iPhone 13, Notebook Dell, Impressora Brother"></label>
          <label>Identificação do equipamento <span class="pdv-muted-note">(opcional)</span><input id="osEquipmentId" placeholder="Número de série, patrimônio ou referência"></label>
          <label>Técnico responsável<select id="osTechnician"><option value="">Selecione o usuário técnico</option><% (technicianUsers||[]).forEach(user=>{ %><option value="<%= user.displayName || user.name %>"><%= user.displayName || user.name %><%= (user.displayName||user.name)!==user.name ? ` · ${user.name}` : `` %></option><% }) %><% const legacyTech=current?.serviceOrder?.technicianName||''; if(legacyTech && !(technicianUsers||[]).some(user=>String(user.displayName||user.name).trim().toLowerCase()===String(legacyTech).trim().toLowerCase())){ %><option value="<%= legacyTech %>"><%= legacyTech %> · histórico</option><% } %></select></label>
        </div>
        <label>Problema relatado / diagnóstico inicial<textarea id="osIssue" rows="3" placeholder="Relato do cliente e diagnóstico inicial no mesmo campo"></textarea></label>
        <label>Serviço realizado<textarea id="osServicePerformed" rows="4" placeholder="Descreva as etapas realizadas para solucionar o problema"></textarea></label>
        <label>Acessórios recebidos <span class="pdv-muted-note">(opcional)</span><input id="osAccessories" placeholder="Ex.: carregador, fonte, cabo USB, capa, mouse"></label>

        <details class="pdv-os-section" id="osPasswordSection">
          <summary><span>🔐 Senhas de desenho</span><small>Opcionais · até duas senhas diferentes</small></summary>
          <div class="pdv-os-section-body">
            <div class="pdv-pattern-pair-editor">
              <div class="pdv-pattern-editor">
                <strong>Senha 1</strong>
                <div class="pdv-pattern-grid" id="osPatternGrid1" aria-label="Primeira senha de desenho"></div>
                <div class="pdv-pattern-actions">
                  <p id="osPatternFeedback1">Nenhuma senha informada.</p>
                  <button class="btn" id="btnClearPattern1" type="button">Limpar senha 1</button>
                </div>
              </div>
              <div class="pdv-pattern-editor">
                <strong>Senha 2</strong>
                <div class="pdv-pattern-grid" id="osPatternGrid2" aria-label="Segunda senha de desenho"></div>
                <div class="pdv-pattern-actions">
                  <p id="osPatternFeedback2">Nenhuma senha informada.</p>
                  <button class="btn" id="btnClearPattern2" type="button">Limpar senha 2</button>
                </div>
              </div>
            </div>
          </div>
        </details>

        <details class="pdv-os-section" id="osCheckinSection">
          <summary><span>📥 Check-in do equipamento</span><small>Opcional · estado na entrada</small></summary>
          <div class="pdv-os-section-body">
            <label>Estado físico / observações de entrada<textarea id="osCheckinNotes" rows="3" placeholder="Riscos, trincas, amassados, peças faltando ou outras observações"></textarea></label>
            <div class="pdv-checklist" id="checkinChecklist"></div>
          </div>
        </details>

        <details class="pdv-os-section" id="osCheckoutSection">
          <summary><span>✅ Check-out e testes finais</span><small>Opcional · validação antes da entrega</small></summary>
          <div class="pdv-os-section-body">
            <div class="pdv-checklist" id="checkoutChecklist"></div>
            <label>Observações finais do check-out<textarea id="osCheckoutNotes" rows="3" placeholder="Resultados, limitações ou orientações ao cliente"></textarea></label>
            <div class="pdv-delivery-checks"><label><input type="checkbox" id="osCustomerChecked"> Cliente conferiu o equipamento</label><label><input type="checkbox" id="osAccessoriesChecked"> Cliente conferiu os acessórios</label><label><input type="checkbox" id="osGuidanceReceived"> Cliente recebeu orientações</label></div>
          </div>
        </details>

        <details class="pdv-os-section" id="osPhotosSection">
          <summary><span>🖼️ Fotos da O.S.</span><small>Até 3 fotos · compactação automática</small></summary>
          <div class="pdv-os-section-body">
            <div class="pdv-photo-toolbar"><select id="photoKind"><option value="checkin">Foto de entrada</option><option value="checkout">Foto de saída</option><option value="general">Foto geral</option></select><input type="file" id="osPhotoInput" accept="image/*" capture="environment"><button class="btn" id="btnAddPhoto" type="button">Adicionar foto</button></div>
            <p class="pdv-modal-help">A imagem é reduzida para no máximo 1600 px e salva em WebP. O limite total é de três fotos por O.S.</p>
            <div class="pdv-photo-grid" id="osPhotoGrid"></div>
          </div>
        </details>
      </div>

      <label class="pdv-notes">Observação geral<textarea id="notes" rows="2" placeholder="Informação interna da venda ou O.S."></textarea></label>
    </div>

    <aside class="pdv-side">
      <div class="pdv-summary"><div><span>Subtotal</span><b id="subtotal">R$ 0,00</b></div><div><span>Descontos</span><b id="discountTotal">R$ 0,00</b></div><div class="pdv-freight-summary"><span>Frete / despesas</span><div><b id="freightTotal">R$ 0,00</b><button class="btn" id="btnFreight" type="button">🚚 Frete</button></div></div><div class="pdv-coupon-box"><label>Cupom de desconto</label><div><input id="couponCode" placeholder="Código" value="<%= current?.coupon?.code || '' %>"><button class="btn" id="btnApplyCoupon" type="button">Aplicar</button><button class="pdv-icon-btn" id="btnRemoveCoupon" type="button" title="Remover cupom">×</button></div><small id="couponFeedback"><%= current?.coupon ? `${current.coupon.name} · - ${Number(current.couponDiscount||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}` : '' %></small></div><div class="total"><span>Total da operação</span><strong id="total">R$ 0,00</strong></div></div>
      <div class="pdv-payments-head"><h3>Pagamentos</h3><button class="btn" id="btnAddPayment">＋ Adicionar</button></div>
      <div id="payments"></div>
      <div class="pdv-payment-summary"><div><span>Total pago</span><b id="amountPaid">R$ 0,00</b></div><div class="pending"><span>Pendente</span><strong id="amountPending">R$ 0,00</strong></div><div class="change"><span>Troco</span><strong id="change">R$ 0,00</strong></div></div>
    </aside>
  </section>

  <footer class="pdv-bottom-actions">
    <div class="pdv-bottom-left">
      <button class="btn" id="btnPrint">🖨️ Imprimir <kbd>F9</kbd></button>
      <button class="btn warn" id="btnCancelOperation" <%= current && !['finalized','cancelled'].includes(current.status) ? '' : 'disabled' %>>Cancelar</button><button class="btn" id="btnSave">💾 Salvar em aberto <kbd>F10</kbd></button>
    </div>
    <button class="btn primary pdv-finalize-wide" id="btnFinalize">✓ Finalizar operação <kbd>F12</kbd></button>
  </footer>
</div>


<div class="pdv-modal" id="modalCustomerSearch" hidden><div class="pdv-modal-card wide pdv-customer-search-modal"><button class="pdv-close" data-close>×</button><h2>Pesquisar / adicionar cliente</h2><p class="pdv-modal-help">Pesquise por nome, telefone, CPF/CNPJ ou e-mail. <span class="help-tip" tabindex="0" data-tooltip="Se o cliente não estiver cadastrado, pesquise pelo CPF/CNPJ para iniciar um novo cadastro.">i</span></p><input id="customerSearchInput" placeholder="Nome, telefone, CPF/CNPJ ou e-mail"><div class="pdv-search-list" id="customerSearchList"></div><div class="pdv-customer-search-footer"><span aria-hidden="true">＋</span> Cliente não encontrado? Pesquise pelo CPF/CNPJ para cadastrar rapidamente.</div></div></div>

<div class="pdv-modal" id="modalCustomerCreate" hidden><div class="pdv-modal-card wide pdv-customer-create-modal"><button class="pdv-close" data-close>×</button><div class="pdv-customer-create-head"><div><span class="pdv-customer-kicker">CADASTRO DE CLIENTE</span><h2 id="pdvCustomerFormTitle">Novo cliente</h2><p class="pdv-modal-help" id="pdvCustomerFormHelp">Cadastre sem sair do PDV. Ao salvar, o cliente será selecionado automaticamente nesta operação.</p></div></div><div class="pdv-customer-tabs"><button type="button" class="active" data-pdv-customer-tab="main">Dados principais</button><button type="button" data-pdv-customer-tab="address">Endereço</button><button type="button" data-pdv-customer-tab="relationship">Relacionamento</button></div><form id="pdvCustomerCreateForm"><section data-pdv-customer-panel="main"><div class="pdv-customer-grid"><label>Tipo de pessoa *<select name="personType" id="pdvCustomerPersonType"><option value="pf">Pessoa física</option><option value="pj">Pessoa jurídica</option></select></label><label><span id="pdvCustomerDocumentLabel">CPF</span><input name="document" id="pdvCustomerDocument" inputmode="numeric" autocomplete="off" maxlength="18"><small id="pdvCustomerDocumentStatus" class="pdv-customer-field-status" aria-live="polite"></small></label><label>Nome / Razão social *<input name="name" id="pdvCustomerName" maxlength="160" required></label><label class="pdv-customer-pj" hidden>Nome fantasia<input name="tradeName" maxlength="160"></label><label>RG / Inscrição estadual<input name="stateRegistration"></label><label class="pdv-customer-pf">Data de nascimento<input name="birthDate" id="pdvCustomerBirthDate" type="text" inputmode="numeric" maxlength="10" placeholder="dd/mm/aaaa" autocomplete="off"></label><label class="pdv-customer-pf">Renda mensal<input name="monthlyIncome" type="number" min="0" step="0.01"></label><label class="pdv-customer-pf">Profissão<input name="profession" maxlength="120"></label><label class="pdv-customer-pf">Cônjuge<input name="spouseName" maxlength="160"></label><label class="pdv-customer-pf">Nome do pai<input name="fatherName" maxlength="160"></label><label class="pdv-customer-pf">Nome da mãe<input name="motherName" maxlength="160"></label><label>Celular / WhatsApp<input name="mobile" inputmode="tel"></label><label>Telefone<input name="phone" inputmode="tel"></label><label class="pdv-customer-full">E-mail<input name="email" type="email"></label><div class="pdv-customer-cnpj-note pdv-customer-pj" hidden>Ao informar um CNPJ válido, o Painel Quality pode consultar os dados públicos da empresa e preencher o cadastro.</div><label class="pdv-customer-pj" hidden>Situação cadastral<input name="companyStatus"></label><label class="pdv-customer-pj" hidden>Data de abertura<input name="openingDate" type="date"></label><label class="pdv-customer-pj" hidden>Natureza jurídica<input name="legalNature"></label><label class="pdv-customer-pj" hidden>Porte<input name="companySize"></label><label class="pdv-customer-pj pdv-customer-full" hidden>Atividade principal (CNAE)<input name="primaryCnae"></label></div></section><section data-pdv-customer-panel="address" hidden><div class="pdv-customer-grid"><label>CEP<input name="zipCode" id="pdvCustomerZipCode" inputmode="numeric"><small id="pdvCustomerZipStatus" class="pdv-customer-field-status" aria-live="polite"></small></label><label>Estado<input name="state" maxlength="2"></label><label class="pdv-customer-full">Endereço<input name="street"></label><label>Número<input name="number"></label><label>Complemento<input name="complement"></label><label>Bairro<input name="district"></label><label>Cidade<input name="city"></label></div></section><section data-pdv-customer-panel="relationship" hidden><div class="pdv-customer-grid"><label>Limite de crédito<input name="creditLimit" type="number" min="0" step="0.01"></label><label>Classificação<select name="classificationId"><% (customerClassifications || []).forEach(item=>{ %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select></label><label>Origem do cliente<input name="origin" placeholder="WhatsApp, indicação, loja..."></label><label>Situação<select name="active"><option value="true">Ativo</option><option value="false">Inativo</option></select></label><label class="pdv-customer-full">Observações<textarea name="notes" rows="4" maxlength="2000"></textarea></label></div></section><div id="pdvCustomerDuplicateBox" class="pdv-customer-duplicate" hidden></div><div id="pdvCustomerCreateMessage" class="pdv-customer-message" hidden></div><div class="pdv-customer-savebar"><button type="button" class="btn" id="btnBackCustomerSearch">Voltar à busca</button><button type="submit" class="btn primary" id="btnSavePdvCustomer">Salvar e usar no PDV</button></div></form></div></div>
<div class="pdv-modal" id="modalProductSearch" hidden><div class="pdv-modal-card wide"><button class="pdv-close" data-close>×</button><h2>Buscar produto / serviço</h2><p class="pdv-modal-help">Pesquise por nome, código, SKU, categoria ou código de barras.</p><input id="productSearchInput" placeholder="Digite para pesquisar"><div class="pdv-search-list" id="productSearchList"></div></div></div>
