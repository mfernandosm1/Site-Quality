<% layout('layout') -%>
<% const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}); const date=v=>v?new Date(v).toLocaleDateString('pt-BR'):'—'; %>
<section class="customer-print-sheet">
  <header><div><span>QUALITY ERP</span><h1>Ficha do cliente</h1><p>Emitida em <%= new Date(printedAt).toLocaleString('pt-BR') %></p></div><div class="no-print"><button class="btn" onclick="window.print()">Imprimir</button><button class="btn" onclick="window.close()">Fechar</button></div></header>
  <h2><%= customer.name %></h2><p>Código <%= customer.code %> · <%= customer.active===false?'Inativo':'Ativo' %></p>
  <div class="customer-print-grid"><div><span>CPF/CNPJ</span><b><%= customer.document||'—' %></b></div><div><span>Celular</span><b><%= customer.mobile||'—' %></b></div><div><span>Telefone</span><b><%= customer.phone||'—' %></b></div><div><span>E-mail</span><b><%= customer.email||'—' %></b></div><div><span>Endereço</span><b><%= [customer.street,customer.number,customer.district,customer.city,customer.state].filter(Boolean).join(', ')||'—' %></b></div><div><span>Profissão</span><b><%= customer.profession||'—' %></b></div><div><span>Renda mensal</span><b><%= money(customer.monthlyIncome) %></b></div><div><span>Limite de crédito</span><b><%= money(customer.creditLimit) %></b></div></div>
  <h3>Resumo financeiro</h3><div class="customer-print-grid"><div><span>Em aberto</span><b><%= money(credit.openBalance) %></b></div><div><span>Vencido</span><b><%= money(credit.overdueBalance) %></b></div><div><span>Total recebido</span><b><%= money(credit.totalReceived) %></b></div><div><span>Carteira do cliente</span><b><%= money(wallet.balance) %></b></div></div>
  <h3>Observações</h3><p class="customer-print-notes"><%= customer.notes||'Sem observações.' %></p>
</section>
<style>.customer-print-sheet{max-width:980px;margin:20px auto;padding:24px;background:#fff;color:#111;border-radius:12px}.customer-print-sheet header{display:flex;justify-content:space-between;border-bottom:2px solid #111;padding-bottom:14px}.customer-print-sheet h1{margin:3px 0}.customer-print-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:14px 0}.customer-print-grid>div{border:1px solid #ccc;padding:10px;border-radius:8px}.customer-print-grid span{display:block;font-size:11px;color:#555}.customer-print-notes{border:1px solid #ccc;min-height:70px;padding:12px}@media print{body{background:#fff!important}.site-header,.no-print{display:none!important}.customer-print-sheet{margin:0;max-width:none;box-shadow:none}}</style>
