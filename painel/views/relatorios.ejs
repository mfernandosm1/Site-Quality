<% layout('layout') -%>
<section class="reports-page" data-reports-page>
  <header class="reports-hero">
    <div>
      <span class="reports-kicker">GESTÃO · RELATÓRIOS</span>
      <h1>📋 Central de Relatórios</h1>
      <p>Uma única base para vendas, lucratividade, produtos, giro de estoque, vendedores, descontos, compras e despesas.</p>
    </div>
    <div class="reports-hero-actions no-print">
      <a class="btn" href="/erp/metas-comissoes">🎯 Metas e Comissões</a>
      <button class="btn" type="button" id="reportsExportCsv">Exportar CSV</button>
      <button class="btn" type="button" id="reportsPrint">Imprimir / PDF</button>
    </div>
  </header>

  <form class="reports-filters no-print" id="reportsFilters">
    <input type="hidden" name="productKind" id="reportsProductKind" value="all">
    <input type="hidden" name="turnoverView" id="reportsTurnoverView" value="all">
    <input type="hidden" name="inactiveDays" value="30">
    <div class="reports-quick-dates">
      <button type="button" data-report-period="month">Este mês</button>
      <button type="button" data-report-period="previous">Mês anterior</button>
      <button type="button" data-report-period="90">Últimos 90 dias</button>
      <button type="button" data-report-period="year">Este ano</button>
      <span class="reports-filter-note"><i class="reports-info" title="Os campos abaixo mudam conforme o relatório. Filtros sem efeito naquela visão ficam ocultos automaticamente.">i</i> Somente filtros aplicáveis ficam visíveis</span>
    </div>
    <div class="reports-filter-grid">
      <label data-date-filter><span>De</span><input type="date" name="from" value="<%= reportDefaults.from %>"></label>
      <label data-date-filter><span>Até</span><input type="date" name="to" value="<%= reportDefaults.to %>"></label>
      <label data-movement-filter><span class="reports-filter-caption">Movimento <i class="reports-info" title="Usado apenas em relatórios derivados de vendas e O.S. Permite analisar os dois juntos ou separar cada tipo.">i</i></span><select name="type"><option value="all">Vendas + O.S.</option><option value="sale">Somente vendas</option><option value="service_order">Somente O.S.</option></select></label>
      <label data-seller-filter><span class="reports-filter-caption">Vendedor <i class="reports-info" title="Filtra somente operações vinculadas ao vendedor selecionado. Não é aplicado aos dados financeiros históricos importados da WM10.">i</i></span><select name="seller" id="reportsSeller"><option value="all">Todos</option></select></label>
      <label class="reports-search" data-search-filter><span class="reports-filter-caption">Buscar <i class="reports-info" title="A busca é aplicada aos campos relevantes da visão atual, como produto, cliente, fornecedor, número da venda, NF ou usuário.">i</i></span><input type="search" name="q" placeholder="Buscar neste relatório..."></label>
      <label class="reports-product-sort-filter" data-product-sort-filter hidden><span class="reports-filter-caption">Ordenar produtos por <i class="reports-info" title="Define qual indicador monta o ranking de Produtos mais vendidos: quantidade, faturamento, lucro, margem ou desconto.">i</i></span><select name="productSort"><option value="quantity" selected>Quantidade vendida</option><option value="revenue">Faturamento</option><option value="profit">Lucro</option><option value="margin">Margem</option><option value="discount">Desconto concedido</option></select></label>
      <label class="reports-top-filter" data-top-filter hidden><span class="reports-filter-caption">Top <i class="reports-info" title="Quantidade máxima de linhas exibidas no ranking de Produtos mais vendidos. Ex.: Top 20 mostra os 20 primeiros conforme a ordenação escolhida.">i</i></span><select name="top"><option>10</option><option>20</option><option selected>50</option><option>100</option><option>300</option></select></label>
      <label class="reports-stale-filter" data-stale-filter hidden><span class="reports-filter-caption">Sem giro a partir de <i class="reports-info" title="No Giro / Estoque parado, define quantos dias sem venda fazem o produto ser marcado como estoque sem giro.">i</i></span><select name="staleDays"><option value="30">30 dias</option><option value="60">60 dias</option><option value="90" selected>90 dias</option><option value="180">180 dias</option><option value="365">365 dias</option></select></label>
      <label class="reports-customer-mode-filter" data-customer-mode-filter hidden><span class="reports-filter-caption">Visão de clientes <i class="reports-info" title="Reativação mostra quem está há muito tempo sem comprar. Mais retornam ordena pela quantidade de compras/visitas. Mais itens comprados soma as quantidades dos itens. Maior valor ordena pelo total gasto.">i</i></span><select name="customerMode"><option value="inactive">Inativos / reativação</option><option value="frequency">Mais retornam / compram</option><option value="quantity">Mais itens comprados</option><option value="value">Maior valor comprado</option></select></label>
      <label class="reports-customer-window-filter" data-customer-window-filter hidden><span class="reports-filter-caption">Janela de análise <i class="reports-info" title="Usada nas visões Mais frequentes e Maior valor. Analisa somente compras ocorridas nos últimos 30 dias, 3, 6, 9, 12 meses ou em todo o histórico WM10 + Quality ERP.">i</i></span><select name="customerWindow"><option value="30">Últimos 30 dias</option><option value="90" selected>Últimos 3 meses</option><option value="180">Últimos 6 meses</option><option value="270">Últimos 9 meses</option><option value="365">Últimos 12 meses</option><option value="all">Todo o período</option></select></label>
      <label class="reports-inactive-filter" data-customer-inactive-range-filter hidden><span class="reports-filter-caption">Faixa sem comprar <i class="reports-info" title="Separa reativação recente de clientes realmente inativos. Use 30–59 dias para contatos mais quentes e 300+ dias para inativos antigos.">i</i></span><select name="customerInactiveRange"><option value="30plus">Todos com 30+ dias</option><option value="30_59">30 a 59 dias · reativação quente</option><option value="60_89">60 a 89 dias · reativação</option><option value="90_179">90 a 179 dias · atenção</option><option value="180_299">180 a 299 dias · reativação fria</option><option value="300plus">300+ dias · inativos</option><option value="never">Nunca compraram</option></select></label>
      <label class="reports-inactive-filter" data-customer-inactive-sort-filter hidden><span class="reports-filter-caption">Ordenar reativação <i class="reports-info" title="Recentes primeiro mostra quem acabou de entrar na faixa de reativação. Mais antigos primeiro prioriza quem está há mais tempo sem voltar.">i</i></span><select name="customerInactiveSort"><option value="recent" selected>Mais recentes primeiro</option><option value="oldest">Mais antigos primeiro</option><option value="purchases">Mais compras no histórico</option><option value="value">Maior valor no histórico</option></select></label>
      <button class="btn primary reports-apply" type="submit">Aplicar</button>
    </div>
  </form>

  <nav class="reports-tabs no-print" aria-label="Tipos de relatório">
    <button type="button" class="active" data-report-view="overview">Resumo</button>
    <button type="button" data-report-view="profitability">Lucratividade</button>
    <button type="button" data-report-view="products">Produtos mais vendidos</button>
    <button type="button" data-report-view="turnover">Giro / Estoque parado</button>
    <button type="button" data-report-view="sellers">Vendedores</button>
    <button type="button" data-report-view="discounts">Descontos</button>
    <button type="button" data-report-view="sales">Vendas detalhadas</button>
    <button type="button" data-report-view="payments">Formas de pagamento</button>
    <button type="button" data-report-view="purchases">Compras</button>
    <button type="button" data-report-view="returns">Trocas / Devoluções</button>
    <button type="button" data-report-view="expenses">Despesas</button>
    <button type="button" data-report-view="health">Saúde financeira</button>
    <button type="button" data-report-view="customers">Clientes / Reativação</button>
    <button type="button" data-report-view="counts">Contagens</button>
    <button type="button" data-report-view="audit">Auditoria</button>
  </nav>

  <section class="reports-context" id="reportsContext"></section>
  <section class="reports-summary" id="reportsSummary" aria-label="Indicadores do relatório"></section>
  <section class="reports-body" id="reportsBody"><div class="reports-loading">Carregando relatório...</div></section>
</section>

<script>window.QUALITY_REPORT_DEFAULTS=<%- JSON.stringify(reportDefaults) %>;</script>
<script src="/public/js/relatorios.js"></script>

<style>
.reports-page{display:grid;gap:14px}.reports-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:18px 20px;border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:0 8px 30px rgba(15,23,42,.05)}.reports-kicker{display:block;font-size:11px;letter-spacing:.12em;font-weight:800;color:var(--muted);margin-bottom:5px}.reports-hero h1{margin:0 0 5px;font-size:26px;color:var(--text)}.reports-hero p{margin:0;max-width:840px;color:var(--muted)}.reports-hero-actions{display:flex;gap:8px;flex-wrap:wrap}
.reports-filters{border:1px solid var(--line);border-radius:14px;background:var(--card);padding:12px}.reports-quick-dates{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:10px}.reports-filter-note{margin-left:auto;display:inline-flex;align-items:center;gap:5px;font-size:10px;color:var(--muted)}.reports-filter-caption{display:inline-flex!important;align-items:center;gap:5px}.reports-info{display:inline-grid;place-items:center;width:15px;height:15px;border:1px solid color-mix(in srgb,var(--blue) 55%,var(--line));border-radius:50%;font:800 10px/1 sans-serif;font-style:normal;color:var(--blue);cursor:help;text-transform:none;letter-spacing:0}.reports-quick-dates button,.reports-tabs button{border:1px solid var(--line);background:color-mix(in srgb,var(--card) 94%,var(--text));color:var(--text);border-radius:999px;padding:7px 11px;cursor:pointer;font:inherit;font-size:12px;font-weight:700}.reports-quick-dates button:hover,.reports-tabs button:hover{border-color:color-mix(in srgb,var(--brand) 45%,var(--line))}.reports-filter-grid{display:grid;grid-template-columns:140px 140px 170px minmax(160px,190px) minmax(220px,1fr) auto;gap:8px;align-items:end}.reports-filter-grid label{display:grid;gap:4px;min-width:0}.reports-filter-grid label span{font-size:11px;font-weight:800;color:var(--muted)}.reports-filter-grid input,.reports-filter-grid select{height:36px;min-width:0;border:1px solid var(--line);border-radius:10px;padding:0 9px;background:var(--card);color:var(--text)}.reports-apply{height:36px;white-space:nowrap}.reports-top-filter,.reports-stale-filter{grid-column:auto}
.reports-tabs{display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:0 0 10px}.reports-tabs button{border-radius:10px}.reports-tabs button.active{background:var(--brand)!important;color:#fff!important;border-color:var(--brand)!important}.reports-context{font-size:12px;color:var(--muted);min-height:16px}.reports-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}.report-stat{border:1px solid var(--line);border-radius:13px;background:var(--card);padding:13px 14px;min-width:0}.report-stat span{display:block;font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.report-stat strong{display:block;color:var(--text);font-size:21px;margin-top:5px;overflow:hidden;text-overflow:ellipsis}.report-stat small{display:block;color:var(--muted);margin-top:4px}.report-stat.positive strong{color:#15803d}.report-stat.negative strong{color:#b91c1c}.report-stat.info strong{color:#2563eb}.report-stat.warning strong{color:#d97706}.reports-page[data-active-view="purchases"] .reports-summary,.reports-page[data-active-view="expenses"] .reports-summary{grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:8px}.reports-page[data-active-view="purchases"] .report-stat,.reports-page[data-active-view="expenses"] .report-stat{padding:10px 11px;border-radius:11px}.reports-page[data-active-view="purchases"] .report-stat strong,.reports-page[data-active-view="expenses"] .report-stat strong{font-size:18px}.reports-page[data-active-view="purchases"] .report-stat span,.reports-page[data-active-view="expenses"] .report-stat span{font-size:9px}.reports-page[data-active-view="purchases"] .report-stat small,.reports-page[data-active-view="expenses"] .report-stat small{font-size:10px}
.reports-body{min-width:0}.report-panel{border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden}.report-panel>header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 15px;border-bottom:1px solid var(--line)}.report-panel>header h2{font-size:15px;margin:0;color:var(--text)}.report-panel>header small{color:var(--muted)}.report-table-wrap{overflow:auto;max-height:67vh}.report-table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:12px}.report-table th{position:sticky;top:0;z-index:2;background:color-mix(in srgb,var(--card) 92%,var(--text));color:var(--text);text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.04em;padding:9px 10px;border-bottom:1px solid var(--line)}.report-table td{padding:9px 10px;border-bottom:1px solid var(--line);color:var(--text)}.report-table tbody tr:nth-child(even) td{background:color-mix(in srgb,var(--card) 96%,var(--blue))}.report-table tbody tr:hover td{background:color-mix(in srgb,var(--card) 91%,var(--blue))}.report-table .num{text-align:right;font-variant-numeric:tabular-nums}.report-table .positive{color:#15803d;font-weight:800}.report-table .negative{color:#b91c1c;font-weight:800}.report-table a{color:var(--blue);font-weight:800;text-decoration:none}.report-table tfoot td{position:sticky;bottom:0;background:var(--card);font-weight:800;border-top:2px solid var(--line)}.report-product-cell{white-space:normal;min-width:260px;max-width:420px}.report-product-cell small{display:block;color:var(--muted);margin-top:2px}.report-empty,.reports-loading,.reports-error{padding:38px;text-align:center;color:var(--muted)}.reports-error{color:#b91c1c}
.report-chart{padding:18px;display:grid;gap:12px}.report-chart-row{display:grid;grid-template-columns:76px minmax(100px,1fr) 130px;gap:10px;align-items:center}.report-chart-row>span{font-size:12px;color:var(--muted)}.report-chart-track{height:14px;background:color-mix(in srgb,var(--card) 86%,var(--text));border-radius:999px;overflow:hidden}.report-chart-track i{display:block;height:100%;background:var(--blue);border-radius:inherit}.report-chart-row b{text-align:right;font-size:12px;color:var(--text)}
.report-status{display:inline-flex;align-items:center;gap:5px;padding:4px 7px;border-radius:999px;font-size:10px;font-weight:800}.report-status.atypical{background:color-mix(in srgb,#dc2626 18%,var(--card));color:#dc2626}.report-status.stale,.report-status.no_sales{background:color-mix(in srgb,#dc2626 12%,var(--card));color:#b91c1c}.report-status.slow{background:color-mix(in srgb,#f59e0b 16%,var(--card));color:#a16207}.report-status.high{background:color-mix(in srgb,#16a34a 13%,var(--card));color:#15803d}.report-status.normal{background:color-mix(in srgb,var(--blue) 10%,var(--card));color:var(--blue)}.report-status.empty{background:color-mix(in srgb,var(--muted) 10%,var(--card));color:var(--muted)}
.report-group-row td{background:color-mix(in srgb,var(--card) 88%,var(--blue));font-weight:800}.report-note{padding:10px 14px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}
@media(max-width:1100px){.reports-filter-grid{grid-template-columns:repeat(3,minmax(150px,1fr))}.reports-search{grid-column:span 2}}@media(max-width:700px){.reports-hero{display:grid}.reports-filter-grid{grid-template-columns:1fr 1fr}.reports-search{grid-column:1/-1}.reports-apply{grid-column:1/-1}.reports-tabs{overflow:auto;flex-wrap:nowrap;padding-bottom:8px}.reports-tabs button{white-space:nowrap}.report-chart-row{grid-template-columns:65px 1fr 100px}.reports-summary{grid-template-columns:1fr 1fr}}
@media print{.quality-shell,.no-print,.reports-context{display:none!important}.reports-page{display:block}.reports-hero{box-shadow:none;border:0;padding:0 0 12px}.reports-summary{grid-template-columns:repeat(4,1fr);margin-bottom:12px}.report-panel{border:0}.report-table-wrap{overflow:visible;max-height:none}.report-table{white-space:normal}.report-table th{position:static}.report-table tfoot td{position:static}.reports-body{font-size:10px}}

.report-segmented{display:flex;gap:6px;flex-wrap:wrap;padding:0 0 12px}.report-segmented button{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:9px;padding:7px 12px;font:inherit;font-size:12px;font-weight:800;cursor:pointer}.report-segmented button.active{background:var(--brand);border-color:var(--brand);color:#fff}.report-detail-json{max-width:520px;white-space:normal}.report-detail-json details{cursor:pointer}.report-detail-json summary{font-weight:800;color:var(--blue)}.report-detail-json code{display:block;margin-top:6px;padding:8px;border:1px solid var(--line);border-radius:8px;background:color-mix(in srgb,var(--card) 92%,var(--text));white-space:pre-wrap;word-break:break-word;font-size:10px;color:var(--muted)}

.report-audit-section{border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden;margin-bottom:10px}.report-audit-section>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 15px;color:var(--text)}.report-audit-section>summary::-webkit-details-marker{display:none}.report-audit-section>summary:after{content:"＋";font-size:18px;color:var(--muted);margin-left:8px}.report-audit-section[open]>summary:after{content:"−"}.report-audit-section>summary span{display:grid;gap:2px}.report-audit-section>summary b{font-size:14px}.report-audit-section>summary small{font-size:10px;color:var(--muted);font-weight:400}.report-audit-section>summary strong{margin-left:auto;min-width:42px;text-align:right;font-size:13px;color:var(--muted)}.report-audit-section[open]>summary{border-bottom:1px solid var(--line)}.report-audit-content .report-table-wrap{max-height:none;overflow-x:auto;overflow-y:visible}.report-audit-content .report-table th{position:static}.report-audit-content .report-table tfoot td{position:static}

.report-table-wrap.report-table-wrap-unbounded{max-height:none;overflow-x:auto;overflow-y:visible}.report-table-wrap.report-table-wrap-unbounded .report-table th,.report-table-wrap.report-table-wrap-unbounded .report-table tfoot td{position:static}
.report-fold-section{border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden;margin-bottom:10px}.report-fold-section>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 15px;color:var(--text)}.report-fold-section>summary::-webkit-details-marker{display:none}.report-fold-section>summary:after{content:"＋";font-size:18px;color:var(--muted);margin-left:8px}.report-fold-section[open]>summary:after{content:"−"}.report-fold-section>summary span{display:grid;gap:2px}.report-fold-section>summary b{font-size:14px}.report-fold-section>summary small{font-size:10px;color:var(--muted);font-weight:400}.report-fold-section>summary strong{margin-left:auto;min-width:70px;text-align:right;font-size:13px;color:var(--text)}.report-fold-section[open]>summary{border-bottom:1px solid var(--line)}.report-fold-content .report-table-wrap{max-height:none;overflow-x:auto;overflow-y:visible}.report-fold-content .report-table th,.report-fold-content .report-table tfoot td{position:static}.report-fold-section.tone-1>summary{background:color-mix(in srgb,var(--blue) 8%,var(--card))}.report-fold-section.tone-2>summary{background:color-mix(in srgb,#16a34a 7%,var(--card))}.report-fold-section.tone-3>summary{background:color-mix(in srgb,#f59e0b 8%,var(--card))}.report-fold-section.tone-4>summary{background:color-mix(in srgb,#a855f7 7%,var(--card))}.report-fold-section.tone-danger>summary{background:color-mix(in srgb,#dc2626 9%,var(--card))}.report-fold-section.tone-success>summary{background:color-mix(in srgb,#16a34a 9%,var(--card))}
.report-source-badge{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;font-size:9px;font-weight:900;letter-spacing:.03em}.report-source-badge.erp{background:color-mix(in srgb,var(--blue) 13%,var(--card));color:var(--blue)}.report-source-badge.wm10{background:color-mix(in srgb,#f59e0b 14%,var(--card));color:#d97706}.report-history-banner{display:flex;align-items:flex-start;gap:9px;padding:10px 12px;margin-bottom:10px;border:1px solid color-mix(in srgb,#f59e0b 30%,var(--line));border-radius:11px;background:color-mix(in srgb,#f59e0b 7%,var(--card));color:var(--text);font-size:11px}.report-history-banner b{color:#d97706}.report-history-banner small{display:block;color:var(--muted);margin-top:2px}
.report-comparison-suppliers{display:flex;gap:5px;flex-wrap:wrap;white-space:normal;min-width:260px}.report-comparison-suppliers span{display:inline-flex;padding:3px 6px;border-radius:7px;background:color-mix(in srgb,var(--card) 91%,var(--blue));font-size:10px}.report-comparison-suppliers span.best{background:color-mix(in srgb,#16a34a 13%,var(--card));color:#15803d;font-weight:800}
.report-customer-mode-note{padding:9px 12px;margin-bottom:10px;border:1px solid var(--line);border-radius:10px;background:color-mix(in srgb,var(--blue) 5%,var(--card));color:var(--muted);font-size:11px}.report-stage{display:inline-flex;align-items:center;padding:4px 7px;border-radius:999px;font-size:9px;font-weight:900}.report-stage.hot{background:color-mix(in srgb,#16a34a 14%,var(--card));color:#15803d}.report-stage.reactivation,.report-stage.attention{background:color-mix(in srgb,#f59e0b 16%,var(--card));color:#b45309}.report-stage.cold{background:color-mix(in srgb,#f97316 16%,var(--card));color:#c2410c}.report-stage.inactive,.report-stage.never{background:color-mix(in srgb,#dc2626 13%,var(--card));color:#b91c1c}.health-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.health-indicator,.health-alert{border:1px solid var(--line);border-radius:12px;padding:12px;background:var(--card)}.health-indicator{display:grid;gap:5px}.health-indicator span{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.health-indicator b{font-size:18px;color:var(--text)}.health-indicator small{color:var(--muted);line-height:1.4}.health-indicator.good{border-color:color-mix(in srgb,#16a34a 35%,var(--line));background:color-mix(in srgb,#16a34a 5%,var(--card))}.health-indicator.warning{border-color:color-mix(in srgb,#f59e0b 38%,var(--line));background:color-mix(in srgb,#f59e0b 6%,var(--card))}.health-indicator.risk{border-color:color-mix(in srgb,#dc2626 35%,var(--line));background:color-mix(in srgb,#dc2626 5%,var(--card))}.health-alert{display:grid;gap:3px}.health-alert.good{border-left:4px solid #16a34a}.health-alert.warning{border-left:4px solid #f59e0b}.health-alert.risk{border-left:4px solid #dc2626}.health-alert b{color:var(--text)}.health-alert small{color:var(--muted);line-height:1.45}.turnover-quick{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.turnover-quick button{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:999px;padding:7px 10px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}.turnover-quick button.active{background:var(--brand);border-color:var(--brand);color:#fff}
