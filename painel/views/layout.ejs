<div class="container">
  <% if (typeof flash !== 'undefined' && flash) { %><div class="notice"><%= flash %></div><% } %>
  <%- body %>
</div>
<script>
(function(){
  var select=document.getElementById('panelThemeSelect');
  var root=document.documentElement;
  if(select){
    var current=root.getAttribute('data-panel-theme')||'light';
    select.value=current;
    select.addEventListener('change',function(){
      root.setAttribute('data-panel-theme',this.value);
      try{localStorage.setItem('quality_panel_theme',this.value);}catch(e){}
    });
  }

  var menus=Array.from(document.querySelectorAll('[data-shell-menu]'));
  menus.forEach(function(menu){
    menu.addEventListener('toggle',function(){
      if(!menu.open)return;
      menus.forEach(function(other){if(other!==menu)other.open=false;});
    });
  });
  document.addEventListener('click',function(event){
    if(event.target.closest('[data-shell-menu]'))return;
    menus.forEach(function(menu){menu.open=false;});
  });
  document.addEventListener('keydown',function(event){if(event.key==='Escape')menus.forEach(function(menu){menu.open=false;});});

  var shortcutStorageKey='quality_global_menu_shortcuts';
  var shortcutDefaults=['pdv','caixa','agenda','inbox','centro'];
  var shortcutLinks=Array.from(document.querySelectorAll('[data-global-shortcut]'));
  var shortcutModal=document.querySelector('[data-global-shortcuts-modal]');
  var getShortcutIds=function(){try{var raw=JSON.parse(localStorage.getItem(shortcutStorageKey)||'null');return Array.isArray(raw)?raw:shortcutDefaults.slice();}catch(e){return shortcutDefaults.slice();}};
  var applyShortcuts=function(){var ids=new Set(getShortcutIds());shortcutLinks.forEach(function(link){var visible=ids.has(link.dataset.globalShortcut);link.hidden=!visible;link.style.display=visible?'':'none';});};
  var openShortcutConfig=function(){if(!shortcutModal)return;var ids=new Set(getShortcutIds());shortcutModal.querySelectorAll('input[type=checkbox]').forEach(function(box){box.checked=ids.has(box.value);});shortcutModal.hidden=false;menus.forEach(function(menu){menu.open=false;});};
  applyShortcuts();
  document.querySelector('[data-global-shortcuts-config]')?.addEventListener('click',function(event){event.preventDefault();openShortcutConfig();});
  shortcutModal?.querySelector('[data-global-shortcuts-close]')?.addEventListener('click',function(){shortcutModal.hidden=true;});
  shortcutModal?.addEventListener('click',function(event){if(event.target===shortcutModal)shortcutModal.hidden=true;});
  shortcutModal?.querySelector('[data-global-shortcuts-reset]')?.addEventListener('click',function(){localStorage.removeItem(shortcutStorageKey);applyShortcuts();openShortcutConfig();});
  shortcutModal?.querySelector('[data-global-shortcuts-save]')?.addEventListener('click',function(){var ids=Array.from(shortcutModal.querySelectorAll('input[type=checkbox]:checked')).map(function(box){return box.value;});if(!ids.length)ids=['pdv'];try{localStorage.setItem(shortcutStorageKey,JSON.stringify(ids));}catch(e){}applyShortcuts();shortcutModal.hidden=true;});

  var path=location.pathname.replace(/\/$/,'')||'/';
  var links=Array.from(document.querySelectorAll('[data-shell-link]'));
  var candidates=links.filter(function(link){
    var href=(new URL(link.href,location.origin)).pathname.replace(/\/$/,'')||'/';
    return href==='/' ? path==='/' : (path===href || path.indexOf(href+'/')===0);
  }).sort(function(a,b){return b.pathname.length-a.pathname.length;});
  if(candidates[0]){
    candidates[0].classList.add('is-active');
    var parent=candidates[0].closest('[data-shell-menu]');
    if(parent)parent.classList.add('has-active');
  }

  var searchInput=document.getElementById('qualityGlobalSearch');
  var searchResults=document.querySelector('[data-global-search-results]');
  if(searchInput&&searchResults){
    var extraSearchItems=[
      ['Caixa Operacional','/erp/pdv/caixa','Financeiro'],['Orçamentos','/orcamentos','Operação'],['Categorias ERP','/erp/categorias','ERP'],
      ['Produtos do site','/produtos?lvStatus=true','Negócio'],['Banners','/banners','Negócio'],['SEO','/seo','Negócio'],['Configurações','/configuracoes','Sistema']
    ];
    var navItems=Array.from(document.querySelectorAll('.quality-main-nav a[href],.quality-nav-dropdown a[href]')).map(function(a){
      return {label:(a.querySelector('b')?.textContent||a.textContent||'').replace(/[🏠⭐⚡💼💰💬🌐🛒💵✅🧭⚙📦]/g,'').trim(),href:a.getAttribute('href'),group:a.closest('.quality-nav-menu')?.querySelector('summary')?.textContent.replace('▾','').trim()||'Menu'};
    });
    extraSearchItems.forEach(function(item){navItems.push({label:item[0],href:item[1],group:item[2]});});
    var seen=new Set();navItems=navItems.filter(function(item){var key=(item.label+'|'+item.href).toLowerCase();if(!item.label||!item.href||seen.has(key))return false;seen.add(key);return true;});
    var normalize=function(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();};
    var renderSearch=function(){
      var q=normalize(searchInput.value).trim();
      if(!q){searchResults.hidden=true;searchResults.innerHTML='';return;}
      var terms=q.split(/\s+/).filter(Boolean);
      var matches=navItems.filter(function(item){var hay=normalize(item.label+' '+item.group);return terms.every(function(term){return hay.includes(term);});}).slice(0,9);
      searchResults.innerHTML=matches.length?matches.map(function(item,index){return '<a href="'+item.href+'" data-global-result="'+index+'"><b>'+item.label+'</b><small>'+item.group+'</small></a>';}).join(''):'<div class="quality-search-empty">Nenhuma opção encontrada.</div>';
      searchResults.hidden=false;
    };
    searchInput.addEventListener('input',renderSearch);
    searchInput.addEventListener('keydown',function(event){
      if(event.key==='Enter'){var first=searchResults.querySelector('a');if(first){event.preventDefault();location.href=first.href;}}
      if(event.key==='Escape'){searchInput.value='';searchResults.hidden=true;searchInput.blur();}
    });
    document.addEventListener('keydown',function(event){if(event.key==='F1'){event.preventDefault();searchInput.focus();searchInput.select();}});
    document.addEventListener('click',function(event){if(!event.target.closest('[data-global-search]'))searchResults.hidden=true;});
  }
})();
</script>
<script src="/public/js/painel.js" defer></script>
<script src="/public/js/help-tips.js" defer></script>
<script src="/public/js/address-autocomplete.js" defer></script>
