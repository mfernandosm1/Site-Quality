<style>
.quality-user-chip{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--card);border-radius:10px;padding:5px 7px 5px 9px;max-width:210px}.quality-user-chip__info{display:grid;min-width:0}.quality-user-chip__info b{font-size:11px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quality-user-chip__info small{font-size:9px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quality-user-chip form{margin:0}.quality-user-settings{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line);background:var(--card);color:var(--muted);font-size:21px;line-height:1;text-decoration:none;border-radius:8px;transition:.15s ease}.quality-user-settings:hover{color:var(--text);border-color:color-mix(in srgb,var(--text) 34%,var(--line));background:color-mix(in srgb,var(--text) 5%,var(--card));transform:translateY(-1px)}.quality-user-logout{display:grid;place-items:center;width:30px;height:30px;border:1px solid color-mix(in srgb,#ef4444 36%,var(--line));background:color-mix(in srgb,#ef4444 9%,var(--card));color:#ef4444;font-size:18px;line-height:1;cursor:pointer;padding:0;border-radius:8px}.quality-user-logout:hover{background:#ef4444;color:#fff;border-color:#ef4444}
@media(max-width:900px){.quality-user-chip__info{display:none}.quality-user-chip{padding:4px}}
.quality-universal-print-brand{display:none}
@media print{.quality-universal-print-brand{display:flex!important;align-items:center;gap:12px;border-bottom:1px solid #bbb;padding:0 0 10px;margin:0 0 12px;color:#111;background:#fff}.quality-universal-print-brand img{width:110px;max-height:50px;object-fit:contain;object-position:left center}.quality-universal-print-brand div{display:grid}.quality-universal-print-brand strong{font-size:16px}.quality-universal-print-brand small{font-size:9px;color:#666}}
</style>
