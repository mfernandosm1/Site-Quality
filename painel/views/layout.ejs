<div class="quality-shortcuts-config" data-global-shortcuts-modal hidden>
  <div class="quality-shortcuts-config__card" role="dialog" aria-modal="true" aria-labelledby="qualityShortcutsTitle">
    <div class="quality-shortcuts-config__head"><div><strong id="qualityShortcutsTitle">Personalizar atalhos do menu</strong><small>Esses atalhos são independentes dos ícones da Dashboard.</small></div><button type="button" data-global-shortcuts-close aria-label="Fechar">×</button></div>
    <div class="quality-shortcuts-config__grid">
      <label><input type="checkbox" value="pdv"> 🛒 PDV</label>
      <label><input type="checkbox" value="caixa"> 💵 Caixa Operacional</label>
      <label><input type="checkbox" value="agenda"> ✅ Agenda</label>
      <label><input type="checkbox" value="inbox"> 💬 Inbox</label>
      <label><input type="checkbox" value="centro"> 🧭 Centro de Operações</label>
      <label><input type="checkbox" value="clientes"> 👥 Clientes</label>
      <label><input type="checkbox" value="compras"> 🚚 Compras</label>
      <label><input type="checkbox" value="estoque"> 📚 Estoque</label>
      <label><input type="checkbox" value="orcamentos"> 📝 Orçamentos</label>
      <label><input type="checkbox" value="produtos"> 📦 Produtos</label>
