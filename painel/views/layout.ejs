<script>window.QUALITY_AUTH_BOOT=<%- JSON.stringify({user:(typeof currentUser!=='undefined'?currentUser:null),profile:(typeof currentProfile!=='undefined'?currentProfile:null),permissions:(typeof currentPermissions!=='undefined'?currentPermissions:[])}) %>;</script>
<script>
(function(){
  var authBoot=window.QUALITY_AUTH_BOOT||{};
  var authRules=Array.isArray(authBoot.permissions)?authBoot.permissions:[];
  var authCan=function(permission){return !!authBoot.user&&authRules.some(function(rule){return rule==='*'||rule===permission||(rule.endsWith('.*')&&permission.indexOf(rule.slice(0,-1))===0)||(rule==='*.view'&&permission.endsWith('.view'));});};
  var permissionForHref=function(href){
    var raw=String(href||'');
    var parts=raw.split('?'),p=parts[0],query=new URLSearchParams(parts[1]||'');
    if(p==='/')return 'dashboard.view';
    if(p.indexOf('/configuracoes/usuarios')===0)return 'users.manage';
    if(p.indexOf('/configuracoes')===0)return 'settings.manage';
    if(p.indexOf('/erp/configuracoes')===0)return 'settings.manage';
    if(p.indexOf('/erp/metas-comissoes')===0)return 'commissions.view';
    if(p.indexOf('/erp/relatorios')===0)return 'reports.view';
    if(p.indexOf('/erp/financeiro')===0)return 'finance.view';
    if(p.indexOf('/erp/pdv/caixa')===0)return 'cash.view';
    if(p.indexOf('/erp/pdv')===0)return 'pdv.view';
    if(p.indexOf('/erp/estoque')===0)return 'inventory.view';
    if(p.indexOf('/erp/compras')===0)return 'purchases.view';
    if(p.indexOf('/erp/clientes')===0)return 'customers.view';
    if(p.indexOf('/erp/fornecedores')===0)return 'suppliers.view';
    if(p.indexOf('/erp/produtos')===0||p.indexOf('/erp/categorias')===0||p.indexOf('/erp/precificacao')===0)return 'products.view';
    if(p.indexOf('/erp/agenda')===0)return 'agenda.view';
    if(p.indexOf('/erp/historico')===0||p.indexOf('/kernel')===0)return 'audit.view';
    if(p.indexOf('/erp/centro-operacoes')===0)return 'operations.view';
    if(p==='/erp'||p.indexOf('/erp/modulo/')===0)return 'erp.view';
    if(p.indexOf('/orcamentos')===0)return 'quotes.view';
    if(p.indexOf('/automacao-whatsapp')===0||p==='/crm'){
      var tab=query.get('tab')||'';
      if(tab==='inbox')return 'crm.inbox.view';
      if(['palavras-chave','automacao','blocos','fluxos'].indexOf(tab)>=0)return 'crm.automation.view';
      return 'crm.view';
    }
    if(p==='/site')return 'site.view';
    if(p.indexOf('/produtos')===0)return 'site.products.view';
    if(p.indexOf('/categorias')===0||p.indexOf('/subcategorias')===0)return 'site.catalog.view';
    if(p.indexOf('/seo')===0)return 'site.seo.view';
    if(['/aparencia','/personalizacao','/estilos','/css'].some(function(prefix){return p.indexOf(prefix)===0;}))return 'site.design.view';
    if(p.indexOf('/manutencao')===0)return 'site.maintenance.view';
    if(['/header','/footer','/sobre','/pagamentos','/paginas','/banners'].some(function(prefix){return p.indexOf(prefix)===0;}))return 'site.content.view';
    if(p.indexOf('/analytics')===0)return 'analytics.view';
    if(p.indexOf('/marketing')===0||p.indexOf('/sorteios')===0)return 'marketing.view';
    if(p.indexOf('/compatibilidade')===0)return 'compatibility.view';
    if(p.indexOf('/ferramentas')===0)return 'tools.view';
    return null;
  };

  if(authBoot.user){
    document.querySelectorAll('a[href]').forEach(function(link){var permission=permissionForHref(link.getAttribute('href'));if(permission&&!authCan(permission))link.remove();});
    document.querySelectorAll('[data-auth-permission]').forEach(function(el){if(!authCan(el.getAttribute('data-auth-permission')))el.remove();});
    var shortcutPermissions={pdv:'pdv.view',caixa:'cash.view',agenda:'agenda.view',inbox:'crm.inbox.view',centro:'operations.view',clientes:'customers.view',compras:'purchases.view',estoque:'inventory.view',orcamentos:'quotes.view',produtos:'products.view',precificacao:'products.view',fornecedores:'suppliers.view',receber:'finance.view',pagar:'finance.view',fluxo:'finance.view',dre:'finance.view',relatorios:'reports.view','metas-comissoes':'commissions.view',site:'site.view','produtos-site':'site.products.view',analytics:'analytics.view',marketing:'marketing.view',configuracoes:'settings.manage'};
    document.querySelectorAll('[data-global-shortcuts-modal] label').forEach(function(label){var box=label.querySelector('input[value]');var permission=box&&shortcutPermissions[box.value];if(permission&&!authCan(permission))label.remove();});
    document.querySelectorAll('[data-shell-menu]').forEach(function(menu){if(!menu.querySelector('a'))menu.remove();});
  }
  var select=document.getElementById('panelThemeSelect');
  var root=document.documentElement;
  if(select){
    var current=root.getAttribute('data-panel-theme')||'light';
    select.value=current;
    select.addEventListener('change',function(){
      root.setAttribute('data-panel-theme',this.value);
      try{localStorage.setItem('quality_panel_theme',this.value);}catch(e){}
    });
  }

  var menus=Array.from(document.querySelectorAll('[data-shell-menu]'));
  menus.forEach(function(menu){
    menu.addEventListener('toggle',function(){
      if(!menu.open)return;
      menus.forEach(function(other){if(other!==menu)other.open=false;});
    });
  });
  document.addEventListener('click',function(event){
    if(event.target.closest('[data-shell-menu]'))return;
    menus.forEach(function(menu){menu.open=false;});
  });
  document.addEventListener('keydown',function(event){if(event.key==='Escape')menus.forEach(function(menu){menu.open=false;});});

  var shortcutStorageKey='quality_global_menu_shortcuts';
  var shortcutDefaults=['pdv','caixa','agenda','inbox','centro'];
  var shortcutLinks=Array.from(document.querySelectorAll('[data-global-shortcut]'));
  var shortcutModal=document.querySelector('[data-global-shortcuts-modal]');
  var getShortcutIds=function(){try{var raw=JSON.parse(localStorage.getItem(shortcutStorageKey)||'null');return Array.isArray(raw)?raw:shortcutDefaults.slice();}catch(e){return shortcutDefaults.slice();}};
  var applyShortcuts=function(){var ids=new Set(getShortcutIds());shortcutLinks.forEach(function(link){var visible=ids.has(link.dataset.globalShortcut);link.hidden=!visible;link.style.display=visible?'':'none';});};
  var openShortcutConfig=function(){if(!shortcutModal)return;var ids=new Set(getShortcutIds());shortcutModal.querySelectorAll('input[type=checkbox]').forEach(function(box){box.checked=ids.has(box.value);});shortcutModal.hidden=false;menus.forEach(function(menu){menu.open=false;});};
  applyShortcuts();
  document.querySelector('[data-global-shortcuts-config]')?.addEventListener('click',function(event){event.preventDefault();openShortcutConfig();});
  shortcutModal?.querySelector('[data-global-shortcuts-close]')?.addEventListener('click',function(){shortcutModal.hidden=true;});
  shortcutModal?.addEventListener('click',function(event){if(event.target===shortcutModal)shortcutModal.hidden=true;});
  shortcutModal?.querySelector('[data-global-shortcuts-reset]')?.addEventListener('click',function(){localStorage.removeItem(shortcutStorageKey);applyShortcuts();openShortcutConfig();});
  shortcutModal?.querySelector('[data-global-shortcuts-save]')?.addEventListener('click',function(){var ids=Array.from(shortcutModal.querySelectorAll('input[type=checkbox]:checked')).map(function(box){return box.value;});if(!ids.length)ids=['pdv'];try{localStorage.setItem(shortcutStorageKey,JSON.stringify(ids));}catch(e){}applyShortcuts();shortcutModal.hidden=true;});

  var path=location.pathname.replace(/\/$/,'')||'/';
  var links=Array.from(document.querySelectorAll('[data-shell-link]'));
  var candidates=links.filter(function(link){
    var href=(new URL(link.href,location.origin)).pathname.replace(/\/$/,'')||'/';
    return href==='/' ? path==='/' : (path===href || path.indexOf(href+'/')===0);
  }).sort(function(a,b){return b.pathname.length-a.pathname.length;});
  if(candidates[0]){
    candidates[0].classList.add('is-active');
    var parent=candidates[0].closest('[data-shell-menu]');
    if(parent)parent.classList.add('has-active');
  }

  var searchInput=document.getElementById('qualityGlobalSearch');
  var searchResults=document.querySelector('[data-global-search-results]');
  if(searchInput&&searchResults){
    var extraSearchItems=[
      ['Caixa Operacional','/erp/pdv/caixa','Financeiro'],['Orçamentos','/orcamentos','Operação'],['Categorias ERP','/erp/categorias','ERP'],['Relatórios','/erp/relatorios','ERP'],['Metas e Comissões','/erp/metas-comissoes','ERP'],
      ['Produtos do site','/produtos?lvStatus=true','Negócio'],['Banners','/banners','Negócio'],['SEO','/seo','Negócio'],['Configurações','/configuracoes','Sistema']
    ];
    // A pesquisa usa somente os caminhos canônicos dos menus permanentes.
    // Atalhos são personalizados pelo usuário e não devem aparecer como origem do resultado.
    var navItems=Array.from(document.querySelectorAll('.quality-main-nav > a[href], .quality-nav-menu:not(.quality-shortcuts-menu) .quality-nav-dropdown a[href]')).map(function(a){
      return {label:(a.querySelector('b')?.textContent||a.textContent||'').replace(/[🏠⭐⚡💼💰💬🌐🛒💵✅🧭⚙📦]/g,'').trim(),href:a.getAttribute('href'),group:a.closest('.quality-nav-menu')?.querySelector('summary')?.textContent.replace('▾','').trim()||'Início'};
    });
    extraSearchItems.forEach(function(item){navItems.push({label:item[0],href:item[1],group:item[2]});});
    var normalize=function(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();};
    var seen=new Set();navItems=navItems.filter(function(item){
      var key=normalize(item.label);
      if(!key||!item.href||item.href==='#'||seen.has(key))return false;
      seen.add(key);return true;
    });
    var renderSearch=function(){
      var q=normalize(searchInput.value).trim();
      if(!q){searchResults.hidden=true;searchResults.innerHTML='';return;}
      var terms=q.split(/\s+/).filter(Boolean);
      var matches=navItems.filter(function(item){var hay=normalize(item.label+' '+item.group);return terms.every(function(term){return hay.includes(term);});}).slice(0,9);
      searchResults.innerHTML=matches.length?matches.map(function(item,index){return '<a href="'+item.href+'" data-global-result="'+index+'"><b>'+item.label+'</b><small>'+item.group+'</small></a>';}).join(''):'<div class="quality-search-empty">Nenhuma opção encontrada.</div>';
      searchResults.hidden=false;
    };
    searchInput.addEventListener('input',renderSearch);
    searchInput.addEventListener('keydown',function(event){
      if(event.key==='Enter'){var first=searchResults.querySelector('a');if(first){event.preventDefault();location.href=first.href;}}
      if(event.key==='Escape'){searchInput.value='';searchResults.hidden=true;searchInput.blur();}
    });
    document.addEventListener('keydown',function(event){if(event.key==='F1'){event.preventDefault();searchInput.focus();searchInput.select();}});
    document.addEventListener('click',function(event){if(!event.target.closest('[data-global-search]'))searchResults.hidden=true;});
  }
})();
</script>
