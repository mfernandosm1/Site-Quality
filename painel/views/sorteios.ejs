<% layout('layout') -%>
<style>
:root{--sq-bg:#071018;--sq-card:#0d1823;--sq-line:#223142;--sq-text:#f8fafc;--sq-muted:#94a3b8;--sq-green:#22c55e;--sq-blue:#2563eb;--sq-gold:#facc15;--sq-red:#dc2626;--sq-purple:#7c3aed}.content,.container,main{max-width:none!important}.sq-page{margin:-18px -12px -30px;padding:18px;min-height:calc(100vh - 70px);background:radial-gradient(circle at 82% 0%,rgba(250,204,21,.10),transparent 27%),radial-gradient(circle at 18% 6%,rgba(34,197,94,.12),transparent 34%),linear-gradient(135deg,#050b12,#09131d 42%,#05080d);color:var(--sq-text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial}.sq-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.sq-brand{display:flex;gap:13px;align-items:center}.sq-brand img{width:128px;filter:drop-shadow(0 8px 16px rgba(0,0,0,.4))}.sq-title{margin:0;font-size:25px;font-weight:1000}.sq-sub{margin:3px 0 0;color:var(--sq-muted)}.sq-layout{display:grid;grid-template-columns:360px 1fr 380px;gap:14px}.sq-card{background:linear-gradient(180deg,rgba(17,31,44,.96),rgba(10,20,30,.96));border:1px solid var(--sq-line);border-radius:16px;padding:16px;box-shadow:0 16px 60px rgba(0,0,0,.28)}.sq-card h3{margin:0 0 13px;font-size:17px;color:#22c55e}.sq-field{margin-bottom:11px}.sq-field label{display:block;color:#cbd5e1;font-size:12px;font-weight:800;margin-bottom:5px}.sq-input,.sq-textarea{width:100%;border:1px solid #26384b;background:#07111b;color:#fff;border-radius:10px;padding:11px 12px;outline:none}.sq-input:focus,.sq-textarea:focus{border-color:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.12)}.sq-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.sq-game{display:grid;grid-template-columns:1fr 34px 1fr;gap:8px;align-items:end}.sq-vs{text-align:center;color:#facc15;font-weight:1000;padding-bottom:10px}.sq-textarea{min-height:310px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;resize:vertical}.sq-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px}.sq-btn{border:0;border-radius:11px;padding:11px 13px;font-weight:1000;cursor:pointer;color:#fff;background:#334155;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:.15s}.sq-btn:hover{transform:translateY(-1px);filter:brightness(1.08)}.blue{background:linear-gradient(135deg,#2563eb,#1d4ed8)}.green{background:linear-gradient(135deg,#22c55e,#15803d)}.gold{background:linear-gradient(135deg,#facc15,#f59e0b);color:#111827}.purple{background:linear-gradient(135deg,#8b5cf6,#6d28d9)}.dark{background:#0f172a;border:1px solid #334155}.sq-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.sq-stat{border:1px solid #25384c;border-radius:14px;padding:13px;background:#101b27;min-height:80px}.sq-stat small{display:block;color:#cbd5e1}.sq-stat b{font-size:30px;display:block;margin-top:7px}.sq-stat.green{background:linear-gradient(135deg,rgba(34,197,94,.23),rgba(22,101,52,.20));border-color:#16a34a}.sq-stat.blue{background:linear-gradient(135deg,rgba(37,99,235,.30),rgba(30,64,175,.20));border-color:#2563eb}.sq-stat.gold{background:linear-gradient(135deg,rgba(250,204,21,.28),rgba(146,64,14,.20));border-color:#ca8a04}.sq-list{border:1px solid #223142;border-radius:14px;overflow:hidden;background:#07111b;margin-top:10px}.sq-item{display:grid;grid-template-columns:38px 1fr 70px;gap:10px;padding:10px 12px;border-bottom:1px solid #172536;align-items:center}.sq-item:last-child{border-bottom:0}.sq-user{font-weight:1000}.sq-raw{font-size:11px;color:#94a3b8;margin-top:3px}.sq-pill{text-align:center;border-radius:999px;padding:5px 8px;background:#132338;color:#bfdbfe;font-weight:900}.sq-pill.ok{background:#14532d;color:#bbf7d0}.sq-alert{margin-top:12px;border:1px solid rgba(250,204,21,.35);background:rgba(250,204,21,.08);border-radius:13px;padding:12px;font-size:12px;color:#fde68a;line-height:1.45}.sq-winner{border:1px solid rgba(250,204,21,.7);background:linear-gradient(135deg,rgba(250,204,21,.18),rgba(255,255,255,.06));border-radius:16px;padding:18px;text-align:center;margin:12px 0}.sq-winner small{color:#fde68a;font-weight:900}.sq-winner b{display:block;font-size:29px;margin:5px 0}.sq-linkbox{display:none;margin-top:12px;border:1px solid rgba(34,197,94,.5);background:rgba(22,163,74,.08);border-radius:14px;padding:13px}.sq-linkgrid{display:grid;grid-template-columns:1fr 112px;gap:12px;align-items:center}.sq-help{font-size:12px;color:var(--sq-muted);line-height:1.45;margin-top:8px}.phone{width:320px;max-width:100%;margin:0 auto;border:7px solid #111827;border-radius:36px;padding:8px;background:#020617;box-shadow:0 22px 70px rgba(0,0,0,.6)}.phone-screen{border-radius:27px;overflow:hidden;background:linear-gradient(180deg,#062612,#020617);min-height:650px;padding:14px 12px;text-align:center;position:relative}.phone-logo{position:absolute;top:18px;left:18px;width:104px}.phone-badge{position:absolute;top:18px;right:14px;border:1px solid rgba(250,204,21,.5);border-radius:12px;color:#fde68a;font-weight:1000;font-size:13px;padding:6px}.phone-cup{font-size:95px;margin-top:40px;filter:drop-shadow(0 12px 18px #000)}.phone-title{font-size:36px;line-height:.95;color:#facc15;font-weight:1000;text-shadow:0 3px 0 rgba(127,29,29,.8);margin:8px 0}.phone-game{font-weight:1000;color:#fff;font-size:23px}.phone-flags{display:flex;align-items:center;justify-content:center;gap:8px;margin:12px 0}.phone-flags span{border:1px solid rgba(255,255,255,.18);border-radius:12px;background:rgba(255,255,255,.13);padding:7px 10px;font-weight:1000}.phone-prize{border:1px solid rgba(34,197,94,.5);border-radius:17px;padding:10px;margin:10px 0}.phone-products{display:flex;justify-content:center;align-items:flex-end;gap:12px;margin-top:8px}.phone-products img{object-fit:contain;filter:drop-shadow(0 8px 12px rgba(0,0,0,.55))}.phone-products .album{height:82px}.phone-products .pack{height:78px}.phone-count{background:rgba(22,163,74,.35);border:1px solid rgba(34,197,94,.4);border-radius:16px;padding:9px;margin:10px auto;width:160px}.phone-count b{font-size:29px}.phone-btn{border-radius:15px;padding:13px;background:linear-gradient(135deg,#facc15,#f59e0b);color:#111827;font-weight:1000;margin-top:10px}.phone-site{color:#facc15;font-weight:1000;margin-top:10px}.sq-modal{display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.75);align-items:center;justify-content:center}.sq-modal.open{display:flex}.stage-wide{width:min(900px,92vw);height:min(520px,82vh);border-radius:28px;background:radial-gradient(circle at 50% 0,rgba(250,204,21,.25),transparent 26%),linear-gradient(135deg,#052713,#020617);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden}.stage-title{font-size:44px;font-weight:1000;color:#facc15;text-transform:uppercase}.stage-game{color:#bbf7d0;font-weight:800}.stage-name{margin:25px auto;background:linear-gradient(90deg,#fff,#fff1a9);color:#111827;border-radius:22px;padding:25px;width:min(720px,86%);font-size:42px;font-weight:1000}.stage-count{font-size:100px;color:#facc15;font-weight:1000;display:none}@media(max-width:1200px){.sq-layout{grid-template-columns:1fr}.phone{width:360px}.sq-stats{grid-template-columns:repeat(2,1fr)}}
</style>
<div class="sq-page">
  <div class="sq-head"><div class="sq-brand"><img src="/public/img/sorteios/logo-quality-transp.png"><div><h1 class="sq-title">🎁 Promoções & Sorteios</h1><p class="sq-sub">Cole comentários, filtre acertadores e gere a apresentação para gravar no celular.</p></div></div><a class="sq-btn dark" href="/">← Voltar</a></div>
  <div class="sq-layout">
    <div>
      <section class="sq-card"><h3>1. Dados da campanha</h3><div class="sq-field"><label>Nome da campanha</label><input id="campanha" class="sq-input" value="Palpite Premiado Brasil x Noruega"></div><div class="sq-field"><label>Prêmio</label><input id="premio" class="sq-input" value="Álbum da Copa Capa Dura + 1 pacote de figurinhas"></div><div class="sq-game"><div class="sq-field"><label>Time A</label><input id="timeA" class="sq-input" value="Brasil"></div><div class="sq-vs">X</div><div class="sq-field"><label>Time B</label><input id="timeB" class="sq-input" value="Noruega"></div></div><div class="sq-field"><label>Jogo</label><input id="jogo" class="sq-input" value="Brasil x Noruega"></div><div class="sq-field"><label>Placar correto</label><input id="placar" class="sq-input" value="Brasil 2 x 1 Noruega"></div></section>
      <section class="sq-card" style="margin-top:14px"><h3>2. Comentários do Instagram</h3><textarea id="comentarios" class="sq-textarea" placeholder="Cole aqui os comentários copiados do Instagram..."></textarea><div class="sq-actions"><button class="sq-btn blue" onclick="processar()">🔎 Processar comentários</button><button class="sq-btn dark" onclick="limparTudo()">🧹 Limpar</button></div><div class="sq-help">Dica: o sistema identifica @usuário e placar em formatos como 2x1, 2 x 1, Brasil 2x1 Noruega.</div><div id="review" class="sq-alert" style="display:none"></div></section>
    </div>
    <div>
      <section class="sq-card"><h3>3. Resumo</h3><div class="sq-stats"><div class="sq-stat green"><small>Comentários lidos</small><b id="stLidos">0</b></div><div class="sq-stat blue"><small>Participantes válidos</small><b id="stValidos">0</b></div><div class="sq-stat gold"><small>Acertadores</small><b id="stAcert">0</b></div><div class="sq-stat"><small>Repetidos removidos</small><b id="stRep">0</b></div></div><div class="sq-actions"><button class="sq-btn green" onclick="filtrarAcertadores()">✅ Filtrar acertadores</button><button class="sq-btn blue" onclick="sortear()">🎲 Sortear agora</button><button class="sq-btn purple" onclick="abrirModoGravacao()">🎥 Modo gravação</button><button class="sq-btn dark" onclick="copiarResumo()">📋 Copiar resumo</button><button class="sq-btn dark" onclick="salvarRegistro()">💾 Salvar registro</button></div><div id="winner" class="sq-winner" style="display:none"><small>VENCEDOR(A)</small><b id="winnerName"></b><div id="winnerScore" class="sq-help"></div></div></section>
      <section class="sq-card" style="margin-top:14px"><h3>Link para abrir no celular</h3><p class="sq-sub">Gere o link, abra no celular na mesma rede Wi-Fi e grave a tela.</p><div class="sq-actions"><button class="sq-btn green" onclick="gerarLinkCelular()">📱 Gerar link + QR Code</button></div><div id="linkBox" class="sq-linkbox"><div class="sq-linkgrid"><div><input id="linkCelular" class="sq-input" readonly><div class="sq-actions"><button class="sq-btn dark" onclick="copiarLink()">Copiar link</button><button class="sq-btn dark" onclick="abrirLink()">Abrir</button></div><div class="sq-help">Se não abrir no celular, confirme se notebook e celular estão no mesmo Wi-Fi.</div></div><img id="qrImg" width="108" height="108" alt="QR Code"></div></div></section>
      <section class="sq-card" style="margin-top:14px"><h3>4. Acertadores / participantes</h3><div id="lista" class="sq-list"><div class="sq-item"><div>—</div><div class="sq-user">Nenhum participante processado ainda</div><div class="sq-pill">—</div></div></div></section>
    </div>
    <aside><section class="sq-card"><h3 style="text-align:center;color:#fde68a">APRESENTAÇÃO NO CELULAR</h3><div class="phone"><div class="phone-screen"><img class="phone-logo" src="/public/img/sorteios/logo-quality-transp.png"><div class="phone-badge">COPA DO<br>MUNDO<br>2026</div><div class="phone-cup">🏆</div><div style="font-weight:1000;color:#f8e9a3;letter-spacing:.12em">COPA DO MUNDO FIFA 2026</div><div class="phone-title">PALPITE<br>PREMIADO</div><div class="phone-game">BRASIL X NORUEGA</div><div class="phone-flags"><span>🇧🇷 BRASIL</span><b style="color:#facc15">X</b><span>NORUEGA 🇳🇴</span></div><div style="color:#facc15;font-weight:1000">BRASIL 2 X 1 NORUEGA</div><div class="phone-prize"><b style="color:#fde68a">🎁 PRÊMIO</b><br><b>ÁLBUM DA COPA CAPA DURA<br>+ 1 PACOTE DE FIGURINHAS</b><div class="phone-products"><img class="album" src="/public/img/sorteios/album-copa.png"><img class="pack" src="/public/img/sorteios/pacote-figurinhas.png"></div></div><div class="phone-count"><b id="prevCount">0</b><br><small>participantes</small></div><div class="phone-btn">INICIAR SORTEIO →</div><div class="phone-site">www.qualitycel.com.br</div></div></div></section></aside>
  </div>
</div>
<div id="modal" class="sq-modal"><div class="stage-wide"><div><div class="stage-title">Palpite Premiado</div><div class="stage-game" id="mgame">Brasil x Noruega</div><div id="mcount" class="stage-count">3</div><div id="mname" class="stage-name">Clique em iniciar</div><div class="sq-actions" style="justify-content:center"><button class="sq-btn gold" onclick="animarSorteio()">▶️ Iniciar sorteio</button><button class="sq-btn" onclick="fecharModo()">Fechar</button></div></div></div></div>
<script>
let participantes=[], acertadores=[], vencedor=null, revisar=[], repetidos=0; const $=id=>document.getElementById(id);
function cleanText(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[×]/g,'x')}
function extractScore(txt){const t=cleanText(txt);let m=t.match(/(\d{1,2})\s*(?:x|a|-)\s*(\d{1,2})/);if(m)return `${Number(m[1])}x${Number(m[2])}`;m=t.match(/brasil\D{0,15}(\d{1,2})\D{0,15}(\d{1,2})\D{0,15}(noruega|noroegua|nonuega)/);if(m)return `${Number(m[1])}x${Number(m[2])}`;m=t.match(/(noruega|noroegua|nonuega)\D{0,15}(\d{1,2})\D{0,15}(\d{1,2})\D{0,15}brasil/);if(m)return `${Number(m[3])}x${Number(m[2])}`;return null}
function isMeta(l){const x=String(l||'').trim();return !x||/^responder$/i.test(x)||/^\d+\s*(d|h|min)\s*responder$/i.test(x)||/^\d+\s*gostos?\s*responder$/i.test(x)||/^ver tradução$/i.test(x)}
function sanitizeLine(l){return String(l||'').replace(/\b\d+\s*(d|h|min)\b/gi,'').replace(/\bResponder\b/gi,'').replace(/\b\d+\s*gostos?\b/gi,'').trim()}
function processar(){const raw=$('comentarios').value;const linhas=raw.split(/\n+/).map(x=>x.trim()).filter(x=>!isMeta(x));const chunks=[];let buffer='';for(const ln of linhas){const c=sanitizeLine(ln);if(!c)continue;const startsNew=/@[\w.]+/.test(c)||/\d\s*[xXa×-]\s*\d/.test(c)||/brasil/i.test(c);if(buffer&&startsNew){chunks.push(buffer.trim());buffer=c}else buffer+=(buffer?' ':'')+c}if(buffer)chunks.push(buffer.trim());const seen=new Map();revisar=[];participantes=[];repetidos=0;for(const c of chunks){const score=extractScore(c);if(!score)continue;const userMatch=c.match(/@[a-zA-Z0-9._]+/);if(!userMatch){revisar.push(c);continue}const usuario=userMatch[0].toLowerCase();if(seen.has(usuario)){repetidos++;continue}const obj={usuario,palpite:score,comentario:c};seen.set(usuario,obj);participantes.push(obj)}acertadores=[];vencedor=null;render(chunks.length,true)}
function filtrarAcertadores(){if(!participantes.length)processar();const correto=extractScore($('placar').value);acertadores=participantes.filter(p=>p.palpite===correto);vencedor=null;render(null,false)}
function render(lidos,showReview){if(lidos!==null)$('stLidos').textContent=lidos;$('stValidos').textContent=participantes.length;$('stRep').textContent=repetidos;$('stAcert').textContent=acertadores.length;$('prevCount').textContent=acertadores.length||participantes.length;const lista=acertadores.length?acertadores:participantes;$('lista').innerHTML=lista.length?lista.map((p,i)=>`<div class="sq-item"><div>${i+1}</div><div><div class="sq-user">${p.usuario}</div><div class="sq-raw">${esc(p.comentario)}</div></div><div class="sq-pill ${acertadores.includes(p)?'ok':''}">${p.palpite.replace('x',' x ')}</div></div>`).join(''):'<div class="sq-item"><div>—</div><div class="sq-user">Nenhum participante encontrado</div><div class="sq-pill">—</div></div>';if(showReview&&revisar.length){$('review').style.display='block';$('review').innerHTML='<b>Atenção:</b> estes palpites parecem estar sem @ e ficaram fora do sorteio automático:<br>'+revisar.map(x=>'• '+esc(x)).join('<br>')}else if(showReview){$('review').style.display='none'}if(!vencedor)$('winner').style.display='none'}
function esc(s){return String(s||'').replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]))}
function sortear(){if(!acertadores.length)filtrarAcertadores();if(!acertadores.length){alert('Nenhum acertador encontrado para este placar.');return}let e=acertadores[Math.floor(Math.random()*acertadores.length)];if(vencedor&&acertadores.length>1){let t=0;while(e.usuario===vencedor.usuario&&t<30){e=acertadores[Math.floor(Math.random()*acertadores.length)];t++}}vencedor=e;$('winnerName').textContent=e.usuario;$('winnerScore').textContent='Palpite: '+e.palpite.replace('x',' x ');$('winner').style.display='block'}
function abrirModoGravacao(){if(!vencedor)sortear();if(!vencedor)return;$('mgame').textContent=$('jogo').value+' • '+acertadores.length+' participante(s)';$('mname').textContent=vencedor.usuario;$('modal').classList.add('open')}function fecharModo(){$('modal').classList.remove('open')}
function animarSorteio(){sortear();const nomes=acertadores.map(p=>p.usuario);if(!nomes.length)return;const name=$('mname'),count=$('mcount');let c=3;count.style.display='block';name.style.display='none';count.textContent=c;const cd=setInterval(()=>{c--;if(c>0)count.textContent=c;else{clearInterval(cd);count.style.display='none';name.style.display='block';let i=0,started=Date.now(),duration=2700;const roll=()=>{const progress=Math.min(1,(Date.now()-started)/duration),delay=28+Math.round(progress*95);name.textContent=nomes[i%nomes.length]||vencedor.usuario;i++;if(progress<1)setTimeout(roll,delay);else name.textContent='🎉 '+vencedor.usuario};roll()}},650)}
async function gerarLinkCelular(){if(!vencedor)sortear();if(!vencedor)return;const payload={campanha:$('campanha').value,premio:$('premio').value,jogo:$('jogo').value,placarCorreto:$('placar').value,timeA:$('timeA').value,timeB:$('timeB').value,flagA:'🇧🇷',flagB:'🇳🇴',participantes:acertadores,vencedor};const r=await fetch('/sorteios/sessao',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const j=await r.json();if(!j.ok){alert('Erro ao gerar link');return}const url=j.lanUrl||j.originUrl||(location.origin+j.url);$('linkBox').style.display='block';$('linkCelular').value=url;$('qrImg').src='https://api.qrserver.com/v1/create-qr-code/?size=220x220&data='+encodeURIComponent(url)}
function copiarLink(){$('linkCelular').select();document.execCommand('copy');alert('Link copiado.')}function abrirLink(){const u=$('linkCelular').value;if(u)window.open(u,'_blank')}async function salvarRegistro(){const payload={campanha:$('campanha').value,premio:$('premio').value,jogo:$('jogo').value,placarCorreto:$('placar').value,participantes,acertadores,vencedor};const r=await fetch('/sorteios/registro',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const j=await r.json();alert(j.ok?'Registro salvo: '+j.id:'Erro ao salvar')}function copiarResumo(){const txt=`🏆 ${$('campanha').value}\nJogo: ${$('jogo').value}\nPlacar correto: ${$('placar').value}\nAcertadores: ${acertadores.length}\nVencedor(a): ${vencedor?vencedor.usuario:'a definir'}`;navigator.clipboard.writeText(txt);alert('Resumo copiado.')}function limparTudo(){participantes=[];acertadores=[];vencedor=null;revisar=[];repetidos=0;$('comentarios').value='';['stLidos','stValidos','stRep','stAcert','prevCount'].forEach(id=>$(id).textContent='0');$('lista').innerHTML='<div class="sq-item"><div>—</div><div class="sq-user">Nenhum participante processado ainda</div><div class="sq-pill">—</div></div>';$('winner').style.display='none';$('review').style.display='none';$('linkBox').style.display='none'}
</script>
