<style>
:root{--sq-bg:#071018;--sq-card:#0d1823;--sq-card2:#111f2c;--sq-line:#223142;--sq-text:#f8fafc;--sq-muted:#94a3b8;--sq-green:#22c55e;--sq-blue:#2563eb;--sq-gold:#facc15;--sq-red:#dc2626;--sq-purple:#7c3aed}.content,.container,main{max-width:none!important}.sq-page{margin:-18px -12px -30px;padding:18px;min-height:calc(100vh - 70px);background:radial-gradient(circle at 80% 0%,rgba(37,99,235,.18),transparent 30%),radial-gradient(circle at 20% 10%,rgba(34,197,94,.12),transparent 36%),linear-gradient(135deg,#050b12,#09131d 42%,#05080d);color:var(--sq-text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial}.sq-top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.sq-brand{display:flex;gap:12px;align-items:center}.sq-brand-icon{font-size:34px}.sq-title{margin:0;font-size:25px;font-weight:1000}.sq-sub{margin:3px 0 0;color:var(--sq-muted)}.sq-layout{display:grid;grid-template-columns:390px 1fr 340px;gap:14px}.sq-card{background:linear-gradient(180deg,rgba(17,31,44,.96),rgba(10,20,30,.96));border:1px solid var(--sq-line);border-radius:16px;padding:16px;box-shadow:0 16px 60px rgba(0,0,0,.28)}.sq-card h3{margin:0 0 13px;font-size:17px}.sq-section-title{color:var(--sq-green);font-weight:1000}.sq-field{margin-bottom:11px}.sq-field label{display:block;color:#cbd5e1;font-size:12px;font-weight:800;margin-bottom:5px}.sq-input,.sq-textarea,.sq-select{width:100%;border:1px solid #26384b;background:#07111b;color:#fff;border-radius:10px;padding:11px 12px;outline:none}.sq-input:focus,.sq-textarea:focus{border-color:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.12)}.sq-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.sq-game-row{display:grid;grid-template-columns:1fr 32px 1fr;gap:8px;align-items:end}.sq-vs{text-align:center;font-weight:1000;color:#facc15;padding-bottom:11px}.sq-team{display:flex;gap:8px;align-items:center}.sq-team .flag{font-size:24px}.sq-textarea{min-height:260px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;resize:vertical}.sq-btn{border:0;border-radius:11px;padding:11px 13px;font-weight:1000;cursor:pointer;color:#fff;background:#334155;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:.15s}.sq-btn:hover{transform:translateY(-1px);filter:brightness(1.08)}.sq-btn.blue{background:linear-gradient(135deg,#2563eb,#1d4ed8)}.sq-btn.green{background:linear-gradient(135deg,#22c55e,#15803d)}.sq-btn.gold{background:linear-gradient(135deg,#facc15,#f59e0b);color:#111827}.sq-btn.purple{background:linear-gradient(135deg,#8b5cf6,#6d28d9)}.sq-btn.red{background:linear-gradient(135deg,#ef4444,#b91c1c)}.sq-btn.dark{background:#0f172a;border:1px solid #334155}.sq-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px}.sq-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.sq-stat{border:1px solid #25384c;border-radius:14px;padding:13px;min-height:78px;position:relative;overflow:hidden;background:#101b27}.sq-stat:after{content:'';position:absolute;right:-20px;bottom:-25px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,.04)}.sq-stat small{display:block;color:#cbd5e1;line-height:1.2}.sq-stat b{font-size:29px;display:block;margin-top:7px}.sq-stat.green{background:linear-gradient(135deg,rgba(34,197,94,.22),rgba(22,101,52,.20));border-color:#16a34a}.sq-stat.blue{background:linear-gradient(135deg,rgba(37,99,235,.30),rgba(30,64,175,.20));border-color:#2563eb}.sq-stat.gold{background:linear-gradient(135deg,rgba(250,204,21,.28),rgba(146,64,14,.20));border-color:#ca8a04}.sq-stat.gray{background:linear-gradient(135deg,rgba(148,163,184,.15),rgba(51,65,85,.18))}.sq-linkbox{display:none;margin-top:12px;border:1px solid rgba(34,197,94,.5);background:rgba(22,163,74,.08);border-radius:14px;padding:13px}.sq-linkgrid{display:grid;grid-template-columns:1fr 108px;gap:12px;align-items:center}.sq-help{font-size:12px;color:var(--sq-muted);line-height:1.45;margin-top:8px}.sq-alert{margin-top:12px;border:1px solid rgba(250,204,21,.35);background:rgba(250,204,21,.08);border-radius:13px;padding:12px;font-size:12px;color:#fde68a;line-height:1.45}.sq-okbox{margin-top:14px;border:1px solid rgba(34,197,94,.35);background:rgba(34,197,94,.08);border-radius:14px;padding:14px;color:#dcfce7}.sq-winner{border:1px solid rgba(250,204,21,.7);background:linear-gradient(135deg,rgba(250,204,21,.18),rgba(255,255,255,.06));border-radius:16px;padding:18px;text-align:center;margin:12px 0}.sq-winner small{color:#fde68a;font-weight:900}.sq-winner b{display:block;font-size:30px;margin:5px 0}.sq-list{border:1px solid #223142;border-radius:14px;overflow:hidden;background:#07111b;margin-top:10px}.sq-item{display:grid;grid-template-columns:34px 1fr 74px 88px;gap:10px;align-items:center;padding:11px 12px;border-bottom:1px solid #172436;font-size:13px}.sq-item:last-child{border-bottom:0}.sq-user{font-weight:1000}.sq-raw{font-size:11px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sq-pill{border-radius:999px;padding:5px 8px;text-align:center;font-weight:1000;background:#1e293b;color:#cbd5e1}.sq-pill.ok{background:rgba(34,197,94,.18);color:#86efac}.sq-preview{position:sticky;top:12px}.phone{width:100%;max-width:315px;margin:auto;border:10px solid #111;border-radius:42px;background:#000;box-shadow:0 25px 80px rgba(0,0,0,.55);overflow:hidden}.phone-screen{aspect-ratio:9/16;padding:18px 14px;color:#fff;text-align:center;background:radial-gradient(circle at 50% 0%,rgba(250,204,21,.34),transparent 26%),linear-gradient(180deg,#071d10,#020617);position:relative}.phone-screen:before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.18) 1px,transparent 2px);background-size:30px 30px;opacity:.45}.phone-inner{position:relative;z-index:1;height:100%;display:flex;flex-direction:column;align-items:center}.phone-cup{font-size:58px;margin:8px 0}.phone h4{font-size:25px;line-height:1;margin:5px 0 10px}.phone-flags{display:flex;gap:9px;align-items:center;justify-content:center;font-size:22px;margin:8px 0}.phone-prize{border:1px solid rgba(255,255,255,.18);border-radius:13px;padding:10px;margin:10px 0;font-weight:900;background:rgba(0,0,0,.25)}.phone-count{margin-top:auto;border:1px solid rgba(255,255,255,.22);border-radius:14px;padding:10px 30px}.phone-btn{margin-top:12px;background:linear-gradient(135deg,#facc15,#f59e0b);color:#111;padding:12px 22px;border-radius:999px;font-weight:1000}.sq-modal{position:fixed;inset:0;background:rgba(2,6,23,.86);z-index:9999;display:none;align-items:center;justify-content:center;padding:24px}.sq-modal.open{display:flex}.stage-wide{width:min(1100px,96vw);height:min(620px,88vh);border-radius:28px;overflow:hidden;position:relative;color:#fff;background:radial-gradient(circle at 50% 0%,rgba(250,204,21,.22),transparent 26%),radial-gradient(circle at 18% 30%,rgba(34,197,94,.35),transparent 30%),radial-gradient(circle at 84% 28%,rgba(220,38,38,.25),transparent 28%),linear-gradient(180deg,#062b16,#020617)}.stage-wide:before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.18) 1px,transparent 2px);background-size:38px 38px;opacity:.55}.stage-panel{position:relative;z-index:1;height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:36px}.stage-box{width:min(760px,92%);border:1px solid rgba(255,255,255,.20);border-radius:28px;background:rgba(0,0,0,.35);box-shadow:0 24px 90px rgba(0,0,0,.48);padding:28px}.stage-logo{width:100px;background:#fff;border-radius:10px;padding:7px}.stage-title{font-size:48px;margin:16px 0 4px;font-weight:1000;text-transform:uppercase}.stage-game{color:#bbf7d0;font-weight:900}.stage-name{margin:22px auto;background:linear-gradient(90deg,#fff,#fff5bd);color:#0f172a;border-radius:22px;padding:24px;font-size:42px;font-weight:1000}.stage-count{font-size:100px;color:#facc15;font-weight:1000;display:none}.stage-foot{position:absolute;left:30px;right:30px;bottom:22px;display:flex;justify-content:space-between;font-weight:900}.qrBox{width:108px;height:108px;background:#fff;border-radius:8px;padding:5px}.qrBox img{width:100%;height:100%}@media(max-width:1250px){.sq-layout{grid-template-columns:1fr}.sq-preview{position:relative}.phone{display:none}.sq-stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.sq-row,.sq-game-row{grid-template-columns:1fr}.sq-vs{display:none}.sq-stats{grid-template-columns:1fr}.sq-item{grid-template-columns:28px 1fr 58px}.sq-item div:last-child{display:none}.sq-linkgrid{grid-template-columns:1fr}.sq-page{margin:0;padding:12px}.sq-title{font-size:21px}}
</style>
<div class="sq-page">
  <div class="sq-top">
    <div class="sq-brand"><div class="sq-brand-icon">🎁</div><div><h1 class="sq-title">Promoções & Sorteios</h1><p class="sq-sub">Crie promoções, cole comentários, filtre acertadores e sorteie com apresentação profissional.</p></div></div>
    <a class="sq-btn dark" href="/">← Voltar</a>
  </div>
  <div class="sq-layout">
    <div>
      <section class="sq-card">
        <h3 class="sq-section-title">1. Dados da campanha</h3>
        <div class="sq-field"><label>Nome da campanha</label><input class="sq-input" id="campanha" value="Palpite Premiado Brasil x Noruega"></div>
        <div class="sq-field"><label>Prêmio</label><input class="sq-input" id="premio" value="Álbum de Figurinhas Copa 2026 + 1 pacote"></div>
        <div class="sq-game-row">
          <div class="sq-field"><label>Time 1</label><input class="sq-input" id="timeA" value="🇧🇷 Brasil"></div><div class="sq-vs">X</div>
          <div class="sq-field"><label>Time 2</label><input class="sq-input" id="timeB" value="🇳🇴 Noruega"></div>
        </div>
        <div class="sq-field"><label>Jogo</label><input class="sq-input" id="jogo" value="Brasil x Noruega"></div>
        <div class="sq-field"><label>Placar correto</label><input class="sq-input" id="placar" value="2x1" placeholder="Ex: 2x1"></div>
      </section>
      <section class="sq-card" style="margin-top:14px">
        <h3 class="sq-section-title">2. Comentários do Instagram</h3>
        <textarea id="comentarios" class="sq-textarea" placeholder="Cole aqui os comentários copiados do Instagram..."></textarea>
        <div class="sq-help">Cole o texto copiado do Instagram. O sistema busca @, placar e ignora linhas como Responder, horas e curtidas.</div>
        <div class="sq-actions"><button class="sq-btn blue" onclick="processar()">🔎 Processar comentários</button><button class="sq-btn" onclick="limparTudo()">🧹 Limpar</button></div>
        <div id="review" class="sq-alert" style="display:none"></div>
      </section>
    </div>
    <div>
      <section class="sq-card">
        <h3 class="sq-section-title">3. Resumo</h3>
        <div class="sq-stats">
          <div class="sq-stat green"><small>Comentários lidos</small><b id="stLidos">0</b></div>
          <div class="sq-stat blue"><small>Participantes válidos</small><b id="stValidos">0</b></div>
          <div class="sq-stat gold"><small>Acertadores</small><b id="stAcert">0</b></div>
          <div class="sq-stat gray"><small>Repetidos removidos</small><b id="stRep">0</b></div>
        </div>
        <div class="sq-actions"><button class="sq-btn green" onclick="filtrarAcertadores()">✅ Filtrar acertadores</button><button class="sq-btn blue" onclick="sortear()">🎲 Sortear agora</button><button class="sq-btn purple" onclick="abrirModoGravacao()">🎥 Modo notebook</button><button class="sq-btn" onclick="copiarResumo()">📋 Copiar resumo</button><button class="sq-btn" onclick="salvarRegistro()">💾 Salvar registro</button></div>
        <div id="linkBox" class="sq-linkbox"><b style="color:#bbf7d0">Link para abrir no celular</b><div class="sq-linkgrid"><div><input id="linkCelular" class="sq-input" readonly style="color:#22c55e"><div class="sq-help">Use o link com IP da rede, não o localhost. Celular e notebook precisam estar no mesmo Wi‑Fi.</div></div><div class="qrBox"><img id="qrImg" alt="QR Code"></div></div><div class="sq-actions"><button class="sq-btn green" onclick="copiarLink()">Copiar link</button><button class="sq-btn dark" onclick="abrirLink()">Abrir no notebook</button></div></div>
        <div id="winner" class="sq-winner" style="display:none"><small>VENCEDOR(A)</small><b id="winnerName"></b><div id="winnerScore" class="sq-help"></div></div>
      </section>
      <section class="sq-card" style="margin-top:14px">
        <h3>Acertadores / participantes para sorteio</h3>
        <div id="lista" class="sq-list"><div class="sq-item"><div>—</div><div class="sq-user">Nenhum participante processado ainda</div><div class="sq-pill">—</div><div></div></div></div>
      </section>
      <div id="okbox" class="sq-okbox" style="display:none">🎉 Tudo pronto! Confira os acertadores, clique em “Sortear agora” e gere o link para gravar no celular.</div>
    </div>
    <aside class="sq-preview">
      <section class="sq-card"><h3 style="text-align:center;color:#fde68a">APRESENTAÇÃO NO CELULAR</h3><p class="sq-sub" style="text-align:center;margin-bottom:12px">Preview da tela vertical para gravar.</p><div class="phone"><div class="phone-screen"><div class="phone-inner"><div class="phone-cup">🏆</div><div style="color:#fde68a;font-weight:1000">COPA DO MUNDO 2026</div><h4>PALPITE PREMIADO</h4><div class="phone-flags"><span>🇧🇷</span><b>BRASIL X NORUEGA</b><span>🇳🇴</span></div><div class="phone-prize">PRÊMIO<br>ÁLBUM OFICIAL<br>+ 1 PACOTE</div><div class="phone-count"><b id="prevCount">0</b><br><small>participantes</small></div><div class="phone-btn">INICIAR SORTEIO ›</div><div style="font-size:11px;margin-top:10px">Quality Celulares<br>www.qualitycel.com.br</div></div></div></div><div class="sq-actions"><button class="sq-btn green" style="width:100%" onclick="gerarLinkCelular()">📱 Gerar link + QR Code</button></div></section>
    </aside>
  </div>
</div>
<div id="modal" class="sq-modal"><div class="stage-wide"><div class="stage-panel"><div class="stage-box"><img class="stage-logo" src="/public/LogoSemFundo.png"><div class="stage-title">Palpite Premiado</div><div class="stage-game" id="mgame">Brasil x Noruega</div><div id="mcount" class="stage-count">3</div><div id="mname" class="stage-name">Clique em iniciar</div><div class="sq-actions" style="justify-content:center"><button class="sq-btn gold" onclick="animarSorteio()">▶️ Iniciar sorteio</button><button class="sq-btn" onclick="fecharModo()">Fechar</button></div></div></div><div class="stage-foot"><span>Quality Celulares</span><span>www.qualitycel.com.br</span></div></div></div>
<script>
let participantes=[], acertadores=[], vencedor=null, revisar=[];
const $=id=>document.getElementById(id);
function normScore(s){return (s||'').toLowerCase().replace(/brasil|noruega|noroegua|nonuega|pro|para|ganha|de|🇧🇷|🇳🇴|\./g,' ').replace(/[×xX]/g,'x').replace(/\s+/g,' ').trim();}
function extractScore(txt){
  const t=(txt||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[×]/g,'x');
  let m=t.match(/(\d{1,2})\s*(?:x|a|-)\s*(\d{1,2})/i); if(m) return `${m[1]}x${m[2]}`;
  m=t.match(/brasil\D{0,12}(\d{1,2})\D{0,12}(\d{1,2})\D{0,12}(noruega|noroegua|nonuega)/i); if(m) return `${m[1]}x${m[2]}`;
  m=t.match(/(noruega|noroegua|nonuega)\D{0,12}(\d{1,2})\D{0,12}(\d{1,2})\D{0,12}brasil/i); if(m) return `${m[3]}x${m[2]}`;
  return null;
}
function limparLinha(l){return (l||'').replace(/\b\d+\s*(d|h|min)\b/gi,'').replace(/\bResponder\b/gi,'').replace(/\b\d+\s*gostos?\b/gi,'').trim();}
function looksMeta(l){return /^\s*$/.test(l)||/^(responder|ver tradução|curtir|enviar)$/i.test(l.trim())||/^\d+\s*(d|h|min)\s*responder$/i.test(l.trim())||/^\d+\s*gostos?\s*responder$/i.test(l.trim());}
function processar(){
  const raw=$('comentarios').value; const linhas=raw.split(/\n+/).map(x=>x.trim()).filter(x=>!looksMeta(x));
  const chunks=[]; let buffer='';
  for(const ln of linhas){
    const clean=limparLinha(ln); if(!clean) continue;
    if(buffer && (/@[\w.]+/.test(clean) || /\d\s*[xXa×-]\s*\d/.test(clean) || /brasil/i.test(clean))){ chunks.push(buffer.trim()); buffer=clean; } else { buffer += (buffer?' ':'')+clean; }
  }
  if(buffer) chunks.push(buffer.trim());
  const seen=new Map(); let rep=0; revisar=[]; participantes=[];
  for(const c of chunks){
    const userMatch=c.match(/@[a-zA-Z0-9._]+/); const score=extractScore(c);
    if(!score) continue;
    if(!userMatch){ revisar.push(c); continue; }
    const usuario=userMatch[0].toLowerCase();
    if(seen.has(usuario)){ rep++; continue; }
    const obj={usuario, palpite:score, comentario:c}; seen.set(usuario,obj); participantes.push(obj);
  }
  acertadores=[]; vencedor=null; render(chunks.length,rep,true); $('okbox').style.display=participantes.length?'block':'none';
}
function filtrarAcertadores(){ if(!participantes.length) processar(); const correto=extractScore($('placar').value)||normScore($('placar').value); acertadores=participantes.filter(p=>p.palpite===correto); vencedor=null; render(null,null,false); $('prevCount').textContent=acertadores.length||participantes.length; }
function render(lidos=null,rep=null,showReview=false){
  if(lidos!==null) $('stLidos').textContent=lidos; $('stValidos').textContent=participantes.length; if(rep!==null) $('stRep').textContent=rep; $('stAcert').textContent=acertadores.length; $('prevCount').textContent=acertadores.length||participantes.length;
  const lista=acertadores.length?acertadores:participantes;
  $('lista').innerHTML=lista.length?lista.map((p,i)=>`<div class="sq-item"><div>${i+1}</div><div><div class="sq-user">${p.usuario}</div><div class="sq-raw">${esc(p.comentario)}</div></div><div class="sq-pill ${acertadores.includes(p)?'ok':''}">${p.palpite}</div><div>${acertadores.includes(p)?'✅ Acertou':''}</div></div>`).join(''):'<div class="sq-item"><div>—</div><div class="sq-user">Nenhum participante encontrado</div><div class="sq-pill">—</div><div></div></div>';
  if(showReview&&revisar.length){$('review').style.display='block';$('review').innerHTML='<b>Atenção:</b> estes palpites parecem não ter @ e ficaram fora do sorteio automático:<br>'+revisar.map(x=>'• '+esc(x)).join('<br>');} else if(showReview){$('review').style.display='none'}
  if(!vencedor) $('winner').style.display='none';
}
function esc(s){return String(s||'').replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));}
function sortear(){ if(!acertadores.length) filtrarAcertadores(); if(!acertadores.length){alert('Nenhum acertador encontrado para este placar.');return;} vencedor=acertadores[Math.floor(Math.random()*acertadores.length)]; $('winnerName').textContent=vencedor.usuario; $('winnerScore').textContent='Palpite: '+vencedor.palpite; $('winner').style.display='block'; }
function abrirModoGravacao(){ if(!vencedor) sortear(); if(!vencedor) return; $('mgame').textContent=$('jogo').value+' • '+acertadores.length+' participante(s)'; $('mname').textContent=vencedor.usuario; $('modal').classList.add('open'); }
function fecharModo(){ $('modal').classList.remove('open'); }
function animarSorteio(){ const nomes=acertadores.map(p=>p.usuario); if(!nomes.length) return; const name=$('mname'), count=$('mcount'); let c=3; count.style.display='block'; name.style.display='none'; count.textContent=c; const cd=setInterval(()=>{c--; if(c>0) count.textContent=c; else{clearInterval(cd); count.style.display='none'; name.style.display='block'; let i=0,total=58; const timer=setInterval(()=>{name.textContent=nomes[i%nomes.length]; i++; if(i>total){clearInterval(timer); name.textContent='🎉 '+vencedor.usuario;}},55+Math.min(i*4,145));}},800); }
async function gerarLinkCelular(){ if(!vencedor) sortear(); if(!vencedor) return; const payload={campanha:$('campanha').value,premio:$('premio').value,jogo:$('jogo').value,placarCorreto:$('placar').value,timeA:$('timeA').value,timeB:$('timeB').value,flagA:'🇧🇷',flagB:'🇳🇴',participantes:acertadores,vencedor}; const r=await fetch('/sorteios/sessao',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}); const j=await r.json(); if(!j.ok){alert('Erro ao gerar link');return;} const url=j.lanUrl||j.originUrl||(location.origin+j.url); $('linkBox').style.display='block'; $('linkCelular').value=url; $('qrImg').src='https://api.qrserver.com/v1/create-qr-code/?size=220x220&data='+encodeURIComponent(url); }
function copiarLink(){ $('linkCelular').select(); document.execCommand('copy'); alert('Link copiado.'); }
function abrirLink(){ const u=$('linkCelular').value; if(u) window.open(u,'_blank'); }
async function salvarRegistro(){ const payload={campanha:$('campanha').value,premio:$('premio').value,jogo:$('jogo').value,placarCorreto:$('placar').value,participantes,acertadores,vencedor}; const r=await fetch('/sorteios/registro',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}); const j=await r.json(); alert(j.ok?'Registro salvo: '+j.id:'Erro ao salvar'); }
function copiarResumo(){ const txt=`🏆 ${$('campanha').value}\nJogo: ${$('jogo').value}\nPlacar correto: ${$('placar').value}\nAcertadores: ${acertadores.length}\nVencedor(a): ${vencedor?vencedor.usuario:'a definir'}`; navigator.clipboard.writeText(txt); alert('Resumo copiado.'); }
function limparTudo(){ participantes=[]; acertadores=[]; vencedor=null; revisar=[]; $('comentarios').value=''; ['stLidos','stValidos','stRep','stAcert','prevCount'].forEach(id=>$(id).textContent='0'); $('lista').innerHTML='<div class="sq-item"><div>—</div><div class="sq-user">Nenhum participante processado ainda</div><div class="sq-pill">—</div><div></div></div>'; $('winner').style.display='none'; $('review').style.display='none'; $('linkBox').style.display='none'; $('okbox').style.display='none'; }
</script>
