<% layout('layout') -%>
<%
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const pct=v=>v===null||v===undefined||v===''?'—':`${Number(v).toLocaleString('pt-BR',{minimumFractionDigits:0,maximumFractionDigits:2})}%`;
const esc=v=>String(v??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
const productRows=(rows||[]).filter(r=>r.scope==='product');
const variationRows=(rows||[]).filter(r=>r.scope==='variation');
const rounding=rules?.global?.rounding||'exact';
%>
<section class="pricing-page">
  <header class="pricing-hero">
    <div><span class="pricing-kicker">GESTÃO · PRODUTOS</span><h1>🏷️ Precificação Inteligente</h1><p>Defina margens sem conflito: <b>Variação → Produto → Categoria → Regra geral</b>. A regra mais específica sempre prevalece.</p></div>
    <div class="pricing-actions"><a class="btn" href="/erp/produtos">📦 Produtos</a><a class="btn" href="/erp/compras">🚚 Compras</a></div>
  </header>

  <section class="pricing-info"><b>Como a margem funciona?</b><span>Nesta tela, margem é calculada <strong>sobre o custo</strong>. Ex.: custo R$ 100 + margem alvo 20% = preço sugerido R$ 120. O sistema sugere; nada muda sem você aplicar.</span></section>

  <section class="pricing-grid-top">
    <article class="pricing-panel"><header><div><h2>Regra geral</h2><small>Fallback para itens sem regra própria.</small></div></header><div class="pricing-form-row"><label>Margem alvo (%)<input id="globalMargin" type="number" min="0" step="0.01" value="<%= rules?.global?.marginPercent ?? '' %>" placeholder="Sem regra geral"></label><label>Arredondamento<select id="rounding"><option value="exact" <%= rounding==='exact'?'selected':'' %>>Exato (2 casas)</option><option value="ending_90" <%= rounding==='ending_90'?'selected':'' %>>Terminar em ,90</option><option value="ending_99" <%= rounding==='ending_99'?'selected':'' %>>Terminar em ,99</option><option value="up_integer" <%= rounding==='up_integer'?'selected':'' %>>Inteiro para cima</option></select></label><button class="btn primary" id="saveGlobal">Salvar</button></div></article>
    <article class="pricing-panel"><header><div><h2>Atribuir a vários produtos</h2><small>Selecione produtos abaixo e grave a mesma margem própria neles.</small></div></header><div class="pricing-form-row"><label>Margem própria (%)<input id="bulkMargin" type="number" min="0" step="0.01" placeholder="Vazio = voltar a herdar"></label><button class="btn primary" id="applyBulk">Aplicar aos selecionados</button></div></article>
  </section>

  <details class="pricing-panel pricing-categories">
    <summary><span><b>Margens padrão por categoria</b><small>Úteis como base; produtos e variações podem ter margens diferentes dentro da mesma categoria.</small></span><strong><%= categories.length %> categoria(s)</strong></summary>
    <div class="pricing-category-grid">
      <% categories.forEach(cat=>{ const rule=rules?.categories?.[cat.id]; %>
        <label class="pricing-category"><span><b><%= cat.name %></b><small><%= cat.type==='service'?'Serviço':'Produto' %></small></span><input type="number" min="0" step="0.01" data-category-margin="<%= cat.id %>" value="<%= rule?.marginPercent ?? '' %>" placeholder="Herdar geral"><button type="button" class="btn" data-save-category="<%= cat.id %>">Salvar</button></label>
      <% }) %>
    </div>
  </details>

  <section class="pricing-filter pricing-panel"><form method="get" action="/erp/precificacao"><label>Buscar<input name="q" value="<%= filters.q %>" placeholder="Produto, código, SKU..."></label><label>Categoria<select name="categoryId"><option value="">Todas</option><% categories.forEach(cat=>{ %><option value="<%= cat.id %>" <%= String(filters.categoryId)===String(cat.id)?'selected':'' %>><%= cat.name %></option><% }) %></select></label><button class="btn primary">Filtrar</button><a class="btn" href="/erp/precificacao">Limpar</a></form></section>

  <section class="pricing-panel"><header class="pricing-table-head"><div><h2>Produtos e variações</h2><small><%= productRows.length %> produto(s) · <%= variationRows.length %> variação(ões)</small></div><div class="pricing-apply"><span id="selectedSuggested">0 selecionado(s)</span><button class="btn primary" id="applySuggested">Aplicar preços sugeridos</button></div></header>
    <div class="pricing-table-wrap"><table class="pricing-table"><thead><tr><th><input type="checkbox" id="checkAllProducts" title="Selecionar produtos para atribuição em massa"></th><th>Produto / variação</th><th>Categoria</th><th>Preço compra</th><th>Preço venda atual</th><th>Margem própria</th><th>Margem efetiva</th><th>Origem</th><th>Preço sugerido</th><th>Aplicar preço</th></tr></thead><tbody>
      <% (rows||[]).forEach(row=>{ const isVariation=row.scope==='variation'; const changed=row.suggestedSalePrice!==null && Math.abs(Number(row.suggestedSalePrice)-Number(row.salePrice||0))>=0.01; %>
        <tr class="<%= isVariation?'is-variation':'is-product' %>" data-row-key="<%= row.key %>">
          <td><% if(!isVariation){ %><input type="checkbox" class="bulk-product" value="<%= row.productId %>"><% } %></td>
          <td><div class="pricing-product-name"><% if(isVariation){ %><span class="variation-branch">↳</span><% } %><b><%= row.name %></b><% if(isVariation){ %><small><%= row.variationLabel %></small><% } else if(row.hasVariations){ %><small>Possui variações</small><% } %></div></td>
          <td><%= row.categoryName || '—' %></td><td class="num"><%= money(row.cost) %></td><td class="num"><%= money(row.salePrice) %></td>
          <td><div class="inline-margin"><input type="number" min="0" step="0.01" value="<%= row.ownMargin ?? '' %>" placeholder="Herdar" data-margin-scope="<%= row.scope %>" data-product-id="<%= row.productId %>" data-inventory-id="<%= row.inventoryItemId %>"><button type="button" class="mini-save" title="Salvar margem">✓</button></div></td>
          <td class="num"><b><%= pct(row.effectiveMargin) %></b></td><td><span class="rule-badge rule-<%= row.source %>"><%= row.sourceLabel %></span></td>
          <td class="num"><% if(row.suggestedSalePrice===null){ %>—<% } else { %><b class="<%= changed?'suggested-change':'' %>"><%= money(row.suggestedSalePrice) %></b><% if(changed){ %><small class="price-diff"><%= Number(row.suggestedSalePrice)>Number(row.salePrice||0)?'↑':'↓' %> <%= money(Math.abs(Number(row.suggestedSalePrice)-Number(row.salePrice||0))) %></small><% } %><% } %></td>
          <td><% if(row.suggestedSalePrice!==null){ %><input type="checkbox" class="suggested-check" value="<%= row.key %>" <%= changed?'':'disabled' %> title="Aplicar este preço sugerido"><% } %></td>
        </tr>
      <% }) %>
    </tbody></table></div>
  </section>
</section>

<style>
.pricing-page{padding:24px;display:grid;gap:14px}.pricing-hero{display:flex;justify-content:space-between;gap:16px;align-items:center;border:1px solid var(--line);background:var(--card);border-radius:16px;padding:18px}.pricing-kicker{font-size:10px;font-weight:900;letter-spacing:.08em;color:var(--blue)}.pricing-hero h1{margin:4px 0;font-size:25px}.pricing-hero p{margin:0;color:var(--muted)}.pricing-actions{display:flex;gap:8px}.pricing-info{display:flex;gap:10px;align-items:center;border:1px solid color-mix(in srgb,var(--blue) 30%,var(--line));background:color-mix(in srgb,var(--blue) 7%,var(--card));border-radius:12px;padding:11px 13px}.pricing-info span{color:var(--muted);font-size:12px}.pricing-grid-top{display:grid;grid-template-columns:1fr 1fr;gap:12px}.pricing-panel{border:1px solid var(--line);background:var(--card);border-radius:14px;overflow:hidden}.pricing-panel>header{display:flex;justify-content:space-between;align-items:center;padding:13px 14px;border-bottom:1px solid var(--line)}.pricing-panel h2{font-size:15px;margin:0}.pricing-panel small{display:block;color:var(--muted);margin-top:3px}.pricing-form-row{display:flex;gap:10px;align-items:end;padding:14px}.pricing-form-row label,.pricing-filter label{display:grid;gap:5px;font-size:11px;font-weight:800}.pricing-form-row input,.pricing-form-row select,.pricing-filter input,.pricing-filter select{min-height:38px;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:8px;padding:0 9px}.pricing-categories summary{display:flex;justify-content:space-between;align-items:center;padding:13px 14px;cursor:pointer}.pricing-categories summary span small{display:block}.pricing-category-grid{padding:10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:8px;border-top:1px solid var(--line)}.pricing-category{display:grid;grid-template-columns:minmax(130px,1fr) 100px auto;align-items:center;gap:8px;border:1px solid var(--line);border-radius:9px;padding:8px}.pricing-category input{width:100%;min-height:34px}.pricing-filter form{display:flex;gap:8px;align-items:end;padding:10px}.pricing-filter label:first-child{flex:1}.pricing-table-head{gap:10px}.pricing-apply{display:flex;align-items:center;gap:8px}.pricing-apply span{font-size:11px;color:var(--muted)}.pricing-table-wrap{overflow:auto;max-height:66vh}.pricing-table{width:100%;border-collapse:collapse;font-size:11px}.pricing-table th{position:sticky;top:0;background:color-mix(in srgb,var(--card) 94%,var(--text));z-index:2;text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);white-space:nowrap}.pricing-table td{padding:8px;border-bottom:1px solid var(--line);vertical-align:middle}.pricing-table tr:nth-child(even){background:color-mix(in srgb,var(--text) 2.5%,transparent)}.pricing-table tr.is-variation{background:color-mix(in srgb,var(--blue) 3.5%,transparent)}.pricing-table .num{text-align:right;white-space:nowrap}.pricing-product-name{display:flex;align-items:center;gap:6px;min-width:260px}.pricing-product-name small{display:inline;margin:0;color:var(--muted)}.variation-branch{color:var(--blue);font-weight:900}.inline-margin{display:flex;gap:4px}.inline-margin input{width:84px;min-height:31px;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:7px;padding:0 7px}.mini-save{width:30px;border:1px solid var(--line);border-radius:7px;background:var(--card);color:var(--text);cursor:pointer}.rule-badge{display:inline-block;padding:3px 7px;border-radius:999px;background:color-mix(in srgb,var(--text) 8%,transparent);white-space:nowrap}.rule-variation{color:#a855f7}.rule-product{color:#2563eb}.rule-category{color:#d97706}.rule-global{color:#16a34a}.rule-none{color:var(--muted)}.suggested-change{color:#16a34a}.price-diff{font-size:9px!important;text-align:right}.btn.primary{background:var(--blue);color:#fff;border-color:var(--blue)}@media(max-width:900px){.pricing-grid-top{grid-template-columns:1fr}.pricing-hero{align-items:flex-start;flex-direction:column}.pricing-filter form{flex-wrap:wrap}.pricing-filter label:first-child{flex-basis:100%}}
</style>
<script>
(()=>{const $=s=>document.querySelector(s);const all=s=>[...document.querySelectorAll(s)];async function post(url,body){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));if(!r.ok||j.success===false)throw new Error(j.message||'Não foi possível salvar.');return j;}function done(msg){alert(msg);location.reload();}
$('#saveGlobal')?.addEventListener('click',async()=>{try{const j=await post('/erp/api/precificacao/global',{marginPercent:$('#globalMargin').value,rounding:$('#rounding').value});done(j.message);}catch(e){alert(e.message);}});
all('[data-save-category]').forEach(btn=>btn.addEventListener('click',async()=>{try{const id=btn.dataset.saveCategory,input=document.querySelector(`[data-category-margin="${CSS.escape(id)}"]`);const j=await post(`/erp/api/precificacao/categorias/${encodeURIComponent(id)}`,{marginPercent:input?.value||''});done(j.message);}catch(e){alert(e.message);}}));
$('#checkAllProducts')?.addEventListener('change',e=>all('.bulk-product').forEach(c=>c.checked=e.target.checked));
$('#applyBulk')?.addEventListener('click',async()=>{const ids=all('.bulk-product:checked').map(c=>c.value);if(!ids.length)return alert('Selecione ao menos um produto.');try{const j=await post('/erp/api/precificacao/produtos/bulk',{productIds:ids,marginPercent:$('#bulkMargin').value});done(`${j.message} ${j.updated||0} produto(s).`);}catch(e){alert(e.message);}});
all('.mini-save').forEach(btn=>btn.addEventListener('click',async()=>{const input=btn.previousElementSibling,scope=input.dataset.marginScope;try{let j;if(scope==='variation')j=await post('/erp/api/precificacao/variacoes',{productId:input.dataset.productId,inventoryItemId:input.dataset.inventoryId,marginPercent:input.value});else j=await post(`/erp/api/precificacao/produtos/${encodeURIComponent(input.dataset.productId)}`,{marginPercent:input.value});done(j.message);}catch(e){alert(e.message);}}));
function updateSelected(){const n=all('.suggested-check:checked').length;$('#selectedSuggested').textContent=`${n} selecionado(s)`;}all('.suggested-check').forEach(c=>c.addEventListener('change',updateSelected));updateSelected();
$('#applySuggested')?.addEventListener('click',async()=>{const keys=all('.suggested-check:checked').map(c=>c.value);if(!keys.length)return alert('Selecione ao menos um preço sugerido.');if(!confirm(`Aplicar ${keys.length} preço(s) sugerido(s) no cadastro ERP?`))return;try{const j=await post('/erp/api/precificacao/aplicar',{keys});done(`${j.message} ${j.updated||0} preço(s) alterado(s).`);}catch(e){alert(e.message);}});
})();
</script>
