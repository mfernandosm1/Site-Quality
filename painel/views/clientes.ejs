<section class="customers-page" id="customersPage">
<style>
.customers-page{padding:20px 24px 40px;color:#e5e7eb}.customers-hero,.customers-card{border:1px solid #30363d;background:#101214;border-radius:14px}.customers-hero{display:flex;justify-content:space-between;gap:18px;padding:18px;margin-bottom:14px}.customers-kicker{font-size:10px;font-weight:900;color:#60a5fa;letter-spacing:.08em}.customers-hero h1{margin:4px 0 5px;font-size:25px}.customers-hero p{margin:0;color:#94a3b8;font-size:12px}.customers-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.customers-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.customers-kpi{border:1px solid #30363d;background:#111315;border-radius:12px;padding:13px}.customers-kpi span{display:block;color:#94a3b8;font-size:10px;font-weight:900;text-transform:uppercase}.customers-kpi strong{display:block;font-size:24px;margin-top:5px}.customers-card{padding:14px}.customers-filters{display:grid;grid-template-columns:2fr repeat(4,minmax(145px,1fr)) auto;gap:8px;align-items:end}.customers-filter-actions{display:flex;gap:8px;align-items:center;white-space:nowrap}.customers-filters label,.customer-field label{display:block;font-size:10px;font-weight:900;color:#94a3b8;text-transform:uppercase;margin-bottom:5px}.customers-filters input,.customers-filters select,.customer-field input,.customer-field select,.customer-field textarea{width:100%;box-sizing:border-box;border:1px solid #374151;background:#17191d;color:#fff;border-radius:9px;padding:9px;min-height:39px}.customers-list-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:15px 0 9px}.customers-pagination{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px;flex-wrap:wrap}.customers-pagination-info{font-size:11px;color:#94a3b8}.customers-pagination-links{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.customers-pagination-links a,.customers-pagination-links span{display:inline-flex;min-width:34px;min-height:32px;align-items:center;justify-content:center;padding:0 9px;border:1px solid #374151;border-radius:8px;text-decoration:none;color:inherit;background:#17191d}.customers-pagination-links .active{background:#2563eb;border-color:#2563eb;color:#fff}.customers-pagination-links .disabled{opacity:.45;pointer-events:none}.customers-bulk-actions{display:flex;align-items:center;gap:8px}.customer-select-cell{width:34px;text-align:center!important}.customer-select-cell input{width:16px;height:16px;cursor:pointer}.customers-bulk-count{font-size:11px;color:#94a3b8;min-width:92px;text-align:right}.customers-list-head h2{font-size:16px;margin:0}.customers-list-head p{margin:3px 0 0;color:#94a3b8;font-size:11px}.customers-table-wrap{overflow:auto;border:1px solid #30363d;border-radius:12px}.customers-table{width:100%;border-collapse:collapse;min-width:930px}.customers-table th,.customers-table td{padding:11px 10px;border-bottom:1px solid #2b3036;text-align:left;font-size:11px}.customers-table th{background:#17191d;color:#cbd5e1;text-transform:uppercase;font-size:9px}.customer-name strong{display:block;font-size:12px}.customer-name small{color:#94a3b8}.customer-contact{display:grid;gap:3px;line-height:1.25}.customer-contact-line{display:block;white-space:nowrap;font-weight:800}.customer-contact-email{display:block;color:#94a3b8;font-weight:400}.customer-status{display:inline-flex;padding:5px 8px;border-radius:999px;font-weight:900;font-size:9px}.customer-active{background:#052e16;color:#86efac;border:1px solid #166534}.customer-inactive{background:#3f1d0b;color:#fdba74;border:1px solid #9a3412}.customers-empty{text-align:center;padding:34px;color:#94a3b8}.customer-drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:1100}.customer-drawer{position:fixed;right:0;top:0;bottom:0;width:min(720px,96vw);background:#0e1012;border-left:1px solid #374151;z-index:1101;transform:translateX(100%);transition:.22s;overflow:auto}.customer-drawer.open{transform:translateX(0)}.customer-drawer-header{position:sticky;top:0;background:#111315;border-bottom:1px solid #30363d;padding:16px;display:flex;justify-content:space-between;z-index:2}.customer-drawer-header h2{margin:3px 0}.customer-close{border:0;background:#222;color:#fff;width:34px;height:34px;border-radius:9px;font-size:22px}.customer-drawer-body{padding:16px}.customer-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}.customer-tab{border:1px solid #374151;background:#17191d;color:#ddd;border-radius:9px;padding:8px 11px;font-weight:800}.customer-tab.active{background:#2563eb;border-color:#2563eb;color:#fff}.customer-panel[hidden]{display:none!important}.customer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.customer-field.full{grid-column:1/-1}.customer-save-bar{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #30363d}.customer-message{padding:10px;border-radius:9px;margin-top:12px}.customer-message.error{background:#3f1d0b;color:#fed7aa}.customer-message.success{background:#052e16;color:#bbf7d0}.customer-document-valid{border-color:#22c55e!important;box-shadow:0 0 0 1px rgba(34,197,94,.18)}.customer-document-invalid{border-color:#ef4444!important;box-shadow:0 0 0 1px rgba(239,68,68,.18)}.customer-cnpj-note{grid-column:1/-1;border:1px solid #1e3a5f;background:#0c1b2d;color:#bfdbfe;border-radius:10px;padding:10px;font-size:11px}.customer-pj-field[hidden]{display:none!important}.customer-document-warning{border-color:#f59e0b!important;box-shadow:0 0 0 1px rgba(245,158,11,.18)}.customer-document-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:6px}.customer-document-open{border:1px solid #92400e;background:#451a03;color:#fde68a;border-radius:7px;padding:5px 8px;font-size:10px;font-weight:900;cursor:pointer}.customer-document-reactivate{border:1px solid #166534;background:#052e16;color:#bbf7d0;border-radius:7px;padding:5px 8px;font-size:10px;font-weight:900;cursor:pointer}.customer-age-info{display:block;margin-top:5px;min-height:14px;color:#94a3b8;font-size:11px}.duplicate-box{border:1px solid #854d0e;background:#422006;border-radius:10px;padding:11px;margin-top:10px}.duplicate-box strong{display:block;margin-bottom:5px}.duplicate-box p{margin:3px 0;font-size:11px}.btn.danger{background:#7f1d1d;color:#fff}.btn.success{background:#166534;color:#fff}@media(max-width:900px){.customers-kpis{grid-template-columns:repeat(2,1fr)}.customers-filters{grid-template-columns:1fr 1fr}.customer-grid{grid-template-columns:1fr}}@media(max-width:600px){.customers-page{padding:14px}.customers-hero{flex-direction:column}.customers-kpis,.customers-filters{grid-template-columns:1fr}}

