<% layout('layout') -%>
<section class="customers-page" id="customersPage">
<style>
.customers-page{padding:20px 24px 40px;color:#e5e7eb}.customers-hero,.customers-card{border:1px solid #30363d;background:#101214;border-radius:14px}.customers-hero{display:flex;justify-content:space-between;gap:18px;padding:18px;margin-bottom:14px}.customers-kicker{font-size:10px;font-weight:900;color:#60a5fa;letter-spacing:.08em}.customers-hero h1{margin:4px 0 5px;font-size:25px}.customers-hero p{margin:0;color:#94a3b8;font-size:12px}.customers-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.customers-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.customers-kpi{border:1px solid #30363d;background:#111315;border-radius:12px;padding:13px}.customers-kpi span{display:block;color:#94a3b8;font-size:10px;font-weight:900;text-transform:uppercase}.customers-kpi strong{display:block;font-size:24px;margin-top:5px}.customers-card{padding:14px}.customers-filters{display:grid;grid-template-columns:2fr repeat(3,minmax(150px,1fr)) auto;gap:8px;align-items:end}.customers-filters label,.customer-field label{display:block;font-size:10px;font-weight:900;color:#94a3b8;text-transform:uppercase;margin-bottom:5px}.customers-filters input,.customers-filters select,.customer-field input,.customer-field select,.customer-field textarea{width:100%;box-sizing:border-box;border:1px solid #374151;background:#17191d;color:#fff;border-radius:9px;padding:9px;min-height:39px}.customers-list-head{display:flex;justify-content:space-between;align-items:center;margin:15px 0 9px}.customers-list-head h2{font-size:16px;margin:0}.customers-list-head p{margin:3px 0 0;color:#94a3b8;font-size:11px}.customers-table-wrap{overflow:auto;border:1px solid #30363d;border-radius:12px}.customers-table{width:100%;border-collapse:collapse;min-width:930px}.customers-table th,.customers-table td{padding:11px 10px;border-bottom:1px solid #2b3036;text-align:left;font-size:11px}.customers-table th{background:#17191d;color:#cbd5e1;text-transform:uppercase;font-size:9px}.customer-name strong{display:block;font-size:12px}.customer-name small{color:#94a3b8}.customer-status{display:inline-flex;padding:5px 8px;border-radius:999px;font-weight:900;font-size:9px}.customer-active{background:#052e16;color:#86efac;border:1px solid #166534}.customer-inactive{background:#3f1d0b;color:#fdba74;border:1px solid #9a3412}.customers-empty{text-align:center;padding:34px;color:#94a3b8}.customer-drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:1100}.customer-drawer{position:fixed;right:0;top:0;bottom:0;width:min(720px,96vw);background:#0e1012;border-left:1px solid #374151;z-index:1101;transform:translateX(100%);transition:.22s;overflow:auto}.customer-drawer.open{transform:translateX(0)}.customer-drawer-header{position:sticky;top:0;background:#111315;border-bottom:1px solid #30363d;padding:16px;display:flex;justify-content:space-between;z-index:2}.customer-drawer-header h2{margin:3px 0}.customer-close{border:0;background:#222;color:#fff;width:34px;height:34px;border-radius:9px;font-size:22px}.customer-drawer-body{padding:16px}.customer-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}.customer-tab{border:1px solid #374151;background:#17191d;color:#ddd;border-radius:9px;padding:8px 11px;font-weight:800}.customer-tab.active{background:#2563eb;border-color:#2563eb;color:#fff}.customer-panel[hidden]{display:none!important}.customer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.customer-field.full{grid-column:1/-1}.customer-save-bar{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #30363d}.customer-message{padding:10px;border-radius:9px;margin-top:12px}.customer-message.error{background:#3f1d0b;color:#fed7aa}.customer-message.success{background:#052e16;color:#bbf7d0}.customer-document-valid{border-color:#22c55e!important;box-shadow:0 0 0 1px rgba(34,197,94,.18)}.customer-document-invalid{border-color:#ef4444!important;box-shadow:0 0 0 1px rgba(239,68,68,.18)}.customer-cnpj-note{grid-column:1/-1;border:1px solid #1e3a5f;background:#0c1b2d;color:#bfdbfe;border-radius:10px;padding:10px;font-size:11px}.customer-pj-field[hidden]{display:none!important}.customer-document-warning{border-color:#f59e0b!important;box-shadow:0 0 0 1px rgba(245,158,11,.18)}.customer-document-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:6px}.customer-document-open{border:1px solid #92400e;background:#451a03;color:#fde68a;border-radius:7px;padding:5px 8px;font-size:10px;font-weight:900;cursor:pointer}.customer-document-reactivate{border:1px solid #166534;background:#052e16;color:#bbf7d0;border-radius:7px;padding:5px 8px;font-size:10px;font-weight:900;cursor:pointer}.customer-age-info{display:block;margin-top:5px;min-height:14px;color:#94a3b8;font-size:11px}.duplicate-box{border:1px solid #854d0e;background:#422006;border-radius:10px;padding:11px;margin-top:10px}.duplicate-box strong{display:block;margin-bottom:5px}.duplicate-box p{margin:3px 0;font-size:11px}.btn.danger{background:#7f1d1d;color:#fff}.btn.success{background:#166534;color:#fff}@media(max-width:900px){.customers-kpis{grid-template-columns:repeat(2,1fr)}.customers-filters{grid-template-columns:1fr 1fr}.customer-grid{grid-template-columns:1fr}}@media(max-width:600px){.customers-page{padding:14px}.customers-hero{flex-direction:column}.customers-kpis,.customers-filters{grid-template-columns:1fr}}
</style>
<header class="customers-hero"><div><span class="customers-kicker">ERP · CLIENTES v0.12.6</span><h1>Central do Cliente</h1><p>Cadastro mestre único, preparado para WhatsApp, orçamentos, vendas, O.S. e financeiro.</p></div><div class="customers-actions"><a class="btn" href="/erp">← Voltar ao ERP</a><button class="btn primary" id="customerNewButton" type="button">+ Novo cliente</button></div></header>
<section class="customers-kpis"><article class="customers-kpi"><span>Total de clientes</span><strong><%= summary.total %></strong></article><article class="customers-kpi"><span>Ativos</span><strong><%= summary.active %></strong></article><article class="customers-kpi"><span>Inativos</span><strong><%= summary.inactive %></strong></article><article class="customers-kpi"><span>Novos neste mês</span><strong><%= summary.newThisMonth %></strong></article></section>
<section class="customers-card">
<div class="customers-filters"><div><label for="customerSearch">Pesquisar</label><input id="customerSearch" type="search" placeholder="Nome, código, telefone, CPF/CNPJ ou e-mail..."></div><div><label for="customerStatusFilter">Situação</label><select id="customerStatusFilter"><option value="">Todos</option><option value="active">Ativos</option><option value="inactive">Inativos</option></select></div><div><label for="customerTypeFilter">Pessoa</label><select id="customerTypeFilter"><option value="">Todos</option><option value="pf">Pessoa física</option><option value="pj">Pessoa jurídica</option></select></div><div><label for="customerClassificationFilter">Classificação</label><select id="customerClassificationFilter"><option value="">Todas</option><% classifications.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select></div><button class="btn" id="customerClearFilters" type="button">Limpar</button></div>
<div class="customers-list-head"><div><h2>Clientes cadastrados</h2><p id="customerResultCount"><%= customers.length %> cliente(s) encontrado(s)</p></div><span class="badge">Cadastro Mestre</span></div>
<div class="customers-table-wrap"><table class="customers-table"><thead><tr><th>Código</th><th>Cliente</th><th>CPF/CNPJ</th><th>Contato</th><th>Cidade</th><th>Classificação</th><th>Situação</th><th>Ações</th></tr></thead><tbody id="customersTableBody"><% customers.forEach(customer => { %><tr data-customer-row data-search="<%= customer.searchText %>" data-status="<%= customer.active ? 'active' : 'inactive' %>" data-type="<%= customer.personType %>" data-classification="<%= customer.classificationId %>"><td><strong><%= customer.code %></strong></td><td class="customer-name"><strong><%= customer.name %></strong><small><%= customer.personType === 'pj' ? (customer.tradeName || 'Pessoa jurídica') : 'Pessoa física' %></small></td><td><%= customer.documentFormatted || '—' %></td><td><strong><%= customer.mobileFormatted || customer.phoneFormatted || '—' %></strong><br><small><%= customer.email || '' %></small></td><td><%= customer.city ? `${customer.city}${customer.state ? `/${customer.state}` : ''}` : '—' %></td><td><%= customer.classificationName %></td><td><span class="customer-status customer-<%= customer.active ? 'active' : 'inactive' %>"><%= customer.active ? 'Ativo' : 'Inativo' %></span></td><td><button class="btn customer-edit" type="button" data-id="<%= customer.id %>">Ver detalhes</button></td></tr><% }) %></tbody></table><div class="customers-empty" id="customersEmpty" <%= customers.length ? 'hidden' : '' %>>Nenhum cliente encontrado.</div></div>
</section>
<script id="customersData" type="application/json"><%- JSON.stringify(customersRaw || []).replace(/</g,'\\u003c') %></script>
<script id="customerClassificationsData" type="application/json"><%- JSON.stringify(classifications || []).replace(/</g,'\\u003c') %></script>
</section>
<div class="customer-drawer-backdrop" id="customerDrawerBackdrop" hidden></div><aside class="customer-drawer" id="customerDrawer" aria-hidden="true"><header class="customer-drawer-header"><div><span class="customers-kicker">CADASTRO MESTRE</span><h2 id="customerDrawerTitle">Novo cliente</h2><small id="customerDrawerCode"></small></div><button class="customer-close" id="customerDrawerClose" type="button">×</button></header><div class="customer-drawer-body"><div class="customer-tabs"><button class="customer-tab active" type="button" data-customer-tab="main">Dados principais</button><button class="customer-tab" type="button" data-customer-tab="address">Endereço</button><button class="customer-tab" type="button" data-customer-tab="relationship">Relacionamento</button></div><form id="customerForm"><input type="hidden" name="id" id="customerId"><section class="customer-panel" data-customer-panel="main"><div class="customer-grid"><div class="customer-field"><label>Tipo de pessoa</label><select name="personType" id="customerPersonType"><option value="pf">Pessoa física</option><option value="pj">Pessoa jurídica</option></select></div><div class="customer-field"><label id="customerDocumentLabel">CPF</label><input name="document" id="customerDocument" inputmode="numeric" autocomplete="off" maxlength="18"></div><div class="customer-field"><label>Nome / Razão social *</label><input name="name" id="customerName" maxlength="160" required></div><div class="customer-field"><label>Nome fantasia</label><input name="tradeName" id="customerTradeName" maxlength="160"></div><div class="customer-field"><label>RG / Inscrição estadual</label><input name="stateRegistration" id="customerStateRegistration"></div>
<div class="customer-cnpj-note customer-pj-field" id="customerCnpjNote" hidden>Ao informar um CNPJ válido, o Painel Quality consulta os dados públicos da empresa e preenche o cadastro automaticamente.</div>
<div class="customer-field customer-pj-field" hidden><label>Situação cadastral</label><input name="companyStatus" id="customerCompanyStatus"></div>
<div class="customer-field customer-pj-field" hidden><label>Data de abertura</label><input name="openingDate" id="customerOpeningDate" type="date"></div>
<div class="customer-field customer-pj-field" hidden><label>Natureza jurídica</label><input name="legalNature" id="customerLegalNature"></div>
<div class="customer-field customer-pj-field" hidden><label>Porte</label><input name="companySize" id="customerCompanySize"></div>
<div class="customer-field full customer-pj-field" hidden><label>Atividade principal (CNAE)</label><input name="primaryCnae" id="customerPrimaryCnae"></div>
<div class="customer-field customer-pf-field"><label>Data de nascimento</label><input name="birthDate" id="customerBirthDate" type="date"><small class="customer-age-info" id="customerAgeInfo" aria-live="polite"></small></div><div class="customer-field"><label>Celular / WhatsApp</label><input name="mobile" id="customerMobile" inputmode="tel"></div><div class="customer-field"><label>Telefone</label><input name="phone" id="customerPhone" inputmode="tel"></div><div class="customer-field full"><label>E-mail</label><input name="email" id="customerEmail" type="email"></div></div></section><section class="customer-panel" data-customer-panel="address" hidden><div class="customer-grid"><div class="customer-field"><label>CEP</label><input name="zipCode" id="customerZipCode" inputmode="numeric"></div><div class="customer-field"><label>Estado</label><input name="state" id="customerState" maxlength="2"></div><div class="customer-field full"><label>Rua</label><input name="street" id="customerStreet"></div><div class="customer-field"><label>Número</label><input name="number" id="customerNumber"></div><div class="customer-field"><label>Complemento</label><input name="complement" id="customerComplement"></div><div class="customer-field"><label>Bairro</label><input name="district" id="customerDistrict"></div><div class="customer-field"><label>Cidade</label><input name="city" id="customerCity"></div></div></section><section class="customer-panel" data-customer-panel="relationship" hidden><div class="customer-grid"><div class="customer-field"><label>Classificação</label><select name="classificationId" id="customerClassification"><% classifications.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select></div><div class="customer-field"><label>Origem do cliente</label><input name="origin" id="customerOrigin" placeholder="WhatsApp, indicação, loja..."></div><div class="customer-field"><label>Situação</label><select name="active" id="customerActive"><option value="true">Ativo</option><option value="false">Inativo</option></select></div><div class="customer-field full"><label>Observações</label><textarea name="notes" id="customerNotes" rows="5" maxlength="2000"></textarea></div></div></section><div class="duplicate-box" id="customerDuplicateBox" hidden></div><div class="customer-message" id="customerMessage" hidden></div><div class="customer-save-bar"><button class="btn danger" id="customerToggleActive" type="button" hidden>Inativar</button><button class="btn primary" id="customerSave" type="submit">Salvar cliente</button></div></form></div></aside>
<script src="/public/js/clientes.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const customerId = new URLSearchParams(window.location.search).get('abrir');
  if (!customerId) return;
  const button = document.querySelector(`.customer-edit[data-id="${CSS.escape(customerId)}"]`);
  if (button) setTimeout(() => button.click(), 0);
});
</script>
