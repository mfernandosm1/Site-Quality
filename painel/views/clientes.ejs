.customer-manage{position:relative}.customer-manage summary{list-style:none;cursor:pointer}.customer-manage summary::-webkit-details-marker{display:none}.customer-manage-menu{position:fixed;left:0;top:0;z-index:1300;display:none;min-width:220px;max-width:min(300px,calc(100vw - 20px));padding:6px;background:#101214;border:1px solid #30363d;border-radius:10px;box-shadow:0 12px 30px #0008}.customer-manage[open] .customer-manage-menu{display:block}.customer-manage-menu a,.customer-manage-menu button{display:block;width:100%;padding:9px 10px;border:0;background:transparent;color:#fff;text-align:left;text-decoration:none;border-radius:7px;font:inherit;cursor:pointer}.customer-manage-menu a:hover,.customer-manage-menu button:hover{background:#24282e}.customer-finance-modal{position:fixed;inset:0;z-index:1000;background:#0009;display:grid;place-items:center}.customer-finance-modal[hidden]{display:none}.customer-finance-card{width:min(520px,calc(100vw - 30px));background:#101214;color:#fff;border:1px solid #30363d;border-radius:14px;padding:18px;position:relative}.customer-finance-card>button{position:absolute;right:12px;top:10px;border:0;background:#222;color:#fff;border-radius:50%;width:30px;height:30px}.customer-finance-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.customer-finance-grid div{padding:10px;border:1px solid #30363d;border-radius:9px}.customer-finance-grid span{display:block;font-size:11px;color:#9ca3af}.customer-finance-grid strong{font-size:18px}.customer-finance-alert{margin-top:10px;padding:10px;border-radius:8px;background:#3b0b12;color:#fecaca}html[data-panel-theme="light"] .customer-manage-menu,html[data-panel-theme="light"] .customer-finance-card{background:#fff;color:#111827;border-color:#cbd5e1}html[data-panel-theme="light"] .customer-manage-menu a,html[data-panel-theme="light"] .customer-manage-menu button{color:#111827}html[data-panel-theme="light"] .customer-manage-menu a:hover,html[data-panel-theme="light"] .customer-manage-menu button:hover{background:#f1f5f9}html[data-panel-theme="light"] .customer-finance-grid div{border-color:#e2e8f0}
.customer-feature-modal{position:fixed;inset:0;background:rgba(0,0,0,.68);z-index:1250;display:grid;place-items:center;padding:18px}.customer-feature-modal[hidden]{display:none}.customer-feature-card{width:min(1000px,96vw);max-height:90vh;overflow:auto;background:#101214;border:1px solid #374151;border-radius:14px;color:#e5e7eb}.customer-feature-card>header{position:sticky;top:0;display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#111315;border-bottom:1px solid #30363d;z-index:2}.customer-feature-card h2{margin:3px 0}.customer-feature-card>header button{border:0;background:#222;color:#fff;border-radius:8px;width:34px;height:34px;font-size:20px}.customer-feature-body{padding:16px}.customer-feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.customer-feature-grid>div,.wallet-summary{border:1px solid #30363d;border-radius:10px;padding:10px;background:#17191d}.customer-feature-grid span{display:block;font-size:10px;color:#94a3b8;text-transform:uppercase}.customer-history-table{width:100%;border-collapse:collapse;margin-top:12px}.customer-history-table th,.customer-history-table td{padding:9px;border-bottom:1px solid #30363d;text-align:left;font-size:11px}.customer-pagination{display:flex;justify-content:center;gap:8px;margin-top:12px}.wallet-form{display:grid;grid-template-columns:140px 160px 1fr auto;gap:8px;margin:12px 0}.wallet-form input,.wallet-form select{min-height:38px;border:1px solid #374151;border-radius:8px;background:#17191d;color:#fff;padding:8px}.wallet-entry{display:grid;grid-template-columns:120px 100px 1fr 130px;gap:8px;padding:9px;border-bottom:1px solid #30363d}.wallet-credit{color:#86efac}.wallet-debit{color:#fca5a5}body:not(.theme-black-oled):not([data-theme="black-oled"]) .customer-feature-card{background:#fff;color:#111;border-color:#cbd5e1}body:not(.theme-black-oled):not([data-theme="black-oled"]) .customer-feature-card>header{background:#f8fafc;border-color:#cbd5e1}body:not(.theme-black-oled):not([data-theme="black-oled"]) .customer-feature-grid>div,body:not(.theme-black-oled):not([data-theme="black-oled"]) .wallet-summary{background:#f8fafc;border-color:#cbd5e1}body:not(.theme-black-oled):not([data-theme="black-oled"]) .wallet-form input,body:not(.theme-black-oled):not([data-theme="black-oled"]) .wallet-form select{background:#fff;color:#111;border-color:#cbd5e1}@media(max-width:760px){.customer-feature-grid{grid-template-columns:repeat(2,1fr)}.wallet-form{grid-template-columns:1fr}.wallet-entry{grid-template-columns:1fr 1fr}}</style>
<header class="customers-hero"><div><span class="customers-kicker">ERP · CLIENTES v0.12.6</span><h1>Central do Cliente</h1><p>Cadastro mestre único, preparado para WhatsApp, orçamentos, vendas, O.S. e financeiro.</p></div><div class="customers-actions"><a class="btn" href="/erp">← Voltar ao ERP</a><a class="btn" href="/erp/clientes/importar-wm10">⇩ Importar WM10</a><button class="btn primary" id="customerNewButton" type="button">+ Novo cliente</button></div></header>
<section class="customers-kpis"><article class="customers-kpi erp-tone-info"><span>Total de clientes</span><strong><%= summary.total %></strong></article><article class="customers-kpi erp-tone-success"><span>Ativos</span><strong><%= summary.active %></strong></article><article class="customers-kpi erp-tone-expense"><span>Inativos</span><strong><%= summary.inactive %></strong></article><article class="customers-kpi erp-tone-income"><span>Novos neste mês</span><strong><%= summary.newThisMonth %></strong></article></section>
<section class="customers-card">
<form class="customers-filters" id="customerFiltersForm" method="get" action="/erp/clientes"><div><label for="customerSearch">Pesquisar</label><input id="customerSearch" name="q" type="search" value="<%= filters?.search || '' %>" placeholder="Nome, cidade, código, telefone, CPF/CNPJ ou e-mail..." autocomplete="off"></div><div><label for="customerStatusFilter">Situação</label><select id="customerStatusFilter" name="status"><option value="">Todos</option><option value="active" <%= filters?.status === 'active' ? 'selected' : '' %>>Ativos</option><option value="inactive" <%= filters?.status === 'inactive' ? 'selected' : '' %>>Inativos</option></select></div><div><label for="customerTypeFilter">Pessoa</label><select id="customerTypeFilter" name="type"><option value="">Todos</option><option value="pf" <%= filters?.type === 'pf' ? 'selected' : '' %>>Pessoa física</option><option value="pj" <%= filters?.type === 'pj' ? 'selected' : '' %>>Pessoa jurídica</option></select></div><div><label for="customerClassificationFilter">Classificação</label><select id="customerClassificationFilter" name="classification"><option value="">Todas</option><% classifications.forEach(item => { %><option value="<%= item.id %>" <%= String(filters?.classification || '') === String(item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %></select></div><div><label for="customerRegistrationFilter">Cadastro</label><select id="customerRegistrationFilter" name="registration"><option value="all" <%= !filters?.registration || filters.registration === 'all' ? 'selected' : '' %>>Todos</option><option value="recent" <%= filters?.registration === 'recent' ? 'selected' : '' %>>Mais recentes</option><option value="oldest" <%= filters?.registration === 'oldest' ? 'selected' : '' %>>Mais antigos</option><option value="last7" <%= filters?.registration === 'last7' ? 'selected' : '' %>>Últimos 7 dias</option></select></div><div class="customers-filter-actions"><button class="btn primary" id="customerSearchButton" type="submit">🔎 Buscar</button><button class="btn" id="customerClearFilters" type="button">Limpar</button></div></form>
<div class="customers-list-head"><div><h2>Clientes cadastrados</h2><p id="customerResultCount"><%= pagination?.totalFiltered ?? customers.length %> cliente(s) encontrado(s)</p></div><div class="customers-bulk-actions"><span class="customers-bulk-count" id="customerBulkCount">Nenhum selecionado</span><button class="btn success" id="customerBulkActivate" type="button" disabled>Reativar selecionados</button><button class="btn danger" id="customerBulkDeactivate" type="button" disabled>Inativar selecionados</button></div></div>
<div class="customers-table-wrap"><table class="customers-table"><thead><tr><th class="customer-select-cell"><input id="customerSelectAll" type="checkbox" aria-label="Selecionar clientes visíveis"></th><th>Código</th><th>Cliente</th><th>CPF/CNPJ</th><th>Contato</th><th>Cidade</th><th>Classificação</th><th>Situação</th><th>Gerenciar</th></tr></thead><tbody id="customersTableBody"><% customers.forEach(customer => {
  const displayCode = String(customer.code || '').replace(/^0+(?=\d)/, '') || '0';
  const contactDigits = value => String(value || '').replace(/\D/g, '');
  const comparableContact = value => {
    let digits = contactDigits(value);
    if (digits.length > 11 && digits.startsWith('55')) digits = digits.slice(2);
    return digits;
  };
  const mobileDisplay = customer.mobileFormatted || customer.mobile || '';
  const phoneDisplay = customer.phoneFormatted || customer.phone || '';
  const mobileComparable = comparableContact(customer.mobile || customer.mobileFormatted);
  const phoneComparable = comparableContact(customer.phone || customer.phoneFormatted);
  const hasMobile = Boolean(mobileComparable);
  const hasPhone = Boolean(phoneComparable);
  const sameContact = hasMobile && hasPhone && mobileComparable === phoneComparable;
%><tr data-customer-row data-id="<%= customer.id %>" data-search="<%= customer.searchText %>" data-status="<%= customer.active ? 'active' : 'inactive' %>" data-type="<%= customer.personType %>" data-classification="<%= customer.classificationId %>" data-created-at="<%= customer.createdAt || customer.registeredAt || '' %>"><td class="customer-select-cell"><input class="customer-row-select" type="checkbox" value="<%= customer.id %>" aria-label="Selecionar <%= customer.name %>"></td><td><strong><%= displayCode %></strong></td><td class="customer-name"><strong><%= customer.name %></strong><small><%= customer.personType === 'pj' ? (customer.tradeName || 'Pessoa jurídica') : 'Pessoa física' %></small></td><td><%= customer.documentFormatted || '—' %></td><td><div class="customer-contact">
<% if (hasMobile) { %><span class="customer-contact-line">📱 <%= mobileDisplay %></span><% } else if (hasPhone) { %><span class="customer-contact-line">📱 <%= phoneDisplay %></span><% } else { %><span class="customer-contact-line">—</span><% } %>
<% if (hasMobile && hasPhone && !sameContact) { %><span class="customer-contact-line">☎ <%= phoneDisplay %></span><% } %>
<% if (customer.email) { %><small class="customer-contact-email"><%= customer.email %></small><% } %>
</div></td><td><%= customer.city ? `${customer.city}${customer.state ? `/${customer.state}` : ''}` : '—' %></td><td><%= customer.classificationName %></td><td><span class="customer-status customer-<%= customer.active ? 'active' : 'inactive' %>"><%= customer.active ? 'Ativo' : 'Inativo' %></span></td><td><details class="customer-manage"><summary class="btn">Gerenciar</summary><div class="customer-manage-menu"><button class="customer-edit" type="button" data-id="<%= customer.id %>">Ver detalhes / Editar</button><a target="_blank" href="/erp/clientes/<%= encodeURIComponent(customer.id) %>/ficha">Imprimir ficha</a><button class="customer-credit-analysis" type="button" data-id="<%= customer.id %>">Análise de crédito</button><button class="customer-history" type="button" data-id="<%= customer.id %>">Histórico de operações</button><button class="customer-credit-account" type="button" data-id="<%= customer.id %>">Crediário do cliente</button><button class="customer-wallet" type="button" data-id="<%= customer.id %>">Carteira do cliente</button><a href="/erp/pdv?cliente=<%= encodeURIComponent(customer.id) %>">Nova venda no PDV</a><button class="customer-finance" type="button" data-id="<%= customer.id %>">Resumo financeiro</button></div></details></td></tr><% }) %></tbody></table><div class="customers-empty" id="customersEmpty" <%= customers.length ? 'hidden' : '' %>>Nenhum cliente encontrado.</div></div>
<% if (pagination) {
  const params = new URLSearchParams();
  if (filters?.search) params.set('q', filters.search);
  if (filters?.status) params.set('status', filters.status);
  if (filters?.type) params.set('type', filters.type);
  if (filters?.classification) params.set('classification', filters.classification);
  if (filters?.registration && filters.registration !== 'all') params.set('registration', filters.registration);
  if (pagination?.pageSize && pagination.pageSize !== 20) params.set('pageSize', pagination.pageSize);
  const pageHref = page => { const copy = new URLSearchParams(params); copy.set('page', page); return `/erp/clientes?${copy.toString()}`; };
  const firstPage = Math.max(1, pagination.currentPage - 2);
  const lastPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
%><nav class="customers-pagination" aria-label="Paginação de clientes"><div class="customers-pagination-info"><span>Exibindo <strong><%= pagination.start %>–<%= pagination.end %></strong> de <strong><%= pagination.totalFiltered %></strong></span><label class="customers-page-size">Por página <select id="customersPageSize" aria-label="Quantidade de clientes por página"><% [20,50,100,300].forEach(size => { %><option value="<%= size %>" <%= pagination.pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></label></div><div class="customers-pagination-links"><a class="<%= pagination.currentPage <= 1 ? 'disabled' : '' %>" href="<%= pagination.currentPage <= 1 ? '#' : pageHref(pagination.currentPage - 1) %>">← Anterior</a><% if (firstPage > 1) { %><a href="<%= pageHref(1) %>">1</a><% if (firstPage > 2) { %><span>…</span><% } } %><% for (let page = firstPage; page <= lastPage; page += 1) { %><a class="<%= page === pagination.currentPage ? 'active' : '' %>" href="<%= pageHref(page) %>"><%= page %></a><% } %><% if (lastPage < pagination.totalPages) { if (lastPage < pagination.totalPages - 1) { %><span>…</span><% } %><a href="<%= pageHref(pagination.totalPages) %>"><%= pagination.totalPages %></a><% } %><a class="<%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>" href="<%= pagination.currentPage >= pagination.totalPages ? '#' : pageHref(pagination.currentPage + 1) %>">Próxima →</a></div></nav><% } %>
</section>
<script>
(function(){
  const selector=document.getElementById('customersPageSize');
  if(!selector)return;
  selector.addEventListener('change',function(){
    const url=new URL(window.location.href);
    url.searchParams.set('pageSize',this.value);
    url.searchParams.set('page','1');
    window.location.href=url.toString();
  });
})();
</script>
<script id="customersData" type="application/json"><%- JSON.stringify(customersRaw || []).replace(/</g,'\\u003c') %></script>
<script id="customerFieldSettingsData" type="application/json"><%- JSON.stringify(customerFieldSettings || {fields:[]}).replace(/</g,'\\u003c') %></script>
<script id="customerFinancialData" type="application/json"><%- JSON.stringify(customerFinancialSummaries || {}).replace(/</g,'\u003c') %></script>
<script id="customerClassificationsData" type="application/json"><%- JSON.stringify(classifications || []).replace(/</g,'\\u003c') %></script>
