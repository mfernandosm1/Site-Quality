<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= firstAccess?'Primeiro acesso':'Entrar' %> · <%= company?.tradeName || 'Quality ERP' %></title>
<script>(function(){try{document.documentElement.setAttribute('data-panel-theme',localStorage.getItem('quality_panel_theme')||'light')}catch(e){}})();</script>
<link rel="stylesheet" href="/public/css/painel.css"><link rel="stylesheet" href="/public/css/painel-theme.css">
<style>
*{box-sizing:border-box}.login-page{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 15% 15%,color-mix(in srgb,var(--brand) 12%,transparent),transparent 38%),var(--bg)}.login-card{width:min(450px,96vw);border:1px solid var(--line);background:var(--card);border-radius:22px;padding:26px;box-shadow:0 24px 70px rgba(15,23,42,.12)}.login-brand{display:flex;align-items:center;gap:12px;margin-bottom:22px}.login-brand img{width:48px;height:48px;object-fit:contain}.login-mark{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:var(--brand);color:white;font-size:24px;font-weight:900}.login-brand strong{display:block;color:var(--text);font-size:18px}.login-brand small{color:var(--muted)}.login-kicker{font-size:10px;letter-spacing:.13em;font-weight:900;color:var(--muted)}.login-card h1{margin:5px 0 7px;color:var(--text);font-size:26px}.login-card>p{margin:0 0 18px;color:var(--muted);line-height:1.5}.login-error,.login-notice{margin:0 0 14px;padding:10px 12px;border-radius:10px;font-size:12px}.login-error{border:1px solid color-mix(in srgb,#dc2626 35%,var(--line));background:color-mix(in srgb,#dc2626 9%,var(--card));color:#dc2626}.login-notice{border:1px solid color-mix(in srgb,#16a34a 35%,var(--line));background:color-mix(in srgb,#16a34a 9%,var(--card));color:#15803d}.login-form{display:grid;gap:11px}.login-form label{display:grid;gap:5px}.login-form span{font-size:11px;font-weight:800;color:var(--muted)}.login-form input{height:43px;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:10px;padding:0 11px;font:inherit}.login-form input:focus{outline:2px solid color-mix(in srgb,var(--brand) 28%,transparent);border-color:var(--brand)}.login-form button{height:44px;margin-top:4px}.login-field-help{font-size:10px;color:var(--muted);line-height:1.35}.login-tip{margin-top:15px!important;padding-top:14px;border-top:1px solid var(--line);font-size:11px!important}.login-check{display:flex!important;grid-template-columns:none!important;align-items:flex-start;gap:8px!important}.login-check input{height:auto;width:auto;margin-top:2px}.login-check span{font-weight:600;line-height:1.4}.login-recover{display:block;text-align:center;margin-top:3px;color:var(--brand);font-size:12px;font-weight:800;text-decoration:none}.login-recover:hover{text-decoration:underline}
</style>
</head>
<body>
<main class="login-page">
  <section class="login-card">
    <div class="login-brand">
      <% if(company?.logoUrl){ %><img src="<%= company.logoUrl %>?v=<%= company.logoVersion||1 %>" alt="Logo"><% } else { %><div class="login-mark">Q</div><% } %>
      <div><strong><%= company?.tradeName || 'Quality ERP' %></strong><small><%= firstAccess?'Configuração inicial':'Acesso ao painel' %></small></div>
    </div>
    <% if(firstAccess){ %>
      <span class="login-kicker">PRIMEIRO ACESSO</span><h1>Criar administrador</h1><p>Cadastre o primeiro usuário. Depois disso o ERP passa a exigir login e aplicar as permissões de cada perfil.</p>
    <% } else { %>
      <span class="login-kicker">ACESSO SEGURO</span><h1>Entrar no ERP</h1><p>Use seu usuário ou e-mail e a senha cadastrada.</p>
    <% } %>
    <% if(error){ %><div class="login-error"><%= error %></div><% } %><% if(typeof notice!=='undefined' && notice){ %><div class="login-notice"><%= notice %></div><% } %>
    <% if(firstAccess){ %>
      <form class="login-form" method="post" action="/login/primeiro-acesso">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <label><span>Nome completo</span><input name="name" maxlength="120" required autofocus autocomplete="name" placeholder="Nome do administrador"></label>
        <label><span>Nome no PDV / O.S.</span><input name="displayName" maxlength="24" required placeholder="Ex.: Matheus"><small class="login-field-help">Máximo 24 caracteres. É o nome curto usado nas vendas e ordens de serviço.</small></label>
        <label><span>Usuário</span><input name="username" maxlength="80" minlength="3" required autocomplete="username" placeholder="ex.: matheus"></label>
        <label><span>E-mail *</span><input name="email" type="email" maxlength="140" required autocomplete="email" placeholder="seuemail@empresa.com.br"><small class="login-field-help">Obrigatório para identificação e recuperação de acesso.</small></label><label><span>Celular com DDD *</span><input name="mobile" inputmode="tel" maxlength="18" required autocomplete="tel" placeholder="(55) 99999-9999"><small class="login-field-help">Segundo canal de segurança para recuperação.</small></label>
        <label><span>Senha</span><input name="password" type="password" minlength="6" required autocomplete="new-password" placeholder="Mínimo 6 caracteres"></label>
        <label><span>Confirmar senha</span><input name="passwordConfirm" type="password" minlength="6" required autocomplete="new-password"></label>
        <label class="login-check"><input name="seller" type="checkbox" checked><span>Também usar este usuário como vendedor no PDV.</span></label>
        <button class="btn primary" type="submit">Criar administrador e entrar</button>
      </form>
    <% } else { %>
      <form class="login-form" method="post" action="/login">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <label><span>Usuário ou e-mail</span><input name="login" required autofocus autocomplete="username"></label>
        <label><span>Senha</span><input name="password" type="password" required autocomplete="current-password"></label>
        <button class="btn primary" type="submit">Entrar</button>
        <a class="login-recover" href="/recuperar-acesso">Esqueci meu usuário ou senha</a>
      </form>
      <p class="login-tip">Você pode entrar com <b>usuário ou e-mail</b>. Para recuperação sem outro administrador, use sua <b>chave pessoal de recuperação</b>. O cadastro de celular + e-mail já prepara a verificação em dois canais quando o envio automático estiver configurado.</p>
    <% } %>
  </section>
</main>
</body></html>
