<% layout('layout') -%>
<section class="stock-count-page">
<style>
.stock-count-page{max-width:1500px;margin:0 auto;padding:18px}.sc-hero,.sc-card{border:1px solid #2d3540;background:#101214;border-radius:14px;padding:16px}.sc-hero{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:14px}.sc-kicker{font-size:10px;font-weight:900;letter-spacing:.12em;color:#60a5fa}.sc-hero h1{margin:4px 0 4px;font-size:27px}.sc-hero p{margin:0;color:#94a3b8}.sc-actions{display:flex;gap:8px;flex-wrap:wrap}.sc-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;margin-bottom:14px}.sc-card h2{margin:0 0 5px;font-size:17px}.sc-card p{color:#94a3b8;font-size:12px}.sc-choice{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}.sc-choice label{border:1px solid #374151;border-radius:11px;padding:12px;cursor:pointer;background:#15181c}.sc-choice label:has(input:checked){border-color:#2563eb;background:#102446}.sc-choice strong,.sc-choice small{display:block}.sc-choice small{color:#94a3b8;margin-top:4px}.sc-switch{display:flex;gap:10px;align-items:flex-start;border:1px solid #374151;border-radius:11px;padding:12px;margin-bottom:10px}.sc-switch input{margin-top:3px}.sc-note{width:100%;min-height:74px;border:1px solid #374151;background:#0f1114;color:#fff;border-radius:9px;padding:10px;resize:vertical}.sc-warning{border-color:#7c2d12;background:#2b160c}.sc-warning strong{color:#fdba74}.sc-table-wrap{overflow:auto;border:1px solid #30363d;border-radius:12px}.sc-table{width:100%;border-collapse:collapse;min-width:900px}.sc-table th,.sc-table td{padding:11px 10px;border-bottom:1px solid #2b3036;text-align:left;font-size:11px}.sc-table th{background:#17191d;color:#cbd5e1;text-transform:uppercase;font-size:10px}.sc-status{display:inline-flex;padding:5px 8px;border-radius:999px;font-weight:900;font-size:10px}.sc-status-in_progress{background:#172554;color:#93c5fd;border:1px solid #1d4ed8}.sc-status-completed{background:#052e16;color:#86efac;border:1px solid #166534}.sc-status-cancelled{background:#3f1515;color:#fecaca;border:1px solid #991b1b}.sc-empty{text-align:center;padding:30px;color:#94a3b8}.sc-start{width:100%;margin-top:6px}.sc-error{margin-top:9px;padding:9px;border-radius:8px;background:#3f1515;color:#fecaca}.sc-lock{color:#fbbf24;font-weight:900}.sc-info{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;margin-left:5px;border:1px solid #64748b;border-radius:50%;font-size:10px;font-weight:900;color:#cbd5e1;cursor:help;vertical-align:middle}.sc-total-alert{display:none;margin:0 0 10px;padding:11px 12px;border:1px solid #991b1b;background:#3f1515;border-radius:10px;color:#fecaca;font-size:12px;font-weight:800;line-height:1.45}.sc-total-alert.show{display:block}.sc-total-alert strong{color:#fff}.sc-intro-highlight{margin:8px 0 4px!important;padding:10px 12px;border:1px solid #334155;border-left:4px solid #3b82f6;border-radius:9px;background:#111827;color:#dbeafe!important;font-size:12px!important;line-height:1.45}.sc-switch small{display:block;margin-top:5px;line-height:1.35}@media(max-width:850px){.sc-grid{grid-template-columns:1fr}.sc-choice{grid-template-columns:1fr}}
</style>
<header class="sc-hero"><div><span class="sc-kicker">ERP · ESTOQUE · INVENTÁRIO</span><h1>Contagens de estoque <span class="sc-info" title="Conte rápido com código de barras, confira divergências e aplique os ajustes com histórico completo. A contagem registra o estoque físico, compara com o saldo do sistema e, ao concluir, gera os ajustes com histórico de auditoria.">i</span></h1></div><div class="sc-actions"><a class="btn" href="/erp/estoque">← Estoque</a><a class="btn" href="/erp">ERP</a></div></header>
<% if (blockingCount) { %><section class="sc-card sc-warning"><strong>🔒 PDV bloqueado pela contagem <%= blockingCount.id %></strong><p>As vendas que movimentam estoque voltam a finalizar assim que esta contagem for concluída ou cancelada.</p><a class="btn" href="/erp/estoque/contagens/<%= blockingCount.id %>">Abrir contagem</a></section><br><% } %>
<div class="sc-grid"><section class="sc-card"><h2>+ Nova contagem</h2><p class="sc-intro-highlight"><strong>Parcial</strong> é a opção mais rápida para conferências do dia a dia. <strong>Total</strong> prepara todos os itens controlados para inventário geral.</p><form id="stockCountCreateForm"><div class="sc-choice"><label><input type="radio" name="type" value="partial" checked><strong>Contagem parcial</strong><small>Somente os produtos que você incluir serão ajustados.</small></label><label><input type="radio" name="type" value="total"><strong>Contagem total</strong><small>Ao final, o sistema também aponta produtos que ficaram sem contagem.</small></label></div><div id="totalCountAlert" class="sc-total-alert"><strong>ATENÇÃO — CONTAGEM TOTAL</strong><br>Ao concluir uma Contagem Total, os produtos controlados que não forem contados serão ajustados para <strong>ZERO</strong>. Antes de aplicar, o Quality mostrará quantos itens ficaram sem contagem e exigirá uma confirmação explícita.</div><label class="sc-switch"><input type="checkbox" id="blockPdv"><span><strong>Bloquear vendas no PDV durante a contagem</strong><small>Evita movimentações de estoque enquanto o inventário estiver aberto. <span class="sc-info" title="Enquanto esta opção estiver ativa, o PDV não poderá concluir operações que movimentem estoque. Ao concluir ou cancelar a contagem, o bloqueio é liberado.">i</span></small></span></label><textarea class="sc-note" id="countNotes" placeholder="Observação opcional..."></textarea><div id="createCountError" class="sc-error" hidden></div><button class="btn primary sc-start" type="submit">Iniciar contagem</button></form></section><section class="sc-card"><h2>Como funciona</h2><p><b>1.</b> Inicie a contagem.<br><br><b>2.</b> Leia o código de barras. Cada leitura soma +1 automaticamente.<br><br><b>3.</b> Se preferir, pesquise pelo nome, código ou SKU e informe a quantidade.<br><br><b>4.</b> Na conferência, veja apenas o que bateu, faltou ou sobrou.<br><br><b>5.</b> Ao concluir, o Quality gera as correções de inventário no histórico oficial.</p></section></div>
<section class="sc-card"><h2>Histórico de contagens</h2><div class="sc-table-wrap"><table class="sc-table"><thead><tr><th>Contagem</th><th>Situação</th><th>Tipo</th><th>Início</th><th>Itens</th><th>Unidades contadas</th><th>Divergências</th><th>PDV</th><th></th></tr></thead><tbody><% counts.forEach(c=>{ %><tr><td><strong><%= c.id %></strong><br><small><%= c.createdBy || 'painel' %></small></td><td><span class="sc-status sc-status-<%= c.status %>"><%= c.status==='in_progress'?'Em andamento':c.status==='completed'?'Concluída':'Cancelada' %></span></td><td><%= c.type==='total'?'Total':'Parcial' %></td><td><%= new Date(c.startedAt).toLocaleString('pt-BR') %></td><td><%= c.itemCount %></td><td><%= c.countedUnits %></td><td><%= c.status==='completed'?c.divergenceCount:'—' %></td><td><% if(c.blockPdv){ %><span class="sc-lock">Bloqueado</span><% } else { %>Liberado<% } %></td><td><a class="btn" href="/erp/estoque/contagens/<%= c.id %>">Abrir</a></td></tr><% }) %></tbody></table><% if(!counts.length){ %><div class="sc-empty">Nenhuma contagem criada ainda.</div><% } %></div></section>
</section>
<script src="/public/js/estoque-contagens.js"></script>
