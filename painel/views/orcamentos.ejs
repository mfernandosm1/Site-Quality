$('saveQuote').onclick=openSaveQuoteModal;$('confirmSaveQuote').onclick=confirmSaveQuote;$('closeSaveQuoteModal').onclick=closeSaveQuoteModal;$('cancelSaveQuote').onclick=closeSaveQuoteModal;$('saveQuoteModalBg').onclick=closeSaveQuoteModal;$('saveQuoteCustomerName').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();confirmSaveQuote()}};$('savedQuoteSearch').oninput=renderSavedQuotes;$('copyMessage').onclick=async()=>{try{await navigator.clipboard.writeText($('message').innerText);showResult('Texto copiado com emojis e quebras de linha.')}catch{showResult('Não foi possível copiar automaticamente.',false)}};$('sendWhatsApp').onclick=async()=>{if(!$('conversationId').value)return showResult('Selecione a conversa do cliente.',false);if(!confirm('Enviar este orçamento para a conversa selecionada?'))return;try{await api('/orcamentos/enviar-whatsapp',payload());showResult('Orçamento enviado para o WhatsApp.')}catch(e){showResult(e.message,false)}};$('newQuote').onclick=()=>location.href='/orcamentos';

function syncConditionToggles(){const active=showCash();['tableCashToggle','quoteCashToggle'].forEach(id=>{const b=$(id);if(b)b.classList.toggle('active',active)})}
function toggleCashDisplay(){const next=!showCash();saveLocalPrefs({showCash:next});settings={...settings,showCash:next};syncConditionToggles();renderPrepared();recalculateTableOffer();recalculate();showResult(next?'Valor à vista habilitado.':'Valor à vista ocultado.')}
if($('tableCashToggle'))$('tableCashToggle').onclick=toggleCashDisplay;if($('quoteCashToggle'))$('quoteCashToggle').onclick=toggleCashDisplay;
