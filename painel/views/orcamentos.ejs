<h3>Nomes das formas de pagamento</h3><p class="q-sub">Personalize exatamente como cada condição aparecerá no texto enviado ao cliente.</p><div class="q-grid"><div class="q-field s6"><label>Nome do cartão</label><input class="q-input" id="labelCard" placeholder="no cartão"></div><div class="q-field s6"><label>Nome do boleto / crediário</label><input class="q-input" id="labelCredit" placeholder="no boleto/crediário"></div><div class="q-field s6"><label>Nome do à vista com taxa</label><input class="q-input" id="labelCashWithFee" placeholder="à vista no Pix ou dinheiro"></div><div class="q-field s6"><label>Nome do à vista sem taxa</label><input class="q-input" id="labelCashNoFee" placeholder="à vista sem taxa"></div></div><h3>Padrões por ambiente</h3><div class="q-grid"><div class="q-field s6"><label>Tabela de preços</label><select class="q-select" id="defaultTableCashMode"><option value="withFee">À vista com taxa</option><option value="noFee">À vista sem taxa</option></select></div><div class="q-field s6"><label>Orçamento manual</label><select class="q-select" id="defaultManualCashMode"><option value="noFee">À vista sem taxa</option><option value="withFee">À vista com taxa</option></select></div></div><h3>Modelo da mensagem</h3><div class="q-grid"><div class="q-field s6"><label>Nome da oferta</label><input class="q-input" id="msgOfferTitle" placeholder="Ofertas de Julho Xiaomi 🔥"></div><div class="q-field s6"><label>Validade manual</label><input class="q-input" id="msgValidUntil" placeholder="02/07 às 18h"></div><div class="q-field s3"><label>Emoji produto</label><input class="q-input" id="msgProductEmoji"></div><div class="q-field s3"><label>Emoji parcelas</label><input class="q-input" id="msgInstallmentEmoji"></div><div class="q-field s3"><label>Emoji à vista</label><input class="q-input" id="msgCashEmoji"></div><div class="q-field s3"><label>Cabeçalho alternativo</label><input class="q-input" id="msgHeader"></div><div class="q-field s6"><label>Rodapé</label><input class="q-input" id="msgFooter"></div><div class="q-field s6"><label>Garantia</label><input class="q-input" id="msgWarranty"></div><div class="q-field s6"><label>Frete</label><input class="q-input" id="msgShipping"></div></div><button class="q-btn primary" id="saveSettings" style="margin-top:10px">💾 Salvar configurações</button></div>
<script>
const initialQuote=<%- quoteJson %>,productCatalog=<%- productsJson %>;let settings=<%- settingsJson %>,savedTables=<%- supplierTablesJson %>,messageTemplates=<%- messageTemplatesJson %>,savedQuotes=<%- quotesJson %>,currentId=initialQuote.id||'',workbookSheets=[],prepared=[],currentTableId='',lastImportSource='',dollarLoading=false;
function quoteLimit(){const local=Number(localStorage.getItem('quality_quote_max_items')||0),saved=Number(settings.limits?.maxItems||settings.maxQuoteItems||0);return Math.max(1,Math.min(300,local||saved||100))}
function savedDollarAdd(){const local=localStorage.getItem('quality_quote_dollar_add');return local!==null?num(local):num(settings.defaults?.dollarAdd||0)}
function getLocalPrefs(){try{return JSON.parse(localStorage.getItem('qualityQuotePrefs')||'{}')}catch{return {}}}function saveLocalPrefs(patch){const next={...getLocalPrefs(),...patch};localStorage.setItem('qualityQuotePrefs',JSON.stringify(next));return next}function tableCashMode(){const p=getLocalPrefs();return p.tableCashMode||settings.defaults?.tableCashMode||'withFee'}function manualCashMode(){const p=getLocalPrefs();return p.manualCashMode||settings.defaults?.manualCashMode||'noFee'}function paymentLabel(key,fallback){return String(settings.message?.paymentLabels?.[key]||fallback)}function normalizeTerms(source,fallback=[18,12]){const list=Array.isArray(source)?source.map(Number).filter(n=>n>=1&&n<=18):fallback;return [...new Set(list)]}function tableInstallments(){const p=getLocalPrefs();return normalizeTerms(Object.prototype.hasOwnProperty.call(p,'tableDisplayInstallments')?p.tableDisplayInstallments:settings.displayInstallments)}function manualInstallments(){const p=getLocalPrefs();return normalizeTerms(Object.prototype.hasOwnProperty.call(p,'manualDisplayInstallments')?p.manualDisplayInstallments:settings.displayInstallments)}function displayedInstallments(){return activeArea==='quote'?manualInstallments():tableInstallments()}function showCash(){const prefs=getLocalPrefs();return Object.prototype.hasOwnProperty.call(prefs,'showCash')?prefs.showCash:(settings.showCash!==false)}function roundToNine99Enabled(){const prefs=getLocalPrefs();return Object.prototype.hasOwnProperty.call(prefs,'roundToNine99')?prefs.roundToNine99:(settings.pricing?.roundToNine99!==false)}function commercialRound(value){const n=Number(value||0);if(!roundToNine99Enabled()||n<=0)return n;return Math.round((Math.ceil(((n+0.01)-1e-9)/10)*10-0.01)*100)/100}
function renderTermChips(){[['termChips','table'],['quoteTermChips','manual']].forEach(([id,scope])=>{const box=$(id);if(!box)return;const selected=scope==='table'?tableInstallments():manualInstallments();box.innerHTML=Array.from({length:18},(_,i)=>i+1).map(n=>`<button type="button" class="q-term-chip ${selected.includes(n)?'active':''}" data-term="${n}">${n}x</button>`).join('');box.querySelectorAll('.q-term-chip').forEach(btn=>btn.onclick=()=>toggleDisplayTerm(Number(btn.dataset.term),scope))})}
function toggleDisplayTerm(term,scope){let terms=scope==='table'?tableInstallments():manualInstallments();if(terms.includes(term)){terms=terms.filter(n=>n!==term)}else{terms=[...terms,term]}terms=[...new Set(terms)];saveLocalPrefs(scope==='table'?{tableDisplayInstallments:terms}:{manualDisplayInstallments:terms});renderTermChips();if(scope==='table'){renderPrepared();recalculateTableOffer()}else recalculate();showResult((scope==='table'?'Tabela de preços: ':'Orçamento manual: ')+(terms.length?terms.map(n=>n+'x').join(' e '):'somente à vista'))}
const $=id=>document.getElementById(id),brl=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}),pct=v=>Number(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'%';
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function num(v){if(typeof v==='number')return v;let s=String(v??'').trim().replace(/[^0-9,.-]/g,'');if(s.includes(',')&&s.includes('.'))s=s.lastIndexOf(',')>s.lastIndexOf('.')?s.replace(/\./g,'').replace(',','.'):s.replace(/,/g,'');else if(s.includes(','))s=s.replace(',','.');return Number(s)||0}
function api(url,data){return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({payload:JSON.stringify(data)})}).then(async r=>{const j=await r.json();if(!r.ok||!j.success)throw new Error(j.message||'Falha na operação.');return j})}
function showResult(text,ok=true){const r=$('result');r.textContent=text;r.className='q-result show '+(ok?'ok':'bad');setTimeout(()=>r.classList.remove('show'),4500)}
function quoteSubtotal(q){return Number(q?.calculation?.subtotal||q?.subtotal||0)}
function quoteProductSummary(q){const items=Array.isArray(q?.items)?q.items:[];const names=items.map(item=>String(item?.name||'').trim()).filter(Boolean);if(!names.length)return 'Produto não informado';const visible=names.slice(0,2);return visible.join(' • ')+(names.length>2?' • +'+(names.length-2)+' produto(s)':'')}
function quoteType(q){return q?.type==='table'||q?.pricingContext==='table'?'table':'manual'}
function quoteTypeLabel(q){return quoteType(q)==='table'?'TABELA':'MANUAL'}
function quoteDateTime(q){const value=q?.updatedAt||q?.createdAt;if(!value)return '';const date=new Date(value);return Number.isNaN(date.getTime())?'':date.toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})}
function renderSavedQuotes(){const box=$('savedQuotesList'),query=String($('savedQuoteSearch')?.value||'').trim().toLocaleLowerCase('pt-BR');if(!box)return;const list=(savedQuotes||[]).filter(q=>{const haystack=[q.customerName,quoteProductSummary(q),quoteTypeLabel(q),quoteType(q)].join(' ').toLocaleLowerCase('pt-BR');return haystack.includes(query)});$('savedQuotesCount').textContent=query?list.length+' de '+savedQuotes.length:savedQuotes.length;box.innerHTML=list.length?list.map(q=>{const type=quoteType(q),dateTime=quoteDateTime(q);return `<div class="q-saved-card" data-quote-id="${esc(q.id)}"><div class="q-saved-card-main"><div class="q-saved-card-info"><div class="q-saved-card-name">${esc(q.customerName||'Sem cliente')}</div><div class="q-saved-card-meta"><span class="q-saved-type ${type}">${quoteTypeLabel(q)}</span>${dateTime?`<span class="q-saved-date">${esc(dateTime)}</span>`:''}</div><div class="q-saved-card-products">📱 ${esc(quoteProductSummary(q))}</div></div><div class="q-saved-card-value">${brl(quoteSubtotal(q))}</div></div><div class="q-saved-card-actions"><a class="q-btn primary" href="/orcamentos?edit=${encodeURIComponent(q.id)}">Abrir</a><button class="q-btn danger saved-quote-delete" type="button" data-id="${esc(q.id)}">Excluir</button></div></div>`}).join(''):`<div class="q-saved-empty">${query?'Nenhum orçamento encontrado.':'Nenhum orçamento salvo ainda.'}</div>`;box.querySelectorAll('.saved-quote-delete').forEach(btn=>btn.onclick=()=>deleteSavedQuote(btn.dataset.id))}
async function deleteSavedQuote(id){const quote=(savedQuotes||[]).find(q=>q.id===id);if(!quote||!confirm(`Excluir o orçamento de ${quote.customerName||'Sem cliente'}?`))return;try{await api('/orcamentos/excluir',{id});savedQuotes=savedQuotes.filter(q=>q.id!==id);renderSavedQuotes();if(currentId===id){currentId='';history.replaceState(null,'','/orcamentos')}showResult('Orçamento excluído.')}catch(e){showResult(e.message,false)}}
function suggestedCustomerName(){const typed=String($('customerName')?.value||'').trim();if(typed)return typed;const select=$('conversationId');if(select?.value){const label=String(select.options[select.selectedIndex]?.text||'').split(' · ')[0].trim();if(label&&label!=='Selecionar quando for enviar')return label}return ''}
