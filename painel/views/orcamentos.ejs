function buildTradeEntryText(d){const entry=Math.max(0,Number(d.entry||0)),tradeValue=Math.max(0,Number(d.trade?.value||0)),tradeName=String(d.trade?.name||'').trim();const parts=[];if(tradeName||tradeValue>0){let text='Recebendo '+(tradeName||'seu aparelho')+' na troca';if(tradeValue>0)text+=' por '+brl(tradeValue);parts.push(text)}if(entry>0)parts.push(brl(entry)+' de entrada em dinheiro ou Pix');if(!parts.length)return '';if(parts.length===1)return parts[0]+' e o restante em:';return parts[0]+' + '+parts[1]+' e o restante em:'}
function buildSyncedClientMessage(d,c,fallback){
  const hasEntry=Number(d.entry||0)>0;
  const hasTrade=Boolean(String(d.trade?.name||'').trim())||Number(d.trade?.value||0)>0;
  if(!hasEntry&&!hasTrade)return fallback;

  const msg=settings.message||{};
  const terms=manualInstallments();
  const lines=[];
  const channel=d.paymentChannel==='credit'?'credit':'card';
  const channelLabel=channel==='credit'?paymentLabel('credit','no boleto/crediário'):paymentLabel('card','no cartão');
  const cashMode=d.cashMode==='withFee'?'withFee':'noFee';
  const cashLabel=cashMode==='withFee'?paymentLabel('cashWithFee','à vista no Pix ou dinheiro'):paymentLabel('cashNoFee','à vista no Pix ou dinheiro');
  const intro=String(msg.introText||'').trim();
  if(intro){lines.push(...intro.split('\n'));lines.push('')}

  const discount=Math.max(0,Number(d.entry||0))+Math.max(0,Number(d.trade?.value||0));
  (c.items||[]).forEach((item,i)=>{
    const source=d.items?.[i]||{};
    const itemTotal=Math.max(0,Number(item.total||0));
    const remaining=Math.max(0,itemTotal-discount);

    lines.push((msg.productEmoji||'📲')+' '+String(source.name||item.name||'Produto'));
    const tradeEntryText=buildTradeEntryText(d);
    if(tradeEntryText)lines.push(tradeEntryText);
    lines.push('Tem um *investimento* de');

    terms
      .map(n=>({term:n,financed:applyPriceRate(remaining,settings.rates?.[channel]?.[n]||0)}))
      .sort((a,b)=>b.financed-a.financed||b.term-a.term)
      .forEach(({term,financed})=>{
        lines.push((msg.installmentEmoji||'💳')+' '+term+'x de '+brl(financed/term)+' '+channelLabel)
      });

    if(showCash()){
      const cashValue=cashMode==='withFee'?applyPriceRate(remaining,settings.rates?.pix||0):remaining;
      lines.push((msg.cashEmoji||'🔥')+' '+brl(cashValue)+' '+cashLabel)
    }
    if(i<(c.items||[]).length-1)lines.push('')
  });
  if(d.notes){lines.push('');lines.push('Observação: '+String(d.notes).trim())}
  if(msg.footer){lines.push('');lines.push(String(msg.footer).trim())}
  return lines.filter((line,index,arr)=>line!==''||arr[index-1]!=='').join('\n').trim()
}
