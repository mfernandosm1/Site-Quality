function columnLabel(i){let n=i+1,out='';while(n){n--;out=String.fromCharCode(65+n%26)+out;n=Math.floor(n/26)}return out}
function textScore(v,words){const t=String(v||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');return words.reduce((a,w)=>a+(t.includes(w)?1:0),0)}
function autoDetectColumns(){const sheetIndex=Number($('sheetSelect').value||0),rows=workbookSheets[sheetIndex]?.rows||[];let best={score:-1,nameCol:0,priceCol:1,startRow:0,confident:false};const nameWords=['produto','descricao','descrição','nome','modelo','item','aparelho'];const priceWords=['preco','preço','precios','precios','valor','custo','price','usd','us$','r$','dolar','dólar'];const blockedPriceWords=['codigo','código','cod','id','referencia','referência','sku','ean'];for(let r=0;r<Math.min(rows.length,25);r++){const row=rows[r]||[];for(let n=0;n<row.length;n++){const ns=textScore(row[n],nameWords);if(!ns)continue;for(let p=0;p<row.length;p++){if(p===n)continue;const header=String(row[p]||'').toLowerCase().trim();const ps=textScore(header,priceWords);if(!ps||blockedPriceWords.some(w=>header.includes(w)))continue;let valid=0,texts=0,decimalLike=0;for(let k=r+1;k<Math.min(rows.length,r+40);k++){const name=String(rows[k]?.[n]||'').trim(),raw=String(rows[k]?.[p]||'').trim(),value=num(raw);if(name&&/[A-Za-zÀ-ÿ]/.test(name))texts++;if(value>0){valid++;if(/[.,]/.test(raw)||/r\$|us\$|\$/i.test(raw))decimalLike++}}const score=ns*8+ps*10+Math.min(valid,15)+Math.min(texts,15)+decimalLike*2;if(score>best.score)best={score,nameCol:n,priceCol:p,startRow:r+1,confident:valid>=2&&texts>=2}}}}return best}
