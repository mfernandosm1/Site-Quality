function parseWhatsAppBlocks(raw){
  const source=String(raw||'').replace(/\u00a0/g,' ').replace(/\r/g,'');
  const lines=source.split('\n').map(s=>s.trim()).filter(Boolean);
  const rows=[];let currentProduct='',pendingColors=[],detected='';
  const strip=v=>String(v||'').replace(/[\*_~`]/g,'').replace(/^[>\s]+/,'').trim();
  const separator=v=>/^[\s_\-–—=•·⸻━─]{3,}$/.test(strip(v));
  const cleanName=v=>strip(v).replace(/^[\p{Extended_Pictographic}\uFE0F]+\s*/u,'').replace(/^[✅✔☑•▪▫►▶➤➜\-–—]+\s*/u,'').replace(/[\-–—:|]+\s*$/,'').replace(/\s+/g,' ').trim();
  const parsePrice=rawValue=>{
    let s=String(rawValue||'').replace(/\s/g,'').replace(/[^\d,.-]/g,'');
    if(!s)return 0;
    if(s.includes(',')&&s.includes('.'))s=s.lastIndexOf(',')>s.lastIndexOf('.')?s.replace(/\./g,'').replace(',','.'):s.replace(/,/g,'');
    else if(s.includes(','))s=s.replace(',','.');
    else if(/^\d{1,3}(?:\.\d{3})+$/.test(s))s=s.replace(/\./g,'');
    return Number(s)||0;
  };
  const storageOnly=v=>/^\s*\d+(?:[.,]\d+)?\s*(?:GB|TB|MB)\s*$/i.test(v);
  const containsStorage=v=>/\b\d+(?:[.,]\d+)?\s*(?:GB|TB|MB)\b/i.test(v);
  const explicitPriceLine=v=>/(?:R\$|US\$|USD|U\$|\$|💵|💰)/i.test(v);
  const numericPriceLine=v=>/^\s*(?:[\p{Extended_Pictographic}\uFE0F]\s*)?(?:R\$|US\$|USD|U\$|\$)?\s*\d{3,}(?:[.,]\d{1,2})?\s*$/u.test(v);
  const findPrice=v=>{
    if(!explicitPriceLine(v)&&!numericPriceLine(v))return null;
    const matches=[...v.matchAll(/(\d{1,3}(?:[.\s]\d{3})+(?:,\d{1,2})?|\d{3,}(?:[.,]\d{1,2})?)/g)];
    if(!matches.length)return null;
    const m=matches[matches.length-1],price=parsePrice(m[1]);
    if(price<100)return null;
    const before=String(v).slice(Math.max(0,m.index-5),m.index),after=String(v).slice(m.index+m[1].length,m.index+m[1].length+5);
    const marker=((before.match(/R\$|US\$|USD|U\$|\$/i)||after.match(/R\$|US\$|USD|U\$|\$/i)||v.match(/R\$|US\$|USD|U\$|\$/i)||[''])[0]||'').toUpperCase();
    const currency=marker==='R$'?'BRL':(marker?'USD':(detected||'BRL'));
    return {price,currency,index:m.index,length:m[1].length,raw:m[1]};
  };
  const push=(price,currency,index)=>{
    if(!currentProduct||price<=0)return;
    const colorText=pendingColors.length?' — '+pendingColors.join(' / '):'';
    rows.push({id:'wa_'+index+'_'+rows.length,name:cleanName(currentProduct)+colorText,colors:[...pendingColors],original:price,currency,selected:true,importRate:Number(settings.defaults?.importRate||0),profit:0,source:'whatsapp'});
    pendingColors=[];detected=detected||currency;
  };
  lines.forEach((original,index)=>{
    const line=strip(original);if(!line||separator(line))return;
    const priceData=findPrice(line);
    if(priceData){
      const beforePrice=line.slice(0,priceData.index).replace(/(?:R\$|US\$|USD|U\$|\$)\s*$/i,'').trim();
      const afterPrice=line.slice(priceData.index+priceData.length).replace(/^\s*(?:R\$|US\$|USD|U\$|\$)/i,'').trim();
      const inlineName=cleanName([beforePrice,afterPrice].filter(Boolean).join(' '));
      if(inlineName&&/[A-Za-zÀ-ÿ]/.test(inlineName)&&!storageOnly(inlineName)){currentProduct=inlineName;pendingColors=[];}
      push(priceData.price,priceData.currency,index);return;
    }
    const cleaned=cleanName(line);if(!cleaned)return;
    if(storageOnly(cleaned))return;
    const isVariantLine=/^[✅✔☑•▪▫►▶➤➜]/u.test(line)
      && currentProduct
      && !containsStorage(cleaned)
      && !/(?:R\$|US\$|USD|U\$|\$|💵|💰)/i.test(line);
    if(isVariantLine){
      const variant=cleaned.replace(/\s+/g,' ').trim();
      if(variant&&!pendingColors.some(v=>normalizeKey(v)===normalizeKey(variant)))pendingColors.push(variant);
      return;
    }
    if(/^((garantia|frete|validade|oferta|promoção|pagamento|pix|cartão)\b)/i.test(cleaned))return;
    if(/[A-Za-zÀ-ÿ]/.test(cleaned)&&(/\d/.test(cleaned)||containsStorage(cleaned))){
      currentProduct=cleaned;pendingColors=[];return;
    }
    if(/[A-Za-zÀ-ÿ]/.test(cleaned)&&!currentProduct){currentProduct=cleaned;pendingColors=[];}
  });
  return {rows,currency:detected||'BRL'};
}
