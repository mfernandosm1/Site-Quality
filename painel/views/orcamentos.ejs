function matchProfit(name){const n=name.toLowerCase();for(const rule of settings.marginRules||[]){const words=String(rule.keywords||'').toLowerCase().split(/\s+/).filter(Boolean);if(words.length&&words.every(w=>n.includes(w)))return Number(rule.profit||0)}return Number($('bulkProfit').value||settings.defaults?.defaultProfit||0)}function fillMargins(){prepared.forEach(r=>r.profit=matchProfit(r.name));renderPrepared()}$('fillMargins').onclick=fillMargins;$('applyImport').onclick=()=>{const value=num($('bulkImport').value);prepared.forEach(r=>{if(r.selected)r.importRate=value});renderPrepared()};$('bulkCondition').onchange=()=>{$('bulkConditionCustom').disabled=$('bulkCondition').value!=='custom';if(!$('bulkConditionCustom').disabled)$('bulkConditionCustom').focus()};$('applyCondition').onclick=()=>{const value=($('bulkCondition').value==='custom'?$('bulkConditionCustom').value:$('bulkCondition').value).trim();if(!value)return alert('Informe o texto que deseja adicionar.');const targets=prepared.filter(r=>r.selected);if(!targets.length)return alert('Selecione ao menos um produto.');targets.forEach(r=>{r.condition=value;r.name=String(r.name||'').replace(/\s+(?:—|–|•)\s+(?:Novo lacrado|Usado|Vitrine|Seminovo|Importado)\s*$/i,'').trim()});renderPrepared();recalculateTableOffer();showResult(value+' aplicado em '+targets.length+' produto(s).')};$('applyManualProfit').onclick=()=>{const value=num($('manualBulkProfit').value);const targets=prepared.filter(r=>r.selected);if(!targets.length)return alert('Selecione ao menos um produto.');if(value<0)return alert('Informe um lucro válido.');const add=$('manualProfitMode').value==='add';targets.forEach(r=>r.profit=add?Number(r.profit||0)+value:value);renderPrepared();recalculateTableOffer();showResult((add?'Lucro somado':'Lucro substituído')+' em '+targets.length+' produto(s).')};document.querySelectorAll('.prep-change').forEach(e=>e.oninput=()=>{if(e.id==='dollarBase'||e.id==='dollarAdd'){if(e.id==='dollarAdd')localStorage.setItem