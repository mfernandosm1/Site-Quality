function updateItemCounter(){const count=document.querySelectorAll('.q-item').length,limit=quoteLimit();if($('quoteItemCounter'))$('quoteItemCounter').textContent=count+' / '+limit}function addItem(item={}){if(document.querySelectorAll('.q-item').length>=quoteLimit()){alert('Limite de '+quoteLimit()+' produtos por orçamento atingido.');return}$('items').insertAdjacentHTML('beforeend',itemTemplate(item));bindItems();updateItemCounter();recalculate()}function bindItems(){document.querySelectorAll('.q-item input').forEach(e=>e.oninput=recalculate);document.querySelectorAll('.item-remove').forEach(b=>b.onclick=()=>{b.closest('.q-item').remove();updateItemCounter();recalculate()})}function collectItems(){return [...document.querySelectorAll('.q-item')].map(r=>({id:r.dataset.id,name:r.querySelector('.item-name').value,quantity:Number(r.querySelector('.item-qty').value||1),cost:Number(r.querySelector('.item-cost').value||0),importRate:Number(r.querySelector('.item-import').value||0),profit:Number(r.querySelector('.item-profit').value||0),source:'manual'})).filter(i=>i.name.trim())}
