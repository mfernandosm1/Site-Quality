function legacyTemplateIntro(t={}){
  const direct=String(t.introText||t.defaultMessage||'').trim();
  if(direct)return direct;
  const lines=[],title=String(t.offerTitle||t.header||'').trim(),valid=String(t.validUntil||'').trim();
  if(title)lines.push(title+(valid?' válidas até '+valid:''));
  else if(valid)lines.push('Válidas até '+valid);
  if(t.warranty)lines.push('✅ '+String(t.warranty).trim().replace(/^✅\s*/,''));
  if(t.shipping)lines.push('🚚 '+String(t.shipping).trim().replace(/^🚚\s*/,''));
  return lines.join('\n').trim();
}
