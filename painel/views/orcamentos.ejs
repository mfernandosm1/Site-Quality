function rateFields(el,type){el.innerHTML='';for(let i=1;i<=18;i++)el.insertAdjacentHTML('beforeend',`<div class="q-rate"><label>${i}x (%)</label><input type="number" step="0.01" data-rate-type="${type}" data-installment="${i}"></div>`)}rateFields($('cardRates'),'card');rateFields($('creditRates'),'credit');function renderDisplayInstallmentChoices(){const selected=tableInstallments();const options=Array.from({length:18},(_,i)=>i+1).map(n=>`<option value="${n}">${n}x</option>`).join('');$('displayTerm1').innerHTML='<option value="">Não mostrar</option>'+options;$('displayTerm2').innerHTML='<option value="">Não mostrar</option>'+options;$('displayTerm1').value=selected[0]?String(selected[0]):'';$('displayTerm2').value=selected[1]?String(selected[1]):''}
function addRule(rule={}){$('marginRules').insertAdjacentHTML('beforeend',`<div class="q-rule"><input class="q-input rule-keywords" placeholder="Ex.: iphone 16 pro" value="${esc(rule.keywords||'')}"><input class="q-input rule-profit" type="number" step="0.01" placeholder="Lucro" value="${rule.profit||0}"><button class="q-icon rule-remove">✕</button></div>`);document.querySelectorAll('.rule-remove').forEach(b=>b.onclick=()=>b.closest('.q-rule').remove())}$('addRule').onclick=()=>addRule();
function populateSettings(){renderDisplayInstallmentChoices();const np=namePrefs();$('nameRemoveWords').value=np.removeWords.join('\n');$('nameReplacements').value=np.replacements.map(x=>x.from+' = '+x.to).join('\n');$('nameTitleCase').checked=np.titleCase;$('roundToNine99').checked=roundToNine99Enabled();$('calculationMode').value=settings.calculationMode||'gross-up';$('defaultDollar').value=settings.defaults?.dollarRate||0;$('defaultDollarAdd').value=savedDollarAdd();$('maxQuoteItems').value=quoteLimit();$('defaultImport').value=settings.defaults?.importRate||0;$('defaultProfit').value=settings.defaults?.defaultProfit||0;$('ratePix').value=settings.rates?.pix||0;$('rateCash').value=settings.rates?.cash||0;$('rateDebit').value=settings.rates?.debit||0;document.querySelectorAll('[data-rate-type]').forEach(i=>i.value=settings.rates?.[i.dataset.rateType]?.[i.dataset.installment]||0);$('msgOfferTitle').value=settings.message?.offerTitle||'';$('msgValidUntil').value=settings.message?.validUntil||'';$('msgProductEmoji').value=settings.message?.productEmoji||'📲';$('msgInstallmentEmoji').value=settings.message?.installmentEmoji||'💳';$('msgCashEmoji').value=settings.message?.cashEmoji||'🔥';$('msgHeader').value=settings.message?.header||'';$('msgFooter').value=settings.message?.footer||'';$('msgWarranty').value=settings.message?.warranty||'';$('msgShipping').value=settings.message?.shipping||'';$('labelCard').value=paymentLabel('card','no cartão');$('labelCredit').value=paymentLabel('credit','no boleto/crediário');$('labelCashWithFee').value=paymentLabel('cashWithFee','à vista no Pix ou dinheiro');$('labelCashNoFee').value=paymentLabel('cashNoFee','à vista sem taxa');$('defaultTableCashMode').value=tableCashMode();$('defaultManualCashMode').value=manualCashMode();$('marginRules').innerHTML='';(settings.marginRules||[]).forEach(addRule)}
function openSettings(){populateSettings();$('modalBg').classList.add('open');$('settingsModal').classList.add('open')}function closeSettings(){$('modalBg').classList.remove('open');$('settingsModal').classList.remove('open')}$('openSettings').onclick=openSettings;$('closeSettings').onclick=closeSettings;$('modalBg').onclick=closeSettings;
$('saveSettings').onclick=async()=>{const card={},credit={};document.querySelectorAll('[data-rate-type="card"]').forEach(i=>card[i.dataset.installment]=Number(i.value||0));document.querySelectorAll('[data-rate-type="credit"]').forEach(i=>credit[i.dataset.installment]=Number(i.value||0));const marginRules=[...document.querySelectorAll('.q-rule')].map(r=>({keywords:r.querySelector('.rule-keywords').value,profit:Number(r.querySelector('.rule-profit').value||0)})).filter(r=>r.keywords.trim());const displayInstallments=[Number($('displayTerm1').value||0),Number($('displayTerm2').value||0)].filter(n=>n>=1&&n<=18).filter((n,i,a)=>a.indexOf(n)===i);const removeWords=$('nameRemoveWords').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);const replacements=$('nameReplacements').value.split(/\r?\n/).map(line=>{const i=line.indexOf('=');return i<0?null:{from:line.slice(0,i).trim(),to:line.slice(i+1).trim()}}).filter(x=>x&&x.from);saveLocalPrefs({tableDisplayInstallments:displayInstallments,manualDisplayInstallments:manualInstallments(),showCash:showCash(),roundToNine99:$('roundToNine99').checked,removeWords,replacements,titleCase:$('nameTitleCase').checked,tableCashMode:$('defaultTableCashMode').value,manualCashMode:$('defaultManualCashMode').value});localStorage.setItem('quality_quote_dollar_add',String(num($('defaultDollarAdd').value)));localStorage.setItem('quality_quote_max_items',String(Math.max(1,Math.min(300,Number($('maxQuoteItems').value||100)))));const data={calculationMode:$('calculationMode').value,displayInstallments,showCash:showCash(),pricing:{roundToNine99:$('roundToNine99').checked},rates:{pix:Number($('ratePix').value||0),cash:Number($('rateCash').value||0),debit:Number($('rateDebit').value||0),card,credit},defaults:{...(settings.defaults||{}),dollarRate:Number($('defaultDollar').value||0),dollarAdd:num($('defaultDollarAdd').value||0),importRate:Number($('defaultImport').value||0),defaultProfit:Number($('defaultProfit').value||0),tableCashMode:$('defaultTableCashMode').value,manualCashMode:$('defaultManualCashMode').value},limits:{maxItems:Math.max(1,Math.min(300,Number($('maxQuoteItems').value||100)))},marginRules,message:{offerTitle:$('msgOfferTitle').value,validUntil:$('msgValidUntil').value,productEmoji:$('msgProductEmoji').value,installmentEmoji:$('msgInstallmentEmoji').value,cashEmoji:$('msgCashEmoji').value,header:$('msgHeader').value,footer:$('msgFooter').value,warranty:$('msgWarranty').value,shipping:$('msgShipping').value,paymentLabels:{card:$('labelCard').value,credit:$('labelCredit').value,cashWithFee:$('labelCashWithFee').value,cashNoFee:$('labelCashNoFee').value}}};try{const j=await api('/orcamentos/configuracoes',data);settings=j.settings||data;saveLocalPrefs({tableDisplayInstallments:displayInstallments,manualDisplayInstallments:manualInstallments(),showCash:data.showCash,roundToNine99:data.pricing.roundToNine99,tableCashMode:data.defaults.tableCashMode,manualCashMode:data.defaults.manualCashMode});if($('tableCashMode'))$('tableCashMode').value=tableCashMode();if($('manualCashMode'))$('manualCashMode').value=manualCashMode();$('dollarAdd').value=savedDollarAdd();syncDollar();renderTermChips();closeSettings();renderPrepared();updateItemCounter();recalculate();showResult('Configurações salvas.')}catch(e){alert(e.message)}};
function loadInitial(){updateItemCounter();if(initialQuote?.id){$('customerId').value=initialQuote.customerId||'';$('customerName').value=initialQuote.customerName||'';$('conversationId').value=initialQuote.conversationId||'';$('entry').value=initialQuote.entry||0;$('tradeName').value=initialQuote.trade?.name||'';$('tradeValue').value=initialQuote.trade?.value||0;$('useEntry').checked=Number(initialQuote.entry||0)>0;$('entryFields').style.display=$('useEntry').checked?'grid':'none';$('useTrade').checked=Boolean(initialQuote.trade?.name)||Number(initialQuote.trade?.value||0)>0;$('tradeFields').style.display=$('useTrade').checked?'grid':'none';$('paymentMethod').value=initialQuote.paymentMethod||'pix';$('installments').value=initialQuote.installments||1;$('notes').value=initialQuote.notes||'';(initialQuote.items||[]).forEach(addItem);openTab('quote')}else addItem({quantity:1});recalculate();recalculateTableOffer()}loadInitial();renderSavedQuotes();const defaultTemplate=messageTemplates.find(t=>t.isDefault);if(defaultTemplate&&!initialQuote?.id){setTimeout(()=>{applyMessageTemplate(defaultTemplate)},250)}
</script>
