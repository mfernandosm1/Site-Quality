<% layout('layout') -%>
<section class="count-workspace" data-count-id="<%= count.id %>" data-count-status="<%= count.status %>">
<style>
.count-workspace{max-width:1500px;margin:0 auto;padding:18px}.cw-hero,.cw-card{border:1px solid #2d3540;background:#101214;border-radius:14px;padding:15px}.cw-hero{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;margin-bottom:12px}.cw-kicker{font-size:10px;font-weight:900;letter-spacing:.12em;color:#60a5fa}.cw-hero h1{margin:4px 0;font-size:24px}.cw-meta{display:flex;gap:8px;flex-wrap:wrap;color:#94a3b8;font-size:11px}.cw-pill{padding:5px 8px;border:1px solid #374151;border-radius:999px}.cw-lock{border-color:#92400e;color:#fbbf24}.cw-actions{display:flex;gap:8px;flex-wrap:wrap}.cw-scan{margin-bottom:12px;position:relative}.cw-searchline{display:flex;gap:8px;align-items:stretch}.cw-search{flex:1 1 auto;min-width:0;min-height:54px;background:#090b0e;color:#fff;border:2px solid #2563eb;border-radius:12px;padding:0 16px;font-size:17px;font-weight:700}.cw-scan-qty{flex:0 0 86px!important;width:86px!important;min-width:86px!important;max-width:86px!important;min-height:54px;background:#090b0e;color:#fff;border:1px solid #374151;border-radius:12px;padding:0 8px;text-align:center;font-size:17px;font-weight:900}.cw-scan-qty:focus{border-color:#2563eb;outline:none}.cw-help{color:#94a3b8;font-size:11px;margin:7px 2px 0}.cw-results{position:relative}.cw-results-list{position:absolute;z-index:20;left:0;right:0;top:5px;background:#11151a;border:1px solid #374151;border-radius:12px;overflow:hidden;box-shadow:0 20px 45px #0008}.cw-result{width:100%;display:flex;justify-content:space-between;gap:10px;text-align:left;padding:11px 13px;border:0;border-bottom:1px solid #29313b;background:transparent;color:#fff;cursor:pointer}.cw-result:hover,.cw-result.active{background:#172554}.cw-result small{color:#94a3b8}.cw-summary{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-bottom:12px}.cw-summary article{border:1px solid #30363d;background:#111315;border-radius:11px;padding:11px}.cw-summary span{display:block;color:#94a3b8;text-transform:uppercase;font-size:9px;font-weight:900}.cw-summary strong{font-size:22px}.cw-table-wrap{overflow:auto;border:1px solid #30363d;border-radius:12px}.cw-table{width:100%;border-collapse:collapse;min-width:860px}.cw-table th,.cw-table td{padding:10px;border-bottom:1px solid #2b3036;text-align:left;font-size:11px}.cw-table th{background:#17191d;color:#cbd5e1;text-transform:uppercase;font-size:10px}.cw-qty{display:flex;align-items:center;gap:5px}.cw-qty button{width:30px;height:30px;border:1px solid #374151;background:#17191d;color:#fff;border-radius:7px;cursor:pointer}.cw-qty input{width:72px;height:32px;border:1px solid #374151;background:#0d0f12;color:#fff;text-align:center;border-radius:7px;font-weight:900}.cw-delete{border:0;background:transparent;color:#fca5a5;cursor:pointer;font-weight:900}.cw-empty{text-align:center;padding:34px;color:#94a3b8}.cw-conference{margin-top:12px}.cw-conf-actions{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center}.cw-counted-searchbar{display:flex;align-items:center;gap:8px;margin:12px 0 0}.cw-counted-search{flex:1;min-width:220px;height:38px;border:1px solid #374151;background:#0d0f12;color:#fff;border-radius:9px;padding:0 12px;font-size:12px}.cw-counted-search:focus{outline:none;border-color:#2563eb}.cw-counted-search-info{flex:0 0 auto;color:#94a3b8;font-size:10px;white-space:nowrap}.cw-filterbar{display:flex;gap:7px;flex-wrap:wrap}.cw-filter{border:1px solid #374151;background:#17191d;color:#cbd5e1;border-radius:999px;padding:7px 10px;cursor:pointer;font-weight:800}.cw-filter.active{background:#2563eb;color:#fff;border-color:#2563eb}.cw-diff-pos{color:#86efac;font-weight:900}.cw-diff-neg{color:#fca5a5;font-weight:900}.cw-diff-zero{color:#94a3b8}.cw-notice{margin:10px 0;padding:10px;border-radius:9px;background:#2b160c;border:1px solid #7c2d12;color:#fdba74}.cw-success{background:#052e16;border-color:#166534;color:#86efac}.cw-feedback{position:absolute;z-index:30;right:16px;top:78px;margin:0;max-width:min(520px,calc(100% - 32px));padding:7px 10px;box-shadow:0 8px 24px #0008;font-size:11px;font-weight:800;pointer-events:none}.cw-feedback.cw-success{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cw-modal-bg{position:fixed;inset:0;background:#000a;z-index:60;display:grid;place-items:center}.cw-modal-bg[hidden]{display:none!important}.cw-modal{width:min(520px,calc(100% - 28px));background:#11151a;border:1px solid #374151;border-radius:14px;padding:16px}.cw-modal textarea{width:100%;min-height:90px;background:#090b0e;color:#fff;border:1px solid #374151;border-radius:9px;padding:9px}.cw-modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}.cw-closed{padding:10px;border-radius:10px;background:#172554;color:#bfdbfe;margin-bottom:12px}.cw-browser{margin-bottom:12px}.cw-browser-head{display:flex;justify-content:space-between;align-items:end;gap:10px;flex-wrap:wrap}.cw-browser-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.cw-browser-controls input,.cw-browser-controls select{height:36px;border:1px solid #374151;background:#0d0f12;color:#fff;border-radius:8px;padding:0 10px}.cw-browser-controls input{min-width:260px}.cw-browser-list{margin-top:10px;border:1px solid #30363d;border-radius:11px;overflow:hidden}.cw-browser-row{display:grid;grid-template-columns:minmax(280px,1fr) 190px 110px 100px;gap:10px;align-items:center;padding:9px 11px;border-bottom:1px solid #292f36;font-size:11px}.cw-browser-row:last-child{border-bottom:0}.cw-browser-row small{color:#94a3b8}.cw-browser-row .btn{justify-self:end}.cw-counted-tag{display:inline-flex;padding:4px 7px;border-radius:999px;background:#052e16;border:1px solid #166534;color:#86efac;font-weight:900}.cw-pager{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:10px;color:#94a3b8;font-size:11px}.cw-browser-details{margin-top:12px}.cw-browser-details>summary{list-style:none;cursor:pointer;font-weight:900;font-size:14px;padding:12px 14px;border:1px solid #30363d;border-radius:12px;background:#111315;color:#e5e7eb}.cw-browser-details>summary::-webkit-details-marker{display:none}.cw-browser-details>summary:before{content:"▸";display:inline-block;margin-right:8px;color:#60a5fa;transition:transform .15s}.cw-browser-details[open]>summary:before{transform:rotate(90deg)}.cw-browser-details[open]>summary{border-radius:12px 12px 0 0}.cw-browser-details .cw-browser{border-top:0;border-radius:0 0 14px 14px;margin:0}.cw-info{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border:1px solid #64748b;border-radius:50%;font-size:10px;font-weight:900;color:#cbd5e1;cursor:help;vertical-align:middle;margin-left:4px}@media(max-width:800px){.cw-summary{grid-template-columns:repeat(2,1fr)}.cw-counted-searchbar{align-items:stretch;flex-direction:column}.cw-counted-search{width:100%}.cw-counted-search-info{padding-left:2px}.cw-searchline{display:grid;grid-template-columns:76px minmax(0,1fr);gap:7px}.cw-scan-qty{flex:none!important;width:76px!important;min-width:76px!important;max-width:76px!important}.cw-searchline .btn{grid-column:1/-1;width:100%}}
.cw-system-now{display:block;margin-top:5px;color:#94a3b8;font-size:10px}.cw-system-now strong{color:#e5e7eb}
</style>
<header class="cw-hero"><div><span class="cw-kicker">CONTAGEM DE ESTOQUE</span><h1><%= count.id %></h1><div class="cw-meta"><span class="cw-pill"><%= count.type==='total'?'Total':'Parcial' %></span><span class="cw-pill"><%= count.status==='in_progress'?'Em andamento':count.status==='completed'?'Concluída':'Cancelada' %></span><% if(count.blockPdv){ %><span class="cw-pill cw-lock">🔒 PDV bloqueado</span><% } %><span>Iniciada por <b><%= count.createdBy %></b> em <%= new Date(count.startedAt).toLocaleString('pt-BR') %></span></div></div><div class="cw-actions"><a class="btn" href="/erp/estoque/contagens">← Contagens</a><% if(count.status==='in_progress'){ %><button class="btn" id="cancelCount" type="button">Cancelar</button><button class="btn primary" id="openConference" type="button">Conferir e concluir</button><% } %></div></header>
<% if(count.status!=='in_progress'){ %><div class="cw-closed">Esta contagem está <b><%= count.status==='completed'?'concluída':'cancelada' %></b> e permanece disponível apenas para consulta.</div><% } %>
<% if(count.status==='in_progress'){ %><section class="cw-card cw-scan"><div class="cw-searchline"><input class="cw-scan-qty" id="countScanQty" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" value="1" maxlength="4" aria-label="Quantidade" title="Quantidade a adicionar na próxima leitura ou seleção" <%= count.status!=='in_progress'?'disabled':'' %>><input class="cw-search" id="countSearch" type="search" autocomplete="off" placeholder="Leia o código de barras ou pesquise produto, SKU, código..." <%= count.status!=='in_progress'?'disabled':'' %>><button class="btn" id="manualSearch" type="button" <%= count.status!=='in_progress'?'disabled':'' %>>Pesquisar</button></div><p class="cw-help">Informe a <b>quantidade</b> e leia o código + Enter. Após adicionar, a quantidade volta para <b>1</b>. O campo aceita somente números inteiros positivos.</p><div class="cw-results"><div class="cw-results-list" id="countSearchResults" hidden></div></div><div id="countMessage" class="cw-notice" hidden></div></section><% } else { %><div id="countMessage" class="cw-notice" hidden></div><% } %>
<section class="cw-summary"><article class="erp-tone-info"><span>Itens contados</span><strong id="sumCounted"><%= conference.summary.counted %></strong></article><article class="erp-tone-success"><span>Corretos</span><strong id="sumMatched"><%= conference.summary.matched %></strong></article><article class="erp-tone-expense"><span>Faltando</span><strong id="sumShortage"><%= conference.summary.shortage %></strong></article><article class="erp-tone-warning"><span>Sobrando</span><strong id="sumSurplus"><%= conference.summary.surplus %></strong></article><article class="erp-tone-warning"><span>Não contados</span><strong id="sumUncounted"><%= conference.summary.uncounted %></strong></article></section>

<section class="cw-card"><div class="cw-conf-actions"><div><h2 style="margin:0;font-size:17px">Produtos contados</h2><p style="margin:4px 0 0;color:#94a3b8;font-size:11px">O estoque atual aparece já na contagem para facilitar a conferência física. O ajuste só é aplicado ao concluir.</p></div><div class="cw-filterbar" id="conferenceFilters" hidden><button class="cw-filter active" data-filter="divergent">Divergentes</button><button class="cw-filter" data-filter="all">Todos</button><button class="cw-filter" data-filter="shortage">Faltando</button><button class="cw-filter" data-filter="surplus">Sobrando</button><button class="cw-filter" data-filter="matched">Corretos</button></div></div><div class="cw-counted-searchbar"><input class="cw-counted-search" id="countedProductsSearch" type="search" autocomplete="off" placeholder="Buscar entre os produtos já contados por nome, código, SKU ou EAN..."><span class="cw-counted-search-info" id="countedProductsSearchInfo"></span></div><div class="cw-table-wrap" style="margin-top:10px"><table class="cw-table"><thead id="countTableHead"><tr><th>Produto</th><th>Código / EAN</th><th>Contado</th><th id="systemHead">Estoque atual</th><th id="differenceHead" hidden>Diferença</th><th></th></tr></thead><tbody id="countTableBody"></tbody></table><div id="countEmpty" class="cw-empty">Nenhum produto contado ainda. Leia o primeiro código acima.</div></div><div id="totalUncountedNotice" class="cw-notice" hidden></div><div class="cw-conference" id="finishArea" hidden><label id="zeroConfirmWrap" style="display:none;margin:10px 0"><input type="checkbox" id="confirmUncountedZero"> Estou ciente e quero zerar o estoque de todos os produtos da contagem total que permaneceram sem contagem.</label><button class="btn primary" id="finishCount" type="button">Aplicar ajustes e concluir</button></div></section>
<% if(count.status==='in_progress'){ %><details class="cw-browser-details"><summary>Produtos para contagem <span style="font-weight:400;color:#94a3b8">— abrir lista</span></summary><section class="cw-card cw-browser"><div class="cw-browser-head"><div><h2 style="margin:0;font-size:17px">Produtos para contagem</h2><p style="margin:4px 0 0;color:#94a3b8;font-size:11px">Carregamos somente uma página por vez para manter a tela rápida. <span class="cw-info" title="Você pode usar a leitora no campo acima ou localizar manualmente um item nesta lista. A quantidade por página não altera a contagem, apenas o que aparece na tela.">i</span></p></div><div class="cw-browser-controls"><input id="catalogSearch" type="search" placeholder="Filtrar produtos desta contagem..."><select id="catalogLimit" title="Produtos por página"><option value="50">50 por página</option><option value="100">100 por página</option><option value="200">200 por página</option><option value="300">300 por página</option></select></div></div><div id="catalogList" class="cw-browser-list"><div class="cw-empty">Carregando produtos...</div></div><div class="cw-pager"><span id="catalogPageInfo"></span><button class="btn" id="catalogPrev" type="button">← Anterior</button><button class="btn" id="catalogNext" type="button">Próxima →</button></div></section></details><% } %>
<div class="cw-modal-bg" id="cancelModal" hidden><div class="cw-modal"><h2>Cancelar contagem</h2><p>O estoque não será alterado. A contagem permanecerá no histórico.</p><textarea id="cancelReason" placeholder="Motivo do cancelamento..."></textarea><div class="cw-modal-actions"><button class="btn" id="closeCancel" type="button">Voltar</button><button class="btn" id="confirmCancel" type="button">Cancelar contagem</button></div></div></div>
<script id="countInitialData" type="application/json"><%- JSON.stringify(conference).replace(/</g,'\\u003c') %></script>
<script src="/public/js/estoque-contagem.js"></script>
</section>
