<% layout('layout') -%>
<section class="customer-settings-page">
  <header class="customer-settings-hero">
    <div><span>CONFIGURAÇÕES · ERP</span><h1>Gerenciar Cadastro de Clientes</h1><p>Defina o nome exibido, quais campos aparecem, quais são obrigatórios e a ordem dentro de cada seção.</p></div>
    <div class="customer-settings-actions"><a class="btn" href="/configuracoes">← Voltar</a><button class="btn" id="restoreCustomerFields" type="button">Restaurar padrão</button><button class="btn primary" id="saveCustomerFields" type="button">Salvar configurações</button></div>
  </header>
  <div class="customer-settings-note">Ocultar um campo não apaga informações já cadastradas. Tipo de pessoa e Nome/Razão social são protegidos.</div>
  <div id="customerSettingsMessage" class="customer-settings-message" hidden></div>
  <% const sections = [{key:'main',label:'Dados principais'},{key:'address',label:'Endereço'},{key:'relationship',label:'Relacionamento'}]; %>
  <% sections.forEach(section => { const fields=(fieldSettings.fields||[]).filter(item=>item.section===section.key).sort((a,b)=>a.order-b.order); %>
    <section class="customer-settings-card">
      <h2><%= section.label %></h2>
      <div class="customer-settings-table-wrap"><table class="customer-settings-table"><thead><tr><th>Campo interno</th><th>Nome exibido</th><th>Aplicação</th><th>Ativo</th><th>Obrigatório</th><th>Ordem</th><th>Organizar</th></tr></thead><tbody data-settings-section="<%= section.key %>">
      <% fields.forEach(field => { %><tr data-field-key="<%= field.key %>">
        <td><strong><%= field.label %></strong><small><%= field.key %></small></td>
        <td><input class="customer-label-input" type="text" maxlength="80" data-setting="displayLabel" value="<%= field.displayLabel || field.label %>"></td>
        <td><%= field.personType === 'pj' ? 'Somente PJ' : field.personType === 'pf' ? 'Somente PF' : 'PF e PJ' %></td>
        <td><input type="checkbox" data-setting="enabled" <%= field.enabled ? 'checked' : '' %> <%= field.locked ? 'disabled' : '' %>></td>
        <td><input type="checkbox" data-setting="required" <%= field.required ? 'checked' : '' %> <%= field.locked || !field.enabled ? 'disabled' : '' %>></td>
        <td><input class="customer-order-input" type="number" min="1" data-setting="order" value="<%= field.order %>"></td>
        <td><button class="customer-move" data-move="up" type="button" title="Mover para cima">↑</button><button class="customer-move" data-move="down" type="button" title="Mover para baixo">↓</button></td>
      </tr><% }) %>
      </tbody></table></div>
    </section>
  <% }) %>
</section>
<style>
.customer-settings-page{padding:18px 22px 40px}.customer-settings-hero,.customer-settings-card,.customer-settings-note{border:1px solid #d6dbe3;background:#fff;border-radius:13px}.customer-settings-hero{display:flex;justify-content:space-between;gap:18px;padding:18px;margin-bottom:12px}.customer-settings-hero span{font-size:10px;font-weight:900;color:#2563eb;letter-spacing:.08em}.customer-settings-hero h1{margin:4px 0;font-size:24px}.customer-settings-hero p{margin:0;color:#64748b;font-size:12px}.customer-settings-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.customer-settings-note{padding:10px 13px;margin-bottom:12px;color:#475569;font-size:12px}.customer-settings-card{padding:14px;margin-bottom:12px}.customer-settings-card h2{margin:0 0 10px;font-size:16px}.customer-settings-table-wrap{overflow:auto}.customer-settings-table{width:100%;border-collapse:collapse;min-width:720px}.customer-settings-table th,.customer-settings-table td{padding:9px 10px;border-bottom:1px solid #e2e8f0;text-align:left;font-size:12px}.customer-settings-table th{font-size:10px;text-transform:uppercase;color:#64748b}.customer-settings-table td strong,.customer-settings-table td small{display:block}.customer-settings-table td small{color:#94a3b8;margin-top:2px}.customer-label-input{width:100%;min-width:180px;padding:6px;border:1px solid #cbd5e1;border-radius:7px}.customer-order-input{width:72px;padding:6px;border:1px solid #cbd5e1;border-radius:7px}.customer-move{width:30px;height:30px;margin-right:4px;border:1px solid #cbd5e1;background:#f8fafc;border-radius:7px;cursor:pointer}.customer-settings-message{padding:10px 12px;border-radius:9px;margin-bottom:12px}.customer-settings-message.success{background:#dcfce7;color:#166534}.customer-settings-message.error{background:#fee2e2;color:#991b1b}
html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-hero,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-card,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-note{background:var(--surface,#101214);border-color:var(--border,#30363d);color:var(--text,#e5e7eb)}html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-hero p,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-note,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-table th{color:var(--muted,#94a3b8)}html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-table th,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-settings-table td{border-color:var(--border,#30363d)}html[data-panel-theme]:not([data-panel-theme="light"]) .customer-label-input,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-order-input,html[data-panel-theme]:not([data-panel-theme="light"]) .customer-move{background:var(--surface-2,#17191d);border-color:var(--border,#374151);color:var(--text,#fff)}
@media(max-width:760px){.customer-settings-page{padding:14px}.customer-settings-hero{flex-direction:column}}
</style>
<script>
(() => {
 const message=document.getElementById('customerSettingsMessage');
 const show=(text,type='success')=>{message.textContent=text;message.className=`customer-settings-message ${type}`;message.hidden=false};
 document.querySelectorAll('[data-setting="enabled"]').forEach(input=>input.addEventListener('change',()=>{const row=input.closest('tr');const required=row.querySelector('[data-setting="required"]');required.disabled=!input.checked; if(!input.checked) required.checked=false;}));
 document.querySelectorAll('.customer-move').forEach(button=>button.addEventListener('click',()=>{const row=button.closest('tr'),body=row.parentElement; if(button.dataset.move==='up'&&row.previousElementSibling)body.insertBefore(row,row.previousElementSibling); if(button.dataset.move==='down'&&row.nextElementSibling)body.insertBefore(row.nextElementSibling,row); [...body.children].forEach((item,index)=>item.querySelector('[data-setting="order"]').value=(index+1)*10);}));
 const collect=()=>({fields:[...document.querySelectorAll('tr[data-field-key]')].map(row=>({key:row.dataset.fieldKey,displayLabel:row.querySelector('[data-setting="displayLabel"]')?.value||'',enabled:row.querySelector('[data-setting="enabled"]').checked,required:row.querySelector('[data-setting="required"]').checked,order:Number(row.querySelector('[data-setting="order"]').value)||1}))});
 document.getElementById('saveCustomerFields').addEventListener('click',async()=>{try{const r=await fetch('/configuracoes/clientes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(collect())});const j=await r.json();if(!r.ok||!j.success)throw new Error(j.message);show(j.message);setTimeout(()=>location.reload(),500)}catch(e){show(e.message||'Falha ao salvar.','error')}});
 document.getElementById('restoreCustomerFields').addEventListener('click',async()=>{if(!confirm('Restaurar a configuração padrão do cadastro de clientes?'))return;try{const r=await fetch('/configuracoes/clientes/restaurar',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const j=await r.json();if(!r.ok||!j.success)throw new Error(j.message);show(j.message);setTimeout(()=>location.reload(),500)}catch(e){show(e.message||'Falha ao restaurar.','error')}});
})();
</script>
