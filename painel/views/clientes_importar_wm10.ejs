<% layout('layout') -%>
<section class="wm10-import-page">
  <header class="wm10-import-hero">
    <div><span>QUALITY ERP v0.26.0</span><h1>Importar clientes do WM10</h1><p>Migração econômica: usa snapshot local, evita consultas repetidas e mantém os dados atuais protegidos.</p></div>
    <a class="btn" href="/erp/clientes">← Voltar aos clientes</a>
  </header>

  <div class="wm10-grid">
    <section class="wm10-card">
      <h2>1. Configuração da API</h2>
      <form id="wm10ConfigForm" class="wm10-form">
        <label>URL da API<input name="baseUrl" value="<%= wm10Settings.baseUrl || '' %>" required></label>
        <label>CNPJ da loja<input name="cnpj" value="<%= wm10Settings.cnpj || '' %>" inputmode="numeric" required></label>
        <label>Token da API<input name="token" type="password" placeholder="<%= wm10Settings.tokenConfigured ? 'Token já configurado — deixe em branco para manter' : 'Informe o token' %>"></label>
        <label>Registros por página<input name="pageSize" type="number" min="1" max="500" value="<%= wm10Settings.pageSize || 500 %>"><small>Use 500 para reduzir o número de consultas cobradas.</small></label>
        <label>Clientes por consulta de vendas<input name="salesBatchSize" type="number" min="25" max="500" value="<%= wm10Settings.salesBatchSize || 250 %>"><small>250 equilibra custo baixo e respostas menores.</small></label>
        <label class="full">URL da API de vendas<input name="salesBaseUrl" value="<%= wm10Settings.salesBaseUrl || 'https://app.wm10.com.br/quality/sistema/api/venda/' %>" required></label>
        <label class="full">Códigos ignorados<input name="ignoredCodes" value="<%= (wm10Settings.ignoredCodes || []).join(', ') %>"><small>Separados por vírgula. Configurados: 2, 755, 759 e 760.</small></label>
        <button class="btn primary" type="submit">Salvar configuração</button>
      </form>
      <p id="wm10ConfigMessage" class="wm10-message" hidden></p>
    </section>

    <section class="wm10-card">
      <h2>2. Snapshot local e simulação</h2>
      <p>O WM10 cobra por requisição. Por isso, a API só é consultada quando você manda atualizar o snapshot; simular e importar depois usam os dados locais e não fazem novas consultas.</p>
      <div class="wm10-cost-box" id="wm10CacheBox">
        <strong id="wm10CacheTitle">Snapshot local</strong>
        <span id="wm10CacheStatus">Carregando status…</span>
        <small id="wm10CacheCost"></small>
      </div>
      <div class="wm10-action-row"><button id="wm10Refresh" class="btn" type="button">↻ Atualizar dados do WM10</button><button id="wm10Simulate" class="btn primary" type="button">Reanalisar snapshot local · R$ 0,00</button></div>
      <div id="wm10Progress" class="wm10-progress" hidden></div>
      <div class="wm10-safe-mode"><strong>🔒 Importação protegida</strong><span>Somente clientes novos são criados. Cadastros existentes não são sobrescritos pela importação normal.</span></div>
      <label class="wm10-option"><input id="wm10NormalizeNames" type="checkbox" checked><span><strong>Padronizar nomes de pessoas físicas em caixa alta</strong><small>Ex.: KAUE CONRADO ALLGAYER GONÇALVES → Kaue Conrado Allgayer Gonçalves. Empresas e nomes já formatados não serão alterados.</small></span></label>
      <hr class="wm10-divider">
      <h3>Diagnóstico por registro</h3>
      <p class="wm10-muted">Consulte um código específico para comparar UTF-8, Windows-1252 e ISO-8859-1 sem gravar dados.</p>
      <div class="wm10-diagnostic-form">
        <input id="wm10DiagnosticCode" type="number" min="1" placeholder="Código WM10, ex.: 218">
        <button id="wm10Diagnose" class="btn" type="button">🔍 Diagnosticar registro</button>
      </div>
    </section>
  </div>

  <section class="wm10-card" id="wm10LegacyCard">
    <div class="wm10-report-head"><div><h2>3. Histórico legado WM10</h2><p>Importa todas as Vendas e O.S. concluídas do WM10 como histórico somente para consulta. Não cria operação operacional, não movimenta estoque, caixa, financeiro ou comissão.</p></div><button id="wm10LegacyRun" class="btn success" type="button">Importar histórico WM10</button></div>
    <div class="wm10-safe-mode"><strong>💰 Economia de consultas</strong><span>Cada consulta salva imediatamente o lote concluído. Vendas e O.S. são consultadas separadamente para garantir o tipo correto; se interromper, as consultas concluídas não são repetidas ao continuar.</span></div>
    <div id="wm10LegacySummary" class="wm10-summary"></div>
    <p class="wm10-muted">O histórico importado aparece junto ao <strong>Histórico de operações</strong> do cliente com selo <strong>WM10</strong>. Produtos antigos são preservados como fotografia histórica e podem usar o nome do snapshot de produtos do WM10, mesmo que não existam mais no ERP. Nenhum campo do cadastro mestre é alterado.</p>
    <div id="wm10LegacyProgress" class="wm10-progress" hidden></div>
  </section>

  <section class="wm10-card" id="wm10ReceivablesCard">
    <div class="wm10-report-head"><div><h2>4. Crediários em aberto do WM10</h2><p>Importa somente os saldos informados para <strong>Contas a Receber</strong>, identificados como origem WM10. Não recria venda, não movimenta estoque e não duplica títulos já importados.</p></div><button id="wm10ReceivablesImport" class="btn success" type="button">Importar crediários WM10</button></div>
    <div class="wm10-safe-mode"><strong>🔒 Importação controlada</strong><span>Os 8 clientes são localizados pelo CPF. Valores já pagos no WM10 não viram recebimento novo no ERP: entra somente o saldo ainda em aberto. Nos 3 casos informados sem vencimento, a data fica em branco para não inventarmos informação.</span></div>
    <div id="wm10ReceivablesSummary" class="wm10-summary"></div>
    <div id="wm10ReceivablesList" class="wm10-list"></div>
    <div id="wm10ReceivablesProgress" class="wm10-progress" hidden></div>
  </section>


  <section class="wm10-card" id="wm10ArchiveCard">
    <div class="wm10-report-head"><div><h2>5. Arquivo histórico completo WM10</h2><p>Cria uma cópia separada dos dados antigos da WM10 para consulta futura, relatórios históricos e auditoria. Nada desta área entra na operação atual do ERP.</p></div><button id="wm10ArchiveRun" class="btn success" type="button">Criar arquivo histórico</button></div>
    <div class="wm10-safe-mode"><strong>🗄️ Dados separados por nome</strong><span>Serão salvos em <strong>data/erp/wm10-arquivo-historico</strong>, organizados em Clientes, Classificações, Lojas, Usuários/Vendedores, Categorias, Produtos, Fotos, Serviços, Movimentações e Notas Fiscais. Também são preservadas as respostas brutas da API.</span></div>
    <p class="wm10-muted">As movimentações são arquivadas em todos os tipos disponíveis na API — consignado, venda, orçamento, venda da loja virtual, O.S. e pré-venda — e em todos os estados: aberta, concluída, cancelada e estornada. Esse arquivo serve como fotografia da WM10 e não movimenta estoque, caixa, financeiro, comissão ou cadastros do Quality ERP.</p>
    <div id="wm10ArchiveSummary" class="wm10-summary"></div>
    <details class="wm10-archive-details"><summary>Ver estrutura que será preservada</summary><div class="wm10-archive-folders"><code>01_CLIENTES</code><code>02_CLASSIFICACOES_CLIENTES</code><code>03_LOJAS</code><code>04_USUARIOS_VENDEDORES</code><code>05_CATEGORIAS_PRODUTOS</code><code>06_PRODUTOS</code><code>07_FOTOS_PRODUTOS</code><code>08_SERVICOS</code><code>09_MOVIMENTACOES</code><code>10_NOTAS_FISCAIS</code><code>11_DADOS_JA_IMPORTADOS_LOCALMENTE</code></div></details>
    <div class="wm10-action-row"><button id="wm10ArchiveRetry" class="btn" type="button" hidden>↻ Repetir itens com erro</button></div>
    <div id="wm10ArchiveProgress" class="wm10-progress" hidden></div>
  </section>

  <section id="wm10Diagnostic" class="wm10-card" hidden>
    <div class="wm10-report-head"><div><h2>Diagnóstico de codificação</h2><p id="wm10DiagnosticConclusion"></p></div></div>
    <div id="wm10DiagnosticSummary" class="wm10-summary"></div>
    <div id="wm10DiagnosticCandidates" class="wm10-diagnostic-candidates"></div>
    <details><summary>Prévia hexadecimal dos bytes recebidos</summary><pre id="wm10DiagnosticHex" class="wm10-code"></pre></details>
  </section>

  <section id="wm10Report" class="wm10-card" hidden>
    <div class="wm10-report-head"><div><h2>6. Resultado da simulação</h2><p id="wm10GeneratedAt"></p></div><button id="wm10Execute" class="btn success" type="button" disabled>Importar novos clientes</button></div>
    <div id="wm10Summary" class="wm10-summary"></div>
    <p class="wm10-muted"><strong>Regra do WhatsApp:</strong> celular é a primeira opção; telefone é usado como alternativa. “Sem WhatsApp” significa que nenhum dos dois campos possui número utilizável.</p>
    <div class="wm10-search-wrap"><label for="wm10Search">Conferir clientes</label><input id="wm10Search" type="search" placeholder="Pesquisar por nome, CPF/CNPJ ou cidade..."></div>
    <div id="wm10Conflicts" class="wm10-conflicts" hidden></div>
    <details><summary>Novos clientes</summary><div id="wm10NewList" class="wm10-list"></div></details>
    <details><summary>Clientes existentes — não serão alterados</summary><div id="wm10UpdateList" class="wm10-list"></div></details>
    <details><summary>Ignorados e avisos</summary><div id="wm10IgnoredList" class="wm10-list"></div></details>
  </section>
</section>

<style>
.wm10-import-page{max-width:1280px;margin:0 auto;padding:24px}.wm10-import-hero,.wm10-report-head{display:flex;justify-content:space-between;gap:20px;align-items:center}.wm10-import-hero{padding:20px;border:1px solid var(--border,#d8dee8);border-radius:14px;margin-bottom:14px}.wm10-import-hero span{font-size:11px;font-weight:800;color:#2563eb}.wm10-import-hero h1{margin:5px 0}.wm10-import-hero p{margin:0;color:#64748b}.wm10-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:14px}.wm10-card{border:1px solid var(--border,#d8dee8);border-radius:14px;padding:18px;margin-bottom:14px;background:var(--card-bg,#fff)}.wm10-card h2{margin:0 0 14px}.wm10-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.wm10-form label{font-size:11px;font-weight:800;text-transform:uppercase}.wm10-form input{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:10px;border:1px solid #cbd5e1;border-radius:8px;background:transparent;color:inherit}.wm10-form .full{grid-column:1/-1}.wm10-form small{display:block;margin-top:5px;color:#64748b;text-transform:none;font-weight:400}.wm10-option{display:flex;gap:10px;align-items:flex-start;margin:12px 0;padding:11px;border:1px solid #cbd5e1;border-radius:9px}.wm10-option input{margin-top:3px}.wm10-option span{display:grid;gap:3px}.wm10-option small{color:#64748b}.wm10-message,.wm10-progress{padding:10px;border-radius:8px;margin-top:12px;background:rgba(37,99,235,.12)}.wm10-cost-box{display:grid;gap:4px;padding:12px;border:1px solid #cbd5e1;border-radius:10px;background:rgba(148,163,184,.08);margin:12px 0}.wm10-cost-box span,.wm10-cost-box small{color:#64748b}.wm10-action-row{display:flex;gap:8px;flex-wrap:wrap}.wm10-safe-mode{display:grid;gap:4px;margin:12px 0;padding:12px;border:1px solid rgba(21,128,61,.45);border-radius:10px;background:rgba(21,128,61,.10)}.wm10-safe-mode span{color:#64748b}.wm10-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0}.wm10-stat{border:1px solid #cbd5e1;border-radius:10px;padding:12px}.wm10-stat span{display:block;font-size:10px;text-transform:uppercase;color:#64748b}.wm10-stat strong{font-size:22px}.wm10-conflicts{padding:12px;border-radius:10px;background:rgba(220,38,38,.12);color:#ef4444;font-weight:700;margin-bottom:12px}.wm10-list{max-height:280px;overflow:auto;margin-top:8px}.wm10-search-wrap{margin:12px 0}.wm10-search-wrap label{display:block;font-size:11px;font-weight:800;text-transform:uppercase;margin-bottom:6px}.wm10-search-wrap input{width:100%;box-sizing:border-box;padding:10px;border:1px solid #cbd5e1;border-radius:8px;background:transparent;color:inherit}.wm10-list article{display:grid;grid-template-columns:80px minmax(220px,1.5fr) minmax(150px,.8fr) minmax(180px,1fr) 130px;gap:10px;align-items:center;padding:8px;border-bottom:1px solid #d8dee8;font-size:12px}.wm10-list article.wm10-list-head{position:sticky;top:0;background:var(--card-bg,#fff);z-index:1;font-size:10px;font-weight:800;text-transform:uppercase;color:#64748b}.wm10-list article[hidden]{display:none}.wm10-divider{border:0;border-top:1px solid #d8dee8;margin:18px 0}.wm10-muted{color:#64748b}.wm10-diagnostic-form{display:flex;gap:8px;align-items:center}.wm10-diagnostic-form input{flex:1;min-width:0;padding:10px;border:1px solid #cbd5e1;border-radius:8px;background:transparent;color:inherit}.wm10-diagnostic-candidates{display:grid;gap:12px}.wm10-diagnostic-card{border:1px solid #cbd5e1;border-radius:10px;padding:12px}.wm10-diagnostic-card h3{margin:0 0 8px}.wm10-diagnostic-card dl{display:grid;grid-template-columns:180px 1fr;gap:6px 12px;margin:0}.wm10-diagnostic-card dt{font-weight:800}.wm10-diagnostic-card dd{margin:0;overflow-wrap:anywhere}.wm10-code{white-space:pre-wrap;overflow-wrap:anywhere;max-height:220px;overflow:auto;padding:12px;border-radius:8px;background:rgba(148,163,184,.12)}details{border-top:1px solid #d8dee8;padding:10px 0}summary{cursor:pointer;font-weight:800}.btn.success{background:#15803d;color:white}.btn:disabled{opacity:.5;cursor:not-allowed}
html[data-panel-theme="oled"] .wm10-card,html[data-panel-theme="oled"] .wm10-import-hero,html[data-panel-theme="black-oled"] .wm10-card,html[data-panel-theme="black-oled"] .wm10-import-hero{background:#080a0c!important;border-color:#30363d!important;color:#f8fafc!important}html[data-panel-theme="oled"] .wm10-form input,html[data-panel-theme="black-oled"] .wm10-form input,html[data-panel-theme="oled"] .wm10-search-wrap input,html[data-panel-theme="black-oled"] .wm10-search-wrap input{background:#0d0f12!important;border-color:#374151!important;color:#fff!important}html[data-panel-theme="oled"] .wm10-list article.wm10-list-head,html[data-panel-theme="black-oled"] .wm10-list article.wm10-list-head{background:#080a0c!important}html[data-panel-theme="oled"] .wm10-option,html[data-panel-theme="black-oled"] .wm10-option{border-color:#374151!important;background:#0d0f12!important}html[data-panel-theme="oled"] .wm10-diagnostic-form input,html[data-panel-theme="black-oled"] .wm10-diagnostic-form input{background:#0d0f12!important;border-color:#374151!important;color:#fff!important}
@media(max-width:800px){.wm10-grid{grid-template-columns:1fr}.wm10-form{grid-template-columns:1fr}.wm10-summary{grid-template-columns:repeat(2,1fr)}.wm10-import-hero,.wm10-report-head{align-items:flex-start;flex-direction:column}.wm10-list{overflow:auto}.wm10-list article{min-width:850px}}
.wm10-archive-folders{display:flex;flex-wrap:wrap;gap:8px;padding:12px 0}.wm10-archive-folders code{padding:7px 9px;border:1px solid var(--border,#d8dee8);border-radius:8px;background:var(--surface,#f8fafc);font-size:12px}.wm10-archive-details{margin-top:12px}
</style>
<script id="wm10CacheData" type="application/json"><%- JSON.stringify(cacheInfo || {}).replace(/</g,'\\u003c') %></script>
<script id="wm10LegacyData" type="application/json"><%- JSON.stringify(legacyInfo || {}).replace(/</g,'\\u003c') %></script>
<script id="wm10ArchiveData" type="application/json"><%- JSON.stringify(archiveInfo || {}).replace(/</g,'\\u003c') %></script>
<script>
(() => {
  const configForm=document.getElementById('wm10ConfigForm'), configMessage=document.getElementById('wm10ConfigMessage');
  const simulate=document.getElementById('wm10Simulate'), refresh=document.getElementById('wm10Refresh'), execute=document.getElementById('wm10Execute'), progress=document.getElementById('wm10Progress'), reportBox=document.getElementById('wm10Report');
  const diagnose=document.getElementById('wm10Diagnose'), diagnosticCode=document.getElementById('wm10DiagnosticCode'), diagnosticBox=document.getElementById('wm10Diagnostic'), normalizeNames=document.getElementById('wm10NormalizeNames');
  const legacyRun=document.getElementById('wm10LegacyRun'), legacyProgress=document.getElementById('wm10LegacyProgress');
  const receivablesImport=document.getElementById('wm10ReceivablesImport'), receivablesSummary=document.getElementById('wm10ReceivablesSummary'), receivablesList=document.getElementById('wm10ReceivablesList'), receivablesProgress=document.getElementById('wm10ReceivablesProgress');
  const archiveRun=document.getElementById('wm10ArchiveRun'), archiveRetry=document.getElementById('wm10ArchiveRetry'), archiveSummary=document.getElementById('wm10ArchiveSummary'), archiveProgress=document.getElementById('wm10ArchiveProgress');
  const parseJson=id=>{try{return JSON.parse(document.getElementById(id)?.textContent||'{}');}catch(_){return {};}};
  let cacheInfo=parseJson('wm10CacheData'), legacyInfo=parseJson('wm10LegacyData'), archiveInfo=parseJson('wm10ArchiveData'), lastReport=null;
  const request=async(url,options={})=>{const response=await fetch(url,{...options,headers:{'Content-Type':'application/json',Accept:'application/json',...(options.headers||{})}});const result=await response.json();if(!response.ok||!result.success)throw new Error(result.message||'Falha na operação.');return result;};
  const money=value=>Number(value||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  async function loadReceivablesStatus(){
    try{
      const result=await request('/erp/clientes/importar-wm10/crediarios/status');
      const summary=result.summary||{};
      receivablesSummary.innerHTML=[['Crediários',summary.total||0],['Clientes localizados',summary.ready||0],['Já importados',summary.imported||0],['Pendentes',summary.pending||0],['Saldo total',money(summary.openValue||0)]].map(([label,value])=>`<div class="wm10-stat"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`).join('');
      const rows=result.items||[];
      receivablesList.innerHTML=`<article class="wm10-list-head"><span>Origem</span><span>Cliente</span><span>CPF</span><span>Saldo</span><span>Status</span></article>`+rows.map(item=>`<article><strong>${esc(item.originId&&String(item.originId).startsWith('manual')?'Manual':`#${item.originId}`)}</strong><span>${esc(item.customerCurrentName||item.customerName)}</span><span>${esc(formatDocument(item.customerDocument))}</span><span>${esc(money(item.openBalance))}</span><small>${item.imported?'✅ Importado':item.customerFound?'Pronto para importar':'❌ Cliente não localizado'}</small></article>`).join('');
      receivablesImport.disabled=Number(summary.pending||0)===0||Number(summary.ready||0)!==Number(summary.total||0);
      receivablesImport.textContent=Number(summary.pending||0)===0?'Crediários já importados':`Importar ${summary.pending} crediário(s)`;
      return result;
    }catch(error){receivablesProgress.hidden=false;receivablesProgress.textContent=error.message;receivablesImport.disabled=true;}
  }
  const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
  function renderCacheInfo(info=cacheInfo){cacheInfo=info||{};const status=document.getElementById('wm10CacheStatus'),cost=document.getElementById('wm10CacheCost');if(cacheInfo.available){status.textContent=`${cacheInfo.rows||cacheInfo.total||0} cliente(s) no snapshot · atualizado em ${cacheInfo.updatedAt?new Date(cacheInfo.updatedAt).toLocaleString('pt-BR'):'—'}`;}else status.textContent='Nenhum snapshot local criado ainda.';cost.textContent=`Atualização externa estimada: ${cacheInfo.estimatedRefreshRequests||1} requisição(ões) · aproximadamente ${money(cacheInfo.estimatedRefreshCost||0.01)}. Reanalisar depois custa R$ 0,00.`;simulate.disabled=!cacheInfo.available;}
  function renderLegacyInfo(info=legacyInfo){legacyInfo=info||{};const stats=[['Clientes vinculados',legacyInfo.totalCustomers||0],['Clientes completos',legacyInfo.processedCustomers||0],['Clientes pendentes',legacyInfo.pendingCustomers||0],['Lote',legacyInfo.batchSize||0],['Consultas restantes',legacyInfo.estimatedRequests||0],['Custo restante',money(legacyInfo.estimatedCost||0)],['Vendas importadas',legacyInfo.saleCount||0],['O.S. importadas',legacyInfo.serviceOrderCount||0],['Total histórico',legacyInfo.operationCount||0],['Clientes com histórico',legacyInfo.customersWithHistory||0]];document.getElementById('wm10LegacySummary').innerHTML=stats.map(([label,value])=>`<div class="wm10-stat"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`).join('');legacyRun.textContent=legacyInfo.complete?'Histórico WM10 concluído':'Importar histórico WM10';}
  function renderArchiveInfo(info=archiveInfo){
    archiveInfo=info||{};
    const statusMap={not_started:'Não iniciado',ready:'Pronto',running:'Em execução',paused:'Pausado por erro',complete:'Concluído'};
    const stats=[['Status',statusMap[archiveInfo.status]||archiveInfo.status||'Não iniciado'],['Etapas',archiveInfo.totalTasks||0],['Concluídas',archiveInfo.doneTasks||0],['Pendentes',archiveInfo.pendingTasks||0],['Requisições feitas',archiveInfo.requestCount||0],['Custo realizado',money(archiveInfo.actualCost||0)],['Estimativa restante',money(archiveInfo.estimatedCost||0)],['Erros',archiveInfo.errorTasks||0]];
    archiveSummary.innerHTML=stats.map(([label,value])=>`<div class="wm10-stat"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`).join('');
    archiveRun.textContent=archiveInfo.status==='complete'?'Arquivo histórico concluído':archiveInfo.available?'Continuar arquivo histórico':'Criar arquivo histórico';
    archiveRun.disabled=archiveInfo.status==='complete';
    archiveRetry.hidden=!(Number(archiveInfo.errorTasks||0)>0);
  }
  renderCacheInfo();renderLegacyInfo();renderArchiveInfo();
  configForm.addEventListener('submit',async event=>{event.preventDefault();configMessage.hidden=false;configMessage.textContent='Salvando…';try{const data=Object.fromEntries(new FormData(configForm));const result=await request('/erp/clientes/importar-wm10/configuracao',{method:'POST',body:JSON.stringify(data)});configMessage.textContent=`${result.message} Atualize a página para recalcular as estimativas.`;}catch(error){configMessage.textContent=error.message;}});
  const formatDocument=value=>{const raw=String(value||'').replace(/\D/g,'');if(raw.length===11)return raw.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/,'$1.$2.$3-$4');if(raw.length===14)return raw.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/,'$1.$2.$3/$4-$5');return raw||'—';};
  const fillList=(id,items,kind)=>{const target=document.getElementById(id);const rows=(items||[]).slice(0,5000);if(!rows.length){target.innerHTML='<p>Nenhum registro.</p>';return;}target.innerHTML=`<article class="wm10-list-head"><span>Código</span><span>Nome</span><span>CPF/CNPJ</span><span>Cidade</span><span>Resultado</span></article>`+rows.map(item=>{const mapped=item.mapped||{};const city=item.city||mapped.city||'';const state=item.state||mapped.state||'';const result=kind==='new'?'Novo cliente':kind==='existing'?'Preservado — sem alteração':item.matchBy||item.reason||'';const search=[item.name,item.document||mapped.document,city,state,result].join(' ').toLowerCase();return `<article data-search="${esc(search)}"><strong>#${esc(item.code)}</strong><span>${esc(item.name||'Sem nome')}</span><span>${esc(formatDocument(item.document||mapped.document))}</span><span>${esc([city,state].filter(Boolean).join('/')||'—')}</span><small>${esc(result)}</small></article>`;}).join('');};
  function applySearch(){const term=document.getElementById('wm10Search').value;document.querySelectorAll('.wm10-list article[data-search]').forEach(row=>{row.hidden=!QualitySearch.matches(row.dataset.search,term);});}
  document.getElementById('wm10Search').addEventListener('input',applySearch);
  function render(report){lastReport=report;reportBox.hidden=false;document.getElementById('wm10GeneratedAt').textContent=`Consulta gerada em ${new Date(report.generatedAt).toLocaleString('pt-BR')}`;const stats=[['Localizados',report.totalFound],['Novos para importar',report.new.length],['Existentes preservados',report.updates.length],['Ignorados',report.ignored.length],['Conflitos',report.duplicates.length],['Avisos',report.invalid.length],['Ativos',report.active||0],['Inativos',report.inactive||0],['Pessoa física',report.individuals||0],['Pessoa jurídica',report.companies||0],['Nomes padronizados',report.normalizedNames||0],['WhatsApp via celular',report.whatsAppFromMobile||0],['WhatsApp via telefone',report.whatsAppFromPhone||0],['Sem WhatsApp',report.withoutWhatsApp],['Sem nascimento',report.withoutBirthDate]];document.getElementById('wm10Summary').innerHTML=stats.map(([label,value])=>`<div class="wm10-stat"><span>${label}</span><strong>${value}</strong></div>`).join('');const conflicts=document.getElementById('wm10Conflicts');conflicts.hidden=!report.duplicates.length;conflicts.textContent=report.duplicates.length?`Importação bloqueada: ${report.duplicates.length} conflito(s). Revise os registros listados antes de continuar.`:'';execute.disabled=report.duplicates.length>0||report.new.length===0;execute.textContent=report.new.length?`Importar ${report.new.length} novo(s) cliente(s)`:'Nenhum cliente novo';fillList('wm10NewList',report.new,'new');fillList('wm10UpdateList',report.updates,'existing');fillList('wm10IgnoredList',[...report.ignored,...report.invalid,...report.duplicates],'warning');applySearch();reportBox.scrollIntoView({behavior:'smooth',block:'start'});}
  const fieldRows=fields=>Object.entries(fields||{}).map(([key,value])=>`<dt>${esc(key)}</dt><dd>${esc(value||'—')}</dd>`).join('');
  function renderDiagnostic(diagnostic){
    diagnosticBox.hidden=false;
    document.getElementById('wm10DiagnosticConclusion').textContent=diagnostic.conclusion||'';
    const stats=[['Código',diagnostic.customerCode],['HTTP',diagnostic.httpStatus],['Bytes',diagnostic.rawLength],['Content-Type',diagnostic.contentType],['Escolhida',diagnostic.selectedEncoding||'—'],['� nos bytes',diagnostic.rawContainsReplacementUtf8?'Sim':'Não']];
    document.getElementById('wm10DiagnosticSummary').innerHTML=stats.map(([label,value])=>`<div class="wm10-stat"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`).join('');
    document.getElementById('wm10DiagnosticCandidates').innerHTML=(diagnostic.candidates||[]).map(candidate=>`<article class="wm10-diagnostic-card"><h3>${esc(candidate.encoding)} ${candidate.parseOk?'✅':'❌'}</h3><p>Score: <strong>${esc(candidate.score)}</strong> · �: ${esc(candidate.replacementCount)} · Mojibake: ${esc(candidate.mojibakeCount)} · Controles: ${esc(candidate.controlCount)}</p>${candidate.parseError?`<p>${esc(candidate.parseError)}</p>`:`<dl>${fieldRows(candidate.fields)}</dl>`}</article>`).join('');
    document.getElementById('wm10DiagnosticHex').textContent=diagnostic.hexPreview||'';
    diagnosticBox.scrollIntoView({behavior:'smooth',block:'start'});
  }
  diagnose.addEventListener('click',async()=>{const code=Number.parseInt(diagnosticCode.value,10);if(!code){alert('Informe o código WM10 do cliente.');diagnosticCode.focus();return;}diagnose.disabled=true;diagnose.textContent='Diagnosticando…';try{const result=await request('/erp/clientes/importar-wm10/diagnosticar',{method:'POST',body:JSON.stringify({customerCode:code})});renderDiagnostic(result.diagnostic);}catch(error){alert(error.message);}finally{diagnose.disabled=false;diagnose.textContent='🔍 Diagnosticar registro';}});
  refresh.addEventListener('click',async()=>{const estimated=cacheInfo.estimatedRefreshRequests||1,cost=cacheInfo.estimatedRefreshCost||estimated*0.01;if(!confirm(`Atualizar o snapshot de clientes do WM10?\n\nEstimativa: ${estimated} requisição(ões), cerca de ${money(cost)}.\nDepois disso, simular e importar usam o snapshot local sem novas consultas.`))return;refresh.disabled=true;simulate.disabled=true;progress.hidden=false;progress.textContent='Atualizando snapshot de clientes do WM10…';try{const result=await request('/erp/clientes/importar-wm10/atualizar',{method:'POST',body:'{}'});renderCacheInfo(result.cacheInfo);progress.textContent=`Snapshot atualizado: ${result.cacheInfo.rows} clientes em ${result.cacheInfo.requestCount} requisição(ões) (${money(result.cacheInfo.actualCost)}).`;setTimeout(()=>{progress.hidden=true;},3500);}catch(error){alert(error.message);progress.hidden=true;}finally{refresh.disabled=false;simulate.disabled=!cacheInfo.available;}});
  simulate.addEventListener('click',async()=>{simulate.disabled=true;progress.hidden=false;progress.textContent='Reanalisando o snapshot local — nenhuma consulta cobrada ao WM10…';try{const result=await request('/erp/clientes/importar-wm10/simular',{method:'POST',body:JSON.stringify({normalizeIndividualNames:normalizeNames.checked})});render(result.report);}catch(error){alert(error.message);}finally{simulate.disabled=!cacheInfo.available;progress.hidden=true;}});
  legacyRun.addEventListener('click',async()=>{legacyRun.disabled=true;legacyProgress.hidden=false;legacyProgress.textContent='Preparando histórico e calculando somente as consultas ainda pendentes…';try{let result=await request('/erp/clientes/importar-wm10/legado/preparar',{method:'POST',body:'{}'});let info=result.info;renderLegacyInfo(info);if(info.complete){legacyProgress.textContent='O histórico completo de Vendas e O.S. concluídas já está salvo localmente. Nenhuma nova consulta foi feita.';return;}if(!confirm(`Importar o histórico completo de Vendas e O.S. concluídas para ${info.pendingCustomers} cliente(s)?\n\nRestam aproximadamente ${info.estimatedRequests} requisição(ões) ao WM10 (${money(info.estimatedCost)}).\n\nOs registros serão somente históricos: não alteram cadastro, estoque, caixa, financeiro ou comissão.`)){legacyProgress.hidden=true;return;}let calls=0;while(!info.complete){const tipo=info.salePendingCustomers>0?'Vendas':'O.S.';legacyProgress.textContent=`Consultando ${tipo} concluídas… ${info.estimatedRequests} consulta(s) restantes. Realizadas nesta execução: ${calls}.`;result=await request('/erp/clientes/importar-wm10/legado/proximo',{method:'POST',body:'{}'});info=result.info;calls+=Number(info.requestCount||0);renderLegacyInfo(info);}legacyProgress.textContent=`Histórico concluído: ${calls} requisição(ões) nesta execução. ${info.saleCount||0} venda(s) e ${info.serviceOrderCount||0} O.S. ficaram disponíveis no Histórico de operações, sem movimentar o ERP.`;}catch(error){legacyProgress.textContent=`Importação interrompida: ${error.message} As consultas já concluídas ficaram salvas; ao continuar, elas não serão repetidas.`;}finally{legacyRun.disabled=false;}});
  archiveRun.addEventListener('click',async()=>{
    archiveRun.disabled=true;archiveProgress.hidden=false;
    try{
      let result=await request('/erp/clientes/importar-wm10/arquivo-historico/preparar',{method:'POST',body:'{}'});
      let info=result.info;renderArchiveInfo(info);
      if(info.status==='complete'){archiveProgress.textContent='Arquivo histórico WM10 já está completo e salvo separadamente.';return;}
      const estimate=Math.max(1,Number(info.estimatedRequests||info.pendingTasks||0));
      if(!confirm(`Criar/continuar o Arquivo Histórico completo da WM10?\n\nA estimativa atual é de ${estimate} requisição(ões), aproximadamente ${money(info.estimatedCost||estimate*0.01)}.\n\nA quantidade pode aumentar depois da primeira página de Clientes/Produtos, quando a API informar o total real.\n\nOs dados ficarão em uma pasta separada e NÃO serão aplicados ao ERP.`)){archiveProgress.hidden=true;return;}
      let calls=0;
      while(info.status!=='complete'){
        if(Number(info.errorTasks||0)>0) throw new Error('Existe uma etapa com erro. Use “Repetir itens com erro” para continuar.');
        archiveProgress.textContent=`Arquivando WM10… ${info.doneTasks||0}/${info.totalTasks||0} etapas. Próxima: ${info.nextTask||'calculando…'} · ${calls} requisição(ões) nesta execução.`;
        result=await request('/erp/clientes/importar-wm10/arquivo-historico/proximo',{method:'POST',body:'{}'});
        info=result.info;calls+=Number(info.processedNow||0);renderArchiveInfo(info);
      }
      archiveProgress.textContent=`Arquivo histórico concluído. ${info.requestCount||0} requisição(ões) registradas no total (${money(info.actualCost||0)}). Dados salvos separadamente em data/erp/wm10-arquivo-historico.`;
    }catch(error){
      archiveProgress.textContent=`Arquivo histórico pausado: ${error.message} O que já foi concluído permaneceu salvo e não será repetido.`;
      try{const state=await request('/erp/clientes/importar-wm10/arquivo-historico/status');renderArchiveInfo(state.info);}catch(_){}
    }finally{if(archiveInfo.status!=='complete')archiveRun.disabled=false;}
  });
  archiveRetry.addEventListener('click',async()=>{try{const result=await request('/erp/clientes/importar-wm10/arquivo-historico/repetir-erros',{method:'POST',body:'{}'});renderArchiveInfo(result.info);archiveProgress.hidden=false;archiveProgress.textContent='Itens com erro reabertos. Clique em “Continuar arquivo histórico”.';}catch(error){alert(error.message);}});

  receivablesImport.addEventListener('click',async()=>{
    const status=await loadReceivablesStatus(); if(!status)return;
    const pending=Number(status.summary?.pending||0); if(!pending)return;
    if(!confirm(`Importar ${pending} crediário(s) em aberto do WM10 para Contas a Receber?\n\nSaldo total considerado: ${money(status.summary?.openValue||0)}.\nSomente o saldo em aberto será criado; nenhum estoque, venda ou caixa será movimentado.`))return;
    receivablesImport.disabled=true;receivablesProgress.hidden=false;receivablesProgress.textContent='Importando saldos em aberto para Contas a Receber…';
    try{const result=await request('/erp/clientes/importar-wm10/crediarios/importar',{method:'POST',body:'{}'});receivablesProgress.textContent=result.message;await loadReceivablesStatus();}
    catch(error){receivablesProgress.textContent=error.message;receivablesImport.disabled=false;}
  });
  loadReceivablesStatus();
  execute.addEventListener('click',async()=>{if(!lastReport||execute.disabled)return;const normalizeAtExecution=Boolean(lastReport.normalizeIndividualNames);if(normalizeNames.checked!==normalizeAtExecution){alert('A opção de padronização mudou após a simulação. Execute uma nova simulação antes de importar.');return;}const expectedNewCodes=(lastReport.new||[]).map(item=>Number(item.code)).filter(Number.isFinite);if(!confirm(`Importar somente ${expectedNewCodes.length} cliente(s) novo(s)?\n\nOs ${lastReport.updates.length} clientes já existentes serão preservados sem qualquer alteração. Um backup será feito antes.`))return;execute.disabled=true;execute.textContent='Importando novos…';try{const result=await request('/erp/clientes/importar-wm10/executar',{method:'POST',body:JSON.stringify({mode:'new-only',normalizeIndividualNames:normalizeAtExecution,expectedNewCodes})});alert(`${result.message}\nNovos importados: ${result.report.imported}\nExistentes preservados: ${result.report.preservedExisting}\nAtualizados: ${result.report.updated}\nErros: ${result.report.errors.length}`);window.location.href='/erp/clientes';}catch(error){alert(error.message);execute.disabled=false;execute.textContent=`Importar ${expectedNewCodes.length} novo(s) cliente(s)`;}});
})();
</script>
