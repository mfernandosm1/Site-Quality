<% layout('layout') -%>

<% if (flashes && flashes.length) { %>
  <% flashes.forEach(function(msg){ %>
    <div class="notice">✅ <%= msg %></div>
  <% }) %>
<% } %>

<div class="card">
  <h3>🖼️ Banners (CRUD)</h3>

  <form method="post" action="/banners/add" class="grid" style="grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:10px;">
    <div>
      <label>Imagem Desktop (URL)</label>
      <input type="text" name="src" placeholder="images/meu-banner.png">
    </div>
    <div>
      <label>Imagem Mobile (URL)</label>
      <input type="text" name="mobileSrc" placeholder="images/meu-banner-mobile.png">
    </div>
    <div>
      <label>Título</label>
      <input type="text" name="title" placeholder="Título do banner">
    </div>
    <div>
      <label>Link</label>
      <input type="text" name="href" placeholder="https://wa.me/...">
    </div>
    <div>
      <label>Ordem</label>
      <input type="number" name="order" value="<%= (items||[]).length %>">
    </div>
    <div style="display:flex; align-items:flex-end; gap:8px;">
      <button class="btn">💾 Adicionar</button>
    </div>
  </form>

  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Preview</th>
        <th>Imagem (desktop)</th>
        <th>Imagem (mobile)</th>
        <th>Título</th>
        <th>Link</th>
        <th>Ordem</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% (items||[]).forEach(function(it, idx){ %>
        <tr>
          <td><span class="badge"><%= idx+1 %></span></td>
          <td>
            <% if (it.src) { %>
              <img src="<%= it.src %>" alt="" style="height:26px;max-width:120px;object-fit:cover;border-radius:6px;">
            <% } %>
          </td>
          <td>
            <form method="post" action="/banners/<%= idx %>/save">
              <input type="text" name="src" value="<%- it.src||'' %>" placeholder="images/bannerX.png">
          </td>
          <td>
              <input type="text" name="mobileSrc" value="<%- it.mobileSrc||'' %>" placeholder="images/bannerX-mobile.png">
          </td>
          <td>
              <input type="text" name="title" value="<%- it.title||'' %>">
          </td>
          <td>
              <input type="text" name="href" value="<%- it.href||'' %>" placeholder="https://...">
          </td>
          <td style="width:80px;">
              <input type="number" name="order" value="<%- Number(it.order||0) %>">
          </td>
          <td style="white-space:nowrap;">
              <button class="btn btn-small">💾 Salvar</button>
            </form>
            <form method="post" action="/banners/delete/<%= idx %>" style="display:inline;">
              <button class="btn btn-small btn-danger" onclick="return confirm('🗑️ Deseja realmente excluir este banner?')">🗑️ Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!items || !items.length) { %>
        <tr><td colspan="8" style="text-align:center;color:#777;">Nenhum banner cadastrado.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
