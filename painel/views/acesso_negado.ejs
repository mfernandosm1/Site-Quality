<% layout('layout') -%>
<section style="max-width:720px;margin:40px auto;border:1px solid var(--line);background:var(--card);border-radius:18px;padding:28px;text-align:center">
  <div style="font-size:42px">🔒</div>
  <h1 style="margin:8px 0;color:var(--text)">Acesso não permitido</h1>
  <p style="color:var(--muted);line-height:1.55">Seu perfil não possui permissão para abrir esta área ou executar esta ação.</p>
  <% if(typeof permission!=='undefined' && permission){ %><code style="display:inline-block;margin:8px 0 18px;padding:6px 9px;border-radius:8px;background:color-mix(in srgb,var(--card) 88%,var(--text));color:var(--muted)"><%= permission %></code><% } %>
  <div><a class="btn primary" href="/">Voltar ao início</a></div>
</section>
