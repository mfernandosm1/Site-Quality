<% layout('layout') -%>
<%
  const iconOptions = [
    { value: '', label: 'Sem ícone' },
    { value: 'fa-solid fa-mobile-screen-button', label: '📱 Smartphones' },
    { value: 'fa-solid fa-headphones', label: '🎧 Acessórios / Fones' },
    { value: 'fa-solid fa-laptop', label: '💻 Notebooks' },
    { value: 'fa-solid fa-tablet-screen-button', label: '📲 Tablets' },
    { value: 'fa-solid fa-clock', label: '⌚ Smartwatch' },
    { value: 'fa-solid fa-gamepad', label: '🎮 Games / Videogames' },
    { value: 'fa-solid fa-volume-high', label: '🔊 Caixas de som' },
    { value: 'fa-solid fa-plug', label: '🔌 Carregadores / Cabos' },
    { value: 'fa-solid fa-camera', label: '📷 Câmeras' },
    { value: 'fa-solid fa-tv', label: '📺 TVs' },
    { value: 'fa-solid fa-memory', label: '💾 Memória / Pendrive' },
    { value: 'fa-solid fa-keyboard', label: '⌨️ Periféricos' },
    { value: 'fa-solid fa-battery-full', label: '🔋 Baterias' },
    { value: 'fa-solid fa-shield-screen', label: '🛡️ Películas / Proteção' },
    { value: 'fa-solid fa-tag', label: '🏷️ Ofertas / Geral' }
  ];
%>

<style>
  html, body {
    overflow-x: hidden !important;
  }

  .card {
    max-width: 100%;
    box-sizing: border-box;
  }

  .cat-page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
  }

  .cat-page-header h3 {
    margin: 0;
  }

  .cat-subtitle {
    color: #64748b;
    font-size: 13px;
    margin-top: 4px;
  }

  .cat-create-box {
    display: none;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    border-radius: 14px;
    padding: 14px;
    margin: 12px 0 18px;
  }

  .cat-create-box.open {
    display: block;
  }

  .cat-create-grid {
    display: grid;
    grid-template-columns: minmax(160px, 1.2fr) minmax(140px, 1fr) 90px minmax(190px, 1fr) auto;
    gap: 10px;
    align-items: end;
  }

  .cat-create-grid .full { grid-column: 1 / -1; }

  .cat-seo-help { color:#64748b; font-size:12px; margin-top:4px; line-height:1.35; }
  .cat-seo-counter { color:#64748b; font-size:12px; margin-top:5px; font-weight:700; }
  .cat-seo-counter.ok { color:#047857; }
  .cat-seo-counter.warn { color:#c2410c; }

  .cat-list {
    display: grid;
    gap: 10px;
    width: 100%;
  }

  .cat-list-head,
  .cat-row {
    display: grid;
    grid-template-columns: 44px minmax(170px, 1.3fr) minmax(120px, .9fr) 74px minmax(120px, .8fr) 116px;
    gap: 10px;
    align-items: center;
  }

  .cat-list-head {
    padding: 0 8px 10px;
    border-bottom: 1px solid #e5e7eb;
    color: #111827;
    font-weight: 800;
    font-size: 13px;
  }

  .cat-row {
    padding: 12px 8px;
    border-bottom: 1px solid #e5e7eb;
  }

  .cat-row:last-child {
    border-bottom: 0;
  }

  .cat-index {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #f3f4f6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    font-weight: 700;
    font-size: 13px;
  }

  .cat-name {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .cat-icon-preview {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: #2563eb;
    font-size: 18px;
  }

  .cat-name-main {
    font-weight: 800;
    color: #111827;
    line-height: 1.2;
    word-break: break-word;
  }

  .cat-muted {
    color: #64748b;
    font-size: 12px;
    margin-top: 2px;
    word-break: break-word;
  }

  .cat-slug {
    font-size: 13px;
    color: #111827;
    word-break: break-word;
  }

  .cat-order-badge {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }

  .cat-icon-pill {
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border-radius: 999px;
    background: #f3f4f6;
    color: #334155;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 12px;
  }

  .cat-icon-pill i {
    color: #111827;
  }

  .cat-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
  }

  .cat-action-btn {
    min-width: 0;
    height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid #dbe2ea;
    background: #fff;
    cursor: pointer;
    font-weight: 800;
    color: #2563eb;
  }

  .cat-action-btn:hover {
    background: #eff6ff;
  }

  .cat-delete-row {
    margin: 0;
    padding: 0;
  }

  .cat-delete-btn {
    background: none;
    border: none;
    color: #dc2626;
    font-weight: 800;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 8px;
  }

  .cat-delete-btn:hover {
    background: #fef2f2;
  }

  .cat-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: rgba(15, 23, 42, .55);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }

  .cat-modal-backdrop.open {
    display: flex;
  }

  .cat-modal {
    width: min(560px, 100%);
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 22px 60px rgba(0,0,0,.25);
    overflow: hidden;
  }

  .cat-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .cat-modal-header h4 {
    margin: 0;
    font-size: 18px;
  }

  .cat-modal-body {
    padding: 18px 20px 20px;
  }

  .cat-modal-grid {
    display: grid;
    grid-template-columns: 1fr 120px;
    gap: 14px;
  }

  .cat-modal-grid .full {
    grid-column: 1 / -1;
  }

  .cat-modal-footer {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding-top: 16px;
  }

  .cat-modal-footer-left,
  .cat-modal-footer-right {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .cat-delete-inline {
    margin-top: 10px;
  }

  .cat-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    background: #fff;
    cursor: pointer;
  }

  @media (max-width: 980px) {
    .cat-list-head {
      display: none;
    }

    .cat-row {
      grid-template-columns: 36px 1fr auto;
      grid-template-areas:
        "idx name action"
        "idx meta action";
      gap: 8px 10px;
      align-items: center;
    }

    .cat-cell-idx { grid-area: idx; }
    .cat-cell-name { grid-area: name; }
    .cat-cell-slug {
      grid-area: meta;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .cat-cell-order,
    .cat-cell-icon {
      display: none;
    }
    .cat-cell-actions { grid-area: action; }

    .cat-slug::before {
      content: "Slug: ";
      color: #64748b;
      font-weight: 700;
    }

    .cat-action-btn {
      width: 40px;
      padding: 0;
      font-size: 0;
    }

    .cat-action-btn::before {
      content: "✏️";
      font-size: 16px;
    }

    .cat-delete-btn {
      font-size: 0;
      width: 40px;
      padding: 4px 0;
    }

    .cat-delete-btn::before {
      content: "🗑";
      font-size: 16px;
    }

    .cat-actions .sub-add-inline {
      width: 40px;
      min-height: 34px;
      padding: 0;
      overflow: hidden;
      font-size: 0;
    }

    .cat-actions .sub-add-inline::before {
      content: "+";
      font-size: 18px;
      line-height: 1;
    }

    .cat-create-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cat-create-submit {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .cat-page-header {
      flex-direction: column;
    }

    .cat-create-grid,
    .cat-modal-grid {
      grid-template-columns: 1fr;
    }

    .cat-row {
      grid-template-columns: 32px 1fr 44px;
    }

    .cat-icon-preview {
      display: none;
    }

    .cat-muted {
      display: none;
    }
  }

  .catalog-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e5e7eb;
  }
  .catalog-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid #dbe2ea;
    border-radius: 999px;
    background: var(--panel-card, #fff);
    color: inherit;
    text-decoration: none;
    font-weight: 800;
    font-size: 13px;
  }
  .catalog-tab:hover { background: rgba(59,130,246,.10); }
  .catalog-tab.active {
    border-color: #3b82f6;
    background: #3b82f6;
    color: #fff;
  }


  .cat-page-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
  .sub-create-box {
    display:none; border:1px solid #dbe2ea; background:var(--panel-soft,#f8fafc);
    border-radius:14px; padding:14px; margin:12px 0 18px;
  }
  .sub-create-box.open { display:block; }
  .sub-create-grid { display:grid; grid-template-columns:minmax(180px,1.2fr) minmax(160px,1fr) minmax(140px,1fr) 90px 110px 130px; gap:10px; align-items:end; }
  .sub-create-grid .full { grid-column:1/-1; }
  .cat-tree-row { position:relative; }
  .cat-tree-row.cat-parent-row { background:rgba(59,130,246,.035); }
  .cat-tree-row.sub-child-row { padding-top:9px; padding-bottom:9px; background:rgba(100,116,139,.035); }
  .sub-child-row .cat-cell-name { padding-left:28px; position:relative; }
  .sub-child-row .cat-cell-name::before { content:'↳'; position:absolute; left:3px; top:50%; transform:translateY(-50%); color:#64748b; font-weight:900; font-size:17px; }
  .sub-child-row .cat-name-main { font-weight:750; }
  .sub-meta-pills { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .sub-status-pill { display:inline-flex; align-items:center; min-height:28px; padding:0 9px; border-radius:999px; background:rgba(100,116,139,.13); font-size:11px; font-weight:800; white-space:nowrap; }
  .sub-status-pill.on { background:rgba(16,185,129,.13); color:#047857; }
  .sub-status-pill.off { background:rgba(239,68,68,.11); color:#b91c1c; }
  .sub-actions-unified { display:flex; flex-direction:column; align-items:flex-end; gap:5px; }
  .sub-empty-row { margin:0 8px 4px 76px; padding:8px 10px 10px 18px; border-left:2px dashed #cbd5e1; color:#64748b; font-size:12px; display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .sub-add-inline { border:0; background:transparent; color:#2563eb; font-weight:800; cursor:pointer; padding:5px 7px; border-radius:8px; white-space:nowrap; }
  .sub-add-inline:hover { background:rgba(59,130,246,.10); }
  .sub-modal-bg { position:fixed; inset:0; z-index:9999; background:rgba(15,23,42,.58); display:none; align-items:center; justify-content:center; padding:18px; }
  .sub-modal-bg.open { display:flex; }
  .sub-modal { width:min(620px,100%); max-height:calc(100vh - 36px); overflow:auto; background:var(--panel-card,#fff); border-radius:18px; box-shadow:0 22px 60px rgba(0,0,0,.28); padding:20px; }
  .sub-modal h3 { margin-top:0; }
  .sub-modal-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .sub-modal-grid .full { grid-column:1/-1; }
  .sub-modal-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:16px; }
  .cat-tree-helper { color:#64748b; font-size:12px; margin:-4px 0 12px 52px; }

  /* Respeita os temas globais do painel nesta tela. */
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-create-box,
  html[data-panel-theme]:not([data-panel-theme="light"]) .sub-create-box,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-modal,
  html[data-panel-theme]:not([data-panel-theme="light"]) .sub-modal {
    background:var(--card)!important; color:var(--text)!important; border-color:var(--line)!important;
  }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-list-head,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-row { border-color:var(--line)!important; color:var(--text)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-name-main,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-icon-pill i { color:var(--text)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-icon-preview,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-action-btn,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-close-btn { background:var(--card)!important; border-color:var(--line)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-action-btn:hover { background:var(--surface-hover)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-tree-row.cat-parent-row { background:color-mix(in srgb,var(--blue) 5%,var(--card))!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-tree-row.sub-child-row { background:var(--surface-soft)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .sub-empty-row { color:var(--muted)!important; border-color:var(--line)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-index,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-order-badge,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-icon-pill,
  html[data-panel-theme]:not([data-panel-theme="light"]) .sub-status-pill { background:var(--surface-soft)!important; color:var(--text)!important; border-color:var(--line)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-muted,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-subtitle,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-seo-help,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-seo-counter,
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-tree-helper { color:var(--muted)!important; }
  html[data-panel-theme]:not([data-panel-theme="light"]) .cat-slug { color:var(--text)!important; background:var(--surface-soft)!important; border-color:var(--line)!important; }
  html[data-panel-theme="oled"] .cat-tree-row.cat-parent-row { background:#050505!important; }
  html[data-panel-theme="oled"] .cat-tree-row.sub-child-row,
  html[data-panel-theme="oled"] .sub-empty-row { background:#0b0b0b!important; }
  html[data-panel-theme="blue"] .cat-tree-row.cat-parent-row { background:#0d1928!important; }
  html[data-panel-theme="blue"] .cat-tree-row.sub-child-row,
  html[data-panel-theme="blue"] .sub-empty-row { background:#142338!important; }

  @media(max-width:950px){
    .sub-create-grid { grid-template-columns:1fr 1fr; }
    .sub-create-grid .full { grid-column:1/-1; }
    .sub-empty-row { margin-left:46px; }
    .sub-child-row .cat-cell-name { padding-left:22px; }
  }
  @media(max-width:600px){
    .cat-page-actions { width:100%; justify-content:flex-start; }
    .sub-create-grid,.sub-modal-grid { grid-template-columns:1fr; }
    .sub-create-grid .full,.sub-modal-grid .full { grid-column:auto; }
    .sub-empty-row { margin-left:8px; }
  }

</style>

<div class="card">
  <div class="cat-page-header">
    <div>
      <h3>✨ 🗂️ Categorias da Loja Virtual</h3>
      <div class="cat-subtitle">Categorias e subcategorias agora ficam juntas em uma única estrutura.</div>
    </div>

    <div class="cat-page-actions">
      <button type="button" class="btn" id="btn-toggle-sub-create">+ Nova Subcategoria</button>
      <button type="button" class="btn primary" id="btn-toggle-create">+ Nova Categoria</button>
    </div>
  </div>

  <div class="cat-create-box" id="cat-create-box">
    <form method="post" action="/categorias/add" class="cat-create-grid">
      <div>
        <label>Nome</label>
        <input type="text" name="name" required placeholder="Ex.: Smartphones">
      </div>
      <div>
        <label>Slug</label>
        <input type="text" name="slug" placeholder="ex.: smartphones">
      </div>
      <div>
        <label>Ordem</label>
        <input type="number" name="order" placeholder="1">
      </div>
      <div>
        <label>Ícone</label>
        <select name="icon">
          <% iconOptions.forEach(opt => { %>
            <option value="<%= opt.value %>"><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="full">
        <label>Título SEO / WhatsApp</label>
        <input type="text" name="seoTitle" placeholder="Ex.: Smartphones | Quality Celulares">
        <div class="cat-seo-counter" data-counter-for="seoTitle"></div>
        <div class="cat-seo-help">Esse é o título que aparece no Google e na prévia do WhatsApp.</div>
      </div>
      <div class="full">
        <label>Descrição SEO / WhatsApp</label>
        <textarea name="seoDescription" rows="3" placeholder="Ex.: 📱 iPhones, Samsung, Motorola, Xiaomi e muito mais. Celulares novos e seminovos com garantia, frete grátis e atendimento especializado."></textarea>
        <div class="cat-seo-counter" data-counter-for="seoDescription"></div>
        <div class="cat-seo-help">Esse texto aparece no Google e na prévia do WhatsApp/Facebook da categoria.</div>
      </div>
      <div class="full">
        <label>Imagem de compartilhamento (opcional)</label>
        <input type="text" name="ogImage" placeholder="Ex.: images/logo.png ou link completo da imagem">
        <div class="cat-seo-help">Por enquanto pode deixar em branco para usar a logo. Depois podemos colocar banners por categoria.</div>
      </div>
      <div class="cat-create-submit">
        <button class="btn primary" type="submit">Adicionar categoria</button>
      </div>
    </form>
  </div>

  <div class="sub-create-box" id="sub-create-box">
    <form method="post" action="/subcategorias/add" class="sub-create-grid" id="sub-create-form">
      <div>
        <label>Categoria pai</label>
        <select name="categoryId" id="sub-create-category" required>
          <option value="">Selecione</option>
          <% (items||[]).forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
      </div>
      <div><label>Nome</label><input name="name" required placeholder="Ex.: Apple"></div>
      <div><label>Slug</label><input name="slug" placeholder="apple"></div>
      <div><label>Ordem</label><input type="number" name="order" min="1" placeholder="1"></div>
      <div><label>Ativa</label><select name="active"><option value="true">Sim</option><option value="false">Não</option></select></div>
      <div><label>Mostrar no site</label><select name="showOnSite"><option value="false">Não</option><option value="true">Sim</option></select></div>
      <div class="full"><label>Descrição interna</label><textarea name="description" rows="2" placeholder="Opcional"></textarea></div>
      <div><button class="btn primary" type="submit">Adicionar subcategoria</button></div>
    </form>
  </div>

  <div class="cat-tree-helper">A hierarquia abaixo representa <strong>Categoria → Subcategoria</strong>. Produtos continuam vinculados pelos mesmos dados já existentes.</div>

  <div class="cat-list">
    <div class="cat-list-head">
      <div>#</div>
      <div>Categoria / subcategoria</div>
      <div>Slug</div>
      <div>Ordem</div>
      <div>Ícone / status</div>
      <div style="text-align:right;">Ações</div>
    </div>

    <% (items||[]).forEach((c,idx)=>{
      const selectedIcon = iconOptions.find(opt => opt.value === (c.icon || ''));
      const iconLabel = selectedIcon ? selectedIcon.label : 'Personalizado';
      const filhos = (subcategorias||[]).filter(s => Number(s.categoryId) === Number(c.id));
    %>
      <div class="cat-row cat-tree-row cat-parent-row">
        <div class="cat-cell-idx"><span class="cat-index"><%= idx+1 %></span></div>

        <div class="cat-cell-name cat-name">
          <span class="cat-icon-preview">
            <% if (c.icon) { %><i class="<%= c.icon %>"></i><% } else { %>🗂️<% } %>
          </span>
          <div>
            <div class="cat-name-main"><%= c.name %></div>
            <div class="cat-muted"><%= filhos.length %> subcategoria<%= filhos.length === 1 ? '' : 's' %> · ID: <%= c.id %></div>
          </div>
        </div>

        <div class="cat-cell-slug"><code class="cat-slug"><%= c.slug %></code></div>
        <div class="cat-cell-order"><span class="cat-order-badge"><%= c.order || (idx+1) %></span></div>
        <div class="cat-cell-icon"><span class="cat-icon-pill"><% if (c.icon) { %><i class="<%= c.icon %>"></i><% } %><%= iconLabel %></span></div>

        <div class="cat-cell-actions cat-actions">
          <button type="button" class="cat-action-btn" data-open-modal="cat-modal-<%= c.id %>">✏️ Editar</button>
          <button type="button" class="sub-add-inline" data-add-subcategory="<%= c.id %>">+ Subcategoria</button>
          <form method="post" action="/categorias/del" class="cat-delete-row" onsubmit="return confirm('Excluir esta categoria?');">
            <input type="hidden" name="id" value="<%= c.id %>">
            <button type="submit" class="cat-delete-btn" <%= filhos.length ? 'disabled title="Remova ou reorganize as subcategorias primeiro"' : '' %>>🗑 Excluir</button>
          </form>
        </div>
      </div>

      <% filhos.forEach(s=>{ %>
        <div class="cat-row cat-tree-row sub-child-row">
          <div class="cat-cell-idx"></div>
          <div class="cat-cell-name cat-name">
            <div>
              <div class="cat-name-main"><%= s.name %></div>
              <div class="cat-muted">Subcategoria · ID: <%= s.id %></div>
            </div>
          </div>
          <div class="cat-cell-slug"><code class="cat-slug"><%= s.slug %></code></div>
          <div class="cat-cell-order"><span class="cat-order-badge"><%= s.order || 1 %></span></div>
          <div class="cat-cell-icon">
            <div class="sub-meta-pills">
              <span class="sub-status-pill <%= s.active !== false ? 'on' : 'off' %>"><%= s.active !== false ? 'Ativa' : 'Inativa' %></span>
              <span class="sub-status-pill"><%= (subUsage && subUsage[s.slug]) || 0 %> produto<%= ((subUsage && subUsage[s.slug]) || 0) === 1 ? '' : 's' %></span>
            </div>
          </div>
          <div class="cat-cell-actions cat-actions sub-actions-unified">
            <button type="button" class="cat-action-btn" data-open-sub="sub-modal-<%= s.id %>">✏️ Editar</button>
            <form method="post" action="/subcategorias/del" class="cat-delete-row" onsubmit="return confirm('Excluir esta subcategoria?');">
              <input type="hidden" name="id" value="<%= s.id %>">
              <button type="submit" class="cat-delete-btn" <%= (subUsage && subUsage[s.slug]) ? 'disabled title="Em uso por produtos"' : '' %>>🗑 Excluir</button>
            </form>
          </div>
        </div>
      <% }) %>

      <% if (!filhos.length) { %>
        <div class="sub-empty-row">
          <span>Nenhuma subcategoria cadastrada em <strong><%= c.name %></strong>.</span>
          <button type="button" class="sub-add-inline" data-add-subcategory="<%= c.id %>">+ Adicionar</button>
        </div>
      <% } %>
    <% }) %>
  </div>
</div>

<% (items||[]).forEach((c,idx)=>{ %>
  <div class="cat-modal-backdrop" id="cat-modal-<%= c.id %>" aria-hidden="true">
    <div class="cat-modal" role="dialog" aria-modal="true" aria-labelledby="cat-modal-title-<%= c.id %>">
      <div class="cat-modal-header">
        <h4 id="cat-modal-title-<%= c.id %>">Editar categoria</h4>
        <button type="button" class="cat-close-btn" data-close-modal title="Fechar">✕</button>
      </div>

      <div class="cat-modal-body">
        <form id="f<%=c.id%>" method="post" action="/categorias/update">
          <input type="hidden" name="id" value="<%= c.id %>">

          <div class="cat-modal-grid">
            <div class="full">
              <label>Nome</label>
              <input type="text" name="name" value="<%= c.name %>" required>
            </div>

            <div>
              <label>Slug</label>
              <input type="text" name="slug" value="<%= c.slug %>">
            </div>

            <div>
              <label>Ordem</label>
              <input type="number" name="order" value="<%= c.order || (idx+1) %>">
            </div>

            <div class="full">
              <label>Ícone</label>
              <select name="icon">
                <% iconOptions.forEach(opt => { %>
                  <option value="<%= opt.value %>" <%= (c.icon || '') === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                <% }) %>
              </select>
            </div>

            <div class="full">
              <label>Título SEO / WhatsApp</label>
              <input type="text" name="seoTitle" value="<%= c.seoTitle || ((c.name || 'Categoria') + ' | Quality Celulares') %>" placeholder="Ex.: Smartphones | Quality Celulares">
              <div class="cat-seo-counter" data-counter-for="seoTitle"></div>
              <div class="cat-seo-help">Título que aparece no Google e na prévia do WhatsApp/Facebook.</div>
            </div>

            <div class="full">
              <label>Descrição SEO / WhatsApp</label>
              <textarea name="seoDescription" rows="4" placeholder="Texto que aparece no Google e na prévia do WhatsApp/Facebook"><%= c.seoDescription || '' %></textarea>
        <div class="cat-seo-counter" data-counter-for="seoDescription"></div>
              <div class="cat-seo-help">Para Smartphones, use: 📱 iPhones, Samsung, Motorola, Xiaomi e muito mais. Celulares novos e seminovos com garantia, frete grátis e atendimento especializado.</div>
            </div>

            <div class="full">
              <label>Imagem de compartilhamento (opcional)</label>
              <input type="text" name="ogImage" value="<%= c.ogImage || '' %>" placeholder="Ex.: images/logo.png ou link completo da imagem">
              <div class="cat-seo-help">Deixe em branco para usar a logo padrão. Mais adiante podemos usar um banner exclusivo por categoria.</div>
            </div>
          </div>

          <div class="cat-modal-footer">
            <div class="cat-modal-footer-left">
              <button type="button" class="btn" data-close-modal>Cancelar</button>
            </div>
            <div class="cat-modal-footer-right">
              <button class="btn primary" type="submit">Salvar alterações</button>
            </div>
          </div>
        </form>

        <form method="post" action="/categorias/del" class="cat-delete-inline" onsubmit="return confirm('Excluir esta categoria?');">
          <input type="hidden" name="id" value="<%= c.id %>">
          <button class="btn" type="submit">Excluir categoria</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<% (subcategorias||[]).forEach(s=>{ %>
  <div class="sub-modal-bg" id="sub-modal-<%= s.id %>" aria-hidden="true">
    <div class="sub-modal" role="dialog" aria-modal="true" aria-labelledby="sub-modal-title-<%= s.id %>">
      <h3 id="sub-modal-title-<%= s.id %>">Editar subcategoria</h3>
      <form method="post" action="/subcategorias/update">
        <input type="hidden" name="id" value="<%= s.id %>">
        <div class="sub-modal-grid">
          <div>
            <label>Categoria pai</label>
            <select name="categoryId" required>
              <% (items||[]).forEach(c=>{ %>
                <option value="<%= c.id %>" <%= Number(c.id)===Number(s.categoryId)?'selected':'' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div><label>Nome</label><input name="name" value="<%= s.name %>" required></div>
          <div><label>Slug</label><input name="slug" value="<%= s.slug %>"></div>
          <div><label>Ordem</label><input type="number" min="1" name="order" value="<%= s.order||1 %>"></div>
          <div><label>Ativa</label><select name="active"><option value="true" <%= s.active!==false?'selected':'' %>>Sim</option><option value="false" <%= s.active===false?'selected':'' %>>Não</option></select></div>
          <div><label>Mostrar no site</label><select name="showOnSite"><option value="false" <%= !s.showOnSite?'selected':'' %>>Não</option><option value="true" <%= s.showOnSite?'selected':'' %>>Sim</option></select></div>
          <div class="full"><label>Descrição interna</label><textarea name="description" rows="3"><%= s.description||'' %></textarea></div>
        </div>
        <div class="sub-modal-actions">
          <button type="button" class="btn" data-close-sub>Cancelar</button>
          <button class="btn primary" type="submit">Salvar alterações</button>
        </div>
      </form>
    </div>
  </div>
<% }) %>

<div class="card">
  <h3>✨ Importar</h3>
  <p class="notice">Tenta ler itens do &lt;nav&gt; do <code>header.html</code> (textos viram nome; href vira slug).</p>
  <form method="post" action="/categorias/import"><button class="btn">Importar do header.html</button></form>
</div>

<div class="card">
  <h3>✨ 🧹 Limpar categorias em desuso</h3>
  <p class="notice">Remove arquivos antigos <code>categoria-*.html</code>. A página nova continua sendo apenas <code>categoria.html</code>.</p>
  <button id="btn-limpar-categorias" class="btn">🧹 Limpar categorias em desuso</button>
</div>

<script>
(function(){
  const createBtn = document.getElementById('btn-toggle-create');
  const createBox = document.getElementById('cat-create-box');

  if (createBtn && createBox) {
    createBtn.addEventListener('click', () => {
      createBox.classList.toggle('open');
      createBtn.textContent = createBox.classList.contains('open') ? 'Fechar criação' : '+ Nova Categoria';
    });
  }

  const subCreateBtn = document.getElementById('btn-toggle-sub-create');
  const subCreateBox = document.getElementById('sub-create-box');
  const subCreateCategory = document.getElementById('sub-create-category');

  function openSubCreate(categoryId = '') {
    if (!subCreateBox) return;
    subCreateBox.classList.add('open');
    if (subCreateBtn) subCreateBtn.textContent = 'Fechar subcategoria';
    if (categoryId && subCreateCategory) subCreateCategory.value = String(categoryId);
    subCreateBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    window.setTimeout(() => subCreateBox.querySelector('input[name="name"]')?.focus(), 180);
  }

  subCreateBtn?.addEventListener('click', () => {
    if (!subCreateBox) return;
    const willOpen = !subCreateBox.classList.contains('open');
    subCreateBox.classList.toggle('open', willOpen);
    subCreateBtn.textContent = willOpen ? 'Fechar subcategoria' : '+ Nova Subcategoria';
  });

  document.querySelectorAll('[data-add-subcategory]').forEach(btn => {
    btn.addEventListener('click', () => openSubCreate(btn.getAttribute('data-add-subcategory')));
  });

  function openModal(id) {
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeModal(modal) {
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll('[data-open-modal]').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.getAttribute('data-open-modal')));
  });

  document.querySelectorAll('[data-close-modal]').forEach(btn => {
    btn.addEventListener('click', () => closeModal(btn.closest('.cat-modal-backdrop')));
  });

  document.querySelectorAll('.cat-modal-backdrop').forEach(backdrop => {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal(backdrop);
    });
  });

  document.querySelectorAll('[data-open-sub]').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = document.getElementById(btn.getAttribute('data-open-sub'));
      modal?.classList.add('open');
      modal?.setAttribute('aria-hidden', 'false');
    });
  });

  document.querySelectorAll('[data-close-sub]').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = btn.closest('.sub-modal-bg');
      modal?.classList.remove('open');
      modal?.setAttribute('aria-hidden', 'true');
    });
  });

  document.querySelectorAll('.sub-modal-bg').forEach(backdrop => {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        backdrop.classList.remove('open');
        backdrop.setAttribute('aria-hidden', 'true');
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.cat-modal-backdrop.open').forEach(closeModal);
      document.querySelectorAll('.sub-modal-bg.open').forEach(modal => { modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); });
    }
  });



  function slugifyCategory(value) {
    return (value || '')
      .toString()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function bindAutoSlug(form) {
    const nameInput = form.querySelector('input[name="name"]');
    const slugInput = form.querySelector('input[name="slug"]');
    if (!nameInput || !slugInput) return;

    let slugEditedManually = !!slugInput.value.trim();

    slugInput.addEventListener('input', () => {
      slugEditedManually = true;
      slugInput.value = slugifyCategory(slugInput.value);
    });

    nameInput.addEventListener('input', () => {
      if (!slugEditedManually || !slugInput.value.trim()) {
        slugInput.value = slugifyCategory(nameInput.value);
      }
    });

    slugInput.addEventListener('blur', () => {
      slugInput.value = slugifyCategory(slugInput.value || nameInput.value);
    });
  }

  document.querySelectorAll('form[action="/categorias/add"], form[action="/categorias/update"]').forEach(bindAutoSlug);
  document.querySelectorAll('form[action="/subcategorias/add"], form[action="/subcategorias/update"]').forEach(bindAutoSlug);



  function bindSeoCounters(form) {
    function bind(fieldName, max, min) {
      const input = form.querySelector('[name="' + fieldName + '"]');
      const output = form.querySelector('[data-counter-for="' + fieldName + '"]');
      if (!input || !output) return;
      function update() {
        const len = (input.value || '').trim().length;
        output.className = 'cat-seo-counter';
        let status = 'Pode ser mais completo';
        if (len >= min && len <= max) { status = 'Tamanho recomendado'; output.classList.add('ok'); }
        else if (len > max) { status = 'Pode ser cortado'; output.classList.add('warn'); }
        output.textContent = len + ' / ' + max + ' caracteres — ' + status;
      }
      input.addEventListener('input', update);
      update();
    }
    bind('seoTitle', 60, 30);
    bind('seoDescription', 160, 120);
  }

  document.querySelectorAll('form[action="/categorias/add"], form[action="/categorias/update"]').forEach(bindSeoCounters);

  const btn = document.getElementById('btn-limpar-categorias');
  if(!btn) return;
  btn.addEventListener('click', async ()=>{
    if(!confirm('Tem certeza que deseja limpar as categorias antigas em desuso?')) return;
    try {
      const res = await fetch('/categorias/limpar', { method: 'POST' });
      const data = await res.json();
      alert(`✅ Limpeza concluída: ${data.removed || 0} arquivo(s) removido(s).`);
      location.reload();
    } catch (e) {
      console.error(e);
      alert('⚠️ Erro ao executar a limpeza. Veja o console para detalhes.');
    }
  });
})();
</script>

<script>
(function(){
  const notice = document.querySelector('.container > .notice');
  if (!notice) return;
  window.setTimeout(() => {
    notice.style.transition = 'opacity .18s ease, transform .18s ease';
    notice.style.opacity = '0';
    notice.style.transform = 'translateY(-5px)';
    window.setTimeout(() => notice.remove(), 200);
  }, 3000);
  try {
    const url = new URL(window.location.href);
    ['saved','subsaved','subdeleted','error'].forEach(k => url.searchParams.delete(k));
    history.replaceState(null, '', url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '') + url.hash);
  } catch (_) {}
})();
</script>
