<% layout('layout') -%>
<section class="ops-hero compact"><div><span class="ops-kicker">CONFIGURAÇÕES · COMERCIAL</span><h1>🎟️ Cupons de desconto</h1><p>Cadastre benefícios promocionais aplicáveis no PDV, sem criar movimentação separada no Caixa.</p></div><a class="btn" href="/configuracoes">← Voltar</a></section>
<section class="settings-card coupon-admin"><form id="couponForm"><input type="hidden" name="id"><div class="coupon-grid"><label>Código<input name="code" maxlength="40" required placeholder="VOLTA10"></label><label>Nome<input name="name" maxlength="100" required placeholder="R$ 10 de desconto"></label><label>Tipo<select name="type"><option value="fixed">Valor fixo</option><option value="percent">Percentual</option></select></label><label>Valor<input name="value" type="number" min="0.01" step="0.01" required></label><label>Compra mínima<input name="minimumTotal" type="number" min="0" step="0.01" value="0"></label><label>Desconto máximo<input name="maximumDiscount" type="number" min="0" step="0.01" value="0"></label><label>Início<input name="startsAt" type="date"></label><label>Fim<input name="endsAt" type="date"></label><label>Máximo de usos<input name="maxUses" type="number" min="0" step="1" value="0"></label><label>Ativo<select name="active"><option value="true">Sim</option><option value="false">Não</option></select></label><label class="full">Descrição<input name="description" maxlength="180"></label></div><div class="coupon-actions"><button class="btn" type="reset">Limpar</button><button class="btn primary" type="submit">Salvar cupom</button></div></form></section>
<section class="settings-card"><h2>Cupons cadastrados</h2><div class="coupon-list"><% coupons.forEach(c=>{ %><button type="button" class="coupon-row" data-coupon='<%- JSON.stringify(c).replace(/'/g,"&#39;") %>'><b><%= c.code %></b><span><%= c.name %></span><span><%= c.type==='percent'?`${c.value}%`:Number(c.value).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span><span><%= c.uses||0 %> uso(s)</span><em><%= c.active!==false?'Ativo':'Inativo' %></em><small><%= (c.usageLog||[]).length ? `Último uso: ${new Date(c.usageLog[c.usageLog.length-1].at).toLocaleString('pt-BR')}` : 'Sem utilização' %></small></button><% }) %><% if(!coupons.length){ %><p>Nenhum cupom cadastrado.</p><% } %></div></section>
<style>.coupon-admin,.coupon-list{margin:16px}.coupon-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.coupon-grid label{font-size:11px;font-weight:800}.coupon-grid input,.coupon-grid select{width:100%;box-sizing:border-box;margin-top:5px}.coupon-grid .full{grid-column:1/-1}.coupon-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.coupon-list{display:grid;gap:6px}.coupon-row{display:grid;grid-template-columns:120px 1fr 140px 100px 90px 190px;gap:10px;align-items:center;border:1px solid var(--line,#d1d5db);background:var(--card,#fff);color:inherit;border-radius:9px;padding:10px;text-align:left}.coupon-row em{text-align:right}@media(max-width:900px){.coupon-grid{grid-template-columns:repeat(2,1fr)}.coupon-row{grid-template-columns:1fr 1fr}}</style>
<script>(()=>{const form=document.getElementById('couponForm');document.querySelectorAll('.coupon-row').forEach(row=>row.onclick=()=>{const c=JSON.parse(row.dataset.coupon);Object.entries(c).forEach(([k,v])=>{const el=form.elements[k];if(el)el.value=v??'';});scrollTo({top:0,behavior:'smooth'});});form.addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));data.active=data.active==='true';const r=await fetch('/configuracoes/cupons',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const j=await r.json();if(!r.ok)return alert(j.message||'Falha ao salvar.');location.reload();});})();</script>
