<% layout('layout') -%>
<section class="ops-hero compact"><div><span class="ops-kicker">CONFIGURAÇÕES · COMERCIAL</span><h1>🎟️ Descontos e cupons</h1><p>Gerencie cupons promocionais e autorizações temporárias para descontos acima do limite do vendedor.</p></div><a class="btn" href="/configuracoes">← Voltar</a></section>

<% if(typeof canApproveDiscount!=='undefined' && canApproveDiscount){ %>
<section class="settings-card discount-approval-admin" id="chave-temporaria">
  <div class="discount-approval-head"><div><span class="ops-kicker">SUPERVISÃO DO PDV</span><h2>🔑 Chave temporária de desconto</h2><p>Gere uma autorização de uso único quando um vendedor precisar ultrapassar o limite individual configurado.</p></div><a class="btn" href="/configuracoes/caixa-pdv">Configurar validade</a></div>
  <div class="discount-approval-tools"><label>Caixa<select id="discountApprovalCashbox"><% (cashboxes||[]).forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><button class="btn primary" id="btnGenerateDiscountApproval" type="button">Gerar chave</button></div>
  <div class="discount-approval-result" id="discountApprovalResult" hidden><span>Chave temporária</span><strong id="discountApprovalCode">------</strong><small id="discountApprovalMeta"></small><button class="btn" id="btnGenerateAnotherDiscountApproval" type="button">Gerar outra</button></div>
  <small class="discount-approval-note">A chave expira automaticamente, funciona uma única vez e registra na auditoria quem autorizou e quem utilizou.</small>
</section>
<% } %>
<section class="settings-card coupon-admin" id="cupons"><div class="coupon-section-head"><span class="ops-kicker">PROMOÇÕES DO PDV</span><h2>🎟️ Cupons de desconto</h2><p>Cadastre cupons em valor fixo ou percentual, com validade, compra mínima e limite de usos.</p></div><form id="couponForm"><input type="hidden" name="id"><div class="coupon-grid"><label>Código<input name="code" maxlength="40" required placeholder="VOLTA10"></label><label>Nome<input name="name" maxlength="100" required placeholder="R$ 10 de desconto"></label><label>Tipo<select name="type"><option value="fixed">Valor fixo</option><option value="percent">Percentual</option></select></label><label>Valor<input name="value" type="number" min="0.01" step="0.01" required></label><label>Compra mínima<input name="minimumTotal" type="number" min="0" step="0.01" value="0"></label><label>Desconto máximo<input name="maximumDiscount" type="number" min="0" step="0.01" value="0"></label><label>Início<input name="startsAt" type="date"></label><label>Fim<input name="endsAt" type="date"></label><label>Máximo de usos<input name="maxUses" type="number" min="0" step="1" value="0"></label><label>Ativo<select name="active"><option value="true">Sim</option><option value="false">Não</option></select></label><label class="full">Descrição<input name="description" maxlength="180"></label></div><div class="coupon-actions"><button class="btn" type="reset">Limpar</button><button class="btn primary" type="submit">Salvar cupom</button></div></form></section>
<section class="settings-card"><h2>Cupons cadastrados</h2><div class="coupon-list"><% coupons.forEach(c=>{ %><button type="button" class="coupon-row" data-coupon='<%- JSON.stringify(c).replace(/'/g,"&#39;") %>'><b><%= c.code %></b><span><%= c.name %></span><span><%= c.type==='percent'?`${c.value}%`:Number(c.value).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span><span><%= c.uses||0 %> uso(s)</span><em><%= c.active!==false?'Ativo':'Inativo' %></em><small><%= (c.usageLog||[]).length ? `Último uso: ${new Date(c.usageLog[c.usageLog.length-1].at).toLocaleString('pt-BR')}` : 'Sem utilização' %></small></button><% }) %><% if(!coupons.length){ %><p>Nenhum cupom cadastrado.</p><% } %></div></section>
<style>.coupon-admin,.coupon-list,.discount-approval-admin{margin:16px}.discount-approval-admin{display:grid;gap:13px}.discount-approval-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.discount-approval-head h2{margin:2px 0 4px}.discount-approval-head p{margin:0;color:var(--muted)}.discount-approval-tools{display:flex;align-items:end;gap:10px}.discount-approval-tools label{display:grid;gap:5px;min-width:260px;font-size:11px;font-weight:800}.discount-approval-tools select{min-height:38px}.discount-approval-result{display:grid;grid-template-columns:auto minmax(180px,260px) 1fr auto;align-items:center;gap:12px;padding:12px;border:1px solid color-mix(in srgb,var(--blue,#2563eb) 35%,var(--line));border-radius:12px;background:color-mix(in srgb,var(--blue,#2563eb) 7%,var(--card))}.discount-approval-result>span{font-size:11px;font-weight:800;color:var(--muted)}.discount-approval-result strong{font-size:30px;letter-spacing:.22em;font-variant-numeric:tabular-nums}.discount-approval-result small,.discount-approval-note{color:var(--muted);font-size:10px}.coupon-section-head{margin-bottom:12px}.coupon-section-head h2{margin:2px 0 4px}.coupon-section-head p{margin:0;color:var(--muted)}.coupon-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.coupon-grid label{font-size:11px;font-weight:800}.coupon-grid input,.coupon-grid select{width:100%;box-sizing:border-box;margin-top:5px}.coupon-grid .full{grid-column:1/-1}.coupon-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.coupon-list{display:grid;gap:6px}.coupon-row{display:grid;grid-template-columns:120px 1fr 140px 100px 90px 190px;gap:10px;align-items:center;border:1px solid var(--line,#d1d5db);background:var(--card,#fff);color:inherit;border-radius:9px;padding:10px;text-align:left}.coupon-row em{text-align:right}@media(max-width:900px){.coupon-grid{grid-template-columns:repeat(2,1fr)}.coupon-row{grid-template-columns:1fr 1fr}.discount-approval-head,.discount-approval-tools{align-items:stretch;flex-direction:column}.discount-approval-result{grid-template-columns:1fr}}</style>
<script>(()=>{const form=document.getElementById('couponForm');document.querySelectorAll('.coupon-row').forEach(row=>row.onclick=()=>{const c=JSON.parse(row.dataset.coupon);Object.entries(c).forEach(([k,v])=>{const el=form.elements[k];if(el)el.value=v??'';});scrollTo({top:0,behavior:'smooth'});});form.addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));data.active=data.active==='true';const r=await fetch('/configuracoes/cupons',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const j=await r.json();if(!r.ok)return alert(j.message||'Falha ao salvar.');location.reload();});
const generate=async event=>{const button=event?.currentTarget||document.getElementById('btnGenerateDiscountApproval');const cashboxId=document.getElementById('discountApprovalCashbox')?.value||'caixa-principal';if(button)button.disabled=true;try{const r=await fetch('/erp/pdv/descontos/chave',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cashboxId})});const j=await r.json();if(!r.ok)throw new Error(j.message||'Não foi possível gerar a chave.');document.getElementById('discountApprovalCode').textContent=j.token?.code||'------';const expires=j.token?.expiresAt?new Date(j.token.expiresAt).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'';document.getElementById('discountApprovalMeta').textContent=`Gerada por ${j.token?.issuerName||'supervisor'}${expires?` · válida até ${expires}`:''}.`;document.getElementById('discountApprovalResult').hidden=false;}catch(error){alert(error.message);}finally{if(button)button.disabled=false;}};document.getElementById('btnGenerateDiscountApproval')?.addEventListener('click',generate);document.getElementById('btnGenerateAnotherDiscountApproval')?.addEventListener('click',generate);})();</script>
