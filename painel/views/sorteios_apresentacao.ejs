<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Sorteio Quality</title><style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#020617;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#fff}.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% -8%,rgba(250,204,21,.45),transparent 28%),radial-gradient(circle at 18% 27%,rgba(22,163,74,.50),transparent 32%),radial-gradient(circle at 82% 30%,rgba(220,38,38,.42),transparent 30%),linear-gradient(180deg,#062b16 0%,#03160b 54%,#020617 100%)}.stage:before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.18) 1px,transparent 2px);background-size:32px 32px;opacity:.48}.light{position:absolute;top:-18%;width:42%;height:55%;background:radial-gradient(ellipse at top,rgba(255,255,255,.38),rgba(250,204,21,.10) 35%,transparent 68%);filter:blur(1px)}.light.l{left:-7%;transform:rotate(18deg)}.light.r{right:-7%;transform:rotate(-18deg)}.field{position:absolute;left:-22%;right:-22%;bottom:-9%;height:42%;background:radial-gradient(ellipse at center,rgba(34,197,94,.48),transparent 54%),linear-gradient(180deg,transparent,#06110a 68%)}.cupShadow{position:absolute;top:5.5vh;font-size:min(22vw,125px);filter:drop-shadow(0 18px 30px rgba(0,0,0,.5));opacity:.95}.card{position:relative;z-index:2;width:min(92vw,520px);height:min(91vh,960px);border:1px solid rgba(255,255,255,.22);border-radius:36px;padding:24px 18px 18px;background:linear-gradient(180deg,rgba(0,0,0,.50),rgba(0,0,0,.23));box-shadow:0 30px 120px rgba(0,0,0,.62);display:flex;flex-direction:column;align-items:center;text-align:center;overflow:hidden}.card:before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 0 42%,rgba(255,255,255,.08) 50%,transparent 58%);transform:translateX(-90%);animation:shine 4.8s ease-in-out infinite}@keyframes shine{55%,100%{transform:translateX(90%)}}.logo{width:104px;background:#fff;border-radius:12px;padding:8px;margin:0 0 12px;box-shadow:0 12px 30px rgba(0,0,0,.24)}.tag{font-size:12px;letter-spacing:.20em;color:#fde68a;font-weight:1000;text-transform:uppercase}.title{font-size:min(10vw,46px);line-height:.94;margin:7px 0 4px;font-weight:1000;text-transform:uppercase;text-shadow:0 5px 22px rgba(0,0,0,.58)}.sub{font-size:13px;color:#bbf7d0;font-weight:900}.flags{display:flex;align-items:center;justify-content:center;gap:10px;margin:14px 0 10px}.flagbox{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:8px 10px;font-weight:1000;display:flex;align-items:center;gap:7px}.versus{font-size:30px;color:#facc15;font-weight:1000}.meta{color:#dcfce7;font-size:13px;margin-bottom:10px}.prize{width:100%;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);border-radius:18px;padding:12px 10px;margin-bottom:13px;font-weight:900;color:#fff7ed}.prize small{display:block;color:#fde68a;margin-bottom:3px}.nameBox{width:100%;margin:auto 0 12px;background:linear-gradient(90deg,#fff,#fff4b7);color:#0f172a;border-radius:22px;padding:20px 10px;box-shadow:0 16px 45px rgba(0,0,0,.28);position:relative;z-index:3}.label{font-size:12px;color:#64748b;font-weight:1000;letter-spacing:.08em}.name{font-size:min(8vw,35px);line-height:1.08;font-weight:1000;word-break:break-word}.count{font-size:94px;line-height:1;font-weight:1000;color:#facc15;text-shadow:0 10px 40px rgba(0,0,0,.75);display:none;margin:auto 0}.participants{border:1px solid rgba(255,255,255,.20);background:rgba(0,0,0,.22);border-radius:14px;padding:8px 28px;margin-bottom:11px}.participants b{font-size:28px}.btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;position:relative;z-index:4}.btn{border:0;border-radius:999px;padding:13px 18px;font-size:15px;font-weight:1000;background:linear-gradient(135deg,#facc15,#f59e0b);color:#111827;box-shadow:0 14px 25px rgba(0,0,0,.28)}.btn.secondary{background:rgba(255,255,255,.18);color:#fff}.foot{position:relative;z-index:2;width:100%;display:flex;justify-content:space-between;gap:10px;font-size:10.5px;font-weight:900;color:rgba(255,255,255,.86);margin-top:10px}.confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:10}.confetti i{position:absolute;width:7px;height:13px;background:#facc15;top:-20px;animation:fall 2.9s linear forwards}.confetti i:nth-child(3n){background:#22c55e}.confetti i:nth-child(4n){background:#fff}.confetti i:nth-child(5n){background:#ef4444}@keyframes fall{to{transform:translateY(110vh) rotate(640deg)}}.hide{display:none!important}@media(orientation:landscape){.card{height:90vh;width:min(92vw,860px);padding:18px}.logo{width:82px}.title{font-size:38px}.flags{margin:8px 0}.name{font-size:38px}.prize{padding:9px}.participants{display:none}.foot{position:absolute;left:20px;right:20px;bottom:12px;width:auto}}
</style></head><body><div class="stage"><div class="light l"></div><div class="light r"></div><div class="field"></div><div class="cupShadow">🏆</div><div class="confetti" id="confetti"></div><main class="card"><img class="logo" src="/public/LogoSemFundo.png"><div class="tag">Copa do Mundo FIFA 2026</div><h1 class="title"><%= data.campanha %></h1><div class="sub">Sorteio Oficial Quality</div><div class="flags"><div class="flagbox"><span>🇧🇷</span><span>Brasil</span></div><span class="versus">X</span><div class="flagbox"><span>🇳🇴</span><span>Noruega</span></div></div><div class="meta"><%= data.jogo %></div><div class="prize"><small>🎁 PRÊMIO</small><%= data.premio %></div><div class="participants"><b><%= data.participantes.length %></b><br><small>participante(s)</small></div><div id="count" class="count">3</div><div id="nameBox" class="nameBox"><div class="label">VENCEDOR(A)</div><div id="name" class="name">Toque em iniciar</div></div><div class="btns" id="btns"><button class="btn" onclick="start()">▶️ Iniciar sorteio</button><button class="btn secondary" onclick="full()">Tela cheia</button></div><div class="foot"><span>Quality Celulares</span><span>www.qualitycel.com.br</span></div></main></div><script>
const participantes=<%- JSON.stringify(data.participantes || []) %>; const vencedor=<%- JSON.stringify(data.vencedor || null) %>; const nomes=participantes.map(p=>p.usuario||p.nome).filter(Boolean); const finalName=(vencedor&&(vencedor.usuario||vencedor.nome))||nomes[Math.floor(Math.random()*nomes.length)]||'Vencedor';
function full(){document.documentElement.requestFullscreen?.().catch(()=>{});}function confetti(){const c=document.getElementById('confetti'); c.innerHTML=''; for(let i=0;i<130;i++){const e=document.createElement('i'); e.style.left=Math.random()*100+'%'; e.style.animationDelay=Math.random()*1.15+'s'; e.style.transform='rotate('+Math.random()*180+'deg)'; c.appendChild(e);} setTimeout(()=>c.innerHTML='',5200)}
function start(){full(); const count=document.getElementById('count'), name=document.getElementById('name'), box=document.getElementById('nameBox'), btns=document.getElementById('btns'); btns.classList.add('hide'); let c=3; count.style.display='block'; box.style.display='none'; count.textContent=c; const cd=setInterval(()=>{c--; if(c>0){count.textContent=c}else{clearInterval(cd); count.style.display='none'; box.style.display='block'; let i=0,total=64; const timer=setInterval(()=>{name.textContent=nomes[i%nomes.length]||finalName; i++; if(i>total){clearInterval(timer); name.textContent='🎉 '+finalName; confetti();}},50+Math.min(i*4,155));}},820)}
</script></body></html>
