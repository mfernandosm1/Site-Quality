<% layout('layout') -%>
<section class="suppliers-page" id="suppliersPage">
<style>
.suppliers-page{padding:20px 24px 40px;color:var(--text,#111827)}
.suppliers-hero,.suppliers-card,.suppliers-kpi{border:1px solid var(--line,#e5e7eb);background:var(--card,#fff);border-radius:14px}
.suppliers-hero{display:flex;justify-content:space-between;gap:18px;padding:18px;margin-bottom:14px}
.suppliers-kicker{font-size:10px;font-weight:900;color:var(--blue,#2563eb);letter-spacing:.08em}
.suppliers-hero h1{margin:4px 0 5px;font-size:25px}.suppliers-hero p{margin:0;color:var(--muted,#6b7280);font-size:12px}
.suppliers-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.suppliers-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}
.suppliers-kpi{padding:13px}.suppliers-kpi span{display:block;color:var(--muted,#6b7280);font-size:10px;font-weight:900;text-transform:uppercase}.suppliers-kpi strong{display:block;font-size:24px;margin-top:5px}
.suppliers-card{padding:14px}.suppliers-filters{display:grid;grid-template-columns:2fr repeat(3,minmax(150px,1fr)) auto;gap:8px;align-items:end}
.suppliers-filters label,.supplier-field label{display:block;font-size:10px;font-weight:900;color:var(--muted,#6b7280);text-transform:uppercase;margin-bottom:5px}
.suppliers-filters input,.suppliers-filters select,.supplier-field input,.supplier-field select,.supplier-field textarea{width:100%;box-sizing:border-box;border:1px solid var(--line,#e5e7eb);background:var(--surface-soft,var(--card,#fff));color:var(--text,#111827);border-radius:9px;padding:9px;min-height:39px}
.suppliers-list-head{display:flex;justify-content:space-between;align-items:center;margin:15px 0 9px}.suppliers-list-head h2{font-size:16px;margin:0}.suppliers-list-head p{margin:3px 0 0;color:var(--muted,#6b7280);font-size:11px}
.suppliers-table-wrap{overflow:auto;border:1px solid var(--line,#e5e7eb);border-radius:12px}.suppliers-table{width:100%;border-collapse:collapse;min-width:980px}.suppliers-table th,.suppliers-table td{padding:11px 10px;border-bottom:1px solid var(--line,#e5e7eb);text-align:left;font-size:11px}.suppliers-table th{background:var(--surface-soft,#f8fafc);color:var(--text,#111827);text-transform:uppercase;font-size:9px}
.supplier-name strong{display:block;font-size:12px}.supplier-name small{color:var(--muted,#6b7280)}
.supplier-status{display:inline-flex;padding:5px 8px;border-radius:999px;font-weight:900;font-size:9px}.supplier-active{background:#052e16;color:#86efac;border:1px solid #166534}.supplier-inactive{background:#3f1d0b;color:#fdba74;border:1px solid #9a3412}
.suppliers-empty{text-align:center;padding:34px;color:var(--muted,#6b7280)}
.supplier-drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:1100}.supplier-drawer{position:fixed;right:0;top:0;bottom:0;width:min(760px,96vw);background:var(--card,#fff);border-left:1px solid var(--line,#e5e7eb);z-index:1101;transform:translateX(100%);transition:.22s;overflow:auto;color:var(--text,#111827)}.supplier-drawer.open{transform:translateX(0)}
.supplier-drawer-header{position:sticky;top:0;background:var(--card,#fff);border-bottom:1px solid var(--line,#e5e7eb);padding:16px;display:flex;justify-content:space-between;z-index:2}.supplier-drawer-header h2{margin:3px 0}.supplier-close{border:0;background:var(--surface-soft,#f3f4f6);color:var(--text,#111827);width:34px;height:34px;border-radius:9px;font-size:22px}
.supplier-drawer-body{padding:16px}.supplier-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}.supplier-tab{border:1px solid var(--line,#e5e7eb);background:var(--surface-soft,#f8fafc);color:var(--text,#111827);border-radius:9px;padding:8px 11px;font-weight:800}.supplier-tab.active{background:var(--blue,#2563eb);border-color:var(--blue,#2563eb);color:#fff}
.supplier-panel[hidden]{display:none!important}.supplier-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.supplier-field.full{grid-column:1/-1}
.supplier-inline{display:flex;gap:8px;align-items:end}.supplier-inline input{flex:1}.supplier-document-state{font-size:11px;margin-top:5px;color:var(--muted,#6b7280)}.supplier-document-state.ok{color:#16a34a}.supplier-document-state.error{color:#dc2626}
.supplier-save-bar{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--line,#e5e7eb)}.supplier-message{padding:10px;border-radius:9px;margin-top:12px}.supplier-message.error{background:#3f1d0b;color:#fed7aa}.supplier-message.success{background:#052e16;color:#bbf7d0}
.supplier-consult-box{border:1px solid var(--line,#e5e7eb);background:var(--surface-soft,#f8fafc);border-radius:10px;padding:10px;font-size:11px;color:var(--muted,#6b7280)}
.btn.danger{background:#7f1d1d;color:#fff}.btn.success{background:#166534;color:#fff}
@media(max-width:900px){.suppliers-kpis{grid-template-columns:repeat(2,1fr)}.suppliers-filters{grid-template-columns:1fr 1fr}.supplier-grid{grid-template-columns:1fr}}@media(max-width:600px){.suppliers-page{padding:14px}.suppliers-hero{flex-direction:column}.suppliers-kpis,.suppliers-filters{grid-template-columns:1fr}}

.supplier-field[hidden],.supplier-pf-only[hidden],.supplier-pj-only[hidden]{display:none!important}
.supplier-check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.supplier-check{display:flex;align-items:center;gap:8px;border:1px solid var(--line,#e5e7eb);background:var(--surface-soft,#f8fafc);border-radius:9px;padding:9px;font-size:11px}
.supplier-check input{width:auto;min-height:auto}
.supplier-contacts{display:grid;gap:9px}.supplier-contact-row{display:grid;grid-template-columns:1.2fr 1fr 1fr 1.3fr auto;gap:7px;align-items:end;border:1px solid var(--line,#e5e7eb);border-radius:10px;padding:9px;background:var(--surface-soft,#f8fafc)}
.supplier-contact-row label{font-size:9px}.supplier-contact-remove{min-height:39px}
.supplier-alert-field textarea{border-color:#b45309!important;background:rgba(180,83,9,.08)!important}
@media(max-width:760px){.supplier-contact-row{grid-template-columns:1fr 1fr}.supplier-contact-remove{grid-column:1/-1}.supplier-check-grid{grid-template-columns:1fr}}


#supplierCnpjLookup[hidden]{display:none!important}
.supplier-existing-card{border:1px solid #b45309;background:rgba(180,83,9,.10);border-radius:11px;padding:12px;margin-top:10px}
.supplier-existing-card.inactive{border-color:#9a3412;background:rgba(154,52,18,.12)}
.supplier-existing-card strong{display:block;font-size:13px;margin-bottom:4px}
.supplier-existing-card p{margin:3px 0;font-size:11px;color:var(--muted,#6b7280)}
.supplier-existing-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}

</style>

<header class="suppliers-hero">
  <div>
    <span class="suppliers-kicker">ERP · FORNECEDORES v0.12.7</span>
    <h1>Central de Fornecedores</h1>
    <p>Cadastro mestre preparado para produtos, compras, estoque e financeiro.</p>
  </div>
  <div class="suppliers-actions">
    <a class="btn" href="/erp">← Voltar ao ERP</a>
    <button class="btn primary" id="supplierNewButton" type="button">+ Novo fornecedor</button>
  </div>
</header>

<section class="suppliers-kpis">
  <article class="suppliers-kpi erp-tone-info"><span>Total</span><strong><%= summary.total %></strong></article>
  <article class="suppliers-kpi erp-tone-success"><span>Ativos</span><strong><%= summary.active %></strong></article>
  <article class="suppliers-kpi erp-tone-expense"><span>Inativos</span><strong><%= summary.inactive %></strong></article>
  <article class="suppliers-kpi erp-tone-income"><span>Novos neste mês</span><strong><%= summary.newThisMonth %></strong></article>
</section>

<section class="suppliers-card">
  <div class="suppliers-filters">
    <div><label for="supplierSearch">Pesquisar</label><input id="supplierSearch" type="search" placeholder="Nome, fantasia, código, CPF/CNPJ, cidade..."></div>
    <div><label for="supplierStatusFilter">Situação</label><select id="supplierStatusFilter"><option value="">Todos</option><option value="active">Ativos</option><option value="inactive">Inativos</option></select></div>
    <div><label for="supplierTypeFilter">Pessoa</label><select id="supplierTypeFilter"><option value="">Todos</option><option value="pf">Pessoa física</option><option value="pj">Pessoa jurídica</option></select></div>
    <div><label for="supplierOriginFilter">Origem</label><select id="supplierOriginFilter"><option value="">Todas</option><option value="national">Nacional</option><option value="imported">Importado</option></select></div>
    <button class="btn" id="supplierClearFilters" type="button">Limpar</button>
  </div>

  <div class="suppliers-list-head">
    <div><h2>Fornecedores cadastrados</h2><p id="supplierResultCount"><%= suppliers.length %> fornecedor(es) encontrado(s)</p></div>
    <span class="badge">Cadastro Mestre</span>
  </div>

  <div class="suppliers-table-wrap">
    <table class="suppliers-table">
      <thead><tr><th>Código</th><th>Fornecedor</th><th>CPF/CNPJ</th><th>Contato</th><th>Cidade</th><th>Origem</th><th>Situação</th><th>Ações</th></tr></thead>
      <tbody id="suppliersTableBody">
      <% suppliers.forEach(supplier => { %>
        <tr data-supplier-row data-search="<%= supplier.searchText %>" data-status="<%= supplier.active ? 'active' : 'inactive' %>" data-type="<%= supplier.personType %>" data-origin="<%= supplier.originType %>">
          <td><strong><%= supplier.code %></strong></td>
          <td class="supplier-name"><strong><%= supplier.name %></strong><small><%= supplier.tradeName || (supplier.personType === 'pj' ? 'Pessoa jurídica' : 'Pessoa física') %></small></td>
          <td><%= supplier.documentFormatted || '—' %></td>
          <td><strong><%= supplier.mobileFormatted || supplier.phoneFormatted || '—' %></strong><br><small><%= supplier.email || '' %></small></td>
          <td><%= supplier.city ? `${supplier.city}${supplier.state ? `/${supplier.state}` : ''}` : '—' %></td>
          <td><%= supplier.originType === 'imported' ? 'Importado' : 'Nacional' %></td>
          <td><span class="supplier-status supplier-<%= supplier.active ? 'active' : 'inactive' %>"><%= supplier.active ? 'Ativo' : 'Inativo' %></span></td>
          <td><button class="btn supplier-edit" type="button" data-id="<%= supplier.id %>">Ver detalhes</button></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <div class="suppliers-empty" id="suppliersEmpty" <%= suppliers.length ? 'hidden' : '' %>>Nenhum fornecedor encontrado.</div>
  </div>
</section>

<script id="suppliersData" type="application/json"><%- JSON.stringify(suppliersRaw || []).replace(/</g,'\\u003c') %></script>
</section>

<div class="supplier-drawer-backdrop" id="supplierDrawerBackdrop" hidden></div>
<aside class="supplier-drawer" id="supplierDrawer" aria-hidden="true">
  <header class="supplier-drawer-header">
    <div><span class="suppliers-kicker">CADASTRO MESTRE</span><h2 id="supplierDrawerTitle">Novo fornecedor</h2><small id="supplierDrawerCode"></small></div>
    <button class="supplier-close" id="supplierDrawerClose" type="button">×</button>
  </header>
  <div class="supplier-drawer-body">
    <div class="supplier-tabs">
      <button class="supplier-tab active" type="button" data-supplier-tab="main">Dados principais</button>
      <button class="supplier-tab" type="button" data-supplier-tab="address">Endereço</button>
      <button class="supplier-tab" type="button" data-supplier-tab="contacts">Contatos</button>
      <button class="supplier-tab" type="button" data-supplier-tab="commercial">Comercial</button>
      <button class="supplier-tab" type="button" data-supplier-tab="notes">Observações</button>
    </div>

    <form id="supplierForm">
      <input type="hidden" name="id" id="supplierId">

      <section class="supplier-panel" data-supplier-panel="main">
        <div class="supplier-grid">
          <div class="supplier-field"><label>Tipo de pessoa *</label><select name="personType" id="supplierPersonType"><option value="pj">Pessoa jurídica</option><option value="pf">Pessoa física</option></select></div>
          <div class="supplier-field"><label>Origem *</label><select name="originType" id="supplierOriginType"><option value="national">Nacional</option><option value="imported">Importado</option></select></div>
          <div class="supplier-field full">
            <label id="supplierDocumentLabel">CNPJ *</label>
            <div class="supplier-inline"><input name="document" id="supplierDocument" inputmode="numeric" autocomplete="off" maxlength="18" required><button class="btn" id="supplierCnpjLookup" type="button">Consultar CNPJ</button></div>
            <div class="supplier-document-state" id="supplierDocumentState">Informe um documento válido.</div>
            <div class="supplier-existing-card" id="supplierExistingCard" hidden>
              <strong id="supplierExistingTitle">Fornecedor já cadastrado</strong>
              <p id="supplierExistingSummary"></p>
              <p id="supplierExistingStatus"></p>
              <div class="supplier-existing-actions">
                <button class="btn primary" id="supplierOpenExisting" type="button">Abrir cadastro existente</button>
                <button class="btn success" id="supplierReactivateExisting" type="button" hidden>Reativar fornecedor</button>
              </div>
            </div>
          </div>
          <div class="supplier-field"><label id="supplierNameLabel">Razão social *</label><input name="name" id="supplierName" maxlength="160" required></div>
          <div class="supplier-field supplier-pj-only"><label>Nome fantasia</label><input name="tradeName" id="supplierTradeName" maxlength="160"></div>
          <div class="supplier-field supplier-pj-only"><label id="supplierRegistrationLabel">Inscrição estadual</label><input name="stateRegistration" id="supplierStateRegistration"></div>
          <div class="supplier-field supplier-pj-only"><label>Inscrição municipal</label><input name="municipalRegistration" id="supplierMunicipalRegistration"></div>
          <div class="supplier-field supplier-pf-only" hidden><label>Data de nascimento</label><input name="birthDate" id="supplierBirthDate" type="date"></div>
          <div class="supplier-field supplier-pj-only"><label>Pessoa de contato</label><input name="contactName" id="supplierContactName"></div>
          <div class="supplier-field"><label>Celular / WhatsApp</label><input name="mobile" id="supplierMobile" inputmode="tel"></div>
          <div class="supplier-field"><label>Telefone</label><input name="phone" id="supplierPhone" inputmode="tel"></div>
          <div class="supplier-field"><label>E-mail</label><input name="email" id="supplierEmail" type="email"></div>
          <div class="supplier-field supplier-pj-only"><label>Website</label><input name="website" id="supplierWebsite" type="url"></div>
          <div class="supplier-field full supplier-pj-only"><div class="supplier-consult-box" id="supplierLookupInfo">A consulta de CNPJ é auxiliar. Os dados continuam editáveis e o cadastro manual permanece disponível caso o serviço externo esteja indisponível.</div></div>
        </div>
      </section>

      <section class="supplier-panel" data-supplier-panel="address" hidden>
        <div class="supplier-grid">
          <div class="supplier-field"><label>CEP</label><div class="supplier-inline"><input name="zipCode" id="supplierZipCode" inputmode="numeric" maxlength="9"><button class="btn" id="supplierCepLookup" type="button">Consultar CEP</button></div></div>
          <div class="supplier-field"><label>Estado</label><input name="state" id="supplierState" maxlength="2"></div>
          <div class="supplier-field full"><label>Endereço</label><input name="street" id="supplierStreet"></div>
          <div class="supplier-field"><label>Número</label><input name="number" id="supplierNumber"></div>
          <div class="supplier-field"><label>Complemento</label><input name="complement" id="supplierComplement"></div>
          <div class="supplier-field"><label>Bairro</label><input name="district" id="supplierDistrict"></div>
          <div class="supplier-field"><label>Cidade</label><input name="city" id="supplierCity"></div>
        </div>
      </section>


      <section class="supplier-panel" data-supplier-panel="contacts" hidden>
        <div class="supplier-grid">
          <div class="supplier-field full">
            <label>Contatos adicionais</label>
            <div class="supplier-contacts" id="supplierContactsList"></div>
            <button class="btn" id="supplierAddContact" type="button" style="margin-top:9px">+ Adicionar contato</button>
          </div>
        </div>
      </section>

      <section class="supplier-panel" data-supplier-panel="commercial" hidden>
        <div class="supplier-grid">
          <div class="supplier-field"><label>Markup padrão (%)</label><input name="defaultMarkup" id="supplierDefaultMarkup" type="number" min="0" step="0.01"></div>
          <div class="supplier-field"><label>Moeda padrão</label><select name="currency" id="supplierCurrency"><option value="BRL">Real (BRL)</option><option value="USD">Dólar (USD)</option></select></div>
          <div class="supplier-field"><label>Prazo médio de entrega (dias)</label><input name="averageDeliveryDays" id="supplierAverageDeliveryDays" type="number" min="0" step="1"></div>
          <div class="supplier-field"><label>Quantidade mínima do pedido</label><input name="minimumOrderQuantity" id="supplierMinimumOrderQuantity" type="number" min="0" step="1"></div>
          <div class="supplier-field"><label>Valor mínimo do pedido</label><input name="minimumOrderValue" id="supplierMinimumOrderValue" type="number" min="0" step="0.01"></div>
          <div class="supplier-field"><label>Dias habituais para pedidos</label><input name="orderDays" id="supplierOrderDays" placeholder="Ex.: segunda e quinta"></div>
          <div class="supplier-field"><label>Condição de pagamento padrão</label><input name="paymentTerms" id="supplierPaymentTerms" placeholder="Ex.: 28 dias, à vista..."></div>
          <div class="supplier-field"><label>Forma de pagamento preferida</label><input name="preferredPaymentMethod" id="supplierPreferredPaymentMethod" placeholder="Ex.: Pix, boleto..."></div>

          <div class="supplier-field full">
            <label>Meios de envio habituais</label>
            <div class="supplier-check-grid">
              <% ['Correios','Transportadora','Motoboy','Retirada no local','Ônibus / excursão','Aéreo','Entrega própria','Outro'].forEach(item => { %>
                <label class="supplier-check"><input type="checkbox" name="shippingMethods" value="<%= item %>"> <span><%= item %></span></label>
              <% }) %>
            </div>
          </div>

          <div class="supplier-field full"><label>Observações sobre frete e envio</label><textarea name="freightNotes" id="supplierFreightNotes" rows="3" placeholder="Ex.: envia toda terça, frete pago, exige coleta..."></textarea></div>

          <div class="supplier-field full">
            <label>Categorias fornecidas</label>
            <div class="supplier-check-grid">
              <% ['Celulares','Peças','Acessórios','Informática','Serviços','Outros'].forEach(item => { %>
                <label class="supplier-check"><input type="checkbox" name="suppliedCategories" value="<%= item %>"> <span><%= item %></span></label>
              <% }) %>
            </div>
          </div>

          <div class="supplier-field"><label>Situação</label><select name="active" id="supplierActive"><option value="true">Ativo</option><option value="false">Inativo</option></select></div>
        </div>
      </section>

      <section class="supplier-panel" data-supplier-panel="notes" hidden>
        <div class="supplier-grid">
          <div class="supplier-field full supplier-alert-field"><label>Alerta interno</label><textarea name="internalAlert" id="supplierInternalAlert" rows="3" maxlength="800" placeholder="Ex.: não comprar sem confirmação, exige pedido mínimo, atenção com garantia..."></textarea></div>
          <div class="supplier-field full"><label>Observações gerais</label><textarea name="notes" id="supplierNotes" rows="7" maxlength="3000"></textarea></div>
        </div>
      </section>

      <div class="supplier-message" id="supplierMessage" hidden></div>
      <div class="supplier-save-bar">
        <button class="btn danger" id="supplierToggleActive" type="button" hidden>Inativar</button>
        <button class="btn primary" id="supplierSave" type="submit" disabled>Salvar fornecedor</button>
      </div>
    </form>
  </div>
</aside>
<script id="supplierFieldSettingsData" type="application/json"><%- JSON.stringify(supplierFieldSettings || {}) %></script>
<script src="/public/js/fornecedores.js"></script>
