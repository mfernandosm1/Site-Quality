# Caminho da raiz do Painel Quality.
QUALITY_ROOT=C:\Site

# Caminho exato da pasta que contém a sessão LocalAuth.
# Pela estrutura atual: C:\Site\Site_with_content\content\automacao_whatsapp\session
WA_SESSION_PATH=C:\Site\Site_with_content\content\automacao_whatsapp\session

WA_CLIENT_ID=quality-teste
WA_HEADLESS=true
WA_READY_TIMEOUT_MS=90000
WA_AUTO_CLOSE_MS=5000

# Opcional: caminho direto do Chrome.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
