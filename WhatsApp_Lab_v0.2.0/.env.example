# Caminho raiz do projeto Quality
QUALITY_ROOT=C:\Site

# Sessão LocalAuth usada pelo Painel
WA_SESSION_PATH=C:\Site\Site_with_content\content\automacao_whatsapp\session
WA_CLIENT_ID=quality-teste

# Navegador
WA_HEADLESS=true
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Tempos do diagnóstico
WA_READY_TIMEOUT_MS=90000
WA_SETTLE_AFTER_READY_MS=12000
WA_EVENT_OBSERVATION_MS=5000
WA_API_TIMEOUT_MS=30000

# Limites seguros
WA_MAX_CHATS_SAMPLE=8
WA_MAX_CONTACTS_SAMPLE=8
WA_MAX_MESSAGES_PER_CHAT=15
WA_MEDIA_CHAT_SCAN_LIMIT=8
WA_SEARCH_QUERY=teste
